	await novel_interface.show_text_only("Aya a affiché le dossier de Walid Mushar sur l'écran.")
	novel_interface.show_character("ai","dizzy")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("liliu_uniform1","normal1",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("...Il a en fait un doctorat !?", "Aya")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Ouais. L’homme qui a autrefois reçu la prime la plus élevée au monde est titulaire d’un doctorat en physique de l’Université Ben Gourion.", "Mariru")
	novel_interface.change_2nd_expression("serious")
	await novel_interface.show_dialog("On raconte qu'après la destruction de la Ville sainte, Masadans, tellement enragé qu'il avait perdu toute raison, a traîné sa femme et sa fille hors de leur maison à Beer Sheva et dans la rue...", "Mariru")
	novel_interface.character_light(0.35,"think")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Une haine ethnique aveugle ?\nLes humains sont vraiment des animaux désespérément stupides...", "Aya")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru coupa légèrement Aya sur la tête. Aya rétrécit son cou par réflexe, seulement pour découvrir que Mariru n'avait pas utilisé beaucoup de force cette fois.")
	novel_interface.show_character("ai","think")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("liliu_uniform1","sigh",0.25)
	await novel_interface.show_dialog("Ouais. Les humains sont vraiment stupides.", "Mariru")
	novel_interface.change_2nd_expression("normal1")
	await novel_interface.show_dialog("Après cela, Mushar a quitté l'université. La prochaine fois qu'il est apparu en public, il était déjà le plus grand casse-tête de Massada.", "Mariru")
	await novel_interface.show_dialog("Sans le système de représailles automatiques de Massada, il aurait probablement continué à se battre jusqu'au jour de sa mort...", "Mariru")
	novel_interface.change_2nd_expression("normal2")
	await novel_interface.show_dialog("Tu devrais aller dormir un peu. Vous êtes assis ici depuis des heures.", "Mariru")
	novel_interface.change_2nd_expression("normal1")
	await novel_interface.show_dialog("On ne sait pas ce qui se passera demain...", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.stop_music()
	await novel_interface.hide_background_with_fade()
	await novel_interface.show_text_only("..................")
	await novel_interface.show_text_only("...")
	await novel_interface.show_text_only("Orphelinat du District Extérieur.")
	novel_interface.change_music("res://assets/audio/music/Shop.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_ShelterCorridor.png")
	novel_interface.show_character("ren_medical","smile")
	await novel_interface.show_dialog("Ouf... Mes cheveux sont pleins de sable. Cette douche était incroyable.", "Lian")
	novel_interface.change_expression("wry_smile")
	await novel_interface.show_dialog("(Dieu merci, il y avait des culottes jetables dans les fournitures militaires...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("La salle de bain est plus grande que ce à quoi je m'attendais et elle est très propre. Le comptoir est soigneusement garni de nombreux jouets en plastique pour les petits enfants.")
	await novel_interface.show_text_only("Tout en me séchant les cheveux, j'ai pris le téléphone qui était en charge à l'extérieur de la salle de bain et je l'ai déconnecté du haut-parleur sans fil.")
	await novel_interface.show_dialog("Tu as fini de faire la vaisselle, Lian ?", "Haifa")
	novel_interface.show_character("ren_medical","smile")
	await novel_interface.show_dialog("Mm-hmm, c'était génial~\nMerci, tante Haifa !", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Je crois que j'ai entendu de la musique dans la salle de bain tout à l'heure.\nVotre téléphone n'était-il pas dehors... ?", "Haifa")
	novel_interface.show_character("ren_medical","shy_left")
	await novel_interface.show_dialog("N-Non ! Ce n'était pas le cas ! Vraiment...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mon visage était rouge alors que je couvrais ma poitrine.")
	await novel_interface.show_text_only("Soudain, le talkie-walkie à côté du téléphone a éclaté en électricité statique...")
	await novel_interface.show_dialog("Lian, tu es là ?!", "Emily")
	novel_interface.show_character("ren_medical","serious")
	await novel_interface.show_dialog("Qu'est-ce que c'est ?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.stop_music()
	await novel_interface.show_dialog("Demandez à tante Haïfa d'éteindre toutes les lumières et de verrouiller la porte d'entrée !\nJ'ai trouvé...", "Emily")
	await novel_interface.show_text_only("Avant que l'orateur n'ait pu terminer, le talkie-walkie s'est dissous en parasites.")

