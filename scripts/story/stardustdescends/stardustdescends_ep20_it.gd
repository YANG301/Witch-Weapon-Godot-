# stardustdescends_ep20.gd - 星尘降落篇第20话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	stardustdescends_ep20_script()

func play_script():
	pass

func stardustdescends_ep20_script():
