# stardustdescends_ep15.gd - 星尘降临篇第15话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	stardustdescends_ep15_script()

func play_script():
	pass

func stardustdescends_ep15_script():
	novel_interface.change_music("res://assets/audio/music/Wind.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_StarrySky.png")
	await novel_interface.show_text_only("Toma mi amor, toma mi tierra.")
	await novel_interface.show_text_only("Llévame donde no puedo soportar")
	await novel_interface.show_text_only("No me importa, todavía soy libre")
	await novel_interface.show_text_only("No puedes quitarme el cielo")
	await novel_interface.show_text_only("Llévame al negro")
	await novel_interface.show_text_only("Diles que no voy a volver")
	await novel_interface.show_text_only("Quema la tierra y hierve el mar")
	await novel_interface.show_text_only("No puedes quitarme el cielo...")
	await novel_interface.show_text_only("-- Tema musical de \"Firefly\"")
	await novel_interface.stop_music()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("...")
	await novel_interface.show_text_only("Al lado de la autopista a las afueras de Masada.")
	novel_interface.change_music("res://assets/audio/music/Shop.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_Sways.png")
	await novel_interface.show_text_only("Después del atardecer, el desierto se oscureció rápidamente y salimos a un camino apartado fuera de la ciudad.")
	await novel_interface.show_text_only("Vera cambió la matrícula del camión, mientras yo ayudaba a Emily a cubrir la plataforma de carga con una red antidisturbios estampada con las marcas de la Fuerza de Defensa Nacional.")
	await novel_interface.show_text_only("Aparentemente, las municiones sin detonar, las minas terrestres y otros artículos peligrosos a menudo deben manipularse fuera de la ciudad, por lo que la gente tiende a mantenerse alejada de los camiones militares cubiertos con redes antidisturbios como ésta.")
	await novel_interface.show_text_only("El modo de conducción autónoma del camión estaba configurado para seguirnos. En un momento, seguiría a nuestro vehículo blindado hasta la ciudad.")
	await novel_interface.show_text_only("Tal vez porque acabábamos de sobrevivir juntos a una experiencia cercana a la muerte esa tarde, la relación entre secuestrador y rehén se estaba convirtiendo gradualmente en una de cómplices.")
	await novel_interface.show_text_only("Charlamos ociosamente en el camino hacia aquí. Les conté sobre la vida en el campus y todo tipo de comida en New Toyosu, y me contaron muchas historias divertidas de la escuela militar.")
	await novel_interface.show_text_only("Resultó que Vera y Emily no eran mucho mayores que yo. Podrías llamarnos pares y, sin embargo, habíamos vivido vidas completamente diferentes...")
	await novel_interface.show_text_only("Durante la Guerra de los Siete Años, Masada se quedó sin mano de obra y comenzó a seleccionar estudiantes recién salidos de la escuela secundaria para asistir a academias militares mejor financiadas.")
	await novel_interface.show_text_only("A los doce años, Emily se matriculó sola en una escuela militar con internado completo sólo para escapar de su asfixiante hogar.")
	await novel_interface.show_text_only("Mientras tanto, Vera fue colocada en la Academia de Estado Mayor de Camberley a una edad temprana porque su padre era un oficial de alto rango de la Fuerza Aérea.")
	await novel_interface.show_text_only("Después de treinta meses de cursos académicos y entrenamiento militar, ambos solicitaron ingreso en el mismo año a la academia militar más elitista de Masada, \"La Torre\".")
	novel_interface.show_character("ren_medical","perspire1")
	await novel_interface.show_dialog("¿“La Torre” es la que tiene una tasa de aceptación inferior al uno por ciento…?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("emilio","smile")
	await novel_interface.show_dialog("Sí. Vera incluso cambió su apellido cuando presentó la solicitud sólo para demostrar que podía ingresar sin conexiones familiares. Eso cabreó muchísimo a su padre.", "Emily")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("\"Dayan\" ni siquiera es un apellido tan raro, pero tuvo que cambiarse el nombre a algo tan exagerado como \"Valkyrie\"...", "Emily")
	await novel_interface.show_dialog("Cuando se publicó la lista de candidatos preseleccionados, los estudiantes y los padres preguntaban quién se suponía que era esa chica \"Valquiria\".", "Emily")
	await novel_interface.show_dialog("Ella estaba parada allí mismo entre la multitud con la cabeza gacha, sonrojada de un rojo brillante. Honestamente fue un poco lamentable~", "Emily")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("¡Ah, lo entiendo! ¡Ese tipo de ejecución chuuni dolorosamente pública!")
	await novel_interface.show_text_only("Espera, ¿por qué lo entiendo...?")
	novel_interface.show_character("valkyrja","shy")
	await novel_interface.show_dialog("¡¡¡Deja de hablar!!!\nLo cambiaré nuevamente después de la graduación...", "Vera")
	await novel_interface.hide_character()
	novel_interface.show_character("emilio","smile")
	await novel_interface.show_dialog("De ninguna manera, me gusta...", "Emily")
	await novel_interface.hide_character()
	novel_interface.show_character("valkyrja","blush")
	await novel_interface.show_dialog("¿Eh?", "Vera")
	await novel_interface.hide_character()
	novel_interface.show_character("emilio","mock")
	await novel_interface.show_dialog("Durante ese examen de combate cuerpo a cuerpo, todo lo que tenía que hacer era gritar \"Lady Valkyrie\" en el ring y Vera perdería la compostura al instante.", "Emily")
	await novel_interface.hide_character()
	novel_interface.show_character("valkyrja","shy")
	await novel_interface.show_dialog("¡¡Cállate!!\nNo me llames así...", "Vera")
	novel_interface.change_expression("angry")
	await novel_interface.show_dialog("¡Lian, ayuda a tirar esa red explosiva hacia allá!", "Vera")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","smile")
	await novel_interface.show_dialog("Sí, Dama Valquiria. No hay problema, Dama Valquiria.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("valkyrja","shy")
	await novel_interface.show_dialog("Oye!!", "Vera")
	await novel_interface.hide_character()
	novel_interface.show_character("emilio","mock")
	await novel_interface.show_dialog("Pfft--jajajajajajajajajajajajaja~", "Emily")
	await novel_interface.hide_character()
	novel_interface.show_character("valkyrja","shy")
	await novel_interface.show_dialog("¿Por qué sigues enseñando a los niños este tipo de cosas?", "Vera")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("...")
	await novel_interface.show_text_only("Cuando terminamos los preparativos entre risas y bromas, la noche había caído por completo.")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_SlumArea.png")
	await novel_interface.show_text_only("El APC entró en la ciudad a través de la antigua zona industrial en el lado este y lentamente se dirigió a un lugar no muy lejos del muro de aislamiento en el lado noreste del centro de la ciudad.")
	await novel_interface.show_text_only("Esta zona parecía ser un barrio pobre. Los edificios que nos rodeaban eran bajos y estaban ruinosos, y sólo funcionaban unas pocas farolas en toda la manzana.")
	await novel_interface.show_text_only("Casi no había peatones en la calle oscura y a lo largo del camino colgaban carteles escritos en cuatro idiomas locales.")
	await novel_interface.show_text_only("El tenue resplandor que se filtraba desde los deteriorados bloques de apartamentos era más tenue que la luz que se derramaba detrás del distante muro de aislamiento.")
	await novel_interface.show_text_only("Sólo las estrellas en lo alto parecían excepcionalmente claras en esta calle.")
	novel_interface.show_character("ren_medical","happy")
	await novel_interface.show_dialog("Vaya--\nLas estrellas son tan brillantes.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("emilio","smile")
	await novel_interface.show_dialog("Este es el lugar~", "Emily")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Emily abrió una puerta de chapa oxidada que daba a la calle, revelando un pequeño patio rodeado de edificios de apartamentos.")
	await novel_interface.show_text_only("Vera hizo retroceder con cuidado el camión hacia el patio y luego estacionó el APC adentro también.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Entramos al oscuro edificio de apartamentos por la entrada del patio. Nada más llegar al segundo piso, vimos una enorme puerta metálica como la entrada a un refugio antiaéreo.")
	await novel_interface.show_text_only("Emily tocó el timbre, dijo en voz baja: \"Soy yo\", y una mujer de unos cuarenta años abrió la puerta y nos dio la bienvenida al interior.")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_ShelterCorridor.png")
	await novel_interface.show_text_only("Lo primero que vi fue un largo pasillo y el aire llevaba un leve aroma a incienso de rosas.")
	await novel_interface.show_text_only("La bombilla desnuda del techo colgaba abiertamente de un casquillo suspendido por cables y, aunque la alfombra era vieja, era evidente que había sido bien cuidada.")
	await novel_interface.show_text_only("Las paredes y puertas del pasillo estaban pintadas de un elegante color azul ultramar y las paredes estaban cubiertas con dibujos infantiles de colores brillantes.")
	await novel_interface.show_text_only("De repente, una niña pequeña asomó la cabeza desde una habitación más al final del pasillo, se aferró al marco de la puerta para mirarnos con curiosidad y luego rápidamente se agachó de nuevo.")
	novel_interface.show_character("ren_medical","worry")
	await novel_interface.show_dialog("(¿Es esto un jardín de infantes?)", "Lian")
	await novel_interface.show_dialog("(No, se siente más como un orfanato...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Al mirar esos dibujos infantiles en la pared, me di cuenta de que algunos de ellos representaban escenas brutales vistas a través de los ojos de un niño...")
	novel_interface.show_character("emilio","smile")
	await novel_interface.show_dialog("Tía Haifa ~", "Emily")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","panic")
	await novel_interface.show_dialog("(¿Tía?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Es muy tarde y aun así viniste hasta aquí. ¿Vera también está aquí?\n¿Y esto es...?", "Haifa")
	novel_interface.show_character("ren_medical","happy")
	await novel_interface.show_dialog("Hola señora. Mi nombre es Lian.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Dios mío, qué chica más bonita. Por cierto, todavía no has comido, ¿verdad?\nIré a traerte algo de la cocina...", "Haifa")
	novel_interface.show_character("emilio","smile")
	await novel_interface.show_dialog("No es necesario. ¿No dijimos la última vez que traeríamos algunos suministros para la comunidad que el ejército planeaba deshacerse de aquí?", "Emily")
	await novel_interface.show_dialog("Las Fuerzas de Defensa han estado reduciendo su personal últimamente y Vera insistió a su padre para que nos consiguiera algunos de los suministros de las unidades desmanteladas.", "Emily")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Siempre estás molestando a tu padre. Ya has traído cosas varias veces... Realmente tendremos que agradecerle en persona algún día.", "Haifa")
	novel_interface.show_character("ren_medical","speechless")
	await novel_interface.show_dialog("(¿Cuántas veces habéis hecho esto ya? No es de extrañar que tengan tanta práctica...)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("valkyrja","panic")
	await novel_interface.show_dialog("No, no, ¡mi papá está demasiado ocupado!", "Vera")
	novel_interface.change_expression("wink")
	await novel_interface.show_dialog("Cuando el ejército se retire, probablemente cueste más transportar algunas de estas cosas a casa que comprarlas nuevamente desde cero.", "Vera")
	await novel_interface.show_dialog("Los procedimientos de eliminación de estas cosas no son exactamente correctos, por eso los trajimos por la noche... Solo diles a todos que no hablen de eso, ¿de acuerdo?", "Vera")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Ah, está bien, está bien. ¿Entonces te ayudo a llevarlos?", "Haifa")
	novel_interface.show_character("emilio","smile")
	await novel_interface.show_dialog("Les llevé a los niños un lote de raciones militares y tabletas. Si pudieras dejarme algo de espacio en el almacén, sería suficiente.", "Emily")
	await novel_interface.show_dialog("La mayor parte del resto son cosas que la estación de socorro del Dr. Hadi puede utilizar. Se lo entregaré en un momento...", "Emily")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("¡Es la hermana mayor Emily!", "Niño A")
	await novel_interface.show_dialog("Hermana mayor Emmie--", "Niño B")
	await novel_interface.show_dialog("Lady Valkyrie también está aquí ~~", "Niño C")
	await novel_interface.show_text_only("Vera se cubrió la cara con una mano, su expresión llena de líneas negras.")
	await novel_interface.show_text_only("Al poco tiempo, más de una docena de niños salieron corriendo uno tras otro de dos grandes dormitorios y nos rodearon.")
	await novel_interface.show_text_only("Obviamente, Emily era una celebridad aquí. Todos los niños lucharon por rodearla y todos parecían encantados.")
	await novel_interface.show_dialog("Hermana mayor, hermana mayor, ¡ya puedo leer lecciones de segundo grado!", "Niño A")
	await novel_interface.show_text_only("Una niña pequeña dijo esto con orgullo mientras sostenía una tableta de tinta electrónica. El modelo parecía lo suficientemente mayor como para tener aproximadamente la misma edad que yo.")
	novel_interface.show_character("emilio","smile")
	await novel_interface.show_dialog("Rima, eso es asombroso. Esta vez les trajimos nuevas tabletas ~", "Emily")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Hermana mayor Emily, ¡ahora puedo hacer malabarismos con una pelota veinte veces!", "Niño B")
	await novel_interface.show_text_only("Un niño pequeño con una camiseta con el número 10 tan grande que se le resbaló de un hombro levantó desesperadamente la mano.")
	novel_interface.show_character("emilio","mock")
	await novel_interface.show_dialog("¡Sigue así, Omar! Algún día serás tú quien aplaste al equipo nacional de Huayungong.", "Emily")
	await novel_interface.hide_character() 
	await novel_interface.show_dialog("Y también, mira, mira lo que dibujé--", "Niño C")
	await novel_interface.show_text_only("Un niño que todavía hablaba un poco confusamente señaló el cuadro más grande en la pared.")
	novel_interface.show_character("emilio","smile")
	await novel_interface.show_dialog("Hasan, eso es realmente bueno...", "Emily")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Para ser honesto, ya había adivinado lo que buscaban cuando vi el manifiesto de suministro antes. Simplemente no sabía que existía un lugar como este...")
	await novel_interface.show_text_only("Los avisos de abajo escritos en varios idiomas locales dejaban claro que se trataba de una zona donde vivían las comunidades étnicas de inmigrantes de Masada.")
	await novel_interface.show_text_only("Obviamente, el área sufría una grave falta de infraestructura y, a juzgar por esa enorme puerta de metal, la criminalidad por aquí probablemente era bastante grave.")
	await novel_interface.show_text_only("Al mirar las sonrisas de los niños, de repente me encontré preocupándome por ese pequeño mocoso...")
	novel_interface.show_character("ren_medical","wry_smile")
	await novel_interface.show_dialog("Emily, um... mi teléfono...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sacó mi teléfono de su bolsillo, luego, después de pensarlo un momento, también sacó un walkie-talkie y se giró para entregármelos a mí.")
	novel_interface.show_character("emilio","normal")
	await novel_interface.show_dialog("Vera y yo bajaremos a trasladar los suministros. Te aferras a la radio. El servicio celular por aquí va y viene...", "Emily")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("La ceremonia de firma del alto el fuego tendrá lugar mañana al amanecer, por lo que las rutas hacia el centro de la ciudad ya están cerradas.", "Emily")
	await novel_interface.show_dialog("Te recuperaremos antes de la tormenta de arena mañana por la mañana ~", "Emily")
	await novel_interface.hide_character()
	await novel_interface.stop_music()
	await novel_interface.hide_background_with_fade()
	await novel_interface.show_text_only("............")
	await novel_interface.show_text_only("...")
	await novel_interface.show_text_only("La oficina del orfanato.")
	novel_interface.change_music("res://assets/audio/music/Sunset.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_ShelterOffice.png")
	await novel_interface.show_text_only("Me acurruqué en la esquina de la pared donde finalmente había logrado obtener señal, agarrando mi teléfono y asintiendo sin parar mientras me disculpaba.")
	await novel_interface.show_dialog("¿Acabas de acordarte de pedirles tu teléfono ahora? \n ¿Tienes idea de qué hora es?", "Mariru")
	await novel_interface.show_dialog("¡Ustedes, idiotas, han estado jugando demasiado!", "Mariru")
	novel_interface.show_character("ren_medical","wail")
	await novel_interface.show_dialog("Eek--!\nS-Lo siento...", "Lian")
	await novel_interface.show_dialog("Entonces...\nTengo que pasar la noche en las afueras de la ciudad hoy, pero regresaré mañana a primera hora...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("¿Durante la noche también?", "Mariru")
	novel_interface.show_character("ren_medical","wail")
	await novel_interface.show_dialog("Emily dijo que todas las rutas hacia el centro de la ciudad están cerradas ahora, probablemente debido al acuerdo de alto el fuego.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("\"Emily\", ¿eh...? Pareces muy cercano a ella.", "Mariru")
	novel_interface.show_character("ren_medical","sob")
	await novel_interface.show_dialog("¡¡N-No!!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Un tonto como tú podría quedar enterrado en el desierto y ni siquiera darse cuenta.", "Mariru")
	novel_interface.show_character("ren_medical","wry_smile")
	await novel_interface.show_dialog("Ah, esos dos misiles de hoy... fuiste tú quien los interceptó, ¿verdad?\n¡¡Gracias, gracias!!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Tch--\nBueno, no puedo decir que hoy haya sido una pérdida total.", "Mariru")
	await novel_interface.show_dialog("El padre de Vera es el Director de Operaciones del Estado Mayor de Masada, uno de los militares de línea dura dentro de las Fuerzas de Defensa.", "Mariru")
	await novel_interface.show_dialog("Son una familia de militares. El bisabuelo de Vera, Moshe Dayan, es prácticamente un nombre muy conocido en Masada.", "Mariru")
	novel_interface.show_character("ren_medical","panic")
	await novel_interface.show_dialog("¿Eh? ¿Es así de impresionante...?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Lo interesante es que también era un arqueólogo aficionado. Supuestamente es el único Masadan que alguna vez dirigió arqueología en la Cueva de Macpela...", "Mariru")
	novel_interface.show_character("ren_medical","worry")
	await novel_interface.show_dialog("La Cueva de Macpela... ese es el lugar donde ocurrió ese incidente hace dos días, ¿verdad?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Después de la Guerra de los Seis Días en 1967, Masada obtuvo el control de Hebrón.", "Mariru")
	await novel_interface.show_dialog("Moshe Dayan, que era ministro de Defensa en ese momento, hizo que una esbelta niña de doce años se arrastrara hasta la cueva de Macpela a través de un hueco desde el exterior.", "Mariru")
	novel_interface.show_character("ren_medical","wry_smile")
	await novel_interface.show_dialog("(¿Por qué suena tan imprudente...?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Pero aquel coleccionista obsesionado no logró ni siquiera sacar de él una sola reliquia. Más tarde, por motivos religiosos, ya no se permitía entrar a nadie...", "Mariru")
	await novel_interface.show_dialog("De todos modos, ese mal genio y esa personalidad de actuar primero parecen ser hereditarios. Su padre también era un piloto intrépido.", "Mariru")
	await novel_interface.show_dialog("Ya era bastante vergonzoso para él que Vera insistiera en postularse para The Tower, la academia para especialistas técnicos. Si la gente también se enterara de lo que hizo su hija hoy...", "Mariru")
	novel_interface.show_character("ren_medical","panic")
	await novel_interface.show_dialog("¿Q-Qué vas a hacer?", "Lian")
	await novel_interface.show_dialog("Esos dos son realmente buenas personas, así que no...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Idiota. Si los atrapan en el camino, necesito preparar algunas monedas de cambio con anticipación.", "Mariru")
	await novel_interface.show_dialog("Los adolescentes en su fase rebelde son un fastidio...", "Mariru")
	novel_interface.show_character("ren_medical","uneasy")
	await novel_interface.show_dialog("Jeje, no te preocupes, estoy bien. ¿Cómo están Annie y la pequeña Stardust?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Después de que te secuestraran, los envié a ambos a la embajada por razones de seguridad.", "Mariru")
	await novel_interface.show_dialog("Suspiro, ahora tengo que volver a explicarles todo a esos viejos del Senado...", "Mariru")
	novel_interface.show_character("ren_medical","smile")
	await novel_interface.show_dialog("Eso está bien entonces~~ ¡Llegaré a la embajada a tiempo mañana!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Ah, claro. Si vas a pasar la noche ahí afuera...", "Mariru")
	novel_interface.show_character("ren_medical","worry")
	await novel_interface.show_dialog("¿Mmm?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Ten cuidado de que ningún hombre te vea mientras te bañas. Según las costumbres de algunos grupos étnicos, es posible que acabes teniendo que casarte con ellos~", "Mariru")
	novel_interface.show_character("ren_medical","wail")
	await novel_interface.show_dialog("¿¡Ja!?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru colgó con un clic seco en el momento en que terminó de hablar.")
	await novel_interface.show_text_only("Al darle vueltas a sus últimas palabras en mi mente, no pude evitar estremecerme.")
	novel_interface.show_character("ren_medical","sob")
	await novel_interface.show_dialog("(¡Qué idiota!)", "Lian")
	await novel_interface.hide_character()
