# stardustdescends_ep03.gd - 星尘降临篇第3话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	stardustdescends_ep03_script()

func play_script():
	pass

func stardustdescends_ep03_script():
	novel_interface.change_music("res://assets/audio/music/Shop.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_NoxRoom.png")
	await novel_interface.show_text_only("Sento-me no canto da cama luxuosa de Nix e ouço sua história.")
	novel_interface.show_character("nyx_full","normal1")
	await novel_interface.show_dialog("Eles trocam minha guarda a cada seis meses. Aqueles dois caras lá fora foram transferidos para cá há menos de três meses.", "Nix")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Mais tarde, você diz aos guardas que acompanhará Lian pessoalmente para casa. Já enviei o carro.", "Mariru")
	await novel_interface.show_dialog("No momento em que esses guardas entrarem no carro, eles serão tratados.", "Mariru")
	novel_interface.show_character("nyx_full","sad")
	await novel_interface.show_dialog("Mas eles têm que apresentar relatórios regularmente. Se não queremos levantar suspeitas, não precisamos da cooperação deles?", "Nix")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aparentemente, Nix não está convencido do atual plano de fuga.")
	novel_interface.show_character("nyx_full","normal1")
	await novel_interface.show_dialog("Todos os guardas enviados aqui para me espionar receberam treinamento rigoroso anti-interrogatório da agência de inteligência externa.", "Nix")
	novel_interface.change_expression("sad")
	await novel_interface.show_dialog("Eu não acho que eles vão cooperar de bom grado...", "Nix")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_full","upset")
	await novel_interface.show_dialog("A agência de inteligência externa?", "Lian")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_Commandments.png")
	await novel_interface.show_text_only("Sim. Também é conhecido como os Sete Mandamentos. Lebona dirige-o agora, mas teve origem nas antigas máfias europeias.")
	await novel_interface.show_text_only("A agência é conhecida por realizar assassinatos impossíveis e por sua obsessão por ternos pretos.")
	await novel_interface.show_text_only("O que realmente tornou a agência lendária, entretanto, é que ela é uma organização independente que responde apenas ao Credo de Lebona.")
	await novel_interface.show_text_only("Nenhum governo o controla e, graças às centenas de casinos que administra em todo o mundo, tem financiamento praticamente ilimitado.")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_NoxRoom.png")
	novel_interface.show_character("ren_full","happy")
	await novel_interface.show_dialog("(Fale sobre hardcore...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Alcancei o nível platina em todos os jogos baseados nesta agência!")
	novel_interface.show_character("ren_full","gratified")
	await novel_interface.show_dialog("Então, se pudéssemos executar o plano de extração com segurança, não precisaríamos apenas resgatar Nix, mas também fazê-lo sem que eles soubessem.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Você não precisa se preocupar com isso.", "Mariru")
	await novel_interface.show_text_only("Mariru sorri com orgulho.")
	await novel_interface.show_dialog("Sempre temos planos especiais para alvos especiais.", "Mariru")
	await novel_interface.show_text_only("Não consigo deixar de imaginar Aya cercada por ferramentas de tortura e se divertindo alegremente...")
	await novel_interface.show_dialog("Uma última verificação, vocês dois. Então, você está pronto!", "Mariru")
	await novel_interface.show_text_only("Mariru acabou e saiu.")
	await novel_interface.show_text_only("O silêncio repentino me faz sentir estranho. Nix, por outro lado, ainda está olhando para meu amplo peito.")
	novel_interface.show_character("nyx_full","smile")
	await novel_interface.show_dialog("Sua voz... eu quase teria sido enganado.", "Nix")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Abaixo a cabeça, envergonhada.")
	novel_interface.show_character("ren_full","shy")
	await novel_interface.show_dialog("Er... obrigado...?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Do que estamos falando, exatamente?")
	await novel_interface.show_text_only("Aya disse algo sobre uma atualização. Parece que sua voz soa mais feminina agora.")
	novel_interface.show_character("ren_full","shy_right")
	await novel_interface.show_dialog("(Por que ela se incomodou em atualizar algo assim?...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Nix se aproxima de repente, sua mão direita alcançando minhas costas.")
	novel_interface.show_character("ren_full","panic")
	await novel_interface.show_dialog("O que você está fazendo...?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sinto ela puxar algo por cima das minhas roupas e instintivamente solto um pequeno suspiro de alívio...")
	novel_interface.show_character("ren_full","awkward")
	await novel_interface.show_dialog("!!!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Não me diga que é a fivela disso...")
	await novel_interface.show_text_only("Antes que eu consiga descobrir o que aconteceu, a mão dela desliza para dentro da minha roupa... e tira meu sutiã preto!!")
	novel_interface.show_character("ren_full","awkward")
	await novel_interface.show_dialog("...", "Lian")
	await novel_interface.show_dialog("...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("...")
	await novel_interface.show_text_only("Aaaaaah!")
	await novel_interface.show_text_only("Ela aperta meu sutiã aqui e ali por um bom tempo, depois me olha em dúvida depois de não conseguir encontrar nenhum dispositivo de troca de voz.")
	await novel_interface.show_text_only("Com o rosto vermelho como uma beterraba, pego meu sutiã e corro para o banheiro.")
	novel_interface.show_character("nyx_full","smile")
	await novel_interface.show_dialog("Você está bem, Lian? Seu estômago está embrulhado?", "Nix")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("Se for essa época do mês, você encontrará o que precisa no armário de remédios.", "Nix")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Nix parece genuinamente preocupado.")
	novel_interface.show_character("ren_full","sob")
	await novel_interface.show_dialog("Não é isso!!!", "Lian")
	await novel_interface.show_dialog("(Boo-hoo!)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.hide_background_with_fade()
	await novel_interface.stop_music()
	await novel_interface.show_text_only("...")
	await novel_interface.show_text_only("Enquanto isso... SID Sala de Comando")
	novel_interface.change_music("res://assets/audio/music/Normal Stage.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	await novel_interface.show_text_only("Aya está examinando uma pilha de documentos em sua mesa. Cinco janelas estão abertas, mudando rapidamente na grande tela à sua frente.")
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("Ei...", "Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aya se vira e olha para a mulher de uniforme.")
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Havia muitas outras maneiras de obter informações daquele caipira...", "Aya")
	await novel_interface.show_dialog("Por que você teve que enviar Lian? Isso só aumenta o risco. Você não está preocupado que ela e Annie comecem a suspeitar de algo?", "Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru verifica os dados em seu celular e sorri.")
	novel_interface.show_character("liliu_uniform1","normal2")
	await novel_interface.show_dialog("Lian está muito animado para suspeitar de qualquer coisa enquanto ela está no quarto de Nix.", "Mariru")
	await novel_interface.show_dialog("Além disso... Para começar, essa foi ideia da Annie.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("O quê?", "Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal2")
	await novel_interface.show_dialog("Tenho certeza que você se lembra.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Soya/Earthperspective.png")
	await novel_interface.show_dialog("Cerca de duas semanas atrás, depois que Lian trouxe Sonya de volta da área de fluxo, onde um Fluxo Espaço-Tempo ocorreu globalmente e durou cerca de 5 segundos.", "Mariru")
	await novel_interface.show_dialog("O sinal era forte, mas não durou muito. Portanto, nenhum país foi capaz de rastrear a sua origem.", "Mariru")
	await novel_interface.show_dialog("A história oficial agora é que ocorreu uma explosão de raios gama perto do sistema solar.", "Mariru")
	await novel_interface.show_dialog("Embora seja inventado, uma coisa é verdade: a humanidade estava perto da extinção.", "Mariru")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.show_character("liliu_uniform1","serious")
	await novel_interface.show_dialog("Mas, o mundo não acabou. Portanto, devemos ter certeza de que ninguém conecte New Opulentia a esse incidente.", "Mariru")
	await novel_interface.show_dialog("O SID tem acompanhado todas as notícias e comunicações.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Até agora, nada de sólido apareceu, mas Annie descobriu algo interessante por meio do rastreamento nas redes sociais.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Annie ficou tão boa, hein? Seu instrutor mencionou que ela também tem trabalhado muito no treinamento físico.", "Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","sigh")
	await novel_interface.show_dialog("Ela tem seus próprios motivos, aquela criança.", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("Lian, no entanto, é uma história totalmente diferente...", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru pega uma lista de todos os jogos que Lian limpou recentemente.")
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("De qualquer forma, Annie encontrou dezenas de postagens publicadas no mesmo dia em que Lian trouxe Sonya de volta. São de pessoas diferentes que tiveram o mesmo sonho estranho durante as sonecas da tarde.", "Mariru")
	await novel_interface.show_dialog("\"Sonhei em cair em um abismo escuro e encontrar meus parentes falecidos.\"", "Mariru")
	await novel_interface.show_dialog("Nenhuma dessas pessoas tinha muitos seguidores, então suas postagens não atraíram muita atenção.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("Sonhos durante as sonecas da tarde...", "Aya")
	novel_interface.change_expression("think")
	await novel_interface.show_dialog("Espere! O Fluxo do Espaço-Tempo aconteceu por volta das 16h, horário New Opulentia!", "Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("Poucas pessoas tiram uma soneca nesse horário e menos ainda publicam seus sonhos online.", "Mariru")
	await novel_interface.show_dialog("Fizemos mais análises. Os endereços físicos de todas essas contas estão dentro de New Opulentia - dentro de um raio de 8 quilômetros.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aya escuta com os olhos brilhantes.")
	novel_interface.show_character("liliu_uniform1","serious")
	await novel_interface.show_dialog("E o centro dessa região é a vila de Nix.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","blush_dizzy")
	await novel_interface.show_dialog("Então realmente pode haver algo especial naquela vila. Quando a Porta do Paraíso se abriu, aquela coisa desencadeou sonhos nas pessoas que estavam dormindo?", "Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aya parece animada.")
	novel_interface.show_character("liliu_uniform1","normal2")
	await novel_interface.show_dialog("Como a princípio eu não tinha certeza, pedi para Annie instalar um sensor Boltzmann no sistema de segurança da villa.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("\"Eu quero ver.\" Aya rapidamente chega até Mariru, mas Mariru coloca a mão no rosto de Aya para impedi-la.")
	await novel_interface.show_text_only("A garota de cabelos grisalhos, infelizmente, tem braços curtos – ela não consegue alcançar Mariru, com as mãos balançando no ar.")
	novel_interface.show_character("ai","blush_dizzy")
	await novel_interface.show_dialog("\"E aí, vamos ver!\" (Eu quero ver!)", "Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal2")
	await novel_interface.show_dialog("Deixarei você ver depois que recuperarmos o sensor. Agora apresse-se e termine a tarefa que o professor Shih lhe deu!", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.stop_music()
	await novel_interface.show_text_only("Então, Mariru sai da sala de comando, olhando para os dados de satélite que está recebendo em seu dispositivo.")
	await novel_interface.show_dialog("(Uma explosão de ondas de rádio de baixa frequência ocorreu quando as testas de Lian e Nix se tocaram anteriormente.)", "Mariru")
	await novel_interface.show_dialog("Mostrou o mesmo padrão das ondas cerebrais humanas durante o sono REM...", "Mariru")
	novel_interface.show_background("res://assets/images/bg/Baizhu/snowfield.png")
	await novel_interface.show_text_only("Quase idêntico ao que aconteceu na Antártida...")

	print("=== 星尘降临篇第3话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
