# stardustdescends_ep05.gd - 星尘降临篇第5话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	stardustdescends_ep05_script()

func play_script():
	pass

func stardustdescends_ep05_script():
	novel_interface.change_music("res://assets/audio/music/Shop.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_Vault.png")
	novel_interface.show_character("ren_full","panic")
	await novel_interface.show_dialog("這裡就是「自由之星」號的金庫嗎……", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("我驚訝地環顧四周，無論天花板、地板還是兩側牆壁，都包覆著光可鑑人的特殊材質金屬板。")
	await novel_interface.show_text_only("我看著手中的金色籌碼，金屬板的顏色與籌碼外殼類似，但隱約散發著一種灰綠色的光澤。")
	await novel_interface.show_text_only("船倉底部的保險箱只有特定的貴賓才能使用，而我剛剛獲得了這個資格。")
	await novel_interface.show_text_only("這裡唯一的出入口是VIP區的電梯，電梯的底部大門厚得像一道牆。")
	await novel_interface.hide_background()
	await novel_interface.show_dialog("（果然這裡完全沒有訊號啊……）", "小憐")
	await novel_interface.show_text_only("耳機從進入電梯起就失去連線了，安妮之前也再三囑咐務必按照之前練習的步驟進行。")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_Vault.png")
	novel_interface.show_character("ren_full","solemn")
	await novel_interface.show_dialog("（第一步，確定監視器癱瘓……OK。）", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("我注意到金庫內幾個監視攝影機的指示燈同時閃了一下，然後都熄滅了。")
	await novel_interface.show_dialog("這位小姐，您的保險箱是1212號，每次開啟都需要您和我們保管的鑰匙一起插入……", "侍者")
	await novel_interface.show_text_only("侍者彬彬有禮地轉身想把鑰匙給我，卻發現我拿著一瓶「香水」正對著他的臉──")
	novel_interface.show_character("ren_full","wry_smile")
	await novel_interface.show_dialog("對不起囉～", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("被迎面噴了一下之後，侍者立刻眼神渙散，似乎想要說點什麼，嘴巴大開卻無法發出聲音。")
	await novel_interface.show_text_only("這種麻醉噴霧是戰研部的新產品，愛衣還在其中添加了能消除大腦抑制作用的藥物。")
	await novel_interface.show_text_only("據說被噴到的人就像被催眠一樣，非常容易接受各種暗示。")
	novel_interface.show_character("ren_full","smile")
	await novel_interface.show_dialog("來，在這站好啊……", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("我小心扶著神情恍惚的侍者走到正對電梯門的位置，在他手中塞入一枚紅色籌碼。")
	novel_interface.show_character("ren_full","solemn")
	await novel_interface.show_dialog("咳咳──", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("我回憶著之前被要求反覆練習的說辭，用堅定的語氣對他說──")
	novel_interface.show_character("ren_full","normal1")
	await novel_interface.show_dialog("你剛才帶我來金庫保險箱，一切都很正常。", "小憐")
	await novel_interface.show_dialog("我存好物品之後，給了你一枚籌碼當作小費。", "小憐")
	novel_interface.change_expression("solemn")
	await novel_interface.show_dialog("當聽到一聲彈指或看到電梯門打開，你就會立刻醒來，並「回憶」起所有的細節。", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("侍者只是目光呆滯地盯著電梯大門。我看著他恍惚的背影，躡手躡腳後退了幾步。")
	novel_interface.show_character("ren_full","stare")
	await novel_interface.show_dialog("（這樣真的就可以了嗎……）", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("雖然莉琉說過人類的大腦很擅長根據簡單的引導和暗示自我腦補……但這也太簡單了吧！？")
	novel_interface.show_character("ren_full","stare")
	await novel_interface.show_dialog("……他到底會「回憶」起什麼啊？", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("我小聲嘟囔著走到保險庫中央，快速把高跟鞋脫掉，整齊地擺在地板上。")
	await novel_interface.show_text_only("然後將耳機和其他金屬物品全部裝入手拿包，放在高跟鞋旁邊。")
	await novel_interface.show_text_only("這個保險庫是一個大型超導靜磁遮蔽艙，能隔絕大部分的輻射和磁場。")
	await novel_interface.show_text_only("萊博娜並未掌握這樣的技術。根據施教授的情報，遮蔽艙是由華雲宮的軍工企業代為製造。")
	await novel_interface.show_text_only("我找到目標貨櫃，每個櫃門上的兩個鎖孔之間都有一個淡淡的雷射蝕刻雲紋。")
	novel_interface.show_character("ren_full","normal1")
	await novel_interface.show_dialog("「0812」號貨櫃……", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("我將兩把陶瓷材質的萬能鑰匙同時插進貨櫃的兩個鎖孔，並啟動了尾部的開關。")
	await novel_interface.show_text_only("法貝拉曾經說過，其實銀行等機構的私人保險箱鑰匙，安全性都很低──")
	await novel_interface.show_text_only("一方面是因為這些機構對保險箱所在金庫的保全能力十分有自信。")
	await novel_interface.show_text_only("更重要的是，那把鑰匙可以讓客戶產生只有自己能打開保險箱的錯覺，付款的時候就會更爽快。")
	novel_interface.show_character("ren_full","stare")
	await novel_interface.show_dialog("（金庫和保全系統提供「安全」，而那把鑰匙卻能提供「安全感」嗎……）", "小憐")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("（這話怎麼那麼像莉琉說的！好討厭……）", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("突然，鎖孔發出「卡噠」一聲，萬能鑰匙調整到位的瞬間，櫃門應聲打開。")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("貨櫃中，正是那塊長度超過1.5公尺的黑色隕石──")
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/APT/livingRoom.png")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("EX級異質物！！？", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("沒錯，就是那塊古代隕石的評級。", "莉琉")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","stare")
	await novel_interface.show_dialog("妳之前不是說過，「EX級」是專門為與宗教相關的異質物制定的評級嗎？", "小憐")
	await novel_interface.show_dialog("因為對教徒有特別的意義，所以EX級的意思是只准收容，不准研究……", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("有些異質物在宗教傳說中擁有弒神的能力。")
	await novel_interface.show_text_only("一旦觸發可能會引起世界末日級災難，所以嚴格禁止任何形式的研究。")
	novel_interface.change_background("res://assets/images/bg/Shot/boySP_news.png")
	await novel_interface.show_text_only("是啊──")
	await novel_interface.show_text_only("之所以我會記得這麼清楚……")
	await novel_interface.show_text_only("因為之前那個頂著我的臉的傢伙偷走的，正是屬於EX級異質物的「天命之矛」。")
	novel_interface.change_background("res://assets/images/bg/APT/livingRoom.png")
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("（我的……臉嗎……）", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("我轉頭看著掛在起居室牆上的鏡子。")
	await novel_interface.show_text_only("好像最近睡覺的時候，我都是以現在這個樣子和聲音出現在夢境中的呢。")
	novel_interface.show_character("liliu_uniform2","speak")
	await novel_interface.show_dialog("EX級並不限於宗教──", "莉琉")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("莉琉的聲音將我從混亂的思緒中帶回現實。")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("根據測定，那塊隕石是4000多年前墜落到地球的，在戰前被埃及的考古學家所發掘。", "莉琉")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_TheMeteorite.png")
	await novel_interface.show_dialog("由於有規則的邊角和平整的外觀，可以斷定絕對不是自然形成。", "莉琉")
	await novel_interface.show_dialog("一開始人們認為那是古埃及的某種石棺，但整塊隕石渾然一體，完全沒有接縫。", "莉琉")
	await novel_interface.show_dialog("數年後，由於異質物而引發的地區衝突升級，那塊隕石就被移至華雲宮城大博物館。", "莉琉")
	await novel_interface.show_dialog("施教授就是研究那塊隕石的主要成員之一。一開始，華雲宮還以為自己撿了個大便宜……", "莉琉")
	await novel_interface.show_dialog("但他們很快就發現，這塊隕石似乎會「激烈地」拒絕所有形式的窺探和入侵──", "莉琉")
	await novel_interface.show_dialog("首先，隕石本身的磁場會週期性地起伏，就像在呼吸一樣，峰值的磁能積接近釹磁鐵。", "莉琉")
	await novel_interface.show_dialog("當它受到射線照射時，磁場會突然暴增，數值甚至高到無法測定。", "莉琉")
	await novel_interface.show_dialog("不僅無法透視其內部，實驗過程中甚至引發了導致整個站點被毀的事故。", "莉琉")
	novel_interface.change_background("res://assets/images/bg/APT/livingRoom.png")
	novel_interface.show_character("anne_normal","happy")
	await novel_interface.show_dialog("……如果直接切開呢？", "安妮")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("雖然隕石的硬度並不高，但任何試圖破壞其物理結構的行為，都會導致它釋放出極高的熱量和輻射。", "莉琉")
	await novel_interface.show_dialog("按照推算，如果強行切割，釋出的能量足以抹平地球上一大片區域。", "莉琉")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("所以才被列為「不准研究」的EX級嗎……", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("由於其性質不穩定，就像一枚不定時炸彈。", "莉琉")
	await novel_interface.show_dialog("華雲宮也千方百計地想甩掉這塊燙手山芋吧，好不容易才說服教廷接手，也獲得了薩蒙頓方面的默許。", "莉琉")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("說到教廷，我想起索婭下午傳來的郵件，是她在聖赦院工房拍的照片。")
	await novel_interface.show_text_only("上次事件之後，索婭說她要回教廷調查一些事情，順便升級「工具」。")
	await novel_interface.show_text_only("那張照片的房間裡堆滿了一看就知道很貴的設備，簡直與戰研部的開發所完全一樣。")
	await novel_interface.show_text_only("除了房間正中拿著雷射焊槍的人所穿的修士服，根本看不出一絲宗教氣息。")
	novel_interface.show_character("ren_battle","speechless")
	await novel_interface.show_dialog("（是不是只要給錢，教廷什麼都敢接手啊……）", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("由於那塊隕石的強烈磁性並不適合使用飛機運輸，唯一保險的方式就是海運。", "莉琉")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("又因為需要經過蘇伊士運河，理論上會違反一長串國際公約……", "莉琉")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_normal","normal1",0.25)
	await novel_interface.show_dialog("所以才會委託萊博娜方面幫忙處理吧？", "安妮")
	novel_interface.character_light(0.35,"normal1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("沒錯，華雲宮還用異質物材料為洪先生的賭船打造了一間超導靜磁遮蔽艙。", "莉琉")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"panic")
	await novel_interface.show_dialog("把這些情報透露給我們，難道說……", "安妮")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("莉琉微笑著點了點頭。")
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("說到有呼吸效應的物品，妳們其實也接觸過──", "莉琉")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("嗯？", "小憐")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_TheLastJudgement.png")
	await novel_interface.show_text_only("我心不在焉地應和著，發現郵件最後是一張照片，內容是索婭在西斯汀教堂拍的壁畫《最後的審判》。")
	await novel_interface.show_text_only("看到她的身體已經能自由進出教堂，我不由得鬆了口氣，順手打開網頁查了查那幅壁畫的資料。")
	await novel_interface.show_dialog("（米開朗基羅……好像和海因理希是同個年代吧。）", "小憐")
	await novel_interface.show_dialog("那個時代的天才們，是不是都對裸體有某種特別的執著啊……", "小憐")
	novel_interface.change_background("res://assets/images/bg/APT/livingRoom.png")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("海因理希的「特斯海姆青金石柱」。", "莉琉")
	await novel_interface.show_dialog("石柱的表面溫度也會週期性地些微起伏，就像呼吸一樣。", "莉琉")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_normal","stare")
	await novel_interface.show_dialog("所以……", "安妮")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("莉琉和安妮同時看向正在玩手機的我，房間忽然安靜了下來。")
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("咳咳。", "莉琉")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","speechless")
	await novel_interface.show_dialog("？", "小憐")
	novel_interface.change_expression("panic")
	await novel_interface.show_dialog("──欸、欸！？", "小憐")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("……")
	novel_interface.change_music("res://assets/audio/music/Shop.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_Vault.png")
	await novel_interface.show_text_only("為了避免再次發生「天堂之門」那樣的事件，莉琉改變了SID的作戰方針。")
	await novel_interface.show_text_only("任何有關EX級異質物的情報都要主動追蹤後續，且專案權級不設上限。")
	await novel_interface.show_text_only("「固守新豐洲是無法阻止末日級災難的，而且我們需要一把打開聯合議會大門的鑰匙。」")
	novel_interface.show_character("ren_full","panic")
	await novel_interface.show_dialog("（話是這麼說啦……）", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("我想到上次在第一大道遇到那群身著黑色特種作戰服的傢伙，不由得打了個冷顫。")
	novel_interface.show_character("ren_full","uneasy")
	await novel_interface.show_dialog("（但、但願鑰匙不會斷在鎖孔裡……）", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("我有點不情願地拉開0812號櫃門，端詳著那塊整顆黑漆漆的隕石。")
	await novel_interface.show_text_only("按照愛衣的說法，這個異質物金屬打造的遮蔽艙能夠以最大程度限制任何魔法的效果。")
	await novel_interface.show_text_only("而且在賭船上空的SID重型運輸機上，裝載了足以發動一場小型戰爭的戰鬥部人員，以應對突發狀況。")
	novel_interface.show_character("ren_full","upset")
	await novel_interface.show_dialog("所以我只要「摸一下」就可以了？", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("不知是緊張還是害怕，我明顯感到體內的血液開始湧動。")
	await novel_interface.show_text_only("我伸出手，慢慢地探向隕石表面，同時緊張地閉上了眼睛。")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("……")
	await novel_interface.show_text_only("…………")
	await novel_interface.show_text_only("似乎，軟綿綿的？")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_Vault.png")
	await novel_interface.show_text_only("我再次睜開眼睛，手掌已經貼在隕石的表面上了，質感堅硬而溫潤。")
	novel_interface.show_character("ren_full","panic")
	await novel_interface.show_dialog("（是幻覺？剛才似乎摸到了軟軟的東西……）", "小憐")
	await novel_interface.hide_character()
