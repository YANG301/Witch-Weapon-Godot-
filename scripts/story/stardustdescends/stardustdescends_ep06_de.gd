	await novel_interface.show_text_only("Hmpf! Emily dreht sich dann um und lächelt mich an.")
	novel_interface.show_character("emilio","mock")
	await novel_interface.show_dialog("Fräulein, kann ich einen Ausweis sehen?", "Emily")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_full","panic")
	await novel_interface.show_dialog("Huh?\n... Oh, natürlich!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ich greife nach meiner Handtasche und suche nach dem „richtigen“ Ausweis. Der SID hat mehrere gefälschte Ausweise für mich vorbereitet.")
	await novel_interface.show_text_only("Wenn Masada mich befragt, sollte ich...\nDas Orange verwenden!")
	await novel_interface.show_text_only("Sie scannt meinen Ausweis auf ihrem tragbaren Gerät und zieht die Augenbrauen hoch.")
	novel_interface.show_character("emilio","smile")
