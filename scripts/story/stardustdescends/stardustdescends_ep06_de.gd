	novel_interface.show_character("ren_full","upset")
	await novel_interface.show_dialog("(Ist dieses Mädchen... eine Hexe?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aber es gibt ein Problem. Dieser Meteor fiel vor über viertausend Jahren auf die Erde und nichts an der Kleidung dieses Mädchens sieht auch nur annähernd so alt aus.")
	novel_interface.show_character("ren_full","normal2")
	await novel_interface.show_dialog("(Vielleicht ist es so etwas wie Henriettes Fall...?)\n(Und hat „dieser“ diese Kleidung auch für sie gemacht?)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("stardust_small","normal1")
	await novel_interface.show_text_only("Es fühlt sich nicht so an. Zum Beispiel ihre Cat-Ear-Kopfhörer? Ich bin mir ziemlich sicher, dass ich sie auf einer Einkaufsseite gesehen habe.")
