	await novel_interface.hide_character()
	novel_interface.show_character("stardust_small","uneasy")
	await novel_interface.show_dialog("Ich bin...", "Kleines Mädchen")
	await novel_interface.show_dialog("Hm...", "Kleines Mädchen")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_full","stare")
	await novel_interface.show_dialog("... Hä?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sie starrt mich an, ohne zu blinzeln, und ihr Gesichtsausdruck wechselt von Selbstgefälligkeit zu Panik.")
	novel_interface.show_character("stardust_small","panic")
	await novel_interface.show_dialog("Ähm... wie war noch mal mein Name?!", "Kleines Mädchen")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_full","perspire1")
	await novel_interface.show_dialog("Du fragst mich??", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("stardust_small","tear")
	await novel_interface.show_dialog("Schrei mich nicht an!", "Kleines Mädchen")
	await novel_interface.show_dialog("Boo-hoo...", "Kleines Mädchen")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Anscheinend habe ich ihr wirklich Angst gemacht. Sie schaut sich hilflos um und macht ein paar zitternde Schritte zurück.")
	await novel_interface.show_text_only("Dann wendet sie sich ab, bedeckt ihren Kopf mit beiden Händen und geht in die Hocke.")
