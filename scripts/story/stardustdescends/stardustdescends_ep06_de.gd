	await novel_interface.show_dialog("(„Das menschliche Gehirn kann selbst auf der Grundlage der einfachsten Anleitung oder Hinweise Details ausfüllen.“ Ich kann nur hoffen, dass es wahr ist ...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sein Gesicht wird rot, Schweiß steht auf seiner Stirn, als wäre er gerade dabei erwischt worden, etwas Unanständiges zu tun.")
