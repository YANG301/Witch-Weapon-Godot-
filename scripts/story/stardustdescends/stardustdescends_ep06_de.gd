	await novel_interface.show_dialog("Wer bist du?...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("stardust_small","pleased")
	await novel_interface.show_dialog("Gut, ich sage es dir noch einmal, also hör gut zu!", "Kleines Mädchen")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sie stemmt die Hände in die Hüften und hebt das Kinn, offensichtlich bereitet sie sich darauf vor, ihren großen Namen zu verkünden.")
	novel_interface.show_character("ren_full","bored")
	await novel_interface.show_dialog("(Die Art, wie sie sich verhält... ich weiß es von irgendwoher...)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("stardust_small","pleased")
	await novel_interface.show_dialog("Ich bin...", "Kleines Mädchen")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_full","uneasy")
