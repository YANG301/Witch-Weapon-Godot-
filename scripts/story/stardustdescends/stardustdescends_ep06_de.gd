	await novel_interface.show_dialog("??", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ich habe immer noch keine Ahnung, was los ist, aber ich kann deutlich spüren, wie dieser kleine Bengel auf mich herabblickt.")
