	await novel_interface.show_dialog("Wir haben nichts gemacht...", "Kellner")
	novel_interface.show_character("emilio","speechless")
	await novel_interface.show_dialog("...", "Emily")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_full","wail")
	await novel_interface.show_dialog("...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Woran genau hat er sich „erinnert“?")
	await novel_interface.show_text_only("Und kann er nicht sehen, dass hier eine dritte Person ist?")
