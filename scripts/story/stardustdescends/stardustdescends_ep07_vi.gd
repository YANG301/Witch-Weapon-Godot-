	await novel_interface.show_dialog("Cô ấy ở ngay cạnh anh à? Theo những gì chúng tôi thấy, anh đã tự mình bước ra khỏi hành lang...", "Annie")
	await novel_interface.show_dialog("Tôi đang tự hỏi làm thế nào mà bạn lại vượt qua được cuộc kiểm tra an ninh nhanh đến vậy - bạn là người đầu tiên bước ra ngoài!", "Annie")
	novel_interface.show_character("ren_full","gratified")
