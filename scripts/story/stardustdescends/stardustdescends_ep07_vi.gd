	await novel_interface.show_text_only("Một chiếc tàu tuần tra Super Dvora Mk neo đậu cạnh tàu đánh bạc, lá cờ Tổ quốc màu xanh trắng treo trên thuyền.")
	novel_interface.show_character("ren_full","smile")
	await novel_interface.show_dialog("Cuối cùng, một chút không khí trong lành!", "Lian")
