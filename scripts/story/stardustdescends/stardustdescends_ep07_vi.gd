	await novel_interface.show_dialog("Tôi đã có vòng tay rồi. Tôi có thể rời đi bây giờ được không?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Vera có chút ngạc nhiên. Cô ấy quét mã vạch trên dây đeo cổ tay của tôi rồi mỉm cười.")
	novel_interface.show_character("valkyrja","wink")
	await novel_interface.show_dialog("Vâng, bạn có thể rời đi.", "Vera")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Tôi cảm thấy nhẹ nhõm. Tôi cũng mừng vì không ai ở tầng này có thể nhìn thấy Stardust.")
	await novel_interface.show_text_only("Ngay khi tôi vừa ra khỏi phòng, một nhân viên sòng bạc đã tiến tới xin lỗi.")
	await novel_interface.show_text_only("Theo ông, Lebona sẽ đàm phán với Masada để đảm bảo không có thông tin khách hàng nào bị rò rỉ.")
	await novel_interface.show_text_only("Tín hiệu trong toàn bộ cabin bị nhiễu. Anh ấy bảo nếu tôi cần gọi điện, tôi có thể sử dụng đường dây cố định của họ hoặc ra boong sau.")
