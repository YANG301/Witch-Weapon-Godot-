	await novel_interface.show_dialog("Ôi, mùi ngọt ngào của tuổi trẻ! Đây có phải là cách bạn có được một cặp thậm chí còn lớn hơn?", "Aya")
	await novel_interface.show_text_only("Hóa ra đó là một cuộc gọi hội nghị—Mariru và một số người khác cũng đang gọi điện...")
	novel_interface.show_character("ren_full","awkward")
	await novel_interface.show_dialog("Họ đang theo dõi tôi à?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Tôi nhìn quanh và không thấy bất kỳ thiết bị giám sát nào. Sau đó tôi nhận ra có lẽ nó đến từ phía trên.")
	novel_interface.show_character("ren_full","shy")
	await novel_interface.show_dialog("(Cảm giác thật kỳ lạ khi có một đôi mắt đang theo dõi từng bước đi của mình...)", "Lian")
