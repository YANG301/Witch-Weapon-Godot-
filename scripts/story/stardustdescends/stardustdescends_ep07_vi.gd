# stardustdescends_ep07.gd - 星尘降临篇第7话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	stardustdescends_ep07_script()

func play_script():
	pass

func stardustdescends_ep07_script():
	novel_interface.change_music("res://assets/audio/music/Shop.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_Vault.png")
	await novel_interface.show_text_only("Lúc này tôi chỉ muốn rời khỏi đây càng nhanh càng tốt. Tôi ra hiệu Stardust rồi đi về phía thang máy.")
	await novel_interface.show_text_only("Cô ấy ngay lập tức hiểu được ý định của tôi và nhanh chóng bắt kịp tôi.")
	await novel_interface.show_text_only("Cô gái nhỏ hình như cảm nhận được sự lo lắng của tôi nên nhẹ nhàng xoa xoa cổ tay tôi.")
	novel_interface.show_character("stardust_small","normal2")
	await novel_interface.show_dialog("(thì thầm) Đừng lo lắng.", "Stardust")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Cảm nhận được bàn tay mềm mại và hơi ấm của cô ấy, tôi dần dần bình tĩnh lại rồi nắm lấy tay cô ấy.")
	novel_interface.show_character("stardust_small","normal2")
	await novel_interface.show_text_only("Dường như chúng tôi đã thiết lập được một mối liên kết đặc biệt giữa chúng tôi. Cô ấy bắt đầu mỉm cười.")
	await novel_interface.show_text_only("Thật kỳ lạ - rốt cuộc thì chúng ta cũng chỉ mới gặp nhau mà thôi.")
	await novel_interface.show_text_only("Ngoài ra, tại sao cả người phục vụ và những người lính đều hoàn toàn phớt lờ cô ấy?")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Trong thang máy, tôi véo vào khuôn mặt mềm mại của cô ấy khi cố gắng tìm hiểu toàn bộ chuyện này. Cô ấy không thích nó.")
	novel_interface.show_character("ren_full","gratified")
	await novel_interface.show_dialog("(Làn da của cô ấy bằng cách nào đó làm tôi bình tĩnh lại...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Có lẽ cô ấy giống Beatrice? Cả hai đều có một sức mạnh đặc biệt mà chính họ cũng không nhận ra?")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_Gambling_Boat3.png")
	await novel_interface.show_text_only("Khi tôi đang cố gắng phân loại tất cả các khả năng, thang máy sẽ đưa chúng tôi trở lại phòng VIP.")
	await novel_interface.show_text_only("Ngay khi cánh cửa mở ra, tôi nhận ra mọi chuyện đã trở nên nghiêm trọng đến mức nào.")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_Gambling_Boat.png")
	await novel_interface.show_text_only("Hàng chục khách và thủy thủ đoàn đã bị binh lính Masadan bắt giữ. Họ được chia thành bốn nhóm và đang xếp hàng chờ kiểm tra an ninh.")
	await novel_interface.show_text_only("Một nhân viên đang sử dụng máy tính bảng quân sự để chụp ảnh tất cả các vị khách bất chấp sự phản đối của họ.")
	await novel_interface.show_text_only("Một thiết bị gây nhiễu đã được lắp đặt trong phòng để ngăn khách gọi điện thoại và giật dây.")
	await novel_interface.show_text_only("Điện thoại và tai nghe của tôi cũng không nhận được bất kỳ tín hiệu nào. Stardust sợ hãi trước những gì nhìn thấy và trốn đằng sau tôi.")
	await novel_interface.show_text_only("Đến lối ra sảnh, một cán bộ đang dùng loa thông báo nội quy kiểm tra an ninh.")
	novel_interface.show_character("valkyrja","normal")
	await novel_interface.show_dialog("Tháo đồng hồ, đồ trang sức và bất kỳ đồ vật kim loại nào khác.", "Sĩ quan")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("Dán mã nhận dạng vào tất cả túi xách và vali của bạn, sau đó mang chúng đến đây để quét.", "Sĩ quan")
	await novel_interface.show_dialog("Nếu mọi thứ đều ổn, bạn sẽ nhận được một dây đeo cổ tay màu xanh. Chỉ những người có vòng tay mới có thể rời khỏi đây.", "Sĩ quan")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_full","panic")
	await novel_interface.show_dialog("Việc kiểm tra an ninh này không phải là chuyện đùa...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Tôi kiểm tra để chắc chắn rằng tôi vẫn còn dây đeo cổ tay.")
	novel_interface.show_character("ren_full","worry")
	await novel_interface.show_dialog("(Vòng tay này ở đây có nghĩa là bây giờ tôi đã an toàn rồi phải không?)", "Lian")
	novel_interface.change_expression("panic")
	await novel_interface.show_dialog("(Tôi sẽ chờ xem để chắc chắn.)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Tôi nhìn xung quanh. Trong số tất cả binh sĩ ở tầng này, chỉ có sĩ quan cầm loa là con gái. Và cũng giống như Emily, cô ấy cũng còn rất trẻ.")
	await novel_interface.show_text_only("Tuy nhiên, tất cả những người lính khác dường như thực sự tôn trọng cô ấy.")
	novel_interface.show_character("ren_full","bored")
	await novel_interface.show_dialog("(Cô ấy trông giống như một học sinh trung học...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Đột nhiên, một người đàn ông to lớn nào đó thoát ra và lao ra lối ra. Anh ta mắng nữ sĩ quan.")
	novel_interface.show_character("miller")
	await novel_interface.show_dialog("Tôi là Tổng Giám mục Miller từ Giáo hội Anh giáo miền Nam Ấn Độ. Bạn không có quyền chất vấn những tôi tớ của Chúa!", "Miller")
	await novel_interface.show_dialog("Ngoài ra, đồng phục của bạn... đó hoàn toàn không phải là đồng phục của Lực lượng Phòng vệ Masada!", "Miller")
	await novel_interface.show_dialog("Thực ra bạn là ai? Ai cho phép hoạt động này?", "Miller")
	await novel_interface.show_dialog("Tôi yêu cầu được nói chuyện với người giám sát của bạn!", "Miller")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Vị tổng giám mục hung hãn đứng trước mặt cô gái trẻ như một ngọn núi nhỏ.")
	novel_interface.show_character("valkyrja","normal2")
	await novel_interface.show_dialog("Ồ, tôi chưa bao giờ nói đây là đồng phục của Lực lượng Phòng vệ Masada. Tôi là Chuẩn úy Vera Valkyrie, sĩ quan chỉ huy tạm thời.", "Sĩ quan")
	novel_interface.change_expression("speechless")
	await novel_interface.show_dialog("Bạn là ai nữa? Ai đó đến từ miền Nam Ấn Độ?\nBạn có phải là thanh tra thuế không?", "Vera")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Vera dường như đã nhận ra điều gì đó.")
	novel_interface.show_character("valkyrja","speechless")
	await novel_interface.show_dialog("Không có gì ngạc nhiên khi bạn lớn... Tôi cho rằng nó đi kèm với lãnh thổ công việc của bạn.", "Vera")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Tuy nhiên, lần trước tôi đã kiểm tra, khu vực đó đang có chiến tranh. Người ta vẫn đóng thuế trong thời chiến?", "Vera")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Cô ấy hoàn toàn phớt lờ khuôn mặt đỏ bừng của tổng giám mục khi cô ấy cầm chiếc máy tính bảng mà một nhân viên đưa cho cô ấy.")
	novel_interface.show_character("valkyrja","happy")
	await novel_interface.show_dialog("Chà, chà, chà... Ai mà nghĩ được. Bạn đang có thị thực lao động tôn giáo.", "Vera")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Vera cười khinh thường rồi nhìn vào bàn roulette.")
	novel_interface.show_character("valkyrja","happy")
	await novel_interface.show_dialog("Một tôi tớ của Chúa. Tôi hiểu rồi... Người như bạn quả thực có thời gian và phương tiện để ăn tất cả những món ăn ngon. Bạn có vui vẻ trong sòng bạc không?", "Vera")
	novel_interface.change_expression("wink")
	await novel_interface.show_dialog("Và ở đây tôi đã nghĩ \"Chúa không chơi xúc xắc.\"", "Vera")
	await novel_interface.hide_character()
	novel_interface.show_character("miller")
	await novel_interface.show_dialog("Đó là sự báng bổ!", "Miller")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Đức tổng giám mục không thể chịu đựng được nữa. Anh ta bắt đầu hét lên khi đến gần Vera, sẵn sàng vận động. Nhưng trước khi anh có thể tiếp cận Vera, cô đã túm lấy cổ áo anh.")
	await novel_interface.show_text_only("Tôi bị sốc bởi những gì tôi nhìn thấy.")
	await novel_interface.show_text_only("Chỉ bằng một tay, Vera nhấc vị tổng giám mục nặng nề lên không trung.")
	novel_interface.show_character("ren_full","panic")
	await novel_interface.show_dialog("(Sức mạnh thật là!)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("valkyrja","speechless")
	await novel_interface.show_dialog("Trong trường hợp bạn không nghe thấy tôi lần đầu tiên...", "Vera")
	novel_interface.change_expression("angry")
	await novel_interface.show_dialog("Tôi không phải là người lính. Tôi là học viên của \"Chương trình Talpiot\" được phân công tới đây vào phút chót.", "Vera")
	await novel_interface.show_dialog("Tôi không muốn bất kỳ điều gì trong số này, nhưng những người trong Ủy ban Quân vụ nghĩ rằng họ có thể ra lệnh cho chúng tôi.", "Vera")
	await novel_interface.show_dialog("Và họ có thể! Mấy hôm nay tôi bực mình vì chuyện này. Nếu bạn vượt qua tôi một lần nữa, tôi sẽ ném bạn xuống biển và cho cá mập ăn bạn!", "Vera")
	await novel_interface.show_dialog("Chúng ta đã rõ chưa?!", "Vera")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Khuôn mặt của tổng giám mục đã chuyển sang màu tím. Không thể nói được, anh vội vàng gật đầu.")
	novel_interface.show_character("valkyrja","angry")
	await novel_interface.show_dialog("Hãy trở lại hàng của bạn!", "Vera")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ngay khi anh ta buông ra, tổng giám mục vội vàng quay trở lại hàng của mình khi lấy lại hơi thở.")
