	await novel_interface.show_dialog("Ờ, xin lỗi...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Tôi cẩn thận bước lại gần và cho cô ấy xem dây đeo cổ tay của mình.")
