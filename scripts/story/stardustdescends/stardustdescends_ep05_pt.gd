# stardustdescends_ep05.gd - 星尘降临篇第5话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	stardustdescends_ep05_script()

func play_script():
	pass

func stardustdescends_ep05_script():
	novel_interface.change_music("res://assets/audio/music/Shop.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_Vault.png")
	novel_interface.show_character("ren_full","panic")
	await novel_interface.show_dialog("Então este é o cofre a bordo da \"Liberty Star\"...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Olho em volta com espanto. O teto, o chão e ambas as paredes são revestidos com painéis de metal espelhados e brilhantes feitos de algum material especial.")
	await novel_interface.show_text_only("Comparo os painéis de metal com a lasca de ouro em minha mão. A cor é semelhante, mas as paredes emitem um leve brilho verde-acinzentado.")
	await novel_interface.show_text_only("Apenas alguns convidados VIP têm permissão para usar os cofres do porão – e acabei de obter esse privilégio.")
	await novel_interface.show_text_only("A única maneira de entrar ou sair é pelo elevador da área VIP, e a porta na parte inferior é tão grossa quanto uma parede.")
	await novel_interface.hide_background()
	await novel_interface.show_dialog("(Não há sinais aqui... Tal como esperado.)", "Lian")
	await novel_interface.show_text_only("Perdi meu comunicador assim que entrei no elevador. Agora, devo fazer tudo exatamente como fiz durante o exercício e não posso errar nem um passo.")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_Vault.png")
	novel_interface.show_character("ren_full","solemn")
	await novel_interface.show_dialog("(Etapa um: confirme se o sistema de vigilância está inativo... OK.)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Percebo várias câmeras dentro do cofre piscando ao mesmo tempo e depois escurecendo.")
	await novel_interface.show_dialog("Senhorita, o seu cofre é o nº 1212. Cada vez que for aberto é necessário inserir tanto a sua chave quanto a nossa...", "Garçom")
	await novel_interface.show_text_only("O garçom educadamente se vira para me entregar a chave, apenas para encontrar um frasco de “perfume” apontado diretamente para seu rosto...")
	novel_interface.show_character("ren_full","wry_smile")
	await novel_interface.show_dialog("Sinto muito!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Depois de uma borrifada no rosto, seus olhos ficam imediatamente opacos. Ele parece querer dizer alguma coisa, mas depois de abrir a boca algumas vezes, nenhum som sai.")
	await novel_interface.show_text_only("Este spray anestésico é um novo produto SRD. Aya ainda adicionou uma droga que remove o controle inibitório do cérebro.")
	await novel_interface.show_text_only("Qualquer pessoa pulverizada por ele entra em um estado hipnótico e se torna extremamente receptivo a sugestões.")
	novel_interface.show_character("ren_full","smile")
	await novel_interface.show_dialog("Venha e fique aqui.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Com cuidado conduzo o garçom atordoado até um lugar de frente para a porta do elevador e coloco uma ficha vermelha em sua mão.")
	novel_interface.show_character("ren_full","solemn")
	await novel_interface.show_dialog("Aham...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Relembrando as falas que me disseram para ensaiar várias vezes, dirijo-me a ele com voz firme...")
	novel_interface.show_character("ren_full","normal1")
	await novel_interface.show_dialog("Você me trouxe aqui para o cofre agora há pouco. Tudo estava normal.", "Lian")
	await novel_interface.show_dialog("Depois de guardar meu item, te dei uma ficha como gorjeta.", "Lian")
	novel_interface.change_expression("solemn")
	await novel_interface.show_dialog("No momento em que você ouvir um estalar de dedos ou ver a porta do elevador se abrir, você acordará e “lembrará” de cada detalhe.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("O garçom não pode dizer nada. Ele apenas olha para a porta do elevador. Eu cuidadosamente me afasto.")
	novel_interface.show_character("ren_full","stare")
	await novel_interface.show_dialog("(Isso é realmente suficiente?...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru disse que o cérebro humano é bom em preencher detalhes a partir de algumas dicas e sugestões simples... mas isso ainda parece fácil demais, não é?!")
	novel_interface.show_character("ren_full","stare")
	await novel_interface.show_dialog("Do que exatamente ele se lembrará?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ainda murmurando para mim mesmo, ando até o meio do cofre, tiro rapidamente os saltos altos e os coloco no chão.")
	await novel_interface.show_text_only("Então coloco meu fone de ouvido e todos os outros objetos de metal na minha bolsa e deixo ao lado dos calcanhares.")
	await novel_interface.show_text_only("Este cofre é uma enorme câmara de blindagem magnética estática supercondutora, capaz de bloquear a maior parte da radiação e dos campos magnéticos.")
	await novel_interface.show_text_only("Lebona não tem tecnologia como essa. De acordo com as informações do Professor Shih, a câmara de blindagem foi encomendada a um fabricante militar no Palácio Hovering.")
	await novel_interface.show_text_only("Eu encontro o contêiner de destino. Entre as duas fechaduras de cada porta há um leve motivo de nuvem gravado a laser.")
	novel_interface.show_character("ren_full","normal1")
	await novel_interface.show_dialog("Recipiente nº 0812...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Insiro duas chaves mestras de cerâmica nas duas fechaduras ao mesmo tempo e aciono os interruptores em suas extremidades.")
	await novel_interface.show_text_only("Fabella disse uma vez que as chaves dos cofres privados em bancos e instituições similares são, na verdade, de segurança muito baixa.")
	await novel_interface.show_text_only("Parte da razão é que essas instituições estão extremamente confiantes na segurança que protege o próprio cofre.")
	await novel_interface.show_text_only("Mais importante ainda, a chave dá aos clientes a ilusão de que só eles podem abrir o cofre, o que torna o pagamento do serviço muito mais fácil.")
	novel_interface.show_character("ren_full","stare")
	await novel_interface.show_dialog("(Então o cofre e o sistema de segurança fornecem “segurança”, enquanto a chave fornece “paz de espírito”...?)", "Lian")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("(Por que isso parece tanto com algo que Mariru diria? Eu odeio isso...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Clique. O cofre está aberto!")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Dentro do contêiner estava o meteorito negro com mais de 1,5 metros de comprimento.")
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/APT/livingRoom.png")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Substância nível EX H?!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Sim, nível EX!", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","stare")
	await novel_interface.show_dialog("Mas lembro que você disse que o nível EX está ligado às religiões.", "Lian")
	await novel_interface.show_dialog("Como são especiais para seguidores religiosos, a Substância H de nível EX pode ser coletada, mas a pesquisa é proibida.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Diz-se que alguma Substância H possui o poder de matar deuses nas lendas religiosas.")
	await novel_interface.show_text_only("Uma vez ativado, pode desencadear um desastre apocalíptico, portanto todas as formas de pesquisa são estritamente proibidas.")
	novel_interface.change_background("res://assets/images/bg/Shot/boySP_news.png")
	await novel_interface.show_text_only("E sim...")
	await novel_interface.show_text_only("A razão pela qual me lembro de tudo isso tão claramente...")
	await novel_interface.show_text_only("É porque a Lança do Destino que ela roubou também era a Substância H de grau EX!")
	novel_interface.change_background("res://assets/images/bg/APT/livingRoom.png")
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("(Ela está falando de mim?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Eu olho para cima e me olho no espelho.")
	await novel_interface.show_text_only("É exatamente como pareço em todos os sonhos que tive ultimamente.")
	novel_interface.show_character("liliu_uniform2","speak")
	await novel_interface.show_dialog("Nível EX A Substância H está conectada a mais do que religiões.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("A voz de Mariru me traz de volta à realidade.")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Nosso teste mostra que o meteorito caiu na Terra há mais de 4 mil anos. Foi escavado por arqueólogos egípcios antes da guerra.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_TheMeteorite.png")
	await novel_interface.show_dialog("Devido aos seus cantos regulares e faces planas, concluiu-se que o meteorito não poderia ter se formado naturalmente.", "Mariru")
	await novel_interface.show_dialog("A princípio as pessoas pensaram que era uma espécie de sarcófago do Antigo Egito, mas aquele meteoro estava inteiro, sem a menor rachadura.", "Mariru")
	await novel_interface.show_dialog("Anos mais tarde, à medida que as questões em torno da Substância H aumentavam, o meteorito foi transferido para o Museu do Palácio Hovering.", "Mariru")
	await novel_interface.show_dialog("O professor Shih foi um dos principais pesquisadores que o estudou. Quando o Hovering Palace recebeu o meteorito pela primeira vez, eles pensaram que tinham tirado a sorte grande.", "Mariru")
	await novel_interface.show_dialog("Mas logo descobriram que o meteorito recusava qualquer forma de sondagem e intrusão.", "Mariru")
	await novel_interface.show_dialog("Para começar, o seu próprio campo magnético flutua periodicamente, quase como a respiração - e no seu pico, o campo é quase tão forte como o de um íman de neodímio.", "Mariru")
	await novel_interface.show_dialog("No momento em que detecta radiação, o seu campo magnético aumenta acentuadamente, atingindo uma intensidade demasiado elevada para ser medida.", "Mariru")
	await novel_interface.show_dialog("O experimento não apenas falhou, como quase explodiu toda a estação de pesquisa.", "Mariru")
	novel_interface.change_background("res://assets/images/bg/APT/livingRoom.png")
	novel_interface.show_character("anne_normal","happy")
	await novel_interface.show_dialog("...E se, digamos, eu tentasse abri-lo?", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("Embora o meteorito em si não seja especialmente duro, qualquer tentativa de danificar sua estrutura faz com que ele emita calor e radiação intensos.", "Mariru")
	await novel_interface.show_dialog("De acordo com nossos cálculos, se alguém o abrisse à força, a energia liberada seria suficiente para destruir metade do planeta.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Não é à toa que a pesquisa é proibida...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Também é extremamente instável – uma bomba-relógio que ninguém sabe quando irá explodir.", "Mariru")
	await novel_interface.show_dialog("O Palácio Hovering tentou de todas as maneiras possíveis se livrar do meteorito. No final, a igreja concordou em assumir o controle e Samonton concedeu permissão.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Falando da igreja. Sonya me enviou um e-mail esta tarde. Em anexo estava uma foto dela na oficina da Penitenciária.")
	await novel_interface.show_text_only("Após o último incidente, Sonya voltou para a igreja. Ela disse que precisava investigar algo e atualizar algumas “ferramentas”.")
	await novel_interface.show_text_only("A sala da foto dela estava cheia de equipamentos caros. Quase confundi com uma instalação SRD.")
	await novel_interface.show_text_only("Se Sonya não estivesse usando seu uniforme de freira, não haveria nada naquela foto que fizesse as pessoas associarem o lugar à religião.")
	novel_interface.show_character("ren_battle","speechless")
	await novel_interface.show_dialog("(Parece que a igreja realmente aceitará qualquer pessoa e qualquer coisa, desde que o preço seja justo...)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("O meteoro não pôde ser transportado por avião devido ao seu forte magnetismo. A única maneira segura era de navio.", "Mariru")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("O que levou a outro problema: uma vez que o navio passasse pelo Canal de Suez, poderia acabar violando toda uma série de convenções internacionais...", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_normal","normal1",0.25)
	await novel_interface.show_dialog("E foi aí que entrou Lebona?", "Annie")
	novel_interface.character_light(0.35,"normal1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Exatamente! O Palácio Flutuante até forneceu a Substância H para construir um cofre seguro na nave para bloquear a radiação e os campos magnéticos.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"panic")
	await novel_interface.show_dialog("E ao vazar toda essa informação para nós...", "Annie")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru acena com a cabeça enquanto confirma a teoria de Annie.")
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("Você já entrou em contato com algo semelhante a este meteorito antes.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("Ah?", "Lian")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_TheLastJudgement.png")
	await novel_interface.show_text_only("Ao responder a ela, já me distraio com uma das fotos do e-mail. É uma foto do Juízo Final, o afresco que Sonya fotografou na Capela Sistina.")
	await novel_interface.show_text_only("Aliviado ao ver que Sonya ainda pode circular livremente pela igreja, começo a procurar informações sobre o afresco.")
	await novel_interface.show_dialog("(Michelangelo... Ele é da mesma época que Henriette.)", "Lian")
	await novel_interface.show_dialog("Parece que todo gênio daquela época tinha uma obsessão por corpos nus...", "Lian")
	novel_interface.change_background("res://assets/images/bg/APT/livingRoom.png")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("\"Pilar Tesheim Lapis\" de Henriette.", "Mariru")
	await novel_interface.show_dialog("A temperatura da superfície do pilar também flutua, assim como a respiração.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_normal","stare")
	await novel_interface.show_dialog("Então...", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Tanto Mariru quanto Annie se viram para olhar para mim. A sala de repente fica em silêncio.")
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("Aham...", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","speechless")
	await novel_interface.show_dialog("?", "Lian")
	novel_interface.change_expression("panic")
	await novel_interface.show_dialog("Hein??", "Lian")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("...")
	novel_interface.change_music("res://assets/audio/music/Shop.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_Vault.png")
	await novel_interface.show_text_only("Para evitar que outro incidente da “Porta do Céu” acontecesse novamente, Mariru mudou o protocolo SID.")
	await novel_interface.show_text_only("É obrigatório acompanhar todas as informações relacionadas à Substância H nível EX.")
	await novel_interface.show_text_only("\"Você não pode salvar o mundo inteiro ficando dentro de New Opulentia. Também precisamos de uma chave para o Conselho Unido.\"")
	novel_interface.show_character("ren_full","panic")
	await novel_interface.show_dialog("(É verdade, mas...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aqueles homens em trajes especiais de combate pretos vêm à minha mente, assim como meu medo.")
	novel_interface.show_character("ren_full","uneasy")
	await novel_interface.show_dialog("(Só espero que minha chave não quebre na fechadura...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Abro relutantemente o cofre nº 0812 e olho para o meteoro negro guardado dentro dele.")
	await novel_interface.show_text_only("De acordo com Aya, a sala em que estou deve ser capaz de resistir até mesmo à feitiçaria mais forte.")
	await novel_interface.show_text_only("Além disso, há uma Unidade de Resposta Tática a bordo deste navio-cassino, pronta para lidar com qualquer tipo de emergência.")
	novel_interface.show_character("ren_full","upset")
	await novel_interface.show_dialog("Então eu só preciso tocá-lo uma vez?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Nervoso ou assustado? Eu não tenho certeza. Mas quase pude sentir meu sangue correndo em minhas veias.")
	await novel_interface.show_text_only("Estico minha mão lentamente em direção ao meteoro e fecho os olhos.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("...")
	await novel_interface.show_text_only("...")
	await novel_interface.show_text_only("Parece... macio?")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_Vault.png")
	await novel_interface.show_text_only("Abro os olhos novamente. Minha palma já está apoiada no meteorito. É duro e ligeiramente úmido.")
	novel_interface.show_character("ren_full","panic")
	await novel_interface.show_dialog("(Isso foi apenas minha imaginação? Eu poderia jurar que toquei em algo macio...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Toco o meteoro novamente. Na verdade, é difícil e plano.")
	await novel_interface.show_text_only("De acordo com o plano original, eu deveria tocar no meteoro apenas uma vez.")
	await novel_interface.show_text_only("Confusa, fecho o cofre e coloco a fechadura de volta no lugar. Então fico parada em silêncio diante dele, ainda tentando descobrir o que senti da primeira vez.")
	novel_interface.show_character("ren_full","upset")
	await novel_interface.show_dialog("(O que foi isso...?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("De repente, um som estranho vem de trás de mim – como um botão caindo no chão.")
	await novel_interface.show_text_only("Nesta pequena sala lacrada, o barulho do objeto rolando pelo chão soa estranhamente claro.")
	novel_interface.show_character("ren_full","normal1")
	await novel_interface.show_dialog("?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Eu me viro – é uma coisinha amarela. Eu vou até lá e pego.")
	await novel_interface.show_text_only("É um pequeno objeto redondo com oito pequenas saliências na superfície.")
	novel_interface.show_character("ren_full","wry_smile")
	await novel_interface.show_dialog("... Caiu do meu vestido?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mas parece o doce konpeito que eu comia quando era pequeno. Por um segundo, quase quero lambê-lo.")
	await novel_interface.show_dialog("Hein?", "???")
	await novel_interface.show_text_only("É a voz de uma menina!")
	novel_interface.show_character("stardust_small","smile")
	await novel_interface.show_dialog("Hein? O que eu deveria estar procurando?", "Stardust")

	print("=== 星尘降临篇第5话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
