# stardustdescends_ep01.gd - 星尘降临篇第1话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	stardustdescends_ep01_script()

func play_script():
	pass

func stardustdescends_ep01_script():
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_Prisoner.png")
	await novel_interface.show_text_only("Có lẽ bạn đã từng nghe câu chuyện kinh điển này rồi...")
	await novel_interface.show_text_only("Một người đàn ông giàu có bị mất cắp đồ quý. Cảnh sát tìm thấy tang vật trong căn phòng mà hai nghi phạm cùng ở, nhưng vẫn không có đủ bằng chứng để kết tội bất kỳ ai.")
	await novel_interface.show_text_only("Vì thế, cảnh sát tách hai nghi phạm ra và đưa cho họ lựa chọn sau:")
	await novel_interface.show_text_only("Nếu một người thú nhận còn người kia im lặng, người thú nhận sẽ được thả tự do, còn người im lặng sẽ bị kết án mười năm tù.")
	await novel_interface.show_text_only("Nếu cả hai cùng im lặng, mỗi người chịu sáu tháng. Nhưng nếu cả hai cùng thú nhận, mỗi người sẽ nhận năm năm tù.")
	await novel_interface.show_text_only("Với hai người trong câu chuyện này, kết quả có lợi nhất cho cả hai mãi mãi vẫn ngoài tầm với--")
	await novel_interface.show_text_only("Bởi dù phía bên kia im lặng hay thú nhận, tự mình thú nhận vẫn luôn dẫn đến kết cục tốt hơn. Thú nhận trở thành chiến lược áp đảo.")
	novel_interface.hide_background()
	await novel_interface.show_text_only("Một số nhà kinh tế học cho rằng trong đời thực, những trò chơi lặp đi lặp lại có thể dạy cho cả hai bên hiểu rằng hợp tác mới là chiến lược tối ưu.")
	novel_interface.show_background("res://assets/images/bg/Shot/storyBGWar.png")
	await novel_interface.show_text_only("Nhưng một số trò chơi không còn chỗ cho vòng thứ hai--")
	await novel_interface.show_text_only("Một khi cả hai bên rơi vào tình trạng nghi ngờ lẫn nhau, họ không bao giờ có thể thoát khỏi 'tình thế tiến thoái lưỡng nan của tù nhân' này...")
	novel_interface.hide_background()
	await novel_interface.show_text_only("<Vùng ngoại ô, New Opulentia>")
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_Manorgate.png")
	await novel_interface.show_text_only("Một chiếc limousine dài dừng ở lối vào khu nhà. Một cô gái ăn mặc sang trọng lúng túng bước ra khỏi ghế sau.")
	novel_interface.show_character("ren_full","upset")
	await novel_interface.show_dialog("Đ-Nơi này--!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Trước mắt tôi là một dinh thự sang trọng theo phong cách châu Âu - một cánh cổng bằng đồng, những tác phẩm điêu khắc tinh xảo, thậm chí cả bãi cỏ và bụi cây được cắt tỉa hoàn hảo.")
	await novel_interface.show_text_only("Tôi không biết có một nơi như vậy tồn tại ở New Opulentia. Khi đang ngắm nhìn khung cảnh đẹp đẽ, tôi nghe thấy giọng nói nghiêm khắc của Mariru từ tai nghe.")
	await novel_interface.show_dialog("Đừng lảng vảng nữa. Bạn gần như đang chảy nước dãi.", "Mariru")
	novel_interface.show_character("ren_full","shy")
	await novel_interface.show_dialog("Được rồi, được rồi...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Tôi thu mình lại và tiến lên một bước - ngay lập tức vấp phải đôi giày của mình.")
	novel_interface.show_character("ren_full","shy")
	await novel_interface.show_dialog("Đôi giày cao gót này quá cao... Và tại sao chiếc váy này lại ngắn đến thế?!", "Lian")
	novel_interface.change_expression("shy_right")
	await novel_interface.show_dialog("(Và nó cũng hơi chật ở phần eo. Gần đây mình đã ăn quá nhiều phải không...?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Hãy nâng cằm lên, đừng cúi xuống. Bạn trông giống như một con tôm hùm.", "Mariru")
	await novel_interface.show_dialog("Đây không phải là ngày đầu tiên bạn làm con gái!", "Mariru")
	await novel_interface.show_text_only("Thật khó chịu--!!")
	await novel_interface.show_text_only("Khi tôi đến gần lối vào biệt thự, một người gác cửa mở cổng và cúi chào tôi.")
	await novel_interface.show_text_only("Tôi cố mỉm cười và cầu nguyện thật nhiều rằng mình sẽ không vấp phải cầu thang lần nữa.")
	novel_interface.hide_background()
	await novel_interface.show_text_only("Thực hiện những bước cẩn thận, tôi bước vào biệt thự và trải qua một loạt kiểm tra an ninh phức tạp. Nội thất của tòa nhà hiện ra trong tầm mắt - và nó thật lộng lẫy.")
	novel_interface.change_music("res://assets/audio/music/Shop.mp3")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_VillaHall.png")
	await novel_interface.show_text_only("Sảnh tuy không lớn nhưng rõ ràng được thiết kế bởi một người có khiếu thẩm mỹ. Ngay cả chiếc đèn trong góc cũng tỏa sáng theo cách mà chỉ đồ cổ mới có thể làm được.")
	await novel_interface.show_text_only("Trong đầu tôi lặp lại những gì đã học hôm qua trong phép xã giao 101. Hóp bụng, ưỡn ngực, cổ thẳng, mỉm cười, mặt hướng về phía trước...")
	novel_interface.show_character("ren_full","uneasy")
	await novel_interface.show_dialog("(Và đừng phá vỡ bất cứ thứ gì!)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Khoảnh khắc tôi bước vào tiền sảnh, những vị khách, tất cả đều ăn mặc sang trọng và thì thầm theo nhóm hai hoặc ba, quay lại nhìn chằm chằm như một.")
	await novel_interface.show_dialog("Wow, Lian, hôm nay trông bạn xinh quá!", "Annie")
	await novel_interface.show_text_only("Theo dõi từng cử động của tôi qua camera giám sát, Annie có vẻ rất phấn khích, mặc dù cô ấy vẫn nhớ giữ giọng nhỏ nhẹ.")
	novel_interface.show_character("ren_full","blush")
	await novel_interface.show_dialog("(Chà, chiếc váy này trông rất đẹp, đúng vậy...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Nhưng tôi là một chàng trai! Ờ!")
	await novel_interface.show_dialog("Những vị khách ở đây đều là những người ưu tú nổi tiếng từ các Thành phố Học viện khác nhau. Nhìn bề ngoài, nơi này điều hành một sòng bạc chỉ dành cho thành viên theo giấy phép đặc biệt của Thượng viện.", "Mariru")
	await novel_interface.show_dialog("Nhưng hoạt động kinh doanh thực sự của trang viên là buôn lậu và buôn bán tình báo. Đây cũng là người bảo lãnh ngầm lớn nhất trong tất cả New Opulentia.", "Mariru")
	novel_interface.show_character("ren_full","upset")
	await novel_interface.show_dialog("Vậy là cậu đang cố gắng thu thập bằng chứng để có thể đột kích nơi này...?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Tôi thì thầm, trong khi mỉm cười và gật đầu với những người xung quanh.")
	await novel_interface.show_dialog("Tôi thực sự đánh giá bạn là thiếu tế nhị như vậy sao?\nHơn nữa, nếu tôi muốn đột kích một nơi, tôi có cần bằng chứng không?", "Mariru")
	await novel_interface.show_text_only("Mariru trả lời. Tôi cá là cô ấy đang đảo mắt khi chúng tôi nói chuyện.")
	await novel_interface.show_dialog("Bạn cần thu hút sự chú ý của mục tiêu trước tiên. Annie sẽ giúp đỡ.", "Mariru")
	novel_interface.show_character("ren_full","upset")
	await novel_interface.show_dialog("Mọi người ở đây dường như đều ở độ tuổi bốn mươi và năm mươi. Rõ ràng tôi là một học sinh trung học... điều đó có đáng nghi không?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("An ninh đã quét bạn và kiểm tra hồ sơ của bạn ngay khi bạn bước vào cổng.", "Mariru")
	await novel_interface.show_dialog("Và đừng lo lắng, bạn sẽ xuất hiện trong hệ thống với tư cách là một học sinh trung học bình thường làm việc bán thời gian trong một quán cà phê hầu gái.", "Mariru")
	novel_interface.show_character("ren_full","panic")
	await novel_interface.show_dialog("Huh?\n(Tại sao một người như thế lại được phép tham gia vào cuộc tụ tập kiểu này?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Tôi cứng người, lo lắng, co rúm người khó chịu trước cái nhìn của những vị khách khác.")
	await novel_interface.show_dialog("Những người như bạn thỉnh thoảng vẫn xuất hiện ở đây. Một số khách rất thích điều đó.", "Mariru")
	await novel_interface.show_text_only("Ý bạn là gì, 'những người như tôi'?!!")
	await novel_interface.show_dialog("Mục tiêu đang ngồi gần góc, cạnh cầu thang. Có vẻ hơi lo lắng.", "Annie")
	await novel_interface.show_text_only("Tôi trôi tới một nơi mà tôi có thể quan sát mục tiêu và lén nhìn qua--")
	novel_interface.show_character("shi","angry")
	await novel_interface.show_dialog("Chết tiệt! Chết tiệt! Chết tiệt!", "???")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mục tiêu là một người đàn ông trung niên đang ôm một chiếc túi. Đầu tóc rối bù, khuôn mặt không chải chuốt. Trông không giống những vị khách khác.")
	await novel_interface.show_text_only("Một chiếc áo khoác cũ, một chiếc áo sơ mi trắng dưới chiếc áo len màu mù tạt, thậm chí cả một chiếc khăn quàng cổ màu xanh lá cây…")
	novel_interface.show_character("ren_full","wail")
	await novel_interface.show_dialog("Đó là Giáo sư Shih?\n(Ông ấy keo kiệt đến mức không thể tin được!)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Ừ, đoán vậy...", "Annie")
	novel_interface.show_character("ren_full","smile")
	await novel_interface.show_dialog("Được rồi.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Vì lý do nào đó, tôi cảm thấy tự tin một cách kỳ lạ về vẻ ngoài của mình ngày hôm nay.")
	await novel_interface.show_text_only("Tôi bước đến trước mặt anh ấy và giả vờ chiêm ngưỡng kính màu trên lầu, lắc lư hông khi đi tới đi lui. Anh chàng vẫn không liếc nhìn tôi một cách đàng hoàng.")
	await novel_interface.show_text_only("Có chút không muốn bỏ cuộc, tôi lén kéo miếng đệm ngực của mình và tiến lại gần hơn, giả vờ kiểm tra cái đầu hươu gắn trên tường.")
	await novel_interface.show_text_only("Anh ta thực sự đã quay đầu đi một cách kinh tởm!!")
	novel_interface.show_character("ren_full","wail")
	await novel_interface.show_dialog("(Anh bạn, cố lên!)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Ừm... xin lỗi, cô--", "Khách nam")
	await novel_interface.show_text_only("Một người đàn ông trung niên trong bộ tuxedo và thắt nơ xuất hiện bên cạnh tôi.")
	await novel_interface.show_dialog("Tôi điều hành một công ty truyền thông ở Newmoridas... Bạn có muốn trò chuyện một chút không?", "Khách nam")
	await novel_interface.show_text_only("Xoa xoa tay, người đàn ông cười rạng rỡ.")
	novel_interface.show_character("ren_full","perspire1")
	await novel_interface.show_dialog("X-Xin lỗi--xin lỗi...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Tôi ôm bụng như bị choáng váng bất ngờ, lẻn vào một góc, gửi cho camera giám sát một ánh mắt tuyệt vọng.")
	await novel_interface.show_text_only("Mục tiêu không có phản ứng gì cả. Cuối cùng tôi chỉ thu hút được một số kẻ lập dị thôi.")
	novel_interface.show_character("ren_full","sob")
	await novel_interface.show_dialog("Tôi dường như không thể thu hút được sự chú ý của anh chàng đó chút nào...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Lian, cậu cứng quá rồi...", "Annie")
	await novel_interface.show_dialog("Hình như anh ấy cũng đang đợi ai đó. Và bất cứ thứ gì trong túi đó đều có vẻ đáng ngờ.", "Annie")
	await novel_interface.show_dialog("Có một thiết bị chụp ảnh trong túi xách của bạn. Vừa rồi chúng tôi đã quét túi của anh ấy - không có thiết bị điện tử bên trong, chỉ có hai mươi hoặc ba mươi trang tài liệu giấy.", "Mariru")
	await novel_interface.show_dialog("Anh ta thực sự là một hóa thạch cũ ...", "Annie")
	novel_interface.show_character("ren_full","normal2")
	await novel_interface.show_dialog("Không phải Aya đã nói thứ này có thể chụp ảnh nội dung của nhiều tài liệu giấy xuyên qua chướng ngại vật sao?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Tôi nhấc chiếc túi xách nặng đến mức đáng kinh ngạc. Bên dưới lớp da sáng chế được khâu cẩn thận, nó chứa đầy những vật dụng nhỏ của SRD.")
	await novel_interface.show_text_only("Điều tuyệt vời nhất là nhờ lớp lót được xử lý đặc biệt nên bằng cách nào đó nó đã vượt qua được cuộc kiểm tra an ninh ở lối vào.")
	await novel_interface.show_dialog("Để chụp ảnh nhiều tờ cùng một lúc, bột kim loại phải được phân tán đều trong không gian để các tia đi qua mỗi trang sẽ có cường độ khác nhau.", "Mariru")
	await novel_interface.show_dialog("Có một viên thuốc nổ kim loại được kích nổ từ xa trong túi của bạn, nhưng đó là rất nhiều trang. Bạn sẽ cần lắc mạnh để bột trải đều.", "Mariru")
	await novel_interface.show_dialog("Viên nang sẽ không phát ra âm thanh khi nó nổ tung phải không? Và anh ấy đang ôm chiếc túi đó như thể nó là báu vật vậy...", "Annie")
	await novel_interface.show_dialog("Bạn không có chất dính có thể làm nổ tung ổ khóa sao?", "Mariru")
	await novel_interface.show_dialog("Âm thanh đó thậm chí còn to hơn!\nVà nếu cô ấy thu hút sự chú ý trong bộ trang phục đó và bị người khác chú ý...", "Annie")
	await novel_interface.show_text_only("Tôi rùng mình khi nhớ lại cái cách gã công ty truyền thông cứ nhìn chằm chằm vào ngực tôi.")
	novel_interface.show_character("ren_full","normal2")
	await novel_interface.show_dialog("Bây giờ tôi đang nghĩ về nó...", "Lian")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Tiền sảnh có vẻ là sự lựa chọn tốt nhất của chúng tôi.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Không có cửa sổ nào cả. Ngay cả kính màu cũng không cho ánh sáng lọt vào, có lẽ để đảm bảo sự riêng tư.")
	novel_interface.show_character("ren_full","gratified")
	await novel_interface.show_dialog("Hai người có thể cắt điện trong phòng này được không?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Có vẻ như cậu đang có ý tưởng táo bạo nào đó đấy, nhóc...", "Mariru")
	await novel_interface.show_text_only("...")
	await novel_interface.show_text_only("Tôi quay lại tiền sảnh và đi dạo bên cạnh Giáo sư, cố gắng tỏ ra tự nhiên.")
	await novel_interface.show_text_only("Đột nhiên, bóng đèn ở phía bên kia cầu thang nhấp nháy—và sau đó, với một tiếng bốp, nó vỡ tan.")
	await novel_interface.show_text_only("Khi tất cả mọi người, bao gồm cả giáo sư, quay đầu lại, tôi nhét một viên thuốc bạc qua lỗ trên túi của ông ấy.")
	await novel_interface.show_text_only("Sau đó, tôi cúi xuống như thể đang điều chỉnh gót chân của mình và nhanh chóng ấn keo vào một chân ghế của anh ấy.")
	novel_interface.show_character("ren_full","uneasy")
	await novel_interface.show_dialog("(Hoàn hảo!)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Tôi ra hiệu “OK” trước camera giám sát và di chuyển ra xa vài bước.")
	novel_interface.hide_background()
	await novel_interface.show_text_only("Một tiếng thịch phát ra từ trần nhà, và ngay lập tức tất cả đèn trong phòng vụt tắt. Giáo sư hét lên.")
