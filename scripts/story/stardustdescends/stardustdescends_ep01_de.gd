# stardustdescends_ep01.gd - 星尘降临篇第1话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	stardustdescends_ep01_script()

func play_script():
	pass

func stardustdescends_ep01_script():
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_Prisoner.png")
	await novel_interface.show_text_only("Diese klassische Geschichte haben Sie sicher schon einmal gehört...")
	await novel_interface.show_text_only("Einem reichen Mann wurden Wertsachen gestohlen. Die Polizei fand das Diebesgut in einem Zimmer, das sich zwei Verdächtige teilten, hatte aber nicht genug Beweise, um einen von beiden zu verurteilen.")
	await novel_interface.show_text_only("Also trennte die Polizei die beiden Verdächtigen und stellte sie vor folgende Wahl:")
	await novel_interface.show_text_only("Wenn einer gesteht und der andere schweigt, kommt der Geständige frei, während der Schweigende zehn Jahre Haft bekommt.")
	await novel_interface.show_text_only("Wenn beide schweigen, erhalten sie jeweils sechs Monate. Gestehen jedoch beide, bekommt jeder von ihnen fünf Jahre.")
	await novel_interface.show_text_only("Für die beiden in dieser Geschichte bleibt das Ergebnis, das für beide zusammen am besten wäre, auf ewig unerreichbar--")
	await novel_interface.show_text_only("Denn ganz gleich, ob die andere Seite schweigt oder gesteht: Selbst zu gestehen führt immer zum besseren Ergebnis. Das Geständnis wird damit zur dominanten Strategie.")
	novel_interface.hide_background()
	await novel_interface.show_text_only("Einige Ökonomen meinen, dass wiederholte Spiele im wirklichen Leben beiden Seiten beibringen können, dass Kooperation die beste Strategie ist.")
	novel_interface.show_background("res://assets/images/bg/Shot/storyBGWar.png")
	await novel_interface.show_text_only("Aber manche Spiele lassen keinen Platz für eine zweite Runde –")
	await novel_interface.show_text_only("Wenn beide Seiten erst einmal in gegenseitigen Verdacht geraten, können sie diesem „Gefangenendilemma“ nicht mehr entkommen...")
	novel_interface.hide_background()
	await novel_interface.show_text_only("<Stadtrand, New Opulentia>")
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_Manorgate.png")
	await novel_interface.show_text_only("Eine Stretchlimousine hält am Eingang des Anwesens. Ein fein gekleidetes Mädchen klettert unbeholfen vom Rücksitz.")
	novel_interface.show_character("ren_full","upset")
	await novel_interface.show_dialog("T-So ein Ort--!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Vor mir stand ein prächtiges Anwesen im europäischen Stil – ein Messingtor, exquisite Skulpturen, sogar der Rasen und die Sträucher waren perfekt geschnitten.")
	await novel_interface.show_text_only("Ich hatte keine Ahnung, dass es einen solchen Ort in New Opulentia gibt. Während ich die schöne Landschaft genieße, höre ich Marirus strenge Stimme aus meinem Ohrhörer.")
	await novel_interface.show_dialog("Hör auf zu gaffen. Du sabberst praktisch.", "Mariru")
	novel_interface.show_character("ren_full","shy")
	await novel_interface.show_dialog("Alles klar, alles klar...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ich sammle mich und mache einen Schritt nach vorne – wobei ich prompt über meine Schuhe stolpere.")
	novel_interface.show_character("ren_full","shy")
	await novel_interface.show_dialog("Diese Absätze sind viel zu hoch... Und warum ist dieser Kleidrock so kurz?!", "Lian")
	novel_interface.change_expression("shy_right")
	await novel_interface.show_dialog("(Und an der Taille ist es auch etwas eng. Habe ich in letzter Zeit zu viel gegessen...?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Kopf hoch, nicht lümmeln. Du siehst aus wie ein Hummer.", "Mariru")
	await novel_interface.show_dialog("Es ist nicht dein erster Tag als Mädchen!", "Mariru")
	await novel_interface.show_text_only("So nervig--!!")
	await novel_interface.show_text_only("Als ich mich dem Eingang der Villa nähere, öffnet ein Türsteher die Tore und verbeugt sich vor mir.")
	await novel_interface.show_text_only("Ich zwinge mich zu einem Lächeln und bete inständig, dass ich nicht noch einmal auf der Treppe stolpere.")
	novel_interface.hide_background()
	await novel_interface.show_text_only("Mit vorsichtigen Schritten betrete ich die Villa und durchlaufe eine Reihe komplizierter Sicherheitskontrollen. Das Innere des Gebäudes kommt zum Vorschein – und es ist wunderschön.")
	novel_interface.change_music("res://assets/audio/music/Shop.mp3")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_VillaHall.png")
	await novel_interface.show_text_only("Die Lobby ist zwar nicht besonders groß, wurde aber offensichtlich von jemandem mit Geschmack gestaltet. Sogar die Lampe in der Ecke glänzt wie nur eine Antiquität.")
	await novel_interface.show_text_only("In meinem Kopf wiederhole ich, was ich gestern in Etikette 101 gelernt habe. Brust raus, Bauch rein, Hals gerade, lächeln, Gesicht nach vorne ...")
	novel_interface.show_character("ren_full","uneasy")
	await novel_interface.show_dialog("(Und nichts kaputt machen!)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("In dem Moment, in dem ich die Lobby betrete, drehen sich die Gäste, alle bis ins kleinste Detail gekleidet und in Zweier- und Dreiergruppen flüsternd, um und starren wie ein Mann.")
	await novel_interface.show_dialog("Wow, Lian, du siehst heute hübsch aus!", "Annie")
	await novel_interface.show_text_only("Annie beobachtet jede meiner Bewegungen von der Überwachungskamera aus und hört sich aufgeregt an, obwohl sie daran denkt, ihre Stimme leise zu halten.")
	novel_interface.show_character("ren_full","blush")
	await novel_interface.show_dialog("(Nun, dieses Kleid sieht wirklich schön aus, das stimmt ...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aber ich bin ein Typ! Pfui!")
	await novel_interface.show_dialog("Die Gäste hier sind allesamt berühmte Eliten aus den verschiedenen Akademiestädten. Oberflächlich betrachtet betreibt dieser Ort ein Casino nur für Mitglieder unter einer speziellen Senatslizenz.", "Mariru")
	await novel_interface.show_dialog("Aber das eigentliche Geschäft des Herrenhauses ist Schmuggelware und Geheimdiensthandel. Es ist auch der größte Underground-Garant in ganz New Opulentia.", "Mariru")
	novel_interface.show_character("ren_full","upset")
	await novel_interface.show_dialog("Sie versuchen also, Beweise zu sammeln, damit Sie diesen Ort überfallen können ...?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ich flüstere, während ich die Menschen um mich herum lächle und ihnen zunicke.")
	await novel_interface.show_dialog("Komme ich Ihnen wirklich so taktlos vor?\nAußerdem, wenn ich einen Ort überfallen wollte, bräuchte ich dann Beweise?", "Mariru")
	await novel_interface.show_text_only("Mariru antwortet. Ich wette, sie verdreht die Augen, während wir reden.")
	await novel_interface.show_dialog("Sie müssen zuerst die Aufmerksamkeit des Ziels auf sich ziehen. Annie wird helfen.", "Mariru")
	novel_interface.show_character("ren_full","upset")
	await novel_interface.show_dialog("Alle hier scheinen in den Vierzigern oder Fünfzigern zu sein. Ich bin offensichtlich ein Gymnasiast... wäre das nicht verdächtig?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Der Sicherheitsdienst hat Sie bereits gescannt und Ihre Unterlagen überprüft, sobald Sie die Tore betreten haben.", "Mariru")
	await novel_interface.show_dialog("Und keine Sorge, Sie werden im System als normaler Oberstufenschüler auftauchen, der Teilzeit in einem Dienstmädchencafé arbeitet.", "Mariru")
	novel_interface.show_character("ren_full","panic")
	await novel_interface.show_dialog("Huh?\n(Warum sollte jemand wie er zu so einer Versammlung zugelassen werden?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ich erstarre, bin nervös und schaudere unbehaglich unter den Blicken der anderen Gäste.")
	await novel_interface.show_dialog("Leute wie Sie tauchen von Zeit zu Zeit hier auf. Manche Gäste mögen so etwas sehr.", "Mariru")
	await novel_interface.show_text_only("Was meinst du mit „Leute wie ich“?!!")
	await novel_interface.show_dialog("Das Ziel sitzt in der Nähe der Ecke bei der Treppe. Sieht etwas nervös aus.", "Annie")
	await novel_interface.show_text_only("Ich schwebe zu einer Stelle, von der aus ich das Ziel beobachten und einen flüchtigen Blick darüber werfen kann …")
	novel_interface.show_character("shi","angry")
	await novel_interface.show_dialog("Verdammt! Verdammt! Verdammt!", "???")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Das Ziel ist ein Mann mittleren Alters, der eine Tasche umarmt. Sein Haar ist durcheinander, die Gesichtsbehaarung ungepflegt. Sieht den anderen Gästen überhaupt nicht ähnlich.")
	await novel_interface.show_text_only("Ein alter Mantel, ein weißes Hemd unter einem senffarbenen Pullover und sogar ein grüner Schal ...")
	novel_interface.show_character("ren_full","wail")
	await novel_interface.show_dialog("Das ist Professor Shih?\n(Er ist unglaublich kitschig!)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Ja, das schätze ich...", "Annie")
	novel_interface.show_character("ren_full","smile")
	await novel_interface.show_dialog("Alles klar.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aus irgendeinem Grund war ich seltsam zuversichtlich, wie ich heute aussah.")
	await novel_interface.show_text_only("Ich gehe vor ihn und tue so, als würde ich die Buntglasfenster oben bewundern, während ich mit den Hüften auf und ab gehe. Der Typ wirft mir immer noch keinen richtigen Blick zu.")
	await novel_interface.show_text_only("Da ich ein wenig nicht bereit bin aufzugeben, ziehe ich heimlich an meinen Brustpolstern und schleiche mich näher heran, wobei ich so tue, als würde ich den aufgesetzten Hirschkopf an der Wand untersuchen.")
	await novel_interface.show_text_only("Er drehte tatsächlich angewidert den Kopf weg!!")
	novel_interface.show_character("ren_full","wail")
	await novel_interface.show_dialog("(Alter, komm schon!)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Ähm... entschuldigen Sie, Miss--", "Männlicher Gast")
	await novel_interface.show_text_only("An meiner Seite erscheint ein Mann mittleren Alters im Smoking und mit Fliege.")
	await novel_interface.show_dialog("Ich leite ein Medienunternehmen in Newmoridas... Möchten Sie ein wenig chatten?", "Männlicher Gast")
	await novel_interface.show_text_only("Der Mann reibt sich die Hände und strahlt fröhlich.")
	novel_interface.show_character("ren_full","perspire1")
	await novel_interface.show_dialog("S-Entschuldigung--entschuldigen Sie...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ich halte meinen Bauch, als wäre mir plötzlich schwindlig geworden, und schleiche mich in eine Ecke, wo ich der Überwachungskamera einen verzweifelten Blick zuwerfe.")
	await novel_interface.show_text_only("Das Ziel reagierte überhaupt nicht. Am Ende habe ich nur einen Spinner angezogen.")
	novel_interface.show_character("ren_full","sob")
	await novel_interface.show_dialog("Ich schaffe es überhaupt nicht, die Aufmerksamkeit dieses Kerls zu erregen ...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Lian, du bist viel zu steif...", "Annie")
	await novel_interface.show_dialog("Er scheint auch auf jemanden zu warten. Und was auch immer in dieser Tasche ist, sieht verdächtig aus.", "Annie")
	await novel_interface.show_dialog("In Ihrer Handtasche befindet sich ein bildgebendes Gerät. Wir haben gerade seine Tasche gescannt – keine Elektronik darin, nur zwanzig oder dreißig Seiten Papierdokumente.", "Mariru")
	await novel_interface.show_dialog("Er ist wirklich ein altes Fossil...", "Annie")
	novel_interface.show_character("ren_full","normal2")
	await novel_interface.show_dialog("Hat Aya nicht gesagt, dass dieses Ding den Inhalt mehrerer Papierdokumente durch Hindernisse hindurch fotografieren kann?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ich hebe die überraschend schwere Handtasche. Unter dem sorgfältig genähten Lackleder stecken kleine Gadgets von SRD.")
	await novel_interface.show_text_only("Das Erstaunlichste daran ist, dass es dank seines speziell behandelten Futters die Sicherheitskontrolle am Eingang irgendwie bestanden hat.")
	await novel_interface.show_dialog("Um mehrere Blätter gleichzeitig zu fotografieren, muss Metallpulver gleichmäßig im Raum verteilt werden, sodass die durch jede Seite fallenden Strahlen am Ende unterschiedliche Intensitätsniveaus haben.", "Mariru")
	await novel_interface.show_dialog("In Ihrer Tasche befindet sich eine ferngezündete Metallpulverkapsel, aber das sind viele Seiten. Sie müssen es kräftig schütteln, damit sich das Pulver gleichmäßig verteilt.", "Mariru")
	await novel_interface.show_dialog("Macht die Kapsel kein Geräusch, wenn sie platzt? Und er hat diese Tasche umarmt, als wäre sie ein Schatz ...", "Annie")
	await novel_interface.show_dialog("Haben Sie keine Haftladung, die ein Türschloss aufsprengen kann?", "Mariru")
	await novel_interface.show_dialog("Das ist noch lauter!\nUnd wenn sie in diesem Outfit die Aufmerksamkeit auf sich zieht und die falschen Leute es bemerken ...", "Annie")
	await novel_interface.show_text_only("Ein Schauder durchläuft mich, als ich mich daran erinnere, wie dieser Medienkonzern-Fieber immer wieder auf meine Brust gestarrt hat.")
	novel_interface.show_character("ren_full","normal2")
	await novel_interface.show_dialog("Jetzt wo ich darüber nachdenke...", "Lian")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Die Lobby scheint unsere beste Wahl zu sein.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Es gibt keine Fenster. Selbst das farbige Glas lässt kein Licht herein, wahrscheinlich um Privatsphäre zu gewährleisten.")
	novel_interface.show_character("ren_full","gratified")
	await novel_interface.show_dialog("Könnt ihr zwei den Strom in diesem Raum abschalten?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Hört sich an, als hättest du etwas Mutiges im Sinn, Junge ...", "Mariru")
	await novel_interface.show_text_only("...")
	await novel_interface.show_text_only("Ich kehre in die Lobby zurück, schlendere am Professor vorbei und versuche, mich natürlich zu verhalten.")
	await novel_interface.show_text_only("Plötzlich blinkt die Glühbirne auf der anderen Seite der Treppe – und dann zerspringt sie mit einem Knall.")
	await novel_interface.show_text_only("Kaum drehen alle, auch der Professor, den Kopf, stecke ich eine silberne Kapsel durch die Öffnung seiner Tasche.")
	await novel_interface.show_text_only("Dann gehe ich in die Hocke, als würde ich meine Fersen anpassen, und drücke die Klebeladung schnell gegen ein Bein seines Stuhls.")
	novel_interface.show_character("ren_full","uneasy")
	await novel_interface.show_dialog("(Perfekt!)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ich mache ein „OK“-Zeichen an der Überwachungskamera und gehe ein paar Schritte weg.")
	novel_interface.hide_background()
	await novel_interface.show_text_only("Ein dumpfer Schlag ertönt von der Decke und augenblicklich gehen alle Lichter im Raum aus. Der Professor schreit.")
	await novel_interface.show_text_only("Bevor irgendjemand reagieren kann, bricht ein Stuhlbein und der Professor fällt zu Boden.")
	await novel_interface.show_text_only("Im stockdunklen Raum richte ich die Scanseite meiner Tasche auf die Akten und bete insgeheim, dass das Gerät so funktioniert, wie es soll.")
	await novel_interface.show_text_only("Die Gäste geraten in Verwirrung. Ein Butler stürmt herein, um alle zu beruhigen und sagt, dass der Strom für einen Moment wieder da sein wird.")
	await novel_interface.show_dialog("Es funktioniert.", "Mariru")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_VillaHall.png")
	await novel_interface.show_text_only("Ich atme erleichtert aus. Sobald ich die Tasche abstelle, gehen die Lichter wieder an.")
	novel_interface.show_character("ren_full","uneasy")
	await novel_interface.show_dialog("Ja!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Alles erledigt!")
	await novel_interface.show_dialog("Heh, ihr zwei...", "???")
	await novel_interface.show_text_only("Eine weibliche Stimme... hinter mir.")
	novel_interface.show_character("nyx_full","normal1")
	await novel_interface.show_dialog("Ich habe von oben zugesehen. Was machst du hier unten, versuchst du die Leute zu verführen?", "Nix")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_full","panic")
	await novel_interface.show_dialog("... Nix?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Das ältere Mädchen wirft einen Blick auf den Professor, der neben uns sitzt und sich den Hintern reibt.")
	novel_interface.show_character("nyx_full","normal1")
	await novel_interface.show_dialog("Dieser Stuhl ist mindestens hundertdreißig Jahre alt. Experten gehen von einem Wert von mehr als zwei Millionen aus.", "Nix")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_full","upset")
	await novel_interface.show_dialog("Huh...?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Nix dreht sich um und legt eine Hand auf meine Wange.")
	novel_interface.show_character("nyx_full","smile")
	await novel_interface.show_dialog("Du bist heute sehr hübsch gekleidet, Süße.", "Nix")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ihr kalter Finger zieht eine Linie über mein Gesicht und erreicht meinen Knochenleitungs-Ohrhörer, den sie mit einem kalten Lächeln zurücknimmt.")
	novel_interface.show_character("nyx_full","mock")
	await novel_interface.show_dialog("... Wie wollen Sie das bezahlen?", "Nix")

	print("=== 星尘降临篇第1话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
