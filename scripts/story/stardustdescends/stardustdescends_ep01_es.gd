# stardustdescends_ep01.gd - 星尘降临篇第1话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	stardustdescends_ep01_script()

func play_script():
	pass

func stardustdescends_ep01_script():
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_Prisoner.png")
	await novel_interface.show_text_only("Seguro que ya has oído esta historia clásica...")
	await novel_interface.show_text_only("A un hombre rico le robaron sus objetos de valor. La policía encontró el botín en una habitación compartida por dos sospechosos, pero no tenía pruebas suficientes para condenar a ninguno de los dos.")
	await novel_interface.show_text_only("Así que la policía separó a los dos sospechosos y les planteó la siguiente elección:")
	await novel_interface.show_text_only("Si uno confiesa y el otro guarda silencio, el primero queda libre y el segundo recibe diez años de prisión.")
	await novel_interface.show_text_only("Si ambos guardan silencio, cada uno recibe seis meses. Pero si ambos confiesan, cada uno recibe cinco años.")
	await novel_interface.show_text_only("Para las dos personas de esta historia, el resultado que más beneficia a ambos siempre queda fuera de su alcance...")
	await novel_interface.show_text_only("Porque, tanto si la otra parte guarda silencio como si confiesa, confesar uno mismo siempre conduce a un resultado mejor. Confesar se convierte en la estrategia dominante.")
	novel_interface.hide_background()
	await novel_interface.show_text_only("Algunos economistas sostienen que, en la vida real, los juegos repetidos pueden enseñar a ambas partes que cooperar es la mejor estrategia.")
	novel_interface.show_background("res://assets/images/bg/Shot/storyBGWar.png")
	await novel_interface.show_text_only("Pero algunos juegos no dejan espacio para una segunda ronda.")
	await novel_interface.show_text_only("Una vez que ambas partes caen en sospechas mutuas, nunca podrán escapar de este \"dilema del prisionero\"...")
	novel_interface.hide_background()
	await novel_interface.show_text_only("<Afueras, New Opulentia>")
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_Manorgate.png")
	await novel_interface.show_text_only("Una limusina se detiene a la entrada de la finca. Una chica elegantemente vestida sale torpemente del asiento trasero.")
	novel_interface.show_character("ren_full","upset")
	await novel_interface.show_dialog("¡E-Este tipo de lugar--!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ante mí se alzaba una lujosa finca de estilo europeo: una puerta de latón, esculturas exquisitas e incluso el césped y los arbustos recortados a la perfección.")
	await novel_interface.show_text_only("No tenía idea de que existía un lugar así en New Opulentia. Mientras observo el hermoso paisaje, escucho la voz severa de Mariru en mi auricular.")
	await novel_interface.show_dialog("Deja de quedarte boquiabierto. Estás prácticamente babeando.", "Mariru")
	novel_interface.show_character("ren_full","shy")
	await novel_interface.show_dialog("Está bien, está bien...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Me recobro y doy un paso adelante, tropezando rápidamente con mis zapatos.")
	novel_interface.show_character("ren_full","shy")
	await novel_interface.show_dialog("Estos tacones son demasiado altos... ¡¿Y por qué esta falda del vestido es tan corta?!", "Lian")
	novel_interface.change_expression("shy_right")
	await novel_interface.show_dialog("(Y también me queda un poco apretado en la cintura. ¿He estado comiendo demasiado últimamente...?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Ánimo, no te encorves. Pareces una langosta.", "Mariru")
	await novel_interface.show_dialog("¡No es tu primer día como niña!", "Mariru")
	await novel_interface.show_text_only("¡¡Qué molesto--!!")
	await novel_interface.show_text_only("Cuando me acerco a la entrada de la villa, un portero abre las puertas y me hace una reverencia.")
	await novel_interface.show_text_only("Fuerzo una sonrisa y rezo mucho para no volver a tropezar con las escaleras.")
	novel_interface.hide_background()
	await novel_interface.show_text_only("Tomando medidas cuidadosas, entro a la villa y paso por una serie de complicados controles de seguridad. El interior del edificio aparece a la vista y es precioso.")
	novel_interface.change_music("res://assets/audio/music/Shop.mp3")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_VillaHall.png")
	await novel_interface.show_text_only("El vestíbulo, aunque no es muy grande, está evidentemente diseñado por alguien con buen gusto. Incluso la lámpara del rincón brilla como sólo una antigüedad podría hacerlo.")
	await novel_interface.show_text_only("En mi cabeza, repito lo que aprendí ayer en etiqueta 101. Pecho hacia afuera, estómago hacia adentro, cuello recto, sonrisa, cara hacia adelante...")
	novel_interface.show_character("ren_full","uneasy")
	await novel_interface.show_dialog("(¡Y no rompas nada!)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("En el momento en que entro al vestíbulo, los invitados, todos vestidos de punta en blanco y susurrando de dos en dos y de tres en tres, se giran para mirar como uno solo.")
	await novel_interface.show_dialog("¡Guau, Lian, estás guapa hoy!", "Annie")
	await novel_interface.show_text_only("Al observar cada uno de mis movimientos desde la cámara de vigilancia, Annie parece emocionada, aunque recuerda mantener la voz baja.")
	novel_interface.show_character("ren_full","blush")
	await novel_interface.show_dialog("(Bueno, este vestido se ve muy bonito, eso es verdad...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("¡Pero soy un chico! ¡Puaj!")
	await novel_interface.show_dialog("Los invitados aquí son todas las élites famosas de las distintas Ciudades Academia. A primera vista, este lugar gestiona un casino exclusivo para miembros con una licencia especial del Senado.", "Mariru")
	await novel_interface.show_dialog("Pero el verdadero negocio de la mansión es el contrabando y el comercio de inteligencia. También es el mayor garante clandestino de todo New Opulentia.", "Mariru")
	novel_interface.show_character("ren_full","upset")
	await novel_interface.show_dialog("¿Entonces estás tratando de reunir pruebas para poder asaltar este lugar...?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Susurro, mientras sonrío y asiento con la cabeza a las personas que me rodean.")
	await novel_interface.show_dialog("¿Realmente te parezco tan falto de tacto?\nAdemás, si quisiera asaltar un lugar, ¿necesitaría pruebas?", "Mariru")
	await novel_interface.show_text_only("Mariru responde. Apuesto a que está poniendo los ojos en blanco mientras hablamos.")
	await novel_interface.show_dialog("Primero debes atraer la atención del objetivo. Annie te ayudará.", "Mariru")
	novel_interface.show_character("ren_full","upset")
	await novel_interface.show_dialog("Todos aquí parecen tener entre cuarenta y cincuenta años. Obviamente soy un estudiante de secundaria... ¿no sería sospechoso?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("La seguridad ya lo escaneó y verificó sus registros en el momento en que ingresó por las puertas.", "Mariru")
	await novel_interface.show_dialog("Y no te preocupes, aparecerás en el sistema como un estudiante normal de secundaria que trabaja a tiempo parcial en un café de limpieza.", "Mariru")
	novel_interface.show_character("ren_full","panic")
	await novel_interface.show_dialog("¿Eh?\n(¿Por qué se permitiría a alguien así en este tipo de reunión?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Me quedo congelada, nerviosa, encogiéndome incómodamente bajo la mirada de los demás invitados.")
	await novel_interface.show_dialog("Gente como usted aparece aquí de vez en cuando. A algunos invitados les gustan mucho ese tipo de cosas.", "Mariru")
	await novel_interface.show_text_only("¡¿Qué quieres decir con 'gente como yo'?!!")
	await novel_interface.show_dialog("El objetivo está sentado cerca de la esquina, junto a las escaleras. Parece un poco nervioso.", "Annie")
	await novel_interface.show_text_only("Me deslizo hasta un lugar donde puedo observar el objetivo y echar un vistazo furtivo...")
	novel_interface.show_character("shi","angry")
	await novel_interface.show_dialog("¡Maldita sea! ¡Maldita sea! ¡Maldita sea!", "???")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("El objetivo es un hombre de mediana edad que abraza un bolso. Su cabello es un desastre, el vello facial descuidado. No se parece en nada a los demás invitados.")
	await novel_interface.show_text_only("Un abrigo viejo, una camisa blanca debajo de un jersey color mostaza y hasta una bufanda verde...")
	novel_interface.show_character("ren_full","wail")
	await novel_interface.show_dialog("¿Ese es el profesor Shih?\n(¡Es increíblemente vulgar!)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Sí, supongo que sí...", "Annie")
	novel_interface.show_character("ren_full","smile")
	await novel_interface.show_dialog("Muy bien.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Por alguna razón, me sentí extrañamente seguro de cómo me veía hoy.")
	await novel_interface.show_text_only("Camino frente a él y pretendo admirar las vidrieras de arriba, balanceando mis caderas mientras camino de un lado a otro. El chico todavía no me mira adecuadamente.")
	await novel_interface.show_text_only("Un poco reacio a rendirme, secretamente tiro de las almohadillas de mi pecho y me acerco, pretendiendo examinar la cabeza de ciervo montada en la pared.")
	await novel_interface.show_text_only("¡¡De hecho giró la cabeza con disgusto!!")
	novel_interface.show_character("ren_full","wail")
	await novel_interface.show_dialog("(Amigo, ¡vamos!)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Um... disculpe, señorita...", "Invitado masculino")
	await novel_interface.show_text_only("Un hombre de mediana edad con esmoquin y pajarita aparece a mi lado.")
	await novel_interface.show_dialog("Dirijo una empresa de medios en Newmoridas... ¿Te interesaría charlar un rato?", "Invitado masculino")
	await novel_interface.show_text_only("Frotándose las manos, el hombre sonríe alegremente.")
	novel_interface.show_character("ren_full","perspire1")
	await novel_interface.show_dialog("L-Lo siento, disculpe...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Me sostengo el estómago, como si me hubiera golpeado un repentino mareo, y me escabullo hacia un rincón, donde le envío a la cámara de vigilancia una mirada de desesperación.")
	await novel_interface.show_text_only("El objetivo no reaccionó en absoluto. Sólo terminé atrayendo a algún bicho raro.")
	novel_interface.show_character("ren_full","sob")
	await novel_interface.show_dialog("Parece que no puedo llamar la atención de ese tipo en absoluto...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Lian, eres demasiado rígido...", "Annie")
	await novel_interface.show_dialog("Él también parece estar esperando a alguien. Y lo que sea que haya en esa bolsa parece sospechoso.", "Annie")
	await novel_interface.show_dialog("Hay un dispositivo de imágenes en tu bolso. Escaneamos su bolso hace un momento: no hay ningún dispositivo electrónico dentro, solo veinte o treinta páginas de documentos en papel.", "Mariru")
	await novel_interface.show_dialog("Realmente es un viejo fósil...", "Annie")
	novel_interface.show_character("ren_full","normal2")
	await novel_interface.show_dialog("¿No dijo Aya que esta cosa podía fotografiar el contenido de múltiples documentos en papel a través de obstáculos?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sopeso el bolso sorprendentemente pesado. Debajo del charol cuidadosamente cosido se esconden pequeños artilugios del SRD.")
	await novel_interface.show_text_only("Lo más sorprendente es que, gracias a su revestimiento especialmente tratado, de alguna manera pasó el control de seguridad en la entrada.")
	await novel_interface.show_dialog("Para fotografiar varias hojas a la vez, el polvo metálico debe dispersarse uniformemente en el espacio para que los rayos que pasan a través de cada página terminen en diferentes niveles de intensidad.", "Mariru")
	await novel_interface.show_dialog("Hay una cápsula de polvo metálico detonada remotamente en tu bolso, pero son muchas páginas. Tendrás que agitarlo con fuerza para que el polvo se distribuya uniformemente.", "Mariru")
	await novel_interface.show_dialog("¿La cápsula no emitirá ningún sonido cuando explote? Y ha estado abrazando esa bolsa como si fuera un tesoro...", "Annie")
	await novel_interface.show_dialog("¿No tienes una carga pegajosa que puede abrir la cerradura de una puerta?", "Mariru")
	await novel_interface.show_dialog("¡Eso es aún más ruidoso!\nY si llama la atención con ese atuendo y las personas equivocadas se dan cuenta...", "Annie")
	await novel_interface.show_text_only("Un escalofrío me recorre al recordar la forma en que ese canalla de la empresa de medios seguía mirando mi pecho.")
	novel_interface.show_character("ren_full","normal2")
	await novel_interface.show_dialog("Ahora que lo pienso...", "Lian")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("El vestíbulo parece nuestra mejor opción.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("No hay ventanas. Incluso el cristal de color no deja pasar la luz, probablemente para garantizar la privacidad.")
	novel_interface.show_character("ren_full","gratified")
	await novel_interface.show_dialog("¿Pueden ustedes dos cortar la energía en esta habitación?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Parece que tienes algo audaz en mente, chico...", "Mariru")
	await novel_interface.show_text_only("...")
	await novel_interface.show_text_only("Regreso al vestíbulo y paso junto al profesor, tratando de actuar con naturalidad.")
	await novel_interface.show_text_only("De repente, la bombilla del otro lado de las escaleras parpadea y luego, con un estallido, se rompe.")
	await novel_interface.show_text_only("En el momento en que todos, incluido el profesor, giran la cabeza, introduzco una cápsula plateada a través de la abertura de su bolso.")
	await novel_interface.show_text_only("Luego me agacho como si estuviera ajustando mis talones y rápidamente presiono la carga de pegamento contra una pata de su silla.")
	novel_interface.show_character("ren_full","uneasy")
	await novel_interface.show_dialog("(¡Perfecto!)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Hago una señal de \"OK\" ante la cámara de vigilancia y me alejo unos pasos.")
	novel_interface.hide_background()
	await novel_interface.show_text_only("Se oye un ruido sordo en el techo y en un instante se apagan todas las luces de la habitación. El profesor grita.")
	await novel_interface.show_text_only("Antes de que nadie pueda reaccionar, una pata de la silla se rompe y el profesor cae al suelo.")
	await novel_interface.show_text_only("En la habitación a oscuras, apunto el lado de escaneo de mi bolso hacia los archivos y rezo furtivamente para que el dispositivo funcione como se supone que debe hacerlo.")
	await novel_interface.show_text_only("Los invitados estallan en confusión. Un mayordomo se apresura a calmar a todos y dice que la luz volverá momentáneamente.")
	await novel_interface.show_dialog("Está funcionando.", "Mariru")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_VillaHall.png")
	await novel_interface.show_text_only("Exhalo aliviado. En el momento en que dejo la bolsa, las luces se vuelven a encender.")
	novel_interface.show_character("ren_full","uneasy")
	await novel_interface.show_dialog("¡Sí!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("¡Todo listo!")
	await novel_interface.show_dialog("Je, ustedes dos...", "???")
	await novel_interface.show_text_only("Una voz femenina... detrás de mí.")
	novel_interface.show_character("nyx_full","normal1")
	await novel_interface.show_dialog("He estado mirando desde arriba. ¿Qué haces aquí abajo, intentando seducir a la gente?", "Nix")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_full","panic")
	await novel_interface.show_dialog("... ¿Nada?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("La chica mayor mira al profesor, que está sentado cerca de nosotros, frotándose el trasero.")
	novel_interface.show_character("nyx_full","normal1")
	await novel_interface.show_dialog("Esa silla tiene al menos ciento treinta años. Los expertos dicen que vale más de dos millones.", "Nix")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_full","upset")
	await novel_interface.show_dialog("¿Eh...?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Nix se da vuelta y pone una mano en mi mejilla.")
	novel_interface.show_character("nyx_full","smile")
	await novel_interface.show_dialog("Estás muy bien vestida hoy, cariño.", "Nix")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Su dedo frío traza una línea por mi cara, alcanza mi auricular de conducción ósea, que recupera con una sonrisa fría.")
	novel_interface.show_character("nyx_full","mock")
	await novel_interface.show_dialog("... Entonces, ¿cómo planeas pagar eso?", "Nix")

	print("=== 星尘降临篇第1话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
