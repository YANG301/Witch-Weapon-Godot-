# stardustdescends_ep12.gd - 星尘降临篇第12话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	stardustdescends_ep12_script()

func play_script():
	pass

func stardustdescends_ep12_script():
	novel_interface.change_music("res://assets/audio/music/unkown/UI_Draw.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_AncientHumanEH.png")
	novel_interface.show_character("stardust_big","normal")
	await novel_interface.show_dialog("Привет.", "Девочка")
	await novel_interface.show_text_only("У девушки передо мной была нежная, как у ребенка, кожа, золотистые глаза, сверкающие звездным светом и, казалось, окутанные каким-то ореолом.")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","blush")
	await novel_interface.show_dialog("(Т-Она такая красивая!)", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я был так очарован ее лицом, что мне потребовалось немало времени, чтобы вспомнить, что я должен был поздороваться.")
	novel_interface.show_character("ren_medical","awkward")
	await novel_interface.show_dialog("Ах-ааа!!\nХ-привет! Эм, это...", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я в панике вскочил на ноги, почти выпалив «Пожалуйста, присядьте» на скамейку.")
	await novel_interface.show_text_only("Увидев, что я, как идиот, запинаюсь в словах, девушка тихо рассмеялась.")
	await novel_interface.show_text_only("Она подошла к центральной витрине с образцами скелетов и осторожно коснулась ореховой рамы, словно задумавшись...")
	novel_interface.show_character("stardust_big","normal")
	await novel_interface.show_dialog("В этом зале всегда так тихо...\nВы интересуетесь палеоантропологией?", "Девочка")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я рефлекторно кивнул.")
	novel_interface.show_character("ren_medical","uneasy")
	await novel_interface.show_dialog("(Мне может быть интересно!)", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Она одарила меня теплой улыбкой, способной растопить человека, затем повернулась к окаменевшему скелету в футляре и сказала:")
	novel_interface.show_character("stardust_big","normal")
	await novel_interface.show_dialog("Ее зовут «Люси». Она жила около 3,2 миллиона лет назад.", "Девочка")
	await novel_interface.show_dialog("Когда экспедиция обнаружила ее в Африке в 1974 году, она была признана самой ранней и наиболее полной окаменелостью предка человека, найденной в то время.", "Девочка")
	await novel_interface.show_dialog("Позже были обнаружены более древние окаменелости гоминидов, но титул Люси как «бабушки человечества» сохранился и по сей день.", "Девочка")
	novel_interface.change_expression("smile2")
	await novel_interface.show_dialog("А что касается имени \"Люси\"...", "Девочка")
	await novel_interface.show_dialog("Говорят, что когда ее обнаружили, магнитофон на месте раскопок играл «Люси в небе с бриллиантами» группы «Битлз».", "Девочка")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ее голос был нежным и чистым, как будто она описывала звездное ночное небо над африканским континентом более трех миллионов лет назад.")
	novel_interface.show_character("ren_medical","perspire1")
	await novel_interface.show_dialog("Означает ли \"бабушка человечества\"...\n, что она предок множества людей?", "Лиан")
	await novel_interface.hide_character()
	novel_interface.show_character("stardust_big","normal")
	await novel_interface.show_dialog("Не обязательно~", "Девочка")
	await novel_interface.show_dialog("Люси была одним из первых людей, начавших прямоходить, но она была лишь одним из представителей этой популяции.", "Девочка")
	await novel_interface.show_dialog("Некоторые учёные даже утверждают, что, поскольку на этом этапе размер человеческого мозга ещё не начал увеличиваться, нельзя судить о поле по размеру тазового отверстия.", "Девочка")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Улыбаясь, она наклонилась к моему уху и прошептала.")
	novel_interface.show_character("stardust_big","smile1")
	await novel_interface.show_dialog("Так что...\nЛюси, возможно, тоже не была девочкой~", "Девочка")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","awkward")
	await novel_interface.show_dialog("--А?", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("По мне пробежала покалывающая дрожь, и я поспешно отступил на несколько шагов назад.")
	await novel_interface.show_text_only("Ч-почему она сказала это мне?? Могла ли она подозревать меня...?")
	novel_interface.show_character("ren_medical","shy_right")
	await novel_interface.show_dialog("(И перестань дышать мне в ухо~~~!!)", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Она выглядела довольно довольной моей взволнованной реакцией, затем сменила тему и продолжила:")
	novel_interface.show_character("stardust_big","normal")
	await novel_interface.show_dialog("Прошло так много времени, что восстановить ДНК Люси и проверить ее сейчас невозможно.", "Девочка")
	await novel_interface.show_dialog("Но даже если бы тело осталось запечатанным и сохраненным, новейшая технология генетического анализа Самотона все равно могла бы проверить родство.", "Девочка")
	await novel_interface.show_dialog("Пару лет назад они извлекли ДНК из мумии возрастом шесть тысяч лет и сравнили ее с современной базой данных генов, и они действительно нашли потомков, живущих до сих пор.", "Девочка")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","perspire1")
	await novel_interface.show_dialog("Это потрясающе?!", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Эта девушка студентка-медик откуда-то поблизости? Но судя по тому, как она выглядит и одевается, она не похожа на местную...")
	novel_interface.show_character("stardust_big","smile1")
	await novel_interface.show_dialog("На самом деле я узнал об этом только в прошлый раз...", "Девочка")
	novel_interface.change_expression("close_eye")
	await novel_interface.show_dialog("Но человеческие предки действительно невероятны.", "Девочка")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Она говорила, обходя витрину, постепенно покидая мое поле зрения.")
	await novel_interface.show_dialog("Они вышли из Африки, пересекли Плодородный полумесяц и с боями прошли через весь мир.", "Девочка")
	await novel_interface.show_dialog("Они достигли самых холодных мест на планете и самых жарких, мест, где половина года — день, а другая половина — ночь.", "Девочка")
	await novel_interface.show_dialog("Они даже пересекли моря и достигли дальнего берега...", "Девочка")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Ах, это было...?")
	novel_interface.show_background("res://assets/images/bg/Fabiola/Mother.png")
	await novel_interface.show_text_only("Это из книги, которую мама читала мне, когда я был маленьким...")
	await novel_interface.show_text_only("Этот отрывок произвел на меня особенно глубокое впечатление...")
	await novel_interface.show_text_only("Но потом я так и не смог понять, как называлась эта книга.")
	await novel_interface.hide_background()
	novel_interface.show_character("ren_medical","normal2")
	await novel_interface.show_dialog("Подожди, где ты это увидел...?", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Внезапно я заметил, что пространство за витриной погрузилось во тьму, и там, откуда доносился ее голос, мерцал кобальтово-синий свет.")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_Stardust.png")
	await novel_interface.show_text_only("Я сразу же погнался за ней и обнаружил девушку, стоящую в туманном сиянии, а пространство вокруг нее становилось размытым и тусклым.")
	await novel_interface.show_dialog("Это должно передать сообщение сейчас...", "Девочка")
	await novel_interface.show_dialog("--Как мы и обещали.", "Девочка")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Обещали... мы...?")
	await novel_interface.show_text_only("В пустоте до меня донесся ее последний голос:")
	await novel_interface.show_dialog("Ты тоже хорошо выглядишь с длинными волосами...", "Девочка")
	await novel_interface.show_text_only("Прежде чем я успел на нее надавить, ее фигура постепенно исчезла, растворившись, как будто она никогда и не принадлежала этому миру.")
	await novel_interface.show_text_only("Глаза у меня увлажнились, и почему-то внутри меня нахлынула волна печали...")
	await novel_interface.show_text_only("Что... подожди...")
	await novel_interface.stop_music()
	await novel_interface.show_text_only("...")
	await novel_interface.show_text_only("Эй............")
	await novel_interface.show_text_only("Эй, эй--!!!")
	await novel_interface.show_text_only("Затем мир закружился, и мне показалось, что кто-то тряс мое тело.")
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_AncientHumanEH.png")
	novel_interface.show_character("emilio","stare")
	await novel_interface.show_dialog("Эй, Лиан?", "Эмили")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","worry")
	await novel_interface.show_dialog("А...?", "Лиан")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("emilio","speechless",0.25)
	await novel_interface.show_dialog("Так это действительно ты...\nТы здесь заснул? Вы не боитесь простудиться?", "Эмили")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("...Эмили?", "Лиан")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Это был... сон только что?")
	await novel_interface.show_text_only("Я потерла лицо, вытерла слезы и попыталась избавиться от этого чувства как можно быстрее.")
	novel_interface.show_character("ren_medical","normal2")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("emilio","speechless",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Почему ты здесь...", "Лиан")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal")
	await novel_interface.show_dialog("Я принес сюда на оценку несколько конфискованных предметов, предположительно артефактов, а потом увидел, как ты спишь на скамейке.", "Эмили")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Поправляя волосы, я вытащил телефон, все еще думая о том, что сказала та девушка...")
	novel_interface.show_character("ren_medical","panic")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("emilio","normal",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ах!! Как это получилось так поздно?!", "Лиан")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Было такое ощущение, будто я проспал меньше десяти минут, но уже прошло полтора часа.")
	await novel_interface.show_text_only("Требуемое трехчасовое посещение музея было завершено пятнадцать минут назад.")
	await novel_interface.show_text_only("Я встала, потянула платье-комбинацию, которое прилипло к моей попе из-за слишком долгого сидения, и сказала Эмили немного застенчиво:")
	novel_interface.show_character("ren_medical","panic")
	await novel_interface.show_dialog("Хорошо, что ты меня разбудил. Я бы чуть не опоздал...", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("План состоял в том, что после визита Мариру прикажет сотрудникам посольства отвезти меня и маленького Stardust в иммиграционную службу для оформления документов.")
	await novel_interface.show_text_only("Их машина уже должна была подъехать к входу в музей...")
	novel_interface.show_character("ren_medical","sob")
	await novel_interface.show_dialog("Ах~", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Внезапно я почувствовал слабое жжение в затылке...")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Прежде чем я успел обернуться, мое зрение затуманилось, мои конечности обмякли, и я упал назад...")
	await novel_interface.stop_music()
	await novel_interface.show_text_only("...")
	await novel_interface.show_text_only("............")
	await novel_interface.show_text_only("Вскоре после этого SID командный пункт.")
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.show_character("liliu_uniform1","angry")
	await novel_interface.show_dialog("--Она исчезла!?", "Мариру")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Мариру сразу пролистала отчет: водитель посольства сказал, что никто не появился, а звонки на телефон Лиана только перешли в нерабочее состояние.")
	await novel_interface.show_text_only("Трекер Лиана потерял сигнал на территории музея.")
	await novel_interface.show_text_only("Поскольку общественное наблюдение за музеем, как и за всем внутренним районом Масады, должно было осуществляться через серверы Монолы, быстро проникнуть в него было невозможно.")
	await novel_interface.show_text_only("Эта идиотка время от времени теряла себя, но на этот раз она явно превзошла даже ожидания Мариру.")
	await novel_interface.show_text_only("Перед большим экраном Ая быстро вращала карандаш в левой руке, перетаскивая временную шкалу правой, пристально глядя на несколько наборов спутниковых изображений.")
	await novel_interface.show_text_only("-- Это была ее привычка, когда ее мозг работал на полную мощность.")
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("Я думаю, что это тот...", "Ая")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Мариру посмотрела на изображение, указанное Аей: вскоре после того, как сигнал Лиана исчез, из подземного гаража музея выехал бронетранспортер.")
	await novel_interface.show_text_only("Поскольку изображение было получено не с низкоорбитального спутника-шпиона, ни ракурс, ни разрешение не были достаточными, чтобы различить номерной знак.")
	await novel_interface.show_text_only("Покинув музей, машина вскоре въехала в лабиринт подземных туннелей с множеством выходов и полностью исчезла.")
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("Это был бронетранспортёр F-950 SWAT TRUCK. Его тело действительно способно блокировать электромагнитные волны и даже выдержать определенное количество ядерного излучения.", "Ая")
	await novel_interface.show_dialog("Масада развернула более сотни таких машин со специальной броней из разнородных материалов, отчасти для защиты от заминированных автомобилей и атак партизан.", "Ая")
	novel_interface.change_expression("think")
	await novel_interface.show_dialog("Думаешь, это сделала Монола?\nЯ помню, как администратор Эллуки раньше сражался с Лианом и остальными...", "Ая")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Мариру мрачно покачала головой.")
	novel_interface.show_character("ai","think")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform1","serious",0.25)
	await novel_interface.show_dialog("Очень маловероятно. Этот человек не понимает истинной ценности Лиана, поэтому сегодня не стоит рисковать.", "Мариру")
	novel_interface.character_light(0.35,"normal")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("...Из-за соглашения о прекращении огня?", "Ая")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Все пять других городов-академий имеют разведывательные посты в Масаде, но в этот деликатный момент все они молчаливо сдерживают себя.", "Мариру")
	await novel_interface.show_dialog("Даже Самонтон и Нью-Моридас, которые обычно враждуют с Масадой, в последние несколько дней вели себя необычно тихо.", "Мариру")
	novel_interface.change_2nd_expression("normal1")
	await novel_interface.show_dialog("Ведь никто не хочет сейчас провоцировать столкновение и брать на себя вину за срыв мирового мирного процесса...", "Мариру")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Тогда, вероятно, это кто-то из Сил обороны...", "Ая")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Ая вывел на экран файл.")
	novel_interface.show_character("ai","normal")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("liliu_uniform1","normal1",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Эта бронемашина дорогая, и Силы обороны оснастили ее шифрованием наравне с беспилотным штурмовиком «Желтый воробей».", "Ая")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("Если бы это шифрование было взломано, система защиты искусственного интеллекта Масады была бы практически беззащитной. Вся страна уже была бы в смятении.", "Ая")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Телефон Лиана настроен на автоматическое начало записи в тот момент, когда он теряет связь со спутником...", "Мариру")
	await novel_interface.show_dialog("Как только сигнал вернется, резервное питание немедленно отправит обратно аудиофайл и данные о местоположении.", "Мариру")
	novel_interface.change_2nd_expression("sigh")
	await novel_interface.show_dialog("А пока нам остаётся только ждать и смотреть...", "Мариру")
	await novel_interface.stop_music()
	await novel_interface.hide_all_characters()
	await novel_interface.hide_background_with_fade()
	await novel_interface.show_text_only("...")
	await novel_interface.show_text_only("............")
	await novel_interface.show_text_only("У меня болит голова.")
	await novel_interface.show_text_only("Снова та же самая сильная головная боль, как будто я чувствовал ее раньше.")
	await novel_interface.show_text_only("Как будто кто-то всыпал мне в череп несколько мешков с цементом и медленно их перемешивал...")
