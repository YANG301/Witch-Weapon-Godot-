# stardustdescends_ep08.gd - 星尘降临篇第8话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	stardustdescends_ep08_script()

func play_script():
	pass

func stardustdescends_ep08_script():
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Masada0.png")
	await novel_interface.show_text_only("La terza città scolastica, Masadaburg.")
	await novel_interface.show_text_only("Una fortezza militare costruita nel deserto, famosa per il fango del Mar Morto, le tempeste di sabbia e gli attacchi terroristici.")
	await novel_interface.show_text_only("Per la maggior parte delle persone, qualsiasi notizia su Masadaburg significa conflitto militare o disastro umanitario.")
	await novel_interface.show_text_only("Un paesaggio tinto di morte, fatto di sangue e sabbia, petrolio greggio e fumo bianco, incombe da tempo su questa antica terra...")
	await novel_interface.show_text_only("Che tipo di vita vivono le persone lì?\nNon ne ho assolutamente idea...")
	await novel_interface.show_text_only("Eppure mi sembra anche stranamente familiare, come se fossi stato lì io stesso...")
	await novel_interface.hide_background()
	await novel_interface.show_dialog("Sospiro──", "Lian")
	novel_interface.change_music("res://assets/audio/music/unkown/UI_Main_Funk.mp3")
	novel_interface.show_background("res://assets/images/bg/Stardust/Vessel.png")
	await novel_interface.show_text_only("Mi sono appoggiato alla ringhiera sul ponte mentre Stardust si aggrappava a me come un koala, con le lacrime ancora luccicanti nei suoi occhi.")
	novel_interface.show_character("ren_full","wry_smile")
	await novel_interface.show_dialog("Va bene, va bene. Stavo solo scherzando──", "Lian")
	novel_interface.change_expression("wail")
	await novel_interface.show_dialog("Ehi, vacci piano. Le tue unghie stanno affondando nella mia carne...", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("stardust_small","tear",0.25)
	await novel_interface.show_dialog("Annusa...", "Stardust")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("D-Non pulirti il naso sui miei vestiti!!!", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Ho emesso un sospiro impotente e le ho accarezzato la testa per calmarla.")
	await novel_interface.show_text_only("In precedenza Aya aveva immaginato che la direzione verso cui Stardust aveva puntato fosse Masadaburg, ma dopo aver chiesto in giro, si scoprì che la ragazza non aveva idea di cosa significasse quel nome.")
	await novel_interface.show_text_only("O meglio, non capiva nemmeno il concetto di \"città scolastica\"...")
	await novel_interface.show_text_only("Mariru ha detto che prima avrebbe sistemato le informazioni e mi ha detto di aspettare sul ponte finché non mi avesse contattato di nuovo.")
	await novel_interface.show_text_only("Non riuscivo ancora ad accettare che questa ragazza fosse un'illusione che solo io potevo vedere, quindi ho colto l'occasione per fare qualche altro test──")
	await novel_interface.show_text_only("Per prima cosa ho appoggiato il telefono a terra e le ho chiesto di raccoglierlo.")
	await novel_interface.show_text_only("Invece, mi ha semplicemente rivolto un sorriso educato, ha inclinato la testa e mi ha guardato come se dicesse: \"Sei stupido?\"")
	await novel_interface.show_text_only("Dopo circa trenta secondi di stallo, ho potuto solo sollevare goffamente il mio telefono, e poi mi è venuta un'idea ancora più stupida──")
	await novel_interface.show_text_only("\"Se non avesse un corpo fisico, potrebbe passare attraverso i muri?\"")
	await novel_interface.show_text_only("Così, mentre lei guardava, tornai nella cabina, chiusi a chiave la porta che conduceva al ponte e mi nascosi nel suo punto cieco.")
	await novel_interface.show_text_only("Due minuti dopo, ho sentito singhiozzare silenziosamente dall'altra parte. Percependo problemi, ho aperto in fretta la porta e lei mi ha afferrato la coscia e si è rifiutata di lasciarla andare.")
	await novel_interface.show_text_only("Per evitare il passaggio occasionale di camerieri nella cabina, ho faticato a trascinarla accanto alla ringhiera.")
	novel_interface.show_character("ren_full","wail")
	await novel_interface.show_dialog("(Con questo accessorio per la gamba attaccato, riesco a malapena a camminare...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Prendersi cura di un bambino è sempre così faticoso!?")
	await novel_interface.show_text_only("Peggio ancora, nessun altro può vederla. In questo momento devo sembrare un pazzo che borbotta tra sé e si muove in modo strano.")
	await novel_interface.show_text_only("Dato che non avevo davvero alcuna risposta alla sua appiccicosità, potevo solo persuaderla gentilmente.")
	novel_interface.show_character("ren_full","wry_smile")
	await novel_interface.show_dialog("Lì, lì. Non ti lascerò indietro~", "Lian")
	novel_interface.change_expression("gratified")
	await novel_interface.show_dialog("Questa è stata la mia colpa proprio ora. Mi scuserò, ok?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("L'ho detto facendole una faccia sciocca.")
	await novel_interface.show_text_only("Se qualcuno mi vedesse fare le smorfie all'aria aperta, vorrei infilarmi dritto in una fessura del ponte.")
	await novel_interface.show_text_only("Stardust si è calmato un po'. Continuando ad abbracciarmi, alzò lo sguardo, sbatté le palpebre con i suoi grandi occhi e gli auricolari sulla sua testa lampeggiarono.")
	novel_interface.show_character("stardust_small","tear")
	await novel_interface.show_dialog("Allora promettimi che andrai in quella direzione con me, ok...?", "Stardust")
	await novel_interface.show_dialog("È davvero, davvero importante...", "Stardust")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("...")
	await novel_interface.show_text_only("Non stavi piangendo per finta proprio adesso, vero?")
	novel_interface.show_character("ren_full","upset")
	await novel_interface.show_dialog("(I bambini sono davvero una manciata...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Non avevo idea se Mariru avrebbe approvato il fatto che portassi questo piccolo taga con me in un posto così pericoloso.")
	await novel_interface.show_text_only("Proprio in quel momento, l'elettricità crepitava attraverso il mio auricolare e Mariru era di nuovo in linea.")
	await novel_interface.show_dialog("Lian, Annie, quanto sapete voi due di Masadaburg?", "Mariru")
	novel_interface.show_character("ren_full","worry")
	await novel_interface.show_dialog("Mhm...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("All'incirca...", "Annie")
	await novel_interface.show_text_only("Ho fatto di tutto per ricordare, ma anche durante l'addestramento degli agenti SID le informazioni su Masadaburg erano frammentate.")
	await novel_interface.show_dialog("La Third School City, una città fortezza nel cuore dell'Asia occidentale, divisa in quartieri interni ed esterni da un muro di isolamento alto decine di metri.", "Annie")
	novel_interface.show_character("ren_full","bored")
	await novel_interface.show_dialog("Penso che sia stato a causa di un conflitto etnico o religioso o qualcosa del genere?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Comunque, il distretto esterno di Masadaburg sembra pericoloso. Sembra che ci siano uno o due attentati dinamitardi ogni mese!")
	await novel_interface.show_dialog("La loro agenzia di intelligence, il Masada Restoration Mission Bureau, è direttamente controllata dai militari e ha uno stile audace e radicale.", "Annie")
	novel_interface.show_character("ren_full","happy")
	await novel_interface.show_dialog("Ah, lo so. Anche quell'agenzia si chiama \"Monola\", vero?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("È un nome che appare sempre nei film e nei giochi, anche se raramente come fazione principale.")
	novel_interface.show_character("ren_full","smile")
	await novel_interface.show_dialog("Esatto, anche le loro armi sono avanzate. Nei giochi, Masada è solitamente la parte che fornisce ai giocatori carri armati e droni telecomandati...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Va bene, basta──", "Mariru")
	await novel_interface.show_dialog("L’ambiente geopolitico in quella regione è sempre stato complesso e, se si aggiungono le forze di resistenza e i gruppi separatisti, diventa ancora più caotico.", "Mariru")
	await novel_interface.show_dialog("Ma parlando solo del \"distretto interno\" di Masadaburg, la sua sicurezza non è peggiore di quella di New Toyosu, quindi...", "Mariru")
	novel_interface.show_character("ren_full","perspire1")
	await novel_interface.show_dialog("Eh? Non dirmelo...\nSei d'accordo?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ancora avvolto attorno alla mia coscia, Stardust si dimenava allegramente.")
	await novel_interface.show_dialog("Solo noi due... sei sicuro che staremo bene?", "Annie")
	await novel_interface.show_text_only("Tre. Tre di noi!!\nNon dimenticare che qui c'è un bagaglio extra!!")
	await novel_interface.show_dialog("Questa non è una missione di spionaggio. Non sappiamo ancora nemmeno la nostra destinazione esatta. Finché non fai nulla di scandaloso, andrà tutto bene.", "Mariru")
	await novel_interface.show_dialog("Inoltre, non avrai nemmeno bisogno di cambiare nave. Questa nave da casinò attraccherà al porto di Masada domani mattina~", "Aya")
	await novel_interface.show_dialog("...Cosa sta succedendo? Non dovevamo essere diretti a Samonton?", "Annie")
	await novel_interface.show_dialog("Masada firmerà entro tre giorni un accordo di cessate il fuoco con la resistenza e, fino alla fine della cerimonia, il Canale di Suez sarà completamente sigillato.", "Mariru")
	await novel_interface.show_dialog("Per la sicurezza dei suoi passeggeri, il casinò ha appena deciso di seguire la \"forte raccomandazione\" dell'esercito di Masada e di tornare a Eilat.", "Mariru")
	await novel_interface.show_dialog("Questa nave si dirigerà a nord lungo il Canal Grande tra Mar Rosso e Mar Morto, attraccherà al porto di Masada e rimarrà lì fino alla revoca del blocco del Canale di Suez.", "Mariru")
	await novel_interface.show_dialog("L'identità di copertina di Annie è quella di una studentessa in un programma di scambio artistico di New Toyosu. Le pratiche burocratiche sono già state completate.", "Mariru")
	await novel_interface.show_dialog("Per quanto riguarda te, Lian──probabilmente la difesa costiera di Masada ha già registrato la tua identità di copertura, quindi continua a essere la piccola infermiera che sei~", "Mariru")
	await novel_interface.show_text_only("C'era un sorriso nella voce di Mariru che mi mise vagamente a disagio.")
	novel_interface.show_character("ren_full","panic")
	await novel_interface.show_dialog("Eh??!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("In ogni caso non potrai muoverti finché non sarà firmato l'accordo, quindi trascorri i prossimi due giorni visitando la città~", "Aya")
	await novel_interface.show_dialog("Se il posto in cui quella ragazza vuole andare risulta essere fuori città, chiederò alla stazione di intelligence locale di mandare qualcuno a darti supporto entro tre giorni.", "Mariru")
	novel_interface.show_character("ren_full","panic")
	await novel_interface.show_dialog("Anche il Canale di Suez è sigillato...", "Lian")
	await novel_interface.show_dialog("Basta firmare un accordo... è davvero necessario arrivare a tanto?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.stop_music()
	await novel_interface.show_dialog("Questo perché...", "Aya")
	await novel_interface.show_dialog("Perché le cose sono già serie──", "Aya")
	await novel_interface.show_dialog("Voi due siete stati sulla nave per tutto questo tempo, quindi non lo sapete ancora, vero?", "Mariru")
	await novel_interface.show_dialog("W-cosa è successo...?", "Annie")
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("Più di dieci ore fa, vicino alla moschea Ibra a Hebron, nel territorio di Masada, si è verificata un'esplosione coinvolgente prodotti chimici industriali.", "Mariru")
	await novel_interface.show_dialog("L'onda d'urto ha causato il crollo parziale degli edifici vicini e ha danneggiato i sistemi locali di elettricità, acqua e gas.", "Mariru")
	await novel_interface.show_dialog("Secondo il comunicato ufficiale, tutti i residenti della zona sono già stati evacuati in una zona sicura.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Un altro attacco terroristico?", "Lian")
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("Sotto la Moschea Ibra si trova la Grotta di Machpelah, che si dice sia il luogo di sepoltura degli antenati del popolo Masadan.", "Aya")
	await novel_interface.show_dialog("Anche se da quando hanno preso il controllo della città nel secolo scorso, non vi hanno mai condotto alcuno scavo archeologico...", "Aya")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("La cosa strana è che, mentre il rapporto ufficiale sulle vittime è plausibile, il blocco delle informazioni è troppo rigido...", "Aya")
	await novel_interface.show_dialog("In rete non si trovano nemmeno i video girati dai residenti nelle vicinanze. Ogni pagina di notizie su questo incidente utilizza foto e video forniti dai funzionari di Masada.", "Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","serious")
	await novel_interface.show_dialog("Allo stesso tempo, i sistemi elettronici di diversi importanti ospedali di Hebron hanno funzionato male e un numero enorme di registrazioni delle emergenze è andato perduto.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("Dopo l'incidente, Masada rifiutò quasi immediatamente l'offerta dell'Organizzazione per il Patrimonio Mondiale di aiutare a preservare le rovine della Grotta di Machpelah.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Questo livello di controllo palese delle informazioni sembra davvero Monola... ma perché dovrebbero bloccare le informazioni?", "Annie")
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("Probabilmente perché non vogliono che la situazione diventi ancora più complicata──", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("L'analisi delle immagini satellitari suggerisce che l'esplosione è stata molto probabilmente causata da un piccolo razzo.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("La resistenza?\nMa non stanno per firmare un cessate il fuoco...?", "Lian")
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("Il leader della resistenza ha immediatamente postato sui social media dicendo che l'incidente non aveva nulla a che fare con loro ed ha espresso rammarico e condanna.", "Aya")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("Al momento l'intelligence sospetta che l'attacco possa essere stato effettuato da qualche fazione scissionista all'interno della resistenza. Quelle persone non sono mai state un blocco unificato~", "Aya")
	await novel_interface.show_dialog("Anche se il leader vuole un cessate il fuoco, i sostenitori della linea dura al suo interno non vogliono che l’accordo venga raggiunto, giusto?", "Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("Forse. Ma tutto ciò è ancora speculazione. Ciò che non è speculativo è che questi prossimi tre giorni saranno il periodo più delicato che la Città della Terza Scuola potrebbe affrontare──", "Mariru")
	await novel_interface.show_dialog("Di conseguenza, il livello di sicurezza di Masada è al massimo. Sarai più al sicuro nel distretto interno che in mare aperto.", "Mariru")
	novel_interface.change_expression("sigh")
	await novel_interface.show_dialog("Riposati bene stasera. Ti ricontatteremo domani una volta raggiunto il porto.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Ok!", "Lian")
	await novel_interface.show_dialog("Capito~", "Annie")
	await novel_interface.show_text_only("Detto questo, Mariru concluse la chiamata con le due persone a bordo della nave e spostò lo sguardo sull'immagine video di una donna vestita di rosso sul grande schermo.")
	novel_interface.show_character("akiko","serious")
	await novel_interface.show_dialog("...Anche tu pensi che ci sia qualcosa che non va, vero?", "Akiko")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","sigh")
	await novel_interface.show_dialog("Sì. Questo accordo è stato annunciato troppo bruscamente──", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("La settimana scorsa, un portavoce del governo di Masada ha improvvisamente annunciato che avrebbe firmato un accordo di cessate il fuoco con la resistenza entro dieci giorni.", "Mariru")
	await novel_interface.show_dialog("I governi e i media di tutto il mondo lo hanno lodato, e il disarmo e il cessate il fuoco sono effettivamente la tendenza generale.", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("──Ma l'accordo sembra ancora troppo affrettato.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("akiko","normal")
	await novel_interface.show_dialog("Sono d'accordo. Non sembra il solito stile del Primo Ministro Sheinneman di muoversi solo dopo un'attenta pianificazione.", "Akiko")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("È perché le sue condizioni sono peggiorate più del previsto...?", "Aya")
	await novel_interface.show_dialog("Dall'ultimo forum sulla pace, il Primo Ministro Sheinneman non ha mostrato la sua faccia in pubblico nemmeno una volta~", "Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","sigh")
	await novel_interface.show_dialog("Questa potrebbe non essere l'unica ragione──", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Le contraddizioni interne alle forze di difesa di Masada sono probabilmente vicine al punto in cui non possono essere conciliate.", "Mariru")
	await novel_interface.show_dialog("Con personale e budget che devono affrontare tagli drastici, è solo questione di tempo prima che gli ufficiali decorati e la fazione tecnologica si dividano a vicenda.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("akiko","serious")
	await novel_interface.show_dialog("Una lotta tra la fazione tecnica accademica all'interno delle forze di difesa e la fazione per merito di guerra che si è distinta in prima linea...", "Akiko")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru annuì leggermente.")
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("E Masada non ha ancora deciso chi firmerà questo storico accordo per suo conto──", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Chiunque rivendichi un risultato senza precedenti sotto gli occhi di tutto il mondo molto probabilmente vincerà le prossime elezioni, non è vero?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("akiko","normal")
	await novel_interface.show_dialog("Inevitabilmente...", "Akiko")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Come se all'improvviso si fosse reso conto di qualcosa, Akiko emise un dolce \"Ah\".")
	novel_interface.show_character("akiko","shock")
	await novel_interface.show_dialog("Masada non vuole che questo attacco influenzi la cerimonia della firma, quindi insistono che si sia trattato di un'esplosione chimica accidentale...?", "Akiko")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal2")
	await novel_interface.show_dialog("Ehi, il tuo aspetto quando sei scosso è carino come sempre~", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("akiko","shy")
	await novel_interface.show_dialog("(sottovoce) ...Pervertito.", "Akiko")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Le guance di Akiko arrossirono leggermente mentre tossiva due volte.")
	novel_interface.show_character("akiko","shy")
	await novel_interface.show_dialog("Allora, ne hai già trovato uno?", "Akiko")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("──Il \"candidato\" giusto che hai menzionato l'ultima volta.", "Akiko")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru scosse la testa.")
	novel_interface.show_character("liliu_uniform1","sigh")
	await novel_interface.show_dialog("Se fosse stato così facile trovarne uno, quel vecchio Sheinneman non avrebbe resistito così a lungo senza ritirarsi...", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.stop_music()
	await novel_interface.hide_background_with_fade()
	await novel_interface.show_text_only("...")
	await novel_interface.show_text_only("La mattina dopo, alle 8:40.")
	await novel_interface.show_text_only("La nave casinò Liberty Star, ristorante VIP.")
	novel_interface.change_music("res://assets/audio/music/Shop.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_Gambling_Boat4.png")
	await novel_interface.show_text_only("Il ristorante VIP si trovava sul ponte superiore. Non era grande, ma la vista era eccellente.")
	await novel_interface.show_text_only("Nuvole scure pendevano fuori dalle finestre e la superficie del mare profondo sembrava preparare qualche calamità minacciosa.")
	await novel_interface.show_text_only("Forse perché la maggior parte degli ospiti erano rimasti storditi dalle bevande illimitate gratuite del casinò la scorsa notte, il nostro era l'unico tavolo occupato nel ristorante.")
	await novel_interface.show_text_only("Guardavo distrattamente fuori dalla finestra. Quel tratto di acqua blu scuro era il Canale Masada che collegava il Mar Rosso e il Mar Morto.")
	await novel_interface.show_text_only("Questo canale, costruito congiuntamente dalle Città Scolastiche Prima e Terza utilizzando la tecnologia eteromorfa, è lungo 180 chilometri, con un dislivello di 430 metri tra le sue due estremità.")
	await novel_interface.show_text_only("Va dal porto di Eilat, all'estremità settentrionale del Golfo di Aqaba, fino a Masadaburg, sulla sponda sud-occidentale del Mar Morto.")
	await novel_interface.show_text_only("Essendo l'ancora di salvezza di Masada, questo canale è stato accompagnato fin dalla fase di progettazione da conflitti e controversie con numerosi piccoli stati vicini.")
	novel_interface.show_character("anne_uniform","normal1")
	await novel_interface.show_dialog("È l'ultima chiusa più avanti, vero?\nChe incredibile pezzo di ingegneria...", "Annie")
