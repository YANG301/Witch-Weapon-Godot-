# stardustdescends_ep10.gd - 星尘降临篇第10话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	stardustdescends_ep10_script()

func play_script():
	pass

func stardustdescends_ep10_script():
	await novel_interface.show_text_only("Als wir die Passkontrolle verließen, hatte sich der Himmel aufgeklärt und wir drei bestiegen den Hafen-Rail-Shuttle.")
	await novel_interface.show_text_only("Die Magnetschwebebahn war unglaublich schnell. In weniger als zehn Minuten erreichte es den Knesset-Bahnhof in der Innenstadt von Masada.")
	await novel_interface.show_text_only("...")
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_Masadainner.png")
	novel_interface.show_character("anne_uniform","panic")
	await novel_interface.show_dialog("Das...", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","happy")
	await novel_interface.show_dialog("T-Das ist unglaublich!!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("stardust_small","happy")
	await novel_interface.show_dialog("Wooow──", "Stardust")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","happy")
	await novel_interface.show_dialog("Das ist also... Masadaburg?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_uniform","panic",0.25)
	await novel_interface.show_dialog("Sogar ich... hätte das nicht erwartet...", "Annie")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Die Szene vor uns hat meinen Eindruck von Masada als einer „vom Krieg verwüsteten Wüstenfestung“ völlig zunichte gemacht──")
	await novel_interface.show_text_only("Auf Straßen, so gepflegt und elegant wie ein Garten, waren überall KI-Sanitärroboter und unbemannte Lastenkarren zu sehen.")
	await novel_interface.show_text_only("Die Fassaden der Hochhäuser im entfernten Stadtzentrum waren mit Metallpaneelen verkleidet, die stark futuristisch wirkten und in denen sich schwach die weißen Wolken darüber spiegelten.")
	await novel_interface.show_text_only("Unter dem blauen Himmel erstreckten sich weite Grünflächen bis zum Horizont ...")
	novel_interface.show_character("ren_medical","smile")
	await novel_interface.show_dialog("Diese Luft fühlt sich unglaublich erfrischend an──", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ich lehnte mich an das Steingeländer und holte tief Luft. Die feuchte Luft trug den schwachen salzigen Geruch mit sich, der typisch für den Seewind ist.")
	novel_interface.show_character("ren_medical","smile")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_uniform","happy",0.25)
	await novel_interface.show_dialog("Dies ist der Ort mit dem höchsten Luftdruck auf der Erde. Mit mehr Sauerstoff in der Luft fühlt sich das Atmen einfach einfacher an", "Annie")
	novel_interface.change_2nd_expression("normal1")
	await novel_interface.show_dialog("Ich kann nicht glauben, dass sie die Wüste am Toten Meer in dieses ... verwandelt haben.", "Annie")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Annie, was ist das für eine lange Strecke da drüben...?", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Ich zeigte nach links. In der Ferne verlief eine Barriere, die von Ost nach West verlief, und dahinter schien es überhaupt keine Hochhäuser zu geben.")
	novel_interface.show_character("anne_uniform","stare")
	await novel_interface.show_dialog("Das ist die „Isolationswand“.", "Annie")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Wir sind jetzt weit weg, aber es ist tatsächlich Dutzende Meter hoch, mit Sicherheitskontrollpunkten und automatisierten Verteidigungssystemen überall.", "Annie")
	await novel_interface.show_dialog("Es gibt auch viele Sensoren, die unter der Erde vergraben sind. Nicht einmal eine Maus konnte durchkommen.", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie seufzte und murmelte leise vor sich hin.")
	novel_interface.show_character("anne_uniform","upset")
	await novel_interface.show_dialog("Ihr früheres Kapital hatte auch so etwas, und es wurde trotzdem abgeflacht ...", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","worry")
	await novel_interface.show_dialog("Das ist schon lange her, oder...?\nIch war damals erst in der Grundschule──", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Dann fiel mir ein, dass Annie sieben Jahre in der Lücke der Kausalität verbracht hatte. Für sie ist diese Erinnerung vielleicht noch nicht so alt.")
	novel_interface.show_character("ren_medical","wry_smile")
	await novel_interface.show_dialog("B-Übrigens──\nWas bringt es, so eine Mauer zu bauen?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ich wechselte eilig und etwas unbeholfen das Thema.")
	novel_interface.show_character("ren_medical","smile")
	await novel_interface.show_dialog("Sollte wirklich ein Krieg ausbrechen, würde eine solche Mauer nichts aufhalten ...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","normal2")
	await novel_interface.show_dialog("Regierungen errichten Mauern aus allen möglichen Gründen – um Invasionen zu stoppen, Menschen an der Flucht zu hindern, illegale Einwanderer fernzuhalten …", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie sagte dies, während sie auf die Flaggen der sechs Schulstädte im Park vor ihr blickte.")
	novel_interface.show_character("anne_uniform","upset")
	await novel_interface.show_dialog("Aber Masadas Situation ist noch komplizierter ...", "Annie")
	await novel_interface.show_dialog("Auf beiden Seiten dieser Mauer wollen viele Menschen die andere Seite nicht sehen.", "Annie")
	await novel_interface.show_dialog("Nur indem sie die andere Seite nicht sehen, indem sie so tun, als ob die anderen nicht existierten, können sie mit gutem Gewissen leben.", "Annie")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("Nun ja... obwohl ich bezweifle, dass du es wirklich verstehen würdest, Lian.", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("stardust_small","pleased")
	await novel_interface.show_dialog("Ooh~~ Ich verstehe...", "Stardust")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Stardust mischte sich plötzlich in das Gespräch ein, nickte und nahm eine nachdenkliche Pose ein, als hätte sie alles verstanden.")
	novel_interface.show_character("stardust_small","pleased")
	await novel_interface.show_dialog("Mm, mm~", "Stardust")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Als ob du etwas verstehst! Ist das nicht genau die gleiche Reaktion, die ich habe, wenn ich im Physikunterricht ohnmächtig werde?!")
	await novel_interface.show_text_only("Um fair zu sein, Annies Erklärung ging auch über meinen Kopf hinaus. Vielleicht hatte es etwas mit ihrer eigenen Vergangenheit zu tun ...")
	await novel_interface.show_text_only("Als Annie den hohlen, verlorenen Ausdruck in meinen Augen sah, legte sie einen Arm um meinen Hals.")
	novel_interface.show_character("anne_uniform","smile")
	await novel_interface.show_dialog("Hey, nimm es nicht so ernst. Ich rede meistens nur Unsinn~", "Annie")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("Lass mich dir etwas sagen. Masadas „Phantom Force“ liegt irgendwo unter der Erde in der Innenstadt!", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","panic")
	await novel_interface.show_dialog("Huh...?\nDu meinst das heteromorphe Objekt der XK-Klasse?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("„Phantom Force“ ist Masadas heteromorphes Objekt der strategischen Klasse, das als unbeweglicher, ausgewiesener Raum existiert.")
	await novel_interface.show_text_only("Jede Waffe, die aus diesem Raum abgefeuert wird, erhält einen ungewöhnlichen Verstärkungseffekt und erzeugt eine um ein Vielfaches bis Hundertfaches größerer Zerstörungskraft als ursprünglich vorgesehen.")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_doomsday.png")
	await novel_interface.show_text_only("Das von der Third School City vor einiger Zeit angekündigte „automatische Gegenangriffssystem“ macht sich genau diese Eigenschaft zunutze.")
	await novel_interface.show_text_only("Wenn das System feststellt, dass der Schaden im Stadtgebiet von Masada 50 % überschritten hat, aktiviert es automatisch das „Doomsday Program“──")
	await novel_interface.show_text_only("Verwendung von Phantom Force, um wahllos Atomwaffen auf jede größere Stadt der Welt abzufeuern und so gegenseitige Zerstörung sicherzustellen.")
	await novel_interface.show_text_only("Als es zum ersten Mal angekündigt wurde, löste es heftigen Protest aus, aber die Leute schienen die vollendeten Tatsachen überraschend schnell zu akzeptieren.")
	await novel_interface.show_text_only("Dass es Masada gelang, schnell eine Waffenstillstandsvereinbarung mit dem Widerstand zu schließen, hat wahrscheinlich viel mit diesem System zu tun.")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_Masadainner.png")
	novel_interface.show_character("anne_uniform","smile")
	await novel_interface.show_dialog("Sehen Sie die Metallpanzerung dieser Gebäude?", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","stare")
	await novel_interface.show_dialog("Mir ist es vorhin aufgefallen...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sag mir nicht, dass diese ganze Stadt gebaut wurde, um gegen Apostel zu kämpfen ...")
	novel_interface.show_character("anne_uniform","smile")
	await novel_interface.show_dialog("Ich habe gehört, dass der gesamte Untergrund der Innenstadt mit derselben Panzerung ausgekleidet ist.", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Je mehr ich höre, desto mehr klingt es genau so!")
	novel_interface.show_character("ren_medical","perspire1")
	await novel_interface.show_dialog("W-Was meinst du...?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","smile")
	await novel_interface.show_dialog("Warum, glauben Sie, haben sie sich entschieden, ihre neue Hauptstadt in dieser kargen Salzwüste am Toten Meer zu errichten──?", "Annie")
	await novel_interface.show_dialog("Und dann wurde eine enorme Summe ausgegeben, um einen großen Kanal mit einem Gefälle von über vierhundert Metern zu bauen, nur um eine Hauptstadt in solch einer miserablen Lage zu unterstützen.", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","panic")
	await novel_interface.show_dialog("Wegen dem Phantom Force unten...?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ich zeigte auf den Boden unter meinen Füßen, aber irgendetwas daran fühlte sich komisch an.")
	novel_interface.show_character("ren_medical","panic")
	await novel_interface.show_dialog("Aber das ist immer noch eine viel zu große Investition ... Es ist nicht wie Aegis, ein Schild, der jeden Angriff von außen abwehren kann.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","worry")
	await novel_interface.show_dialog("Aus diesem Grund vermutet jedes Land, dass Phantom Force über ein nicht offengelegtes Schlüsseleigentum verfügt.", "Annie")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Genug, dass die Führer von Masada bereit waren, das Schicksal des gesamten Volkes in diesem Land aufs Spiel zu setzen.", "Annie")
	await novel_interface.show_dialog("Man könnte sagen, die ganze Stadt ist eine Schutzanlage, die um Phantom Force── herum gebaut ist", "Annie")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("Als Teil dieses Verteidigungssystems scheint der Bau einer Isolationsmauer in diesem Ausmaß dann gar nicht so seltsam, oder?", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","stare")
	await novel_interface.show_dialog("„Masada Shall Never Fall“ trägt also auch diese Implikation …", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Doch je unerbittlicher ein Geheimnis gehütet wird, desto neugieriger macht es die Menschen...")
	await novel_interface.show_text_only("Ich drehte mich um und blickte auf die riesige Werbetafel vor dem Knesset-Bahnhof, auf der derselbe Slogan stand, und sah unerwartet ein bekanntes Gesicht──")
	await novel_interface.show_text_only("Emilio, eine vollgestopfte weiße Einkaufstasche in der Hand, kam gerade die Rolltreppe am Bahnhofsausgang hinauf ...")
	novel_interface.show_character("emilio","smile")
	await novel_interface.show_dialog("Ach?", "Emily")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Der Leutnant begegnete meinem Blick, lächelte und ging hinüber.")
	await novel_interface.show_text_only("Annie benahm sich sofort wie eine Profi-Frau wie eine Fremde, die mich nicht kannte, schleppte ihren Koffer weg und schaute dabei auf ihr Handy.")
	await novel_interface.show_text_only("In der Zwischenzeit schien Stardust in den letzten zwei Tagen gemerkt zu haben, dass niemand sonst sie sehen oder hören konnte, und war viel mutiger geworden.")
	await novel_interface.show_text_only("Sie stand selbstgefällig vor mir wie ein kleiner Hund, dem es Mut macht, seinen Besitzer hinter sich zu haben.")
	novel_interface.show_character("emilio","mock")
	await novel_interface.show_dialog("Ach! Du bist diese... angehende Krankenschwester vom Casino-Schiff, oder?", "Emily")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sie warf einen Blick auf das Namensschild, das an meiner Brust hing.")
	novel_interface.show_character("emilio","mock")
	await novel_interface.show_dialog("Dein Name ist Lian, richtig~", "Emily")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","perspire1")
	await novel_interface.show_dialog("H-Hallo...\nIch freue mich, dich wiederzusehen.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("emilio","mock")
	await novel_interface.show_dialog("Haha, ich wollte es dir sagen – nachdem du an diesem Tag gegangen warst, habe ich diesem Kellner eine ordentliche Lektion erteilt.", "Emily")
	await novel_interface.show_dialog("Später fanden wir heraus, dass er auch mehrere der weiblichen Dealer belästigt hatte.", "Emily")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","wail")
	await novel_interface.show_dialog("——Was!?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Er war also auch ein Wiederholungstäter?")
	novel_interface.show_character("emilio","mock")
	await novel_interface.show_dialog("Und dieses Mal wagte er es sogar, Hand an einen Gast zu legen. War sein Gehirn kurzgeschlossen oder was?", "Emily")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","wry_smile")
	await novel_interface.show_dialog("Ahahaha...!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Es war tatsächlich das Hypnosespray!")
	novel_interface.show_character("ren_medical","happy")
	await novel_interface.show_dialog("Apropos, ich muss Ihnen wirklich dafür danken, dass Sie mich früh an diesem Tag durch die Sicherheitskontrolle gewinkt haben ...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("emilio","smile")
	await novel_interface.show_dialog("Oh, es war nichts. In letzter Zeit lieben es die Vorgesetzten, uns für alle möglichen langweiligen Aufgaben zu verpflichten.", "Emily")
	novel_interface.change_expression("upset")
	await novel_interface.show_dialog("Und beim letzten Mal haben sie sich auch lächerlich gemacht – das Eindämmungsteam hat einen halben Tag damit verbracht, das Schiff mit einem Berg an Ausrüstung zu scannen und absolut nichts gefunden.", "Emily")
	novel_interface.change_expression("speechless")
	await novel_interface.show_dialog("Keine Ahnung, woher sie diese gefälschten Informationen damals gekauft haben ...", "Emily")
	await novel_interface.hide_character()
	novel_interface.show_character("stardust_small","stare")
	await novel_interface.show_dialog("Hmpf! Und sie musste immer noch so gemein sein...", "Stardust")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Stardust streckte Emilio die Zunge heraus.")
	novel_interface.show_character("stardust_small","stare")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("emilio","normal",0.25)
	await novel_interface.show_dialog("Übrigens──", "Emily")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Emilio ging in die Hocke.")
	novel_interface.show_character("stardust_small","stare")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("emilio","smile",0.25)
	await novel_interface.show_dialog("Dieses Kind ist bezaubernd ~ Sie ist keine Einheimische, oder?", "Emily")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Stardust und ich erstarrte auf der Stelle.")
	novel_interface.show_character("stardust_small","panic")
	await novel_interface.show_dialog("Huh...?\nUgh... guh...", "Stardust")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("All ihre Tapferkeit verschwand augenblicklich. Sie war fast zu Tränen gerührt und versteckte sich hektisch hinter mir.")
	novel_interface.show_character("stardust_small","panic")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_medical","wail",0.25)
	await novel_interface.show_dialog("Ah? Hahaha...\nS-Sie ist meine... meine, ähm...", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Wie sieht sie sie überhaupt!?")
	await novel_interface.show_text_only("Emilio zog eine Glasflasche mit einer durchsichtigen roten Flüssigkeit aus ihrer Einkaufstasche. Es war kein Etikett darauf.")
	novel_interface.show_character("stardust_small","panic")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("emilio","smile",0.25)
	await novel_interface.show_dialog("Frisch gepresster Granatapfelsaft. Es ist köstlich~\nEine der berühmtesten Spezialitäten der Stadt.", "Emily")
	await novel_interface.show_dialog("Hier, nimm eins──", "Emily")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Als sie das sagte, hielt sie Stardust die Flasche hin. Als mir klar wurde, dass ich sie aufhalten musste, war es zu spät.")
	await novel_interface.show_text_only("Ich konnte praktisch sehen, wie die Flasche den Körper von Stardust durchdrang und auf dem Boden zerbrach ...")
	novel_interface.show_character("stardust_small","uneasy")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("emilio","smile",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Mm... danke...", "Stardust")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Stardust fing die Flasche auf und hielt sie in ihren Armen.\nEmilio streckte die Hand aus und tätschelte ihren Kopf.")
	novel_interface.show_character("stardust_small","uneasy")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("emilio","mock",0.25)
	await novel_interface.show_dialog("So ein gutes Mädchen~", "Emily")
	novel_interface.character_light(0.35,"konata_eye")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ehehe~~", "Stardust")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Was ist los...?\nHat dieses kleine Ding... aufgehört, eine Illusion zu sein?")
	await novel_interface.show_text_only("Seit wann? Hatten Annie und ich es einfach nicht bemerkt, weil wir sie die ganze Zeit über sehen konnten?")
	await novel_interface.show_text_only("Nein, es musste sein, nachdem wir die Einwanderungsbehörde passiert hatten. Sonst hätte uns der Zoll nie so einfach durchgelassen.")
	await novel_interface.show_text_only("Was bedeutet, dass es gerade passiert ist?")
	await novel_interface.show_text_only("Wie auch immer, wir sollten es später im Hotel untersuchen. Jetzt müssen wir uns durch einen Bluff durchsetzen")
	await novel_interface.show_text_only("Moment, wenn wir gerade von Einwanderung sprechen ...")
	novel_interface.show_character("emilio","normal")
	await novel_interface.show_dialog("Trotzdem, Lian──", "Emily")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Emilio schien etwas zu bemerken. Sie packte beiläufig das Handgelenk von Stardust und drehte es um.")
	novel_interface.show_character("emilio","stare")
	await novel_interface.show_dialog("Warum hat sie keinen Einwanderungsbarcode auf der Hand?", "Emily")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mein Kopf summte und Schweiß begann auf meiner Stirn zu perlen.")
	await novel_interface.show_text_only("Es ist vorbei, es ist vorbei. Ich werde verhaftet!!")
	await novel_interface.show_text_only("Ich habe gehört, dass sogar normale Bürger in Masada äußerst sensibel gegenüber illegalen Einreisenden sind – ganz zu schweigen davon, wenn uns Soldaten auf frischer Tat auf frischer Tat ertappt werden ...")
	await novel_interface.show_text_only("Emilio studierte meinen steifen Gesichtsausdruck und warf dann einen Blick auf Stardust, der immer noch den Granatapfelsaft umarmte und dumm grinste, ohne etwas zu verstehen.")
	novel_interface.show_character("emilio","speechless")
	await novel_interface.show_dialog("Seufz. Wenn du so offen mit ihr durch die Stadt gehst, wirst du innerhalb einer Stunde verhaftet.", "Emily")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Emilio nahm ein Handgerät aus ihrem Gürtelclip. Es sah aus wie ein Mobiltelefon, das zwei- oder dreimal dicker als normal war.")
	await novel_interface.show_text_only("Nach mehrmaligem Antippen tauchte ein etwa einen Zentimeter breiter, mit einem Barcode bedruckter weißer Papierstreifen aus dem Druckerschacht des Geräts auf.")
	await novel_interface.show_text_only("Sie wickelte den Papierstreifen um Stardusts Arm und klebte die Enden zusammen.")
	novel_interface.show_character("emilio","smile")
