# stardustdescends_ep09.gd - 星尘降临篇第9话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	stardustdescends_ep09_script()

func play_script():
	pass

func stardustdescends_ep09_script():
	novel_interface.change_music("res://assets/audio/music/Normal Stage.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_Ordovician.png")
	await novel_interface.show_text_only("Mọi người luôn thích suy đoán: nếu tồn tại một nền văn minh ngoài hành tinh hùng mạnh thì đó là nhân từ hay độc hại?")
	await novel_interface.show_text_only("Một câu trả lời thích hợp hơn là──nó thờ ơ.")
	await novel_interface.show_text_only("Một ngày cách đây 449 triệu năm, một chùm tia gamma năng lượng cao cách chúng ta 6.000 năm ánh sáng đã xuyên qua bầu khí quyển và tấn công Trái đất.")
	await novel_interface.show_text_only("Trong chốc lát, bức xạ đã phá hủy 1/3 tầng ozone, khiến tia cực tím từ mặt trời truyền thẳng vào bầu khí quyển.")
	await novel_interface.show_text_only("Một lượng lớn sinh vật phù du chết, phá vỡ nền tảng của chuỗi thức ăn biển và nạn đói bắt đầu lan rộng.")
	await novel_interface.show_text_only("Vài thập kỷ sau thảm họa, các phân tử khí quyển bị vỡ vụn kết hợp lại, tạo thành một lượng lớn nitơ dioxide độc hại.")
	await novel_interface.show_text_only("Khí nitơ dioxide che khuất bầu trời, chặn 50% ánh sáng mặt trời. Thiếu ánh sáng mặt trời, Trái đất bắt đầu nguội đi nhanh chóng.")
	await novel_interface.show_text_only("Nhiệt độ đại dương giảm từ 25 độ xuống còn 10, và sự chết thêm của sinh vật phù du đã đẩy nhanh sự sụp đổ của chuỗi thức ăn.")
	await novel_interface.show_text_only("Năm trăm năm sau thảm họa, một phần ba sự sống trên Trái đất đã biến mất, và những gì còn lại phải vật lộn với nạn đói và cái lạnh.")
	await novel_interface.show_text_only("Khi ánh sáng mặt trời giảm dần, một lượng lớn nước biển đóng băng trên toàn thế giới. Sông băng lan rộng với tốc độ không thể tưởng tượng được và mực nước biển giảm 100 mét.")
	await novel_interface.show_text_only("Một trăm năm mươi nghìn năm sau thảm họa, nhiệt độ trung bình toàn cầu giảm xuống 5 độ. Hầu hết bề mặt được bao phủ trong băng và hơn một nửa số loài đã chết vì giá lạnh.")
	await novel_interface.show_text_only("Sự sơ suất bất cẩn của một ngôi sao xa xôi sụp đổ đâu đó trong thiên hà đã khiến sự sống cổ xưa trên Trái đất rơi vào tuyệt vọng vô tận.")
	await novel_interface.show_text_only("──Vụ tai nạn đó được lịch sử gọi là sự tuyệt chủng hàng loạt vào cuối kỷ Ordovic.")
	await novel_interface.hide_background()
	await novel_interface.stop_music()
	await novel_interface.show_text_only("...")
	await novel_interface.show_text_only("...")
	await novel_interface.show_text_only("Thành phố trường học thứ năm.")
	await novel_interface.show_text_only("Khi một giai điệu nhẹ nhàng vang lên, người đàn ông nằm dài trên ghế sofa từ từ tỉnh dậy...")
	novel_interface.change_music("res://assets/audio/music/Sunset.mp3")
	novel_interface.show_background("res://assets/images/bg/Fabiola/BAR.png")
	await novel_interface.show_text_only("Với râu ria trên mặt và mái tóc rối bù, anh ấy cố gắng đứng thẳng bằng lưng ghế sofa để làm điểm tựa.")
	await novel_interface.show_text_only("Một ly nước đặt trên bàn trước mặt anh. Cổ họng anh khô khốc như vừa mới bước ra khỏi sa mạc nên anh chộp lấy và uống cạn trong một ngụm.")
	await novel_interface.show_text_only("Sau đó một cơn đau đầu ập đến với anh. Anh ta ôm đầu rên rỉ một lúc rồi đột nhiên đứng dậy như đang tìm kiếm thứ gì đó.")
	await novel_interface.show_text_only("Khi tìm thấy chiếc cặp của mình bên cạnh ghế sofa và xác nhận tài liệu bên trong vẫn còn nguyên vẹn, anh mới yên tâm một chút và ngồi xuống lần nữa.")
	novel_interface.show_character("shi","normal")
	await novel_interface.show_dialog("Đây là...\nTôi đang ở đâu...?", "Professor Shih")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Giáo sư Shih nhìn quanh. Nơi này giống như một quán bar cao cấp, với tiếng nhạc nhẹ nhàng vang khắp phòng và ánh đèn neon nhấp nháy trên các tòa nhà bên ngoài.")
	await novel_interface.show_dialog("Bạn tỉnh rồi à?", "Giọng nữ")
	await novel_interface.show_text_only("Theo giọng nói đó, giáo sư Shih nhìn thấy một người phụ nữ tóc đỏ mặc áo khoác trắng từ từ tiến lại gần với đồ uống màu vàng nhạt trên tay.")
	await novel_interface.show_text_only("Cô đặt đồ uống trước mặt anh và ngồi xuống chiếc ghế sofa đối diện.")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Đó là nước điện giải. Nó sẽ giúp giảm đau đầu.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("shi","normal")
	await novel_interface.show_dialog("Bạn là...?", "Professor Shih")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Giáo sư Shih nghi ngờ nhìn chằm chằm vào khuôn mặt của cô, như thể ông có chút ký ức mơ hồ nào về cô.")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Bạn nên biết tôi──", "Mariru")
	await novel_interface.show_dialog("Tôi là Mariru von Braun. Năm ngoái, khi bạn đến Học viện Khoa học New Toyosu với tư cách là học giả thỉnh giảng, bạn đã tham dự bài giảng của tôi về các vật thể dị hình kết tinh.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru dừng lại, rồi mỉm cười và tiếp tục.")
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("Ngoài ra, tôi là người đứng đầu SID.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Giáo sư Shih giật mình, theo bản năng muốn chạy, nhưng nhanh chóng bỏ đi suy nghĩ trẻ con đó──")
	await novel_interface.show_text_only("Mariru đưa cho anh một chiếc máy tính bảng và nói nhẹ nhàng,")
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Đừng sợ. Ở đây rất an toàn──", "Mariru")
	await novel_interface.show_dialog("Và nếu không có chúng tôi thì bạn đã chết rồi.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Giáo sư Shih nghi ngờ cầm lấy chiếc máy tính bảng. Nó đang chiếu đoạn phim giám sát đường phố.")
	await novel_interface.show_text_only("Anh chợt nhớ đã đợi ở căn biệt thự đó rất lâu mà không thấy người mua mà anh đã hẹn gặp. Khi rời đi, anh gọi một chiếc taxi.")
	await novel_interface.show_text_only("Khi đang đợi bên đường, anh cảm thấy cổ đau nhói, rồi mọi thứ trở nên tối đen...")
	novel_interface.show_character("shi","normal")
	await novel_interface.show_dialog("Đây là...", "Professor Shih")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Trong đoạn phim, giáo sư Shih đang đứng bên đường đợi taxi. Khi một người phụ nữ trung niên bình thường đi ngang qua phía sau anh ta, cô ấy đột nhiên rút ra một ống tiêm──")
	await novel_interface.show_text_only("Với chuyển động rõ ràng và hiệu quả, cô đâm chiếc kim vào cổ anh, rồi nhanh chóng đỡ lấy cơ thể đang gục xuống của anh từ phía sau.")
	await novel_interface.show_text_only("Khoảng ba giây sau, một chiếc xe tải màu đen mở cửa hông tấp vào lề đường, hai người bên trong kéo anh ta lên xe.")
	await novel_interface.show_text_only("Sau đó chiếc xe van phóng đi. Chưa đầy mười giây, anh ta đã biến mất như thể bốc hơi khỏi thế giới.")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Những người này là những kẻ giết người được một khách hàng ẩn danh thuê trực tuyến với giá cao. May mắn thay, chúng tôi đã dừng xe ở ngã tư đầu tiên...", "Mariru")
	await novel_interface.show_dialog("Lúc đó họ vừa định tiêm cho bạn một chất độc thần kinh. Chậm một bước nữa là bạn sẽ chết não ngay bây giờ.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Giáo sư Shih hít một hơi lạnh và cứng người.")
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Đó là lý do tại sao...", "Mariru")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("Bạn đã xúc phạm ai?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("shi","angry")
	await novel_interface.show_dialog("Xúc phạm...?\nH-Sao có thể thế được!", "Professor Shih")
	await novel_interface.show_dialog("Tôi chỉ là một học giả. Tôi có thể đã xúc phạm ai...", "Professor Shih")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Căn biệt thự đó luôn có danh tiếng vững chắc là “môi giới ngầm”. Cho dù đó là giao dịch vũ khí, tài liệu mật hay vật thể dị hình──", "Mariru")
	await novel_interface.show_dialog("Dưới sự bảo đảm của tổ chức mang tên \"Bảy điều răn\", dù người mua hay người bán hèn hạ đến đâu, không ai dám vượt quá giới hạn.", "Mariru")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Nhưng lần này, người mua mà bạn liên hệ sẵn sàng mạo hiểm loại bỏ một người mới vô giá trị như bạn. Tại sao?", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Giáo sư Shih phòng thủ kéo cổ áo khoác lên và liếc nhìn chiếc túi da cũ của mình.")
	novel_interface.show_character("shi","normal")
	await novel_interface.show_dialog("Bạn đã nhìn thấy nó rồi phải không? Đây là hồ sơ \"tuyệt mật\" từ Thành phố Trường học Đầu tiên. Có lẽ đó là Cổng Vô Hình...", "Professor Shih")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru dựa lưng vào ghế sofa và cười khinh bỉ──")
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("Nếu ngay cả người như bạn cũng có thể mang nó ra nước ngoài thì đó không thể là bí mật được.", "Mariru")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Ba tài liệu giống hệt nhau đã xuất hiện trên thị trường và bộ phận tình báo của Masada cũng có một tài liệu.", "Mariru")
	await novel_interface.show_dialog("Thậm chí có thể suy ra rằng Huayungong đã cố tình để tài liệu này bị rò rỉ──", "Mariru")
	await novel_interface.show_dialog("Và theo như tôi biết, những người bán khác đã giao dịch thông tin này đều hoàn thành giao dịch của mình mà không xảy ra sự cố nào.", "Mariru")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("So với họ, bạn có gì đặc biệt đến mức họ phải liều lĩnh bắt bạn phải im lặng?", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Giáo sư Shih ngơ ngác một lúc lâu, không nói được lời nào.")
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Tôi đoán là mức giá mà bạn đưa ra cho người mua trước đó không chỉ là tiền, phải không?", "Mariru")
	await novel_interface.show_dialog("Có lẽ điều bạn yêu cầu chính xác là điều khiến bạn suýt bị giết?", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Người đàn ông đối diện Mariru thở dài một hơi, thả lỏng rồi tựa lưng vào ghế sofa.")
	novel_interface.show_character("shi","eyeclose")
	await novel_interface.show_dialog("Những người như bạn... thật đáng sợ.", "Professor Shih")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("Tôi rất hân hạnh~", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Khóe miệng Mariru hơi nhếch lên.")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Vì bạn hiểu được tình hình hiện tại của mình──", "Mariru")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Sau đó hãy nói về thỏa thuận của chúng ta.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.stop_music()
	await novel_interface.hide_background_with_fade()
	await novel_interface.show_text_only("...")
	await novel_interface.show_text_only("Thành phố trường thứ ba, hải quan cảng Masada.")
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_MasadaCustoms.png")
	novel_interface.show_character("ren_medical","stare")
	await novel_interface.show_dialog("Liệu một thứ trông giống như một hình xăm có thể tự phân hủy sinh học được không...?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Tôi xoa mã vạch lên mu bàn tay. Rõ ràng mực sử dụng một số loại xử lý dị hình và tự động biến mất vào một thời điểm định sẵn.")
	await novel_interface.show_text_only("Mã vạch này là giấy phép nhập cảnh của hải quan Masada và là giấy tờ tùy thân hợp pháp duy nhất mà người nước ngoài có khi lưu trú tại quốc gia này.")
	await novel_interface.show_text_only("Thời điểm hết thời gian lưu trú được phép, mực sẽ tự bay hơi.")
	await novel_interface.show_text_only("Nếu không có mã vạch này, bất kỳ người lính hoặc nhân viên kiểm tra nào ở Masada đều có quyền bắt tôi ngay tại chỗ.")
	novel_interface.show_character("ren_medical","uneasy")
	await novel_interface.show_dialog("(Hmm...nó sẽ không bong ra khi mình tắm, phải không?)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("stardust_small","disgust")
	await novel_interface.show_dialog("Chậm quá...", "Stardust")
	novel_interface.change_expression("wordless")
	await novel_interface.show_dialog("Ôi ôi ôi ôi~~", "Stardust")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Chờ đợi mệt mỏi, Stardust lẩm bẩm những âm tiết vô nghĩa trong khi luồn lách đến cửa sổ hành lang và bám vào cây cột để nhìn ra bên ngoài.")
	await novel_interface.show_text_only("Tôi đưa cô ấy qua lối đi đặc biệt dành cho Tổ chức Cứu trợ Y tế Quốc tế, nhưng Annie phải xếp hàng qua làn đường an ninh thông thường dành cho du khách bình thường.")
	await novel_interface.show_text_only("An ninh của Masada nổi tiếng khắp thế giới vì sự nghiêm ngặt đến mức tàn bạo; ngay cả ở sảnh cảng, binh lính mang theo đạn thật tuần tra khắp nơi.")
	await novel_interface.show_text_only("Tôi bước tới phía sau Stardust và nhìn về phía đông qua cửa sổ. Ở đó tôi có thể nhìn thấy Biển Chết trong xanh yên tĩnh và Đập Elijah nằm ở cuối con kênh Grand Canal.")
	await novel_interface.show_text_only("Gần dòng chảy ở phía nam của đập Biển Chết, nước có màu cẩm thạch với màu ngọc lam và xanh nhạt không đồng đều, và càng nhìn xa về phía bắc, màu nước càng đậm.")
	await novel_interface.show_text_only("Theo Genesis, hai thành phố tội lỗi bị Chúa phá hủy—Sodom và Gomorrah—nằm chìm dưới phía nam Biển Chết.")
	await novel_interface.show_text_only("Tôi tự hỏi liệu biển có còn giữ những linh hồn lang thang nuôi dưỡng sự oán giận đối với “kẻ vĩ đại đó” hay không.")
	await novel_interface.show_text_only("Đúng lúc đó, ở chân trời phía đông bắc, đám mây mù màu đỏ sẫm do bão cát sinh ra đang bắt đầu khuấy động.")
	await novel_interface.show_text_only("Nhưng điều làm tôi ngạc nhiên nhất là cô bé này lại là người kể cho tôi nghe về cơn bão cát──")
	novel_interface.show_character("stardust_small","konata_eye")
	await novel_interface.show_dialog("Ừm?", "Stardust")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","smile")
	await novel_interface.show_dialog("Này~ bạn có biết lịch sử của Masada không?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Cô ấy chớp mắt nhìn tôi với câu \"Bạn đang nói về cái gì vậy?\" biểu cảm, trong khi chiếc tai nghe giống như tai mèo trên đầu cô ấy nhấp nháy nhanh hai lần.")
	novel_interface.show_character("ren_medical","smile")
