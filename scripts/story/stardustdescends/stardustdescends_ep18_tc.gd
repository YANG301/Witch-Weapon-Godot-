	novel_interface.show_character("hamon","serious")
	await novel_interface.show_dialog("外面那些記者，誰知道有多少他們的人呢……", "哈蒙")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("他當然明白，自己這幾年從軍隊系統內部培養出的軍情局，是無法和摩諾拉這種怪物相比的。")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_Speech.png")
