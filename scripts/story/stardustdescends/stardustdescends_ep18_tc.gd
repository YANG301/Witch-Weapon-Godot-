	await novel_interface.show_text_only("他意味深長的看著面前這位自己一手提拔的軍官。")
	novel_interface.show_character("hamon","serious")
	await novel_interface.show_dialog("被抓的那個女人，是卡拉卡爾營的少尉。", "哈蒙")
	await novel_interface.hide_character()
