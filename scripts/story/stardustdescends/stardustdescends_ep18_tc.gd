	await novel_interface.hide_character()
	await novel_interface.show_dialog("……電梯井！？
有、有人潛入會場了？", "少校")
	await novel_interface.show_text_only("少校快速翻閱著報告，腦袋頓時嗡的一下──")
	await novel_interface.show_text_only("難道剛才那次爆炸，是轉移注意力……")
