	await novel_interface.hide_character()
	await novel_interface.show_text_only("哈蒙盯著少校的眼睛，半晌沒有說話，少校不敢言語，只得筆直的站在原地。")
	await novel_interface.show_text_only("哈蒙哼了一聲，不滿的將手中的平板電腦拍向了少校的胸口──")
	novel_interface.show_character("hamon","speak")
	await novel_interface.show_dialog("你自己看吧！", "哈蒙")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("少校被拍得向後一個趔趄，趕緊扶穩平板，螢幕上赫然顯示著『摩諾拉』標誌性的七燈燭臺LOGO。")
	novel_interface.show_character("hamon","serious")
	await novel_interface.show_dialog("這是他們幾分鐘前發來的。", "哈蒙")
