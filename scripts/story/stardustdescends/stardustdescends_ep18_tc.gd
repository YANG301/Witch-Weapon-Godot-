# stardustdescends_ep18.gd - 星尘降临篇第18话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	stardustdescends_ep18_script()

func play_script():
	pass

func stardustdescends_ep18_script():
	novel_interface.change_music("res://assets/audio/music/Sewer.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_Psychology.png")
	await novel_interface.show_text_only("每個人都體驗過內心的痛苦──那感覺是如此的真切、沉重、讓人心焦、難以承受。")
	await novel_interface.show_text_only("然而很少有人知道，人類心理上的痛苦大多是後天習得的。")
	await novel_interface.show_text_only("吃個雞腿就能幸福一整天的小孩，無法理解在社交網路上被同學排斥和孤立的痛苦。")
	await novel_interface.show_text_only("無論你苦於無法融入團體、苦於不被周遭認同、還是苦於不能成為想象中的角色……")
	await novel_interface.show_text_only("這些痛苦全都構建在複雜的概念之上，是大量後天所習得的意義堆砌而出的副產品。")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_Camus.png")
	await novel_interface.show_text_only("加繆說，人類的荒誕之處在於，永遠要在無意義的宇宙中不停尋找意義。")
	await novel_interface.show_text_only("在意義的枷鎖中，沒人能夠獲得真正的自由。")
	await novel_interface.show_text_only("人類文明無法脫離意義，它是各個時代社會體系的基石。")
	await novel_interface.show_text_only("宗族的意義、國家的意義、主君的意義、宗教的意義、乃至民族認同、意識形態和流行文化……")
	await novel_interface.show_text_only("當你被灌輸了一套意義系統，就會自然而然的形成各種觀念，在腦內構造出價值階梯──")
	await novel_interface.show_text_only("什麼值得嘉獎和晉升，什麼需要唾棄和貶斥，怎樣是幸福和光榮，怎樣該痛苦和羞愧……")
	await novel_interface.show_text_only("改朝換代時有人痛苦到自殺，偶像結婚時也有人痛苦到自殺，二者的痛苦並無真偽之分。")
	await novel_interface.show_text_only("但如果你頭腦夠靈光，或許能偶爾的掙脫枷鎖，獨自出去放放風。")
	await novel_interface.show_text_only("然後再次回到群體中，繼續假裝掛上鐐銬，歌頌大家共同歌頌的，鄙視大家共同鄙視的。")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_Prisoner.png")
	await novel_interface.show_text_only("因為聰明的你一定已經意識到：人類不僅是意義的囚徒，還會自願成為它的獄卒。")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("…………")
	await novel_interface.show_text_only("……")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_ConventionCentre.png")
	await novel_interface.show_text_only("馬薩達國際會展中心，簽字儀式開場前。")
	await novel_interface.show_text_only("大廳中，上百家媒體的記者已經就位，各種閃光燈和攝影攝像器材隨時準備記錄這歷史性的一刻。")
	await novel_interface.show_text_only("而主席臺背面，厚重的藍色幕布將外面人聲鼎沸的大廳和後臺全隔絕開來。")
	await novel_interface.show_text_only("頂棚桁架上一排排嶄新的專業照明裝置，此時全都處於低亮度待機模式。")
	await novel_interface.show_text_only("牆壁包裹的隔音板和幕布上的隔音塗層，讓這裡安靜得有些詭異。")
	await novel_interface.show_text_only("身著沙漠迷彩作訓服的軍官看到穿著灰色西服的男人從幕簾後的通道走來，立刻挺直腰板敬禮。")
	await novel_interface.show_text_only("軍官迷彩服領章上的軍銜和金色六芒星標誌著這是一位國防軍上校。")
	await novel_interface.show_text_only("而他將要彙報的物件，正是今天馬薩達方面的簽約代表──國防軍北方司令部陸軍少將哈蒙。")
	await novel_interface.show_dialog("報告少將，我來做關於剛才襲擊的簡報。", "少校")
	await novel_interface.show_text_only("少將的身材有些發福，但頭髮梳得一絲不苟，目光依然保持著軍人特有的犀利。")
	await novel_interface.show_text_only("他邊走邊不耐煩的解下領帶，和手中黑色皮革底面的平板電腦夾在一起。")
	novel_interface.show_character("hamon","serious")
	await novel_interface.show_dialog("這東西真戴不慣……", "哈蒙")
	await novel_interface.show_dialog("你說吧。", "哈蒙")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("是關於30分鐘前，會展中心西南方爆炸事件的調查報告。", "少校")
	await novel_interface.show_dialog("爆炸物處理小隊根據現場痕跡判斷，那是以砂糖為主要原料的IED（簡易爆炸裝置）。", "少校")
	novel_interface.show_character("hamon","serious")
	await novel_interface.show_dialog("……砂糖做的土製炸彈？", "哈蒙")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("對，但爆炸烈度不大，沒有造成人員傷亡，炸藥似乎加入了能強化煙霧的新增物。", "少校")
	await novel_interface.show_dialog("煙霧在第一時間被我們撲滅了，警衛團現已將周圍區域戒嚴，目前沒有媒體報導此事。", "少校")
	await novel_interface.show_dialog("附近街道的監控錄影暫未發現疑犯蹤跡，現正擴大搜查範圍，報告完畢。", "少校")
	novel_interface.show_character("hamon","serious")
