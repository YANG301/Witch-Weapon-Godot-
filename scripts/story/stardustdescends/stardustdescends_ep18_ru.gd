# stardustdescends_ep18.gd - 星尘降临篇第18话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	stardustdescends_ep18_script()

func play_script():
	pass

func stardustdescends_ep18_script():
	novel_interface.change_music("res://assets/audio/music/Sewer.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_Psychology.png")
	await novel_interface.show_text_only("Каждый испытал внутреннюю боль — что-то такое настоящее, такое тяжелое, такое мучительное, такое трудновыносимое.")
	await novel_interface.show_text_only("Однако мало кто знает, что большинство психологических страданий приобретаются после рождения.")
	await novel_interface.show_text_only("Ребенок, который может весь день оставаться счастливым, имея только куриную голень, не может понять боль от того, что его исключают и изолируют одноклассники в социальных сетях.")
	await novel_interface.show_text_only("Страдаете ли вы из-за того, что не можете вписаться в группу, из-за того, что окружающие вас не принимают, или из-за того, что вы не можете стать тем человеком, которого представляете...")
	await novel_interface.show_text_only("Вся эта боль построена на сложных концепциях и является не чем иным, как побочным продуктом накопленных значений, усвоенных постфактум.")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_Camus.png")
	await novel_interface.show_text_only("Камю сказал, что абсурдность человечества заключается в бесконечном поиске смысла в бессмысленной вселенной.")
	await novel_interface.show_text_only("Под оковами смысла никто не может обрести истинную свободу.")
	await novel_interface.show_text_only("Человеческая цивилизация не может существовать без смысла; это основа социальных систем каждой эпохи.")
	await novel_interface.show_text_only("Значение клана, значение нации, значение господина, значение религии, даже этнической идентичности, идеологии и поп-культуры...")
	await novel_interface.show_text_only("Как только вам прививается система значений, естественным образом формируются всевозможные идеи, и в вашем уме выстраивается лестница ценностей.")
	await novel_interface.show_text_only("что заслуживает похвалы и поощрения, что заслуживает презрения и осуждения, что считается счастьем и честью, что должно приносить боль и стыд...")
	await novel_interface.show_text_only("Некоторых людей доводит до самоубийства династическая смена, других – женитьба их кумира; между их болью нет истинного или ложного различия.")
	await novel_interface.show_text_only("Но если ваш ум достаточно острый, возможно, вам удастся время от времени вырваться из оков и выскользнуть в одиночестве подышать воздухом.")
	await novel_interface.show_text_only("Затем вы возвращаетесь в группу, продолжаете притворяться, что носите цепи, восхваляя то, что все хвалят, и презирая то, что все презирают.")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_Prisoner.png")
	await novel_interface.show_text_only("Потому что, если вы умны, вы уже должны это осознать: человечество не только узник смысла, но и охотно становится его тюремщиком.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("..............")
	await novel_interface.show_text_only("...")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_ConventionCentre.png")
	await novel_interface.show_text_only("Международный конференц-центр Масады перед церемонией подписания.")
	await novel_interface.show_text_only("В зале уже находились репортеры более сотни СМИ со вспышками и камерами, готовыми запечатлеть этот исторический момент.")
	await novel_interface.show_text_only("За трибуной тяжелый синий занавес полностью отделял шумный зал от закулисья.")
	await novel_interface.show_text_only("Ряды совершенно новых профессиональных осветительных установок на потолочных фермах находились в режиме ожидания с низкой яркостью.")
	await novel_interface.show_text_only("Акустические панели, обрамленные стенами, и звукоизоляционное покрытие на занавеске создавали пугающую тишину.")
	await novel_interface.show_text_only("Когда офицер в пустынном камуфляже увидел человека в сером костюме, приближающегося через проход за занавеской, он тут же выпрямился и отдал честь.")
	await novel_interface.show_text_only("Знаки различия на камуфляжном воротнике и золотая шестиконечная звезда указывали на то, что он был майором Сил обороны.")
	await novel_interface.show_text_only("И человеком, которого он собирался проинформировать, был сегодняшний представитель Масадана: генерал-майор Хамон из Северного командования Сил обороны.")
	await novel_interface.show_dialog("Докладывайте, сэр. Я здесь, чтобы проинформировать вас о нападении прямо сейчас.", "Майор")
	await novel_interface.show_text_only("Генерал-майор немного прибавил в весе, но волосы его по-прежнему были причесаны с идеальной аккуратностью, а взгляд сохранил характерную солдатскую остроту.")
	await novel_interface.show_text_only("На ходу он нетерпеливо ослабил галстук и сунул его вместе с черным планшетом в кожаной обложке в руке.")
	novel_interface.show_character("hamon","serious")
	await novel_interface.show_dialog("Я никогда не смогу привыкнуть носить эту вещь...", "Хамон")
	await novel_interface.show_dialog("Продолжайте.", "Хамон")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Это отчет о расследовании взрыва к юго-западу от конференц-центра тридцать минут назад.", "Майор")
	await novel_interface.show_dialog("Основываясь на следах на месте происшествия, группа по обезвреживанию бомб пришла к выводу, что это было СВУ, изготовленное в основном из сахара.", "Майор")
	novel_interface.show_character("hamon","serious")
	await novel_interface.show_dialog("...Самодельная бомба из сахара?", "Хамон")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Да, но мощность взрыва была невысокой и жертв не было. Судя по всему, взрывчатка содержала добавки, усиливающие дым.", "Майор")
	await novel_interface.show_dialog("Мы немедленно потушили дым. Полк охраны сейчас оцепил прилегающую территорию, и ни одно СМИ пока не сообщило об инциденте.", "Майор")
	await novel_interface.show_dialog("Уличное наблюдение поблизости пока не выявило подозреваемых. Сейчас мы расширяем зону поиска. Отчет завершен.", "Майор")
	novel_interface.show_character("hamon","serious")
	await novel_interface.show_dialog("...И это все?", "Хамон")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Хамон посмотрел майору в глаза и долгое время ничего не говорил. Майор не смел говорить и мог только твердо стоять на месте.")
	await novel_interface.show_text_only("Хамон фыркнул и, недовольный, хлопнул планшетом, который держал в руке, о грудь майора...")
	novel_interface.show_character("hamon","speak")
	await novel_interface.show_dialog("Посмотрите сами!", "Хамон")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Отшатнувшись от удара, майор поспешно удержал планшет. На экране был знаковый логотип Монолы в виде семисвечника.")
	novel_interface.show_character("hamon","serious")
	await novel_interface.show_dialog("Они отправили это несколько минут назад.", "Хамон")
	await novel_interface.show_dialog("Монола заметил трех подозрительных людей, которые зашли в подземный гараж.", "Хамон")
	await novel_interface.show_dialog("Двое из них проскользнули в шахту лифта с намерением вывести из строя систему пожаротушения здания.", "Хамон")
	await novel_interface.show_dialog("К счастью, их агенты вовремя вмешались. Одного они поймали, но двое других сбежали; одного из них при бегстве задела пуля.", "Хамон")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("...Шахта лифта!?\nS-Кто-то проник на место встречи?", "Майор")
	await novel_interface.show_text_only("Майор быстро пролистал отчет, и в голове у него сразу загудело:")
	await novel_interface.show_text_only("Был ли этот взрыв всего лишь отвлекающим маневром...?")
	await novel_interface.show_text_only("Поскольку наземная парковка была занята силами безопасности и военной техникой, все фургоны с оборудованием для СМИ были припаркованы в подвале конференц-центра.")
	await novel_interface.show_text_only("Тогда в подземный гараж действительно было легче всего проникнуть.")
	await novel_interface.show_text_only("Хотя военная разведка организовала усиленную охрану в каждом углу здания, нижняя часть кабины лифта оставалась слепой зоной для наблюдения.")
	await novel_interface.show_text_only("Осознав, что организованная им оборонительная линия была так легко прорвана, на лбу майора тут же выступил пот.")
	novel_interface.show_character("hamon","speak")
	await novel_interface.show_dialog("Разве военная разведка не заверила меня, что охрана объекта безупречна?", "Хамон")
	novel_interface.change_expression("shout")
	await novel_interface.show_dialog("Я намеренно оттащил людей Монолы и отправил их на внешний периметр, и вот как вы меня выставляете?!", "Хамон")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Вспомнив, что зал за занавесом был полон репортеров, Хамон намеренно понизил голос, упрекая его.")
	await novel_interface.show_dialog("Это...\nI-Это был мой провал!", "Майор")
	await novel_interface.show_dialog("Но разве агенты Монолы не были расквартированы вокруг конференц-центра?\nКак они могли оказаться внутри здания...?", "Майор")
	await novel_interface.show_text_only("Хамон слегка покачал головой и похлопал майора по плечу.")
	novel_interface.show_character("hamon","serious")
	await novel_interface.show_dialog("Среди репортеров, кто знает, сколько из них принадлежат им...", "Хамон")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Он прекрасно понимал, что Бюро военной разведки, которое он взрастил в армейской системе за последние несколько лет, не могло сравниться с таким монстром, как Монола.")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_Speech.png")
	await novel_interface.show_text_only("«Они — нервная система этой страны, способная среагировать на любую опасность с величайшей скоростью».")
	await novel_interface.show_text_only("«Если кто-то пустит в вас стрелу, и вам нужно, чтобы ваш мозг подумал, прежде чем увернуться, вы умрете только со стрелой в своем теле».")
	await novel_interface.show_text_only("Дядя Хамона, премьер-министр Шнейдерман, однажды таким образом объяснил парламенту, почему Монола обладает неограниченной высшей оперативной властью.")
	await novel_interface.show_text_only("Но Хамон не мог допустить, чтобы вся разведывательная информация хранилась у организации, которую он не мог контролировать.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Информация – это сила. Это был боевой опыт, накопленный им за десятилетия, как во внутренних, так и во внешних войнах.")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_ConventionCentre.png")
	novel_interface.show_character("hamon","serious")
	await novel_interface.show_dialog("И кроме того...", "Хамон")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Он многозначительно посмотрел на стоявшего перед ним офицера, человека, которого лично повысил в должности.")
	novel_interface.show_character("hamon","serious")
	await novel_interface.show_dialog("Женщина, которую они поймали, — лейтенант батальона Каракал.", "Хамон")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("--Один из наших?!", "Майор")
	novel_interface.show_character("hamon","serious")
	await novel_interface.show_dialog("И кадет из Башни, причём...", "Хамон")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Хамон сказал это слово в слово.")
	await novel_interface.show_text_only("Понимая, какие политические последствия это может вызвать, майор не мог не затаить дыхание...")
	await novel_interface.show_text_only("В Силах обороны всегда было много голосов против этого соглашения, особенно среди молодых смутьянов, стремившихся отличиться.")
	novel_interface.show_character("hamon","serious")
	await novel_interface.show_dialog("Еще более странно то, что отпечатки пальцев, снятые на месте происшествия, показывают, что среди тех, кто действовал вместе с ней, был иностранец, зарегистрировавшийся в иммиграционной службе несколько дней назад.", "Хамон")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Заграничный... шпион?", "Майор")
	await novel_interface.show_text_only("Брови Хамона сдвинулись вместе, когда он на мгновение задумался.")
	novel_interface.show_character("hamon","speak")
	await novel_interface.show_dialog("Это возможно. В любом случае, я попросил Монолу сначала поделиться всей информацией, но не стоит ожидать, что они будут очень готовы помочь...", "Хамон")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("Я поручил гвардейскому полку задержать этого лейтенанта. Сейчас она в безопасной комнате наверху и тоже находится под вашим присмотром.", "Хамон")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Да, сэр!", "Майор")
	await novel_interface.show_text_only("Хамон отвернулся, поправил воротник и снова надел галстук.")
	novel_interface.show_character("hamon","speak")
	await novel_interface.show_dialog("Церемония вот-вот начнется...\nНе создавай мне больше проблем!", "Хамон")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Да! Даю вам слово, сэр!", "Майор")
	await novel_interface.show_text_only("Хамон помолчал, затем мрачно сказал, повернувшись спиной к майору:")
	novel_interface.show_character("hamon","serious")
	await novel_interface.show_dialog("Я сегодня не ношу форму. Не обращайтесь ко мне по моему званию.", "Хамон")
	await novel_interface.show_dialog("Народу больше не нужны солдаты, возглавляющие правительство... понятно?", "Хамон")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Ах... понял!", "Майор")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("...\nМеждународный конференц-центр Масада, открытая парковка.")
	await novel_interface.show_text_only("Внутри бронетранспортера.")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_MasadAPCRS.png")
	await novel_interface.show_dialog("Ты идиот--!!!\nТы попал прямо в их ловушку??!", "Мариру")
	await novel_interface.show_text_only("Если бы эти наушники не могли динамически регулировать громкость, мои барабанные перепонки, вероятно, умерли бы раньше меня.")
	novel_interface.show_character("ren_medical","panic")
	await novel_interface.show_dialog("Ууу...", "Лиан")
	novel_interface.change_expression("wry_smile")
	await novel_interface.show_dialog("Э-это...", "Лиан")
	await novel_interface.show_dialog("Б-потому что я не мог ни с кем связаться...", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я долго возился с управлением, прежде чем наконец отключил режим экранирования этого автомобиля и дозвонился до Мариру.")
	await novel_interface.show_text_only("В наушниках раздался тяжелый стук, и я представил, как она разбивает свой стол на куски.")
	await novel_interface.show_dialog("Итак... ты просто ушел сам, не так ли?", "Мариру")
	await novel_interface.show_dialog("Неужели я так давно давал тебе упражнения, что у тебя весь зуд без них...?", "Мариру")
	await novel_interface.show_text_only("Мариру перестала кричать и перешла на низкий, угрожающий тон.")
	await novel_interface.show_text_only("Это было похоже на извержение вулкана, и это было еще страшнее, чем раньше!")
	await novel_interface.show_dialog("Эй, эй...\nНе злись так~", "Ая")
	await novel_interface.show_text_only("Айя попыталась сгладить ситуацию своим обычным ленивым тоном.")
	await novel_interface.show_dialog("Даже если Лиан набрала все двойки на каждом физическом тесте, тот факт, что она добровольно вызвалась на такого рода полевые работы, все равно кое-что говорит о ее смелости~", "Ая")
	await novel_interface.show_text_only("Она пытается успокоить ситуацию или разжечь пламя!?")
	await novel_interface.show_text_only("У меня не было выбора. Я мог только стиснуть зубы и объясниться.")
	novel_interface.show_character("ren_medical","sob")
	await novel_interface.show_dialog("Б-Из-за звезд...", "Лиан")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_SlumArea.png")
	await novel_interface.show_dialog("Помню, вчерашняя ночь была ясной, в трущобах было мало огней, поэтому звезды было хорошо видно.", "Лиан")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_SlumArea1.png")
	await novel_interface.show_dialog("Но когда эти люди позже прошли через трущобы, ни одной звезды не было видно.", "Лиан")
	await novel_interface.show_dialog("И вдобавок ко всему, все устройства связи потеряли сигнал...", "Лиан")
	await novel_interface.show_dialog("Я чувствовал, что это был не обычный джем...", "Лиан")
	await novel_interface.hide_background()
	await novel_interface.show_dialog("...Что ты имеешь в виду?", "Мариру")
	await novel_interface.show_dialog("Это было похоже на ситуацию вокруг церкви в ту ночь, когда мы захватили Эльгану...", "Лиан")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_Church.png")
	await novel_interface.show_text_only("Той ночью, когда мой разговор с Мариру внезапно прервался, атмосфера вокруг меня тоже стала странной...")
	await novel_interface.show_text_only("Здания вдалеке расплывались и искажались, а ясное ночное небо мгновенно потемнело.")
	await novel_interface.show_dialog("Я это хорошо помню: все звезды на небе разом исчезли.", "Лиан")
	await novel_interface.show_dialog("И сразу после этого пришли те солдаты в черной спецназовской форме...", "Лиан")
