# stardustdescends_ep07.gd - 星尘降临篇第7话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	stardustdescends_ep07_script()

func play_script():
	pass

func stardustdescends_ep07_script():
	novel_interface.change_music("res://assets/audio/music/Shop.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_Vault.png")
	await novel_interface.show_text_only("A questo punto voglio solo andarmene di qui il più velocemente possibile. Segnale Stardust, poi mi dirigo verso l'ascensore.")
	await novel_interface.show_text_only("Capisce immediatamente la mia intenzione e mi raggiunge rapidamente.")
	await novel_interface.show_text_only("La bambina sembra sentire la mia ansia, quindi mi massaggia dolcemente il polso.")
	novel_interface.show_character("stardust_small","normal2")
	await novel_interface.show_dialog("(sussurra) Non preoccuparti.", "Stardust")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sentendo la sua mano morbida e la sua temperatura, mi calmo gradualmente, poi le tengo la mano.")
	novel_interface.show_character("stardust_small","normal2")
	await novel_interface.show_text_only("Sembra che abbiamo stabilito un legame speciale tra di noi. Comincia a sorridere.")
	await novel_interface.show_text_only("È strano: dopotutto ci siamo appena conosciuti.")
	await novel_interface.show_text_only("Inoltre, come mai sia il cameriere che i soldati l'hanno completamente ignorata?")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Dentro l'ascensore, pizzico il suo viso morbido mentre cerco di capire tutta la faccenda. Non le piace.")
	novel_interface.show_character("ren_full","gratified")
	await novel_interface.show_dialog("(La sua pelle in qualche modo mi calma...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Forse è come Beatrice? Entrambi hanno un potere speciale di cui loro stessi non si rendono nemmeno conto?")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_Gambling_Boat3.png")
	await novel_interface.show_text_only("Mentre cerco di valutare tutte le possibilità, l'ascensore ci riporta nella sala VIP.")
	await novel_interface.show_text_only("Appena la porta si apre mi rendo conto di quanto le cose siano diventate serie.")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_Gambling_Boat.png")
	await novel_interface.show_text_only("Decine di ospiti e dell'equipaggio sono già trattenuti dai soldati Masadan. Sono stati divisi in quattro gruppi e stanno aspettando in fila per i controlli di sicurezza.")
	await novel_interface.show_text_only("Un impiegato sta utilizzando un tablet militare per scattare foto di tutti gli ospiti nonostante le loro obiezioni.")
	await novel_interface.show_text_only("Nella stanza è stato installato un jammer per impedire agli ospiti di effettuare telefonate e tirare fili.")
	await novel_interface.show_text_only("Nemmeno il telefono e l'auricolare ricevono alcun segnale. Stardust è spaventata da ciò che vede e si nasconde dietro di me.")
	await novel_interface.show_text_only("All'uscita dell'atrio, un agente annuncia con l'altoparlante le regole del controllo di sicurezza.")
	novel_interface.show_character("valkyrja","normal")
	await novel_interface.show_dialog("Rimuovi orologi, gioielli e qualsiasi altro oggetto metallico.", "Ufficiale")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("Attacca un codice identificativo su tutte le tue borse e valigie, poi portale qui per la scansione.", "Ufficiale")
	await novel_interface.show_dialog("Se tutto è andato a buon fine, riceverai un braccialetto blu. Da qui può uscire solo chi ha il braccialetto.", "Ufficiale")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_full","panic")
	await novel_interface.show_dialog("Questo controllo di sicurezza non è uno scherzo...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Controllo per assicurarmi di avere ancora il braccialetto.")
	novel_interface.show_character("ren_full","worry")
	await novel_interface.show_dialog("(Questo braccialetto qui significa che ora sono al sicuro?)", "Lian")
	novel_interface.change_expression("panic")
	await novel_interface.show_dialog("(Aspetterò e vedrò per essere sicuro.)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mi guardo intorno. Di tutti i soldati di questo piano, solo l'ufficiale con l'altoparlante è una ragazza. E proprio come Emily, anche lei è molto giovane.")
	await novel_interface.show_text_only("Tutti gli altri soldati, però, sembrano rispettarla sinceramente.")
	novel_interface.show_character("ren_full","bored")
	await novel_interface.show_dialog("(Sembra una liceale...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("All'improvviso, un uomo robusto si libera e si precipita verso l'uscita. Urla all'ufficiale donna.")
	novel_interface.show_character("miller")
	await novel_interface.show_dialog("Sono l'arcivescovo Miller della Chiesa anglicana dell'India meridionale. Non hai il diritto di interrogare i servi di Dio!", "Miller")
	await novel_interface.show_dialog("Inoltre, la tua uniforme... non è affatto un'uniforme delle Forze di Difesa Masada!", "Miller")
	await novel_interface.show_dialog("Chi sei, davvero? Chi ha autorizzato questa operazione?", "Miller")
	await novel_interface.show_dialog("Esigo di parlare con il tuo supervisore!", "Miller")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("L'aggressivo arcivescovo sta di fronte alla giovane come una piccola montagna.")
	novel_interface.show_character("valkyrja","normal2")
	await novel_interface.show_dialog("Oh, non ho mai detto che fosse un'uniforme delle Forze di Difesa di Masada. Sono il maresciallo Vera Valkyrie, l'ufficiale temporaneo al comando.", "Ufficiale")
	novel_interface.change_expression("speechless")
	await novel_interface.show_dialog("Chi sei ancora? Qualcuno dell'India meridionale?\nSei una specie di ispettore fiscale?", "Vera")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Vera sembra aver capito qualcosa.")
	novel_interface.show_character("valkyrja","speechless")
	await novel_interface.show_dialog("Non c'è da stupirsi che tu sia grande... Dipende dal territorio del tuo lavoro, suppongo.", "Vera")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("L'ultima volta che ho controllato, però, quella regione era in guerra. La gente paga ancora le tasse durante la guerra?", "Vera")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ignora completamente la faccia rossa dell'arcivescovo mentre prende la tavoletta che un impiegato le porge.")
	novel_interface.show_character("valkyrja","happy")
	await novel_interface.show_dialog("Bene, bene, bene... Chi l'avrebbe mai detto. Sei in possesso di un visto per lavoratore religioso.", "Vera")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Vera ride con disprezzo, poi guarda il tavolo della roulette.")
	novel_interface.show_character("valkyrja","happy")
	await novel_interface.show_dialog("Un servitore di Dio. Capisco... Qualcuno come te ha il tempo e i mezzi per mangiare tutto quel cibo delizioso. Ti sei divertito al casinò?", "Vera")
	novel_interface.change_expression("wink")
	await novel_interface.show_dialog("E qui ho pensato \"Dio non gioca a dadi\".", "Vera")
	await novel_interface.hide_character()
	novel_interface.show_character("miller")
	await novel_interface.show_dialog("Questa è una bestemmia!", "Miller")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("L'arcivescovo non ne può più. Inizia a gridare mentre si avvicina a Vera, pronto a diventare fisico. Ma prima che possa raggiungere Vera, lei lo afferra per il colletto.")
	await novel_interface.show_text_only("Sono scioccato da ciò che vedo.")
	await novel_interface.show_text_only("Con una sola mano Vera solleva in aria il pesante arcivescovo.")
	novel_interface.show_character("ren_full","panic")
	await novel_interface.show_dialog("(Che forza!)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("valkyrja","speechless")
	await novel_interface.show_dialog("Nel caso non mi avessi sentito la prima volta...", "Vera")
	novel_interface.change_expression("angry")
	await novel_interface.show_dialog("Non sono un soldato. Sono un cadetto del \"Programma Talpiot\" che è stato assegnato qui all'ultimo minuto.", "Vera")
	await novel_interface.show_dialog("Non voglio niente di tutto questo, ma quelli del Comitato per le Forze Armate pensano di poterci comandare.", "Vera")
	await novel_interface.show_dialog("E possono! Mi sono arrabbiato per questa cosa in questi giorni. Se mi incroci di nuovo, ti getterò nell'oceano e ti darò in pasto agli squali!", "Vera")
	await novel_interface.show_dialog("Siamo chiari?!", "Vera")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Il volto dell'arcivescovo è diventato viola. Incapace di parlare, annuisce frettolosamente.")
	novel_interface.show_character("valkyrja","angry")
	await novel_interface.show_dialog("Torna in linea!", "Vera")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Non appena lo lascia andare, l'arcivescovo torna di corsa alla sua fila mentre riprende fiato.")
	novel_interface.show_character("ren_full","wry_smile")
	await novel_interface.show_dialog("Eh, scusami...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mi avvicino con cautela e le mostro il mio braccialetto.")
	novel_interface.show_character("ren_full","wry_smile")
	await novel_interface.show_dialog("Ho già il braccialetto. Posso partire adesso?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Vera è un po' sorpresa. Scansiona il codice a barre sul mio braccialetto, poi sorride.")
	novel_interface.show_character("valkyrja","wink")
	await novel_interface.show_dialog("Sì, puoi andartene.", "Vera")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mi sento sollevato. Sono anche felice che nessuno su questo piano possa vedere neanche Stardust.")
	await novel_interface.show_text_only("Non appena esco dalla stanza, un membro dello staff del casinò si avvicina per scusarsi.")
	await novel_interface.show_text_only("Secondo lui, Lebona negozierà con Masada per assicurarsi che nessuna informazione sui clienti venga trapelata.")
	await novel_interface.show_text_only("I segnali in tutta la cabina sono disturbati. Mi dice che se devo fare una telefonata posso usare la loro linea fissa oppure andare sul ponte di poppa.")
	novel_interface.change_music("res://assets/audio/music/unkown/UI_Main_Funk.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/Vessel.png")
	await novel_interface.show_text_only("Trascino Stardust e cammino fino al ponte.")
	await novel_interface.show_text_only("Una motovedetta Super Dvora Mk è ormeggiata accanto alla nave da gioco, sulla barca è appesa la bandiera nazionale blu e bianca.")
	novel_interface.show_character("ren_full","smile")
	await novel_interface.show_dialog("Finalmente un po' d'aria fresca!", "Lian")
	novel_interface.change_expression("sob")
	await novel_interface.show_dialog("(Dopo tutto, tutte le finestre all'interno del casinò sono chiuse.)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Allungo le braccia mentre guardo il ponte sul canale.")
	novel_interface.show_character("ren_full","gratified")
	await novel_interface.show_dialog("È questo il Canale di Suez?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("stardust_small","happy",0.25)
	await novel_interface.show_dialog("Ehi!", "Stardust")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Stardust è più emozionato di me. Salta fino al recinto della nave.")
	novel_interface.show_character("ren_full","worry")
	await novel_interface.show_dialog("(È solo una coincidenza? Stardust si sta dirigendo verso la poppa della nave.)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("All'improvviso il mio telefono squilla: una voce familiare attende.")
	await novel_interface.show_dialog("Lian? Stai bene?", "Annie")
	await novel_interface.show_dialog("Sta bene. Sta facendo un po' di stretching davanti all'oceano.", "Mariru")
	await novel_interface.show_dialog("Ah, il dolce profumo della giovinezza! È questo il tuo modo per ottenere un paio ancora più grande?", "Aya")
	await novel_interface.show_text_only("Si scopre che si tratta di una teleconferenza: in linea ci sono anche Mariru e alcuni altri...")
	novel_interface.show_character("ren_full","awkward")
	await novel_interface.show_dialog("Mi stanno spiando?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mi guardo intorno e non riesco a individuare alcun dispositivo di sorveglianza. Poi mi rendo conto che probabilmente viene da molto più in alto.")
	novel_interface.show_character("ren_full","shy")
	await novel_interface.show_dialog("(È strano sapere che un paio di occhi osservano ogni mio movimento...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Andiamo al punto: cosa è successo prima?", "Mariru")
	novel_interface.show_character("ren_full","shy_left")
	await novel_interface.show_dialog("Da dove comincio?...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mi schiarisco la voce, poi racconto tutto quello che è successo. Segnalo espressamente che nessuno può vedere Stardust.")
	await novel_interface.show_dialog("E' proprio accanto a te? Da quello che abbiamo visto, sei uscito dall'atrio da solo...", "Annie")
	await novel_interface.show_dialog("Mi chiedevo come hai fatto a superare il controllo di sicurezza così in fretta: sei stata la prima persona a uscire!", "Annie")
	novel_interface.show_character("ren_full","gratified")
	await novel_interface.show_dialog("È il sottotenente che ho incontrato nel caveau. Ha scansionato la mia carta d'identità falsa e poi mi ha dato il braccialetto.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("I soldati Masadan non avrebbero dovuto essere così imprudenti...", "Mariru")
	novel_interface.show_character("ren_full","worry")
	await novel_interface.show_dialog("Oh, ancora una cosa. Sia il comandante nell'atrio che il sottotenente nel caveau sono ragazze giovani, non più di 20 anni.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Cosa? So che anche le donne sono soggette al servizio militare obbligatorio a Masada, ma già a quell'età?", "Annie")
	novel_interface.show_character("ren_full","normal1")
	await novel_interface.show_dialog("L'ufficiale nell'atrio ha detto che era una cadetta del \"Programma Talpiot\". È stata assegnata qui all'ultimo minuto.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Questo lo spiega...", "Mariru")
	await novel_interface.show_dialog("Talpiot è stata per decenni un'accademia militare d'élite direttamente sotto lo stato maggiore di Masada.", "Mariru")
	await novel_interface.show_dialog("Successivamente, l'esercito Masadan lo espanse nel \"Programma Talpiot\". Invita a provare solo l’1% più ricco degli studenti delle scuole medie e militari.", "Mariru")
	await novel_interface.show_dialog("Ogni anno solo poche dozzine di candidati superano l'estenuante screening mentale, fisico e del QI.", "Mariru")
	await novel_interface.show_dialog("È un canale per l'addestramento delle future élite militari e il suo curriculum include anche operazioni sul campo su piccola scala.", "Mariru")
	await novel_interface.show_dialog("Monola ha reclutato molti diplomati dal \"Programma Talpiot\". Sono noti per essere professionali e leali.", "Mariru")
	novel_interface.show_character("ren_full","worry")
	await novel_interface.show_dialog("Una scuola militare d'élite, vero?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Non credo che io e Lian riusciremo ad entrare...", "Annie")
	await novel_interface.show_dialog("Povero Lian...", "Aya")
	await novel_interface.show_text_only("Aya è riluttante a finire la frase.")
	await novel_interface.show_dialog("La ragazza di cui hai parlato. È sul ponte con te in questo momento?", "Aya")
	novel_interface.show_character("ren_full","worry")
	await novel_interface.show_dialog("Sì. Perché?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Ma anche il sensore termico indica che sei solo sul ponte...", "Aya")
	await novel_interface.show_text_only("Adesso nemmeno io ne sono sicuro, ma eccola lì, accovacciata davanti alla staccionata e con lo sguardo fisso in una direzione.")
	await novel_interface.show_text_only("All'improvviso si alza e mi indica la direzione in cui stava guardando.")
	novel_interface.show_character("stardust_small","happy")
	await novel_interface.show_dialog("Noi... andremo lì!", "Stardust")
	novel_interface.change_expression("pleased")
	await novel_interface.show_dialog("Non ricordo perché, ma qualcosa mi dice che è lì che stiamo andando.", "Stardust")
	novel_interface.change_expression("uneasy")
	await novel_interface.show_dialog("Altrimenti... Altrimenti sarà il disastro...", "Stardust")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("Per favore! Andiamo insieme, per favore!", "Stardust")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Stardust mi afferra la testa e mi fissa con i suoi occhi grandi, è solo una bambina che chiede alla mamma dei giocattoli.")
	novel_interface.show_character("ren_full","wry_smile")
	await novel_interface.show_dialog("Hai... sentito cosa mi ha detto poco fa?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("ti ho solo sentito...", "Annie")
	await novel_interface.show_dialog("Il suono è prodotto dalla vibrazione delle corde vocali. Se non c'è un corpo fisico, non può esserci suono.", "Aya")
	novel_interface.show_character("ren_full","panic")
	await novel_interface.show_dialog("Ma... ma posso vederla, toccarla e sentire la sua temperatura corporea...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("In base a ciò che hai descritto, probabilmente il tuo cervello è stato influenzato da qualcosa. E dopo, ti invia un feedback neurale che solo tu puoi percepire.", "Aya")
	novel_interface.show_character("ren_full","panic")
	await novel_interface.show_dialog("Ma riesco anche a vedere la sua ombra!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Provo a discutere, incapace di accettare la sua spiegazione.")
	await novel_interface.show_dialog("... Prova con la fotocamera del tuo telefono.", "Mariru")
	await novel_interface.show_text_only("È una buona idea! Ma quando punto la mia macchina fotografica su di lei...")
	await novel_interface.show_text_only("Non c'è nessuno nell'inquadratura della telecamera!")
	await novel_interface.show_text_only("Non appena sposto il telefono, però, la rivedo, che continua a implorarmi.")
	novel_interface.show_character("ren_full","panic")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("stardust_small","happy",0.25)
	await novel_interface.show_dialog("Per favore!", "Stardust")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Continuo a non credere che la ragazza sia solo un'illusione. Frugo nella sua borsa e trovo il bigliettino rosa con scritto sopra il suo nome.")
	await novel_interface.show_text_only("Sempre lo stesso: non riesco a vedere la nota nell'inquadratura della mia fotocamera.")
	await novel_interface.show_text_only("E questa volta, dopo aver allontanato il telefono, la nota è scomparsa!")
	await novel_interface.show_text_only("Allungo la mano tremante e metto il telefono sopra Stardust.")
	await novel_interface.show_text_only("!!! Il mio telefono cade proprio sul pavimento!")
	novel_interface.show_character("stardust_small","konata_eye")
	await novel_interface.show_dialog("?", "Stardust")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mi fischiano le orecchie e all'improvviso gli arti diventano pesanti.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Dopo un po' sento la voce di Aya al telefono.")
	novel_interface.show_background("res://assets/images/bg/Stardust/Vessel.png")
	await novel_interface.show_dialog("Ho una teoria, più una supposizione, a dire il vero.", "Aya")
	novel_interface.show_character("ren_full","sob")
	await novel_interface.show_dialog("Dimmi.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Pensa a tutte le streghe che hai evocato prima. Non erano \"fantasmi\" come questo, e avevano tutti la loro memoria completa.", "Aya")
	await novel_interface.show_dialog("Secondo quello che ci hai detto, soffre di perdita di memoria e non può essere vista. Forse i requisiti per evocarla non sono stati completamente soddisfatti?", "Aya")
