	novel_interface.show_character("ren_full","happy")
	await novel_interface.show_dialog("A questo proposito... Sì!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("All'improvviso trovo la speranza. Indico la direzione in cui Stardust vuole andare.")
	novel_interface.show_character("ren_full","happy")
	await novel_interface.show_dialog("Vuole andare lì. Non il luogo esatto, ma da qualche parte laggiù.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sento il suono di una tastiera al telefono.")
	await novel_interface.show_dialog("318 miglia in quella direzione...", "Mariru")
	await novel_interface.show_dialog("È la Fortezza di Masada!", "Annie")

	print("=== 星尘降临篇第7话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
