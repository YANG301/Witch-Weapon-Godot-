	await novel_interface.show_dialog("Wenn Hamon dennoch für ein Amt kandidieren will ... nein, auch wenn er nur vermeiden will, selbst einen gewaltsamen Tod zu sterben, muss er den Konflikt nach außen verlagern.", "Mariru")
