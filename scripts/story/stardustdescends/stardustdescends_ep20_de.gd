	await novel_interface.show_text_only("Und im Prozess der Überprüfung und Ablehnung dieser Antworten entsteht echtes rationales Denken.")
	await novel_interface.show_text_only("Wenn die Fackel der Vernunft schwächer wird, erschaffen die Menschen instinktiv Glauben für sich ...")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Genau wie das berühmte Sprichwort: Der Glaube beginnt dort, wo das Denken aufhört.")
