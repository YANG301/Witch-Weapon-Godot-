	await novel_interface.show_dialog("(Was soll ich tun...)\n(Was soll ich tun!!)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Komm schon... denk nach!!!")
	await novel_interface.show_text_only("...")
	await novel_interface.show_text_only("In der Zwischenzeit SID Kommandoraum.")
	novel_interface.show_background("res://assets/images/bg/SID/opsRoom.png")
	await novel_interface.show_text_only("Aya rief schnell einen Strom von Satellitendaten auf dem großen Bildschirm auf und achtete dabei überhaupt nicht auf die Spuren, die noch immer auf ihren Wangen zurückblieben.")
