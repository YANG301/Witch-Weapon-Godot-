	await novel_interface.show_dialog("Dieser Satellit hat eine Masse von etwa dreißig Tonnen. Es hat bereits die geostationäre Umlaufbahn überschritten.", "Aya")
	novel_interface.change_expression("blush_dizzy")
	await novel_interface.show_dialog("Es wird erwartet, dass es in zehn Minuten in die Atmosphäre eindringt, und bis dahin wird seine Geschwindigkeit ...\n...Mach 80 erreichen!!", "Aya")
