	await novel_interface.show_dialog("Verbrauchen Sie den Treibstoff, der ursprünglich für den Rückflug zur Erde gedacht war, indem Sie zum Mars fliegen, und verlassen Sie sich dann auf den Ionenmotor für längere Beschleunigung ...", "Aya")
	novel_interface.change_expression("blush_dizzy")
