# stardustdescends_ep09.gd - 星尘降临篇第9话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	stardustdescends_ep09_script()

func play_script():
	pass

func stardustdescends_ep09_script():
	novel_interface.change_music("res://assets/audio/music/Normal Stage.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_Ordovician.png")
	await novel_interface.show_text_only("Люди всегда любят размышлять: если существует могущественная инопланетная цивилизация, то она доброжелательна или злонамеренна?")
	await novel_interface.show_text_only("Более вероятный ответ: ──безразлично.")
	await novel_interface.show_text_only("Однажды 449 миллионов лет назад луч высокоэнергетических гамма-лучей с расстояния 6000 световых лет пронзил атмосферу и поразил Землю.")
	await novel_interface.show_text_only("В одно мгновение радиация уничтожила треть озонового слоя, позволив ультрафиолетовому свету Солнца проходить напрямую через атмосферу.")
	await novel_interface.show_text_only("Огромное количество планктона погибло, разрушив основы морской пищевой цепи, и начал распространяться голод.")
	await novel_interface.show_text_only("Через несколько десятилетий после катастрофы разрушенные молекулы атмосферы воссоединились, образовав огромное количество токсичного диоксида азота.")
	await novel_interface.show_text_only("Диоксид азота закрыл небо, заблокировав 50% солнечного света. Лишенная солнечного света, Земля начала быстро остывать.")
	await novel_interface.show_text_only("Температура океана упала с 25 градусов до 10, а дальнейшая гибель планктона ускорила распад пищевой цепи.")
	await novel_interface.show_text_only("Через пятьсот лет после катастрофы треть всей жизни на Земле исчезла, а то, что осталось, боролось с голодом и холодом.")
	await novel_interface.show_text_only("С уменьшением количества солнечного света огромное количество морской воды замерзло по всему миру. Ледники распространялись с невообразимой скоростью, а уровень моря упал на 100 метров.")
	await novel_interface.show_text_only("Через сто пятьдесят тысяч лет после катастрофы средняя глобальная температура упала до 5 градусов. Большая часть поверхности была покрыта льдом, и более половины всех видов погибло от холода.")
	await novel_interface.show_text_only("Неосторожный шаг далекой звезды, коллапсирующей где-то в галактике, поверг древнюю жизнь на Земле в бесконечное отчаяние.")
	await novel_interface.show_text_only("──Это происшествие известно в истории как массовое вымирание в позднем ордовике.")
	await novel_interface.hide_background()
	await novel_interface.stop_music()
	await novel_interface.show_text_only("...")
	await novel_interface.show_text_only("...")
	await novel_interface.show_text_only("Пятый школьный город.")
	await novel_interface.show_text_only("Под нежную мелодию, развалившуюся на диване, мужчина медленно просыпался...")
	novel_interface.change_music("res://assets/audio/music/Sunset.mp3")
	novel_interface.show_background("res://assets/images/bg/Fabiola/BAR.png")
	await novel_interface.show_text_only("С щетиной на лице и растрепанными волосами он изо всех сил пытался встать, опираясь на спинку дивана.")
	await novel_interface.show_text_only("Перед ним на столе стоял стакан с водой. В горле у него пересохло, как будто он только что вышел из пустыни, поэтому он схватил ее и осушил одним глотком.")
	await novel_interface.show_text_only("Затем его охватила острая головная боль. Он схватился за голову и некоторое время стонал, а затем внезапно встал, словно что-то ища.")
	await novel_interface.show_text_only("Как только он нашел свой портфель возле дивана и убедился, что документы внутри не повреждены, он почувствовал себя немного успокоенным и снова сел.")
	novel_interface.show_character("shi","normal")
	await novel_interface.show_dialog("Это...\nГде я...?", "Профессор Ши")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Профессор Ши огляделся вокруг. Это место напоминало высококлассный бар: по комнате доносилась тихая музыка, а на зданиях снаружи мерцали неоновые огни.")
	await novel_interface.show_dialog("Ты проснулся?", "Женский голос")
	await novel_interface.show_text_only("Следуя за голосом, профессор Ши увидел медленно приближающуюся рыжеволосую женщину в белом халате с бледно-желтым напитком в руке.")
	await novel_interface.show_text_only("Она поставила перед ним напиток и села на диван напротив.")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Это электролитная вода. Это поможет от головной боли.", "Мариру")
	await novel_interface.hide_character()
	novel_interface.show_character("shi","normal")
	await novel_interface.show_dialog("Ты...?", "Профессор Ши")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Профессор Ши подозрительно посмотрел на ее лицо, как будто он смутно помнил о ней.")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Ты должен меня знать──", "Мариру")
	await novel_interface.show_dialog("Я Мариру фон Браун. В прошлом году, когда вы приехали в Новую Академию наук Тоёсу в качестве приглашенного ученого, вы посетили мою лекцию о кристаллических гетероморфных объектах.", "Мариру")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Мариру помолчала, затем улыбнулась и продолжила.")
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("Кроме того, я руководитель SID.", "Мариру")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Профессор Ши вздрогнул, инстинктивно желая бежать, но быстро отбросил эту детскую мысль──")
	await novel_interface.show_text_only("Мариру протянула ему планшет и успокаивающе сказала:")
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Не бойтесь. Здесь очень безопасно──", "Мариру")
	await novel_interface.show_dialog("И если бы не мы, ты бы уже был мертв.", "Мариру")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Профессор Ши с подозрением взял планшет. Показывались записи уличного наблюдения.")
	await novel_interface.show_text_only("Он внезапно вспомнил, как долго ждал на этой вилле, не видя покупателя, о встрече которого договорился. Уходя, он вызвал такси.")
	await novel_interface.show_text_only("Ожидая на обочине, он почувствовал острую боль в шее, а затем все потемнело...")
	novel_interface.show_character("shi","normal")
	await novel_interface.show_dialog("Это...", "Профессор Ши")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("На кадрах профессор Ши стоял у дороги и ждал такси. Когда за ним проходила ничем не примечательная женщина средних лет, она внезапно вытащила шприц──")
	await novel_interface.show_text_only("Чистым и эффективным движением она вонзила иглу ему в шею, а затем быстро поймала его падающее тело сзади.")
	await novel_interface.show_text_only("Примерно через три секунды к обочине подъехал черный фургон с открытой боковой дверью, и два человека внутри затащили его в машину.")
	await novel_interface.show_text_only("Затем фургон умчался. Менее чем за десять секунд он исчез, как будто испарился из мира.")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Эти люди были убийцами, нанятыми онлайн анонимным клиентом за высокую цену. К счастью, мы остановили фургон на первом перекрестке...", "Мариру")
	await novel_interface.show_dialog("В тот момент они как раз собирались ввести вам нейротоксин. Еще один шаг, и ты прямо сейчас умрешь.", "Мариру")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Профессор Ши глубоко вздохнул и напрягся.")
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Вот почему...", "Мариру")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("Только кого ты обидел?", "Мариру")
	await novel_interface.hide_character()
	novel_interface.show_character("shi","angry")
	await novel_interface.show_dialog("Обидеть...?\nH-Как такое может быть!", "Профессор Ши")
	await novel_interface.show_dialog("Я всего лишь ученый. Кого я мог обидеть...", "Профессор Ши")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Эта вилла всегда имела прочную репутацию «подпольной брокерской конторы». Будь то сделки с оружием, секретные документы или гетероморфные предметы ──", "Мариру")
	await novel_interface.show_dialog("Под гарантией организации под названием «Семь заповедей», каким бы подлым ни был покупатель или продавец, никто не смел переступить черту.", "Мариру")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Но на этот раз покупатель, с которым вы связались, был готов пойти на такой риск, чтобы устранить такого бесполезного новичка, как вы. Почему?", "Мариру")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Профессор Ши оборонительно одернул воротник пальто и взглянул на свою старую кожаную сумку.")
	novel_interface.show_character("shi","normal")
	await novel_interface.show_dialog("Вы это уже видели, да? Это «совершенно секретный» файл из Первого школьного города. Может быть, это Бесформенные Врата...", "Профессор Ши")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Мариру откинулась на спинку дивана и пренебрежительно рассмеялась──")
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("Если даже кто-то вроде вас сможет вывезти это за границу, то это не может быть таким уж секретом.", "Мариру")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("На рынке уже появились три одинаковых документа, один из которых попал и в разведку Масады.", "Мариру")
	await novel_interface.show_dialog("Можно даже предположить, что Хуаюньгун намеренно допустил утечку этого документа ──", "Мариру")
	await novel_interface.show_dialog("И, насколько мне известно, все остальные продавцы, которые торговали этой информацией, завершили свои сделки без происшествий.", "Мариру")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("По сравнению с ними, что в вас такого особенного, что им пришлось рискнуть заставить вас замолчать?", "Мариру")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Профессор Ши долго смотрел бессмысленно, не в силах произнести ни слова.")
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Я предполагаю, что цена, которую вы назвали своему предыдущему покупателю, была не просто деньгами, не так ли...", "Мариру")
	await novel_interface.show_dialog("Возможно, именно то, о чем вы просили, чуть не убило вас?", "Мариру")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Мужчина напротив Мариру глубоко вздохнул, расслабился и откинулся на диван.")
	novel_interface.show_character("shi","eyeclose")
	await novel_interface.show_dialog("Такие люди, как ты... ужасны.", "Профессор Ши")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("Я польщён~", "Мариру")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Уголки рта Мариру слегка приподнялись.")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Поскольку ты понимаешь ситуацию, в которой находишься сейчас──", "Мариру")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Тогда давай поговорим о нашей сделке.", "Мариру")
	await novel_interface.hide_character()
	await novel_interface.stop_music()
	await novel_interface.hide_background_with_fade()
	await novel_interface.show_text_only("...")
	await novel_interface.show_text_only("Город Третьей школы, таможня порта Масада.")
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_MasadaCustoms.png")
	novel_interface.show_character("ren_medical","stare")
	await novel_interface.show_dialog("Может ли что-то, похожее на татуировку, само по себе разлагаться?", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я потер штрих-код на тыльной стороне ладони. Видимо чернила используют какую-то гетероморфную обработку и исчезают автоматически в заданное время.")
	await novel_interface.show_text_only("Этот штрих-код является разрешением на въезд таможни Масады и единственным законным удостоверением личности, которое иностранцы имеют во время пребывания в стране.")
	await novel_interface.show_text_only("По истечении срока разрешенного пребывания чернила должны испариться самостоятельно.")
	await novel_interface.show_text_only("Без этого штрих-кода любой солдат или инспектор Масады имеет право арестовать меня на месте.")
	novel_interface.show_character("ren_medical","uneasy")
	await novel_interface.show_dialog("(Хм... оно не сотрется, когда я приму душ, верно?)", "Лиан")
	await novel_interface.hide_character()
	novel_interface.show_character("stardust_small","disgust")
	await novel_interface.show_dialog("Так медленно...", "Stardust")
	novel_interface.change_expression("wordless")
	await novel_interface.show_dialog("Вааа ваааааааа~~", "Stardust")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Устав ждать, Stardust пробормотала себе под нос бессмысленные слоги, подползла к окну коридора и вцепилась в колонну, чтобы выглянуть наружу.")
	await novel_interface.show_text_only("Я провел ее через специальный проход Международной организации медицинской помощи, но Энни пришлось стоять в очереди через обычный проход для обычных посетителей.")
	await novel_interface.show_text_only("Служба безопасности Масады известна во всем мире своей строгостью; даже в вестибюле порта повсюду патрулируют солдаты с боевыми патронами.")
	await novel_interface.show_text_only("Я подошел сзади Stardust и посмотрел в окно на восток. Там я увидел спокойное голубое Мертвое море и плотину Илии, стоящую в конце Большого канала.")
	await novel_interface.show_text_only("Рядом с выходом на южной стороне плотины Мертвого моря вода была мраморной с неравномерным бирюзовым и бледно-голубым цветом, и чем дальше на север вы смотрели, тем глубже становился цвет воды.")
	await novel_interface.show_text_only("Согласно Бытию, два грешных города, разрушенные Богом, — Содом и Гоморра — затонули в южной части Мертвого моря.")
	await novel_interface.show_text_only("Я задавался вопросом, живут ли еще в море блуждающие духи, питающие обиду на «того великого».")
	await novel_interface.show_text_only("В этот момент на северо-восточном горизонте начала шевелиться темно-красная дымка, порожденная песчаной бурей.")
	await novel_interface.show_text_only("Но больше всего меня поразило то, что именно эта маленькая девочка рассказала мне о песчаной буре.")
	novel_interface.show_character("stardust_small","konata_eye")
	await novel_interface.show_dialog("Мм?", "Stardust")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","smile")
	await novel_interface.show_dialog("Эй~ ты знаешь историю Масады?", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Она моргнула мне: «О чем ты вообще говоришь?» выражение лица, в то время как наушники в форме кошачьих ушей на ее голове дважды быстро вспыхнули.")
	novel_interface.show_character("ren_medical","smile")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("stardust_small","normal1",0.25)
	await novel_interface.show_dialog("На арамейском языке Масада означает «крепость». Первоначально это был дворец, построенный на вершине холма, а также мощное оборонительное укрепление ──", "Stardust")
	await novel_interface.show_dialog("В 72 году крепость Масада, имея всего лишь тысячу защитников, два года продержалась в осаде римских легионов. Когда город наконец пал, его защитники совершили массовое самоубийство.", "Stardust")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Как и раньше в ресторане, она машинально произнесла стандартный ответ из энциклопедии, как если бы читала книгу.")
	novel_interface.show_character("ren_medical","wry_smile")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("stardust_small","normal1",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("...Ты действительно понимаешь, что значит то, что ты только что сказал?", "Лиан")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"konata_eye")
	await novel_interface.show_dialog("Нет~!", "Stardust")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Она одарила меня беззаботной улыбкой.")
	await novel_interface.show_text_only("Ты умный оратор или что-то в этом роде!?")
	await novel_interface.show_text_only("Особенно тупой тип, к тому же...")
	await novel_interface.show_text_only("Я не очень разбираюсь в истории. Я только знаю, что Масаде пришлось нелегко на протяжении тысячелетий, а во время Семилетней войны даже их первоначальная священная столица была разрушена.")
	novel_interface.show_character("ren_medical","upset")
	await novel_interface.show_dialog("Блин... у этих людей действительно был трудный путь.", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Подумав об этом, я смог понять чувства, стоящие за лозунгом на балке иммиграционного зала: «Масада никогда не падет».")
	novel_interface.show_character("ren_medical","upset")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("stardust_small","happy",0.25)
