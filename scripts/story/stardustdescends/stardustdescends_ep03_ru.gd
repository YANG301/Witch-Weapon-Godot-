# stardustdescends_ep03.gd - 星尘降临篇第3话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	stardustdescends_ep03_script()

func play_script():
	pass

func stardustdescends_ep03_script():
	novel_interface.change_music("res://assets/audio/music/Shop.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_NoxRoom.png")
	await novel_interface.show_text_only("Я сижу в углу роскошной кровати Никс и слушаю ее историю.")
	novel_interface.show_character("nyx_full","normal1")
	await novel_interface.show_dialog("Они меняют мою охрану каждые шесть месяцев. Тех двух парней снаружи перевели сюда меньше трёх месяцев назад.", "Никс")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Позже вы скажете охранникам, что лично проводите Лиана домой. Я уже отправил машину.", "Мариру")
	await novel_interface.show_dialog("Как только охранники сядут в машину, с ними разберутся.", "Мариру")
	novel_interface.show_character("nyx_full","sad")
	await novel_interface.show_dialog("Но они должны регулярно отчитываться. Если мы не хотим вызвать подозрения, разве нам не нужно их сотрудничество?", "Никс")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Никс, очевидно, не убедил нынешний план побега.")
	novel_interface.show_character("nyx_full","normal1")
	await novel_interface.show_dialog("Все охранники, посланные сюда шпионить за мной, прошли строгую подготовку по предотвращению допросов со стороны внешней разведки.", "Никс")
	novel_interface.change_expression("sad")
	await novel_interface.show_dialog("Я не думаю, что они охотно будут сотрудничать...", "Никс")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_full","upset")
	await novel_interface.show_dialog("Служба внешней разведки?", "Лиан")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_Commandments.png")
	await novel_interface.show_text_only("Да. Он также известен как Семь заповедей. Сейчас им управляет Лебона, но зародилось оно у старой европейской мафии.")
	await novel_interface.show_text_only("Агентство известно тем, что совершает невозможные убийства, и своей одержимостью черными костюмами.")
	await novel_interface.show_text_only("Однако что действительно сделало агентство легендарным, так это то, что это независимая организация, подотчетная только Кредо Лебоны.")
	await novel_interface.show_text_only("Ни одно правительство его не контролирует, и благодаря сотням казино, которыми оно управляет по всему миру, оно имеет практически неограниченное финансирование.")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_NoxRoom.png")
	novel_interface.show_character("ren_full","happy")
	await novel_interface.show_dialog("(Поговорим о хардкоре...)", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я достиг платинового уровня во всех играх этого агентства!")
	novel_interface.show_character("ren_full","gratified")
	await novel_interface.show_dialog("Итак, если бы мы хотели безопасно реализовать план эвакуации, нам нужно было бы не только спасти Никс, но и сделать это без их ведома.", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Вам не нужно об этом беспокоиться.", "Мариру")
	await novel_interface.show_text_only("Мариру гордо улыбается.")
	await novel_interface.show_dialog("У нас всегда есть особые планы для особых целей.", "Мариру")
	await novel_interface.show_text_only("Я не могу не представить Аю, окруженную орудиями пыток и радостно развлекающуюся...")
	await novel_interface.show_dialog("Последняя проверка, вы двое. Тогда вам пора!", "Мариру")
	await novel_interface.show_text_only("Мариру закончилась и вышла.")
	await novel_interface.show_text_only("Внезапная тишина заставляет меня чувствовать себя неловко. Никс, напротив, все еще смотрит на мою обширную грудь.")
	novel_interface.show_character("nyx_full","smile")
	await novel_interface.show_dialog("Твой голос... Меня бы чуть не обманули.", "Никс")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я опускаю голову, смущенный.")
	novel_interface.show_character("ren_full","shy")
	await novel_interface.show_dialog("Э... спасибо...?", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("О чем именно мы говорим?")
	await novel_interface.show_text_only("Ая сказал что-то об обновлении. Кажется, твой голос теперь звучит более женственно.")
	novel_interface.show_character("ren_full","shy_right")
	await novel_interface.show_dialog("(Зачем она вообще потрудилась обновить что-то подобное?...)", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Никс внезапно приближается, ее правая рука тянется мне за спину.")
	novel_interface.show_character("ren_full","panic")
	await novel_interface.show_dialog("Что ты делаешь...?", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я чувствую, как она что-то тянет за мою одежду, и инстинктивно вздыхаю с облегчением...")
	novel_interface.show_character("ren_full","awkward")
	await novel_interface.show_dialog("!!!", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Не говорите мне, что это пряжка...")
	await novel_interface.show_text_only("Прежде чем я успеваю понять, что только что произошло, ее рука скользит мне под одежду... и вытаскивает мой черный лифчик!!")
	novel_interface.show_character("ren_full","awkward")
	await novel_interface.show_dialog("...", "Лиан")
	await novel_interface.show_dialog("...", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("...")
	await novel_interface.show_text_only("Ааааааа!")
	await novel_interface.show_text_only("Она довольно долго сжимает мой лифчик тут и там, а затем с сомнением смотрит на меня, не сумев найти никакого устройства для изменения голоса.")
	await novel_interface.show_text_only("Лицо покраснело, я забрала у нее лифчик и бросилась в ванную.")
	novel_interface.show_character("nyx_full","smile")
	await novel_interface.show_dialog("С тобой все в порядке, Лиан? У вас расстройство желудка?", "Никс")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("Если сейчас такое время месяца, вы найдете то, что вам нужно, в аптечке.", "Никс")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Никс звучит искренне обеспокоенным.")
	novel_interface.show_character("ren_full","sob")
	await novel_interface.show_dialog("Это не то!!!", "Лиан")
	await novel_interface.show_dialog("(Бу-ху!)", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.hide_background_with_fade()
	await novel_interface.stop_music()
	await novel_interface.show_text_only("...")
	await novel_interface.show_text_only("Тем временем... SID Командный пункт")
	novel_interface.change_music("res://assets/audio/music/Normal Stage.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	await novel_interface.show_text_only("Ая просматривает стопку документов на своем столе. Пять окон открыты, быстро меняясь на большом экране перед ней.")
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("Эй...", "Ая")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ая оборачивается и смотрит на женщину в форме.")
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Была масса других способов вытянуть информацию из этого мужлана...", "Ая")
	await novel_interface.show_dialog("Почему тебе пришлось послать Лиана? Это только увеличивает риск. Ты не боишься, что они с Энни начнут что-то подозревать?", "Ая")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Мариру проверяет данные на своем мобильном устройстве и улыбается.")
	novel_interface.show_character("liliu_uniform1","normal2")
	await novel_interface.show_dialog("Лиан слишком взволнован, чтобы что-то подозревать, пока она находится в спальне Никс.", "Мариру")
	await novel_interface.show_dialog("Кроме того... Изначально это была идея Энни.", "Мариру")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("Что?", "Ая")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal2")
	await novel_interface.show_dialog("Я уверен, ты помнишь.", "Мариру")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Soya/Earthperspective.png")
	await novel_interface.show_dialog("Около двух недель назад, после того как Лиан вернул Соню из области потока, где во всем мире произошел поток пространства-времени, который длился около 5 секунд.", "Мариру")
	await novel_interface.show_dialog("Сигнал был сильным, но длился недолго. Поэтому ни одна страна не смогла отследить его источник.", "Мариру")
	await novel_interface.show_dialog("Официальная версия теперь гласит, что вблизи Солнечной системы произошел гамма-всплеск.", "Мариру")
	await novel_interface.show_dialog("Хоть это и выдумано, но верно одно: человечество было на грани вымирания.", "Мариру")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.show_character("liliu_uniform1","serious")
	await novel_interface.show_dialog("Но конец света не закончился. Поэтому мы должны убедиться, что никто не причастен New Opulentia к этому инциденту.", "Мариру")
	await novel_interface.show_dialog("SID отслеживает все новостные сообщения и сообщения.", "Мариру")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Пока ничего достоверного не обнаружено, но Энни нашла кое-что интересное, просматривая социальные сети.", "Мариру")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Энни так хорошо поправилась, да? Ее инструктор отметил, что она также много занимается физической подготовкой.", "Ая")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","sigh")
	await novel_interface.show_dialog("У нее свои причины, у этого ребенка.", "Мариру")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("Лиан, однако, это совсем другая история...", "Мариру")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Мариру достает список всех игр, которые Лиан недавно прошел.")
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("Так или иначе, Энни нашла десятки постов, опубликованных в тот же день, когда Лиан вернул Соню. Они от разных людей, которым во время дневного сна снился один и тот же странный сон.", "Мариру")
	await novel_interface.show_dialog("«Мне снилось, что я упал в темную пропасть и встретил своих умерших родственников».", "Мариру")
	await novel_interface.show_dialog("Ни у одного из этих людей не было много подписчиков, поэтому их посты не привлекли особого внимания.", "Мариру")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("Сны во время дневного сна...", "Ая")
	novel_interface.change_expression("think")
	await novel_interface.show_dialog("Подожди! Пространственно-временной поток произошел около 16:00 по времени New Opulentia!", "Ая")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("Немногие люди в это время дремлют, и еще меньше людей публикуют свои сны в Интернете.", "Мариру")
	await novel_interface.show_dialog("Мы сделали дополнительные анализы. Физические адреса всех этих учетных записей находятся внутри New Opulentia — в радиусе 5 миль.", "Мариру")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ая слушает, глаза блестят.")
	novel_interface.show_character("liliu_uniform1","serious")
	await novel_interface.show_dialog("И центром этого региона является вилла Никса.", "Мариру")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","blush_dizzy")
	await novel_interface.show_dialog("Так что на этой вилле действительно может быть что-то особенное. Когда открылась Дверь Небес, эта штука вызывала сны у спящих людей?", "Ая")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ая звучит взволнованно.")
	novel_interface.show_character("liliu_uniform1","normal2")
	await novel_interface.show_dialog("Поскольку поначалу я не был уверен, я попросил Энни установить датчик Больцмана в систему безопасности виллы.", "Мариру")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("«Я хочу это увидеть». Ая быстро подходит к Мариру, но Мариру кладет руку на лицо Аи, чтобы остановить ее.")
	await novel_interface.show_text_only("У седовласой девушки, к сожалению, короткие руки, она не может дотянуться до Мариру, ее руки машут в воздухе.")
	novel_interface.show_character("ai","blush_dizzy")
	await novel_interface.show_dialog("«Что ты увидишь!» (Я хочу это увидеть!)", "Ая")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal2")
	await novel_interface.show_dialog("Я покажу вам это после того, как мы найдём датчик. А теперь поторопитесь и выполните задание, которое дал вам профессор Ши!", "Мариру")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.stop_music()
	await novel_interface.show_text_only("Затем Мариру выходит из командной комнаты, глядя на спутниковые данные, которые она получает на свое устройство.")
	await novel_interface.show_dialog("(Ранее, когда лбы Лиана и Никс соприкоснулись, произошел всплеск низкочастотных радиоволн.)", "Мариру")
	await novel_interface.show_dialog("Он показал ту же картину, что и мозговые волны человека во время быстрого сна...", "Мариру")
	novel_interface.show_background("res://assets/images/bg/Baizhu/snowfield.png")
	await novel_interface.show_text_only("Почти идентично тому, что произошло в Антарктиде...")

	print("=== 星尘降临篇第3话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
