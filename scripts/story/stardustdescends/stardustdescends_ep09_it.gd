# stardustdescends_ep09.gd - 星尘降临篇第9话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	stardustdescends_ep09_script()

func play_script():
	pass

func stardustdescends_ep09_script():
	novel_interface.change_music("res://assets/audio/music/Normal Stage.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_Ordovician.png")
	await novel_interface.show_text_only("Le persone amano sempre speculare: se esiste una potente civiltà aliena, è benevola o dannosa?")
	await novel_interface.show_text_only("Una risposta più probabile è: è indifferente.")
	await novel_interface.show_text_only("Un giorno, 449 milioni di anni fa, un fascio di raggi gamma ad alta energia proveniente da 6.000 anni luce di distanza perforò l’atmosfera e colpì la Terra.")
	await novel_interface.show_text_only("In un istante, la radiazione distrusse un terzo dello strato di ozono, consentendo alla luce ultravioletta proveniente dal sole di passare direttamente attraverso l'atmosfera.")
	await novel_interface.show_text_only("Enormi quantità di plancton morirono, distruggendo le fondamenta della catena alimentare marina, e la carestia cominciò a diffondersi.")
	await novel_interface.show_text_only("Diversi decenni dopo il disastro, le molecole atmosferiche frantumate si sono ricombinate, formando grandi quantità di biossido di azoto tossico.")
	await novel_interface.show_text_only("Il biossido di azoto ha oscurato il cielo, bloccando il 50% della luce solare. Privata della luce solare, la Terra iniziò a raffreddarsi rapidamente.")
	await novel_interface.show_text_only("La temperatura dell'oceano scese da 25 a 10 gradi e l'ulteriore morte del plancton accelerò il collasso della catena alimentare.")
	await novel_interface.show_text_only("Cinquecento anni dopo la catastrofe, un terzo di tutta la vita sulla Terra era scomparsa e ciò che restava lottava contro la fame e il freddo.")
	await novel_interface.show_text_only("Con la diminuzione della luce solare, enormi quantità di acqua di mare si sono congelate in tutto il mondo. I ghiacciai si espansero a una velocità inimmaginabile e il livello del mare si abbassò di 100 metri.")
	await novel_interface.show_text_only("Centocinquantamila anni dopo il disastro, la temperatura media globale scese a 5 gradi. La maggior parte della superficie era ricoperta di ghiaccio e oltre la metà di tutte le specie morirono a causa del freddo.")
	await novel_interface.show_text_only("Il passo falso di una stella lontana che collassa da qualche parte nella galassia ha gettato la vita antica sulla Terra in una disperazione senza fine.")
	await novel_interface.show_text_only("──Quell'incidente è passato alla storia come l'estinzione di massa del Tardo Ordoviciano.")
	await novel_interface.hide_background()
	await novel_interface.stop_music()
	await novel_interface.show_text_only("...")
	await novel_interface.show_text_only("...")
	await novel_interface.show_text_only("La quinta città scolastica.")
	await novel_interface.show_text_only("Mentre una dolce melodia suonava in sottofondo, l'uomo sdraiato sul divano si svegliò lentamente...")
	novel_interface.change_music("res://assets/audio/music/Sunset.mp3")
	novel_interface.show_background("res://assets/images/bg/Fabiola/BAR.png")
	await novel_interface.show_text_only("Con la barba incolta sul viso e i capelli in disordine, si alzò in piedi appoggiandosi allo schienale del divano.")
	await novel_interface.show_text_only("Sul tavolo davanti a lui c'era un bicchiere d'acqua. Aveva la gola secca come se fosse appena uscito dal deserto, così l'afferrò e lo vuotò tutto d'un fiato.")
	await novel_interface.show_text_only("Poi un mal di testa lancinante lo colpì. Si prese la testa e gemette per un po', poi all'improvviso si alzò come se stesse cercando qualcosa.")
	await novel_interface.show_text_only("Una volta trovata la sua valigetta accanto al divano e accertato che i documenti al suo interno erano intatti, si sentì leggermente rassicurato e si sedette di nuovo.")
	novel_interface.show_character("shi","normal")
	await novel_interface.show_dialog("Questo è...\nDove sono...?", "Professor Shih")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Il professor Shih si guardò intorno. Il posto somigliava a un bar di lusso, con musica soft che diffondeva nella stanza e luci al neon che tremolavano sugli edifici all'esterno.")
	await novel_interface.show_dialog("Sei sveglio?", "Voce femminile")
	await novel_interface.show_text_only("Seguendo la voce, il professor Shih vide una donna dai capelli rossi in camice bianco avvicinarsi lentamente con una bevanda giallo pallido in mano.")
	await novel_interface.show_text_only("Gli mise davanti il drink e prese il divano di fronte.")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("E' acqua elettrolitica. Aiuterà con il mal di testa.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("shi","normal")
	await novel_interface.show_dialog("Tu sei...?", "Professor Shih")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Il professor Shih la fissò con sospetto, come se avesse un vago ricordo di lei.")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Dovresti conoscermi──", "Mariru")
	await novel_interface.show_dialog("Sono Mariru von Braun. L'anno scorso, quando sei venuto alla Nuova Accademia delle Scienze di Toyosu come studioso in visita, hai assistito alla mia conferenza sugli oggetti eteromorfi cristallini.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru fece una pausa, poi sorrise e continuò.")
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("Inoltre, sono il capo di SID.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Il Professor Shih sussultò, istintivamente voleva correre, ma abbandonò rapidamente quel pensiero infantile──")
	await novel_interface.show_text_only("Mariru gli porse una tavoletta e disse in tono rassicurante,")
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Non aver paura. È molto sicuro qui──", "Mariru")
	await novel_interface.show_dialog("E se non fosse per noi, saresti già morto.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Il professor Shih ha preso la tavoletta con sospetto. Mostrava filmati di sorveglianza stradale.")
	await novel_interface.show_text_only("All'improvviso si ricordò di aver aspettato a lungo in quella villa senza vedere l'acquirente che aveva dato appuntamento. Quando se ne andò, chiamò un taxi.")
	await novel_interface.show_text_only("Mentre aspettava sul ciglio della strada, ha sentito un forte dolore al collo, e poi tutto è diventato nero...")
	novel_interface.show_character("shi","normal")
	await novel_interface.show_dialog("Questo è...", "Professor Shih")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Nel filmato, il professor Shih era in piedi sulla strada in attesa del taxi. Quando una insignificante donna di mezza età gli passò dietro, all'improvviso tirò fuori una siringa──")
	await novel_interface.show_text_only("Con un movimento pulito ed efficiente, gli piantò l'ago nel collo, poi afferrò rapidamente il suo corpo che crollava da dietro.")
	await novel_interface.show_text_only("Circa tre secondi dopo, un furgone nero con la portiera laterale aperta si fermò sul marciapiede e due persone a bordo lo caricarono a bordo.")
	await novel_interface.show_text_only("Poi il furgone si è allontanato a tutta velocità. In meno di dieci secondi era scomparso come se fosse evaporato dal mondo.")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Queste persone erano assassini assunti online da un cliente anonimo a caro prezzo. Per fortuna abbiamo fermato il furgone al primo incrocio...", "Mariru")
	await novel_interface.show_dialog("In quel momento stavano per iniettarti una neurotossina. Un passo dopo e saresti cerebralmente morto in questo momento.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Il professor Shih fece un respiro freddo e si irrigidì.")
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Ecco perché...", "Mariru")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("Chi hai offeso?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("shi","angry")
	await novel_interface.show_dialog("Offendere...?\nH-Come potrebbe essere!", "Professor Shih")
	await novel_interface.show_dialog("Sono solo uno studioso. Chi avrei potuto offendere...", "Professor Shih")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Quella villa ha sempre avuto una solida fama di “intermediazione clandestina”. Che si trattasse di affari di armi, documenti riservati o oggetti eteromorfi──", "Mariru")
	await novel_interface.show_dialog("Sotto la garanzia dell'organizzazione chiamata \"I Sette Comandamenti\", non importa quanto vile fosse l'acquirente o il venditore, nessuno osava oltrepassare il limite.", "Mariru")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Ma questa volta, l'acquirente che hai contattato era disposto a correre un rischio del genere pur di eliminare un principiante senza valore come te. Perché?", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Il professor Shih, sulla difensiva, si tirò su il bavero del cappotto e guardò la sua vecchia borsa di pelle.")
	novel_interface.show_character("shi","normal")
	await novel_interface.show_dialog("L'hai già visto, vero? Questo è un file \"top secret\" della First School City. Potrebbe essere la Porta Senza Forma...", "Professor Shih")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru si appoggiò allo schienale del divano e rise in modo sprezzante──")
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("Se anche uno come te riesce a portarlo all'estero, allora non può essere quel segreto.", "Mariru")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Tre documenti identici sono già apparsi sul mercato e anche il dipartimento di intelligence di Masada ne ha ottenuto uno.", "Mariru")
	await novel_interface.show_dialog("Si può anche dedurre che Huayungong abbia deliberatamente permesso che questo documento trapelasse──", "Mariru")
	await novel_interface.show_dialog("E per quanto ne so, gli altri venditori che hanno scambiato queste informazioni hanno tutti completato i loro affari senza incidenti.", "Mariru")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("Rispetto a loro, cosa hai di così speciale da spingerli a rischiare di metterti a tacere?", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Il professor Shih rimase a lungo con lo sguardo assente, incapace di dire una parola.")
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("La mia ipotesi è che il prezzo che hai indicato al tuo precedente acquirente non fosse solo denaro, vero...", "Mariru")
	await novel_interface.show_dialog("Forse quello che hai chiesto è stato proprio ciò che ti ha quasi fatto uccidere?", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("L'uomo di fronte a Mariru emise un lungo sospiro, si rilassò e si appoggiò allo schienale del divano.")
	novel_interface.show_character("shi","eyeclose")
	await novel_interface.show_dialog("Le persone come te... sono terrificanti.", "Professor Shih")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("Sono lusingato~", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Gli angoli della bocca di Mariru si sollevarono leggermente.")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Dal momento che capisci la situazione in cui ti trovi adesso──", "Mariru")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Allora parliamo del nostro accordo.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.stop_music()
	await novel_interface.hide_background_with_fade()
	await novel_interface.show_text_only("...")
	await novel_interface.show_text_only("La Terza Città Scolastica, dogana del porto di Masada.")
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_MasadaCustoms.png")
	novel_interface.show_character("ren_medical","stare")
	await novel_interface.show_dialog("Può qualcosa che assomiglia a un tatuaggio davvero biodegradarsi da solo...?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ho strofinato il codice a barre sul dorso della mano. Apparentemente l'inchiostro utilizza una sorta di elaborazione eteromorfa e scompare automaticamente in un momento prestabilito.")
	await novel_interface.show_text_only("Questo codice a barre è il permesso di ingresso alla dogana di Masada e l'unico documento d'identità legale che gli stranieri hanno durante il soggiorno nel paese.")
	await novel_interface.show_text_only("Nel momento in cui scade il soggiorno consentito, l’inchiostro dovrebbe evaporare da solo.")
	await novel_interface.show_text_only("Senza questo codice a barre, qualsiasi soldato o ispettore di Masada ha il diritto di arrestarmi sul posto.")
	novel_interface.show_character("ren_medical","uneasy")
	await novel_interface.show_dialog("(Hmm... non si cancellerà quando faccio la doccia, giusto?)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("stardust_small","disgust")
	await novel_interface.show_dialog("Così lento...", "Stardust")
	novel_interface.change_expression("wordless")
	await novel_interface.show_dialog("Waaah waaah aaawoo~~", "Stardust")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Stanca di aspettare, Stardust mormorò sottovoce sillabe senza senso mentre si trascinava verso la finestra del corridoio e si aggrappava al pilastro per guardare fuori.")
	await novel_interface.show_text_only("L'ho portata attraverso il passaggio speciale per l'Organizzazione internazionale di soccorso medico, ma Annie ha dovuto fare la fila attraverso la normale corsia di sicurezza per i visitatori normali.")
	await novel_interface.show_text_only("La sicurezza di Masada è famosa in tutto il mondo per essere brutalmente severa; anche nell'atrio del porto, soldati armati di munizioni pattugliano ovunque.")
	await novel_interface.show_text_only("Mi sono avvicinato dietro Stardust e ho guardato a est attraverso la finestra. Lì potevo vedere il calmo blu del Mar Morto e la diga di Elia che si trovava alla fine del Canal Grande.")
	await novel_interface.show_text_only("Vicino al deflusso sul lato meridionale della diga del Mar Morto, l'acqua era marmorizzata di turchese irregolare e azzurro pallido, e più si guardava a nord, più il colore dell'acqua diventava scuro.")
	await novel_interface.show_text_only("Secondo la Genesi, le due città peccaminose distrutte da Dio, Sodoma e Gomorra, giacciono sprofondate sotto il Mar Morto meridionale.")
	await novel_interface.show_text_only("Mi chiedevo se il mare ospitasse ancora spiriti erranti che nutrivano risentimento verso \"quel grande\".")
	await novel_interface.show_text_only("In quel momento, all'orizzonte nord-orientale, cominciava ad agitarsi la foschia rosso scuro nata dalla tempesta di sabbia.")
	await novel_interface.show_text_only("Ma quello che mi colpì di più come strano fu che fosse stata proprio questa ragazzina a parlarmi della tempesta di sabbia──")
	novel_interface.show_character("stardust_small","konata_eye")
	await novel_interface.show_dialog("Mmm?", "Stardust")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","smile")
	await novel_interface.show_dialog("Ehi~ conosci la storia di Masada?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mi guardò sbattendo le palpebre con un \"Di cosa stai parlando?\" espressione, mentre le cuffie a forma di orecchie di gatto sulla sua testa lampeggiavano due volte velocemente.")
	novel_interface.show_character("ren_medical","smile")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("stardust_small","normal1",0.25)
	await novel_interface.show_dialog("In aramaico Masada significa \"fortezza\". In origine era un palazzo costruito in cima a una collina, e anche una potente fortificazione difensiva──", "Stardust")
	await novel_interface.show_dialog("Nell'anno 72, con solo un migliaio di difensori, la Fortezza di Masada resistette per due anni sotto l'assedio delle legioni romane. Quando la città finalmente cadde, i difensori commisero un suicidio di massa.", "Stardust")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Proprio come prima al ristorante, recitò meccanicamente la risposta standard dell'enciclopedia come se stesse leggendo da un libro.")
	novel_interface.show_character("ren_medical","wry_smile")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("stardust_small","normal1",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("...Capisci davvero cosa significa quello che hai appena detto?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"konata_eye")
	await novel_interface.show_dialog("No~!", "Stardust")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mi ha regalato un sorriso spensierato.")
	await novel_interface.show_text_only("Sei un oratore intelligente o qualcosa del genere!?")
	await novel_interface.show_text_only("Il tipo particolarmente stupido, per giunta...")
	await novel_interface.show_text_only("Non so molto di storia. So solo che Masada ha vissuto momenti difficili per migliaia di anni, e durante la Guerra dei Sette Anni anche la loro originaria capitale sacra fu distrutta.")
	novel_interface.show_character("ren_medical","upset")
	await novel_interface.show_dialog("Cavolo... quelle persone hanno davvero avuto una strada difficile.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Pensando questo, ho potuto capire il sentimento dietro lo slogan sulla trave dell'atrio dell'immigrazione: \"Masada non cadrà mai\".")
	novel_interface.show_character("ren_medical","upset")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("stardust_small","happy",0.25)
	await novel_interface.show_dialog("Ah! Annie──", "Stardust")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Stardust indicò l'uscita di sicurezza e gridò. Annie stava tirando la valigia e da lì veniva verso di noi.")
	await novel_interface.stop_music()
	await novel_interface.hide_background_with_fade()
	await novel_interface.show_text_only("...")
	await novel_interface.show_text_only("Centro di ricerca sulle neuroscienze Harima, divisione medica sperimentale.")
	novel_interface.change_music("res://assets/audio/music/Normal Stage.mp3")
	novel_interface.change_background("res://assets/images/bg/Fabiola/Dementium.png")
	await novel_interface.show_text_only("Seduta sul letto del dispositivo per l'immersione mentale, Mariru si strofinò stancamente le tempie──")
	await novel_interface.show_text_only("Aya entrò e le porse una bottiglia di acqua elettrolitica.")
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("Com'è stato? Hai ricavato qualcosa dall'interrogatorio?", "Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Sì... abbiamo delle informazioni interessanti.", "Mariru")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Come sta il professor Shih adesso?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("Beh... è ancora in coma profondo. I suoi riflessi del tronco cerebrale sono deboli e la sua vita deve essere mantenuta dalle macchine──", "Aya")
	await novel_interface.show_dialog("L'agente chelante ha eliminato la maggior parte delle neurotossine dal suo corpo, ma non possiamo dire quanti danni siano già stati fatti o se si sveglierà mai.", "Aya")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("Questa impostazione è l'unico modo che abbiamo in questo momento per ottenere informazioni da lui~", "Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru svitò il tappo e bevve un bel sorso prima di parlare.")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Ha detto di aver rubato e venduto i documenti per ritrovare sua figlia.", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","wink",0.25)
	await novel_interface.show_dialog("Eh? Pensavo che quel vecchio fossile fosse single~", "Aya")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Sua figlia si è laureata al dipartimento di astronomia di Berkeley sei anni fa ed è stata reclutata in un progetto segreto della NASA prima che il governo federale si sciogliesse.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"think")
	await novel_interface.show_dialog("NASA? È un nome che non sento da un po'...", "Aya")
	novel_interface.change_2nd_expression("normal")
	await novel_interface.show_dialog("Si trattava di un progetto militare di armi spaziali?", "Aya")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Era un progetto di osservazione astronomica──", "Mariru")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("La NASA presumibilmente ha ricevuto un segnale tremolante ad alta frequenza in una banda specifica mentre osservava una certa coordinata nell'ammasso delle Pleiadi.", "Mariru")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Il segnale era chiaramente direzionale e poteva essere ricevuto solo da una specifica posizione orbitale──", "Mariru")
	await novel_interface.show_dialog("Come un laser sparato verso il sistema solare da 400 anni luce di distanza, osservabile solo se ti trovi nel suo stretto percorso.", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Le guance di Aya arrossirono immediatamente per l'eccitazione quando chiese,")
	novel_interface.show_character("liliu_research","smile")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("ai","dizzy",0.25)
	await novel_interface.show_dialog("Tipo... un messaggio trasmesso direzionalmente attraverso la fibra ottica?", "Aya")
	novel_interface.change_2nd_expression("blush_dizzy")
