# stardustdescends_ep13.gd - 星尘降临篇第13话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	stardustdescends_ep13_script()

func play_script():
	pass

func stardustdescends_ep13_script():
	novel_interface.change_music("res://assets/audio/music/Story_01.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_MasadSentry.png")
	await novel_interface.show_text_only("À en juger par les images du moniteur du véhicule, droit devant, se trouvait une section du mur d'isolation encore en construction.")
	await novel_interface.show_text_only("Parce que c'était à la limite du centre-ville, il n'y avait rien de l'atmosphère prospère et paisible du quartier central...")
	await novel_interface.show_text_only("L’acier, le béton et la poussière ont restitué la texture brute et rugueuse d’une zone de guerre désertique.")
	await novel_interface.show_text_only("Le point de contrôle devant avait été construit comme une forteresse, et plusieurs APC du même modèle étaient garés autour.")
	await novel_interface.show_text_only("Au loin, de nombreuses grues à tour et engins lourds étaient à l'œuvre, et au-delà du mur on apercevait vaguement des nuées de drones dans le ciel.")
	await novel_interface.show_text_only("De la façon dont les barricades métalliques étaient disposées, la sortie devant semblait clairement fermée à la circulation.")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_MasadAPCO2.png")
	novel_interface.show_character("ren_medical","wail")
	await novel_interface.show_dialog("Tu veux... forcer le passage ?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Emily frappa du bout des doigts la paroi intérieure de l'APC.")
	novel_interface.show_character("emilio","speechless")
	await novel_interface.show_dialog("Avec ça ?", "Emily")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("L'armure est solide, mais elle conduit la chaleur comme le métal ordinaire. Nous tiendrons probablement une vingtaine de secondes avant d'être rôtis vivants ~", "Emily")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Soudain, le véhicule s'est arrêté. Une voix familière est venue de la cabine du conducteur...")
	await novel_interface.show_dialog("Vera Valkyrie, adjudant de première classe du bataillon Caracal, récupérant le personnel du camp pour une reconnaissance à l'extérieur de la ville.", "Vera")
	novel_interface.show_character("ren_medical","wry_smile")
	await novel_interface.show_dialog("(C'est la femme de sécurité ultra-puissante du bateau-casino, n'est-ce pas ?!)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Je me souvenais encore très bien d’elle soulevant d’une seule main cet énorme évêque en chef.")
	await novel_interface.show_dialog("Oh, c'est Véra. Il y a actuellement une manifestation près du marché de Yehuda. Si vous ne voulez pas vous enliser, vous feriez mieux de prendre une autre sortie...", "Voix masculine")
	await novel_interface.show_dialog("Arrêtez de parler et laissez-nous passer. Nous n'avons pas le temps de faire un détour !", "Vera")
	await novel_interface.show_dialog("Haha, bien, bien. Ne causez pas plus de problèmes. La dernière fois, votre vieux a appelé de l'état-major juste pour gronder les gens...", "Voix masculine")
	await novel_interface.show_dialog("Parlez-en encore et je vous écraserai.", "Vera")
	await novel_interface.show_dialog("Déplacez le barrage routier. Laissez-les passer, laissez-les passer !", "Voix masculine")
	await novel_interface.show_text_only("Emily se pencha et me chuchota.")
	novel_interface.show_character("emilio","mock")
	await novel_interface.show_dialog("Alors, avez-vous eu ce bref moment où vous avez pensé à crier à l'aide... et ensuite vous vous êtes dégonflé ?", "Emily")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","shy_left")
	await novel_interface.show_dialog("Bien sûr que non !", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Je détournai précipitamment la tête. Ugh, elle est tellement odieuse !")
	await novel_interface.show_text_only("Le véhicule a lentement avancé et a rapidement traversé le mur d'isolement pour rejoindre la ville périphérique de Massada.")
	await novel_interface.show_text_only("J'avais pensé que la périphérie de la ville serait encore plus désolée, mais après avoir traversé le mur d'isolement, le nombre de personnes sur la route a soudainement bondi...")
	await novel_interface.show_text_only("Les routes étaient plus difficiles ici, et il y avait moins de gratte-ciel et de ceintures vertes, mais les rues étaient étonnamment animées.")
	await novel_interface.show_text_only("La foule, les bus qui allaient et venaient et les vendeurs ambulants vendant des marchandises me donnaient l'impression d'avoir glissé dans le temps.")
	novel_interface.show_character("ren_medical","gratified")
	await novel_interface.show_dialog("Il y a tellement de monde ici...", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("emilio","smile",0.25)
	await novel_interface.show_dialog("Bien sûr. Quatre-vingt-dix pour cent de la population de cette ville vit en dehors du mur d'isolement.", "Emily")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("C'est autant !?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Le centre-ville ne fait que 32 kilomètres carrés au total, soit moins d'un quart de la superficie totale de Massada, et les prix des terrains sont scandaleux~", "Emily")
	await novel_interface.show_dialog("Surtout dans le quartier central. La surface au sol d'une seule toilette serait suffisante pour acheter un studio au bord de la Mer Morte.", "Emily")
	novel_interface.character_light(0.35,"wry_smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Je pensais que le mur d'isolation était fait pour ça... tu sais...", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Ségrégation raciale ?", "Emily")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("C'est vrai, c'est vrai. N'y a-t-il pas une règle selon laquelle certains mots offensants pour un groupe spécifique ne peuvent être prononcés que par les personnes de ce groupe elles-mêmes...")
	novel_interface.show_character("emilio","mock")
	await novel_interface.show_dialog("Le Conseil Unifié a interdit ce genre de chose il y a longtemps~", "Emily")
	await novel_interface.show_dialog("Mais la loi antiterroriste de Massada stipule que si vous souhaitez résider à long terme dans le centre-ville où se trouvent le gouvernement et le parlement, vous devez passer un examen du Bureau de sécurité.", "Emily")
	await novel_interface.show_dialog("Et les candidats dont la famille immédiate appartient à certains groupes ethniques ne sont jamais admis... vous comprenez ?", "Emily")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("J'ai hoché la tête, ne comprenant qu'à moitié.")
	await novel_interface.show_text_only("C'est donc ça la ségrégation !\nMême s'il semble qu'ils se ségrégent eux-mêmes...")
	await novel_interface.show_text_only("Et si c’est vrai, alors même la plupart des Masadans doivent également vivre en périphérie de la ville, n’est-ce pas ?")
	await novel_interface.show_text_only("Sur l'écran, j'ai vu une femme soldat avec un M16 en bandoulière, accroupie devant un étal de rue vendant des ornements pour cheveux, marchandant avec une vendeuse dont le visage était enveloppé dans un foulard.")
	novel_interface.show_character("ren_medical","wail")
	await novel_interface.show_dialog("(Il s'avère que personne ne peut se permettre un logement, peu importe d'où il vient...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Soudain, le véhicule a freiné brusquement. Ma tête a presque heurté l'écran et les jurons de Vera ont retenti depuis la cabine du conducteur.")
	await novel_interface.show_dialog("Bon sang !!", "Vera")
	novel_interface.show_character("emilio","shout")
	await novel_interface.show_dialog("Que s'est-il passé !?", "Emily")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("J'ai lancé un drone éclaireur. Regardez simplement l’écran vous-mêmes.", "Vera")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Emily et moi nous sommes précipités vers l'écran et avons vu une scène qui m'a donné la chair de poule...")
	#novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_AncientHumanEH.png") #原游戏有素材，但已丢失
	await novel_interface.show_text_only("Plus d’un millier d’hommes en manteaux noirs et chapeaux noirs étaient rassemblés à l’intersection devant eux, comme lors de funérailles massives.")
	await novel_interface.show_text_only("Ils brandissaient des pancartes de protestation en noir et blanc, faites maison, comme s'ils s'opposaient à l'existence d'autres couleurs dans le monde.")
	await novel_interface.show_text_only("La plupart d’entre eux avaient d’énormes barbes et d’étranges petites tresses sur les tempes. Ce regard lui semblait terriblement familier…")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_MasadAPCR1.png")
	await novel_interface.show_dialog("Ces conneries inutiles ! Ils vivent des subventions de l’État et protestent encore tous les jours !", "Vera")
	await novel_interface.show_text_only("Supposons simplement que \"bip\" soit une sorte de dialecte... De toute façon, je ne pouvais pas le comprendre.")
	await novel_interface.show_dialog("Ils veulent que le nombre d'écoles élémentaires qui correspondent à leur doctrine double ?\nEst-ce que ces fichues boucles latérales ont poussé dans leur cerveau !?", "Vera")
	await novel_interface.show_text_only("J'ai entendu des coups de pied venant de la porte de la cabine. Apparemment, notre chauffeur avait sauté pour se battre.")
	novel_interface.show_character("ren_medical","wail")
	await novel_interface.show_dialog("Qu-Qu'est-ce qu'elle fait ?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("emilio","mock",0.25)
	await novel_interface.show_dialog("Je vais couvrir les assiettes~", "Emily")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Emily répondit distraitement tout en vérifiant la carte de l'itinéraire sur sa tablette militaire robuste.")
	novel_interface.show_character("ren_medical","wry_smile")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("emilio","mock",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Q-Qu'est-ce qu'elle va faire... ? Ces gens sont des Masadans, n'est-ce pas ?\nJe crois en avoir vu quelques-uns au musée tout à l'heure...", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"stare")
	await novel_interface.show_dialog("Ils font partie du « patrimoine historique » de Massada. Ils ne travaillent pas, ne paient pas d'impôts, ne servent pas dans l'armée, et le gouvernement doit quand même leur verser des subventions mensuelles...", "Emily")
	await novel_interface.show_dialog("Même s'ils perturbent l'ordre public et bloquent la circulation, la police et l'armée ne peuvent pas y toucher, car ils ont leurs propres tribunaux religieux.", "Emily")
	novel_interface.character_light(0.35,"stare")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("...C'est si bon ?", "Lian")
	novel_interface.change_expression("uneasy")
	await novel_interface.show_dialog("(Cela ne signifierait-il pas que vous pourriez simplement rester à la maison et jouer à des jeux tous les jours...)", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"mock")
	await novel_interface.show_dialog("Mais leur doctrine dit qu'il ne peut y avoir de télévision ou d'ordinateur à la maison, et que l'accès à Internet est strictement interdit...", "Emily")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("C'est une torture !!")
	novel_interface.show_character("ren_medical","uneasy")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("emilio","speechless",0.25)
	await novel_interface.show_dialog("Mais leurs femmes sont différentes. Ils sont autorisés à utiliser des appareils électroniques, car ces hommes comptent sur les femmes pour gagner de l'argent et les aider à subvenir aux besoins du ménage.", "Emily")
	novel_interface.change_2nd_expression("stare")
	await novel_interface.show_dialog("Ce n'est pas parce que les subventions sont trop faibles. C'est parce que les femmes de ces familles ont en moyenne six ou sept enfants, et certaines en ont plus d'une douzaine.", "Emily")
	novel_interface.change_2nd_expression("speechless")
	await novel_interface.show_dialog("Autant d’enfants. Pas étonnant que les écoles religieuses ne suffisent pas...", "Emily")
	novel_interface.character_light(0.35,"bored")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("(La dizaine d'enfants que j'ai vus se rassembler autour de ces deux hommes barbus en noir au musée auraient-ils pu être...)", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Et les deux femmes hagardes qui les suivaient...")
	await novel_interface.show_text_only("Quand j'ai pensé à la poussette que l'un d'eux poussait, un frisson m'a parcouru le dos.")
	novel_interface.show_character("emilio","speechless")
	await novel_interface.show_dialog("Les fondamentalistes religieux sont un cancer, peu importe où vous allez...", "Emily")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Emily n'arrêtait pas de jouer avec sa tablette, la tête baissée, son ton empreint d'une étrange tristesse et d'une pointe de résignation.")
	await novel_interface.show_text_only("Peu de temps après, Vera revint dans le véhicule et Emily tapota la cloison métallique de la cabine pour le lui rappeler.")
	novel_interface.show_character("emilio","smile")
	await novel_interface.show_dialog("Contourner jusqu'à la troisième intersection du côté est. Il y a là un viaduc récemment achevé. C'est l'itinéraire le plus rapide pour sortir de la ville.", "Emily")
	await novel_interface.show_dialog("Et aussi, si vous comptez faire « ça », n'oubliez pas de faire demi-tour en premier.", "Emily")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Compris ~", "Vera")
	await novel_interface.show_text_only("Vera a fait tourner le volant à l'extrême et a appuyé sur l'accélérateur, faisant tourner l'avant en un seul tour sans le moindre souci pour le confort des passagers.")
	await novel_interface.show_text_only("Un instant plus tard, quatre bruits sourds retentirent du toit du véhicule : bruit sourd, bruit sourd, bruit sourd.")
	novel_interface.show_character("ren_medical","panic")
	await novel_interface.show_dialog("(Attendez, pourquoi ça ressemblait à un lance-grenades...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Très vite, les hommes en noir rassemblés ont commencé à paniquer, alors que des panaches de fumée blanche de gaz lacrymogène ont jailli de quatre endroits différents de la foule...")
	await novel_interface.show_text_only("Et notre véhicule l'a écrasé et a disparu au coin de la rue.")
	await novel_interface.stop_music()
	await novel_interface.hide_background_with_fade()
	await novel_interface.show_text_only("...")
	await novel_interface.show_text_only("............")
	await novel_interface.show_text_only("À mesure que l’ombre du mur d’isolation diminuait derrière moi, les terres des deux côtés de la route devenaient progressivement stériles.")
	await novel_interface.show_text_only("Après être resté si longtemps dans la ville, il était facile d'oublier que Masadaburg elle-même était une ville abrupte construite dans le désert.")
	await novel_interface.show_text_only("L'APC roulait à toute vitesse sur une route déserte, et il n'y avait aucun signe de vie humaine à côté de l'autoroute isolée.")
	await novel_interface.show_text_only("Seuls quelques arbustes desséchés se tenaient encore obstinément dans le sable...")
	novel_interface.change_music("res://assets/audio/music/unkown/Battle_08.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_StagingPost.png")
	await novel_interface.show_text_only("Après environ une heure hors de la ville, la porte du compartiment des troupes s'est lentement ouverte et une station de ravitaillement militaire est apparue devant moi.")
	novel_interface.show_character("valkyrja","normal")
	await novel_interface.show_dialog("C'est ça. Vous voulez qu'elle vous aide ?", "Vera")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","perspire1")
	await novel_interface.show_dialog("Hein ?!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("emilio","smile")
	await novel_interface.show_dialog("Pas de problème. Elle coopérera.", "Emily")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","wry_smile")
	await novel_interface.show_dialog("Tu n'as même pas peur que je m'enfuie...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("J'ai protesté en sortant du véhicule très docilement, mais j'ai avalé le reste à mi-chemin.")
	novel_interface.show_character("ren_medical","wail")
	await novel_interface.show_dialog("(C'est un désert vide dans toutes les directions. Où pourrais-je courir exactement...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Cette station de ravitaillement engloutie était nichée dans les dunes. De loin, cela ressemblait à un simple monticule de terre nue sur une colline aride.")
	await novel_interface.show_text_only("Pourtant, il était visiblement abandonné depuis assez longtemps...")
	await novel_interface.show_text_only("Probablement parce qu'un endroit comme celui-ci coûte trop cher à entretenir et que la résistance avait déjà abandonné les environs.")
	await novel_interface.show_text_only("La jeep garée à l'intérieur de la gare était recouverte d'une épaisse couche de poussière et d'énormes tas de sacs de sable destinés à la construction de fortifications étaient empilés négligemment partout.")
	await novel_interface.show_text_only("Le chariot élévateur et le générateur appuyés contre le mur étaient couverts de rouille et de cicatrices laissées par le vent et le sable. Quelques caisses de munitions renversées gisaient également dans le coin...")
	await novel_interface.show_text_only("De retour dans le véhicule, Emily avait répondu à ma deuxième question : quelle était exactement la « affaire personnelle » pour laquelle ils étaient ici.")
	await novel_interface.show_text_only("En fait, j'en avais déjà deviné une partie. Cela avait à voir avec mon identité de couverture...")
	await novel_interface.show_text_only("Selon Emily, cela viole les conventions internationales permettant aux ONG présentes dans les zones de guerre de transporter tout type de matériel militaire.")
	await novel_interface.show_text_only("Obtenir des exemptions des deux côtés au nom de l’aide à des civils innocents, pour ensuite aider l’un des camps, constitue une grave violation de l’éthique.")
	await novel_interface.show_text_only("Mais ces dernières années, l'armée de Massadan a déguisé de nombreux avant-postes militaires en installations d'aide civile et a soudoyé des ONG pour qu'elles transportent des fournitures.")
	await novel_interface.show_text_only("De cette façon, ils peuvent cerner avec plus de flexibilité la résistance de la guérilla et, chaque fois qu'un de ces avant-postes est détruit, ils peuvent le dénoncer haut et fort comme une attaque terroriste contre des innocents.")
	await novel_interface.show_text_only("Ce qu’ils étaient là pour faire, c’était détourner ce genre d’offre du marché gris.")
	await novel_interface.show_text_only("Grâce au code de secours d'urgence inscrit sur mon badge, Emily avait trouvé des informations sur le véhicule le mieux adapté à la cible.")
	await novel_interface.show_text_only("Cette fonction visait à l'origine à localiser et à appeler les secours des ONG les plus proches en cas d'urgence.")
	novel_interface.show_character("emilio","smile")
	await novel_interface.show_dialog("Le camion transporte principalement du matériel médical militaire. Il passera par ici sur l'autoroute dans quarante minutes.", "Emily")
	await novel_interface.hide_character()
	novel_interface.show_character("valkyrja","happy")
	await novel_interface.show_dialog("Je vais installer des barrages routiers et des mines. Vous deux, préparez les mitrailleuses et les haut-parleurs.", "Vera")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","shy")
	await novel_interface.show_dialog("...Des haut-parleurs ?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ma main s'est déplacée vers ma poitrine par réflexe.")
	await novel_interface.show_text_only("Vera a retiré un à un les capots de protection des équipements du véhicule. Je m'étais préparé, mais ça m'a quand même surpris...")
	await novel_interface.show_text_only("Un grand robot cargo quadrupède, deux rangées de barrages routiers télécommandés, six mitrailleuses à visée automatique, quatre haut-parleurs et un tas de petites bombes télécommandées...")
	await novel_interface.show_text_only("...Qu'est-ce qu'ils prévoyaient de faire !?")
	await novel_interface.show_text_only("Emily et moi avons rapidement utilisé la capacité de charge du robot pour déployer les mitrailleuses et les haut-parleurs sur les collines voisines.")
	await novel_interface.show_text_only("Après avoir posé les barrages routiers et les bombes, Vera a suivi les instructions d'Emily, a rempli une jeep d'essence et l'a conduite derrière un rocher géant au bord de la route.")
	await novel_interface.show_text_only("Ensuite, ils ont lancé le drone éclaireur depuis le haut de l'APC et ont parfaitement caché le véhicule sous une couverture de camouflage optique.")
	await novel_interface.show_text_only("Finalement, nous nous sommes accroupis tous les trois derrière la plus haute colline et avons attendu tranquillement que la cible apparaisse.")
	novel_interface.show_character("ren_medical","stare")
	await novel_interface.show_dialog("Vous garantissez vraiment que personne ne sera blessé... ?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ai-je demandé avec inquiétude. Les armes que nous venions d'installer semblaient suffisantes pour anéantir un peloton entier.")
	novel_interface.show_character("valkyrja","wink")
	await novel_interface.show_dialog("Détendez-vous. C'est un plan d'Emily...", "Vera")
	await novel_interface.show_dialog("Tout le monde dans notre bataillon sait que si c'est son plan, c'est bon !", "Vera")
	await novel_interface.hide_character()
	novel_interface.show_character("emilio","mock")
	await novel_interface.show_dialog("Ces mitrailleuses utilisent un ciblage infrarouge contrôlé par l’IA. Ils ne frapperont absolument pas les gens.", "Emily")
	await novel_interface.show_dialog("Et les bombes télécommandées ont également été modifiées. Fondamentalement, ils n’ont pas beaucoup de pouvoir meurtrier. Certains sont principalement destinés au bruit, et d'autres émettent simplement des tonnes de fumée...", "Emily")
	novel_interface.change_expression("shout")
	await novel_interface.show_dialog("Ah, le camion arrive !", "Emily")
	await novel_interface.hide_character()
