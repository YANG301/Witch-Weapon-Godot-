	await novel_interface.show_dialog("Физика... Мушар?", "Акико")
	await novel_interface.show_text_only("Мариру кивнула.")
	novel_interface.show_character("liliu_uniform1","serious")
	await novel_interface.show_dialog("Это последняя часть головоломки, и причина, по которой церемония подписания должна была состояться сегодня...", "Мариру")
	await novel_interface.show_dialog("Но пока эта часть наконец не будет установлена на место, мы все еще не сможем увидеть полную схему плана Мушара...", "Мариру")
	await novel_interface.hide_character()
