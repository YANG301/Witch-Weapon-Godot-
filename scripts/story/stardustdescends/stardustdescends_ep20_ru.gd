# stardustdescends_ep20.gd - 星尘降落篇第20话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	stardustdescends_ep20_script()

func play_script():
	pass

func stardustdescends_ep20_script():
	novel_interface.change_music("res://assets/audio/music/Sewer.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_Religion.png")
	await novel_interface.show_text_only("Многие люди имеют веру и используют ее как якорь для установления собственного порядка в неспокойном мире.")
	await novel_interface.show_text_only("Вера также может помочь людям обрести то, чего они жаждут внутри: цель, смелость, спасение, чувство принадлежности... список можно продолжать.")
	await novel_interface.show_text_only("Вера также принимает множество форм: религия, политика, идеология и даже форма отдельного человека.")
	await novel_interface.show_text_only("Многие люди спорят о том, в чем на самом деле заключается суть веры.")
	await novel_interface.show_text_only("Философы полагают, что вера — это акт принудительного рассмотрения какого-либо недоказуемого утверждения как истины и его защиты с непоколебимой убежденностью.")
	await novel_interface.show_text_only("Таким образом, столкнувшись с этими «конечными вопросами», вы сможете пропустить процесс доказательства и сразу ввести ответ, даже сделать вывод, какими должны были быть предпосылки.")
	await novel_interface.show_text_only("Логически последовательное, систематическое объяснение действительно является мощным средством от пустоты внутри человеческого сердца.")
	await novel_interface.show_text_only("Но исследования в области нейробиологии постепенно показали, что, столкнувшись с вопросом, человеческий мозг с самого начала склонен дать ответ.")
	await novel_interface.show_text_only("И настоящее рациональное мышление возникает в процессе проверки и отклонения этих ответов.")
	await novel_interface.show_text_only("Когда факел разума начинает тускнеть, люди инстинктивно выдумывают себе веру...")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Как в известной поговорке: вера начинается там, где останавливается мысль.")
	await novel_interface.stop_music()
	await novel_interface.show_text_only("…………")
	await novel_interface.show_text_only("……")
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_APC_Wall.png")
	await novel_interface.show_dialog("Не отвечайте ему!!", "Мариру")
	await novel_interface.show_text_only("Мариру повторила только что отданный приказ резким голосом.")
	novel_interface.show_character("ren_medical","panic")
	await novel_interface.show_dialog("Н-Но...", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Слушайте внимательно. На этот раз Хамон сильно упал...", "Мариру")
	await novel_interface.show_dialog("Все поверят, что это самоубийственное возмездие было вызвано его жестокостью и глупостью.", "Мариру")
	await novel_interface.show_dialog("А предсмертное послание Мушара сделает правительство Масады, военные и даже религиозные гильдии объектами международного осуждения.", "Мариру")
	await novel_interface.show_dialog("Если Хамон все еще хочет баллотироваться на пост... нет, даже если он просто хочет избежать насильственной смерти, ему придется перенести конфликт вовне.", "Мариру")
	await novel_interface.show_dialog("И превратить внутренний конфликт в международный спор – его лучший вариант.", "Мариру")
	await novel_interface.show_dialog("Пока он предоставит доказательства сейчас, у всех в Масаде - независимо от того, поддерживают они его или нет - не будет иного выбора, кроме как поддержать его.", "Мариру")
	await novel_interface.show_dialog("Так что, если ты сейчас сдашься, ты не просто погубишь свою жизнь. Вы также подтвердите измену Эмили, и ее родственники тоже будут замешаны.", "Мариру")
	await novel_interface.show_dialog("Хамон организует массовый общенациональный публичный суд, приговорит вас обоих к смертной казни в открытом суде и немедленно приведет его в исполнение.", "Мариру")
	novel_interface.show_character("ren_medical","panic")
	await novel_interface.show_dialog("...", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Анализ ситуации Мариру лишил меня дара речи.")
	await novel_interface.show_dialog("Брось это...", "Мариру")
	await novel_interface.show_dialog("У нас нет рычагов влияния в этих переговорах.", "Мариру")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("...")
	await novel_interface.show_text_only("На радио снова загорелся индикатор вызова.")
	await novel_interface.show_dialog("Осталось четыре минуты.", "Радио")
	await novel_interface.show_text_only("В голосе Хамона не было и следа эмоций.")
	await novel_interface.show_text_only("Этот спокойный, леденящий душу тон убедил меня, что он без колебаний нажмет на курок, когда обратный отсчет закончится...")
	novel_interface.show_character("ren_medical","serious")
	await novel_interface.show_dialog("(Что мне делать...)\n(Что мне делать!!)", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Давай... думай!!!")
	await novel_interface.show_text_only("...")
	await novel_interface.show_text_only("Тем временем SID Командный пункт.")
	novel_interface.show_background("res://assets/images/bg/SID/opsRoom.png")
	await novel_interface.show_text_only("Ая быстро вывела на большой экран поток спутниковых данных, не обращая никакого внимания на следы, все еще оставшиеся на ее щеках.")
	novel_interface.show_character("ai","blush_stare")
	await novel_interface.show_dialog("Этот спутник имеет массу около тридцати тонн. Он уже пересек геостационарную орбиту.", "Ая")
	novel_interface.change_expression("blush_dizzy")
	await novel_interface.show_dialog("Ожидается, что он войдет в атмосферу через десять минут, и к тому времени его скорость достигнет...\n...80 Маха!!", "Ая")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","serious")
	await novel_interface.show_dialog("Можно ли его перехватить?", "Мариру")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Айя развела руками.")
	novel_interface.show_character("ai","blush_think")
	await novel_interface.show_dialog("Спутник постоянно корректирует ориентацию. На такой скорости, даже когда его орбиту невозможно определить, не осталось ничего, что могло бы его перехватить...", "Ая")
	await novel_interface.show_dialog("Тепловой экран должен потерять большую скорость при спуске, но энергия удара все равно будет огромной...", "Ая")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Он уже движется быстрее, чем \"Вояджер-1\", не так ли?!\nКак это вообще возможно...", "Акико")
	novel_interface.show_character("ai","wink")
	await novel_interface.show_dialog("Это возможно...", "Ая")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Айя открыл модель Солнечной системы, где красная эллиптическая кривая пересекает орбиты третьей и четвертой планет.")
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("Если вы используете переходную орбиту Гомана между Землей и Марсом...", "Ая")
	await novel_interface.show_dialog("Два года назад действительно было окно запуска, когда Земля и Марс находились в подходящих позициях на своих орбитах.", "Ая")
	await novel_interface.show_dialog("Если бы спутник на околоземной орбите в этот момент запустил свой реактивный двигатель для мгновенного ускорения, он мог бы выйти на переходную орбиту и через год достичь Марса.", "Ая")
	await novel_interface.show_dialog("Затем он мог бы использовать гравитационную рогатку, чтобы ускориться обратно к Земле, включив при этом ионный двигатель и непрерывно ускоряясь на обратном пути...", "Ая")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("При условии ускорения в течение 120 дней спутник сможет достичь третьей космической скорости, а путешествие от Марса обратно на Землю займет не менее 260 дней.", "Ая")
	novel_interface.change_expression("dizzy")
	await novel_interface.show_dialog("Израсходуйте топливо, которое изначально предназначалось для доставки его обратно на Землю во время полета на Марс, а затем положитесь на ионный двигатель для длительного ускорения...", "Ая")
	novel_interface.change_expression("blush_dizzy")
	await novel_interface.show_dialog("Реализация столь смелой идеи потребовала бы глубоких знаний физики и чрезвычайно точных расчетов… впечатляет.", "Ая")
