# stardustdescends_ep13.gd - 星尘降临篇第13话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	stardustdescends_ep13_script()

func play_script():
	pass

func stardustdescends_ep13_script():
	novel_interface.change_music("res://assets/audio/music/Story_01.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_MasadSentry.png")
	await novel_interface.show_text_only("A giudicare dalle riprese del monitor del veicolo, proprio davanti a loro c'era una sezione del muro di isolamento ancora in costruzione.")
	await novel_interface.show_text_only("Dato che si trovava al confine del centro città, non aveva l'atmosfera prospera e pacifica del quartiere centrale...")
	await novel_interface.show_text_only("Acciaio, cemento e polvere hanno ripristinato la struttura grezza e ruvida di una zona di guerra nel deserto.")
	await novel_interface.show_text_only("Il posto di blocco più avanti era stato costruito come una fortezza e attorno ad esso erano parcheggiati diversi APC dello stesso modello.")
	await novel_interface.show_text_only("In lontananza molte gru a torre e macchine pesanti erano al lavoro, e al di là del muro si vedevano vagamente sciami di droni nel cielo.")
	await novel_interface.show_text_only("Da come erano disposte le barricate metalliche, l'uscita davanti a loro sembrava chiaramente chiusa al traffico.")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_MasadAPCO2.png")
	novel_interface.show_character("ren_medical","wail")
	await novel_interface.show_dialog("Intendi... farti strada con la forza?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Emily batté le nocche contro la parete interna dell'APC.")
	novel_interface.show_character("emilio","speechless")
	await novel_interface.show_dialog("Con questo?", "Emily")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("L'armatura è robusta, ma conduce il calore proprio come il normale metallo. Probabilmente dureremmo circa venti secondi prima di essere arrostiti vivi~", "Emily")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("All'improvviso il veicolo si fermò. Una voce familiare proveniva dalla cabina di guida...")
	await novel_interface.show_dialog("Vera Valkyrie, maresciallo di prima classe del battaglione Caracal, preleva personale dal campo per la ricognizione fuori città.", "Vera")
	novel_interface.show_character("ren_medical","wry_smile")
	await novel_interface.show_dialog("(Quella è la fortissima donna della sicurezza della nave casinò, vero?!)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ricordavo ancora vividamente quando sollevava quell'enorme capo vescovo con una mano sola.")
	await novel_interface.show_dialog("Oh, sono Vera. C'è una protesta in corso al mercato di Yehuda in questo momento. Se non vuoi impantanarti, è meglio prendere un'altra uscita...", "Voce maschile")
	await novel_interface.show_dialog("Smettila di parlare e lasciaci passare. Non abbiamo tempo per una deviazione!", "Vera")
	await novel_interface.show_dialog("Ahah, bene, bene. Basta, non causare altri problemi. L'ultima volta che il tuo vecchio ha chiamato dal quartier generale dello Stato Maggiore solo per sgridare la gente...", "Voce maschile")
	await novel_interface.show_dialog("Menzionatelo ancora e vi investirò.", "Vera")
	await novel_interface.show_dialog("Spostare il posto di blocco. Lasciali passare, lasciali passare!", "Voce maschile")
	await novel_interface.show_text_only("Emily si è avvicinata e mi ha sussurrato.")
	novel_interface.show_character("emilio","mock")
	await novel_interface.show_dialog("Allora, hai avuto quel breve momento in cui hai pensato di gridare aiuto... e poi ti sei tirato indietro?", "Emily")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","shy_left")
	await novel_interface.show_dialog("Ovviamente no!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Girai in fretta la testa dall'altra parte. Uffa, è così odiosa!")
	await novel_interface.show_text_only("Il veicolo avanzò lentamente e presto attraversò il muro di isolamento entrando nella periferia di Masada.")
	await novel_interface.show_text_only("Avevo pensato che la periferia della città sarebbe stata ancora più desolata, ma dopo aver attraversato il muro di isolamento, il numero di persone sulla strada è improvvisamente aumentato...")
	await novel_interface.show_text_only("Qui le strade erano più accidentate, c'erano meno grattacieli e cinture verdi, ma erano inaspettatamente vivaci.")
	await novel_interface.show_text_only("La folla, gli autobus che andavano avanti e indietro e i venditori ambulanti che vendevano merci mi facevano sentire come se fossi scivolato nel tempo.")
	novel_interface.show_character("ren_medical","gratified")
	await novel_interface.show_dialog("Ci sono così tante persone qui...", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("emilio","smile",0.25)
	await novel_interface.show_dialog("Naturalmente. Il novanta per cento della popolazione di questa città vive fuori dal muro di isolamento.", "Emily")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Così tanti!?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Il centro della città è di soli 32 chilometri quadrati in totale, meno di un quarto della superficie totale di Masada, e i prezzi dei terreni sono scandalosi~", "Emily")
	await novel_interface.show_dialog("Soprattutto nel quartiere centrale. La superficie di un solo bagno sarebbe sufficiente per acquistare un monolocale in riva al Mar Morto.", "Emily")
	novel_interface.character_light(0.35,"wry_smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Pensavo che il muro di isolamento servisse a quello... sai...", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Segregazione razziale?", "Emily")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Giusto, giusto. Non esiste una regola secondo la quale certe parole offensive per un gruppo specifico possono essere dette solo dalle persone di quel gruppo?")
	novel_interface.show_character("emilio","mock")
	await novel_interface.show_dialog("Il Consiglio Unito ha bandito questo genere di cose molto tempo fa~", "Emily")
	await novel_interface.show_dialog("Ma la legge antiterrorismo di Masada dice che se vuoi risiedere a lungo termine nel centro della città dove si trovano il governo e il parlamento, devi superare una revisione dell'Ufficio di sicurezza.", "Emily")
	await novel_interface.show_dialog("E i candidati i cui parenti stretti appartengono a determinati gruppi etnici si dà il caso che non passino mai... capito?", "Emily")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annuii, capendo solo a metà.")
	await novel_interface.show_text_only("Quindi questa è segregazione!\nAnche se sembra che si stiano segregando...")
	await novel_interface.show_text_only("E se questo è vero, allora anche la maggior parte dei masadan deve vivere nella periferia della città, giusto?")
	await novel_interface.show_text_only("Sullo schermo vidi una soldatessa con un M16 in spalla, accovacciata davanti a una bancarella che vendeva ornamenti per capelli, che contrattava con una venditrice il cui volto era avvolto in un velo.")
	novel_interface.show_character("ren_medical","wail")
	await novel_interface.show_dialog("(Si scopre che nessuno può permettersi un alloggio, non importa da dove provenga...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("All'improvviso il veicolo ha frenato bruscamente. La mia testa quasi colpì lo schermo e le imprecazioni di Vera risuonarono dalla cabina di guida.")
	await novel_interface.show_dialog("Dannazione!!", "Vera")
	novel_interface.show_character("emilio","shout")
	await novel_interface.show_dialog("Cosa è successo!?", "Emily")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Ho lanciato un drone da ricognizione. Guardate voi stessi lo schermo.", "Vera")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Emily e io ci siamo precipitati allo schermo e abbiamo visto una scena che mi ha fatto accapponare la pelle...")
	#novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_AncientHumanEH.png") #原游戏有素材，但已丢失
	await novel_interface.show_text_only("Più di mille uomini con cappotti e cappelli neri erano radunati all'incrocio più avanti, come in un imponente funerale.")
	await novel_interface.show_text_only("Tenevano cartelli di protesta fatti in casa in bianco e nero, come se si opponessero all'esistenza di qualsiasi altro colore al mondo.")
	await novel_interface.show_text_only("La maggior parte di loro aveva barbe enormi e strane treccine sulle tempie. Quello sguardo sembrava terribilmente familiare...")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_MasadAPCR1.png")
	await novel_interface.show_dialog("Queste inutili stronzate! Vivono di sussidi statali e continuano a protestare ogni maledetto giorno!", "Vera")
	await novel_interface.show_text_only("Supponiamo che \"bleep\" sia una specie di dialetto... comunque non sono riuscito a capirlo.")
	await novel_interface.show_dialog("Vogliono che il numero di scuole elementari che corrispondono alla loro dottrina sia raddoppiato?\nQuei dannati riccioli laterali sono cresciuti nel loro cervello!?", "Vera")
	await novel_interface.show_text_only("Ho sentito dei calci provenire dalla porta della cabina. Apparentemente il nostro autista era saltato fuori per litigare.")
	novel_interface.show_character("ren_medical","wail")
	await novel_interface.show_dialog("Co-cosa sta facendo?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("emilio","mock",0.25)
	await novel_interface.show_dialog("Coprirò i piatti~", "Emily")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Emily rispose distrattamente mentre controllava la mappa del percorso sul suo robusto tablet militare.")
	novel_interface.show_character("ren_medical","wry_smile")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("emilio","mock",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("C-cosa farà...? Quelle persone sono Masadan, vero?\nPenso di averne visti alcuni al museo proprio ora...", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"stare")
	await novel_interface.show_dialog("Sono il \"patrimonio storico\" di Masada. Non lavorano, non pagano le tasse, non prestano servizio militare e il governo deve comunque erogare loro sussidi mensili...", "Emily")
	await novel_interface.show_dialog("Anche se disturbano l'ordine pubblico e bloccano il traffico, la polizia e l'esercito non possono toccarli, perché hanno i propri tribunali religiosi.", "Emily")
	novel_interface.character_light(0.35,"stare")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("...Va così bene?", "Lian")
	novel_interface.change_expression("uneasy")
	await novel_interface.show_dialog("(Ciò non significherebbe che potresti semplicemente restare a casa e giocare ogni giorno...)", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"mock")
	await novel_interface.show_dialog("Ma la loro dottrina dice che non possono esserci televisori o computer in casa e che l'accesso a Internet è severamente vietato...", "Emily")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Questa è una tortura!!")
	novel_interface.show_character("ren_medical","uneasy")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("emilio","speechless",0.25)
	await novel_interface.show_dialog("Ma le loro mogli sono diverse. Possono utilizzare dispositivi elettronici perché quegli uomini fanno affidamento sulle donne per guadagnare denaro e contribuire al sostentamento della famiglia.", "Emily")
	novel_interface.change_2nd_expression("stare")
	await novel_interface.show_dialog("Non è perché i sussidi sono troppo piccoli. È perché le donne di quelle famiglie hanno in media sei o sette figli, e alcune ne hanno più di una dozzina.", "Emily")
	novel_interface.change_2nd_expression("speechless")
	await novel_interface.show_dialog("Così tanti bambini. Non c'è da stupirsi che le scuole religiose non siano sufficienti...", "Emily")
	novel_interface.character_light(0.35,"bored")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("(I dieci e passa bambini che ho visto raggrupparsi intorno a quei due uomini barbuti vestiti di nero al museo potrebbero essere stati...)", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("E le due donne smunte che li seguivano...")
	await novel_interface.show_text_only("Quando ho pensato al passeggino che uno di loro aveva spinto, un brivido mi ha percorso la schiena.")
	novel_interface.show_character("emilio","speechless")
	await novel_interface.show_dialog("I fondamentalisti religiosi sono un cancro, non importa dove tu vada...", "Emily")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Emily continuava ad armeggiare con il tablet a testa bassa, il suo tono trasportava una strana tristezza e un accenno di rassegnazione.")
	await novel_interface.show_text_only("Dopo non molto Vera ritornò nel veicolo ed Emily diede un colpetto alla parete metallica della cabina per ricordarglielo.")
	novel_interface.show_character("emilio","smile")
	await novel_interface.show_dialog("Girare fino al terzo incrocio sul lato est. C'è un cavalcavia appena completato lì. È il percorso più veloce per uscire dalla città.", "Emily")
	await novel_interface.show_dialog("Inoltre, se hai intenzione di fare \"questo\", ricordati di girare prima il veicolo.", "Emily")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Capito~", "Vera")
	await novel_interface.show_text_only("Vera girò il volante al limite e diede gas, facendo girare la parte anteriore in un giro senza la minima preoccupazione per il comfort dei passeggeri.")
	await novel_interface.show_text_only("Un attimo dopo si sentirono quattro colpi sordi dal tetto del veicolo: tonfo, tonfo, tonfo.")
	novel_interface.show_character("ren_medical","panic")
	await novel_interface.show_dialog("(Aspetta, perché suonava come un lanciagranate...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ben presto gli uomini in nero riuniti iniziarono a farsi prendere dal panico, mentre pennacchi di fumo bianco di gas lacrimogeno eruttavano da quattro punti diversi tra la folla...")
	await novel_interface.show_text_only("E il nostro veicolo l'ha schiacciato ed è scomparso dietro l'angolo.")
	await novel_interface.stop_music()
	await novel_interface.hide_background_with_fade()
	await novel_interface.show_text_only("...")
	await novel_interface.show_text_only("............")
	await novel_interface.show_text_only("Man mano che l'ombra del muro di isolamento si rimpiccioliva dietro di me, il terreno su entrambi i lati della strada diventava gradualmente sterile.")
	await novel_interface.show_text_only("Dopo essere rimasti in città per così tanto tempo, era facile dimenticare che la stessa Masadaburg era una città brusca costruita nel deserto.")
	await novel_interface.show_text_only("L'APC correva lungo una strada deserta e non c'era segno di vita umana da nessuna parte accanto all'autostrada solitaria.")
	await novel_interface.show_text_only("Solo pochi arbusti secchi resistevano ancora ostinatamente nella sabbia...")
	novel_interface.change_music("res://assets/audio/music/unkown/Battle_08.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_StagingPost.png")
	await novel_interface.show_text_only("Dopo circa un'altra ora fuori città, la porta dello scompartimento delle truppe si aprì lentamente e davanti a me apparve una stazione di rifornimento militare.")
	novel_interface.show_character("valkyrja","normal")
	await novel_interface.show_dialog("Questo è tutto. Vuoi aiutarla?", "Vera")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","perspire1")
	await novel_interface.show_dialog("Eh?!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("emilio","smile")
	await novel_interface.show_dialog("Nessun problema. Collaborerà.", "Emily")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","wry_smile")
	await novel_interface.show_dialog("Non hai nemmeno paura che scappi...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ho protestato scendendo dal veicolo molto obbedientemente, ma ho ingoiato il resto a metà.")
	novel_interface.show_character("ren_medical","wail")
	await novel_interface.show_dialog("(È un deserto vuoto in ogni direzione. Dove correrei esattamente...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Questa stazione di rifornimento sommersa era nascosta tra le dune. Da lontano sembrava solo un altro cumulo di terra nuda su una collina brulla.")
	await novel_interface.show_text_only("Eppure era evidentemente abbandonato da parecchio tempo...")
	await novel_interface.show_text_only("Probabilmente perché la manutenzione di un posto come questo costa troppo, e perché la Resistenza aveva già rinunciato ai dintorni.")
	await novel_interface.show_text_only("La jeep parcheggiata all'interno della stazione era ricoperta da uno spesso strato di polvere e enormi mucchi di sacchi di sabbia destinati alla costruzione di fortificazioni erano accatastati con noncuranza ovunque.")
	await novel_interface.show_text_only("Il carrello elevatore e il generatore appoggiati al muro erano coperti di ruggine e cicatrici lasciate dal vento e dalla sabbia. In un angolo giacevano anche alcune scatole di munizioni rovesciate...")
	await novel_interface.show_text_only("Tornati nel veicolo, Emily aveva risposto alla mia seconda domanda: quali fossero esattamente gli \"affari personali\" per cui erano lì.")
	await novel_interface.show_text_only("In realtà lo avevo già indovinato in parte. Aveva a che fare con la mia identità di copertura...")
	await novel_interface.show_text_only("Secondo Emily, ciò viola le convenzioni internazionali per le ONG nelle zone di guerra trasportare qualsiasi tipo di rifornimento militare.")
	await novel_interface.show_text_only("Ottenere esenzioni da entrambe le parti in nome dell’aiuto a civili innocenti, solo per poi aiutare una parte, è una grave violazione dell’etica.")
	await novel_interface.show_text_only("Ma negli ultimi anni, l’esercito di Masadan ha camuffato molti avamposti militari come strutture di aiuto civile e ha corrotto le ONG affinché trasportassero rifornimenti per loro.")
	await novel_interface.show_text_only("In questo modo possono definire con maggiore flessibilità la resistenza della guerriglia e, ogni volta che uno di questi avamposti viene distrutto, possono denunciarlo ad alta voce come un attacco terroristico contro innocenti.")
	await novel_interface.show_text_only("Quello che erano qui per fare era dirottare quel tipo di offerta del mercato grigio.")
	await novel_interface.show_text_only("Usando il codice di soccorso riportato sul mio badge, Emily aveva trovato informazioni sul veicolo più adatto all'obiettivo.")
	await novel_interface.show_text_only("Questa funzione era originariamente destinata a localizzare e richiamare le forniture di soccorso delle ONG più vicine in caso di emergenza.")
	novel_interface.show_character("emilio","smile")
	await novel_interface.show_dialog("Il camion trasporta principalmente forniture mediche militari. Passerà di qui sull'autostrada tra quaranta minuti.", "Emily")
	await novel_interface.hide_character()
	novel_interface.show_character("valkyrja","happy")
	await novel_interface.show_dialog("Vado a posizionare posti di blocco e mine. Voi due preparate le mitragliatrici e gli altoparlanti.", "Vera")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","shy")
	await novel_interface.show_dialog("...Altoparlanti?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("La mia mano si spostò di riflesso sul petto.")
	await novel_interface.show_text_only("Vera ha tolto una dopo l'altra le coperture protettive dall'attrezzatura del veicolo. Mi stavo preparando, ma la cosa mi sorprendeva ancora...")
	await novel_interface.show_text_only("Un grande robot da carico quadrupede, due file di posti di blocco telecomandati, sei mitragliatrici a puntamento automatico, quattro altoparlanti e un mucchio di piccole bombe remote...")
	await novel_interface.show_text_only("...Cosa diavolo avevano intenzione di fare!?")
	await novel_interface.show_text_only("Emily e io abbiamo sfruttato rapidamente la capacità di carico del robot da soma per schierare mitragliatrici e altoparlanti sulle colline vicine.")
	await novel_interface.show_text_only("Dopo aver piazzato i posti di blocco e le bombe, Vera ha seguito le istruzioni di Emily, ha riempito di benzina una jeep e l'ha portata dietro un masso gigante lungo la strada.")
	await novel_interface.show_text_only("Quindi hanno lanciato il drone da ricognizione dalla parte superiore dell'APC e hanno nascosto perfettamente il veicolo sotto una copertura mimetica ottica.")
	await novel_interface.show_text_only("Alla fine ci accucciammo tutti e tre dietro la collina più alta e aspettammo in silenzio che apparisse il bersaglio.")
	novel_interface.show_character("ren_medical","stare")
	await novel_interface.show_dialog("Garantisci davvero che nessuno si farà male...?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("chiesi a disagio. Le armi che avevamo appena piazzato sembravano sufficienti a spazzare via un intero plotone.")
	novel_interface.show_character("valkyrja","wink")
	await novel_interface.show_dialog("Rilassati. Questo è un piano di Emily...", "Vera")
	await novel_interface.show_dialog("Tutti nel nostro battaglione sanno che se è il suo piano, va bene!", "Vera")
	await novel_interface.hide_character()
	novel_interface.show_character("emilio","mock")
	await novel_interface.show_dialog("Quelle mitragliatrici utilizzano il targeting a infrarossi controllato dall'intelligenza artificiale. Non colpiranno assolutamente le persone.", "Emily")
	await novel_interface.show_dialog("E anche le bombe remote sono state modificate. Fondamentalmente non hanno molto potere letale. Alcuni servono principalmente per fare rumore, altri semplicemente emettono tonnellate di fumo...", "Emily")
	novel_interface.change_expression("shout")
	await novel_interface.show_dialog("Ah, sta arrivando il camion!", "Emily")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Il feed del drone da ricognizione mostrava un camion con il logo rosso dell'organizzazione di soccorso medico che percorreva l'autostrada.")
	await novel_interface.show_text_only("Quando ha raggiunto il tratto vicino alla stazione di rifornimento, una bomba è esplosa e la prima fila di posti di blocco è emersa ad angolo facendo sobbalzare il camion.")
