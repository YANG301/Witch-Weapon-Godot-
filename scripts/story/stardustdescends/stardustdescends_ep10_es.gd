# stardustdescends_ep10.gd - 星尘降临篇第10话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	stardustdescends_ep10_script()

func play_script():
	pass

func stardustdescends_ep10_script():
	await novel_interface.show_text_only("Cuando salimos de inmigración, el cielo se había despejado y los tres abordamos el transbordador ferroviario del puerto.")
	await novel_interface.show_text_only("El tren maglev era increíblemente rápido. En menos de diez minutos llegó a la estación de la Knesset en el centro de la ciudad de Masada.")
	await novel_interface.show_text_only("...")
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_Masadainner.png")
	novel_interface.show_character("anne_uniform","panic")
	await novel_interface.show_dialog("Esto...", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","happy")
	await novel_interface.show_dialog("¡¡Esto es increíble!!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("stardust_small","happy")
	await novel_interface.show_dialog("Wooow──", "Stardust")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","happy")
	await novel_interface.show_dialog("Entonces esto es... ¿Masadaburg?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_uniform","panic",0.25)
	await novel_interface.show_dialog("Incluso yo... no esperaba esto...", "Annie")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("La escena que teníamos ante nosotros anuló por completo mi impresión de Masada como una \"fortaleza del desierto devastada por la guerra\"──")
	await novel_interface.show_text_only("En calles tan limpias y elegantes como un jardín, se podían ver por todas partes robots sanitarios con inteligencia artificial y carros de carga no tripulados.")
	await novel_interface.show_text_only("Las fachadas de los rascacielos del lejano centro de la ciudad estaban revestidas con paneles metálicos con un fuerte aire futurista, que reflejaban débilmente las nubes blancas de arriba.")
	await novel_interface.show_text_only("Bajo el cielo azul, vastas extensiones de vegetación se extendían hasta el horizonte...")
	novel_interface.show_character("ren_medical","smile")
	await novel_interface.show_dialog("Este aire se siente increíblemente refrescante──", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Apoyándome en la barandilla de piedra, respiré profundamente. El aire húmedo llevaba el leve sabor salado exclusivo del viento marino.")
	novel_interface.show_character("ren_medical","smile")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_uniform","happy",0.25)
	await novel_interface.show_dialog("Este es el lugar con la presión atmosférica más alta de la Tierra. Con más oxígeno en el aire, respirar se siente más fácil~", "Annie")
	novel_interface.change_2nd_expression("normal1")
	await novel_interface.show_dialog("No puedo creer que hayan convertido el desierto junto al Mar Muerto en esto...", "Annie")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Annie, ¿qué es ese largo trecho de allí...?", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Señalé hacia la izquierda. A lo lejos se alzaba una barrera que corría de este a oeste, y más allá no parecía haber ningún rascacielos.")
	novel_interface.show_character("anne_uniform","stare")
	await novel_interface.show_dialog("Ese es el \"muro de aislamiento\".", "Annie")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Estamos muy lejos ahora, pero en realidad tiene decenas de metros de altura, con puntos de control de seguridad y sistemas de defensa automatizados por todas partes.", "Annie")
	await novel_interface.show_dialog("También hay muchos sensores enterrados bajo tierra. Ni siquiera un ratón podría pasar.", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie suspiró y murmuró en voz baja para sí misma.")
	novel_interface.show_character("anne_uniform","upset")
	await novel_interface.show_dialog("Su capital anterior también tenía algo como esto, y aún así se aplanó...", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","worry")
	await novel_interface.show_dialog("Eso pasó hace mucho tiempo, ¿verdad...?\nYo solo estaba en la escuela primaria en ese entonces──", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Entonces se me ocurrió que Annie había pasado siete años en la Brecha de la Causalidad. Para ella, ese recuerdo quizá no sea tan antiguo.")
	novel_interface.show_character("ren_medical","wry_smile")
	await novel_interface.show_dialog("P-Por cierto──\n¿Cuál es el punto de construir un muro como ese?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Rápidamente cambié de tema de manera bastante incómoda.")
	novel_interface.show_character("ren_medical","smile")
	await novel_interface.show_dialog("Si realmente estallara la guerra, un muro como ese no detendría nada...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","normal2")
	await novel_interface.show_dialog("Los gobiernos construyen muros por todo tipo de razones: detener invasiones, evitar que la gente huya, mantener alejados a los inmigrantes ilegales...", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie dijo esto mientras miraba las banderas de las Seis Ciudades Escolares en el parque de enfrente.")
	novel_interface.show_character("anne_uniform","upset")
	await novel_interface.show_dialog("Pero la situación de Masada es aún más complicada...", "Annie")
	await novel_interface.show_dialog("A ambos lados de ese muro, muchas personas no quieren ver el otro lado.", "Annie")
	await novel_interface.show_dialog("Sólo no viendo el otro lado, fingiendo que los demás no existen, podrán vivir con la conciencia tranquila.", "Annie")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("Bueno... aunque dudo que realmente lo entiendas, Lian.", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("stardust_small","pleased")
	await novel_interface.show_dialog("Ooh ~~ Ya veo...", "Stardust")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Stardust de repente apareció en la conversación, asintiendo y adoptando una pose pensativa como si entendiera completamente.")
	novel_interface.show_character("stardust_small","pleased")
	await novel_interface.show_dialog("Mmmm~", "Stardust")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("¡Como si entendieras algo! ¿No es exactamente la misma reacción que tengo cuando me quedo en blanco durante la clase de física?")
	await novel_interface.show_text_only("Para ser justos, la explicación de Annie también pasó por alto. Tal vez tuvo algo que ver con su propio pasado...")
	await novel_interface.show_text_only("Al ver la mirada hueca y perdida en mis ojos, Annie me rodeó el cuello con un brazo.")
	novel_interface.show_character("anne_uniform","smile")
	await novel_interface.show_dialog("Oye, no te lo tomes tan en serio. Más que nada estoy diciendo tonterías~", "Annie")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("Déjame decirte algo. ¡\"Phantom Force\" de Masada está en algún lugar subterráneo del centro de la ciudad!", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","panic")
	await novel_interface.show_dialog("¿Eh...?\n¿Te refieres a ese objeto heteromórfico de clase XK?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("\"Phantom Force\" es el objeto heteromórfico de clase estratégica de Masada, que existe como un espacio designado inamovible.")
	await novel_interface.show_text_only("Cualquier arma disparada desde el interior de ese espacio obtiene un efecto de amplificación anormal, produciendo un poder destructivo de varios a cientos de veces más allá de su diseño original.")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_doomsday.png")
	await novel_interface.show_text_only("El \"sistema de contraataque automático\" que la Tercera Ciudad Escolar anunció hace algún tiempo hace uso de esa propiedad exacta.")
	await novel_interface.show_text_only("Si el sistema determina que el daño al área urbana de Masada ha superado el 50%, activa automáticamente el \"Programa del Juicio Final\"──")
	await novel_interface.show_text_only("Usar Phantom Force para lanzar armas nucleares indiscriminadamente en todas las ciudades importantes del mundo, asegurando la destrucción mutua.")
	await novel_interface.show_text_only("Provocó fuertes protestas cuando se anunció por primera vez, pero la gente pareció aceptar el hecho consumado con sorprendente rapidez.")
	await novel_interface.show_text_only("El hecho de que Masada haya podido alcanzar rápidamente un acuerdo de alto el fuego con la resistencia probablemente tenga mucho que ver con ese sistema.")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_Masadainner.png")
	novel_interface.show_character("anne_uniform","smile")
	await novel_interface.show_dialog("¿Ves el blindaje metálico de esos edificios?", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","stare")
	await novel_interface.show_dialog("Lo noté antes...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("No me digas que toda esta ciudad fue construida para luchar contra los Apóstoles...")
	novel_interface.show_character("anne_uniform","smile")
	await novel_interface.show_dialog("Escuché que todo el subsuelo del centro de la ciudad está revestido con la misma armadura.", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("¡Cuanto más escucho, más suena exactamente así!")
	novel_interface.show_character("ren_medical","perspire1")
	await novel_interface.show_dialog("¿Q-Qué quieres decir...?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","smile")
	await novel_interface.show_dialog("¿Por qué crees que eligieron construir su nueva capital en este árido desierto salado junto al Mar Muerto?", "Annie")
	await novel_interface.show_dialog("Y luego gastó una suma enorme en la construcción de un gran canal con un desnivel de más de cuatrocientos metros sólo para sostener una capital en un lugar tan miserable.", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","panic")
	await novel_interface.show_dialog("¿Por el Phantom Force de abajo...?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Señalé el suelo bajo mis pies, pero algo en eso se sintió mal.")
	novel_interface.show_character("ren_medical","panic")
	await novel_interface.show_dialog("Pero sigue siendo una inversión demasiado grande... No es como Aegis, un escudo que puede bloquear todos los ataques externos.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","worry")
	await novel_interface.show_dialog("Es por eso que todos los países sospechan que Phantom Force puede tener alguna propiedad clave no revelada.", "Annie")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Ya era suficiente que los líderes de Masada estuvieran dispuestos a arriesgar el destino de todo el pueblo de esta tierra.", "Annie")
	await novel_interface.show_dialog("Se podría decir que toda la ciudad es una instalación protectora construida alrededor de Phantom Force──", "Annie")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("Entonces, como parte de ese sistema defensivo, construir un muro de aislamiento a esa escala no parece tan extraño, ¿verdad~?", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","stare")
	await novel_interface.show_dialog("Así que \"Masada Shall Never Fall\" también conlleva esa implicación...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Pero cuanto más implacablemente se protege un secreto, más curiosidad genera en la gente...")
	await novel_interface.show_text_only("Me volví para mirar el cartel gigante afuera de la estación de la Knesset que llevaba el mismo lema, e inesperadamente vi una cara familiar...")
	await novel_interface.show_text_only("Emilio, con una bolsa blanca de compras rellena, subía por las escaleras mecánicas de salida de la estación...")
	novel_interface.show_character("emilio","smile")
	await novel_interface.show_dialog("¿Ah?", "Emily")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("El teniente me miró a los ojos, sonrió y se acercó.")
	await novel_interface.show_text_only("Annie instantáneamente, como una profesional, actuó como una extraña que no me conocía, arrastrando su maleta mientras miraba su teléfono.")
	await novel_interface.show_text_only("Mientras tanto, durante los últimos dos días Stardust parecía haberse dado cuenta de que nadie más podía verla ni oírla, y se había vuelto mucho más audaz.")
	await novel_interface.show_text_only("Ella se paró con aire de suficiencia frente a mí como un perrito envalentonado por tener a su dueño detrás.")
	novel_interface.show_character("emilio","mock")
	await novel_interface.show_dialog("¡Ah! Eres esa... enfermera en prácticas del barco casino, ¿verdad?", "Emily")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Miró la etiqueta con mi nombre que colgaba de mi pecho.")
	novel_interface.show_character("emilio","mock")
	await novel_interface.show_dialog("Tu nombre es Lian, cierto~", "Emily")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","perspire1")
	await novel_interface.show_dialog("H-Hola...\nQue ganas de conocerte de nuevo.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("emilio","mock")
	await novel_interface.show_dialog("Jaja, quería decirte que después de que te fuiste ese día, le di a ese camarero una lección adecuada.", "Emily")
	await novel_interface.show_dialog("Más tarde descubrimos que también había acosado a varias de las traficantes.", "Emily")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","wail")
	await novel_interface.show_dialog("——¿¡Qué!?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("¿Entonces él también era reincidente?")
	novel_interface.show_character("emilio","mock")
	await novel_interface.show_dialog("Y esta vez incluso se atrevió a echarle mano a un invitado. ¿Estaba su cerebro en cortocircuito o qué?", "Emily")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","wry_smile")
	await novel_interface.show_dialog("¡Jajajaja...!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("¡En realidad, fue el spray de hipnosis!")
	novel_interface.show_character("ren_medical","happy")
	await novel_interface.show_dialog("Hablando de eso, realmente necesito agradecerte por hacerme pasar por seguridad temprano ese día...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("emilio","smile")
	await novel_interface.show_dialog("Ah, no fue nada. Últimamente a los superiores les encanta reclutarnos para todo tipo de tareas aburridas.", "Emily")
	novel_interface.change_expression("upset")
	await novel_interface.show_dialog("Y la última vez también hicieron el ridículo: el equipo de contención pasó medio día escaneando el barco con una montaña de equipos y no encontró absolutamente nada.", "Emily")
	novel_interface.change_expression("speechless")
	await novel_interface.show_dialog("No tengo idea de dónde compraron esa información falsa esta vez...", "Emily")
	await novel_interface.hide_character()
	novel_interface.show_character("stardust_small","stare")
	await novel_interface.show_dialog("¡Mmm! Y ella todavía tenía que ser tan mala...", "Stardust")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Stardust le sacó la lengua a Emilio.")
	novel_interface.show_character("stardust_small","stare")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("emilio","normal",0.25)
	await novel_interface.show_dialog("Por cierto──", "Emily")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Emilio se agachó.")
	novel_interface.show_character("stardust_small","stare")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("emilio","smile",0.25)
	await novel_interface.show_dialog("Esta niña es adorable~ No es local, ¿verdad?", "Emily")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Stardust y me quedé helado en el acto.")
	novel_interface.show_character("stardust_small","panic")
	await novel_interface.show_dialog("¿Eh...?\nUf... guh...", "Stardust")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Toda su bravuconería desapareció en un instante. Aterrada casi hasta las lágrimas, se escondió frenéticamente detrás de mí.")
	novel_interface.show_character("stardust_small","panic")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_medical","wail",0.25)
	await novel_interface.show_dialog("Ah? Jajaja...\nS-Ella es mi... mi, um...", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("¿¡Cómo la está viendo!?")
	await novel_interface.show_text_only("Emilio sacó de su bolsa de compras una botella de vidrio llena de un líquido rojo transparente. No tenía ninguna etiqueta.")
	novel_interface.show_character("stardust_small","panic")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("emilio","smile",0.25)
	await novel_interface.show_dialog("Zumo de granada recién exprimido. Es delicioso~\nUna de las famosas especialidades de la ciudad.", "Emily")
	await novel_interface.show_dialog("Toma, toma uno──", "Emily")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mientras decía eso, le tendió la botella a Stardust. Cuando me di cuenta de que necesitaba detenerla, ya era demasiado tarde.")
	await novel_interface.show_text_only("Prácticamente pude ver la botella atravesando el cuerpo de Stardust y rompiéndose en el suelo...")
	novel_interface.show_character("stardust_small","uneasy")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("emilio","smile",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Mmm...gracias...", "Stardust")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Stardust agarró la botella y la sostuvo en sus brazos. \nEmilio extendió la mano y le dio unas palmaditas en la cabeza.")
	novel_interface.show_character("stardust_small","uneasy")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("emilio","mock",0.25)
	await novel_interface.show_dialog("Que buena chica~", "Emily")
	novel_interface.character_light(0.35,"konata_eye")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Jejeje~~", "Stardust")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("¿Qué está pasando...?\n¿Esta cosita... ha dejado de ser una ilusión?")
	await novel_interface.show_text_only("¿Desde cuándo? ¿Annie y yo simplemente no nos dimos cuenta porque habíamos podido verla todo el tiempo?")
	await novel_interface.show_text_only("No, tuvo que ser después de que pasamos inmigración. De lo contrario, la aduana nunca nos habría dejado pasar tan fácilmente.")
	await novel_interface.show_text_only("¿Lo que significa que sucedió hace un momento?")
	await novel_interface.show_text_only("De todos modos, deberíamos investigarlo en el hotel más tarde. Por ahora tenemos que hacernos un farol~")
	await novel_interface.show_text_only("Espera, hablando de inmigración...")
	novel_interface.show_character("emilio","normal")
	await novel_interface.show_dialog("Aún así, Lian──", "Emily")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Emilio pareció notar algo. Casualmente agarró la muñeca de Stardust y le dio la vuelta.")
	novel_interface.show_character("emilio","stare")
	await novel_interface.show_dialog("¿Por qué no tiene un código de barras de inmigración en la mano?", "Emily")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mi cabeza zumbaba y el sudor empezó a gotear en mi frente.")
	await novel_interface.show_text_only("Se acabó, se acabó. ¡¡Me arrestan!!")
	await novel_interface.show_text_only("He oído que incluso los ciudadanos corrientes de Masada son extremadamente sensibles a los entrantes ilegales; no importa si los soldados nos pillan con las manos en la masa en la calle...")
	await novel_interface.show_text_only("Emilio estudió mi expresión rígida, luego miró a Stardust, que todavía estaba abrazando el jugo de granada y sonriendo estúpidamente sin entender nada.")
	novel_interface.show_character("emilio","speechless")
	await novel_interface.show_dialog("Suspiro. Si caminas por la ciudad con ella tan abiertamente, te arrestarán en una hora.", "Emily")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Emilio sacó un dispositivo de mano del clip de su cinturón. Parecía un teléfono móvil dos o tres veces más grueso de lo normal.")
	await novel_interface.show_text_only("Después de tocarlo varias veces, una tira de papel blanco de aproximadamente un centímetro de ancho, impresa con un código de barras, surgió de la ranura de la impresora del dispositivo.")
	await novel_interface.show_text_only("Envolvió la tira de papel alrededor del brazo de Stardust y unió los extremos.")
	novel_interface.show_character("emilio","smile")
	await novel_interface.show_dialog("Esta es una identificación militar temporal. La tinta del código de barras desaparecerá automáticamente después de 36 horas.", "Emily")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("La tira de papel es resistente al agua sólo moderadamente. Ducharse está bien, pero no bañarse ni nadar.", "Emily")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Durante ese tiempo, puede ir a inmigración y rehacer sus trámites, o sacar al niño de la ciudad lo antes posible. ¿Comprendido?", "Emily")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_medical","wry_smile",0.25)
	await novel_interface.show_dialog("¡O-está bien!\nGracias...", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("No lo menciones. Mi campamento está en el distrito exterior, justo al lado del centro de distribución de la organización de ayuda.", "Emily")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("Tal vez nos volvamos a encontrar en los próximos días ~", "Emily")
