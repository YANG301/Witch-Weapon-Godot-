# stardustdescends_ep03.gd - 星尘降临篇第3话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	stardustdescends_ep03_script()

func play_script():
	pass

func stardustdescends_ep03_script():
	novel_interface.change_music("res://assets/audio/music/Shop.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_NoxRoom.png")
	await novel_interface.show_text_only("Je m'assois au coin du lit luxueux de Nix et j'écoute son histoire.")
	novel_interface.show_character("nyx_full","normal1")
	await novel_interface.show_dialog("Ils changent mes gardes tous les six mois. Ces deux gars à l'extérieur viennent d'être transférés ici il y a moins de trois mois.", "Nix")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Vous dites aux gardes plus tard que vous accompagnerez personnellement Lian chez lui. J'ai déjà envoyé la voiture.", "Mariru")
	await novel_interface.show_dialog("Dès que ces gardes monteront dans la voiture, ils seront pris en charge.", "Mariru")
	novel_interface.show_character("nyx_full","sad")
	await novel_interface.show_dialog("Mais ils doivent se présenter régulièrement. Si nous ne voulons pas éveiller les soupçons, n’avons-nous pas besoin de leur coopération ?", "Nix")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Nix n'est apparemment pas convaincu par le plan d'évacuation actuel.")
	novel_interface.show_character("nyx_full","normal1")
	await novel_interface.show_dialog("Tous les gardes envoyés ici pour m'espionner ont reçu une formation anti-interrogatoire stricte de la part des agences de renseignement extérieures.", "Nix")
	novel_interface.change_expression("sad")
	await novel_interface.show_dialog("Je ne pense pas qu'ils coopéreront volontairement...", "Nix")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_full","upset")
	await novel_interface.show_dialog("L’agence de renseignement extérieur ?", "Lian")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_Commandments.png")
	await novel_interface.show_text_only("Oui. C'est également connu sous le nom de Sept Commandements. Lebona le dirige aujourd’hui, mais son origine provient des vieilles mafias européennes.")
	await novel_interface.show_text_only("L'agence est connue pour avoir réalisé des assassinats impossibles et pour son obsession pour les costumes noirs.")
	await novel_interface.show_text_only("Ce qui a vraiment rendu l'agence légendaire, cependant, c'est qu'il s'agit d'une organisation indépendante qui ne répond qu'au Credo de Lebona.")
	await novel_interface.show_text_only("Aucun gouvernement ne le contrôle, et grâce aux centaines de casinos qu’il gère dans le monde, il dispose d’un financement pratiquement illimité.")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_NoxRoom.png")
	novel_interface.show_character("ren_full","happy")
	await novel_interface.show_dialog("(Parlez de hardcore...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("J'ai atteint le niveau platine dans tous les jeux basés sur cette agence !")
	novel_interface.show_character("ren_full","gratified")
	await novel_interface.show_dialog("Donc, si nous devions mettre en œuvre le plan d'extraction en toute sécurité, nous devions non seulement sauver Nix, mais aussi le faire à leur insu.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Vous n'avez pas à vous en soucier.", "Mariru")
	await novel_interface.show_text_only("Mariru sourit fièrement.")
	await novel_interface.show_dialog("Nous avons toujours des plans spéciaux pour des cibles spéciales.", "Mariru")
	await novel_interface.show_text_only("Je ne peux m'empêcher d'imaginer Aya entourée d'outils de torture et s'amusant joyeusement...")
	await novel_interface.show_dialog("Un dernier chèque, vous deux. Alors c'est parti !", "Mariru")
	await novel_interface.show_text_only("Mariru est fini et sorti.")
	await novel_interface.show_text_only("Ce silence soudain me met mal à l’aise. Nix, de son côté, regarde toujours ma poitrine généreuse.")
	novel_interface.show_character("nyx_full","smile")
	await novel_interface.show_dialog("Ta voix... J'aurais presque été dupe.", "Nix")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Je baisse la tête, gênée.")
	novel_interface.show_character("ren_full","shy")
	await novel_interface.show_dialog("Euh... merci... ?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("De quoi parle-t-on, exactement ?")
	await novel_interface.show_text_only("Aya a parlé d'une mise à niveau. On dirait que ta voix est plus féminine maintenant.")
	novel_interface.show_character("ren_full","shy_right")
	await novel_interface.show_dialog("(Pourquoi a-t-elle même pris la peine de mettre à niveau quelque chose comme ça ?...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Nix s’approche soudainement, sa main droite tendue derrière mon dos.")
	novel_interface.show_character("ren_full","panic")
	await novel_interface.show_dialog("Que fais-tu...?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Je la sens tirer quelque chose sur mes vêtements et pousse instinctivement un petit soupir de soulagement...")
	novel_interface.show_character("ren_full","awkward")
	await novel_interface.show_dialog("!!!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ne me dis pas que c'est la boucle de ça...")
	await novel_interface.show_text_only("Avant même que je puisse comprendre ce qui vient de se passer, sa main se glisse dans mes vêtements... et sort mon soutien-gorge noir !!")
	novel_interface.show_character("ren_full","awkward")
	await novel_interface.show_dialog("...", "Lian")
	await novel_interface.show_dialog("...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("...")
	await novel_interface.show_text_only("Aaaaaaaah !")
	await novel_interface.show_text_only("Elle serre mon soutien-gorge ici et là pendant un certain temps, puis me regarde d'un air dubitatif après avoir échoué à trouver un dispositif de changement de voix.")
	await novel_interface.show_text_only("Le visage rouge betterave, je lui reprends mon soutien-gorge et me précipite vers la salle de bain.")
	novel_interface.show_character("nyx_full","smile")
	await novel_interface.show_dialog("Est-ce que ça va, Lian ? Votre estomac vous fait mal ?", "Nix")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("Si c'est cette période du mois, vous trouverez ce dont vous avez besoin dans l'armoire à pharmacie.", "Nix")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Nix semble vraiment inquiet.")
	novel_interface.show_character("ren_full","sob")
	await novel_interface.show_dialog("Ce n'est pas ça !!!", "Lian")
	await novel_interface.show_dialog("(Bouh-hoo !)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.hide_background_with_fade()
	await novel_interface.stop_music()
	await novel_interface.show_text_only("...")
	await novel_interface.show_text_only("Pendant ce temps... SID Salle de Commandement")
	novel_interface.change_music("res://assets/audio/music/Normal Stage.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	await novel_interface.show_text_only("Aya feuillette une pile de documents sur son bureau. Cinq fenêtres sont ouvertes, changeant rapidement sur le grand écran devant elle.")
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("Hé...", "Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aya se retourne et regarde la femme en uniforme.")
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Il y avait bien d'autres moyens d'obtenir des informations de ce rustre...", "Aya")
	await novel_interface.show_dialog("Pourquoi as-tu dû envoyer Lian ? Cela ne fait qu’augmenter le risque. N'as-tu pas peur qu'elle et Annie commencent à soupçonner quelque chose ?", "Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru vérifie les données sur son appareil mobile et sourit.")
	novel_interface.show_character("liliu_uniform1","normal2")
	await novel_interface.show_dialog("Lian est bien trop excitée pour soupçonner quoi que ce soit alors qu'elle est dans la chambre de Nix.", "Mariru")
	await novel_interface.show_dialog("D'ailleurs... C'était l'idée d'Annie au départ.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("Quoi ?", "Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal2")
	await novel_interface.show_dialog("Je suis sûr que tu t'en souviens.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Soya/Earthperspective.png")
	await novel_interface.show_dialog("Il y a environ deux semaines, après que Lian ait ramené Sonya de la zone de flux, où un flux spatio-temporel s'est produit à l'échelle mondiale et a duré environ 5 secondes.", "Mariru")
	await novel_interface.show_dialog("Le signal était fort mais n'a pas duré longtemps. Par conséquent, aucun pays n’a pu retracer sa source.", "Mariru")
	await novel_interface.show_dialog("L’histoire officielle est désormais qu’un sursaut gamma s’est produit près du système solaire.", "Mariru")
	await novel_interface.show_dialog("Même si c'est inventé, c'est vrai sur une chose : l'humanité était si proche de l'extinction.", "Mariru")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.show_character("liliu_uniform1","serious")
	await novel_interface.show_dialog("Mais le monde n’a pas pris fin. Nous devons donc nous assurer que personne ne relie New Opulentia à cet incident.", "Mariru")
	await novel_interface.show_dialog("Le SID a suivi tous les reportages et communications.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Jusqu’à présent, rien de solide n’a été trouvé, mais Annie a découvert quelque chose d’intéressant en explorant les réseaux sociaux.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Annie est devenue si bonne, hein ? Son instructeur a mentionné qu'elle travaillait également dur en entraînement physique.", "Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","sigh")
	await novel_interface.show_dialog("Elle a ses propres raisons, cette gamine.", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("Lian, cependant, c'est une toute autre histoire...", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru sort une liste de tous les jeux que Lian a terminés récemment.")
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("Quoi qu'il en soit, Annie a trouvé des dizaines de messages publiés le jour même où Lian a ramené Sonya. Ils viennent de personnes différentes qui ont fait le même rêve étrange pendant leurs siestes de l'après-midi.", "Mariru")
	await novel_interface.show_dialog("\"Je rêvais de tomber dans un abîme sombre et de rencontrer mes proches décédés.\"", "Mariru")
	await novel_interface.show_dialog("Aucune de ces personnes n’avait beaucoup de followers, leurs publications n’ont donc pas attiré beaucoup d’attention.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("Rêves pendant les siestes de l'après-midi...", "Aya")
	novel_interface.change_expression("think")
	await novel_interface.show_dialog("Attendez ! Le Flux Espace-Temps s'est produit vers 16 heures, heure New Opulentia !", "Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("Peu de gens font la sieste à ce moment-là, et moins nombreux sont ceux qui publient leurs rêves en ligne.", "Mariru")
	await novel_interface.show_dialog("Nous avons fait davantage d'analyses. Les adresses physiques de tous ces comptes se trouvent à l'intérieur de New Opulentia, dans un rayon de 8 kilomètres.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aya écoute, les yeux brillants.")
	novel_interface.show_character("liliu_uniform1","serious")
	await novel_interface.show_dialog("Et le centre de cette région est la villa de Nix.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","blush_dizzy")
	await novel_interface.show_dialog("Il se peut donc qu’il y ait vraiment quelque chose de spécial dans cette villa. Quand la Porte du Ciel s'est ouverte, cette chose a déclenché des rêves chez les gens qui dormaient ?", "Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aya a l'air excitée.")
	novel_interface.show_character("liliu_uniform1","normal2")
	await novel_interface.show_dialog("Comme je n'en étais pas sûr au début, j'ai demandé à Annie d'installer un capteur Boltzmann dans le système de sécurité de la villa.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("\"Je veux le voir.\" Aya vient rapidement vers Mariru, mais Mariru met sa main sur le visage d'Aya pour l'arrêter.")
	await novel_interface.show_text_only("La fille aux cheveux argentés, malheureusement, a les bras courts – elle ne peut pas atteindre Mariru, ses mains agitant en l'air.")
	novel_interface.show_character("ai","blush_dizzy")
	await novel_interface.show_dialog("\"Qu'est-ce que tu verras !\" (je veux le voir!)", "Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal2")
	await novel_interface.show_dialog("Je vous laisserai le voir après avoir récupéré le capteur. Maintenant, dépêchez-vous et terminez le devoir que le professeur Shih vous a confié !", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.stop_music()
	await novel_interface.show_text_only("Ensuite, Mariru sort de la salle de commandement, regardant les données satellite qu'elle reçoit sur son appareil.")
	await novel_interface.show_dialog("(Une explosion d'ondes radio basse fréquence s'est produite lorsque les fronts de Lian et Nix se sont touchés plus tôt.)", "Mariru")
	await novel_interface.show_dialog("Il présentait le même schéma que les ondes cérébrales humaines pendant le sommeil paradoxal...", "Mariru")
	novel_interface.show_background("res://assets/images/bg/Baizhu/snowfield.png")
	await novel_interface.show_text_only("Presque identique à ce qui s'est passé en Antarctique...")

	print("=== 星尘降临篇第3话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
