# stardustdescends_ep17.gd - 星尘降临篇第17话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	stardustdescends_ep17_script()

func play_script():
	pass

func stardustdescends_ep17_script():
	novel_interface.change_music("res://assets/audio/music/Sewer.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_SlumArea.png")
	await novel_interface.show_text_only("Ich tastete mich das düstere Treppenhaus hinunter und verließ das Gebäude in völliger Dunkelheit.")
	novel_interface.show_character("ren_medical","worry")
	await novel_interface.show_dialog("(Es ist so dunkel...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mein Anruf bei Emily wurde ohne Vorwarnung unterbrochen. Egal wie oft ich versuchte zurückzurufen, es kam keine Antwort.")
	await novel_interface.show_text_only("Ein ungutes Gefühl beschlich mich. Die Kriminalitätsrate in diesem Slum war bereits nachts exorbitant und ab und zu tauchten hier vermeintliche Extremisten auf ...")
	await novel_interface.show_text_only("Tante Haifa schaltete schnell das Licht im Flur und in allen Zimmern aus. Zum Glück schliefen die Kinder schon.")
	await novel_interface.show_text_only("Als sie langsam die schwere Metalltür des Waisenhauses schloss, stieg plötzlich eine Welle der Angst in meiner Brust auf –")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Wenn ich hier bliebe, würde ich Emily und die anderen vielleicht nie wieder sehen ...")
	await novel_interface.show_text_only("Ich weiß nicht, woher der Impuls kam, aber bevor sich die Tür schloss, stürmte ich hinaus, hinterließ ein kurzes „Ich schau mal nach“ und rannte die Treppe hinunter.")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_SlumArea.png")
	await novel_interface.show_text_only("...")
	novel_interface.show_character("ren_medical","wry_smile")
	await novel_interface.show_dialog("(Warum bin ich so rücksichtslos hierher gestürmt...?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("In Masada herrscht zwar ein mildes mediterranes Klima, aber der Nachtwind fühlte sich immer noch kühl auf meinen Haaren an, die noch nicht vollständig getrocknet waren.")
	await novel_interface.show_text_only("Das im Hof geparkte gepanzerte Fahrzeug hatte sowohl die Innen- als auch die Außenbeleuchtung ausgeschaltet, aber ich bemerkte, dass die Heckklappe nur halb geschlossen war.")
	await novel_interface.show_text_only("Mit angehaltenem Atem kroch ich zum Heck des Fahrzeugs und öffnete die Luke gerade so weit, dass ich meinen Kopf hineinstecken konnte.")
	await novel_interface.show_text_only("Ich starrte in die pechschwarze Kabine und schaltete die Taschenlampe meines Telefons ein –")
	await novel_interface.show_text_only("Plötzlich tauchte das auf dem Kopf stehende Gesicht eines Mannes auf! Schaum hing aus seinem Mundwinkel und seine leblosen Pupillen starrten mich direkt an!")
	await novel_interface.show_text_only("Ich sprang reflexartig zurück wie ein aufgescheuchtes Reh und mein Handy flog mir aus der Hand.")
	await novel_interface.show_text_only("Noch bevor meine Füße den Boden berührten, packte mich ein Arm von hinten, während eine andere Hand meinen Mund fest umklammerte.")
	novel_interface.show_character("ren_medical","sob")
	await novel_interface.show_dialog("(Mmmph--!)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ich beobachtete, wie mein Telefon durch die Luft flog, nur dass Emily es mit einer Hand auffing, bevor es auf dem Boden aufschlug, und die Taschenlampe sanft ausschaltete.")
	novel_interface.show_character("emilio","smile")
	await novel_interface.show_dialog("(flüstert) Pssst! Wir sind es.", "Emily")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sie tätschelte hilflos mein verängstigtes Gesicht und wischte beiläufig die Tränen weg, die mir gerade aus den Augenwinkeln gestiegen waren.")
	novel_interface.show_character("valkyrja","happy")
	await novel_interface.show_dialog("Bist du gerade aus der Dusche gekommen?\n(schnüffeln schnüffeln) Du riechst ziemlich gut~", "Vera")
	novel_interface.change_expression("wink")
	await novel_interface.show_dialog("Mach keinen Ton, verstanden?", "Vera")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Veras neckende Stimme erklang hinter mir. Erst als sie mich gehorsam nicken sah, ließ sie los.")
	novel_interface.show_character("emilio","stare")
	await novel_interface.show_dialog("(flüstert) Schauen Sie nach draußen.", "Emily")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ich folgte der Richtung, die sie mir zeigte, und spähte durch die Lücke im Hoftor auf die Straße draußen –")
	await novel_interface.show_text_only("Nachdem sich meine Augen an die Dunkelheit gewöhnt hatten, bemerkte ich schnell, dass Schatten auf der Straße raschelten.")
	novel_interface.show_character("emilio","stare")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_medical","stare",0.25)
	await novel_interface.show_dialog("(Sind das Diebe...? Nein, es gibt viel zu viele davon.)", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Direkt in meinem Sichtfeld befanden sich vier oder fünf Männer in Schwarz, die zwei alte Lieferwagen umkreisten, die sich unnatürlich langsam bewegten.")
	await novel_interface.show_text_only("Die Transporter hatten keine Scheinwerfer und sogar die Bremslichter waren entfernt worden. Die Fahrer hielten die Motoren so leise wie möglich.")
	await novel_interface.show_text_only("Kurz nachdem dieser verdächtige Konvoi vorbeigefahren war, tauchte von hinten ein anderes Team mit genau der gleichen Aufstellung auf.")
	await novel_interface.show_text_only("In der Ferne stolperte ein Obdachloser mit einer Schnapsflasche aus einer Hütte an der Straßenecke, rülpste und starrte ausdruckslos auf die dunkle Straße.")
	await novel_interface.show_text_only("Einer der schwarz gekleideten Männer ging auf den Betrunkenen zu, brach ihm ohne zu zögern das Genick und zerrte die Leiche schnell in den Schatten am Straßenrand.")
	novel_interface.show_character("emilio","stare")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("ren_medical","panic",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("--?!!", "Lian")
	await novel_interface.show_dialog("Wer sind diese Leute...?", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Das ist bereits die sechste Mannschaft, die wir gesehen haben. Ich habe mir gerade heimlich einen geschnappt, aber bevor ich ihn befragen konnte, biss er auf Gift und tötete sich.", "Emily")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Emily zeigte auf das gepanzerte Fahrzeug und meinte damit wahrscheinlich den Mann, den ich gerade mit Schaum vor dem Mund gesehen hatte.")
	novel_interface.show_character("emilio","stare")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("ren_medical","panic",0.25)
	await novel_interface.show_dialog("In seiner Kleidung steckte eine schwarze Fahne mit religiösen Parolen. Normalerweise tun das nur Extremisten, die Selbstmordanschläge verüben ...", "Emily")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Emily runzelte tief die Stirn. Die Situation war eindeutig weit über das hinausgegangen, was sie erwartet hatte.")
	novel_interface.show_character("ren_medical","panic")
	await novel_interface.show_dialog("S-Selbstmordattentat?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ich hatte diesen Begriff bisher nur in Filmen und ausländischen Nachrichten gesehen. Ich habe noch nie gehört, dass so viele Leute auf einmal auftauchen!")
	novel_interface.show_character("ren_medical","panic")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("emilio","stare",0.25)
	await novel_interface.show_dialog("Diese Fahrzeuge haben weder Kennzeichen noch Bremslichter und können sich daher nur innerhalb der Slums bewegen, die tote Winkel im Überwachungsnetzwerk sind. Überall sonst würden Drohnen sie fast sofort abfangen.", "Emily")
	await novel_interface.show_dialog("Die National Defense Force führt hier auch tagsüber zufällige Patrouillen durch, daher glaube ich nicht, dass diese Fahrzeuge jemals dafür gedacht waren, unversehrt wieder herauszukommen ...", "Emily")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0)
	await novel_interface.show_dialog("Y-Du meinst--", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("emilio","angry")
	await novel_interface.show_dialog("Ein beispiellos großer Selbstmordanschlag, der höchstwahrscheinlich in den nächsten Stunden passieren wird.", "Emily")
	await novel_interface.hide_character()
	novel_interface.show_character("valkyrja","speak")
	await novel_interface.show_dialog("Die Tatsache, dass sie so nahe an der Innenstadt sind, bedeutet, dass die Fahrzeuge kein radioaktives Material transportieren ...", "Vera")
	await novel_interface.show_dialog("Unter den Straßen rund um Masada sind kilometerweit Detektoren für radioaktives Material vergraben.", "Vera")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Aber wenn es nur ein Autobombenanschlag wäre, würden sie dann wirklich so viele Leute brauchen?", "Vera")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","sob")
	await novel_interface.show_dialog("S-Sollten wir das zuerst melden?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("emilio","stare")
	await novel_interface.show_dialog("Die elektromagnetischen Signale in der Nähe werden derzeit alle gestört. Ich habe gerade einen Notfallcode von einer öffentlichen Telefonzelle gesendet.", "Emily")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Gibt es hier noch so alte Sachen?")
	novel_interface.show_character("emilio","stare")
	await novel_interface.show_dialog("Der Widerstand setzt an der Front kaum Störgeräte ein. Ich habe keine Ahnung, wer diese Leute sind...", "Emily")
	await novel_interface.hide_character()
	novel_interface.show_character("valkyrja","angry")
	await novel_interface.show_dialog("Selbst wenn die Armee und Monola herbeistürmen, werden sie mindestens zehn Minuten brauchen. Bis dahin werden diese Leute längst verschwunden sein.", "Vera")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","stare")
	await novel_interface.show_dialog("Sollten wir ihnen dann ruhig folgen?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("emilio","speechless")
	await novel_interface.show_dialog("Das wird nicht helfen. Da sie in Gruppen operieren, werden sie sich auf jeden Fall aufteilen und getrennt verstecken.", "Emily")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Richtig. Dieser Slum ist bereits eine Enklave ethnischer Minderheiten, und die örtlichen Banden, die verschiedene Sprachen sprechen, sind alle in völligem Chaos vermischt.")
	await novel_interface.show_text_only("Nicht nur ist die Infrastruktur stark beschädigt, es gibt auch viele versteckte Zonen, die durch illegale Bauten geschaffen wurden und auf keiner Planungskarte erscheinen.")
	await novel_interface.show_text_only("Die Regierung von Masada äußerte sich immer uneindeutig über das Chaos hier. Der Staatshaushalt ist ohnehin seit Jahren knapp bemessen, so dass man nicht die Kraft hatte, diese Mülldeponie zu säubern.")
	novel_interface.show_character("ren_medical","worry")
	await novel_interface.show_dialog("Könnte das etwas mit dem morgigen Waffenstillstandsabkommen zu tun haben?", "Lian")
	novel_interface.change_expression("wry_smile")
	await novel_interface.show_dialog("Li... ich meine, mein Vorgesetzter hat morgen eine Art Unterzeichnungszeremonie erwähnt.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("emilio","shout")
	await novel_interface.show_dialog("Ach! Um wie viel Uhr findet die Zeremonie morgen statt?", "Emily")
	await novel_interface.hide_character()
	novel_interface.show_character("valkyrja","panic")
	await novel_interface.show_dialog("Wenn ich mich recht erinnere, stand in der internen Bekanntmachung, dass es auf sechs Uhr morgens verschoben wurde. Da viele Medien anwesend sein werden, wollten sie den Sandsturm für die Aufnahmen so weit wie möglich vermeiden.", "Vera")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Unser unterzeichnender Vertreter ist Generalmajor Hamon. In Interviews sagte er sogar, dass er zur Zeremonie einen Anzug statt einer Uniform tragen würde.", "Vera")
	novel_interface.change_expression("speechless")
	await novel_interface.show_dialog("Diese große Kröte könnte genauso gut einfach verkünden, dass sie bei den Wahlen im nächsten Jahr antritt. Seine Ambitionen könnten nicht offensichtlicher sein ...", "Vera")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","wry_smile")
	await novel_interface.show_dialog("(...Kröte?)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("emilio","stare")
	await novel_interface.show_dialog("Warte... wenn es Hamon ist...", "Emily")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Emily schien den Generalmajor sehr gut zu kennen. Sie runzelte die Stirn und dachte angestrengt nach.")
	novel_interface.show_character("emilio","stare")
	await novel_interface.show_dialog("Wenn Hamon tatsächlich vorhat, für das Amt des Premierministers zu kandidieren, würde er aufgrund seiner Persönlichkeit wahrscheinlich denken, dass eine bloße Unterschrift und ein Händedruck viel zu schwach sind.", "Emily")
	novel_interface.change_expression("shout")
	await novel_interface.show_dialog("Wenn er möchte, dass die Medien die Veränderungen, die der Waffenstillstand mit sich bringt, direkter sehen, wird er meiner Meinung nach gleichzeitig die elektronischen Protokolle der KI-Verteidigungswaffen aktualisieren.", "Emily")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","bored")
	await novel_interface.show_dialog("Was meinst du...?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("emilio","shout")
	await novel_interface.show_dialog("Wenn die linken Medien vor Ort miterleben würden, wie die Drohnenschwärme, die Masada das ganze Jahr über umkreisen, entwaffnet werden und zurücktreten, würden sie wahrscheinlich sofort in Tränen ausbrechen.", "Emily")
	await novel_interface.hide_character()
	novel_interface.show_character("valkyrja","wink")
	await novel_interface.show_dialog("Pfft--\nJa, das kann ich sehen.", "Vera")
	novel_interface.change_expression("panic")
	await novel_interface.show_dialog("Warten Sie ... Sie sagen, dass diese Leute einen Angriff planen, während Masadas Verteidigungssystem ein einheitliches Protokoll-Update durchführt!?", "Vera")
	await novel_interface.hide_character()
	novel_interface.show_character("emilio","stare")
	await novel_interface.show_dialog("Achtzig Prozent der Verteidigungsanlagen Masadas basieren auf KI-Waffen. Das System wäre nicht dumm genug, alles auf einmal offline zu nehmen.", "Emily")
	await novel_interface.show_dialog("Eine solche große Protokollaktualisierung würde stapelweise nach Verteidigungssektor erfolgen ...", "Emily")
	novel_interface.change_expression("shout")
	await novel_interface.show_dialog("Richtig. Wo genau findet morgen die Unterzeichnungszeremonie statt?", "Emily")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","panic")
	await novel_interface.show_dialog("Äh, ich glaube, es ist ein Kongresszentrum am Toten Meer.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Ich erinnerte mich, dass Mariru es gerade am Telefon erwähnt hatte –")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_ShelterOffice.png")
	await novel_interface.show_dialog("Sie haben den Masada-Vertreter für die morgige Unterzeichnung des Waffenstillstands festgelegt. Es wird Generalmajor Hamon vom Nordkommando sein.", "Mariru")
	await novel_interface.show_dialog("Und aus politischen Gründen wurde als Unterzeichnungsort das Masada International Convention Center am Toten Meer ausgewählt.", "Mariru")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_SlumArea.png")
	novel_interface.show_character("valkyrja","speak")
	await novel_interface.show_dialog("Masada International Convention Center?\nDas ist nicht weit von hier...", "Vera")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","solemn")
	await novel_interface.show_dialog("Planen sie, den Veranstaltungsort direkt anzugreifen?!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("valkyrja","speechless")
	await novel_interface.show_dialog("Sei nicht lächerlich. Der Bereich rund um den Veranstaltungsort wird auf jeden Fall unter strenger Monola-Überwachung stehen und die National Defense Force wird überall schwere Waffen im Einsatz haben.", "Vera")
	await novel_interface.show_dialog("Würden diese Leute es wagen, sich auf den Weg zum Kongresszentrum zu machen, würden sie fünf Kilometer entfernt entdeckt und sofort ausgelöscht.", "Vera")
	await novel_interface.hide_character()
	novel_interface.show_character("emilio","stare")
	await novel_interface.show_dialog("Ich erinnere mich, wo sich das Kongresszentrum auf der Karte befindet. Wenn ich in dieser Halle stünde...", "Emily")
	await novel_interface.show_dialog("Die nächste Isolationsmauer, die ich sehen könnte, wäre das Stück vor uns, oder?", "Emily")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ich folgte Emilys Geste und schaute in diese Richtung. Die Straße, die sich in der Ferne erstreckte, schien durch die hoch aufragende Isolationsmauer fast durchtrennt zu sein –")
	await novel_interface.show_text_only("Dahinter drangen schwache Schimmer der geschäftigen Innenstadt durch ...")
	novel_interface.show_character("emilio","stare")
	await novel_interface.show_dialog("Das ist die nordöstliche Isolationsmauer der Innenstadt. Wenn der Veranstaltungsort nicht ihr eigentliches Ziel ist ...", "Emily")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Emily und Vera verstummten beide. An ihren Gesichtsausdrücken konnte ich erkennen, wie schlimm die Situation war.")
	await novel_interface.show_text_only("Ich schaute zum dunklen Himmel hinauf. Es gab keinen einzigen Stern.")
	novel_interface.show_character("ren_medical","worry")
	await novel_interface.show_dialog("(War der Himmel... immer so dunkel?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Damals stieg in mir ein unheimliches und bedrohliches Gefühl auf, das ich nicht in Worte fassen konnte.")
	await novel_interface.show_text_only("Aber ich hatte damals keine Ahnung, dass sich die Dinge so entwickeln würden ...")
	await novel_interface.stop_music()
	await novel_interface.show_text_only("...")
	await novel_interface.show_text_only("Zur gleichen Zeit in der Fünften Schulstadt.")
	novel_interface.change_music("res://assets/audio/music/Shop.mp3")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_bar.png")
	await novel_interface.show_text_only("Die sanfte Hintergrundmusik lief weiter, während Professor Shih auf dem Sofa saß und sich vor Schmerzen den Kopf umklammerte.")
	novel_interface.show_character("liliu_uniform1","normal2")
	await novel_interface.show_dialog("Du bist wach?", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru stellte Professor Shih einen Drink hin und setzte sich langsam in den Sessel ihm gegenüber.")
	novel_interface.show_character("liliu_uniform1","normal2")
	await novel_interface.show_dialog("Es ist Elektrolytwasser. Es wird gegen die Kopfschmerzen helfen.", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("shi","eyeclose",0.25)
	await novel_interface.show_dialog("Ich...", "Professor Shih")
	novel_interface.change_2nd_expression("normal")
	await novel_interface.show_dialog("Ich habe das Gefühl... Ich kenne dich?", "Professor Shih")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru war innerlich erschrocken, aber auf ihrem Gesicht war davon keine Spur zu erkennen.")
	await novel_interface.show_text_only("Sie hatte vorgehabt, die Informationen, die sie gerade über das schwarze NASA-Projekt erhalten hatte, mit Professor Shih abzugleichen, aber seine Reaktion brachte ihr stattdessen etwas Unerwartetes.")
	novel_interface.show_character("liliu_uniform1","normal1")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("shi","normal",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("(Keines der vorherigen Verhöre hinterließ bei ihm Erinnerungen. Konnte die letzte Löschung der Erinnerungen nicht abgeschlossen werden?)", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Woran... erinnerst du dich?", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"eyeclose")
	await novel_interface.show_dialog("N-Nein... ich glaube, ich habe dich in einem Traum gesehen... Ich-ich kann mich auch nicht genau erinnern.", "Professor Shih")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Es ist Elektrolytwasser. Es wird gegen die Kopfschmerzen helfen.", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru schob Professor Shih das blassgelbe Getränk hin. Es war die „Sicherheitsmaßnahme“, die Aya entworfen hatte.")
	await novel_interface.show_text_only("Solange die Flüssigkeit im Becher verbraucht war, wurde die Verbindung zwischen Vernehmer und Versuchsperson automatisch unterbrochen.")
	await novel_interface.show_text_only("Unter normalen Umständen widersetzte sich die Versuchsperson, wenn sie das Elektrolytwasser sah, instinktiv dagegen, als würde das Trinken bedeuten, zuzugeben, dass etwas mit ihr nicht stimmte.")
	await novel_interface.show_text_only("Sobald der Geisteszustand der Versuchsperson jedoch instabil wurde, neigte sie eher dazu, das Wasser zu trinken, um sich zu beruhigen.")
	await novel_interface.show_text_only("Professor Shih starrte lange auf die Tasse, bevor er schließlich zu sprechen begann:")
	novel_interface.stop_music()
	novel_interface.show_character("shi","eyeclose")
	await novel_interface.show_dialog("Es gab eine Zeit, in der meine Tochter wiederholt unter Schlaflosigkeit litt. Während eines Telefonats erzählte sie mir von einem Gedankenexperiment ...", "Professor Shih")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Ihre Frage war: Warum ist die Apokalypse noch nicht gekommen?", "Professor Shih")
