# stardustdescends_ep19.gd - 星尘陨落篇第19话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	stardustdescends_ep19_script()

func play_script():
	pass

func stardustdescends_ep19_script():
	novel_interface.change_music("res://assets/audio/music/Witch's Confession.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_Recording.png")
	await novel_interface.show_dialog("Con gái tôi, Nasha, năm nay lên bảy, và dạo gần đây con bé rất thích lôi tôi vào chơi xếp hình cùng.", "Bản ghi")
	await novel_interface.show_dialog("Đôi khi tôi cố ý làm ra vẻ miễn cưỡng hoặc bận rộn, rồi chỉ \"miễn cưỡng\" đồng ý sau khi đã nhìn nó năn nỉ mình một lúc lâu.", "Bản ghi")
	await novel_interface.show_dialog("Thật ra tôi cũng rất thích chơi với con bé... nhưng cái cách Nasha làm nũng quả thật đáng yêu quá mức.", "Bản ghi")
	await novel_interface.show_text_only("Một tràng cười lớn của khán giả vọng ra từ đoạn ghi âm.")
	await novel_interface.show_dialog("Bộ ghép hình chúng tôi chơi là một kiểu hoàn toàn mới, rất khác với những bộ tôi từng có hồi nhỏ--", "Bản ghi")
	await novel_interface.show_dialog("Mỗi mảnh đều có một màn hình e-ink màu ở một mặt, hiển thị hình ảnh tĩnh, nên thoạt nhìn nó gần như không khác gì một bộ ghép hình truyền thống.", "Bản ghi")
	await novel_interface.show_dialog("Nhưng khi bạn dần hoàn thiện nó và đặt mảnh cuối cùng vào, từng mảnh ghép đều sáng lên, còn hình ảnh trên bộ ghép hình thì bắt đầu chuyển động...", "Bản ghi")
	await novel_interface.show_dialog("Tôi vẫn nhớ rất rõ lần đầu tiên nhìn thấy nó. Ban đầu, tôi tưởng chúng tôi đang ghép bức ảnh Trái Đất nổi tiếng mang tên \"Blue Marble\"--", "Bản ghi")
	await novel_interface.show_dialog("Nhưng khi con gái tôi đặt mảnh cuối cùng, toàn bộ hình ảnh bắt đầu chuyển động: camera lùi lại, đi qua Mặt trăng, Sao Hỏa, Sao Mộc...", "Bản ghi")
	await novel_interface.show_dialog("Sau đó, nó bay ra khỏi hệ mặt trời, vượt ra ngoài vô số ngôi sao và cuối cùng lộ ra toàn bộ Dải Ngân hà.", "Bản ghi")
	await novel_interface.show_dialog("Nasha hưng phấn nhảy lên, vừa hét lên vừa lắc lắc cánh tay tôi, giống như lần đầu tiên tôi hoàn thành thí nghiệm bẻ cong ánh sáng vật chất dị thể...", "Bản ghi")
	await novel_interface.show_dialog("Tôi tin rằng mọi người ở đây đều đã từng trải qua khoảnh khắc như thế.", "Bản ghi")
	await novel_interface.show_dialog("Ngày hôm đó, tôi chạy ra khỏi phòng thí nghiệm với đôi dép và quần pyjama, la hét suốt chặng đường vào văn phòng của một giáo sư vi sinh tại trường đại học của chúng tôi.", "Bản ghi")
	await novel_interface.show_dialog("Ông già đã từng nói với tôi rằng nếu tôi có thể thành công trong thí nghiệm này, ông ấy sẽ mở chai rượu sake Nhật Bản đắt tiền mà học trò của ông ấy đã tặng ông ấy...", "Bản ghi")
	await novel_interface.show_dialog("Thứ rượu đó làm tôi suýt chết. Tôi vẫn không thể tin rằng nó được bán với giá cao như vậy.", "Bản ghi")
	await novel_interface.show_text_only("Khán giả bật cười, và một số người trong số họ vỗ tay.")
	await novel_interface.show_dialog("Sau này, tôi dần dần hiểu rằng quá trình nghiên cứu vật chất không đồng nhất thực sự rất giống với việc giải một câu đố.", "Bản ghi")
	await novel_interface.show_dialog("Trước khi câu đố cuối cùng được giải, tất cả những gì bạn có thể làm là thử mọi thứ dựa trên trực giác và một số manh mối.", "Bản ghi")
	await novel_interface.show_dialog("Nó giống như việc giải một câu đố: đầu tiên bạn tìm bốn góc và dùng chúng làm tiên đề, làm điểm tựa logic.", "Bản ghi")
	await novel_interface.show_dialog("Sau đó, bắt đầu từ các góc, bạn làm mọi cách để đóng khung.", "Bản ghi")
	await novel_interface.show_dialog("Cũng giống như bạn bắt đầu với những tiên đề cơ bản nhất và dần dần rút ra những kết luận nhất quán về mặt logic.", "Bản ghi")
	await novel_interface.show_dialog("Sau đó, trong khuôn khổ đã hoàn thiện đó, bạn tiếp tục thử và sai, từng bước tiến về phía lõi chưa biết...", "Bản ghi")
	await novel_interface.show_dialog("Quá trình này kéo dài và mệt mỏi, và chỉ khi mảnh ghép cuối cùng đã hoàn thành, chúng ta mới có thể thoáng nhìn thấy sự thật của thế giới.", "Bản ghi")
	await novel_interface.show_dialog("Trong thời gian đó, bạn có thể để trí tưởng tượng của mình bay bổng với dự đoán, tự hỏi cuối cùng bạn sẽ nhìn thấy loại bức tranh toàn cảnh tuyệt đẹp nào.", "Bản ghi")
	await novel_interface.show_dialog("Tôi tin rằng đó là phần hấp dẫn nhất của nghiên cứu khoa học và là lý do khiến hầu hết chúng ta kiên trì!", "Bản ghi")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Bấm--")
	await novel_interface.stop_music()
	await novel_interface.show_text_only("Ngay khi tiếng vỗ tay của khán giả sắp tăng lên thì đoạn ghi âm đột ngột bị cắt.")
	novel_interface.change_music("res://assets/audio/music/Normal Stage.mp3")
	novel_interface.show_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("Đây là đoạn ghi âm Mariru tìm thấy trên máy tính của một nhà nghiên cứu đã qua đời.", "Aya")
	novel_interface.change_expression("wink")
	await novel_interface.show_dialog("Người ta cho rằng đó là một phần trong bài nói chuyện riêng mà Mushar đưa ra tại Hội nghị Solvay lần thứ 30 cách đây hơn một thập kỷ~", "Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("akiko","shock")
	await novel_interface.show_dialog("Người đang nói là... Walid Mushar?", "Akiko")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Akiko hơi ngạc nhiên. Trong một khoảnh khắc, cô không thể kết nối giọng nói tinh tế, dễ chịu đó với tên thủ lĩnh khủng bố tàn nhẫn.")
	novel_interface.show_character("akiko","normal")
	await novel_interface.show_dialog("Hội nghị Solvay lần thứ 30... diễn ra vào năm 2026, phải không?", "Akiko")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Hội nghị học thuật này do nhà công nghiệp người Bỉ Ernest Solvay thành lập, đã mời các nhà khoa học hàng đầu thế giới vào thời điểm đó tham dự mỗi phiên họp.")
	await novel_interface.show_text_only("Nó được tổ chức ba năm một lần, và mặc dù chiến tranh và bất ổn chính trị đã khiến nó bị đình chỉ nhiều lần nhưng nó vẫn tiếp tục cho đến ngày nay.")
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("Đúng vậy, một năm trước khi chiến tranh bắt đầu...", "Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Hồi đó, Mushar không thể tưởng tượng được rằng vài tháng sau bài phát biểu đó, vợ và con gái ông lại nằm chết trên đường vì nạn đổ máu mù quáng giữa các dân tộc.")
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("Vào thời điểm đó, các điều ước quốc tế cấm nghiên cứu các vấn đề không đồng nhất, vì vậy các cuộc thảo luận tại các hội nghị học thuật như thế này chỉ có thể được tổ chức riêng tư.", "Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("Nhưng năm sau, mọi quốc gia đều xé bỏ chiếc mặt nạ đó và hầu hết những người tham dự hội nghị đó đều không còn sống nữa…", "Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Một thoáng u sầu thoáng qua trên khuôn mặt Aya, nhưng cô nhanh chóng trở lại như thường lệ.")
	await novel_interface.show_text_only("Cô ấy xem các bản tin trực tiếp từ hàng chục nền tảng truyền thông khác nhau trên màn hình lớn, và không có ngoại lệ, tất cả đều đang chiếu buổi lễ ký kết của Masada--")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_SigningCeremony.png")
	await novel_interface.show_text_only("Mọi thứ dường như đang diễn ra suôn sẻ, không có báo cáo nào về vụ nổ mà Emily đã gây ra gần địa điểm trước đó.")
	await novel_interface.show_text_only("Sau khi quá trình ký tài liệu kéo dài hoàn tất, Masadan và các đại diện của phe kháng chiến cùng nhau bước đi và ấn lòng bàn tay lên màn hình.")
	await novel_interface.show_text_only("Dấu tay của họ, cùng với văn bản thỏa thuận, đã được tải lên trực tuyến theo thời gian thực và hệ thống phòng thủ của thành phố Masada ngay lập tức bắt đầu cập nhật giao thức phòng thủ của mình.")
	await novel_interface.show_text_only("Đồng thời, phe kháng chiến đã tự nguyện gửi các tập tin kỹ thuật số cho hơn hai trăm nghìn thành viên ủng hộ thỏa thuận ngừng bắn.")
	await novel_interface.show_text_only("Từ giờ trở đi, chỉ cần những người đó hạ vũ khí, họ sẽ được tự do ra vào hầu hết các khu vực của Masada như những công dân bình thường.")
	await novel_interface.show_text_only("Cái giá phải trả là họ phải đeo vòng tay theo dõi trong hai năm và bị đặt dưới hệ thống giám sát của Monola.")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_SigningCeremony1.png")
	await novel_interface.show_text_only("Kết thúc buổi lễ, hai đại diện sẽ trao đổi tài liệu và bắt tay trước giới truyền thông.")
	await novel_interface.show_text_only("Thiếu tướng Lực lượng Phòng vệ và thủ lĩnh kháng chiến đã bắt tay nhau trước ống kính suốt ba phút.")
	await novel_interface.show_text_only("Nụ cười toe toét quá mức của Hamon gần như đông cứng trên khuôn mặt anh ta, trong khi Mushar chỉ giữ nụ cười điềm tĩnh.")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	await novel_interface.show_text_only("Aya nhìn cái miệng há hốc trên màn hình, rồi liếc nhìn thông tin cô thu thập được về người đàn ông trên mạng xã hội ngày hôm qua.")
	novel_interface.show_character("ai","dizzy")
	await novel_interface.show_dialog("Hamon, huh...\nThảo nào quân đội đặt biệt danh cho anh ấy là \"Cóc\"~", "Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Thấy Mariru vẫn chưa quay lại, Akiko tháo kính ra và thở vào tròng kính một cách tự nhiên.")
	await novel_interface.show_text_only("Khi cô lau chúng, một lọn tóc bị vướng vào thái dương trượt xuống tóc mai của cô, và vẻ mặt cũng như phong thái của cô ngay lập tức trở nên giống người khác—")
	novel_interface.show_character("akikounglass")
	await novel_interface.show_dialog("Anh chàng này là người mang tiêu chuẩn của phe diều hâu trong Lực lượng Phòng vệ của Masada.", "Akiko")
	await novel_interface.show_dialog("Những người ủng hộ ông ca ngợi ông như một anh hùng bảo vệ đất nước. Đối thủ của anh gọi anh là đồ tể đẫm máu...", "Akiko")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aya nhận thấy sự thay đổi trong giọng điệu của Akiko và nhìn chằm chằm vào hình ảnh video của cô ấy với sự tò mò không giấu được.")
	await novel_interface.show_text_only("Akiko dường như không quan tâm và tiếp tục hồi tưởng.")
	novel_interface.show_character("akikounglass")
	await novel_interface.show_dialog("Hồi đó, Hamon đi theo chú của mình, Thủ tướng Schneiderman, lúc đó là trung tướng trong Quân đội Phục hồi, và chiến đấu trong Phòng thủ Masada.", "Akiko")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("Nơi mà họ xoay chuyển tình thế với \"Phantom Force\" sau khi hết đạn dược và vật tư?", "Aya")
	await novel_interface.show_dialog("Điều đó chắc chắn đủ điều kiện để anh ta tranh cử...", "Aya")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("Có vẻ như mọi sĩ quan cấp cao đã tham gia trận chiến đó và vẫn còn sống hiện đều nắm giữ một chức vụ quan trọng trong quân đội hoặc chính phủ~", "Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aya, người thường không quan tâm đến chính trị, đã đưa ra nhận định của riêng mình dựa trên thông tin cô thu thập và sắp xếp bằng AI tối qua.")
	novel_interface.show_character("akikounglass")
	await novel_interface.show_dialog("Ít hơn mười sĩ quan đó vẫn còn sống, và mỗi người trong số họ đều là một anh hùng chiến tranh, người cũng biết những bí mật cốt lõi của đất nước...", "Akiko")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("Sự thật về \"Phantom Force,\" huh... Họ chắc chắn đã bảo vệ bí mật đó rất tốt.", "Aya")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Nhưng còn có những lý do khác khiến Hamon nhận được nhiều sự ủng hộ như vậy phải không? Tôi nghe nói Lực lượng Phòng vệ đã phá sản từ lâu nếu không có sự quản lý hiệu quả của anh ấy...", "Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("akikounglass")
	await novel_interface.show_dialog("Quản lý?\n Gọi nó là cướp bóc.", "Akiko")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Akiko không hề cố gắng che giấu sự khinh thường của mình đối với anh.")
	novel_interface.show_character("akikounglass")
	await novel_interface.show_dialog("Bên cạnh việc tuân thủ luật pháp quốc tế ở mọi vùng xám có thể, ông ta còn thực thi sự phân biệt chủng tộc trong khu quân sự và mở rộng đáng kể quyền sử dụng vũ khí không người lái...", "Akiko")
	await novel_interface.show_dialog("Các quan chức tình báo của Palantir đánh giá rằng nếu người đàn ông này nắm quyền, điều đầu tiên ông ta sẽ làm là thúc đẩy Đạo luật Dân tộc Quốc gia.", "Akiko")
	await novel_interface.show_dialog("Dù sao thì Grand Rabbi cũng đã bày tỏ rõ ràng sự ủng hộ của mình đối với Hamon rồi...", "Akiko")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aya không biết phải trả lời thế nào trước chủ đề chính trị cao cấp này, nên cô lặng lẽ tìm kiếm \"Đạo luật dân tộc quốc gia\".")
	await novel_interface.show_text_only("Một loạt các từ khóa như \"phân biệt chủng tộc\" xuất hiện bên dưới.")
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("(Con người thật là nhàm chán...)", "Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("akikounglass")
	await novel_interface.show_dialog("Nhân tiện, tại sao Mariru vẫn chưa quay lại...\nThức uống đó thực sự ổn, phải không?", "Akiko")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Hãy thư giãn, người phụ nữ đó thật cứng rắn--", "Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aya mở chai nước tăng lực mới và uống một ngụm. Cô ấy trông tỉnh táo hơn nhiều ngay lập tức.")
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("Có lẽ lúc này cô ấy đang cúi mình trong nhà vệ sinh và suy nghĩ...", "Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("akikounglass")
	await novel_interface.show_dialog("...Đang nghĩ cách xử tử ngươi?", "Akiko")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","blush_dizzy")
	await novel_interface.show_dialog("Nghĩ về kế hoạch của Famur~!!", "Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ngay cả sau khi thu thập được hàng núi thông tin, Aya vẫn không biết cuộc tấn công sắp tới của quân kháng chiến sẽ diễn ra theo hình thức nào.")
