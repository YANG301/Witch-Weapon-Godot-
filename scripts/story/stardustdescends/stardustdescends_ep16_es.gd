# stardustdescends_ep16.gd - 星尘降临篇第16话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	stardustdescends_ep16_script()

func play_script():
	pass

func stardustdescends_ep16_script():
	novel_interface.change_music("res://assets/audio/music/Sunset.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_ShelterOffice.png")
	novel_interface.show_character("ren_medical","gratified")
	await novel_interface.show_dialog("¿Cuántos hijos tienes aquí?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Le pregunté a tía Haifa, que se había puesto a pensar.")
	await novel_interface.show_dialog("Treinta y dos. Todos son huérfanos del asentamiento, ninguno mayor de diez años.", "Haifa")
	await novel_interface.show_dialog("Esto es todo lo que puedo hacer, y aun así necesito que los trabajadores sociales me ayuden durante el día... suspiro...", "Haifa")
	await novel_interface.show_dialog("Hay cientos de niños más como este en los barrios marginales cercanos. Las instituciones de cuidado infantil de Masada reciben tan poca financiación que apenas pueden seguir funcionando.", "Haifa")
	await novel_interface.show_text_only("Tal como dijo Mariru, una vez que los recursos circundantes son saqueados, incluso un lugar como Masada, con un ejército tan grande, no puede continuar para siempre...")
	novel_interface.show_character("ren_medical","worry")
	await novel_interface.show_dialog("¿No hay nadie que pueda ayudar a estos huérfanos? ¿Masada no mantiene siempre sus puertas abiertas a las ONG...?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Algunas personas con cascos blancos vinieron antes, pero solo tomaron algunas fotografías de algunos niños discapacitados y se fueron...", "Haifa")
	await novel_interface.show_dialog("Apenas puedo seguir el ritmo como está. Incluso tareas como la limpieza dependen de la ayuda de los niños mayores. Hay mucho que puedo hacer...", "Haifa")
	novel_interface.show_character("ren_medical","smile")
	await novel_interface.show_dialog("¡No digas eso! Estoy seguro de que todos los niños están increíblemente agradecidos contigo...\nQuiero decir, incluso yo--", "Lian")
	await novel_interface.show_dialog("¡De todos modos, tener una familia es muy importante para niños como ellos!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ella me miró sorprendida y luego sonrió amablemente.")
	await novel_interface.show_dialog("Que buen niño. No eres de por aquí, ¿verdad, Lian?", "Haifa")
	await novel_interface.show_dialog("¿Emily dijo que te quedarías aquí esta noche y te irías mañana por la mañana?", "Haifa")
	novel_interface.show_character("ren_medical","gratified")
	await novel_interface.show_dialog("Mmm. Parece que el centro de la ciudad está bajo la ley marcial esta noche porque mañana firmarán un acuerdo de alto el fuego con la resistencia... ¡Perdón por imponerme!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Está bien, está bien. Primero iré a preparar el baño.", "Haifa")
	await novel_interface.show_text_only("La tía Haifa se levantó y caminó hacia la puerta, murmurando para sí misma.")
	await novel_interface.show_dialog("Suspiro... ¿Se puede realmente borrar tanto odio con un solo trozo de papel...?", "Haifa")
	await novel_interface.stop_music()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("................")
	await novel_interface.show_text_only("...")
	await novel_interface.show_text_only("SID Sala de mando.")
	novel_interface.change_music("res://assets/audio/music/Normal Stage.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	await novel_interface.show_text_only("Mariru entró a la sala de mando bostezando y llevando dos tazas de café, sólo para encontrar a Aya todavía trabajando en la consola principal.")
	novel_interface.show_character("liliu_uniform1","normal2")
	await novel_interface.show_dialog("No es frecuente que te ofrezcas como voluntario para un aburrido trabajo de inteligencia como éste.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","wink")
	await novel_interface.show_dialog("Porque el objetivo es interesante~", "Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru dejó el caramelo macchiato en la mesa junto a Aya, y Aya tomó un sorbo.")
	novel_interface.show_character("liliu_uniform1","normal2")
	await novel_interface.show_dialog("¿Está realmente bien beber algo tan dulce en medio de la noche...?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Mi cerebro quemará el azúcar de todos modos. Y encontré un gran avance.", "Aya")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform1","normal1",0.25)
	await novel_interface.show_dialog("¿Encontró una información privilegiada?", "Mariru")
	novel_interface.character_light(0.35,"normal")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("No. Dado el nivel de cifrado del Proyecto 0812, menos de diez personas deberían conocer el panorama completo y no puedo encontrar a ninguno de ellos.", "Aya")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"sigh")
	await novel_interface.show_dialog("Cierto. Conociendo el estilo de Palantir, no había manera de que dejaran escapar un objetivo tan valioso...", "Mariru")
	novel_interface.character_light(0.35,"stare")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Así que cambié de enfoque...", "Aya")
	await novel_interface.show_dialog("Cualquier nave espacial que involucre materia heterogénea tendría que ser el pináculo de la capacidad industrial y tecnológica de una nación.", "Aya")
	await novel_interface.show_dialog("Al menos varios miles de personas habrían participado en su diseño, investigación y desarrollo, fabricación y transporte.", "Aya")
	novel_interface.change_expression("think")
	await novel_interface.show_dialog("Y después del colapso del gobierno federal, las leyes de secreto pertinentes dejaron de aplicarse, así que...", "Aya")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("¿Estás planeando analizar información pública en línea?\nLa mayor parte tiene que ser basura, ¿verdad...?", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Aya se encogió de hombros.")
	novel_interface.show_character("ai","normal")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("liliu_uniform1","sigh",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Al principio, algunos antiguos conocedores filtraban cosas sólo para ganar dinero... la gente naturalmente sentía curiosidad por este tipo de historias.", "Aya")
	await novel_interface.show_dialog("Luego aparecieron las empresas de marketing online, colocaron titulares sensacionalistas sobre esos fragmentos de información en bruto y los rellenaron con todo tipo de adornos.", "Aya")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("Antes de que el público se cansara de los clickbait y las noticias falsas, había más de seis millones de piezas de información pública relacionadas con secretos de la NASA.", "Aya")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("Me lo imaginé...", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru se frotó las sienes con impotencia y Aya le hizo una mueca.")
	novel_interface.show_character("ai","stare")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("liliu_uniform1","normal1",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Pero si usa IA para la descomposición semántica y el rastreo de fuentes, entonces filtre la información con una confianza ortogonal superior al 90%...", "Aya")
	novel_interface.change_expression("wink")
	await novel_interface.show_dialog("Obtienes mucho más material del que esperas ~", "Aya")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Aya tocó el teclado y al instante apareció una pantalla llena de datos. Mariru se animó de inmediato.")
	novel_interface.show_character("ai","normal")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("liliu_uniform1","normal1",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("El proyecto 0812 tiene una masa total de entre 30 y 50 toneladas. Sólo el equipo óptico representa 5 toneladas y no lleva ningún sistema de soporte vital.", "Aya")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Con esa masa, definitivamente no es un satélite... ¿Una estación espacial no tripulada?", "Mariru")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Posiblemente. La nave tiene dos sistemas de propulsión y puede cambiar de órbita desde 660 kilómetros sobre la Tierra hasta 36.000 kilómetros.", "Aya")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("Uno de ellos es un motor de iones que puede proporcionar una aceleración estable en el espacio a largo plazo, con una vida útil diseñada de treinta años.", "Aya")
	novel_interface.change_expression("normal") 
	await novel_interface.show_dialog("El otro es un motor propulsor convencional que puede soportar un aterrizaje de regreso en la Tierra y representa casi la mitad de la masa del sistema.", "Aya")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"serious")
	await novel_interface.show_dialog("Permaneciendo tanto tiempo en el espacio y ajustando constantemente su posición orbital... ¿Estaba destinado a mantenerse apuntado a una fuente de señal a 400 años luz de distancia?", "Mariru")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Y el hecho de que sea recuperable sugiere que el volumen de datos es demasiado grande para transmitirlo de forma inalámbrica...", "Aya")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("¿De cuánta información estamos hablando...?", "Mariru")
	novel_interface.change_2nd_expression("normal1")
	await novel_interface.show_dialog("¿Puedes localizar ese satélite?", "Mariru")
	novel_interface.character_light(0.35,"think")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Algo tan grande debería haber sido imposible de ocultar a Sentinel, pero no aparece en ninguna órbita...", "Aya")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Sentinel es el sistema de seguimiento de asteroides, ¿verdad?", "Mariru")
	novel_interface.character_light(0.35,"normal")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Sí. Según los registros, la última vez que una nave espacial que coincidía con esas características cambió de órbita fue hace aproximadamente un año.", "Aya")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Entonces en ese momento... ¿la llave de control se vendió en el mercado negro?", "Mariru")
	novel_interface.character_light(0.35,"wink")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ni idea. Si quisieras ocultar algo tan grande, ¿tal vez lo esconderías detrás de la luna?", "Aya")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"sigh")
	await novel_interface.show_dialog("Por cierto... ¿cuándo escribiste una IA como esta?", "Mariru")
	novel_interface.character_light(0.35,"think")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("No podría escribir algo como esto. El modelo y los parámetros fueron cargados anteayer por una cuenta llamada Elder Seven.", "Aya")
	novel_interface.change_expression("wink")
	await novel_interface.show_dialog("Los foros de la comunidad de código abierto han estado explotando al respecto estos últimos días ~", "Aya")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("¿Qué tiene de especial?", "Mariru")
	novel_interface.character_light(0.35,"normal")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("La persona también publicó el algoritmo. Estimaciones aproximadas dicen que entrenar una IA a este nivel consumiría más de mil millones de dólares en computación.", "Aya")
	await novel_interface.show_dialog("Y un código a esta escala definitivamente no podría haber sido escrito por una sola persona.", "Aya")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("¿Qué organización abriría el código fuente de algo tan valioso...? ¿Lo aislaste correctamente?", "Mariru")
	novel_interface.character_light(0.35,"wink")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Por supuesto. Ejecuté todo dentro de una máquina virtual Themis.", "Aya")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Este modelo puede archivar rápidamente volúmenes masivos de información similar y juzgar las correlaciones entre ellas.", "Aya")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("Al mismo tiempo, califica la confiabilidad de cada ítem en función de cuán ortogonales son las diferentes fuentes.", "Aya")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"jest")
	await novel_interface.show_dialog("Suena útil. ¿Entonces esas turbias empresas de marketing están en problemas?", "Mariru")
	novel_interface.character_light(0.35,"blush_think")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Eso es lo que pensé al principio. Pero piénselo: si lo conectara a una base de datos lo suficientemente grande...", "Aya")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("La expresión de Mariru de repente se volvió seria.")
	novel_interface.show_character("ai","blush_think")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("liliu_uniform1","serious",0.25)
	await novel_interface.show_dialog("¿Como un sistema de vigilancia de seguridad del gobierno...?", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Exacto. Combinado con el reconocimiento de imágenes, podría perfilar y clasificar a todos y luego inferir cómo están conectados.")
	await novel_interface.show_text_only("También podría usar esa información para determinar los objetivos de un objetivo y predecir el comportamiento de las personas, tal vez incluso orientarlas a propósito...")
	await novel_interface.show_text_only("Mariru negó con la cabeza. Este no era el momento de dejar que su atención se desviara.")
	novel_interface.show_character("ai","blush_think")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("liliu_uniform1","sigh",0.25)
	await novel_interface.show_dialog("Podemos hablar de esa IA más tarde.", "Mariru")
	novel_interface.change_2nd_expression("normal1")
	await novel_interface.show_dialog("Han seleccionado al representante de Masada para la firma del alto el fuego de mañana. Será el mayor general Hamon del Comando Norte.", "Mariru")
	await novel_interface.show_dialog("Y por razones políticas, el lugar de la firma fue elegido como el Centro Internacional de Convenciones de Masada junto al Mar Muerto.", "Mariru")
	novel_interface.character_light(0.35,"think")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Tiene sentido. Un alto el fuego firmado detrás del muro de aislamiento nunca convencería a nadie.", "Aya")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("¿Qué clase de gente hay en la resistencia? Nunca antes presté mucha atención.", "Aya")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("Por supuesto que no~", "Mariru")
	await novel_interface.show_dialog("Al principio fue una coalición de milicias étnicas locales, grupos religiosos extremistas, restos del ejército tras el colapso del gobierno y bandidos errantes.", "Mariru")
	await novel_interface.show_dialog("Todos ellos eran grupos armados que odiaban a Masada y hablaban entre ellos siete u ocho idiomas locales. Normalmente deberían haber sido eliminados por separado.", "Mariru")
	novel_interface.character_light(0.35,"normal")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("¿Qué clase de persona podría organizar un grupo así?", "Aya")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("Walid Mushar, el hombre que mañana firmará el acuerdo en nombre de la resistencia.", "Mariru")
	await novel_interface.show_dialog("Incluso después de años de ser perseguido por una Fuerza de Defensa Nacional equipada dos generaciones antes que ellos, aún se las arregló para hacer que la resistencia fuera cada vez más grande.", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Aya abrió el expediente de Walid Mushar en la pantalla.")
	novel_interface.show_character("ai","dizzy")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("liliu_uniform1","normal1",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("... ¡¿En realidad tiene un doctorado?!", "Aya")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Sí. El hombre que alguna vez tuvo la mayor recompensa del mundo es un doctorado en física de la Universidad Ben-Gurion.", "Mariru")
	novel_interface.change_2nd_expression("serious")
	await novel_interface.show_dialog("Dicen que después de que la Ciudad Santa fue destruida, los habitantes de Masadan, tan enfurecidos que habían perdido toda razón, arrastraron a su esposa e hija fuera de su casa en Beersheba y las sacaron a la calle...", "Mariru")
	novel_interface.character_light(0.35,"think")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("¿Odio étnico indiscriminado?\nLos humanos realmente son animales irremediablemente estúpidos...", "Aya")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru cortó ligeramente a Aya en la cabeza. Aya encogió el cuello por reflejo, sólo para descubrir que Mariru no había usado mucha fuerza esta vez.")
	novel_interface.show_character("ai","think")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("liliu_uniform1","sigh",0.25)
	await novel_interface.show_dialog("Sí. Los humanos realmente somos estúpidos.", "Mariru")
	novel_interface.change_2nd_expression("normal1")
	await novel_interface.show_dialog("Después de eso, Mushar dejó la universidad. La siguiente vez que apareció en público ya era el mayor dolor de cabeza de Masada.", "Mariru")
	await novel_interface.show_dialog("Si no fuera por el sistema automático de represalias de Masada, probablemente habría seguido luchando hasta el día de su muerte...", "Mariru")
	novel_interface.change_2nd_expression("normal2")
	await novel_interface.show_dialog("Deberías ir a dormir un poco. Has estado sentado aquí durante horas.", "Mariru")
	novel_interface.change_2nd_expression("normal1")
	await novel_interface.show_dialog("No se sabe qué pasará mañana...", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.stop_music()
	await novel_interface.hide_background_with_fade()
	await novel_interface.show_text_only("................")
	await novel_interface.show_text_only("...")
	await novel_interface.show_text_only("Orfanato en el Distrito Exterior.")
	novel_interface.change_music("res://assets/audio/music/Shop.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_ShelterCorridor.png")
	novel_interface.show_character("ren_medical","smile")
	await novel_interface.show_dialog("Uf... Mi pelo está lleno de arena. Esa ducha se sintió increíble.", "Lian")
	novel_interface.change_expression("wry_smile")
	await novel_interface.show_dialog("(Gracias a Dios había bragas desechables en los suministros militares...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("El baño es más grande de lo que esperaba y está muy limpio. El mostrador está cuidadosamente revestido con muchos juguetes de plástico para niños pequeños.")
	await novel_interface.show_text_only("Mientras me secaba el cabello, cogí el teléfono que se estaba cargando fuera del baño y lo desconecté del altavoz inalámbrico.")
	await novel_interface.show_dialog("¿Terminaste de lavarte, Lian?", "Haifa")
	novel_interface.show_character("ren_medical","smile")
	await novel_interface.show_dialog("Mm-hmm, se sintió genial~\n¡Gracias, tía Haifa!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Creo que escuché música en el baño hace un momento.\n¿No estaba tu teléfono afuera...?", "Haifa")
	novel_interface.show_character("ren_medical","shy_left")
	await novel_interface.show_dialog("¡N-No! ¡No lo fue! Realmente...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mi cara se puso roja mientras me cubría el pecho.")
	await novel_interface.show_text_only("De repente, el walkie-talkie al lado del teléfono estalló en estática.")
	await novel_interface.show_dialog("¡¿Lian, estás ahí?!", "Emily")
	novel_interface.show_character("ren_medical","serious")
	await novel_interface.show_dialog("¿Qué es?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.stop_music()
	await novel_interface.show_dialog("¡Pide a tía Haifa que apague todas las luces y cierre la puerta principal!\nEncontré--", "Emily")
	await novel_interface.show_text_only("Antes de que el orador pudiera terminar, el walkie-talkie se disolvió en estática.")

	print("=== 星尘降临篇第16话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
