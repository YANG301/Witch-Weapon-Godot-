# stardustdescends_ep09.gd - 星尘降临篇第9话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	stardustdescends_ep09_script()

func play_script():
	pass

func stardustdescends_ep09_script():
	novel_interface.change_music("res://assets/audio/music/Normal Stage.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_Ordovician.png")
	await novel_interface.show_text_only("Menschen spekulieren immer gerne: Wenn eine mächtige außerirdische Zivilisation existiert, ist sie dann wohlwollend oder böswillig?")
	await novel_interface.show_text_only("Eine wahrscheinlichere Antwort ist: „Es ist gleichgültig.“")
	await novel_interface.show_text_only("Eines Tages vor 449 Millionen Jahren durchbohrte ein Strahl hochenergetischer Gammastrahlen aus einer Entfernung von 6.000 Lichtjahren die Atmosphäre und traf die Erde.")
	await novel_interface.show_text_only("Die Strahlung zerstörte in einem Augenblick ein Drittel der Ozonschicht, sodass ultraviolettes Licht der Sonne direkt durch die Atmosphäre dringen konnte.")
	await novel_interface.show_text_only("Riesige Mengen Plankton starben, wodurch die Grundlagen der marinen Nahrungskette zerstört wurden und eine Hungersnot begann sich auszubreiten.")
	await novel_interface.show_text_only("Mehrere Jahrzehnte nach der Katastrophe verbanden sich zerbrochene atmosphärische Moleküle wieder und bildeten große Mengen giftigen Stickstoffdioxids.")
	await novel_interface.show_text_only("Das Stickstoffdioxid verdunkelte den Himmel und blockierte 50 % des Sonnenlichts. Ohne Sonnenlicht begann die Erde schnell abzukühlen.")
	await novel_interface.show_text_only("Die Meerestemperaturen sanken von 25 auf 10 Grad und das weitere Absterben von Plankton beschleunigte den Zusammenbruch der Nahrungskette.")
	await novel_interface.show_text_only("Fünfhundert Jahre nach der Katastrophe war ein Drittel allen Lebens auf der Erde verschwunden, und was noch übrig war, kämpfte mit Hunger und Kälte.")
	await novel_interface.show_text_only("Mit der Schwächung des Sonnenlichts gefror weltweit große Mengen Meerwasser. Die Gletscher breiteten sich mit unvorstellbarer Geschwindigkeit aus und der Meeresspiegel sank um 100 Meter.")
	await novel_interface.show_text_only("Einhundertfünfzigtausend Jahre nach der Katastrophe sank die globale Durchschnittstemperatur auf 5 Grad. Der größte Teil der Oberfläche war mit Eis bedeckt und über die Hälfte aller Arten starben in der Kälte.")
	await novel_interface.show_text_only("Der unvorsichtige Fehltritt eines fernen Sterns, der irgendwo in der Galaxie zusammenbrach, stürzte das alte Leben auf der Erde in endlose Verzweiflung.")
	await novel_interface.show_text_only("──Dieser Unfall ist in der Geschichte als Massenaussterben im späten Ordovizium bekannt.")
	await novel_interface.hide_background()
	await novel_interface.stop_music()
	await novel_interface.show_text_only("...")
	await novel_interface.show_text_only("...")
	await novel_interface.show_text_only("Die fünfte Schulstadt.")
	await novel_interface.show_text_only("Während im Hintergrund eine sanfte Melodie erklang, wachte der auf dem Sofa ausgestreckte Mann langsam auf ...")
	novel_interface.change_music("res://assets/audio/music/Sunset.mp3")
	novel_interface.show_background("res://assets/images/bg/Fabiola/BAR.png")
	await novel_interface.show_text_only("Mit Stoppeln im Gesicht und zerzausten Haaren kämpfte er sich aufrecht und stützte sich dabei auf die Rückenlehne des Sofas.")
	await novel_interface.show_text_only("Vor ihm stand ein Glas Wasser auf dem Tisch. Seine Kehle fühlte sich so trocken an, als wäre er gerade aus der Wüste gekommen, also schnappte er sich die Flüssigkeit und trank sie in einem Zug aus.")
	await novel_interface.show_text_only("Dann bekam er heftige Kopfschmerzen. Er umklammerte seinen Kopf und stöhnte eine Weile, dann stand er plötzlich auf, als suche er nach etwas.")
	await novel_interface.show_text_only("Als er seine Aktentasche neben dem Sofa fand und sich vergewisserte, dass die Dokumente darin unversehrt waren, fühlte er sich ein wenig beruhigt und setzte sich wieder hin.")
	novel_interface.show_character("shi","normal")
	await novel_interface.show_dialog("Das ist...\nWo bin ich...?", "Professor Shih")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Professor Shih sah sich um. Der Ort ähnelte einer gehobenen Bar, sanfte Musik wehte durch den Raum und Neonlichter flackerten auf den Gebäuden draußen.")
	await novel_interface.show_dialog("Du bist wach?", "Frauenstimme")
	await novel_interface.show_text_only("Professor Shih folgte der Stimme und sah eine rothaarige Frau in einem weißen Kittel, die sich langsam näherte, mit einem blassgelben Getränk in der Hand.")
	await novel_interface.show_text_only("Sie stellte ihm das Getränk hin und setzte sich auf das Sofa gegenüber.")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Es ist Elektrolytwasser. Es wird gegen die Kopfschmerzen helfen.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("shi","normal")
	await novel_interface.show_dialog("Du bist...?", "Professor Shih")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Professor Shih starrte ihr misstrauisch ins Gesicht, als hätte er eine vage Erinnerung an sie.")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Du solltest mich kennen──", "Mariru")
	await novel_interface.show_dialog("Ich bin Mariru von Braun. Als Sie letztes Jahr als Gastwissenschaftler an die New Toyosu Academy of Sciences kamen, haben Sie meinen Vortrag über kristalline heteromorphe Objekte besucht.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru hielt inne, lächelte dann und fuhr fort.")
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("Außerdem bin ich der Leiter von SID.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Professor Shih zuckte zusammen und wollte instinktiv weglaufen, gab diesen kindischen Gedanken aber schnell auf──")
	await novel_interface.show_text_only("Mariru reichte ihm ein Tablet und sagte beruhigend:")
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Hab keine Angst. Hier ist es sehr sicher──", "Mariru")
	await novel_interface.show_dialog("Und wenn wir nicht wären, wärst du schon tot.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Professor Shih nahm die Tablette misstrauisch. Es zeigte Aufnahmen von Straßenüberwachungskameras.")
	await novel_interface.show_text_only("Plötzlich erinnerte er sich, dass er lange Zeit in dieser Villa gewartet hatte, ohne den Käufer zu sehen, mit dem er sich verabredet hatte. Als er ging, rief er ein Taxi.")
	await novel_interface.show_text_only("Während er am Straßenrand wartete, verspürte er einen stechenden Schmerz im Nacken, und dann wurde ihm alles schwarz...")
	novel_interface.show_character("shi","normal")
	await novel_interface.show_dialog("Das ist...", "Professor Shih")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Auf dem Filmmaterial stand Professor Shih an der Straße und wartete auf das Taxi. Als eine unauffällige Frau mittleren Alters hinter ihm vorbeiging, zog sie plötzlich eine Spritze hervor──")
	await novel_interface.show_text_only("Mit einer sauberen, effizienten Bewegung trieb sie die Nadel in seinen Hals und fing dann schnell seinen zusammenbrechenden Körper von hinten auf.")
	await novel_interface.show_text_only("Ungefähr drei Sekunden später fuhr ein schwarzer Lieferwagen mit geöffneter Seitentür an den Bordstein, und zwei Personen zogen ihn in das Fahrzeug.")
	await novel_interface.show_text_only("Dann raste der Transporter davon. In weniger als zehn Sekunden war er verschwunden, als wäre er aus der Welt verschwunden.")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Bei diesen Leuten handelte es sich um Killer, die online von einem anonymen Kunden für einen hohen Preis angeheuert wurden. Zum Glück haben wir den Van an der ersten Kreuzung angehalten...", "Mariru")
	await novel_interface.show_dialog("Damals waren sie gerade dabei, Ihnen ein Neurotoxin zu injizieren. Einen Schritt später und Sie wären sofort hirntot.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Professor Shih holte tief Luft und versteifte sich.")
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Deshalb...", "Mariru")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("Wen hast du bloß beleidigt?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("shi","angry")
	await novel_interface.show_dialog("Beleidigend...?\nH-Wie kann das sein!", "Professor Shih")
	await novel_interface.show_dialog("Ich bin nur ein Gelehrter. Wen hätte ich wohl beleidigen können...", "Professor Shih")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Diese Villa hatte schon immer einen guten Ruf als „Untergrundmakler“. Ob es sich um Waffengeschäfte, geheime Dokumente oder heteromorphe Objekte handelte──", "Mariru")
	await novel_interface.show_dialog("Unter der Garantie der Organisation namens „Sieben Gebote“ wagte niemand, die Grenze zu überschreiten, egal wie abscheulich der Käufer oder Verkäufer war.", "Mariru")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Aber dieses Mal war der von Ihnen kontaktierte Käufer bereit, ein solches Risiko einzugehen, um einen wertlosen Neuling wie Sie auszuschließen. Warum?", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Professor Shih zog abwehrend seinen Mantelkragen zurück und warf einen Blick auf seine alte Ledertasche.")
	novel_interface.show_character("shi","normal")
	await novel_interface.show_dialog("Du hast es doch schon gesehen, oder? Dies ist eine „streng geheime“ Akte der First School City. Könnte es das formlose Tor sein ...", "Professor Shih")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru lehnte sich gegen das Sofa zurück und lachte abweisend──")
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("Wenn selbst jemand wie Sie es ins Ausland bringen kann, kann das kein Geheimnis sein.", "Mariru")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Drei identische Dokumente sind bereits auf dem Markt aufgetaucht, und auch der Geheimdienst von Masada hat eines erhalten.", "Mariru")
	await novel_interface.show_dialog("Es kann sogar gefolgert werden, dass Huayungong dieses Dokument absichtlich durchsickern ließ──", "Mariru")
	await novel_interface.show_dialog("Und soweit ich weiß, haben die anderen Verkäufer, die diese Informationen weitergegeben haben, ihre Geschäfte alle ohne Zwischenfälle abgeschlossen.", "Mariru")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("Was ist im Vergleich zu ihnen so besonders an dir, dass sie das Risiko eingehen mussten, dich zum Schweigen zu bringen?", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Professor Shih starrte ihn lange Zeit ausdruckslos an und konnte kein Wort sagen.")
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Ich vermute, dass der Preis, den Sie Ihrem vorherigen Käufer genannt haben, nicht nur Geld war, oder ...", "Mariru")
	await novel_interface.show_dialog("Vielleicht war das, wonach Sie gefragt haben, genau das, was Sie beinahe umgebracht hätte?", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Der Mann gegenüber von Mariru stieß einen langen Seufzer aus, entspannte sich und lehnte sich gegen das Sofa zurück.")
	novel_interface.show_character("shi","eyeclose")
	await novel_interface.show_dialog("Leute wie du... sind furchterregend.", "Professor Shih")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("Ich fühle mich geschmeichelt~", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Marirus Mundwinkel hoben sich leicht.")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Da Sie die Situation verstehen, in der Sie sich jetzt befinden──", "Mariru")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Dann lass uns über unseren Deal reden.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.stop_music()
	await novel_interface.hide_background_with_fade()
	await novel_interface.show_text_only("...")
	await novel_interface.show_text_only("Die dritte Schulstadt, Zoll des Hafens von Masada.")
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_MasadaCustoms.png")
	novel_interface.show_character("ren_medical","stare")
	await novel_interface.show_dialog("Kann etwas, das wie ein Tattoo aussieht, wirklich von selbst biologisch abgebaut werden ...?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ich rieb den Barcode auf meinem Handrücken. Anscheinend verwendet die Tinte eine Art heteromorphe Verarbeitung und verschwindet automatisch zu einem voreingestellten Zeitpunkt.")
	await novel_interface.show_text_only("Dieser Barcode ist die Einreiseerlaubnis des Zolls von Masada und der einzige legale Ausweis, den Ausländer während ihres Aufenthalts im Land haben.")
	await novel_interface.show_text_only("Sobald die zulässige Aufenthaltsdauer abläuft, soll die Tinte von selbst verdunsten.")
	await novel_interface.show_text_only("Ohne diesen Barcode hat jeder Soldat oder Inspektionsbeamte in Masada das Recht, mich sofort festzunehmen.")
	novel_interface.show_character("ren_medical","uneasy")
	await novel_interface.show_dialog("(Hmm... es färbt nicht ab, wenn ich dusche, oder?)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("stardust_small","disgust")
	await novel_interface.show_dialog("So langsam...", "Stardust")
	novel_interface.change_expression("wordless")
	await novel_interface.show_dialog("Waaah waaah aaawoo~~", "Stardust")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Stardust war des Wartens müde und murmelte unsinnige Silben vor sich hin, während sie sich zum Flurfenster hinüberschlängelte und sich an der Säule festhielt, um nach draußen zu schauen.")
	await novel_interface.show_text_only("Ich brachte sie durch den Sondergang für die International Medical Relief Organization, aber Annie musste sich in der regulären Sicherheitskontrolle für normale Besucher anstellen.")
	await novel_interface.show_text_only("Masadas Sicherheitskräfte sind weltweit für ihre brutale Strenge bekannt; Sogar in der Hafenlobby patrouillieren überall Soldaten mit scharfer Munition.")
	await novel_interface.show_text_only("Ich ging hinter Stardust und schaute durch das Fenster nach Osten. Dort konnte ich das ruhige blaue Tote Meer und den Elijah-Staudamm am Ende des Canal Grande sehen.")
	await novel_interface.show_text_only("In der Nähe des Ausflusses an der Südseite des Staudamms am Toten Meer war das Wasser mit unregelmäßigem Türkis und Hellblau marmoriert, und je weiter man nach Norden blickte, desto tiefer wurde die Farbe des Wassers.")
	await novel_interface.show_text_only("Der Genesis zufolge liegen die beiden von Gott zerstörten sündigen Städte – Sodom und Gomorra – versunken im südlichen Toten Meer.")
	await novel_interface.show_text_only("Ich fragte mich, ob das Meer immer noch umherirrende Geister beherbergte, die Groll gegen „diesen Großen“ hegten.")
	await novel_interface.show_text_only("In diesem Moment begann sich am nordöstlichen Horizont der dunkelrote Dunst zu regen, der durch den Sandsturm entstanden war.")
	await novel_interface.show_text_only("Am seltsamsten fand ich jedoch, dass dieses kleine Mädchen es war, das mir von dem Sandsturm erzählt hatte──")
	novel_interface.show_character("stardust_small","konata_eye")
	await novel_interface.show_dialog("Mhm?", "Stardust")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","smile")
	await novel_interface.show_dialog("Hey~ kennst du Masadas Geschichte?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sie blinzelte mich mit einem „Wovon redest du überhaupt?“ an. Gesichtsausdruck, während die katzenohrartigen Kopfhörer auf ihrem Kopf zweimal schnell aufblitzten.")
	novel_interface.show_character("ren_medical","smile")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("stardust_small","normal1",0.25)
	await novel_interface.show_dialog("Auf Aramäisch bedeutet Masada „Festung“. Es handelte sich ursprünglich um einen auf einem Hügel erbauten Palast und gleichzeitig um eine mächtige Verteidigungsanlage──", "Stardust")
	await novel_interface.show_dialog("Im Jahr 72 hielt die Festung Masada mit nur tausend Verteidigern zwei Jahre lang der Belagerung durch die römischen Legionen stand. Als die Stadt schließlich fiel, begingen die Verteidiger Massenselbstmord.", "Stardust")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Genau wie zuvor im Restaurant rezitierte sie mechanisch die Standardantwort aus einem Lexikon, als würde sie aus einem Buch vorlesen.")
	novel_interface.show_character("ren_medical","wry_smile")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("stardust_small","normal1",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("...Verstehen Sie eigentlich, was Sie gerade gesagt haben?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"konata_eye")
	await novel_interface.show_dialog("Nein~!", "Stardust")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Sie schenkte mir ein unbeschwertes Lächeln.")
	await novel_interface.show_text_only("Bist du ein intelligenter Redner oder so?")
	await novel_interface.show_text_only("Die besonders dumme Art, noch dazu...")
	await novel_interface.show_text_only("Ich weiß nicht viel über Geschichte. Ich weiß nur, dass Masada es Jahrtausende lang schwer hatte und während des Siebenjährigen Krieges sogar ihre ursprüngliche heilige Hauptstadt zerstört wurde.")
	novel_interface.show_character("ren_medical","upset")
	await novel_interface.show_dialog("Mann... diese Leute hatten wirklich einen holprigen Weg.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Bei diesem Gedanken konnte ich das Gefühl hinter dem Slogan auf dem Balken der Einwanderungshalle einigermaßen verstehen: „Masada wird niemals fallen.“")
	novel_interface.show_character("ren_medical","upset")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("stardust_small","happy",0.25)
	await novel_interface.show_dialog("Ach! Annie──", "Stardust")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Stardust zeigte auf den Sicherheitsausgang und rief. Annie zog ihren Koffer und ging von dort auf uns zu.")
	await novel_interface.stop_music()
	await novel_interface.hide_background_with_fade()
	await novel_interface.show_text_only("...")
	await novel_interface.show_text_only("Harima Neuroscience Research Center, Abteilung für experimentelle Medizin.")
	novel_interface.change_music("res://assets/audio/music/Normal Stage.mp3")
	novel_interface.change_background("res://assets/images/bg/Fabiola/Dementium.png")
	await novel_interface.show_text_only("Mariru saß auf dem Bett des Gedankentauchgeräts und rieb sich müde die Schläfen──")
	await novel_interface.show_text_only("Aya kam herein und reichte ihr eine Flasche Elektrolytwasser.")
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("Wie war es? Haben Sie etwas aus dem Verhör herausgeholt?", "Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Ja... wir haben einige interessante Informationen.", "Mariru")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Wie geht es Professor Shih jetzt?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("Nun... er liegt immer noch im tiefen Koma. Seine Hirnstammreflexe sind schwach und sein Leben muss von Maschinen aufrechterhalten werden──", "Aya")
	await novel_interface.show_dialog("Der Chelatbildner hat die meisten Neurotoxine aus seinem Körper entfernt, aber wir können nicht sagen, wie viel Schaden bereits angerichtet wurde oder ob er jemals aufwachen wird.", "Aya")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("Dieses Setup ist die einzige Möglichkeit, die wir derzeit haben, um Informationen aus ihm herauszuholen", "Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru schraubte den Deckel ab und nahm einen großen Schluck, bevor sie sprach.")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Er sagte, er habe die Dokumente gestohlen und verkauft, um seine Tochter zu finden.", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","wink",0.25)
	await novel_interface.show_dialog("Hä? Ich dachte, das alte Fossil sei einzeln", "Aya")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Seine Tochter schloss vor sechs Jahren ihr Studium an der Astronomieabteilung in Berkeley ab und wurde vor der Auflösung der Bundesregierung für ein geheimes NASA-Projekt rekrutiert.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"think")
	await novel_interface.show_dialog("NASA? Das ist ein Name, den ich schon lange nicht mehr gehört habe ...", "Aya")
	novel_interface.change_2nd_expression("normal")
	await novel_interface.show_dialog("War es ein militärisches Weltraumwaffenprojekt?", "Aya")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Es war ein astronomisches Beobachtungsprojekt──", "Mariru")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Die NASA soll während der Beobachtung einer bestimmten Koordinate im Plejadenhaufen ein flackerndes Hochfrequenzsignal in einem bestimmten Band empfangen haben.", "Mariru")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Das Signal war eindeutig gerichtet und konnte nur von einer bestimmten Orbitalposition aus empfangen werden──", "Mariru")
