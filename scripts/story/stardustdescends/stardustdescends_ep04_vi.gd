	await novel_interface.hide_character()
	await novel_interface.show_text_only("Tôi nhìn vào con số trên vòng đeo tay mà sòng bạc phát hành và tự nhủ nhiều lần - đây không phải là tiền.")
	novel_interface.show_character("ren_full","sob")
	await novel_interface.show_dialog("(Nhưng đó vẫn là tiền khó kiếm được từ những người nộp thuế của New Opulentia!)", "Lian")
