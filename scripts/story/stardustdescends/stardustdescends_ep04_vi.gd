	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Dispatched_Ship_Aisle.png")
	await novel_interface.show_text_only("Ở độ cao ba mươi nghìn mét trên bầu trời, trên một phương tiện vận tải hạng nặng tốc độ cao SID, Nix xem màn hình chiếu với một tách trà trên tay.")
	novel_interface.show_character("nyx_normal","normal1")
	await novel_interface.show_dialog("Bạn chỉ có 2 và 6 viên kim cương. Đánh giá theo hành vi của anh ta, khả năng cao là anh ta cũng có bộ bài và quân bài của anh ta gần như chắc chắn cao hơn của bạn.", "Nix")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Nghiêm túc mà nói?!\nTôi vừa định chơi hết mình...", "Lian")
	novel_interface.show_character("nyx_normal","speak")
	await novel_interface.show_dialog("*thở dài*", "Nix")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Cô không biết phải giải thích thế nào cho Lian, chính cô gái đã ngủ quên và chảy nước miếng trên đống khoai tây chiên trị giá năm mươi triệu đêm qua.")
	novel_interface.show_character("nyx_normal","normal2")
	await novel_interface.show_dialog("Sai lầm phổ biến nhất mà một tân binh mắc phải - bất cứ khi nào họ có ván bài tốt, họ lại muốn đặt cược lớn, thậm chí là tất tay.", "Nix")
	await novel_interface.show_dialog("Như thể bàn tay tốt đã tước đi khả năng suy nghĩ phân tích của họ.", "Nix")
	await novel_interface.show_dialog("Vô minh dẫn đến sợ hãi; sự sợ hãi dẫn tới sự liều lĩnh. Cuối cùng, các tân binh có thể dốc toàn lực để ngăn chặn nỗi sợ hãi.", "Nix")
	novel_interface.change_expression("sad")
	await novel_interface.show_dialog("Họ sẽ chỉ cảm thấy tự do sau khi đã đặt cược tất cả những gì họ có.", "Nix")
	await novel_interface.show_dialog("Kết quả là đối thủ có thể dễ dàng đoán được quyết định của anh ta từ hành vi của anh ta.", "Nix")
	novel_interface.change_expression("normal2")
