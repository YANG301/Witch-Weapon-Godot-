	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_Choice.png")
	await novel_interface.show_dialog("Sau khi bạn thực hiện một hành động, đối thủ của bạn sẽ chỉ có ba lựa chọn--bỏ bài, theo cược hoặc tố bài.", "Nix")
	await novel_interface.show_dialog("Vì vậy, bạn nên thực hiện các bước đi của mình dựa trên một nguyên tắc - khiến đối thủ của bạn không thể tìm ra lý do để ủng hộ một trong ba lựa chọn của họ.", "Nix")
	await novel_interface.show_dialog("Nước đi tốt nhất là nước đi khiến đối thủ của bạn cảm thấy rằng bất kỳ lựa chọn nào họ đưa ra đều có thể đúng nhưng đồng thời cũng có thể sai.", "Nix")
	await novel_interface.show_dialog("Nó có ý nghĩa...", "Lian")
	await novel_interface.show_dialog("Khi rơi vào hoàn cảnh như vậy, họ sẽ hoảng sợ, thậm chí đau khổ.", "Nix")
	await novel_interface.show_dialog("Và sẽ đến lượt họ muốn thoát ra.", "Nix")
	await novel_interface.show_dialog("Sau đó, trò chơi sẽ thuộc quyền kiểm soát của bạn--thời điểm hoàn hảo để loại bỏ chúng.", "Nix")
