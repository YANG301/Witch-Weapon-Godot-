	await novel_interface.show_text_only("Lian run rẩy không thể kiểm soát.")
	await novel_interface.show_text_only("Nix nhấp một ngụm trà rồi nói tiếp.")
	novel_interface.show_character("nyx_normal","mock")
	await novel_interface.show_dialog("Nghe này, Texas hold'em là một trò chơi theo lượt.", "Nix")
	await novel_interface.show_dialog("Điều quan trọng nhất không phải là quân bài của bạn mà là đối thủ của bạn.", "Nix")
