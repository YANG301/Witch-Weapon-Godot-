# stardustdescends_ep4.gd - 星尘降临篇第4话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	stardustdescends_ep4_script()

func play_script():
	pass

func stardustdescends_ep4_script():
	novel_interface.change_music("res://assets/audio/music/Story_01.mp3")
	novel_interface.change_background("res://assets/images/bg/Fabiola/Hospital_Passage.png")
	await novel_interface.show_text_only("Vài giờ sau -- Trung tâm nghiên cứu công nghệ Harima")
	await novel_interface.show_text_only("Một cô gái nhỏ uể oải kiểm tra máy tính bảng trong khi nói qua tai nghe.")
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("Đừng lo lắng. Hai người bảo vệ đang có một giấc mơ ngọt ngào khi chúng tôi nói chuyện.", "Aya")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("Đừng đánh giá thấp bộ não con người - nó sẵn sàng và có khả năng hợp lý hóa các tình huống mà nó gặp phải.", "Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aya liếc nhìn quanh phòng một lần nữa. Hai người đàn ông mặc vest đen đang nằm trên một cặp thiết bị Lặn tâm trí.")
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Rốt cuộc, mọi người có nhiều khả năng tin vào những lời nói dối mà họ tự ghép lại với nhau...", "Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Đột nhiên, có thứ gì đó trên máy tính bảng của Aya khiến cô chú ý. Cô nhanh chóng cuộn xuống vài trang rồi quay lại phần dữ liệu thú vị.")
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("Đây là...", "Aya")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Nó là gì?", "Mariru")
	novel_interface.show_character("ai","dizzy")
	await novel_interface.show_dialog("Cảm biến Boltzmann vượt quá mức tối đa vào thời điểm trán của Lian và Nix chạm vào nhau.", "Aya")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Một trục trặc? Tôi tưởng bạn đã đặt giới hạn lý thuyết ở giá trị cao nhất có thể.", "Mariru")
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("Gần như giá trị cao nhất có thể. Nếu khối lượng dữ liệu đạt đến giới hạn Bekenstein thì đó sẽ là một vấn đề khác.", "Aya")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Bạn đang nói rằng, trong thời điểm đó, khối lượng dữ liệu đã đạt đến mức cao nhất tuyệt đối mà bất kỳ vật chất nào cũng có thể mang theo?", "Mariru")
	await novel_interface.show_text_only("Aya đang thực hiện một số phép tính nhanh chóng trên máy tính bảng của mình.")
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("Nếu chúng ta bỏ qua điều bất thường này, các thông số của Nix rất gần với thông số của phù thủy. Có lẽ chính cô ấy cũng chưa nhận ra điều đó.", "Aya")
	await novel_interface.show_dialog("Vậy, thứ gì đó giống như Raphilia?\nGiá như Sonya không đi thực hiện một nhiệm vụ khác...", "Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aya bật video giám sát trong khi phàn nàn.")
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("Không có trục trặc gì cả. Tất cả các bài đọc trở lại bình thường một cách nhanh chóng. Cảm biến cũng đã hoạt động tốt kể từ đó.", "Aya")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("Quan trọng hơn, chỉ có Lian bất tỉnh trong khi tất cả những người khác ở đó đều ổn…", "Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aya nhanh chóng loại trừ các khả năng. Cuối cùng, dường như chỉ có một lời giải thích...")
	novel_interface.show_character("ai","blush_dizzy")
	await novel_interface.show_dialog("Lian--và chỉ Lian--hấp thụ 2,5 YB dữ liệu trong vòng chưa đầy một giây...", "Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aya thấy kết luận của chính mình thật khó tin.")
	await novel_interface.show_dialog("...Nhắc lại cho tôi biết đơn vị YB lớn bao nhiêu?", "Mariru")
	novel_interface.show_character("ai","blush_dizzy")
	await novel_interface.show_dialog("Một yottabyte bằng 10 mũ 24 byte--nhiều hơn tất cả dữ liệu trên internet trước chiến tranh cộng lại...", "Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Giọng Aya run lên vì phấn khích.")
	novel_interface.show_character("ai","blush_dizzy")
	await novel_interface.show_dialog("Và tôi tưởng não cô ấy chỉ dùng cho game thôi...", "Aya")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Yottabyte. Tôi nghĩ tôi đã thấy nó trong báo cáo của Giáo sư Shih!", "Mariru")
	novel_interface.show_character("ai","blush_stare")
	await novel_interface.show_dialog("Thiên thạch cổ xưa đó trong Cung Điện Lơ Lửng!", "Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aya nhanh chóng lấy ra bản báo cáo đó.")
	novel_interface.show_character("ai","blush_wink")
	await novel_interface.show_dialog("Tôi e rằng bây giờ chúng ta sẽ phải dựa vào Lian.", "Aya")
	await novel_interface.hide_character()
	await novel_interface.hide_background_with_fade()
	await novel_interface.stop_music()
	await novel_interface.show_text_only("...")
	await novel_interface.show_text_only("Năm ngày sau -- trên con tàu sòng bạc của Lebona, Liberty Star")
	novel_interface.change_music("res://assets/audio/music/Shop.mp3")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_Gambling_Boat.png")
	await novel_interface.show_dialog("Ừm... cô?", "Người chia bài")
	await novel_interface.show_dialog("Cô?", "Người chia bài")
	novel_interface.show_character("ren_full","panic")
	await novel_interface.show_dialog("Đến lượt tôi à?", "Lian")
	await novel_interface.show_dialog("F-Gấp...", "Lian")
