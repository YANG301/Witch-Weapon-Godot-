	await novel_interface.hide_character()
	await novel_interface.show_text_only("Cô gái rời khỏi bàn và đi đến một nơi yên tĩnh ở góc lối đi.")
	novel_interface.show_character("ren_full","wry_smile")
	await novel_interface.show_dialog("Tôi đã bị đỏ bừng mặt! Tại sao bạn lại bảo tôi gấp?!", "Lian")
	await novel_interface.show_dialog("(cô hạ giọng). Đặc biệt là sau khi tôi đã đặt cược rất nhiều tiền...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Giọng nói trầm thấp của Lian không giấu được sự thất vọng.")
	await novel_interface.show_dialog("Hãy lấy điện thoại ra và giả vờ như bạn đang gọi điện, Lian. Hiện tại, đối với những người khác, có vẻ như bạn đang lẩm bẩm với chính mình.", "Annie")
	await novel_interface.show_dialog("Có ba phòng điều khiển trên con tàu này. Tôi đã đột kích một cái rồi...", "Annie")
	novel_interface.show_character("ren_full","wail")
	await novel_interface.show_dialog("(R-Đột kích?!...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Máy ảnh ở khắp mọi nơi trên con tàu này. Nếu có ai để ý đến chiếc tai nghe siêu nhỏ của bạn, bạn sẽ bị ném cho cá mập.", "Nix")
	await novel_interface.show_text_only("Tôi cảm thấy ớn lạnh sống lưng. Tôi vội lấy điện thoại ra.")
