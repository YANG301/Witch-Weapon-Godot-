	await novel_interface.show_dialog("Tôi vẫn cảm thấy họ đã đi quá xa dù đã giúp tôi giành chiến thắng.", "Lian")
	await novel_interface.show_dialog("Tôi không muốn nghĩ về nó nữa!", "Lian")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_Gambling_Boat3.png")
	await novel_interface.show_text_only("Bây giờ tôi đang theo người phục vụ sòng bạc vào phòng VIP.")
	await novel_interface.show_text_only("Bầu không khí của căn phòng này không giống như tiền sảnh. Đồ trang trí, bàn, ghế... Tất cả đều lộng lẫy hơn nhiều.")
	await novel_interface.show_text_only("Ba người đàn ông mặc vest đắt tiền đang ngồi bên bàn, đã hơi ngà ngà say. Một số cô gái nóng bỏng đang trò chuyện trên ghế dài.")
	await novel_interface.show_text_only("\"Liberty Star\" là một con tàu đánh bạc nhỏ dành riêng cho những người đánh bạc cao cấp. Được bọc trong bộ áo giáp màu xám, nó giữ dáng vẻ rất thấp.")
	await novel_interface.show_text_only("Lên tàu này phải mua ít nhất 20 triệu chip, trên tàu thậm chí không có vài chục khách.")
