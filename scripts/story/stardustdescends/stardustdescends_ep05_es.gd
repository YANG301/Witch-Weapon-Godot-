# stardustdescends_ep05.gd - 星尘降临篇第5话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	stardustdescends_ep05_script()

func play_script():
	pass

func stardustdescends_ep05_script():
	novel_interface.change_music("res://assets/audio/music/Shop.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_Vault.png")
	novel_interface.show_character("ren_full","panic")
	await novel_interface.show_dialog("Esta es la bóveda a bordo del \"Liberty Star\"...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Miro a mi alrededor con asombro. El techo, el suelo y ambas paredes están revestidos con paneles metálicos brillantes hechos de algún material especial.")
	await novel_interface.show_text_only("Comparo los paneles de metal con la ficha de oro que tengo en la mano. El color es similar, pero las paredes desprenden un tenue brillo gris verdoso.")
	await novel_interface.show_text_only("Sólo ciertos invitados VIP pueden usar las cajas fuertes en la bodega, y yo acabo de obtener ese privilegio.")
	await novel_interface.show_text_only("La única forma de entrar o salir es el ascensor en el área VIP, y la puerta en la parte inferior es tan gruesa como una pared.")
	await novel_interface.hide_background()
	await novel_interface.show_dialog("(No hay señales aquí... Tal como se esperaba).", "Lian")
	await novel_interface.show_text_only("Perdí mi comunicación tan pronto como entré al ascensor. Ahora, debo hacer todo exactamente como lo hice durante el simulacro y no puedo equivocarme ni un paso.")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_Vault.png")
	novel_interface.show_character("ren_full","solemn")
	await novel_interface.show_dialog("(Paso uno: confirme que el sistema de vigilancia no funciona... OK.)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Noto que varias cámaras dentro de la bóveda parpadean al mismo tiempo y luego todas se apagan.")
	await novel_interface.show_dialog("Señorita, su caja fuerte es la número 1212. Cada vez que se abre, deben introducirse tanto su llave como la nuestra...", "Camarero")
	await novel_interface.show_text_only("El camarero se gira cortésmente para entregarme la llave, solo para encontrar una botella de \"perfume\" apuntando directamente a su cara.")
	novel_interface.show_character("ren_full","wry_smile")
	await novel_interface.show_dialog("¡Lo siento mucho!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Después de una aplicación en la cara, sus ojos inmediatamente se apagan. Parece que quiere decir algo, pero después de abrir la boca un par de veces, no sale ningún sonido.")
	await novel_interface.show_text_only("Este spray anestésico es un nuevo producto SRD. Aya incluso añadió un fármaco que elimina el control inhibidor del cerebro.")
	await novel_interface.show_text_only("Cualquiera que sea rociado con él entra en algo parecido a un estado hipnótico y se vuelve extremadamente receptivo a la sugestión.")
	novel_interface.show_character("ren_full","smile")
	await novel_interface.show_dialog("Ven y párate aquí.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Conduzco con cuidado al aturdido camarero hasta un lugar directamente frente a la puerta del ascensor y deslizo una ficha roja en su mano.")
	novel_interface.show_character("ren_full","solemn")
	await novel_interface.show_dialog("Ejem...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Recordando las líneas que me habían dicho que ensayara una y otra vez, me dirijo a él con voz firme:")
	novel_interface.show_character("ren_full","normal1")
	await novel_interface.show_dialog("Me trajiste aquí a la bóveda hace un momento. Todo era normal.", "Lian")
	await novel_interface.show_dialog("Después de guardar mi artículo, te di un chip como propina.", "Lian")
	novel_interface.change_expression("solemn")
	await novel_interface.show_dialog("En el momento en que escuches un chasquido de un dedo o veas la puerta del ascensor abrirse, te despertarás y \"recordarás\" cada detalle.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("El camarero no puede decir nada. Se limita a mirar la puerta del ascensor. Me alejo con cuidado.")
	novel_interface.show_character("ren_full","stare")
	await novel_interface.show_dialog("(¿Eso es realmente suficiente?...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru dijo que el cerebro humano es bueno para completar detalles a partir de unas pocas señales y sugerencias simples... pero esto todavía parece demasiado fácil, ¿no?")
	novel_interface.show_character("ren_full","stare")
	await novel_interface.show_dialog("¿Qué recordará exactamente?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Todavía murmurando para mí mismo, camino hasta el centro de la bóveda, rápidamente me quito los tacones altos y los coloco cuidadosamente en el suelo.")
	await novel_interface.show_text_only("Luego meto el auricular y todos los demás objetos metálicos en el bolso y lo dejo al lado de los tacones.")
	await novel_interface.show_text_only("Esta bóveda es una enorme cámara superconductora de protección estático-magnética, capaz de bloquear la mayoría de los campos magnéticos y de radiación.")
	await novel_interface.show_text_only("Lebona no tiene tecnología como esta. Según la información del profesor Shih, la cámara de protección fue encargada a un fabricante militar en Hovering Palace.")
	await novel_interface.show_text_only("Encuentro el contenedor de destino. Entre los dos ojos de cerradura de cada puerta hay un tenue motivo de nube grabado con láser.")
	novel_interface.show_character("ren_full","normal1")
	await novel_interface.show_dialog("Contenedor nº 0812...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Inserto dos llaves maestras de cerámica en las dos cerraduras al mismo tiempo y activo los interruptores en sus extremos.")
	await novel_interface.show_text_only("Fabella dijo una vez que las llaves de las cajas fuertes privadas de los bancos e instituciones similares son en realidad de muy baja seguridad.")
	await novel_interface.show_text_only("Parte de la razón es que esas instituciones tienen mucha confianza en la seguridad que protege la bóveda misma.")
	await novel_interface.show_text_only("Más importante aún, la llave da a los clientes la ilusión de que solo ellos pueden abrir la caja fuerte, lo que hace que pagar por el servicio parezca mucho más fácil.")
	novel_interface.show_character("ren_full","stare")
	await novel_interface.show_dialog("(¿Entonces la bóveda y el sistema de seguridad brindan \"seguridad\", mientras que la clave brinda \"tranquilidad\"...?)", "Lian")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("(¿Por qué eso suena tan parecido a algo que diría Mariru? Lo odio...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Haga clic. ¡La caja fuerte está abierta!")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Dentro del contenedor yacía el meteorito negro de más de 1,5 metros de largo.")
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/APT/livingRoom.png")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("¿Sustancia H de nivel EX?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("¡Sí, nivel EX!", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","stare")
	await novel_interface.show_dialog("Pero recuerdo que dijiste que el nivel EX está conectado con las religiones.", "Lian")
	await novel_interface.show_dialog("Como son especiales para los seguidores religiosos, se puede recolectar la Sustancia H de nivel EX, pero la investigación está prohibida.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("En las leyendas religiosas se dice que cierta sustancia H posee el poder de matar dioses.")
	await novel_interface.show_text_only("Una vez activado, podría desencadenar un desastre apocalíptico, por lo que todas las formas de investigación están estrictamente prohibidas.")
	novel_interface.change_background("res://assets/images/bg/Shot/boySP_news.png")
	await novel_interface.show_text_only("Y si...")
	await novel_interface.show_text_only("La razón por la que recuerdo todo eso tan claramente...")
	await novel_interface.show_text_only("¡Es porque la Destiny Spear que robó también era Sustancia H de grado EX!")
	novel_interface.change_background("res://assets/images/bg/APT/livingRoom.png")
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("(¿Está hablando de mí?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Miro hacia arriba y me miro en el espejo.")
	await novel_interface.show_text_only("Es exactamente como me veo en todos los sueños que he tenido últimamente.")
	novel_interface.show_character("liliu_uniform2","speak")
	await novel_interface.show_dialog("La sustancia H de nivel EX está relacionada con algo más que religiones.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("La voz de Mariru me devuelve a la realidad.")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Nuestra prueba muestra que el meteorito cayó a la Tierra hace más de 4.000 años. Fue excavado por arqueólogos egipcios antes de la guerra.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_TheMeteorite.png")
	await novel_interface.show_dialog("Debido a sus esquinas regulares y caras planas, se concluyó que el meteorito no pudo haberse formado de forma natural.", "Mariru")
	await novel_interface.show_dialog("Al principio la gente pensó que era una especie de sarcófago del Antiguo Egipto, pero aquel meteoro estaba entero, sin la más mínima grieta.", "Mariru")
	await novel_interface.show_dialog("Años más tarde, a medida que aumentaron los problemas relacionados con la Sustancia H, el meteorito fue transferido al Museo Hovering Palace.", "Mariru")
	await novel_interface.show_dialog("El profesor Shih fue uno de los investigadores principales que lo estudiaron. Cuando Hovering Palace recibió el meteorito por primera vez, pensaron que se habían llevado el premio gordo.", "Mariru")
	await novel_interface.show_dialog("Pero pronto descubrieron que el meteorito rechazaba toda forma de sondeo e intrusión.", "Mariru")
	await novel_interface.show_dialog("Para empezar, su propio campo magnético fluctúa periódicamente, casi como la respiración, y en su punto máximo, el campo es casi tan fuerte como el de un imán de neodimio.", "Mariru")
	await novel_interface.show_dialog("En el momento en que detecta radiación, su campo magnético aumenta bruscamente, alcanzando una intensidad demasiado alta para medirla.", "Mariru")
	await novel_interface.show_dialog("El experimento no sólo fracasó, sino que casi hizo estallar toda la estación de investigación.", "Mariru")
	novel_interface.change_background("res://assets/images/bg/APT/livingRoom.png")
	novel_interface.show_character("anne_normal","happy")
	await novel_interface.show_dialog("... ¿Qué pasa si, digamos, intento abrirlo?", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("Aunque el meteorito en sí no es especialmente duro, cualquier intento de dañar su estructura hace que emita intenso calor y radiación.", "Mariru")
	await novel_interface.show_dialog("Según nuestros cálculos, si alguien lo abriera por la fuerza, la energía liberada sería suficiente para acabar con la mitad del planeta.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("No es de extrañar que la investigación esté prohibida...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("También es extremadamente inestable: una bomba de tiempo que nadie sabe cuándo explotará.", "Mariru")
	await novel_interface.show_dialog("Hovering Palace intentó todas las formas posibles para deshacerse del meteorito. Al final, la iglesia accedió a hacerse cargo y Samonton concedió el permiso.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Hablando de la iglesia. Sonya me envió un correo electrónico esta tarde. Adjunto una fotografía de ella en el taller Penitenciario.")
	await novel_interface.show_text_only("Después del último incidente, Sonya regresó a la iglesia. Dijo que necesitaba investigar algo y actualizar algunas \"herramientas\".")
	await novel_interface.show_text_only("La habitación de su foto estaba llena de equipos costosos. Casi lo confundí con una instalación SRD.")
	await novel_interface.show_text_only("Si Sonya no estuviera usando su uniforme de monja, no habría nada en esa imagen que hiciera que la gente conectara el lugar con la religión.")
	novel_interface.show_character("ren_battle","speechless")
	await novel_interface.show_dialog("(Parece que la iglesia realmente aceptará cualquier cosa y a cualquiera, siempre y cuando el precio sea correcto...)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("El meteoro no pudo ser transportado en avión debido a su fuerte magnetismo. La única manera segura era por barco.", "Mariru")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("Lo que llevó a otro problema: una vez que el barco pasara por el Canal de Suez, podría terminar violando toda una serie de convenciones internacionales...", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_normal","normal1",0.25)
	await novel_interface.show_dialog("¿Y ahí es donde entró Lebona?", "Annie")
	novel_interface.character_light(0.35,"normal1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("¡Exactamente! El Palacio Flotante incluso proporcionó Sustancia H para construir una bóveda segura en la nave para bloquear la radiación y los campos magnéticos.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"panic")
	await novel_interface.show_dialog("Y al filtrarnos toda esta información...", "Annie")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru asiente mientras confirma la teoría de Annie.")
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("Sin embargo, ya has entrado en contacto con algo similar a este meteorito antes.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("¿Ah?", "Lian")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_TheLastJudgement.png")
	await novel_interface.show_text_only("Mientras le respondo, ya me distraigo con una de las fotos del correo electrónico. Es una toma de El Juicio Final, el fresco que Sonya fotografió en la Capilla Sixtina.")
	await novel_interface.show_text_only("Aliviado al ver que Sonya todavía puede moverse libremente por la iglesia, empiezo a buscar información sobre el fresco.")
	await novel_interface.show_dialog("(Miguel Ángel... Es de la misma época que Henriette).", "Lian")
	await novel_interface.show_dialog("Parece que todos los genios de esa época tenían una obsesión con los cuerpos desnudos...", "Lian")
	novel_interface.change_background("res://assets/images/bg/APT/livingRoom.png")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("\"El pilar de lapislázuli de Tesheim\" de Henriette.", "Mariru")
	await novel_interface.show_dialog("La temperatura de la superficie del pilar también fluctúa, al igual que la respiración.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_normal","stare")
	await novel_interface.show_dialog("Entonces...", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Tanto Mariru como Annie se giran para mirarme. De repente la habitación queda en silencio.")
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("Ejem...", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","speechless")
	await novel_interface.show_dialog("?", "Lian")
	novel_interface.change_expression("panic")
	await novel_interface.show_dialog("¿Eh?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("...")
	novel_interface.change_music("res://assets/audio/music/Shop.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_Vault.png")
	await novel_interface.show_text_only("Para evitar que vuelva a ocurrir otro incidente de \"Puerta del Cielo\", Mariru cambió el protocolo SID.")
	await novel_interface.show_text_only("Es obligatorio hacer un seguimiento de toda la información relacionada con la Sustancia H de nivel EX.")
	await novel_interface.show_text_only("\"No se puede salvar al mundo entero quedándose dentro de New Opulentia. También necesitamos una llave del Consejo Unido\".")
	novel_interface.show_character("ren_full","panic")
	await novel_interface.show_dialog("(Cierto, pero...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Esos hombres con trajes de combate especiales negros vienen a mi mente, al igual que mi miedo.")
	novel_interface.show_character("ren_full","uneasy")
	await novel_interface.show_dialog("(Sólo espero que mi llave no se rompa en la cerradura...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Abro de mala gana la caja fuerte número 0812 y miro el meteorito negro almacenado en su interior.")
	await novel_interface.show_text_only("Según Aya, la habitación en la que estoy debería poder resistir incluso la hechicería más fuerte.")
	await novel_interface.show_text_only("Además de eso, hay una Unidad de Respuesta Táctica a bordo de este barco casino, lista para manejar cualquier tipo de emergencia.")
	novel_interface.show_character("ren_full","upset")
	await novel_interface.show_dialog("¿Entonces sólo necesito tocarlo una vez?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("¿Nervioso o asustado? No estoy seguro. Pero casi podía sentir la sangre correr por mis venas.")
	await novel_interface.show_text_only("Extiendo mi mano lentamente hacia el meteoro y cierro los ojos.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("...")
	await novel_interface.show_text_only("...")
	await novel_interface.show_text_only("Se siente... ¿suave?")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_Vault.png")
	await novel_interface.show_text_only("Abro los ojos de nuevo. Mi palma ya está apoyada sobre el meteorito. Es duro y ligeramente húmedo.")
	novel_interface.show_character("ren_full","panic")
	await novel_interface.show_dialog("(¿Era sólo mi imaginación? Podría jurar que toqué algo suave...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Toco el meteoro de nuevo. De hecho, es duro y plano.")
	await novel_interface.show_text_only("Según el plan original, se suponía que debía tocar el meteoro sólo una vez.")
	await novel_interface.show_text_only("Confundido, cierro la caja fuerte y vuelvo a poner la cerradura en su lugar. Luego me quedo quieto frente a él, todavía tratando de descubrir qué sentí la primera vez.")
	novel_interface.show_character("ren_full","upset")
	await novel_interface.show_dialog("(¿Qué fue eso...?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("De repente, un sonido extraño viene detrás de mí, como un botón cayendo al suelo.")
	await novel_interface.show_text_only("En esta pequeña habitación sellada, el ruido del objeto rodando por el suelo suena anormalmente claro.")
	novel_interface.show_character("ren_full","normal1")
	await novel_interface.show_dialog("?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Me doy la vuelta: es una cosita amarilla diminuta. Me acerco y lo recojo.")
	await novel_interface.show_text_only("Es un objeto diminuto y redondo con ocho pequeñas protuberancias en su superficie.")
	novel_interface.show_character("ren_full","wry_smile")
	await novel_interface.show_dialog("... ¿Se me cayó el vestido?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Pero se parece al dulce konpeito que solía comer cuando era pequeña. Por un segundo casi quiero lamerlo.")
	await novel_interface.show_dialog("¿Eh?", "???")
	await novel_interface.show_text_only("¡Es la voz de una niña!")
	novel_interface.show_character("stardust_small","smile")
	await novel_interface.show_dialog("¿Eh? ¿Qué se supone que debo estar buscando?", "Stardust")

	print("=== 星尘降临篇第5话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
