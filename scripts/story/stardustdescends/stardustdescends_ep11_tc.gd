# stardustdescends_ep11.gd - 星尘降临篇第11话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	stardustdescends_ep11_script()

func play_script():
	pass

func stardustdescends_ep11_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_MasadMuseum.png")
	novel_interface.show_character("ren_medical","normal1")
	await novel_interface.show_dialog("馬薩達國家博物館……就是在這兒？", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("我拿著手機，確認自己已經到達了目標位置。")
	await novel_interface.show_text_only("讓我意外的是，這座國家博物館的大部分展廳都設在半地下的空間內。")
	await novel_interface.show_text_only("正門入口處矗立的黑色石壁，據稱內部石材取自舊都聖殿山西側老城牆的廢墟。")
	await novel_interface.show_text_only("石壁外嚴密包裹的黑色防輻射材料，似乎在默默訴說著那場浩劫帶來的創傷和苦難。")
	await novel_interface.show_text_only("整面牆就像一座巨大的墓碑，幾位老人正站在牆下低頭輕撫牆壁，不知是在悼念還是在祈禱……")
	novel_interface.show_character("ren_medical","uneasy")
	await novel_interface.show_dialog("是在這裡登記吧……？", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("我用胸卡在場館門口的無人櫃檯登入並完成了面部生物掃描。")
	await novel_interface.show_text_only("這張胸卡是國際醫療救援組織的加密通證，專為經常出入交戰區的醫務人員設計。")
	await novel_interface.show_text_only("除了儲存個人資訊和醫療記錄，憑這個通證還能在全球範圍內呼叫組織的通訊裝置和救援物資。")
	await novel_interface.show_text_only("甚至還預存了一筆離線電子貨幣，據說是用於被綁架時支付贖金……")
	novel_interface.show_character("ren_medical","wry_smile")
	await novel_interface.show_dialog("（一個實習護士根本用不著這些許可權吧！）
（莉琉真是的……）", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("總之別讓我去執行什麼危險的任務就好……")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("……")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_FirstExhibition.png")
	await novel_interface.show_text_only("我順著扶梯進入第一展廳，並不寬敞的空間內陳列著很多石刻浮雕。")
	await novel_interface.show_text_only("那些清晰可見的風蝕痕跡，每一道都像是在講述著遙遠而滄桑的歷史。")
	await novel_interface.show_text_only("然而我對歷史並不感興趣，只是一邊刷手機一邊盤算著要如何度過這難熬的三小時。")
	novel_interface.show_character("ren_medical","panic")
	await novel_interface.show_dialog("那個是……講解員！？", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("在AI合成語音裝置如此普及的今天，我已經很久沒見過真人講解員了。")
	novel_interface.show_character("ren_medical","stare")
	await novel_interface.show_dialog("（馬薩達人口不是很稀缺嗎……）", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("那是一位鬍子花白的老者，大概六十多歲，頭戴黑色小圓帽，西服領口彆著工作證。")
	await novel_interface.show_text_only("他耐心的引導大家領取摺頁傳單，同時笑容慈祥的回應著每一個向他詢問的人。")
	await novel_interface.show_text_only("我有些好奇的湊了過去，他正在給幾位遊客介紹博物館的歷史──")
	await novel_interface.show_dialog("雖然很多珍貴的文物，都和原本的國家博物館一起在戰爭中損毀了。", "講解員")
	await novel_interface.show_dialog("但這座新博物館近些年收藏了很多西亞和非洲的珍貴文物，使它們能夠免遭戰火的蹂躪……", "講解員")
	await novel_interface.show_text_only("我看了看宣傳頁背面印的埃及木乃伊和青銅面具。")
	novel_interface.show_character("ren_medical","wail")
	await novel_interface.show_dialog("（就是從人家那兒搶過來的吧！）", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("不過目前世界上大多數珍貴歷史文物都由六大學園都市保管，這種事也見怪不怪了。")
	await novel_interface.show_text_only("我注意到他在聲情並茂的講解時，左手一直插在西服口袋裡。")
	novel_interface.show_character("ren_medical","bored")
	await novel_interface.show_dialog("（可能是某種特殊的宗教習慣吧……）", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("我環視四周，好在今天不是安息日，參觀者並不算多，而且場館內也沒有醫療組織的其他成員。")
	await novel_interface.show_text_only("NGO成員進行“參觀學習”的必要流程是首先在歷史和文獻館停留三十分鐘以上。")
	await novel_interface.show_text_only("我百無聊賴的閒逛，視線不禁被同場參觀的幾個當地人和十幾個小孩吸引住了。")
	await novel_interface.show_text_only("那群人裡兩個四十多歲的男人最是搶眼──他們都蓄著大鬍子，兩鬢的頭髮梳成了奇怪的小辮。")
	await novel_interface.show_text_only("二人統一身穿白襯衫和黑色及膝外套，頭上戴著黑色平頂卷簷帽，像是來自某種奇怪的組織。")
	await novel_interface.show_text_only("那十幾個小孩跟在男人周圍，無論男生女生都穿著同樣款式且只有黑白兩色布料的衣服。")
	novel_interface.show_character("ren_medical","bored")
	await novel_interface.show_dialog("（是附近學校組織參觀嗎？）
（不過這學校的年級跨度有點大啊……）", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("那群小孩從三四歲到十來歲均勻分佈，最小的路都走不穩，而年齡稍大的幾個孩子則在叫喊打鬧。")
	await novel_interface.show_text_only("人群后面，默默的跟著兩位身材鬆垮面容憔悴的中年婦女。")
	novel_interface.show_character("ren_medical","stare")
	await novel_interface.show_dialog("（那兩個不會是老師吧……）", "小憐")
	await novel_interface.show_dialog("（怎麼其中一個還推著嬰兒車？）", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("真是奇怪的組合……")
	await novel_interface.show_text_only("歷史館的參觀很快就結束了，講解員開始帶著大家前往文獻館。")
	await novel_interface.show_text_only("他調整了下夾在衣領上的麥克風，清了清嗓子──")
	await novel_interface.show_dialog("接下來，我將帶各位參觀本館最重要的展品。", "講解員")
	await novel_interface.show_dialog("下一個展廳禁止拍照，請大家收起手機，跟隨我進入聖書之龕。", "講解員")
	await novel_interface.show_text_only("聽到這話，那群打鬧的小朋友立刻安靜了下來，同行的兩個黑衣男人也變得表情肅穆。")
	await novel_interface.show_text_only("我收起手機，滿心好奇的跟了上去。")
	await novel_interface.hide_background()
	await novel_interface.stop_music()
	await novel_interface.show_text_only("講解員掃描掌紋資訊後，歷史展廳的一扇玄武石大門緩緩開啟，露出後面幽長的石質走廊。")
	await novel_interface.show_text_only("我和二十多位參觀者魚貫進入，好像被某種莊重的氛圍所感染，所有人小心翼翼一言不發。")
	await novel_interface.show_text_only("……")
	novel_interface.change_music("res://assets/audio/music/Normal Stage.mp3")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_SOTB.png")
	novel_interface.show_character("ren_medical","panic")
	await novel_interface.show_dialog("這是……", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("走廊末端連線著一個造型奇異的空間。")
	await novel_interface.show_text_only("聖書之龕的展廳呈正圓形，規則等距的環狀條紋從牆壁一直蔓延到頂部的天窗。")
	await novel_interface.show_text_only("從天窗射入的光線落在正中的展臺上，讓這裡的環境顯得靜謐而神聖。")
	await novel_interface.show_text_only("整個空間被設計得像是一個陶罐，周圍的牆壁也採用了類似陶土質地的材料。")
	await novel_interface.show_text_only("石階上經筒樣式的圓形展臺內，陳列著一卷發黃斑駁的古老羊皮卷。")
	await novel_interface.show_text_only("我拾級而上湊近觀察，展臺外層的防護玻璃目測至少五釐米厚，經卷上的希伯來字元大多清晰可見。")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_DSS.png")
	await novel_interface.show_dialog("難道這就是──", "小憐")
	await novel_interface.show_text_only("就是那部動畫裡出現過的那個那個……")
	await novel_interface.show_dialog("這是在死海西北側山洞中發現的古代文獻，被稱為上個世紀最偉大的考古發現的『死海古卷』。", "講解員")
	await novel_interface.show_dialog("死海古卷規模非常浩大，包含從12個洞穴中發掘出的五百多份文書──", "講解員")
	await novel_interface.show_dialog("而現在展櫃中的這份，正是死海古卷中『摩西五經』《創世紀》的部分稿頁。", "講解員")
	await novel_interface.show_dialog("它記載了神創世的過程以及如何選擇馬薩達人成為的自己選民，是這個國家最重要的歷史文物。", "講解員")
	await novel_interface.show_text_only("說來，馬薩達人好像一直自詡為神的選民吧……")
	await novel_interface.show_text_only("不過我向來對這種宗教故事不感興趣──")
	await novel_interface.show_text_only("全世界的民族有一個算一個，誰家沒幾個當神仙的祖先啊……")
	await novel_interface.show_text_only("但幾個本地遊客顯然不這麼認為，那兩個戴著奇怪帽子的大叔更是立刻面向展櫃禱告了起來。")
	await novel_interface.show_text_only("講解員用他低沉而慈祥聲音接著說道。")
	await novel_interface.show_dialog("這段書稿記錄了先祖亞伯拉罕、以撒、雅各和他十二個兒子的故事。", "講解員")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_TheThree.png")
	await novel_interface.show_dialog("亞伯拉罕是諸多宗教的先知，還是希伯來人和和阿拉伯人的共同祖先。", "講解員")
	await novel_interface.show_dialog("亞伯拉罕是上主從眾生中撿選並給予祝福的人。", "講解員")
	await novel_interface.show_dialog("神曾與亞伯拉罕立約，應許將一片豐沃的土地賜予他的嫡子、嫡孫以及嫡孫所延續的後代。", "講解員")
	await novel_interface.show_dialog("這片土地從尼羅河延續至幼發拉底河，就是今天我們所說的『應許之地』。", "講解員")
	await novel_interface.show_dialog("後來亞伯拉罕生嫡子以撒，以撒生嫡子以掃，他的次子叫做雅各……", "講解員")
	await novel_interface.show_dialog("（等等……雅各？）", "小憐")
	await novel_interface.show_text_only("伊露卡原來那個管理員不就叫這個名字嗎！")
	await novel_interface.show_text_only("不過西方人確實喜歡用宗教經典中的角色為自己的子女命名……")
	await novel_interface.show_text_only("講解員頓了頓，扶起老花鏡繼續講解古捲上內容。")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_MessOfPottage.png")
	await novel_interface.show_dialog("根據經文中的記載，以撒的次子雅各曾用一碗紅豆湯買下了哥哥以掃的長子權。", "講解員")
	await novel_interface.show_dialog("根據亞伯拉罕與神的契約，獲得長子權的雅各就擁有了『應許之地』的合法繼承權。", "講解員")
	await novel_interface.show_dialog("雅各後來成為了馬薩達的聖祖，他的十二個兒子就是馬薩達各支派的十二先祖……", "講解員")
	await novel_interface.show_text_only("聽到這裡，我感到腦袋有些發脹。")
	await novel_interface.show_text_only("等一下……紅豆湯是什麼鬼！？
古人這麼隨便的嗎？")
	await novel_interface.show_text_only("而且這麼說的話，所有馬薩達人都是那個雅各的後裔啊……")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_DSS.png")
	await novel_interface.show_text_only("講解員沿環形的展臺向前走了兩步，端詳著書卷末尾的文字繼續說道。")
	await novel_interface.show_dialog("這裡是《創世紀》結尾的部分──", "講解員")
	await novel_interface.show_dialog("聖祖雅各的一生充滿傳奇，他曾夢見天堂之門，聽見神重申對他祖父的誓約。", "講解員")
	await novel_interface.show_dialog("他曾與神摔跤而瘸腿，而被賜予了聖名。", "講解員")
	await novel_interface.show_dialog("雅各晚年住在埃及地十七年，在他死前，找來了自己的兒子約瑟……", "講解員")
	await novel_interface.show_dialog("雅各要兒子起誓，必要將他帶出埃及，葬在迦南地希伯侖的麥比拉洞。", "講解員")
	await novel_interface.show_dialog("那是當年由亞伯拉罕買下，安葬著雅各的父母和祖父母的家族墓地。", "講解員")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("文稿就在這裡截止。")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_SOTB.png")
	novel_interface.show_character("ren_medical","worry")
	await novel_interface.show_dialog("（麥比拉洞……這個名字怎麼有點熟悉）", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("昨晚愛衣的簡報裡似乎有提到過……是不是前兩天發生過什麼爆炸？")
	await novel_interface.show_text_only("哎呀記不清了，反正這些外國的人名地名聽起來都差不多……")
	await novel_interface.show_text_only("講解員輕撫著展櫃的玻璃，低聲感嘆。")
	await novel_interface.show_dialog("馬薩達是個歷史悠久的民族，也很重視考古發掘。", "講解員")
	await novel_interface.show_dialog("從第一份古卷被發現的那天，『死海古卷』的發掘和復原工作已經持續了八十多年。", "講解員")
	await novel_interface.show_dialog("那是我們祖先寶貴的遺產，也是我們的根源。", "講解員")
	await novel_interface.show_dialog("然而……", "講解員")
	await novel_interface.show_text_only("講解員走下樓梯，來到展廳一側的巨幅油畫處。")
	novel_interface.change_music("res://assets/audio/music/Hero.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_TheJewishWar.png")
	await novel_interface.show_text_only("他在油畫前意味深長的駐足凝望了許久。")
	await novel_interface.show_text_only("這幅油畫篇幅宏大，幾乎佔據了一整面牆。")
	await novel_interface.show_dialog("然而我們的歷史，也充滿了苦難。", "講解員")
	await novel_interface.show_text_only("他轉過身來，嘴角微微抽動了一下，好像在極力壓抑著某些痛苦的回憶。")
	await novel_interface.show_dialog("這幅畫是根據公元一世紀的歷史學家弗拉維奧·約瑟夫斯的著作創作而成。", "講解員")
	await novel_interface.show_dialog("當時強大的羅馬帝國征服了聖城，一百多萬馬薩達先民被軍團士兵屠戮。", "講解員")
	await novel_interface.show_dialog("而這幅畫，講述的就是第二聖殿被點燃的那一天。", "講解員")
	await novel_interface.show_dialog("那是馬薩達歷史上最悲傷的日子……然而這只是上千年苦難的開端。", "講解員")
	await novel_interface.show_dialog("公元七十年，我們的先祖被羅馬人大批的從猶地亞流放出去。", "講解員")
	await novel_interface.show_dialog("不甘心被逐出故土的人打算奮起反抗，其中一千多名起義軍，將當年的馬薩達作為了最後的堡壘。", "講解員")
	await novel_interface.show_dialog("他們堅守在這座城池，在羅馬人的圍困下固守了足足兩年，直到水源被斷再無餘力。", "講解員")
	await novel_interface.show_dialog("當第十軍團終於破城而入時，他們的總督看到的僅僅是九百多具屍體和被燒燬的建築──", "講解員")
	await novel_interface.show_dialog("守城將士因不想屈從成為羅馬的奴隸而全部選擇自殺，最後僅有兩個大人和五個小孩活了下來……", "講解員")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("我想象著當時的畫面，感到有些揪心。")
	await novel_interface.show_text_only("講解員沉默許久，轉過身來面對我們繼續說道。")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_SOTB.png")
