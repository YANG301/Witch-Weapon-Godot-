	await novel_interface.show_dialog("E per quanto riguarda il nome \"Lucy\"...", "Ragazza")
	await novel_interface.show_dialog("Dicono che quando è stata scoperta, il registratore nel sito degli scavi stava suonando \"Lucy in the Sky with Diamonds\" dei Beatles.", "Ragazza")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("La sua voce era gentile e pura, come se stesse descrivendo il cielo notturno stellato sul continente africano più di tre milioni di anni fa.")
	novel_interface.show_character("ren_medical","perspire1")
	await novel_interface.show_dialog("\"Nonna dell'umanità\" significa...\nche è l'antenata di moltissime persone?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("stardust_big","normal")
	await novel_interface.show_dialog("Non necessariamente~", "Ragazza")
	await novel_interface.show_dialog("Lucy fu uno dei primi esseri umani a camminare eretti, ma era solo un membro di quella popolazione.", "Ragazza")
	await novel_interface.show_dialog("Alcuni scienziati sostengono addirittura che, poiché le dimensioni del cervello umano non avevano ancora iniziato ad aumentare in quella fase, non si può giudicare il sesso dalla dimensione dell'apertura pelvica.", "Ragazza")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sorridendo, si avvicinò al mio orecchio e sussurrò.")
	novel_interface.show_character("stardust_big","smile1")
	await novel_interface.show_dialog("Quindi...\nAnche Lucy potrebbe non essere stata una ragazza~", "Ragazza")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","awkward")
	await novel_interface.show_dialog("--Eh?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Un brivido formicolio mi percorse e feci in fretta qualche passo indietro.")
