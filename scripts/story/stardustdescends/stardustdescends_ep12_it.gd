	novel_interface.show_character("ren_medical","blush")
	await novel_interface.show_dialog("(S-lei è così carina!)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ero così ipnotizzato dal suo viso che mi ci è voluto un po' per ricordarmi che dovevo salutarla.")
