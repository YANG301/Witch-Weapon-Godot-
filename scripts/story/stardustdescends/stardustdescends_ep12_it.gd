	novel_interface.show_character("ren_medical","shy_right")
	await novel_interface.show_dialog("(E smettila di respirarmi nell'orecchio~~~!!)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sembrava piuttosto soddisfatta della mia reazione agitata, poi cambiò argomento e continuò:")
	novel_interface.show_character("stardust_big","normal")
	await novel_interface.show_dialog("È passato così tanto tempo che è impossibile recuperare il DNA di Lucy e verificarlo adesso.", "Ragazza")
	await novel_interface.show_dialog("Ma se un corpo fosse rimasto sigillato e preservato, la più recente tecnologia di analisi genetica di Samonton potrebbe ancora testare la parentela.", "Ragazza")
	await novel_interface.show_dialog("Un paio di anni fa hanno estratto il DNA da una mummia di seimila anni e lo hanno confrontato con un moderno database genetico, e hanno davvero trovato dei discendenti ancora viventi oggi.", "Ragazza")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","perspire1")
	await novel_interface.show_dialog("È incredibile...?!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Questa ragazza è una studentessa di medicina da qualche parte nelle vicinanze? Ma a giudicare da come appare e da come si veste, non sembra del posto...")
	novel_interface.show_character("stardust_big","smile1")
	await novel_interface.show_dialog("In realtà, l'ho imparato solo l'ultima volta...", "Ragazza")
	novel_interface.change_expression("close_eye")
