	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("Não se preocupe. Os dois guardas estão tendo um sonho doce enquanto conversamos.", "Aya")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("Não subestime o cérebro humano – ele está disposto e é capaz de racionalizar as situações em que se encontra.", "Aya")
