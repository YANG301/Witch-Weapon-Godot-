	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aya liga o vídeo de vigilância enquanto reclama.")
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("Não é nenhum defeito. Todas as leituras voltaram ao normal rapidamente. O sensor também tem funcionado bem desde então.", "Aya")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("Mais importante ainda, apenas Lian perdeu a consciência enquanto todos os outros estavam bem...", "Aya")
