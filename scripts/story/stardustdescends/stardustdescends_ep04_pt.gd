	novel_interface.show_character("ai","blush_wink")
	await novel_interface.show_dialog("Receio que teremos que confiar em Lian agora.", "Aya")
	await novel_interface.hide_character()
	await novel_interface.hide_background_with_fade()
	await novel_interface.stop_music()
	await novel_interface.show_text_only("...")
	await novel_interface.show_text_only("Cinco dias depois – a bordo do navio cassino de Lebona, Liberty Star")
	novel_interface.change_music("res://assets/audio/music/Shop.mp3")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_Gambling_Boat.png")
	await novel_interface.show_dialog("Hum... senhorita?", "Crupiê")
	await novel_interface.show_dialog("Senhorita?", "Crupiê")
	novel_interface.show_character("ren_full","panic")
	await novel_interface.show_dialog("É a minha vez?", "Lian")
	await novel_interface.show_dialog("F- Dobrar...", "Lian")
	novel_interface.change_expression("perspire1")
	await novel_interface.show_dialog("Desculpe, mas tenho que sentar uma rodada.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("A garota sai da mesa e caminha até um lugar tranquilo no canto do corredor.")
	novel_interface.show_character("ren_full","wry_smile")
	await novel_interface.show_dialog("Eu tive um rubor! Por que você me disse para desistir?!", "Lian")
	await novel_interface.show_dialog("(abaixa a voz). Principalmente depois de já ter apostado tanto dinheiro...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("A voz baixa de Lian não consegue esconder sua decepção.")
	await novel_interface.show_dialog("Pegue seu telefone e finja que está em uma ligação, Lian. Neste momento, para todos os outros, parece que você está murmurando para si mesmo.", "Annie")
	await novel_interface.show_dialog("Existem três salas de controle neste navio. Eu já assaltei um...", "Annie")
	novel_interface.show_character("ren_full","wail")
	await novel_interface.show_dialog("(R-Raid?!...)", "Lian")
	await novel_interface.hide_character()
