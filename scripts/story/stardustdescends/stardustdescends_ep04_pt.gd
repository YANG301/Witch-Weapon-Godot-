	await novel_interface.show_dialog("...Lembre-me novamente do tamanho de uma unidade YB?", "Mariru")
	novel_interface.show_character("ai","blush_dizzy")
	await novel_interface.show_dialog("Um yottabyte equivale a 10 elevado à 24ª potência de bytes - mais do que todos os dados da Internet pré-guerra combinados...", "Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("A voz de Aya está tremendo de excitação.")
	novel_interface.show_character("ai","blush_dizzy")
	await novel_interface.show_dialog("E eu pensei que o cérebro dela só servia para jogos...", "Aya")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Yottabyte. Acho que vi isso no relatório do professor Shih!", "Mariru")
	novel_interface.show_character("ai","blush_stare")
	await novel_interface.show_dialog("Aquele antigo meteoro no Palácio Flutuante!", "Aya")
	await novel_interface.hide_character()
