	await novel_interface.show_text_only("Sinto arrepios na espinha. Eu rapidamente pego meu telefone.")
	novel_interface.show_character("ren_full","upset")
	await novel_interface.show_dialog("Já perdi 20% do que trouxe. Você não disse que eu tinha que dobrar meu dinheiro antes de poder entrar na sala VIP?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Estou olhando para o número na pulseira que o cassino emitiu e dizendo a mim mesmo repetidamente: isso não é dinheiro.")
