	await novel_interface.show_dialog("Talvez os rumores fossem realmente verdadeiros...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Chips feitos de Substância H que podem suportar fortes impactos, campos magnéticos e altas temperaturas; eles podem ser sacados em centenas de cassinos em todo o mundo.")
	await novel_interface.show_text_only("É sem dúvida o título ao portador de maior valor.")
	await novel_interface.show_dialog("Sequestrámos todas as suas câmaras de vigilância. É uma tentativa quando você estiver pronto! ", "Annie")
	await novel_interface.show_text_only("Finalmente, algumas boas notícias!")

	print("=== 星尘降临篇第4话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
