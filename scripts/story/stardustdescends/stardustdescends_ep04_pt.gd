	await novel_interface.show_text_only("Aya rapidamente descarta possibilidades. No final, parece haver apenas uma explicação...")
	novel_interface.show_character("ai","blush_dizzy")
	await novel_interface.show_dialog("Lian – e apenas Lian – absorveu 2,5 YB de dados em menos de um segundo...", "Aya")
	await novel_interface.hide_character()
