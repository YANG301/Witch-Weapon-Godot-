	await novel_interface.show_dialog("(Mas ainda é dinheiro suado dos contribuintes de New Opulentia!)", "Lian")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Dispatched_Ship_Aisle.png")
	await novel_interface.show_text_only("A trinta mil metros de altura, a bordo de um transporte pesado de alta velocidade SID, Nix observa a tela de projeção com uma xícara de chá na mão.")
	novel_interface.show_character("nyx_normal","normal1")
	await novel_interface.show_dialog("Você só tinha 2 e 6 de ouros. A julgar pelo comportamento dele, havia uma grande chance de ele ter um flush também, e as cartas dele eram quase certamente mais altas que as suas.", "Nix")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Sério?!\nEu estava prestes a apostar tudo...", "Lian")
	novel_interface.show_character("nyx_normal","speak")
	await novel_interface.show_dialog("*suspiro*", "Nix")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ela não tem ideia de como explicar isso claramente para Lian, a mesma garota que adormeceu babando em uma pilha de fichas no valor de cinquenta milhões na noite passada.")
	novel_interface.show_character("nyx_normal","normal2")
	await novel_interface.show_dialog("O erro mais comum que um novato comete é que sempre que ele tem uma boa mão, ele quer apostar alto, até mesmo ir all-in.", "Nix")
	await novel_interface.show_dialog("Como se a mão boa os privasse da capacidade de realizar qualquer pensamento analítico.", "Nix")
	await novel_interface.show_dialog("A ignorância leva ao medo; o medo leva à imprudência. No final, os novatos podem apostar tudo para acabar com o medo.", "Nix")
	novel_interface.change_expression("sad")
	await novel_interface.show_dialog("Eles só se sentirão livres depois de apostarem tudo o que têm.", "Nix")
	await novel_interface.show_dialog("O resultado é que seu oponente pode facilmente prever sua decisão a partir de seu comportamento.", "Nix")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Resumindo, você não ganhará muito dinheiro quando tiver uma boa mão e perderá tudo quando seu oponente tiver uma mão melhor.", "Nix")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("Qualquer um que joga fora tudo o que tem é esse tipo de tolo.", "Nix")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Isso é duro!", "Lian")
	await novel_interface.show_text_only("Lian estremece incontrolavelmente.")
	await novel_interface.show_text_only("Nix toma um gole de chá e continua.")
	novel_interface.show_character("nyx_normal","mock")
	await novel_interface.show_dialog("Ouça, Texas Hold'em é um jogo baseado em turnos.", "Nix")
	await novel_interface.show_dialog("O que mais importa não são as suas cartas, mas sim os seus oponentes.", "Nix")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_Choice.png")
