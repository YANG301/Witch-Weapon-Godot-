	await novel_interface.show_dialog("O sensor Boltzmann ultrapassou sua leitura máxima no momento em que as testas de Lian e Nix se tocaram.", "Aya")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Uma avaria? Achei que você já tinha definido o limite teórico para o valor mais alto possível.", "Mariru")
	novel_interface.show_character("ai","think")
