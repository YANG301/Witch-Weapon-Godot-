# stardustdescends_ep18.gd - 星尘降临篇第18话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	stardustdescends_ep18_script()

func play_script():
	pass

func stardustdescends_ep18_script():
	novel_interface.change_music("res://assets/audio/music/Sewer.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_Psychology.png")
	await novel_interface.show_text_only("Mọi người đều từng trải qua nỗi đau nội tâm - một điều gì đó quá thật, quá nặng nề, quá đau đớn, quá khó chịu đựng.")
	await novel_interface.show_text_only("Thế nhưng ít người biết rằng hầu hết nỗi đau tâm lý đều được trải qua sau khi sinh.")
	await novel_interface.show_text_only("Một đứa trẻ có thể vui vẻ cả ngày chỉ với một chiếc đùi gà cũng không thể hiểu được nỗi đau khi bị các bạn cùng lớp loại trừ, cô lập trên mạng xã hội.")
	await novel_interface.show_text_only("Cho dù bạn đau khổ vì không thể hòa nhập vào một nhóm, vì những người xung quanh không chấp nhận bạn, hay vì bạn không thể trở thành con người mà bạn tưởng tượng...")
	await novel_interface.show_text_only("Tất cả nỗi đau đó đều được xây dựng trên những khái niệm phức tạp, không gì khác hơn là sản phẩm phụ của những ý nghĩa chồng chất được học sau sự việc.")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_Camus.png")
	await novel_interface.show_text_only("Camus cho rằng sự phi lý của loài người nằm ở việc không ngừng tìm kiếm ý nghĩa trong một vũ trụ vô nghĩa.")
	await novel_interface.show_text_only("Dưới xiềng xích của ý nghĩa, không ai có thể có được tự do đích thực.")
	await novel_interface.show_text_only("Nền văn minh nhân loại không thể tồn tại mà không có ý nghĩa; nó là nền tảng của các hệ thống xã hội ở mọi thời đại.")
	await novel_interface.show_text_only("Ý nghĩa của dòng tộc, ý nghĩa của quốc gia, ý nghĩa của chúa tể, ý nghĩa của tôn giáo, thậm chí cả bản sắc dân tộc, hệ tư tưởng và văn hóa đại chúng ...")
	await novel_interface.show_text_only("Một khi hệ thống ý nghĩa đã thấm nhuần trong bạn, mọi loại ý tưởng sẽ hình thành một cách tự nhiên và một bậc thang giá trị sẽ được xây dựng trong tâm trí bạn--")
	await novel_interface.show_text_only("Điều gì đáng được khen ngợi và thăng tiến, điều gì đáng bị khinh thường và lên án, điều gì được coi là hạnh phúc và vinh dự, điều gì sẽ mang lại đau khổ và xấu hổ...")
	await novel_interface.show_text_only("Một số người buộc phải tự tử do sự thay đổi triều đại, những người khác do thần tượng của họ kết hôn; không có sự phân biệt đúng hay sai giữa nỗi đau của họ.")
	await novel_interface.show_text_only("Nhưng nếu đầu óc bạn đủ nhạy bén, có lẽ thỉnh thoảng bạn có thể thoát khỏi xiềng xích và lẻn ra ngoài một mình tìm chút không khí.")
	await novel_interface.show_text_only("Sau đó các bạn trở về nhóm, cứ giả vờ đeo xiềng xích, khen điều mọi người khen và khinh điều mọi người chê.")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_Prisoner.png")
	await novel_interface.show_text_only("Bởi vì nếu bạn thông minh, bạn hẳn phải nhận ra điều này: nhân loại không chỉ là tù nhân của ý nghĩa mà còn sẵn sàng trở thành người cai ngục ý nghĩa.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("............")
	await novel_interface.show_text_only("...")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_ConventionCentre.png")
	await novel_interface.show_text_only("Trung tâm Hội nghị Quốc tế Masada trước lễ ký kết.")
	await novel_interface.show_text_only("Trong hội trường, các phóng viên từ hơn một trăm cơ quan truyền thông đã có mặt sẵn, với đèn flash và máy ảnh sẵn sàng ghi lại khoảnh khắc lịch sử này.")
	await novel_interface.show_text_only("Phía sau bục, một tấm màn dày màu xanh lam đã phong tỏa hoàn toàn hội trường ồn ào với khu vực hậu trường.")
	await novel_interface.show_text_only("Những dãy đèn chiếu sáng chuyên nghiệp mới tinh trên giàn trần đều ở chế độ chờ với độ sáng thấp.")
	await novel_interface.show_text_only("Các tấm cách âm được bọc vào tường và lớp cách âm trên tấm rèm khiến nơi này yên tĩnh đến lạ thường.")
	await novel_interface.show_text_only("Khi sĩ quan ngụy trang sa mạc nhìn thấy người đàn ông mặc bộ đồ màu xám đang tiến gần qua lối đi phía sau tấm màn, anh ta lập tức đứng thẳng lên và chào.")
	await novel_interface.show_text_only("Cấp hiệu trên cổ áo ngụy trang và ngôi sao sáu cánh màu vàng cho thấy anh ta là thiếu tá Lực lượng Phòng vệ.")
	await novel_interface.show_text_only("Và người mà anh ta sắp giới thiệu chính là đại diện ký kết Masadan ngày hôm nay: Thiếu tướng Hamon của Bộ Tư lệnh Lực lượng Phòng vệ phía Bắc.")
	await novel_interface.show_dialog("Báo cáo đi, thưa ông. Tôi ở đây để tóm tắt cho bạn về cuộc tấn công vừa rồi.", "Thiếu tá")
	await novel_interface.show_text_only("Thiếu tướng đã tăng cân một chút, nhưng mái tóc vẫn được chải chuốt cực kỳ chính xác, ánh mắt vẫn giữ được vẻ sắc bén đặc trưng của một người lính.")
	await novel_interface.show_text_only("Khi bước đi, anh ta sốt ruột nới lỏng cà vạt và nhét nó lại cùng với chiếc máy tính bảng bọc da màu đen trên tay.")
	novel_interface.show_character("hamon","serious")
	await novel_interface.show_dialog("Tôi không bao giờ có thể quen với việc mặc thứ này...", "Hamon")
	await novel_interface.show_dialog("Đi tiếp.", "Hamon")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Đó là báo cáo điều tra về vụ nổ ở phía tây nam trung tâm hội nghị ba mươi phút trước.", "Thiếu tá")
	await novel_interface.show_dialog("Dựa vào dấu vết tại hiện trường, đội xử lý bom kết luận đó là một quả bom nổ tự chế được chế tạo chủ yếu bằng đường.", "Thiếu tá")
	novel_interface.show_character("hamon","serious")
	await novel_interface.show_dialog("...Một quả bom tự chế làm từ đường?", "Hamon")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Có, nhưng cường độ vụ nổ không cao và không gây thương vong. Chất nổ dường như đã bao gồm các chất phụ gia làm tăng thêm khói.", "Thiếu tá")
	await novel_interface.show_dialog("Chúng tôi dập tắt đám khói ngay lập tức. Trung đoàn bảo vệ hiện đã phong tỏa khu vực xung quanh và cho đến nay vẫn chưa có cơ quan truyền thông nào đưa tin về vụ việc.", "Thiếu tá")
	await novel_interface.show_dialog("Giám sát đường phố gần đó vẫn chưa tìm thấy bất kỳ nghi phạm nào. Chúng tôi hiện đang mở rộng khu vực tìm kiếm. Báo cáo hoàn tất.", "Thiếu tá")
	novel_interface.show_character("hamon","serious")
	await novel_interface.show_dialog("...Vậy thôi à?", "Hamon")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Hamon nhìn chằm chằm vào mắt thiếu tá và không nói gì một lúc lâu. Thiếu tá không dám nói, chỉ có thể cứng ngắc đứng tại chỗ.")
	await novel_interface.show_text_only("Hamon khịt mũi, bất mãn đập mạnh chiếc máy tính bảng trong tay vào ngực thiếu tá—")
	novel_interface.show_character("hamon","speak")
	await novel_interface.show_dialog("Hãy tự mình nhìn vào nó!", "Hamon")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lảo đảo lùi lại sau cú đánh, thiếu tá vội vàng giữ chặt chiếc máy tính bảng. Trên màn hình là biểu tượng cây nến bảy nhánh mang tính biểu tượng của Monola.")
	novel_interface.show_character("hamon","serious")
	await novel_interface.show_dialog("Họ đã gửi cái này vài phút trước.", "Hamon")
	await novel_interface.show_dialog("Monola phát hiện ra ba cá nhân khả nghi đã lẻn vào bãi đậu xe ngầm.", "Hamon")
	await novel_interface.show_dialog("Hai người trong số họ lẻn vào trục thang máy với ý định phá hoại hệ thống chữa cháy của tòa nhà.", "Hamon")
	await novel_interface.show_dialog("May mắn thay, người đại diện của họ đã can thiệp kịp thời. Họ bắt được một người, nhưng hai người còn lại trốn thoát; một trong số họ đã bị trúng đạn khi đang chạy trốn.", "Hamon")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("...Trục thang máy!?\nS-Ai đó đã xâm nhập vào địa điểm?", "Thiếu tá")
	await novel_interface.show_text_only("Thiếu tá nhanh chóng lật qua bản báo cáo, đầu óc lập tức ong ong—")
	await novel_interface.show_text_only("Vụ nổ đó chỉ là một trò đánh lạc hướng sao...?")
	await novel_interface.show_text_only("Vì bãi đậu xe trên mặt đất đã bị lực lượng an ninh và xe quân sự chiếm giữ nên tất cả các xe chở thiết bị truyền thông đều đậu ở tầng hầm của trung tâm hội nghị.")
	await novel_interface.show_text_only("Khi đó, gara đỗ xe ngầm thực sự là khu vực dễ đột nhập nhất.")
	await novel_interface.show_text_only("Mặc dù Tình báo Quân đội đã triển khai an ninh chặt chẽ ở mọi ngóc ngách của tòa nhà nhưng mặt dưới cabin thang máy lại là điểm mù giám sát.")
	await novel_interface.show_text_only("Nhận thấy tuyến phòng thủ do mình bố trí đã bị chọc thủng quá dễ dàng, trán thiếu tá lập tức đổ mồ hôi.")
	novel_interface.show_character("hamon","speak")
	await novel_interface.show_dialog("Tình báo quân sự không đảm bảo với tôi rằng an ninh địa điểm được thắt chặt sao?", "Hamon")
	novel_interface.change_expression("shout")
	await novel_interface.show_dialog("Tôi đã cố tình kéo người của Monola ra và đưa họ ra vòng ngoài, và đây là cách bạn khiến tôi trông như thế này?!", "Hamon")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Nhớ tới hội trường phía sau bức màn đã chật kín phóng viên, Hamon cố ý hạ giọng khiển trách.")
	await novel_interface.show_dialog("Đây...\nI-Đó là thất bại của tôi!", "Thiếu tá")
	await novel_interface.show_dialog("Nhưng không phải đặc vụ của Monola đều đóng quân xung quanh bên ngoài trung tâm hội nghị sao?\nLàm sao họ có thể ở bên trong tòa nhà...?", "Thiếu tá")
	await novel_interface.show_text_only("Hamon lắc nhẹ đầu và vỗ nhẹ vào vai thiếu tá.")
	novel_interface.show_character("hamon","serious")
	await novel_interface.show_dialog("Trong số các phóng viên ngoài kia, ai biết có bao nhiêu người là của họ...", "Hamon")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Anh ta hoàn toàn hiểu rõ rằng Cục Tình báo Quân đội mà anh ta đã xây dựng trong hệ thống quân đội trong vài năm qua không thể so sánh với một con quái vật như Monola.")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_Speech.png")
	await novel_interface.show_text_only("\"Họ là hệ thống thần kinh của đất nước này, có thể phản ứng với mọi nguy hiểm với tốc độ nhanh nhất.\"")
	await novel_interface.show_text_only("\"Nếu ai đó bắn một mũi tên vào bạn và bạn cần phải suy nghĩ trước khi né tránh, bạn sẽ chỉ chết với một mũi tên cắm vào cơ thể.\"")
	await novel_interface.show_text_only("Chú của Hamon, Thủ tướng Schneiderman, đã từng giải thích trước quốc hội theo cách này tại sao Monola lại nắm giữ quyền điều hành tối cao không bị hạn chế.")
	await novel_interface.show_text_only("Nhưng Hamon không thể chấp nhận mọi thông tin tình báo được nắm giữ bởi một tổ chức mà anh không thể kiểm soát.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Thông tin là sức mạnh. Đó là kinh nghiệm chiến đấu mà ông đã tích lũy qua hàng chục năm, dù là chiến tranh trong hay ngoài nước.")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_ConventionCentre.png")
	novel_interface.show_character("hamon","serious")
	await novel_interface.show_dialog("Và bên cạnh đó--", "Hamon")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Anh ta nhìn viên sĩ quan đứng trước mình, người mà chính anh ta đã đề bạt, một cái nhìn đầy ẩn ý.")
	novel_interface.show_character("hamon","serious")
	await novel_interface.show_dialog("Người phụ nữ họ bắt được là một trung úy của Tiểu đoàn Caracal.", "Hamon")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("--Người của chúng ta?!", "Thiếu tá")
	novel_interface.show_character("hamon","serious")
	await novel_interface.show_dialog("Và một học viên từ Tower, lúc đó...", "Hamon")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Hamon nói từng chữ một.")
	await novel_interface.show_text_only("Nhận thức được những hậu quả chính trị mà việc này có thể gây ra, thiếu tá không khỏi nín thở—")
	await novel_interface.show_text_only("Luôn có nhiều tiếng nói trong Lực lượng Phòng vệ phản đối thỏa thuận này, đặc biệt là trong số những người lính cứu hỏa trẻ tuổi mong muốn khẳng định mình.")
	novel_interface.show_character("hamon","serious")
	await novel_interface.show_dialog("Điều kỳ lạ hơn nữa là dấu vân tay lấy tại hiện trường cho thấy trong số những người đi cùng cô có một người nước ngoài đã đăng ký nhập cư cách đây vài ngày.", "Hamon")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Một... gián điệp ở nước ngoài?", "Thiếu tá")
	await novel_interface.show_text_only("Hamon nhíu mày suy nghĩ một lúc.")
	novel_interface.show_character("hamon","speak")
	await novel_interface.show_dialog("Điều đó là có thể. Dù thế nào đi nữa, tôi đã yêu cầu Monola chia sẻ tất cả thông tin của họ trước, nhưng bạn không thể mong đợi họ hợp tác nhiều được...", "Hamon")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("Tôi đã cho trung đoàn bảo vệ giữ trung úy đó. Cô ấy hiện đang ở trong phòng an toàn trên lầu và cũng do bạn phụ trách.", "Hamon")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Vâng, thưa ngài!", "Thiếu tá")
	await novel_interface.show_text_only("Hamon quay đi, chỉnh lại cổ áo và thắt cà vạt lại.")
	novel_interface.show_character("hamon","speak")
	await novel_interface.show_dialog("Buổi lễ sắp bắt đầu...\nĐừng gây thêm rắc rối cho tôi nữa!", "Hamon")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Vâng! Tôi xin hứa, thưa ngài!", "Thiếu tá")
	await novel_interface.show_text_only("Hamon dừng lại, sau đó quay lưng về phía thiếu tá u ám nói:")
	novel_interface.show_character("hamon","serious")
	await novel_interface.show_dialog("Hôm nay tôi không mặc đồng phục. Đừng gọi tôi bằng cấp bậc của tôi.", "Hamon")
	await novel_interface.show_dialog("Người dân không còn muốn binh lính lãnh đạo chính phủ nữa... hiểu không?", "Hamon")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("À... hiểu rồi!", "Thiếu tá")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("...\nTrung tâm Hội nghị Quốc tế Masada, bãi đậu xe ngoài trời.")
	await novel_interface.show_text_only("Bên trong xe bọc thép chở quân.")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_MasadAPCRS.png")
	await novel_interface.show_dialog("Đồ ngốc--!!!\nBạn đã bước thẳng vào bẫy của họ???!", "Mariru")
	await novel_interface.show_text_only("Nếu những chiếc tai nghe này không thể điều chỉnh âm lượng một cách linh hoạt thì màng nhĩ của tôi có lẽ đã chết trước khi tôi kịp làm điều đó.")
	novel_interface.show_character("ren_medical","panic")
	await novel_interface.show_dialog("Ôi...", "Lian")
	novel_interface.change_expression("wry_smile")
	await novel_interface.show_dialog("Đ-Đó...", "Lian")
	await novel_interface.show_dialog("B-Bởi vì tôi không thể liên lạc được với ai cả...", "Lian")
