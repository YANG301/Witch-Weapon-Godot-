# stardustdescends_ep11.gd - 星尘降临篇第11话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	stardustdescends_ep11_script()

func play_script():
	pass

func stardustdescends_ep11_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_MasadMuseum.png")
	novel_interface.show_character("ren_medical","normal1")
	await novel_interface.show_dialog("Museu Nacional de Massada... este é o lugar?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Segurando meu telefone, certifiquei-me de ter chegado ao local certo.")
	await novel_interface.show_text_only("O que me surpreendeu foi que a maior parte das salas de exposição deste museu nacional estavam instaladas em espaços semi-subterrâneos.")
	await novel_interface.show_text_only("Diz-se que o muro de pedra preta situado na entrada principal contém pedras retiradas das ruínas da antiga muralha da cidade, no lado oeste do Monte do Templo, na antiga capital.")
	await novel_interface.show_text_only("O material preto de proteção contra radiação enrolado firmemente na parte externa da parede parecia falar silenciosamente das feridas e do sofrimento deixados por aquela catástrofe.")
	await novel_interface.show_text_only("A parede inteira parecia uma lápide gigante. Algumas pessoas idosas estavam embaixo dela, baixando a cabeça e acariciando suavemente a pedra, e eu não sabia dizer se estavam de luto ou orando...")
	novel_interface.show_character("ren_medical","uneasy")
	await novel_interface.show_dialog("Eu me inscrevo aqui... certo?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Usei meu crachá no balcão não tripulado na entrada e fiz uma varredura biométrica facial.")
	await novel_interface.show_text_only("Este crachá era uma credencial criptografada da Organização Internacional de Assistência Médica, projetada especificamente para pessoal médico que entra e sai frequentemente de zonas de guerra.")
	await novel_interface.show_text_only("Além de armazenar informações pessoais e registros médicos, também permite que você acesse os equipamentos de comunicação e suprimentos de socorro da organização em qualquer lugar do mundo.")
	await novel_interface.show_text_only("Ele até veio pré-carregado com uma quantia em moeda eletrônica off-line, supostamente para pagar resgate se você for sequestrado...")
	novel_interface.show_character("ren_medical","wry_smile")
	await novel_interface.show_dialog("(Uma enfermeira estagiária não precisa de acesso assim, né!)\n(Mariru, honestamente...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("De qualquer forma, desde que não me obriguem a fazer nada perigoso...")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("...")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_FirstExhibition.png")
	await novel_interface.show_text_only("Desci pela escada rolante até a primeira sala de exposições, onde muitos relevos de pedra estavam expostos na sala não muito espaçosa.")
	await novel_interface.show_text_only("Os vestígios visíveis da erosão eólica pareciam contar uma história distante e desgastada.")
	await novel_interface.show_text_only("Mas eu não estava interessado em história. Eu apenas rolei no meu telefone e tentei descobrir como iria sobreviver a essas três horas miseráveis.")
	novel_interface.show_character("ren_medical","panic")
	await novel_interface.show_dialog("Isso é... um guia?!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Nos dias de hoje, quando os guias de voz de IA estão por toda parte, há muito tempo que eu não via um guia humano de verdade.")
	novel_interface.show_character("ren_medical","stare")
	await novel_interface.show_dialog("(Masada não tem desesperadamente falta de população...?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ele era um homem idoso, de barba branca, provavelmente na casa dos sessenta anos, usando um pequeno solidéu preto com um crachá de identificação preso na gola do terno.")
	await novel_interface.show_text_only("Ele guiou pacientemente todos enquanto pegavam os folhetos, sorrindo gentilmente enquanto respondia a cada pessoa que lhe perguntava algo.")
	await novel_interface.show_text_only("Curioso, cheguei mais perto. Ele estava apresentando a história do museu a alguns visitantes...")
	await novel_interface.show_dialog("Embora muitas relíquias preciosas tenham sido destruídas na guerra juntamente com o museu nacional original.", "Guia")
	await novel_interface.show_dialog("Nos últimos anos, no entanto, este novo museu colecionou muitos artefatos preciosos da Ásia Ocidental e da África, permitindo-lhes escapar da devastação da guerra...", "Guia")
	await novel_interface.show_text_only("Olhei para a múmia egípcia e a máscara de bronze impressas no verso do folheto.")
	novel_interface.show_character("ren_medical","wail")
	await novel_interface.show_dialog("(Então você os roubou desses lugares, hein!)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mas hoje em dia, a maioria dos artefatos históricos preciosos ao redor do mundo são mantidos pelas Seis Cidades Acadêmicas de qualquer maneira, então esse tipo de coisa não é incomum.")
	await novel_interface.show_text_only("Percebi que enquanto ele falava com muita emoção, sua mão esquerda ficava o tempo todo enfiada no bolso do terno.")
	novel_interface.show_character("ren_medical","bored")
	await novel_interface.show_dialog("(Talvez seja algum costume religioso especial...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Eu olhei em volta. Felizmente, hoje não era sábado, então não havia muitos visitantes e também não havia outros membros da organização médica no museu.")
	await novel_interface.show_text_only("Para os membros das ONG, o procedimento obrigatório de “visita de estudo” começa com uma passagem de pelo menos trinta minutos nas salas de história e documentação.")
	await novel_interface.show_text_only("Eu vaguei entediado e meus olhos logo foram atraídos para alguns moradores locais e mais de uma dúzia de crianças que visitavam o local ao mesmo tempo.")
	await novel_interface.show_text_only("Entre eles, os que mais chamavam a atenção eram dois homens na casa dos quarenta – ambos tinham barbas grandes e pequenas tranças estranhas penduradas nos cabelos, na altura das têmporas.")
	await novel_interface.show_text_only("Eles estavam vestidos da mesma forma: camisas brancas, casacos pretos até os joelhos e chapéus pretos de copa chata e abas curvadas, como pessoas de alguma organização estranha.")
	await novel_interface.show_text_only("Cerca de uma dúzia de crianças seguiam esses homens, e tanto meninos quanto meninas usavam as mesmas roupas pretas e brancas.")
	novel_interface.show_character("ren_medical","bored")
	await novel_interface.show_dialog("(Esta é uma excursão escolar próxima?)\n(Mas a faixa etária nesta escola é meio selvagem...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("As crianças tinham idades iguais entre três ou quatro anos e cerca de dez; os mais novos mal conseguiam andar com firmeza, enquanto algumas das crianças mais velhas gritavam e brigavam.")
	await novel_interface.show_text_only("Atrás do grupo caminhavam duas mulheres de meia-idade, com aparência cansada e corpos flácidos.")
	novel_interface.show_character("ren_medical","stare")
	await novel_interface.show_dialog("(Esses dois não são os professores... são?)", "Lian")
	await novel_interface.show_dialog("(Por que um deles está empurrando um carrinho?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Que combinação estranha...")
	await novel_interface.show_text_only("O passeio pelo salão de história terminou rapidamente e o guia começou a conduzir todos ao salão de documentos.")
	await novel_interface.show_text_only("Ele ajustou o microfone preso ao colarinho e pigarreou...")
	await novel_interface.show_dialog("A seguir, mostrarei a exposição mais importante deste museu.", "Guia")
	await novel_interface.show_dialog("A fotografia é proibida no corredor ao lado. Por favor, guardem seus telefones e sigam-me até o Santuário do Livro.", "Guia")
	await novel_interface.show_text_only("No momento em que ouviram isso, as crianças turbulentas ficaram em silêncio e os dois homens de preto também ficaram solenes.")
	await novel_interface.show_text_only("Guardei meu telefone e segui com a curiosidade queimando em meu peito.")
	await novel_interface.hide_background()
	await novel_interface.stop_music()
	await novel_interface.show_text_only("Depois que o guia examinou a impressão palmar, uma porta de basalto no salão de história se abriu lentamente, revelando um longo corredor de pedra além dela.")
	await novel_interface.show_text_only("Mais de vinte de nós entramos um após o outro. Parecia que alguma atmosfera solene nos contagiara; todos se moveram com cuidado e não disseram nada.")
	await novel_interface.show_text_only("...")
	novel_interface.change_music("res://assets/audio/music/Normal Stage.mp3")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_SOTB.png")
	novel_interface.show_character("ren_medical","panic")
	await novel_interface.show_dialog("Isto é...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("No final do corredor havia uma câmara de formato estranho.")
	await novel_interface.show_text_only("A sala de exposições do Santuário do Livro era perfeitamente circular, com faixas circulares uniformemente espaçadas que iam das paredes até a claraboia acima.")
	await novel_interface.show_text_only("A luz que atravessava a clarabóia incidia sobre o expositor no centro, fazendo com que todo o lugar parecesse silencioso e sagrado.")
	await novel_interface.show_text_only("Todo o espaço foi projetado como uma jarra de barro, e as paredes circundantes usavam um material de barro semelhante.")
	await novel_interface.show_text_only("No expositor circular em forma de tambor de escrituras, no topo dos degraus de pedra, havia um antigo pergaminho amarelado e manchado.")
	await novel_interface.show_text_only("Subi os degraus e me inclinei para olhar mais de perto. O vidro protetor parecia ter pelo menos cinco centímetros de espessura, e a maioria dos caracteres hebraicos no pergaminho eram claramente visíveis.")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_DSS.png")
	await novel_interface.show_dialog("Isso poderia ser--", "Lian")
	await novel_interface.show_text_only("Você sabe, aquela coisa daquele anime...")
	await novel_interface.show_dialog("Este é um documento antigo descoberto em cavernas a noroeste do Mar Morto, conhecido como “Manuscritos do Mar Morto”, a maior descoberta arqueológica do século passado.", "Guia")
	await novel_interface.show_dialog("Os Manuscritos do Mar Morto são vastos em escala, abrangendo mais de quinhentos manuscritos desenterrados em doze cavernas.", "Guia")
	await novel_interface.show_dialog("E o que está nesta vitrine é uma página manuscrita parcial do Gênesis da “Torá”, um dos Manuscritos do Mar Morto.", "Guia")
	await novel_interface.show_dialog("Ele registra o processo de Deus criando o mundo e como Ele escolheu os Masadans como Seu povo escolhido. É a relíquia histórica mais importante deste país.", "Guia")
	await novel_interface.show_text_only("Pensando bem, os Masadans sempre parecem se orgulhar de serem o povo escolhido de Deus...")
	await novel_interface.show_text_only("Mas nunca me interessei por histórias religiosas como esta...")
	await novel_interface.show_text_only("Cada povo da terra tem alguns ancestrais que se transformaram em deuses em suas lendas, não é...")
	await novel_interface.show_text_only("Os visitantes locais claramente não pensavam assim. Os dois tios com chapéus estranhos imediatamente se voltaram para a maleta e começaram a orar.")
	await novel_interface.show_text_only("Com sua voz profunda e gentil, o guia continuou.")
	await novel_interface.show_dialog("Este manuscrito registra as histórias dos antepassados Abraão, Isaque, Jacó e dos doze filhos de Jacó.", "Guia")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_TheThree.png")
	await novel_interface.show_dialog("Abraão é um profeta em muitas religiões e o ancestral comum dos hebreus e dos árabes.", "Guia")
	await novel_interface.show_dialog("Abraão foi aquele que o Senhor escolheu dentre todos os seres e abençoou.", "Guia")
	await novel_interface.show_dialog("Deus fez uma aliança com Abraão, prometendo conceder uma terra fértil ao seu filho legítimo, ao seu neto e a todos os descendentes que a linhagem do neto produziria.", "Guia")
	await novel_interface.show_dialog("Esta terra se estende do Nilo ao Eufrates. É o que hoje chamamos de “Terra Prometida”.", "Guia")
	await novel_interface.show_dialog("Mais tarde, Abraão gerou seu filho legítimo, Isaque; Isaque gerou Esaú, e seu segundo filho se chamou Jacó...", "Guia")
	await novel_interface.show_dialog("(Espere... Jacob?)", "Lian")
	await novel_interface.show_text_only("Não é esse o nome daquele administrador de Elluka?")
	await novel_interface.show_text_only("Por outro lado, os ocidentais realmente gostam de dar aos seus filhos nomes de figuras de clássicos religiosos...")
	await novel_interface.show_text_only("O guia fez uma pausa, ajustou os óculos de leitura e continuou explicando o conteúdo do pergaminho.")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_MessOfPottage.png")
	await novel_interface.show_dialog("De acordo com as escrituras, Jacó, o segundo filho de Isaque, certa vez comprou o direito de primogenitura de seu irmão mais velho, Esaú, com uma tigela de ensopado de feijão vermelho.", "Guia")
	await novel_interface.show_dialog("De acordo com a aliança de Abraão com Deus, uma vez que Jacó obteve o direito de primogenitura, ele adquiriu o direito legal de herdar a “Terra Prometida”.", "Guia")
	await novel_interface.show_dialog("Jacó mais tarde se tornou o santo patriarca de Massada, e seus doze filhos se tornaram os doze antepassados das tribos de Massada...", "Guia")
	await novel_interface.show_text_only("A essa altura minha cabeça estava começando a latejar.")
	await novel_interface.show_text_only("Espere aí... feijoada vermelha? Que diabos!?\nOs povos antigos eram realmente tão casuais?")
	await novel_interface.show_text_only("E se isso for verdade, então todos os Masadanos são descendentes daquele Jacó...")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_DSS.png")
	await novel_interface.show_text_only("O guia deu dois passos ao longo da plataforma circular, examinou as palavras próximas ao final do pergaminho e continuou.")
	await novel_interface.show_dialog("Esta é a parte final de Gênesis -", "Guia")
	await novel_interface.show_dialog("A vida do santo patriarca Jacó estava cheia de lendas. Ele sonhou com a porta do céu e ouviu Deus reafirmar o juramento feito ao seu avô.", "Guia")
	await novel_interface.show_dialog("Ele lutou com Deus e saiu coxo, recebendo um santo nome.", "Guia")
	await novel_interface.show_dialog("Jacó passou os últimos dezessete anos de sua vida no Egito, e antes de sua morte chamou seu filho José...", "Guia")
	await novel_interface.show_dialog("Jacó fez seu filho jurar que o tiraria do Egito e o enterraria na caverna de Macpela, em Hebrom, na terra de Canaã.", "Guia")
	await novel_interface.show_dialog("Esse foi o túmulo da família que Abraão comprou há muito tempo, onde os pais e avós de Jacó foram enterrados.", "Guia")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("O manuscrito termina aí.")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_SOTB.png")
	novel_interface.show_character("ren_medical","worry")
	await novel_interface.show_dialog("(Caverna Machpelah... por que esse nome parece familiar?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sinto que Aya mencionou isso no briefing da noite passada... Não houve uma explosão alguns dias atrás?")
	await novel_interface.show_text_only("Ugh, não consigo me lembrar. De qualquer forma, todas essas pessoas estrangeiras e nomes de lugares parecem iguais para mim...")
	await novel_interface.show_text_only("O guia acariciou suavemente o vidro da vitrine e suspirou em voz baixa.")
	await novel_interface.show_dialog("Massada é um povo antigo e damos grande importância às escavações arqueológicas.", "Guia")
	await novel_interface.show_dialog("Desde o dia em que o primeiro pergaminho foi descoberto, a escavação e a restauração dos Manuscritos do Mar Morto continuaram por mais de oitenta anos.", "Guia")
	await novel_interface.show_dialog("Eles são a herança preciosa dos nossos antepassados e também das nossas raízes.", "Guia")
	await novel_interface.show_dialog("No entanto...", "Guia")
	await novel_interface.show_text_only("O guia desceu as escadas e se aproximou da enorme pintura a óleo em um dos lados do corredor.")
	novel_interface.change_music("res://assets/audio/music/Hero.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_TheJewishWar.png")
	await novel_interface.show_text_only("Ele ficou diante dela por um longo tempo, olhando em um silêncio significativo.")
	await novel_interface.show_text_only("A pintura era grandiosa em escala, cobrindo quase uma parede inteira.")
	await novel_interface.show_dialog("No entanto, a nossa história também está repleta de sofrimento.", "Guia")
	await novel_interface.show_text_only("Ele se virou, os cantos da boca se contraindo levemente, como se estivesse suprimindo desesperadamente alguma memória dolorosa.")
	await novel_interface.show_dialog("Esta pintura foi criada com base nos escritos do historiador do primeiro século Flávio Josefo.", "Guia")
	await novel_interface.show_dialog("Naquela época, o poderoso Império Romano conquistou a cidade sagrada e mais de um milhão de ancestrais Masadan foram massacrados por soldados legionários.", "Guia")
	await novel_interface.show_dialog("E esta pintura retrata o dia em que o Segundo Templo foi incendiado.", "Guia")
	await novel_interface.show_dialog("Foi o dia mais triste da história de Masadan... e ainda assim foi apenas o começo de mil anos de sofrimento.", "Guia")
	await novel_interface.show_dialog("No ano 70, os nossos antepassados foram expulsos da Judeia em grande número pelos romanos.", "Guia")
	await novel_interface.show_dialog("Aqueles que se recusaram a aceitar o exílio da sua terra natal levantaram-se em resistência, e mais de mil rebeldes fizeram de Massada daquela época a sua fortaleza final.", "Guia")
	await novel_interface.show_dialog("Eles mantiveram aquela cidade durante dois anos inteiros sob o cerco romano, até que o abastecimento de água foi cortado e eles não tiveram mais forças.", "Guia")
	await novel_interface.show_dialog("Quando a Décima Legião finalmente invadiu a cidade, o governador que entrou encontrou apenas mais de novecentos cadáveres e edifícios totalmente queimados.", "Guia")
	await novel_interface.show_dialog("Os defensores escolheram o suicídio em vez de se submeterem e se tornarem escravos de Roma. No final, apenas dois adultos e cinco crianças sobreviveram...", "Guia")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Imaginar aquela cena fez meu peito doer.")
	await novel_interface.show_text_only("O guia ficou em silêncio por um longo tempo, depois se virou para nós e continuou.")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_SOTB.png")
	await novel_interface.show_dialog("Fomos expulsos de nossa terra natal repetidas vezes, forçados a sair de nossas próprias casas.", "Guia")
	await novel_interface.show_dialog("Fomos conquistados, governados, marginalizados, massacrados, tratados como escravos, prisioneiros, até gado...", "Guia")
	await novel_interface.show_dialog("Há um século, numa das mais terríveis purgas étnicas da história da humanidade, seis milhões dos nossos compatriotas foram massacrados.", "Guia")
	await novel_interface.show_dialog("E há dez anos, a nossa capital foi novamente reduzida a terra arrasada. O Monte do Templo queimou em chamas roxas por sete dias e sete noites...", "Guia")
	await novel_interface.show_dialog("Muitas pessoas – minha família e amigos – perderam a vida naquela catástrofe.", "Guia")
	await novel_interface.show_dialog("E aqueles que sobreviveram por pura sorte podem ter perdido ainda mais...", "Guia")
	await novel_interface.show_text_only("Sua voz tremia quando ele levantou a mão esquerda que estava enfiada no bolso.")
	await novel_interface.show_text_only("Só então vimos que a mão havia sido substituída por uma prótese metálica, e queimaduras cobriam o pulso e o antebraço expostos além da manga...")
	await novel_interface.show_text_only("A sala inteira ficou em silêncio. Eu me peguei prendendo a respiração também.")
	await novel_interface.show_text_only("Uma jovem turista no meio da multidão cobriu a boca com as duas mãos, com lágrimas nos olhos.")
	await novel_interface.show_text_only("Mas o guia cerrou a mão em punho e ergueu-a bem alto, olhando para nós enquanto falava com uma voz decidida:")
	await novel_interface.show_dialog("E, no entanto, tal como aqueles milhares de guerreiros que defenderam esta fortaleza até ao fim, o sofrimento nunca nos fará submeter-se.", "Guia")
	await novel_interface.show_text_only("Sua voz não era alta, mas estava cheia de espírito heróico e fez uma força estranha brotar em meu peito.")
	await novel_interface.show_text_only("Seus olhos brilhavam como se ele pudesse ver um deus apontando o caminho.")
	await novel_interface.show_dialog("Passamos por duas grandes diásporas, mas no final sempre voltaremos a esta terra, porque o sofrimento nunca nos fará submeter--", "Guia")
	await novel_interface.show_dialog("Noventa anos atrás, nossos antepassados enfrentaram tiros e granadas apenas para voltar aqui mais uma vez e estabelecer uma nação própria.", "Guia")
	await novel_interface.show_dialog("Mesmo que este não fosse nada além de um deserto árido, mesmo que a água potável fosse escassa, esta é a nossa casa!", "Guia")
	await novel_interface.show_dialog("O que flui por esta terra não é leite e mel, mas nosso sangue, lágrimas e suor.", "Guia")
	await novel_interface.show_dialog("Esta é a nossa única pátria no mundo e o lar espiritual que o povo Masadan preza há milhares de anos.", "Guia")
	await novel_interface.show_dialog("A \"Terra Prometida\" é a aliança entre os nossos antepassados e Deus, e também a nossa promessa às gerações futuras -", "Guia")
	await novel_interface.show_dialog("O Templo pode ser queimado, mas a fortaleza do espírito nunca cairá!", "Guia")
	await novel_interface.show_dialog("Por fim, obrigado a todos mais uma vez pela visita ao Museu Nacional de Massada. Obrigado a todos!", "Guia")
	await novel_interface.show_text_only("Com isso, o guia curvou-se diante da multidão.")
	await novel_interface.show_text_only("Aplausos longos e intermináveis irromperam ao nosso redor. Não pude deixar de sentir admiração por esse povo resiliente e me vi batendo palmas também.")
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_IndiaEH.png")
	await novel_interface.show_text_only("Depois de sair da área de exposição de documentos, comecei a vagar sem rumo pelo museu.")
