# stardustdescends_ep16.gd - 星尘降临篇第16话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	stardustdescends_ep16_script()

func play_script():
	pass

func stardustdescends_ep16_script():
	novel_interface.change_music("res://assets/audio/music/Sunset.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_ShelterOffice.png")
	novel_interface.show_character("ren_medical","gratified")
	await novel_interface.show_dialog("How many children do you have here?", "Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I asked Aunt Haifa, who had fallen into thought.")
	await novel_interface.show_dialog("Thirty-two. They're all orphans from the settlement, none older than ten.", "Haifa")
	await novel_interface.show_dialog("This is all I can manage, and even then I still need social workers to help during the day... sigh...", "Haifa")
	await novel_interface.show_dialog("There are hundreds more children like this in the nearby slums. Masada's childcare institutions get so little funding that they're barely able to keep running.", "Haifa")
	await novel_interface.show_text_only("Just as Mariru said, once the surrounding resources are plundered dry, even a place like Masada, with such a huge army, can't keep going forever...")
	novel_interface.show_character("ren_medical","worry")
	await novel_interface.show_dialog("Isn't there anyone who can help these orphans? Doesn't Masada always keep its doors open to NGOs...?", "Ren")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Some people in white helmets came before, but they just took a few pictures of some disabled children and left...", "Haifa")
	await novel_interface.show_dialog("I can barely keep up as it is. Even chores like cleaning depend on the older kids helping out. There's only so much I can do...", "Haifa")
	novel_interface.show_character("ren_medical","smile")
	await novel_interface.show_dialog("Don't say that! I'm sure the children are all incredibly grateful to you...
I mean, even I--", "Ren")
	await novel_interface.show_dialog("A-Anyway, having a family is really important to kids like them!", "Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("She looked at me in surprise, then smiled kindly.")
	await novel_interface.show_dialog("What a good child. You're not from around here, are you, Ren?", "Haifa")
	await novel_interface.show_dialog("Emily said you'd be staying here tonight and leaving tomorrow morning?", "Haifa")
	novel_interface.show_character("ren_medical","gratified")
	await novel_interface.show_dialog("Mm. It sounds like the inner city is under martial law tonight because they're signing a ceasefire agreement with the resistance tomorrow... Sorry to impose!", "Ren")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("It's fine, it's fine. I'll go get the bath ready first.", "Haifa")
	await novel_interface.show_text_only("Aunt Haifa stood up and walked toward the door, murmuring to herself.")
	await novel_interface.show_dialog("Sigh... Can so much hatred really be wiped away by a single piece of paper...", "Haifa")
	await novel_interface.stop_music()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("................")
	await novel_interface.show_text_only("...")
	await novel_interface.show_text_only("SID Command Room.")
	novel_interface.change_music("res://assets/audio/music/Normal Stage.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	await novel_interface.show_text_only("Mariru walked into the command room yawning and carrying two cups of coffee, only to find Aya still working at the main console.")
	novel_interface.show_character("liliu_uniform1","normal2")
	await novel_interface.show_dialog("Not often you volunteer for a dreary intelligence job like this.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","wink")
	await novel_interface.show_dialog("Because the target is interesting~", "Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru set the caramel macchiato on the table beside Aya, and Aya took a sip.")
	novel_interface.show_character("liliu_uniform1","normal2")
	await novel_interface.show_dialog("Is it really okay to drink something this sweet in the middle of the night...?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("My brain will burn off the sugar anyway. And I found a breakthrough.", "Aya")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform1","normal1",0.25)
	await novel_interface.show_dialog("Found an insider?", "Mariru")
	novel_interface.character_light(0.35,"normal")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("No. Given the encryption level of Project 0812, fewer than ten people should know the full picture, and I can't find any of them.", "Aya")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"sigh")
	await novel_interface.show_dialog("True. Knowing Palantir's style, there was no way they'd let a target this valuable slip away...", "Mariru")
	novel_interface.character_light(0.35,"stare")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("So I switched approaches instead--", "Aya")
	await novel_interface.show_dialog("Any spacecraft involving heterogeneous matter would have to be the pinnacle of a nation's industrial and technological capability.", "Aya")
	await novel_interface.show_dialog("At least several thousand people would have been involved in its design, R&D, manufacturing, and transport.", "Aya")
	novel_interface.change_expression("think")
	await novel_interface.show_dialog("And after the federal government collapsed, the relevant secrecy laws ceased to apply, so...", "Aya")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("You're planning to analyze public information online?
Most of it has to be garbage, right...?", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Aya shrugged.")
	novel_interface.show_character("ai","normal")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("liliu_uniform1","sigh",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("At first, some former insiders were leaking things just to make money... people were naturally curious about this kind of story.", "Aya")
	await novel_interface.show_dialog("Then online marketing companies swarmed in, slapped sensational headlines on those raw scraps of information, and padded them out with all sorts of embellishments.", "Aya")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("Before the public got sick of clickbait and fake news, there were more than six million pieces of public information involving NASA secrets.", "Aya")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("I figured as much...", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru rubbed her temples helplessly, and Aya made a face at her.")
	novel_interface.show_character("ai","stare")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("liliu_uniform1","normal1",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("But if you use AI for semantic decomposition and source tracing, then filter for information with orthogonal confidence above 90%...", "Aya")
	novel_interface.change_expression("wink")
	await novel_interface.show_dialog("You get way more material than you'd expect~", "Aya")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Aya tapped the keyboard, and a screenful of data appeared instantly. Mariru perked up at once.")
	novel_interface.show_character("ai","normal")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("liliu_uniform1","normal1",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Project 0812 has a total mass of between 30 and 50 tons. Optical equipment alone accounts for 5 tons, and it carries no life-support systems whatsoever.", "Aya")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("At that mass, it's definitely not a satellite... An unmanned space station?", "Mariru")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Possibly. The craft has two propulsion systems and can change orbit anywhere from 660 kilometers above Earth to 36,000 kilometers.", "Aya")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("One of them is an ion engine that can provide stable acceleration in space over the long term, with a design life of thirty years.", "Aya")
	novel_interface.change_expression("normal") 
	await novel_interface.show_dialog("The other is a conventional propellant engine that can support a return landing on Earth, and it accounts for nearly half the system's mass.", "Aya")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"serious")
	await novel_interface.show_dialog("Lingering in space for that long and constantly adjusting its orbital position... Was it meant to keep aimed at a signal source 400 light-years away?", "Mariru")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("And the fact that it's recoverable suggests the data volume is too large to transmit wirelessly--", "Aya")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Just how much information are we talking about...?", "Mariru")
	novel_interface.change_2nd_expression("normal1")
	await novel_interface.show_dialog("Can you locate that satellite?", "Mariru")
	novel_interface.character_light(0.35,"think")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Something that big should have been impossible to hide from Sentinel, but it doesn't show up in any orbit...", "Aya")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Sentinel is the asteroid monitoring system, right?", "Mariru")
	novel_interface.character_light(0.35,"normal")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Yeah. According to the records, the last time a spacecraft matching those traits changed orbit was about a year ago.", "Aya")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("So at that point... the control key got sold on the black market?", "Mariru")
	novel_interface.character_light(0.35,"wink")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("No idea. If you wanted to hide something that big, maybe you'd stash it behind the moon?", "Aya")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"sigh")
	await novel_interface.show_dialog("By the way... when did you write an AI like this?", "Mariru")
	novel_interface.character_light(0.35,"think")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("I couldn't write something like this. The model and parameters were uploaded the day before yesterday by an account called Elder Seven.", "Aya")
	novel_interface.change_expression("wink")
	await novel_interface.show_dialog("The open-source community forums have been exploding over it these last few days~", "Aya")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("What's so special about it?", "Mariru")
	novel_interface.character_light(0.35,"normal")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("The person released the algorithm too. Rough estimates say training an AI to this level would consume over a billion dollars' worth of compute.", "Aya")
	await novel_interface.show_dialog("And code on this scale definitely couldn't have been written by just one person.", "Aya")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("What organization would open-source something that valuable...? Did you isolate it properly?", "Mariru")
	novel_interface.character_light(0.35,"wink")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Of course. I ran everything inside a Themis virtual machine.", "Aya")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("This model can rapidly archive massive volumes of similar information and judge the correlations between them--", "Aya")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("At the same time, it scores each item's reliability based on how orthogonal the different sources are.", "Aya")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"jest")
	await novel_interface.show_dialog("Sounds useful. Those shady marketing firms are in trouble then?", "Mariru")
	novel_interface.character_light(0.35,"blush_think")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("That's what I thought at first. But think about it: if you connected it to a large enough database...", "Aya")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru's expression suddenly turned serious--")
	novel_interface.show_character("ai","blush_think")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("liliu_uniform1","serious",0.25)
	await novel_interface.show_dialog("Like a government security surveillance system...?", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Exactly. Combined with image recognition, it could profile and classify everyone, then infer how they're connected.")
	await novel_interface.show_text_only("It could also use that information to determine a target's objectives and predict people's behavior, maybe even steer them on purpose...")
	await novel_interface.show_text_only("Mariru shook her head. This wasn't the time to let their attention drift.")
	novel_interface.show_character("ai","blush_think")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("liliu_uniform1","sigh",0.25)
	await novel_interface.show_dialog("We can talk about that AI later.", "Mariru")
	novel_interface.change_2nd_expression("normal1")
	await novel_interface.show_dialog("They've finalized the Masada representative for tomorrow's ceasefire signing. It'll be Major General Hamon of the Northern Command.", "Mariru")
	await novel_interface.show_dialog("And for political reasons, the signing site has been chosen as the Masada International Convention Center by the Dead Sea.", "Mariru")
	novel_interface.character_light(0.35,"think")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Makes sense. A ceasefire signed behind the isolation wall would never convince anyone.", "Aya")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("What kind of people are in the resistance, anyway? I never paid much attention before.", "Aya")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("Of course you didn't~", "Mariru")
	await novel_interface.show_dialog("At first it was a coalition of local ethnic militias, extremist religious groups, remnants of the army after the government collapsed, and wandering bandits.", "Mariru")
	await novel_interface.show_dialog("They were all armed groups that hated Masada, speaking seven or eight local languages among themselves. Normally they should've been wiped out separately--", "Mariru")
	novel_interface.character_light(0.35,"normal")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("What kind of person could organize a bunch like that?", "Aya")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("Walid Mushar, the man who'll sign the agreement tomorrow on behalf of the resistance.", "Mariru")
	await novel_interface.show_dialog("Even after years of being hunted by a National Defense Force equipped two generations ahead of them, he's still managed to make the resistance bigger and bigger.", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Aya pulled up Walid Mushar's file on the screen.")
	novel_interface.show_character("ai","dizzy")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("liliu_uniform1","normal1",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("...He actually has a doctorate!?", "Aya")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Yeah. The man who once had the highest bounty in the world is a PhD in physics from Ben-Gurion University.", "Mariru")
	novel_interface.change_2nd_expression("serious")
	await novel_interface.show_dialog("They say that after the Holy City was destroyed, Masadans so enraged they'd lost all reason dragged his wife and daughter out of their home in Beersheba and into the street...", "Mariru")
	novel_interface.character_light(0.35,"think")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Indiscriminate ethnic hatred?
Humans really are hopelessly stupid animals...", "Aya")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru chopped Aya lightly on the head. Aya reflexively shrank her neck, only to find Mariru hadn't used much force this time.")
	novel_interface.show_character("ai","think")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("liliu_uniform1","sigh",0.25)
	await novel_interface.show_dialog("Yeah. Humans really are stupid.", "Mariru")
	novel_interface.change_2nd_expression("normal1")
	await novel_interface.show_dialog("After that, Mushar left the university. The next time he appeared in public, he was already Masada's greatest headache.", "Mariru")
	await novel_interface.show_dialog("If not for Masada's automatic retaliation system, he'd probably have kept fighting until the day he died...", "Mariru")
	novel_interface.change_2nd_expression("normal2")
	await novel_interface.show_dialog("You should go get some sleep. You've been sitting here for hours.", "Mariru")
	novel_interface.change_2nd_expression("normal1")
	await novel_interface.show_dialog("No telling what'll happen tomorrow...", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.stop_music()
	await novel_interface.hide_background_with_fade()
	await novel_interface.show_text_only("................")
	await novel_interface.show_text_only("...")
	await novel_interface.show_text_only("Orphanage in the Outer District.")
	novel_interface.change_music("res://assets/audio/music/Shop.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_ShelterCorridor.png")
	novel_interface.show_character("ren_medical","smile")
	await novel_interface.show_dialog("Whew... My hair's full of sand. That shower felt amazing.", "Ren")
	novel_interface.change_expression("wry_smile")
	await novel_interface.show_dialog("(Thank goodness there were disposable panties in the military supplies...)", "Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("The bathroom is bigger than I expected, and it's kept very clean. The counter is neatly lined with lots of plastic toys for little kids.")
	await novel_interface.show_text_only("While drying my hair, I picked up the phone that was charging outside the bathroom and disconnected it from the wireless speaker.")
	await novel_interface.show_dialog("Finished washing up, Ren?", "Haifa")
	novel_interface.show_character("ren_medical","smile")
	await novel_interface.show_dialog("Mm-hmm, it felt great~
Thank you, Aunt Haifa!", "Ren")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("I think I heard music playing in the bathroom just now.
Wasn't your phone outside...?", "Haifa")
	novel_interface.show_character("ren_medical","shy_left")
	await novel_interface.show_dialog("N-No! It wasn't! Really...", "Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("My face burned red as I covered my chest.")
	await novel_interface.show_text_only("Suddenly, the walkie-talkie beside the phone burst into static--")
	await novel_interface.show_dialog("Ren, are you there?!", "Emily")
	novel_interface.show_character("ren_medical","serious")
	await novel_interface.show_dialog("What is it?", "Ren")
	await novel_interface.hide_character()
	await novel_interface.stop_music()
	await novel_interface.show_dialog("Get Aunt Haifa to turn off all the lights and lock the front door!
I found--", "Emily")
	await novel_interface.show_text_only("Before the speaker could finish, the walkie-talkie dissolved into static.")

	print("=== 星尘降临篇第16话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
