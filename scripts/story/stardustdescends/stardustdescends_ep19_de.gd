# stardustdescends_ep19.gd - 星尘陨落篇第19话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	stardustdescends_ep19_script()

func play_script():
	pass

func stardustdescends_ep19_script():
	novel_interface.change_music("res://assets/audio/music/Witch's Confession.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_Recording.png")
	await novel_interface.show_dialog("Meine Tochter Nasha wird dieses Jahr sieben, und in letzter Zeit liebt sie es, mich zum Puzzeln mit ihr zu zerren.", "Aufzeichnung")
	await novel_interface.show_dialog("Manchmal tue ich absichtlich so, als hätte ich keine Lust oder keine Zeit, und gebe erst \"widerwillig\" nach, nachdem ich mir eine Weile lang ihr Betteln angehört habe.", "Aufzeichnung")
	await novel_interface.show_dialog("Dabei spiele ich in Wahrheit liebend gern mit ihr... aber wenn Nasha verwöhnt tut, ist sie einfach zu niedlich.", "Aufzeichnung")
	await novel_interface.show_text_only("Aus der Aufnahme drang schallendes Gelächter des Publikums.")
	await novel_interface.show_dialog("Das Puzzle, mit dem wir spielten, war von einer ganz neuen Art, völlig anders als die, die ich aus meiner Kindheit kannte--", "Aufzeichnung")
	await novel_interface.show_dialog("Jedes Teil besaß auf einer Seite ein farbiges E-Ink-Display, das ein unbewegliches Bild zeigte, also unterschied es sich kaum von einem herkömmlichen Puzzle.", "Aufzeichnung")
	await novel_interface.show_dialog("Doch je weiter man es zusammensetzte und schließlich das letzte Teil einfügte, desto mehr leuchtete jedes einzelne Plättchen auf, und das Bild auf dem Puzzle begann sich zu bewegen...", "Aufzeichnung")
	await novel_interface.show_dialog("Ich erinnere mich noch gut an das erste Mal, als ich es sah. Zuerst dachte ich, wir würden das berühmte Foto der Erde namens \"Blue Marble\" zusammensetzen--", "Aufzeichnung")
	await novel_interface.show_dialog("Aber als meine Tochter das letzte Stück platzierte, begann sich das ganze Bild zu bewegen: Die Kamera zog sich zurück und passierte den Mond, den Mars, den Jupiter ...", "Aufzeichnung")
	await novel_interface.show_dialog("Dann flog es ganz aus dem Sonnensystem heraus, vorbei an unzähligen Sternen, und enthüllte schließlich die gesamte Milchstraße.", "Aufzeichnung")
	await novel_interface.show_dialog("Nasha sprang vor Aufregung auf und schrie, als sie meinen Arm schüttelte, genau wie ich es tat, als ich zum ersten Mal ein Experiment zur Lichtbeugung heterogener Materie durchführte ...", "Aufzeichnung")
	await novel_interface.show_dialog("Ich glaube, jeder hier hat einen solchen Moment erlebt.", "Aufzeichnung")
	await novel_interface.show_dialog("An diesem Tag rannte ich in Hausschuhen und Pyjamahosen aus dem Labor und brüllte den ganzen Weg ins Büro eines Mikrobiologieprofessors an unserer Universität.", "Aufzeichnung")
	await novel_interface.show_dialog("Der alte Kerl hatte mir einmal gesagt, wenn ich das Experiment schaffen könnte, würde er die teure Flasche japanischen Sake öffnen, die ihm sein Schüler gegeben hatte ...", "Aufzeichnung")
	await novel_interface.show_dialog("Dieses Getränk hätte mich fast erstickt. Ich kann immer noch nicht glauben, dass es für so viel verkauft wird.", "Aufzeichnung")
	await novel_interface.show_text_only("Das Publikum brach in Gelächter aus und einige von ihnen applaudierten.")
	await novel_interface.show_dialog("Später wurde mir allmählich klar, dass der Prozess der Untersuchung heterogener Materie tatsächlich einem Puzzle ähnelt.", "Aufzeichnung")
	await novel_interface.show_dialog("Bevor das Rätsel endgültig gelöst ist, können Sie nur noch Dinge ausprobieren, die auf Ihrer Intuition und einer Handvoll Hinweisen basieren.", "Aufzeichnung")
	await novel_interface.show_dialog("Es ist wie ein Puzzle: Zuerst findet man die vier Ecken und verwendet sie als Axiome, als logische Drehpunkte.", "Aufzeichnung")
	await novel_interface.show_dialog("Dann tun Sie, beginnend an den Ecken, alles, um den Rahmen zu schließen.", "Aufzeichnung")
	await novel_interface.show_dialog("So wie Sie mit den grundlegendsten Axiomen beginnen und nach und nach logisch konsistente Schlussfolgerungen ableiten.", "Aufzeichnung")
	await novel_interface.show_dialog("Dann unternehmen Sie innerhalb dieses abgeschlossenen Rahmens weiterhin Versuch-und-Irrtum-Versuche und dringen Schritt für Schritt zum unbekannten Kern vor ...", "Aufzeichnung")
	await novel_interface.show_dialog("Der Prozess ist langwierig und anstrengend, und erst wenn das letzte Stück fertig ist, können wir einen Blick auf die Wahrheit der Welt erhaschen.", "Aufzeichnung")
	await novel_interface.show_dialog("Während dieser Zeit können Sie Ihrer Fantasie freien Lauf lassen und sich fragen, was für ein herrliches Panorama Sie am Ende erwartet.", "Aufzeichnung")
	await novel_interface.show_dialog("Ich glaube, das ist der faszinierendste Teil der wissenschaftlichen Forschung und der Grund, warum die meisten von uns beharrlich sind!", "Aufzeichnung")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Klicken Sie--")
	await novel_interface.stop_music()
	await novel_interface.show_text_only("Gerade als der Applaus des Publikums anschwellen wollte, brach die Aufnahme abrupt ab.")
	novel_interface.change_music("res://assets/audio/music/Normal Stage.mp3")
	novel_interface.show_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("Dies war eine Aufnahme, die Mariru auf dem Computer eines verstorbenen Forschers gefunden hatte.", "Aya")
	novel_interface.change_expression("wink")
	await novel_interface.show_dialog("Angeblich war es Teil eines privaten Vortrags, den Mushar vor mehr als einem Jahrzehnt auf der 30. Solvay-Konferenz hielt", "Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("akiko","shock")
	await novel_interface.show_dialog("Derjenige, der sprach, war... Walid Mushar?", "Akiko")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Akiko war ein wenig überrascht. Einen Moment lang konnte sie diese raffinierte, lockere Stimme nicht mit dem skrupellosen Terroristenführer in Verbindung bringen.")
	novel_interface.show_character("akiko","normal")
	await novel_interface.show_dialog("Die 30. Solvay-Konferenz... das war doch 2026, oder?", "Akiko")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Diese vom belgischen Industriellen Ernest Solvay gegründete akademische Konferenz lud zu jeder Sitzung die weltbesten Wissenschaftler ihrer Zeit ein.")
	await novel_interface.show_text_only("Es fand alle drei Jahre statt und obwohl Kriege und politische Unruhen dazu führten, dass es mehrmals ausgesetzt wurde, wird es bis heute fortgesetzt.")
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("Genau, im Jahr vor Kriegsbeginn...", "Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Damals konnte sich Mushar nicht vorstellen, dass seine Frau und seine Tochter ein paar Monate nach dieser Rede aufgrund blinden ethnischen Blutvergießens tot auf der Straße liegen würden.")
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("Damals war die Erforschung heterogener Materie aufgrund internationaler Verträge verboten, sodass Diskussionen auf wissenschaftlichen Konferenzen wie dieser nur im privaten Rahmen stattfinden konnten.", "Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("Doch im darauffolgenden Jahr riss jedes Land die Maske ab und die meisten Menschen, die an dieser Konferenz teilnahmen, sind heute nicht mehr am Leben ...", "Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ein Anflug von Melancholie huschte über Ayas Gesicht, aber sie kehrte schnell zu ihrem gewohnten Selbst zurück.")
	await novel_interface.show_text_only("Sie rief Live-Feeds von Dutzenden verschiedener Medienplattformen auf die große Leinwand, und ausnahmslos alle zeigten Masadas Unterzeichnungszeremonie –")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_SigningCeremony.png")
	await novel_interface.show_text_only("Alles schien reibungslos zu verlaufen, es gab keinerlei Berichte über die Explosion, die Emily zuvor in der Nähe des Veranstaltungsortes verursacht hatte.")
	await novel_interface.show_text_only("Nachdem der lange Prozess der Unterzeichnung des Dokuments abgeschlossen war, gingen die Masadan- und Widerstandsvertreter zusammen und drückten ihre Handflächen auf einen Bildschirm.")
	await novel_interface.show_text_only("Ihre Handabdrücke wurden zusammen mit dem Vertragstext in Echtzeit online hochgeladen, und das Verteidigungssystem der Stadt Masada begann sofort mit der Aktualisierung seines Verteidigungsprotokolls.")
	await novel_interface.show_text_only("Gleichzeitig übermittelte der Widerstand freiwillig digitale Akten von mehr als zweihunderttausend Mitgliedern, die das Waffenstillstandsabkommen unterstützten.")
	await novel_interface.show_text_only("Von nun an könnten diese Menschen, solange sie ihre Waffen niederlegten, die meisten Gebiete von Masada wie normale Bürger betreten und verlassen.")
	await novel_interface.show_text_only("Der Preis dafür war, dass sie zwei Jahre lang Ortungsarmbänder tragen und unter das Überwachungssystem von Monola gestellt werden mussten.")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_SigningCeremony1.png")
	await novel_interface.show_text_only("Am Ende der Zeremonie sollten die beiden Vertreter vor den Medien Dokumente austauschen und sich die Hand schütteln.")
	await novel_interface.show_text_only("Der Generalmajor der Verteidigungsstreitkräfte und der Widerstandsführer schüttelten sich ganze drei Minuten lang vor den Kameras die Hand.")
	await novel_interface.show_text_only("Hamons übertriebenes Grinsen war fast auf seinem Gesicht eingefroren, während Mushar lediglich sein ruhiges Lächeln behielt.")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	await novel_interface.show_text_only("Aya blickte auf den aufgerissenen Mund auf dem Bildschirm und warf dann einen Blick auf die Informationen, die sie gestern in den sozialen Medien über den Mann gesammelt hatte.")
	novel_interface.show_character("ai","dizzy")
	await novel_interface.show_dialog("Hamon, huh...\nKein Wunder, dass die Armee ihn „Kröte“ nannte~", "Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Als Akiko sah, dass Mariru immer noch nicht zurückgekommen war, nahm sie ihre Brille ab und atmete ganz natürlich auf die Brillengläser.")
	await novel_interface.show_text_only("Während sie sie abwischte, glitt eine Haarsträhne, die sich an der Schläfe verfangen hatte, an ihrem Koteletten herunter, und ihr Gesichtsausdruck und ihre Haltung ähnelten sofort denen einer anderen Person –")
	novel_interface.show_character("akikounglass")
	await novel_interface.show_dialog("Dieser Typ ist der Fahnenträger der kriegerischen Fraktion innerhalb der Verteidigungsstreitkräfte von Masada.", "Akiko")
	await novel_interface.show_dialog("Seine Anhänger loben ihn als Helden, der die Nation beschützt hat. Seine Gegner nennen ihn einen blutgetränkten Schlächter ...", "Akiko")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aya bemerkte die Veränderung in Akikos Tonfall und starrte mit unverhohlener Neugier auf ihr Videobild.")
	await novel_interface.show_text_only("Akiko schien das egal zu sein und schwelgte weiter in Erinnerungen.")
	novel_interface.show_character("akikounglass")
	await novel_interface.show_dialog("Damals folgte Hamon seinem Onkel, Premierminister Schneiderman, der damals Generalleutnant der Restaurationsarmee war, und kämpfte bei der Verteidigung von Masada.", "Akiko")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("Der, bei dem sie mit „Phantom Force“ das Ruder herumschlugen, nachdem ihnen Munition und Vorräte ausgegangen waren?", "Aya")
	await novel_interface.show_dialog("Das qualifiziert ihn auf jeden Fall für eine Kandidatur ...", "Aya")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("Es scheint, dass jeder hochrangige Offizier, der an dieser Schlacht teilgenommen hat und noch am Leben ist, jetzt einen wichtigen Posten im Militär oder in der Regierung innehat", "Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aya, die normalerweise kein Interesse an Politik hatte, traf ihr eigenes Urteil auf der Grundlage der Informationen, die sie gestern Abend mit AI gesammelt und organisiert hatte.")
	novel_interface.show_character("akikounglass")
	await novel_interface.show_dialog("Weniger als zehn dieser Offiziere sind noch am Leben, und jeder von ihnen ist ein Kriegsheld, der auch die Kerngeheimnisse des Landes kennt ...", "Akiko")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("Die Wahrheit über „Phantom Force“, huh ... Sie haben dieses Geheimnis sicherlich gut gehütet.", "Aya")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Aber es gibt noch andere Gründe, warum Hamon so viel Unterstützung bekommt, oder? Ich habe gehört, dass die Verteidigungsstreitkräfte ohne sein effizientes Management schon vor langer Zeit bankrott gegangen wären ...", "Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("akikounglass")
	await novel_interface.show_dialog("Management?\nNennen wir es Plünderung.", "Akiko")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Akiko machte überhaupt keine Anstalten, ihre Verachtung für ihn zu verbergen.")
	novel_interface.show_character("akikounglass")
	await novel_interface.show_dialog("Neben der Umgehung des Völkerrechts in allen möglichen Grauzonen setzte er die Rassentrennung in der Militärzone durch und erweiterte die Befugnisse zum Abfeuern unbemannter Waffen erheblich ...", "Akiko")
	await novel_interface.show_dialog("Die Geheimdienstoffiziere von Palantir waren der Meinung, dass dieser Mann, wenn er die Macht übernehmen würde, als Erstes das National Ethnic Act durchsetzen würde.", "Akiko")
	await novel_interface.show_dialog("Schließlich hat der Großrabbiner seine Unterstützung für Hamon bereits ausdrücklich zum Ausdruck gebracht ...", "Akiko")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aya hatte keine Ahnung, wie sie auf ein derart komplexes politisches Thema reagieren sollte, also suchte sie in aller Stille nach „National Ethnic Act“.")
	await novel_interface.show_text_only("Darunter tauchte eine Flut von Schlagworten wie „Rassentrennung“ auf.")
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("(Menschen sind wirklich langweilig...)", "Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("akikounglass")
	await novel_interface.show_dialog("Übrigens, warum ist Mariru noch nicht zurück...\nDer Drink war wirklich okay, oder?", "Akiko")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Entspannen Sie sich, diese Frau ist hart...", "Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aya öffnete eine frische Flasche Energydrink und nahm einen Schluck. Sie sah sofort viel wacher aus.")
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("Wahrscheinlich kauert sie gerade auf der Toilette und denkt...", "Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("akikounglass")
	await novel_interface.show_dialog("...Denken Sie darüber nach, wie Sie hingerichtet werden sollen?", "Akiko")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","blush_dizzy")
	await novel_interface.show_dialog("Ich denke über Famurs Plan nach~!!", "Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Selbst nachdem sie einen Berg an Informationen gesammelt hatte, hatte Aya immer noch keine Ahnung, wie der bevorstehende Angriff des Widerstands aussehen würde.")
	await novel_interface.show_text_only("Sie hat eine weitere Serie von Satellitenbildern in der Nähe des Toten Meeres erstellt.")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_SatelliteDustStorm.png")
	await novel_interface.show_text_only("Auf den Echtzeit-Wettersatellitenbildern sah der Sandsturm aus wie eine Pfütze schmutzigen Wassers, die sich mutwillig über die Erdoberfläche ausbreitete.")
	await novel_interface.show_text_only("Inzwischen hatte diese Pfütze den Mujib Grand Canyon am Ostufer des Toten Meeres vollständig verschluckt und rollte in Richtung der Festung Masada im Südwesten ...")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	await novel_interface.show_text_only("Aya scannte Masadas Slumviertel noch zweimal mit einem SID-Satelliten und fand keine Spur von Raum-Zeit-Phasenschwankungen.")
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("Selbst wenn es tatsächlich eine Waffe aus heterogener Materie gäbe, die in der Lage wäre, elektromagnetische Wellen zu blockieren, sollte sie derzeit inaktiv sein –", "Aya")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("Andernfalls wären die Satellitenbilder der Slums aufgrund von Lichtbeugungseffekten bereits zu einer verzerrten Unschärfe geworden ...", "Aya")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Die stark verteidigte Masada-Festung ohne heterogene Materiewaffen angreifen?", "Akiko")
	await novel_interface.show_dialog("Selbst wenn die KI-Verteidigungswaffen zu 100 % lahmgelegt wären, wäre das immer noch unmöglich ...", "Akiko")
	await novel_interface.show_dialog("Gemessen an der Größe der Einsatztrupps, die Lian beschrieben hat, würden diese Terroristen keine zwanzig Minuten durchhalten. Sie konnten unmöglich einen Fuß in die Innenstadt setzen.", "Akiko")
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("Irgendwas stimmt definitiv nicht...", "Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Wie Mariru sagte, übergab Mushar dieses Mal sowohl sich selbst als auch Hunderttausende Widerstandskameraden.")
	await novel_interface.show_text_only("Wenn es wirklich darum ginge, einen Angriff zu starten, dann wäre er wie ein Spieler, der am Tisch All-In geht, entschlossen, den Gegner noch in dieser Runde zu besiegen.")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_doomsday.png")
	await novel_interface.show_text_only("Noch schlimmer war, dass sie unter einer impliziten Bedingung operierten: Sie konnten Masadas automatisches Vergeltungssystem nicht auslösen.")
	await novel_interface.show_text_only("Wenn ihnen das automatische Vergeltungssystem egal wäre, könnte der Widerstand einfach an seiner bisherigen Strategie festhalten und weiterhin Masadas Wohnraum bedrängen.")
	await novel_interface.show_text_only("Eines Tages würden die sozialen und wirtschaftlichen Systeme Masadas völlig zusammenbrechen, und dann könnte der Widerstand die Stadt leicht frontal erobern.")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	await novel_interface.show_text_only("Aya starrte schweigend auf die große Leinwand und versank in Gedanken, während die Zeit von Sekunde zu Sekunde verging ...")
	await novel_interface.show_dialog("Aaaahhh, ich habe absolut keine Ahnung!!!", "Aya")
	await novel_interface.show_text_only("Wie eine Studentin, die nicht in der Lage ist, eine Prüfungsfrage mit hoher Punktzahl zu lösen, schlug Aya plötzlich mit der Stirn hart auf die Tastatur der Konsole und erschreckte Akiko.")
	await novel_interface.show_dialog("Wie vernichtet oder erobert man die Innenstadt von Masada, ohne das automatische Vergeltungssystem auszulösen ...", "Aya")
	await novel_interface.show_text_only("Immer noch ihren Kopf in der Tastatur vergraben, murmelte Aya vor sich hin.")
	await novel_interface.show_dialog("Ich habe wochenlang über dieses Problem nachgedacht und es ist völlig unmöglich!!", "Aya")
	await novel_interface.show_dialog("...Seit Wochen?", "Akiko")
	await novel_interface.show_dialog("...Warum verbringen Sie Ihre Freizeit damit, über solche Dinge nachzudenken?", "Akiko")
	await novel_interface.show_dialog("Äh--\nNun...", "Aya")
	await novel_interface.show_text_only("Aya hob den Kopf, wobei die Tastatur mehrere rote Flecken auf ihrer Stirn hinterlassen hatte, und antwortete schwach.")
	novel_interface.show_character("ai","blush_stare")
	await novel_interface.show_dialog("Es ist einfach die Art und Weise, wie ich die Zeit totschlage, wenn mein Gehirn untätig ist ... Ich habe darüber nachgedacht, seit Masada das automatische Vergeltungssystem angekündigt hat.", "Aya")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("...Bist du ein Dämon?!", "Akiko")
	await novel_interface.stop_music()
	await novel_interface.hide_background_with_fade()
	await novel_interface.show_text_only("...")
	await novel_interface.show_text_only("In der Zwischenzeit außerhalb des Veranstaltungsortes der Unterzeichnungszeremonie.")
	novel_interface.change_music("res://assets/audio/music/Story_01.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_MasadAPCRS.png")
	await novel_interface.show_text_only("Während die Zeit verging, saß ich zusammengerollt auf meinem Sitz, die Knie fest umschlungen, und wartete gespannt auf den „Evakuierungsbefehl“, den Mariru erwähnt hatte.")
	novel_interface.show_character("ren_medical","gratified")
	await novel_interface.show_dialog("(Mädchen scheint es wirklich einfacher zu finden, sich an die Knie zu schmiegen ...)", "Lian")
	novel_interface.change_expression("uneasy")
	await novel_interface.show_dialog("(Es ist nur so, dass mein Hintern etwas kalt ist...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Auf dem Konsolenbildschirm lief die Fernsehübertragung der Unterzeichnungszeremonie. Anscheinend war sogar der Regisseur der Meinung, dass der Handschlag zu lange gedauert hatte, da die Übertragung ins Studio unterbrochen wurde.")
	await novel_interface.show_text_only("Die Moderatoren im Studio fingen an, sich müßig mit ihrem Gast zu unterhalten, während ich geistesabwesend auf das Militärradio starrte, das Emily mir letzte Nacht in die Hände gestopft hatte.")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_UAVs.png")
	await novel_interface.show_text_only("Plötzlich schaltete die Live-Übertragung auf die Außenseite des Veranstaltungsortes um und der Kameramann zoomte mit dem Teleobjektiv in den Himmel über der Isolationsmauer der Innenstadt.")
	await novel_interface.show_text_only("Die Stimmen sowohl des Gastes als auch des Feldreporters wurden gleichzeitig lauter, als mehrere Gruppen patrouillierender Drohnen über der Mauer gleichzeitig den Abstieg begannen.")
