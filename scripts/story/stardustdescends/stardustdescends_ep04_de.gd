# stardustdescends_ep4.gd - 星尘降临篇第4话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	stardustdescends_ep4_script()

func play_script():
	pass

func stardustdescends_ep4_script():
	novel_interface.change_music("res://assets/audio/music/Story_01.mp3")
	novel_interface.change_background("res://assets/images/bg/Fabiola/Hospital_Passage.png")
	await novel_interface.show_text_only("Ein paar Stunden später – Harima Tech Research Center")
	await novel_interface.show_text_only("Ein kleines Mädchen schaut träge auf ihr Tablet, während sie über ihren Ohrhörer spricht.")
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("Mach dir keine Sorgen. Während wir sprechen, haben die beiden Wachen einen süßen Traum.", "Aya")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("Unterschätzen Sie nicht das menschliche Gehirn – es ist bereit und in der Lage, die Situationen, in denen es sich befindet, zu rationalisieren.", "Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aya blickt sich noch einmal im Raum um. Zwei Männer in schwarzen Anzügen liegen auf einem Paar Mind Diving-Geräten.")
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Schließlich ist es wahrscheinlicher, dass Menschen Lügen glauben, die sie selbst zusammengebastelt haben ...", "Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Plötzlich erregt etwas auf Ayas Tablet ihre Aufmerksamkeit. Sie scrollt schnell mehrere Seiten nach unten und kehrt dann zu den interessanten Daten zurück.")
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("Das ist...", "Aya")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Was ist das?", "Mariru")
	novel_interface.show_character("ai","dizzy")
	await novel_interface.show_dialog("Der Boltzmann-Sensor überschritt seinen Maximalwert in dem Moment, als sich Lians und Nix‘ Stirn berührten.", "Aya")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Eine Fehlfunktion? Ich dachte, Sie hätten die theoretische Obergrenze bereits auf den höchstmöglichen Wert festgelegt.", "Mariru")
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("Fast der höchstmögliche Wert. Wenn das Datenvolumen die Bekenstein-Grenze erreichen würde, wäre das eine andere Sache.", "Aya")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Wollen Sie damit sagen, dass in diesem Moment das Datenvolumen den absoluten Höchstwert erreicht hat, den eine Substanz transportieren kann?", "Mariru")
	await novel_interface.show_text_only("Aya führt schnell einige Berechnungen auf ihrem Tablet durch.")
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("Wenn wir diese eine Anomalie außer Acht lassen, kommen die Parameter von Nix denen einer Hexe sehr nahe. Wahrscheinlich hat sie es selbst noch nicht einmal bemerkt.", "Aya")
	await novel_interface.show_dialog("Also so etwas wie Raphilia?\nWenn Sonya nur nicht auf einer anderen Mission wäre ...", "Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aya schaltet das Überwachungsvideo ein, während sie sich beschwert.")
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("Es handelt sich nicht um eine Fehlfunktion. Alle Messwerte normalisierten sich schnell wieder. Seitdem funktioniert der Sensor auch einwandfrei.", "Aya")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("Noch wichtiger ist, dass nur Lian das Bewusstsein verlor, während es allen anderen dort gut ging ...", "Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aya schließt Möglichkeiten schnell aus. Am Ende scheint es nur eine Erklärung zu geben ...")
	novel_interface.show_character("ai","blush_dizzy")
	await novel_interface.show_dialog("Lian – und nur Lian – absorbierte 2,5 YB an Daten in weniger als einer Sekunde …", "Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aya kann ihre eigene Schlussfolgerung kaum glauben.")
	await novel_interface.show_dialog("...Erinnern Sie mich noch einmal daran, wie groß eine Einheit YB ist?", "Mariru")
	novel_interface.show_character("ai","blush_dizzy")
	await novel_interface.show_dialog("Ein Yottabyte sind 10 hoch 24 Bytes – mehr als alle Daten im Vorkriegsinternet zusammen ...", "Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ayas Stimme zittert vor Aufregung.")
	novel_interface.show_character("ai","blush_dizzy")
	await novel_interface.show_dialog("Und ich dachte, ihr Gehirn wäre nur für Spiele gut ...", "Aya")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Yottabyte. Ich glaube, ich habe es in Professor Shihs Bericht gesehen!", "Mariru")
	novel_interface.show_character("ai","blush_stare")
	await novel_interface.show_dialog("Dieser uralte Meteor im Schwebenden Palast!", "Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aya holt schnell den Bericht hervor.")
	novel_interface.show_character("ai","blush_wink")
	await novel_interface.show_dialog("Ich fürchte, wir müssen uns jetzt auf Lian verlassen.", "Aya")
	await novel_interface.hide_character()
	await novel_interface.hide_background_with_fade()
	await novel_interface.stop_music()
	await novel_interface.show_text_only("...")
	await novel_interface.show_text_only("Fünf Tage später – an Bord von Lebonas Casinoschiff Liberty Star")
	novel_interface.change_music("res://assets/audio/music/Shop.mp3")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_Gambling_Boat.png")
	await novel_interface.show_dialog("Ähm... Fräulein?", "Croupier")
	await novel_interface.show_dialog("Fräulein?", "Croupier")
	novel_interface.show_character("ren_full","panic")
	await novel_interface.show_dialog("Ich bin dran?", "Lian")
	await novel_interface.show_dialog("F-Faltung...", "Lian")
	novel_interface.change_expression("perspire1")
	await novel_interface.show_dialog("Tut mir leid, aber ich muss eine Runde aussetzen.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Das Mädchen verlässt den Tisch und geht zu einem ruhigen Platz in der Ecke des Ganges.")
	novel_interface.show_character("ren_full","wry_smile")
	await novel_interface.show_dialog("Ich hatte einen Flush! Warum hast du mir gesagt, dass ich aussteigen soll?!", "Lian")
	await novel_interface.show_dialog("(senkt ihre Stimme). Vor allem nachdem ich schon so viel Geld gewettet hatte...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lians leise Stimme kann ihre Enttäuschung nicht verbergen.")
	await novel_interface.show_dialog("Nehmen Sie Ihr Telefon heraus und tun Sie so, als würden Sie telefonieren, Lian. Im Moment sieht es für alle anderen so aus, als würden Sie vor sich hin murmeln.", "Annie")
	await novel_interface.show_dialog("Auf diesem Schiff gibt es drei Kontrollräume. Ich habe schon einen geplündert...", "Annie")
	novel_interface.show_character("ren_full","wail")
	await novel_interface.show_dialog("(R-Raid?!...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Auf diesem Schiff sind überall Kameras. Wenn jemand Ihren Mikro-Ohrhörer bemerkt, werden Sie den Haien vorgeworfen.", "Nix")
	await novel_interface.show_text_only("Ich spüre, wie mir ein Schauer über den Rücken läuft. Ich hole schnell mein Handy heraus.")
	novel_interface.show_character("ren_full","upset")
	await novel_interface.show_dialog("Ich habe bereits 20 % von dem verloren, was ich mitgebracht habe. Sagten Sie nicht, dass ich mein Geld verdoppeln musste, bevor ich in den VIP-Raum durfte?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ich schaue auf die Nummer auf dem Armband, das das Casino ausgegeben hat, und sage mir immer wieder: Das ist kein Geld.")
	novel_interface.show_character("ren_full","sob")
	await novel_interface.show_dialog("(Aber es ist immer noch hart verdientes Geld von den Steuerzahlern von New Opulentia!)", "Lian")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Dispatched_Ship_Aisle.png")
	await novel_interface.show_text_only("Dreißigtausend Meter hoch am Himmel, an Bord eines schweren Hochgeschwindigkeitstransporters SID, blickt Nix mit einer Tasse Tee in der Hand auf die Projektionsfläche.")
	novel_interface.show_character("nyx_normal","normal1")
	await novel_interface.show_dialog("Du hattest nur die Karo 2 und 6. Seinem Verhalten nach zu urteilen, bestand eine hohe Wahrscheinlichkeit, dass er auch einen Flush hatte, und seine Karten waren mit ziemlicher Sicherheit höher als Ihre.", "Nix")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Im Ernst?!\nIch wollte gerade aufs Ganze gehen...", "Lian")
	novel_interface.show_character("nyx_normal","speak")
	await novel_interface.show_dialog("*seufz*", "Nix")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sie hat keine Ahnung, wie sie es Lian klar erklären soll, dem gleichen Mädchen, das letzte Nacht sabbernd auf einem Stapel Chips im Wert von fünfzig Millionen eingeschlafen ist.")
	novel_interface.show_character("nyx_normal","normal2")
	await novel_interface.show_dialog("Der häufigste Fehler, den ein Anfänger macht: Immer wenn er ein gutes Blatt hat, möchte er einen hohen Einsatz machen oder sogar All-In gehen.", "Nix")
	await novel_interface.show_dialog("Als würde ihnen die gute Hand die Fähigkeit zu analytischem Denken nehmen.", "Nix")
	await novel_interface.show_dialog("Unwissenheit führt zu Angst; Angst führt zu Rücksichtslosigkeit. Am Ende können Neulinge All-In gehen, um ihrer Angst ein Ende zu setzen.", "Nix")
	novel_interface.change_expression("sad")
	await novel_interface.show_dialog("Sie werden sich erst dann frei fühlen, wenn sie alles eingesetzt haben, was sie haben.", "Nix")
	await novel_interface.show_dialog("Das Ergebnis ist, dass sein Gegner seine Entscheidung anhand seines Verhaltens leicht vorhersagen kann.", "Nix")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Kurz gesagt: Sie werden nicht viel Geld gewinnen, wenn Sie ein gutes Blatt haben, und Sie werden alles verlieren, wenn Ihr Gegner ein besseres Blatt hat.", "Nix")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("Jeder, der alles verspielt, was er hat, ist so ein Idiot.", "Nix")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Das ist hart!", "Lian")
	await novel_interface.show_text_only("Lian zittert unkontrolliert.")
	await novel_interface.show_text_only("Nix nippt an ihrem Tee und fährt dann fort.")
	novel_interface.show_character("nyx_normal","mock")
	await novel_interface.show_dialog("Hören Sie, Texas Hold'em ist ein rundenbasiertes Spiel.", "Nix")
	await novel_interface.show_dialog("Das Wichtigste sind nicht Ihre Karten, sondern Ihre Gegner.", "Nix")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_Choice.png")
	await novel_interface.show_dialog("Nachdem Sie eine Aktion ausgeführt haben, haben Ihre Gegner nur noch drei Möglichkeiten: Aussteigen, Mitgehen oder Erhöhen.", "Nix")
	await novel_interface.show_dialog("Daher sollten Sie Ihre Schritte auf einem Prinzip basieren: Sorgen Sie dafür, dass Ihre Gegner keine Gründe finden, eine ihrer drei Optionen zu unterstützen.", "Nix")
	await novel_interface.show_dialog("Der beste Zug ist ein Zug, der Ihren Gegnern das Gefühl gibt, dass jede von ihnen getroffene Entscheidung richtig, aber gleichzeitig auch falsch sein könnte.", "Nix")
	await novel_interface.show_dialog("Es macht durchaus Sinn...", "Lian")
	await novel_interface.show_dialog("Wenn sie in eine solche Situation geraten, geraten sie in Panik – und leiden sogar.", "Nix")
	await novel_interface.show_dialog("Und sie werden an der Reihe sein und sich befreien wollen.", "Nix")
	await novel_interface.show_dialog("Dann haben Sie die Kontrolle über das Spiel – der perfekte Moment, um sie auszumerzen.", "Nix")
	await novel_interface.hide_background()
	await novel_interface.show_dialog("Räumen Sie sie aus...", "Lian")
	await novel_interface.show_text_only("Ich nicke, während ich über Nix‘ Worte nachdenke.")
	await novel_interface.show_dialog("(Wo hat Nix das alles gelernt?...)", "Lian")
	await novel_interface.show_dialog("(Jedenfalls spiele ich nie Poker mit ihr!)", "Lian")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_Gambling_Boat.png")
	await novel_interface.show_text_only("Ich kehre zum Pokertisch zurück. Mit Hilfe von Nix verdoppele ich meine Chips in weniger als einer Stunde.")
	await novel_interface.show_text_only("In der Hand, in der ich das meiste Geld verdiente, hörte ich Nix und Aya in dem Moment, als ich alle meine Chips eingesetzt hatte, darüber reden, wie ich aussehe, wenn ich schlafe.")
	await novel_interface.show_text_only("Sie haben sogar Fotos ausgetauscht! Es war mir so peinlich, dass mein Gesicht rot wurde.")
	await novel_interface.show_text_only("Meine Gegner wussten nicht, was los war – sie dachten, ich würde bluffen … Also tappten sie direkt in die Falle.")
	await novel_interface.hide_background()
	await novel_interface.show_dialog("Ich habe immer noch das Gefühl, dass sie zu weit gegangen sind, obwohl sie mir zum Sieg verholfen haben.", "Lian")
	await novel_interface.show_dialog("Ich möchte nicht länger darüber nachdenken!", "Lian")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_Gambling_Boat3.png")
	await novel_interface.show_text_only("Jetzt folge ich dem Casino-Kellner, um den VIP-Raum zu betreten.")
	await novel_interface.show_text_only("Das Ambiente dieses Raumes hat nichts mit der Lobby zu tun. Dekorationen, Tische, Stühle ... Sie sind alle viel ausgefallener.")
	await novel_interface.show_text_only("An einem Tisch sitzen drei Männer in teuren Anzügen, schon etwas beschwipst. Mehrere heiße Girls unterhalten sich auf der Couch.")
	await novel_interface.show_text_only("„Liberty Star“ ist ein kleines Casino-Schiff, das High Rollern vorbehalten ist. In graue Rüstung gehüllt, bleibt es sehr unauffällig.")
	await novel_interface.show_text_only("Um an Bord dieses Schiffes zu gehen, müssen mindestens 20 Millionen Chips gekauft werden, und an Bord sind nicht einmal ein paar Dutzend Gäste.")
	await novel_interface.show_text_only("Für den VIP-Raum müssen Sie mehr als 50 Millionen gewinnen ...")
	await novel_interface.show_text_only("Ich folgte Marirus Anweisungen und tauschte 100 Millionen in bar gegen einen einzelnen Goldchip ein, in den ein exquisites Lebona-Wappen eingraviert war.")
	novel_interface.show_character("ren_full","worry")
	await novel_interface.show_dialog("Vielleicht stimmten die Gerüchte tatsächlich...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Chips aus Stoff H, die starken Stößen, Magnetfeldern und hohen Temperaturen standhalten; Sie können in Hunderten von Casinos auf der ganzen Welt ausgezahlt werden.")
	await novel_interface.show_text_only("Es handelt sich wohl um die höchstbewertete Inhaberschuldverschreibung.")
	await novel_interface.show_dialog("Wir haben alle ihre Überwachungskameras gekapert. Es kann losgehen, wann immer Sie dazu bereit sind! ", "Annie")
	await novel_interface.show_text_only("Endlich eine gute Nachricht!")

	print("=== 星尘降临篇第4话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
