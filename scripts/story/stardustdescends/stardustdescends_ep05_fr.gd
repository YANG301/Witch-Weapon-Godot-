	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Pas étonnant que la recherche soit interdite...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Il est également extrêmement instable – une bombe à retardement dont personne ne sait quand elle explosera.", "Mariru")
	await novel_interface.show_dialog("Hovering Palace a essayé tous les moyens possibles pour se débarrasser de la météorite. En fin de compte, l'église a accepté de le reprendre et Samonton a accordé la permission.", "Mariru")
