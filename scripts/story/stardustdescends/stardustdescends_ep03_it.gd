# stardustdescends_ep03.gd - 星尘降临篇第3话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	stardustdescends_ep03_script()

func play_script():
	pass

func stardustdescends_ep03_script():
	novel_interface.change_music("res://assets/audio/music/Shop.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_NoxRoom.png")
	await novel_interface.show_text_only("Mi siedo all'angolo del lussuoso letto di Nix e ascolto la sua storia.")
	novel_interface.show_character("nyx_full","normal1")
	await novel_interface.show_dialog("Cambiano la mia guardia ogni sei mesi. Quei due ragazzi là fuori sono stati trasferiti qui meno di tre mesi fa.", "Nix")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Più tardi dirai alle guardie che accompagnerai personalmente Lian a casa. Ho già spedito la macchina.", "Mariru")
	await novel_interface.show_dialog("Non appena quelle guardie saliranno in macchina, se ne occuperanno.", "Mariru")
	novel_interface.show_character("nyx_full","sad")
	await novel_interface.show_dialog("Ma devono presentarsi regolarmente. Se non vogliamo destare sospetti, non abbiamo bisogno della loro collaborazione?", "Nix")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Apparentemente Nix non è convinto dell'attuale piano di fuga.")
	novel_interface.show_character("nyx_full","normal1")
	await novel_interface.show_dialog("Tutte le guardie inviate qui per spiarmi hanno ricevuto un rigoroso addestramento anti-interrogatorio da parte dell'agenzia di intelligence esterna.", "Nix")
	novel_interface.change_expression("sad")
	await novel_interface.show_dialog("Non credo che collaboreranno volentieri...", "Nix")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_full","upset")
	await novel_interface.show_dialog("L'agenzia di intelligence esterna?", "Lian")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_Commandments.png")
	await novel_interface.show_text_only("Sì. Sono conosciuti anche come i Sette Comandamenti. Adesso lo gestisce Lebona, ma ha avuto origine dalle vecchie mafie europee.")
	await novel_interface.show_text_only("L'agenzia è nota per aver compiuto omicidi impossibili e per la sua ossessione per gli abiti neri.")
	await novel_interface.show_text_only("Ciò che ha reso davvero leggendaria l'agenzia, tuttavia, è che si tratta di un'organizzazione indipendente responsabile solo del Credo di Lebona.")
	await novel_interface.show_text_only("Nessun governo lo controlla e, grazie alle centinaia di casinò che gestisce in tutto il mondo, dispone di finanziamenti praticamente illimitati.")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_NoxRoom.png")
	novel_interface.show_character("ren_full","happy")
	await novel_interface.show_dialog("(Parliamo di hardcore...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ho raggiunto il livello platino in tutti i giochi basati su questa agenzia!")
	novel_interface.show_character("ren_full","gratified")
	await novel_interface.show_dialog("Quindi, se volessimo attuare il piano di estrazione in modo sicuro, non solo dovremmo salvare Nix, ma dovremmo anche farlo a loro insaputa.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Non devi preoccuparti di questo.", "Mariru")
	await novel_interface.show_text_only("Mariru sorride orgogliosa.")
	await novel_interface.show_dialog("Abbiamo sempre piani speciali per obiettivi speciali.", "Mariru")
	await novel_interface.show_text_only("Non posso fare a meno di immaginare Aya circondata da strumenti di tortura e divertirsi allegramente...")
	await novel_interface.show_dialog("Un ultimo controllo, voi due. Allora sei a posto!", "Mariru")
	await novel_interface.show_text_only("Mariru è finito e uscito.")
	await novel_interface.show_text_only("Il silenzio improvviso mi mette a disagio. Nix, d'altra parte, sta ancora fissando il mio ampio petto.")
	novel_interface.show_character("nyx_full","smile")
	await novel_interface.show_dialog("La tua voce... quasi mi sarei lasciato ingannare.", "Nix")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Abbasso la testa, imbarazzata.")
	novel_interface.show_character("ren_full","shy")
	await novel_interface.show_dialog("Ehm... grazie...?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Di cosa stiamo parlando, esattamente?")
	await novel_interface.show_text_only("Aya ha detto qualcosa a proposito di un aggiornamento. Sembra che la tua voce sembri più femminile adesso.")
	novel_interface.show_character("ren_full","shy_right")
	await novel_interface.show_dialog("(Perché si è presa la briga di aggiornare qualcosa del genere?...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Nix si avvicina all'improvviso, portando la sua mano destra dietro la mia schiena.")
	novel_interface.show_character("ren_full","panic")
	await novel_interface.show_dialog("Cosa stai facendo...?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("La sento infilare qualcosa sopra i miei vestiti e istintivamente emetto un piccolo sospiro di sollievo...")
	novel_interface.show_character("ren_full","awkward")
	await novel_interface.show_dialog("!!!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Non dirmi che è la fibbia di quello...")
	await novel_interface.show_text_only("Prima ancora che io possa capire cosa sia successo, la sua mano si infila nei miei vestiti... e mi tira fuori il reggiseno nero!!")
	novel_interface.show_character("ren_full","awkward")
	await novel_interface.show_dialog("...", "Lian")
	await novel_interface.show_dialog("...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("...")
	await novel_interface.show_text_only("Aaaaaaaah!")
	await novel_interface.show_text_only("Mi stringe il reggiseno qua e là per un bel po', poi mi guarda dubbiosa dopo non essere riuscita a trovare alcun dispositivo per cambiare la voce.")
	await novel_interface.show_text_only("Con la faccia rossa, le riprendo il reggiseno e corro in bagno.")
	novel_interface.show_character("nyx_full","smile")
	await novel_interface.show_dialog("Stai bene, Lian? Hai lo stomaco sottosopra?", "Nix")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("Se è quel periodo del mese, troverai ciò di cui hai bisogno nell'armadietto dei medicinali.", "Nix")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Nix sembra sinceramente preoccupato.")
	novel_interface.show_character("ren_full","sob")
	await novel_interface.show_dialog("Non è quello!!!", "Lian")
	await novel_interface.show_dialog("(Buu-hoo!)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.hide_background_with_fade()
	await novel_interface.stop_music()
	await novel_interface.show_text_only("...")
	await novel_interface.show_text_only("Nel frattempo... SID Sala Comando")
	novel_interface.change_music("res://assets/audio/music/Normal Stage.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	await novel_interface.show_text_only("Aya sta esaminando una pila di documenti sulla sua scrivania. Cinque finestre sono aperte e cambiano rapidamente sul grande schermo di fronte a lei.")
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("Ehi...", "Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aya si gira e guarda la donna in uniforme.")
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("C'erano molti altri modi per ottenere informazioni da quello zotico...", "Aya")
	await novel_interface.show_dialog("Perché hai dovuto mandare Lian? Aumenta solo il rischio. Non hai paura che lei e Annie inizino a sospettare qualcosa?", "Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru controlla i dati sul suo dispositivo mobile e sorride.")
	novel_interface.show_character("liliu_uniform1","normal2")
	await novel_interface.show_dialog("Lian è troppo eccitata per sospettare qualcosa mentre è nella camera da letto di Nix.", "Mariru")
	await novel_interface.show_dialog("Inoltre... Questa è stata un'idea di Annie tanto per cominciare.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("Cosa?", "Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal2")
	await novel_interface.show_dialog("Sono sicuro che ti ricordi.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Soya/Earthperspective.png")
	await novel_interface.show_dialog("Circa due settimane fa, dopo che Lian ha riportato indietro Sonya dall'area del flusso, dove si è verificato un flusso spaziotemporale a livello globale ed è durato circa 5 secondi.", "Mariru")
	await novel_interface.show_dialog("Il segnale era forte ma non durò a lungo. Pertanto, nessun paese è stato in grado di risalire alla sua fonte.", "Mariru")
	await novel_interface.show_dialog("La storia ufficiale ora è che un lampo di raggi gamma si è verificato vicino al sistema solare.", "Mariru")
	await novel_interface.show_dialog("Anche se è inventato, una cosa è vera: l'umanità era così vicina all'estinzione.", "Mariru")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.show_character("liliu_uniform1","serious")
	await novel_interface.show_dialog("Ma il mondo non è finito. Quindi dobbiamo assicurarci che nessuno colleghi New Opulentia a quell'incidente.", "Mariru")
	await novel_interface.show_dialog("Il SID ha monitorato tutte le notizie e le comunicazioni.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Finora non è emerso nulla di concreto, ma Annie ha scoperto qualcosa di interessante attraverso la scansione dei social media.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Annie è diventata così brava, eh? Il suo istruttore ha detto che ha lavorato duro anche nell'allenamento fisico.", "Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","sigh")
	await novel_interface.show_dialog("Ha le sue ragioni, quel ragazzo.", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("Lian, tuttavia, è tutta un'altra storia...", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru tira fuori un elenco di tutti i giochi che Lian ha completato di recente.")
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("Ad ogni modo, Annie ha trovato dozzine di post pubblicati lo stesso giorno in cui Lian ha riportato indietro Sonya. Provengono da persone diverse che hanno fatto lo stesso strano sogno durante i sonnellini pomeridiani.", "Mariru")
	await novel_interface.show_dialog("\"Sognavo di cadere in un abisso oscuro e di incontrare i miei parenti che erano morti.\"", "Mariru")
	await novel_interface.show_dialog("Nessuna di queste persone aveva molti follower, quindi i loro post non attiravano molta attenzione.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("Sogni durante i sonnellini pomeridiani...", "Aya")
	novel_interface.change_expression("think")
	await novel_interface.show_dialog("Aspetta! Il flusso spaziotemporale è avvenuto intorno alle 16:00, ora New Opulentia!", "Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("Non sono molte le persone che fanno un pisolino in quel momento, e ancora meno pubblicano i propri sogni online.", "Mariru")
	await novel_interface.show_dialog("Abbiamo fatto più analisi. Tutti gli indirizzi fisici di questi account si trovano all'interno di New Opulentia, entro un raggio di 5 miglia.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aya ascolta, con gli occhi lucidi.")
	novel_interface.show_character("liliu_uniform1","serious")
	await novel_interface.show_dialog("E il centro di quella regione è la villa di Nix.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","blush_dizzy")
	await novel_interface.show_dialog("Quindi potrebbe esserci davvero qualcosa di speciale in quella villa. Quando la Porta del Paradiso si aprì, quella cosa scatenò i sogni nelle persone che dormivano?", "Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aya sembra eccitata.")
	novel_interface.show_character("liliu_uniform1","normal2")
	await novel_interface.show_dialog("Dato che all'inizio non ne ero sicuro, ho chiesto ad Annie di installare un sensore Boltzmann nel sistema di sicurezza della villa.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("\"Voglio vederlo.\" Aya va rapidamente da Mariru, ma Mariru mette la mano sul viso di Aya per fermarla.")
	await novel_interface.show_text_only("La ragazza dai capelli argentati, sfortunatamente, ha le braccia corte: non riesce a raggiungere Mariru, le sue mani agitano in aria.")
	novel_interface.show_character("ai","blush_dizzy")
	await novel_interface.show_dialog("\"Che ci hai visto!\" (Voglio vederlo!)", "Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal2")
	await novel_interface.show_dialog("Te lo farò vedere dopo che avremo recuperato il sensore. Adesso sbrigati e finisci il compito che ti ha dato il professor Shih!", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.stop_music()
	await novel_interface.show_text_only("Quindi, Mariru esce dalla sala di comando, fissando i dati satellitari che sta ricevendo sul suo dispositivo.")
	await novel_interface.show_dialog("(Un'esplosione di onde radio a bassa frequenza si è verificata quando le fronti di Lian e Nix si sono toccate in precedenza.)", "Mariru")
	await novel_interface.show_dialog("Mostrava lo stesso schema delle onde cerebrali umane durante il sonno REM...", "Mariru")
	novel_interface.show_background("res://assets/images/bg/Baizhu/snowfield.png")
	await novel_interface.show_text_only("Quasi identico a quanto accaduto in Antartide...")

	print("=== 星尘降临篇第3话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
