# stardustdescends_ep4.gd - 星尘降临篇第4话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	stardustdescends_ep4_script()

func play_script():
	pass

func stardustdescends_ep4_script():
	novel_interface.change_music("res://assets/audio/music/Story_01.mp3")
	novel_interface.change_background("res://assets/images/bg/Fabiola/Hospital_Passage.png")
	await novel_interface.show_text_only("幾小時後，播磨腦研科學綜合研究中心。")
	await novel_interface.show_text_only("身穿白大衣的瘦小女性一邊用耳機通話，一邊懶洋洋地在平板電腦上滑動著手指。")
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("放心好啦，那兩個乖寶寶都在好好地做夢呢。", "愛衣")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("嘿嘿，可別小看人類大腦將自身處境合理化的意願和能力哦──", "愛衣")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("愛衣瞥了一眼病房，兩個穿著黑色西裝的男人分別躺在兩台潛腦裝置上。")
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("畢竟只有自己編造的故事才最能騙過自己嘛～", "愛衣")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("突然，愛衣被平板上顯示的內容所吸引，她快速向下翻了幾個畫面，接著又回頭再次確認。")
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("喂喂喂，這個數據……", "愛衣")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("怎麼？", "莉琉")
	novel_interface.show_character("ai","dizzy")
	await novel_interface.show_dialog("小憐和倪克斯額頭觸碰的時候，別墅監視器上的玻爾茲曼探針讀數有一瞬間爆表了！？", "愛衣")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("會不會是設備故障……妳調整後的測量範圍不是已經達到理論極值了嗎？", "莉琉")
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("只是接近而已，如果資訊量逼近貝肯斯坦上限的話就沒辦法了……", "愛衣")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("如果是那樣的話，就代表那一瞬間爆發的資訊量接近了物質所能攜帶的資訊上限！？", "莉琉")
	await novel_interface.show_text_only("愛衣快速在平板上進行著計算。")
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("如果先不考慮那個異常的話，倪克斯的特徵數據倒是與魔女完全吻合，可是她自己似乎沒察覺到？", "愛衣")
	await novel_interface.show_dialog("是和拉斐爾的狀況類似嗎？
要是索婭沒被派遣出去就方便了……", "愛衣")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("愛衣一邊抱怨，一邊打開了讀數異常期間別墅內的監視錄影。")
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("而且一定不是機械故障。因為讀數很快就恢復到了正常水平，探針送回來時的狀態也很完好。", "愛衣")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("更重要的是，當時只有小憐突然失去意識，在場的其他人完全沒有受到影響……", "愛衣")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("愛衣快速排除著各種不合邏輯的假設，似乎最後只剩下一個解釋──")
	novel_interface.show_character("ai","blush_dizzy")
	await novel_interface.show_dialog("就是說，小憐一個人，在不到一秒之內，將瞬間爆發出超過2.5YB的資訊完全吸收了？", "愛衣")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("在說出推理結果之後，她自己都有點難以置信。")
	await novel_interface.show_dialog("……YB是多大的單位來著？", "莉琉")
	novel_interface.show_character("ai","blush_dizzy")
	await novel_interface.show_dialog("沒錯！1YB是10的24次方位元組，這個資訊量超過了戰前整個網際網路的容量總和……", "愛衣")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("愛衣盡量壓抑著自己因興奮而顫抖的語調。")
	novel_interface.show_character("ai","blush_dizzy")
	await novel_interface.show_dialog("我還以為，那個小可愛的腦袋瓜除了遊戲攻略以外裝不下什麼東西了呢～", "愛衣")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("等等，10的24次方的計量單位還叫做「堯」吧？
在施教授的那份情報裡好像也出現過！", "莉琉")
	novel_interface.show_character("ai","blush_stare")
	await novel_interface.show_dialog("妳是說華雲宮的那塊古代隕石……", "愛衣")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("愛衣很快將剛才的紙本資訊照片調出來，沉吟了好一陣。")
	novel_interface.show_character("ai","blush_wink")
	await novel_interface.show_dialog("哦呀呀，搞不好這件事只能靠小憐了。", "愛衣")
	await novel_interface.hide_character()
	await novel_interface.hide_background_with_fade()
	await novel_interface.stop_music()
	await novel_interface.show_text_only("……")
	await novel_interface.show_text_only("5天後，萊博娜「自由之星」號賭船。")
	novel_interface.change_music("res://assets/audio/music/Shop.mp3")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_Gambling_Boat.png")
	await novel_interface.show_dialog("咳咳，這位小姐……", "荷官")
	await novel_interface.show_dialog("這位小姐？", "荷官")
	novel_interface.show_character("ren_full","panic")
	await novel_interface.show_dialog("唔……啊？", "小憐")
	await novel_interface.show_dialog("棄，棄牌……", "小憐")
	novel_interface.change_expression("perspire1")
	await novel_interface.show_dialog("不好意思，下一局我退出～～", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("少女離開牌桌，走到走廊轉角找了個沒人的角落。")
	novel_interface.show_character("ren_full","wry_smile")
	await novel_interface.show_dialog("剛才那把是同花欸！為什麼非要我棄牌啊～！", "小憐")
	await novel_interface.show_dialog("（小聲）而且前兩輪都跟注那麼多了……", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("雖然壓低著嗓門，但小憐的話語中明顯透露著不甘心。")
	await novel_interface.show_dialog("喂喂小憐，別在那邊自言自語，至少拿出手機假裝打電話吧。", "安妮")
	await novel_interface.show_dialog("船上有三個監控室，我只掃蕩了其中一個……", "安妮")
	novel_interface.show_character("ren_full","wail")
	await novel_interface.show_dialog("（掃、掃蕩？）", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("這艘賭船雖然不大，但遍佈著攝影機，如果被人發現妳戴著微型耳機的話，恐怕會被丟進海裡餵鯊魚哦。", "倪克斯")
	await novel_interface.show_text_only("我打了個冷顫，立刻從手拿包裡掏出手機。")
	novel_interface.show_character("ren_full","upset")
	await novel_interface.show_dialog("都輸掉兩成多的本金了，不是說要贏到翻倍才能進入貴賓室嗎？", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("看著賭場發的手環上顯示的籌碼數量，我不停安慰自己：這是莉琉的錢、這是莉琉的錢……")
	novel_interface.show_character("ren_full","sob")
	await novel_interface.show_dialog("（但是，說穿了這也是新豐洲市民的稅金啊！！）", "小憐")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Dispatched_Ship_Aisle.png")
	await novel_interface.show_text_only("海拔三萬公尺的高空，SID所屬高速重型運輸機上，倪克斯端著一杯紅茶盯著投影畫面。")
	novel_interface.show_character("nyx_normal","normal1")
	await novel_interface.show_dialog("剛才妳只有方塊2和6，從對方的行為來看，他有很高的機率也中了同花，而且牌面幾乎肯定比妳大。", "倪克斯")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("欸！？
我剛才都想ALL-IN了……", "小憐")
	novel_interface.show_character("nyx_normal","speak")
	await novel_interface.show_dialog("唉……", "倪克斯")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("她無奈地歎了口氣，思考著怎麼解釋才能讓這個昨晚抱著五千萬籌碼流了一夜口水的笨蛋搞清楚。")
	novel_interface.show_character("nyx_normal","normal2")
	await novel_interface.show_dialog("菜鳥最常犯的錯誤，就是遇到好牌就想快點下重注甚至ALL-IN，反之就恨不得馬上棄牌。", "倪克斯")
	await novel_interface.show_dialog("尤其是拿到好牌的時候，很容易頭腦發熱從而喪失蒐集賭桌上資訊的能力，陷入盲目無知的狀態。", "倪克斯")
	await novel_interface.show_dialog("無知導致恐懼，恐懼導致魯莽，所以菜鳥只能透過ALL-IN來釋放內心的恐懼。", "倪克斯")
	novel_interface.change_expression("sad")
	await novel_interface.show_dialog("在把籌碼全部推入底池的那一刻，你的靈魂才終於獲得自由。", "倪克斯")
	await novel_interface.show_dialog("結果就是對手很容易根據他的行為預測選擇。", "倪克斯")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("所以這種人拿到好牌卻贏不到錢，直到某局被對手更好的牌一把吃光──", "倪克斯")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("在賭場一夜輸到傾家蕩產的，基本上都是這種笨蛋。", "倪克斯")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("咦！", "小憐")
	await novel_interface.show_text_only("小憐的身體好像被一支箭射中，微微顫抖了一下。")
	await novel_interface.show_text_only("倪克斯滿意地端起茶杯抿了一口，接著緩緩說道。")
	novel_interface.show_character("nyx_normal","mock")
	await novel_interface.show_dialog("聽好了，德州撲克是輪流行動的遊戲──", "倪克斯")
	await novel_interface.show_dialog("妳最應該關注的是和妳一起在底池下注的對手，而不是自己手裡的牌。", "倪克斯")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_Choice.png")
	await novel_interface.show_dialog("當妳做出行動之後，對手只有三個選擇：「棄牌」、「跟注」或者「加注」。", "倪克斯")
	await novel_interface.show_dialog("所以，妳的行動首要原則是：讓對手找不到支持自己選擇任一種行動的理由。", "倪克斯")
	await novel_interface.show_dialog("最好的狀態是，在對方看來，似乎每個選擇都是對的，或者說每個選擇都不對。", "倪克斯")
	await novel_interface.show_dialog("好像……有點道理……", "小憐")
	await novel_interface.show_dialog("當對手面對資訊黑洞，找不到最佳選擇，每次出手都會處於萬分糾結和痛苦的狀態──", "倪克斯")
	await novel_interface.show_dialog("就像是在經歷一場心靈和意志的折磨，需要盡快找到解脫。", "倪克斯")
	await novel_interface.show_dialog("那個時候，就是妳掌控局面，將他吃乾抹淨的最好時機～", "倪克斯")
	await novel_interface.hide_background()
	await novel_interface.show_dialog("吃乾…抹淨……？", "小憐")
	await novel_interface.show_text_only("我回味著學姐的話語，小心翼翼地點了點頭。")
	await novel_interface.show_dialog("（學姐到底是怎麼學會這些的……）", "小憐")
	await novel_interface.show_dialog("（總之，千萬不能讓我和她一起打牌啊！！）", "小憐")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_Gambling_Boat.png")
	await novel_interface.show_text_only("我乖巧地回到牌桌，在學姐的指揮下，不到一個小時就讓自己手中的籌碼翻了一倍。")
	await novel_interface.show_text_only("其中贏的最大一把，我剛押上全部籌碼，就聽到耳機裡學姐和愛衣討論起我的睡相。")
	await novel_interface.show_text_only("而且兩個人居然還開始交換照片！聽得我的臉紅一陣紫一陣。")
	await novel_interface.show_text_only("對手看我慌張的表情還以為我在虛張聲勢，也跟著一起全下了。")
	await novel_interface.hide_background()
	await novel_interface.show_dialog("雖然贏了，但總覺得她們……", "小憐")
	await novel_interface.show_dialog("啊啊啊啊實在想不下去啦！", "小憐")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_Gambling_Boat3.png")
	await novel_interface.show_text_only("在侍者引導下，我終於進入賭船的VIP區。")
	await novel_interface.show_text_only("這個房間與大廳的感覺完全不同，裝修、擺設甚至座椅的材質都更加高級。")
	await novel_interface.show_text_only("三個穿著講究的男人在牌桌上喝得微醺，遠處沙發上幾個身材火辣的姐姐正在嘰嘰喳喳地聊天。")
	await novel_interface.show_text_only("自由之星號本來就是針對高檔賭客的小型賭船，船身覆蓋著灰色的裝甲，外觀極其低調。")
	await novel_interface.show_text_only("想要上船最低要買進兩千萬的籌碼，船上總共也只有不到幾十名客人。")
	await novel_interface.show_text_only("而想要進入VIP區，更是要在萊博娜任一賭場內累計贏錢五千萬以上。")
	await novel_interface.show_text_only("按照莉琉的指示，我將一億現金兌換成了一枚金色籌碼，上面雕刻著精美的萊博娜徽記。")
	novel_interface.show_character("ren_full","worry")
	await novel_interface.show_dialog("這就是那枚傳說中的……", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("使用異質物材料作為外殼，能抵抗強衝擊、強磁場和高溫，可以在全球數百家賭場立刻兌現。")
	await novel_interface.show_text_only("可以說是全世界最高額度的不記名債券。")
	await novel_interface.show_dialog("監控劫持已經完成，隨時可以動手哦。", "安妮")
	await novel_interface.show_text_only("終於，耳機傳來了讓人安心的聲音。")

	print("=== 星尘降临篇第4话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
