# stardustdescends_ep10.gd - 星尘降临篇第10话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	stardustdescends_ep10_script()

func play_script():
	pass

func stardustdescends_ep10_script():
	await novel_interface.show_text_only("К тому времени, как мы вышли из иммиграционного контроля, небо прояснилось, и мы втроем сели на борт железнодорожного шаттла.")
	await novel_interface.show_text_only("Поезд на магнитной подвеске был невероятно быстрым. Менее чем за десять минут он прибыл на вокзал Кнессета в центре города Масада.")
	await novel_interface.show_text_only("...")
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_Masadainner.png")
	novel_interface.show_character("anne_uniform","panic")
	await novel_interface.show_dialog("Это...", "Энни")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","happy")
	await novel_interface.show_dialog("Т-это невероятно!!", "Лиан")
	await novel_interface.hide_character()
	novel_interface.show_character("stardust_small","happy")
	await novel_interface.show_dialog("Уууу──", "Stardust")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","happy")
	await novel_interface.show_dialog("Так это... Масадабург?", "Лиан")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_uniform","panic",0.25)
	await novel_interface.show_dialog("Даже я... не ожидал этого...", "Энни")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Сцена, представшая перед нами, полностью перевернула мое представление о Масаде как о «крепости в пустыне, опустошенной войной» ──")
	await novel_interface.show_text_only("На улицах, таких же аккуратных и элегантных, как сад, повсюду можно было увидеть санитарных роботов с искусственным интеллектом и беспилотные грузовые тележки.")
	await novel_interface.show_text_only("Фасады высотных зданий в отдаленном центре города были облицованы металлическими панелями с сильным футуристическим оттенком, слабо отражающими белые облака над головой.")
	await novel_interface.show_text_only("Под голубым небом огромные просторы зелени простирались до самого горизонта...")
	novel_interface.show_character("ren_medical","smile")
	await novel_interface.show_dialog("Этот воздух кажется удивительно освежающим──", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Опираясь на каменные перила, я глубоко вздохнул. Влажный воздух имел слабый соленый привкус, свойственный морскому ветру.")
	novel_interface.show_character("ren_medical","smile")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_uniform","happy",0.25)
	await novel_interface.show_dialog("Это место с самым высоким атмосферным давлением на Земле. Когда в воздухе больше кислорода, дышать становится легче~", "Энни")
	novel_interface.change_2nd_expression("normal1")
	await novel_interface.show_dialog("Я не могу поверить, что они превратили пустыню на Мертвом море в это...", "Энни")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Энни, что это там за длинный отрезок...?", "Лиан")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Я указал налево. Вдали стоял барьер, идущий с востока на запад, а за ним, казалось, вообще не было высотных зданий.")
	novel_interface.show_character("anne_uniform","stare")
	await novel_interface.show_dialog("Это «изоляционная стена».", "Энни")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Мы сейчас далеко, но на самом деле он высотой в несколько десятков метров, с контрольно-пропускными пунктами и автоматизированными системами защиты повсюду.", "Энни")
	await novel_interface.show_dialog("Под землей также спрятано множество датчиков. Даже мышь не могла пройти.", "Энни")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Энни вздохнула и тихо пробормотала про себя.")
	novel_interface.show_character("anne_uniform","upset")
	await novel_interface.show_dialog("В их предыдущей столице тоже было что-то подобное, но ее все равно сгладили...", "Энни")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","worry")
	await novel_interface.show_dialog("Это случилось давным-давно, верно...?\nЯ тогда еще учился в начальной школе──", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Затем мне пришло в голову, что Энни провела семь лет в Разрыве Причинности. Для нее это воспоминание, возможно, не такое уж старое.")
	novel_interface.show_character("ren_medical","wry_smile")
	await novel_interface.show_dialog("Н-Кстати ──\nКакой смысл строить такую стену?", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я поспешно сменил тему, довольно неловко.")
	novel_interface.show_character("ren_medical","smile")
	await novel_interface.show_dialog("Если бы война действительно разразилась, такая стена ничего бы не остановила...", "Лиан")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","normal2")
	await novel_interface.show_dialog("Правительства строят стены по самым разным причинам: чтобы остановить вторжения, не дать людям бежать, не допустить нелегальных иммигрантов...", "Энни")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Энни сказала это, глядя на флаги шести школьных городов в парке впереди.")
	novel_interface.show_character("anne_uniform","upset")
	await novel_interface.show_dialog("Но ситуация Масады еще сложнее...", "Энни")
	await novel_interface.show_dialog("По обе стороны этой стены многие люди не хотят видеть другую сторону.", "Энни")
	await novel_interface.show_dialog("Только не видя другой стороны, делая вид, что других не существует, они смогут жить с чистой совестью.", "Энни")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("Ну... хотя я сомневаюсь, что ты действительно это поймешь, Лиан.", "Энни")
	await novel_interface.hide_character()
	novel_interface.show_character("stardust_small","pleased")
	await novel_interface.show_dialog("Ох~~ Я вижу...", "Stardust")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Stardust внезапно вмешалась в разговор, кивнув и приняв задумчивую позу, как будто она полностью все поняла.")
	novel_interface.show_character("stardust_small","pleased")
	await novel_interface.show_dialog("Мм, мм~", "Stardust")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Как будто ты что-то понимаешь! Разве это не та же самая реакция, которую я испытываю, когда отключаюсь на уроке физики?!")
	await novel_interface.show_text_only("Честно говоря, объяснение Энни тоже пролетело мимо моей головы. Возможно, это как-то связано с ее собственным прошлым...")
	await novel_interface.show_text_only("Увидев пустой и потерянный взгляд в моих глазах, Энни обняла меня за шею.")
	novel_interface.show_character("anne_uniform","smile")
	await novel_interface.show_dialog("Эй, не воспринимай это так серьезно. В основном я говорю ерунду~", "Энни")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("Позвольте мне сказать вам кое-что. \"Phantom Force\" Масады находится где-то под землей в центре города!", "Энни")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","panic")
	await novel_interface.show_dialog("А...?\nТы имеешь в виду тот гетероморфный объект класса XK?", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("«Phantom Force» — гетероморфный объект стратегического класса Масады, существующий как неподвижное выделенное пространство.")
	await novel_interface.show_text_only("Любое оружие, выпущенное изнутри этого пространства, получает аномальный эффект усиления, производя разрушительную силу, в несколько или сотни раз превышающую его первоначальную конструкцию.")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_doomsday.png")
	await novel_interface.show_text_only("«Автоматическая система контратаки», о которой Третья школа города объявила некоторое время назад, использует именно это свойство.")
	await novel_interface.show_text_only("Если система определит, что ущерб городской территории Масады превысил 50%, она автоматически активирует «Программу Судного дня»──")
	await novel_interface.show_text_only("Используя Phantom Force для безразборного запуска ядерного оружия по всем крупным городам мира, гарантируя взаимное уничтожение.")
	await novel_interface.show_text_only("Когда это было впервые объявлено, это вызвало яростные протесты, но люди, похоже, на удивление быстро смирились с совершившимся фактом.")
	await novel_interface.show_text_only("Тот факт, что Масаде удалось быстро достичь соглашения о прекращении огня с сопротивлением, вероятно, во многом связан с этой системой.")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_Masadainner.png")
	novel_interface.show_character("anne_uniform","smile")
	await novel_interface.show_dialog("Вы видите металлическую броню на этих зданиях?", "Энни")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","stare")
	await novel_interface.show_dialog("Я это заметил раньше...", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Не говорите мне, что весь этот город был построен для борьбы с апостолами...")
	novel_interface.show_character("anne_uniform","smile")
	await novel_interface.show_dialog("Я слышал, что все подземелья внутреннего города покрыто такой же броней.", "Энни")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Чем больше я слышу, тем больше это звучит именно так!")
	novel_interface.show_character("ren_medical","perspire1")
	await novel_interface.show_dialog("Ч-что ты имеешь в виду...?", "Лиан")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","smile")
	await novel_interface.show_dialog("Как вы думаете, почему они решили построить свою новую столицу в этой бесплодной соленой пустыне на берегу Мертвого моря?", "Энни")
	await novel_interface.show_dialog("А затем потратили огромную сумму на строительство грандиозного канала с перепадом высоты более четырехсот метров только для того, чтобы поддержать столицу в таком жалком месте.", "Энни")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","panic")
	await novel_interface.show_dialog("Из-за Phantom Force внизу...?", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я указал на землю под ногами, но что-то в этом показалось неправильным.")
	novel_interface.show_character("ren_medical","panic")
	await novel_interface.show_dialog("Но это все равно слишком большие затраты... Это не Aegis, щит, который может блокировать любую внешнюю атаку.", "Лиан")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","worry")
	await novel_interface.show_dialog("Вот почему каждая страна подозревает, что Phantom Force может обладать каким-то нераскрытым ключевым свойством.", "Энни")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Достаточно того, что лидеры Масады были готовы поставить на карту судьбу всего народа на этой земле.", "Энни")
	await novel_interface.show_dialog("Можно сказать, что весь город — это защитный комплекс, построенный вокруг Phantom Force──", "Энни")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("Тогда, как часть этой защитной системы, строительство изоляционной стены такого масштаба не кажется таким уж странным, не так ли~?", "Энни")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","stare")
	await novel_interface.show_dialog("Так что «Масада никогда не падет» тоже несет в себе этот подтекст…", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Но чем неустанно охраняется тайна, тем любопытнее она делает людей...")
	await novel_interface.show_text_only("Я повернулась, чтобы посмотреть на гигантский рекламный щит возле вокзала Кнессета с тем же лозунгом, и неожиданно увидела знакомое лицо ──")
	await novel_interface.show_text_only("Эмилио, неся набитую белую сумку для покупок, как раз поднимался по эскалатору к выходу со станции...")
	novel_interface.show_character("emilio","smile")
	await novel_interface.show_dialog("О?", "Эмили")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Лейтенант встретился со мной взглядом, улыбнулся и подошел.")
	await novel_interface.show_text_only("Энни мгновенно, как профессионал, вела себя как незнакомая мне незнакомка, утаскивая чемодан и глядя в телефон.")
	await novel_interface.show_text_only("Между тем, за последние два дня Stardust, кажется, поняла, что никто больше не видит и не слышит ее, и стала намного смелее.")
	await novel_interface.show_text_only("Она самодовольно стояла передо мной, как маленькая собачка, ободренная тем, что за ней стоит хозяин.")
	novel_interface.show_character("emilio","mock")
	await novel_interface.show_dialog("Ах! Ты та... медсестра-стажер с корабля-казино, да?", "Эмили")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Она взглянула на бейдж с именем, висевший у меня на груди.")
	novel_interface.show_character("emilio","mock")
	await novel_interface.show_dialog("Тебя зовут Лиан, да~", "Эмили")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","perspire1")
	await novel_interface.show_dialog("Д-привет...\nХотела бы встретиться с вами снова.", "Лиан")
	await novel_interface.hide_character()
	novel_interface.show_character("emilio","mock")
	await novel_interface.show_dialog("Ха-ха, я хотел тебе сказать: после того, как ты ушел в тот день, я преподал этому официанту достойный урок.", "Эмили")
	await novel_interface.show_dialog("Позже мы узнали, что он также приставал к нескольким женщинам-дилерам.", "Эмили")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","wail")
	await novel_interface.show_dialog("——Что!?", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Значит, он тоже был рецидивистом?")
	novel_interface.show_character("emilio","mock")
	await novel_interface.show_dialog("И на этот раз он даже посмел наложить руку на гостя. У него что, в мозгу короткое замыкание или что~", "Эмили")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","wry_smile")
	await novel_interface.show_dialog("Ахахаха...!", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("На самом деле это был спрей для гипноза!")
	novel_interface.show_character("ren_medical","happy")
	await novel_interface.show_dialog("Кстати говоря, мне действительно нужно поблагодарить вас за то, что вы провели меня через охрану рано утром в тот день...", "Лиан")
	await novel_interface.hide_character()
	novel_interface.show_character("emilio","smile")
	await novel_interface.show_dialog("О, это было ничего. В последнее время начальство полюбило нас привлекать к разного рода скучным заданиям.", "Эмили")
	novel_interface.change_expression("upset")
	await novel_interface.show_dialog("И в прошлый раз они тоже выставили себя дураками — команда содержания полдня сканировала корабль горой оборудования и не нашла ровным счетом ничего.", "Эмили")
	novel_interface.change_expression("speechless")
	await novel_interface.show_dialog("Понятия не имею, где они купили эту фальшивую информацию того времени...", "Эмили")
	await novel_interface.hide_character()
	novel_interface.show_character("stardust_small","stare")
	await novel_interface.show_dialog("Хм! И ей все еще приходилось быть такой злой...", "Stardust")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Stardust показала Эмилио язык.")
	novel_interface.show_character("stardust_small","stare")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("emilio","normal",0.25)
	await novel_interface.show_dialog("Кстати ──", "Эмили")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Эмилио присел на корточки.")
	novel_interface.show_character("stardust_small","stare")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("emilio","smile",0.25)
	await novel_interface.show_dialog("Этот ребенок очаровательный~ Она не местная, не так ли?", "Эмили")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Stardust и я застыли на месте.")
	novel_interface.show_character("stardust_small","panic")
	await novel_interface.show_dialog("А...?\nУх... гх...", "Stardust")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Вся ее бравада исчезла в одно мгновение. Испуганная почти до слез, она лихорадочно спряталась за моей спиной.")
	novel_interface.show_character("stardust_small","panic")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_medical","wail",0.25)
	await novel_interface.show_dialog("Ах? Ха-ха-ха...\nS-Она моя... моя, эм...", "Лиан")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Как она вообще ее видит!?")
	await novel_interface.show_text_only("Эмилио вытащила из сумки с покупками стеклянную бутылку с прозрачной красной жидкостью. На нем не было никакой этикетки.")
	novel_interface.show_character("stardust_small","panic")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("emilio","smile",0.25)
	await novel_interface.show_dialog("Свежевыжатый гранатовый сок. Это очень вкусно~\nОдно из знаменитых блюд города.", "Эмили")
	await novel_interface.show_dialog("Вот, возьми одну ──", "Эмили")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Сказав это, она протянула бутылку Stardust. Когда я понял, что мне нужно остановить ее, было уже слишком поздно.")
	await novel_interface.show_text_only("Я практически видел, как бутылка прошла сквозь тело Stardust и разбилась об пол...")
	novel_interface.show_character("stardust_small","uneasy")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("emilio","smile",0.25)
	novel_interface.character_2nd_dark()
