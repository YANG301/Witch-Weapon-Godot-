# stardustdescends_ep21.gd - 星尘降临篇第21话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	stardustdescends_ep21_script()

func play_script():
	pass

func stardustdescends_ep21_script():
	await novel_interface.show_text_only("................")
	await novel_interface.show_text_only("...")
	await novel_interface.show_text_only("Dos semanas después del incidente, en las afueras de la Quinta Ciudad Academia.")
	novel_interface.change_music("res://assets/audio/music/Shop.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_VillaHall.png")
	await novel_interface.show_text_only("Con el auricular puesto, Nix bajó las escaleras con elegancia mientras hablaba por teléfono.")
	novel_interface.show_character("nyx_normal","normal1")
	await novel_interface.show_dialog("Ese incidente fue clasificado oficialmente como el atentado terrorista más grave y atroz desde la guerra.", "Nix")
	await novel_interface.show_dialog("El United Council ha abierto una investigación exhaustiva y asegura que no mostrará la menor indulgencia hacia ningún sospechoso.", "Nix")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Entonces--", "Nix")
	await novel_interface.show_dialog("¿Cuánto cree que vale la información de que \"Mushar compró ese satélite a través de su canal\"... señor Hong?", "Nix")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("Tal vez sea porque... Recientemente hice algunos amigos que son muy buenos rastreando moneda electrónica hacia atrás~", "Nix")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Una leve sonrisa se dibujó en las comisuras de la boca de Nix.")
	novel_interface.show_character("nyx_normal","smile")
	await novel_interface.show_dialog("Así que recuperaré esta propiedad en nombre de mi padre...", "Nix")
	await novel_interface.show_dialog("Por supuesto, el negocio que siempre ha dirigido puede continuar. Sólo quiero el diez por ciento de las ganancias como alquiler.", "Nix")
	await novel_interface.show_dialog("Después de todo, no me gustaría que terminaras como Hamon.", "Nix")
	await novel_interface.show_dialog("Simplemente necesito que te hagas cargo de mi seguridad personal...", "Nix")
	await novel_interface.show_dialog("Inspirado por Mushar, también me implantaron una especie de monitor de señales vitales.", "Nix")
	novel_interface.change_expression("sad")
	await novel_interface.show_dialog("Si mis signos vitales se detienen, esos secretos se publicarán automáticamente en línea...", "Nix")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("Por cierto, mantendré confidencial la relación del Arzobispo Miller con Lebona ~", "Nix")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("Ya que fuiste lo suficientemente generoso como para entregarme también los datos robados de la NASA.", "Nix")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Nix tomó la tableta del escritorio y abrió el archivo cifrado.")
	novel_interface.show_character("nyx_normal","normal1")
	await novel_interface.show_dialog("...¿El satélite del Proyecto 0812 se llama \"STARDUST\"?", "Nix")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Cómo... absolutamente nada sorprendente~", "Nix")
	await novel_interface.hide_character()
	await novel_interface.hide_background_with_fade()
	await novel_interface.show_text_only("...")
	await novel_interface.show_text_only("Al día siguiente, SID Sala de Mando.")
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.show_character("liliu_research","shock")
	await novel_interface.show_dialog("Entonces... ¿realmente no recuerdas nada?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("En absoluto...", "Lian")
	novel_interface.change_expression("wry_smile")
	await novel_interface.show_dialog("Creo que la onda expansiva del impacto del satélite hizo que me golpeara la cabeza dentro del APC y me desmayara.", "Lian")
	await novel_interface.show_dialog("Luego, cuando desperté, me encontré acostado en una cama de hospital con una vía intravenosa...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("En las imágenes de las Fuerzas de Defensa, cuando saliste del APC estabas inexpresivo y completamente en silencio, rodeado por un extraño brillo azul cobalto.", "Mariru")
	await novel_interface.show_dialog("Era como si ya conocieras todo el plan. Bajo la mirada de todos, caminaste directamente hacia la azotea del centro de convenciones.", "Mariru")
	novel_interface.change_expression("angry")
	await novel_interface.show_dialog("Según el informe de Annie, casi al mismo tiempo, el inconsciente Stardust en la embajada también comenzó a emitir un brillo similar...", "Mariru")
	await novel_interface.show_dialog("Emily dijo que cuando tomaste su mano en la azotea, un poder indescriptiblemente enorme pareció surgir en su cuerpo.", "Mariru")
	await novel_interface.show_dialog("Cientos de veces más fuerte que cuando ustedes dos se encontraron con la Colmena antes, como si pudiera derretir su cuerpo en cualquier momento.", "Mariru")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("Pero después de que se desató ese ataque, el brillo a tu alrededor desapareció. Te quedaste inerte en sus brazos y trataste desesperadamente de enterrar tu rostro en su pecho.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("...¿Eh?\nD-¿Lo hice?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("¡Maldita sea, no recuerdo nada de eso en absoluto!")
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("Pero después de leer el informe del incidente, todavía hay algunas cosas que no entiendo...", "Lian")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Mushar compró la llave de control de ese satélite hace dos años, ¿verdad?", "Lian")
	await novel_interface.show_dialog("Masada ni siquiera había anunciado el sistema automático de represalias en aquel entonces. ¿Cómo pudo haber preparado una contramedida de antemano?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Incluso si simplemente hubiera estrellado ese satélite contra la tierra, el daño habría sido enorme. Incluso podría haber cambiado el rumbo en el campo de batalla convencional.", "Mariru")
	await novel_interface.show_dialog("Un estratega experto nunca desperdicia ni una sola pieza. Quién sabe cuándo podría resultar útil...", "Mariru")
	await novel_interface.hide_character()
	
	
	await novel_interface.show_text_only("Mariru me dio una mirada significativa mientras fingía entender y asentía.")
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Nix encontró ayer un archivo robado de la NASA en el mercado negro.", "Mariru")
	await novel_interface.show_dialog("El satélite que se estrelló en el Mar Muerto estaba destinado a recibir y almacenar señales transmitidas hacia la Tierra desde una determinada región de las Pléyades, a cuatrocientos años luz de distancia.", "Mariru")
	novel_interface.change_expression("angry")
	await novel_interface.show_dialog("El volumen de datos de la señal era enorme, almacenaba terabytes por segundo y solo podía recibirse desde posiciones orbitales específicas.", "Mariru")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Por lo tanto, los datos tenían que almacenarse en discos duros dentro del satélite hasta que un día, después de que estuviera lleno, el satélite pudiera regresar a la Tierra para su recuperación física.", "Mariru")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("Se podría llamar centro de datos espacial.", "Mariru")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Aya sospecha que los datos pueden estar relacionados con los recuerdos perdidos de Stardust.", "Mariru")
	await novel_interface.show_dialog("Pero ese satélite ahora ha sido destrozado y esparcido por el fondo del Mar Muerto, a más de cuatrocientos metros de profundidad...", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("¿Entonces los recuerdos de Stardust no se pueden recuperar?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Quién sabe... En cualquier caso, la señal del espacio profundo ha desaparecido.", "Mariru")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("¿Quizás, en algún sentido, ya logró su propósito?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","gratified")
	await novel_interface.show_dialog("Entonces, ¿cómo está Stardust ahora...?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Cuando regresó, estaba durmiendo como tú. Aya la llevó a Harima Brain Research...", "Mariru")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Pero ustedes dos parecen tener algún tipo de vínculo psíquico. Ambos se despertaron ayer casi a la misma hora.", "Mariru")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("Aún así, ella tampoco sabe nada. Aya estaba muy decepcionada y dijo que la cabeza de ese niño está tan vacía como la tuya.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("¿¡A quién llamas cabeza hueca!?")
	novel_interface.show_character("liliu_research","angry")
	await novel_interface.show_dialog("¡Ah, claro! Aya también realizó una prueba de parentesco en Stardust...", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","perspire1",0.25)
	await novel_interface.show_dialog("?", "Lian")
	novel_interface.character_light(0.35,"happy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("No se preocupen, ustedes dos realmente no están relacionados por sangre ~", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"wail")
	await novel_interface.show_dialog("¡¡No se suponía que hubiera ninguna posibilidad de eso en primer lugar!!", "Lian")
	novel_interface.character_light(0.35,"speak")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("La pequeña siguió insistiendo en verte después de que se despertó, por lo que Annie la traerá de regreso al cuartel general.", "Mariru")
	await novel_interface.show_dialog("Jejeje... los niños realmente son animados, ¿no?~", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Why do you sound like somebody's grandma...?",)
	novel_interface.show_character("liliu_research","happy")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("ren_battle","wail",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Dado que ese niño insiste en aferrarse a ti, pensé que también podría ser una buena oportunidad para corregir ese hábito tuyo de tratar siempre de eludir la responsabilidad.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("¿Q-Qué quieres decir...?\n(¡¡Eso no puede significar lo que creo que significa!!)", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru tomó su termo y tomó un pequeño sorbo del té de hierbas impregnado de plantas extrañas, con una sonrisa amable en su rostro.")
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("Por cierto, um... ¿Están bien Emily y Vera?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("¿No lo sabías? Lo están haciendo muy bien ahora mismo ~", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("¿Eh?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Un periodista cercano captó imágenes de la azotea del centro de convenciones desde el último piso de un edificio residencial.", "Mariru")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("Entonces el mundo entero vio a Emily descender como una diosa y dividir la tormenta de arena en dos...", "Mariru")
	await novel_interface.show_dialog("Más tarde, las Fuerzas de Defensa lo explicaron como una especie de arma desechable de materia heterogénea que sólo puede dispararse una vez.", "Mariru")
	await novel_interface.show_dialog("Pero en todas las religiones abrahámicas, sólo una figura elegida como Moisés podría \"partir el mar y salvar al pueblo\".", "Mariru")
	await novel_interface.show_dialog("Con los rangos más bajos de los fieles reaccionando tan fuertemente, y con ella siendo mestiza y sin religión ella misma...", "Mariru")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("El Gran Rabino de Masada y sus imanes llegaron a un consenso sin precedentes y ambos se apresuraron a llamarla mensajera de Dios.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","stare")
	await novel_interface.show_dialog("Qué... país tan complicado.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("El Primer Ministro Schneiderman siguió la corriente y la nombró Asesora Principal del Ministerio de Religión y Educación.", "Mariru")
	await novel_interface.show_dialog("Es sólo un puesto honorario, pero Emily aun así contrató a Vera como su asistente.", "Mariru")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("Hace unos días, el parlamento de Masada decidió continuar implementando partes del acuerdo de alto el fuego original, con Emily coordinando los asuntos étnicos.", "Mariru")
	await novel_interface.show_dialog("De esa manera, no importa cómo resulte la lucha por el poder dentro de las Fuerzas de Defensa o las futuras elecciones, ninguno de los dos debería meterse en problemas.", "Mariru")
	await novel_interface.hide_character()
	
	novel_interface.show_character("ren_battle","happy")
	await novel_interface.show_dialog("Mientras estén a salvo...", "Lian")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Luego sobre \"Phantom Force\"...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Antes de que pudiera terminar, Mariru me interrumpió.")
	novel_interface.show_character("liliu_research","angry")
	await novel_interface.show_dialog("Este asunto debe permanecer estrictamente confidencial. Ni siquiera se lo podemos decir a Annie.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("¿Eh?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru me miró con la misma sonrisa que se le da a un animalito que hace una estupidez.")
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("En realidad, no crees que Hamon perdonó a Emily porque adivinaste el secreto de Phantom Force, ¿verdad?", "Mariru")
	await novel_interface.show_dialog("Desde el momento en que presionaste el botón de transmisión, las Fuerzas de Defensa y Monola rastrearon tu ubicación. Ese APC ya había sido rodeado.", "Mariru")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("Si no hubiera intervenido en la conversación a tiempo y no me hubiera identificado, ni tú ni Emily habrían sobrevivido.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","wail")
	await novel_interface.show_dialog("¡¿Eh?!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("¿Lo olvidaste? Como núcleo del sistema de represalias, Phantom Force fue sellado hace mucho tiempo.", "Mariru")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("Incluso si cada deducción que hizo fuera correcta, todavía no tenía evidencia alguna.", "Mariru")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Hace más de veinte años, un profesor de historia de Masadan llamado Shlomo Sander propuso la misma teoría.", "Mariru")
	await novel_interface.show_dialog("Él tampoco tenía pruebas sólidas y fue denunciado como traidor, revisionista del genocidio y cómplice de los nazis.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","stare")
	await novel_interface.show_dialog("Entonces ¿no eras tú también...?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Mi intervención transmitió dos mensajes:", "Mariru")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("Primero, que SID se toma muy en serio tu seguridad si su director se presenta en persona.", "Mariru")
	await novel_interface.show_dialog("Segundo, que si algo te sucediera, SID no dudaría en tomar represalias contra Masada usando esa inteligencia.", "Mariru")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Monola sabe que SID posee mucha inteligencia que puede utilizar para presionar a los verdaderos controladores de los principales medios de comunicación internacionales.", "Mariru")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("Como le gusta decir al mundo de los medios: si tu voz es lo suficientemente fuerte, no necesitas ninguna maldita evidencia.", "Mariru")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Si esa historia se difundiera por todas partes y despertara suficiente sentimiento nacionalista, Asia occidental estaría enfrentando al menos otros treinta años de guerras antiterroristas.", "Mariru")
	await novel_interface.show_dialog("Emily también escuchó todo esto en ese momento, pero no se lo dirá a Vera. Y tú tampoco...", "Mariru")
	await novel_interface.show_dialog("Una vez que un secreto se hace público, pierde su valor.", "Mariru")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("Hazlo. Tú. ¿Entender?", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru me sonrió mientras hacía crujir sus nudillos.")
	novel_interface.show_character("ren_battle","wail")
	await novel_interface.show_dialog("¡¡Lo entiendo!\n¡¡No se lo diré a nadie aunque me mate!!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("Morir no será tan fácil.", "Mariru")
	await novel_interface.show_dialog("He oído que un orfanato en el barrio marginal de Masada recibió una enorme donación no hace mucho...", "Mariru")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("No pensaste que había olvidado esa ficha de oro de Lebona, ¿verdad?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("¿Eh?\nE-E-E-Eso...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("¡Me había olvidado por completo!")
	await novel_interface.show_text_only("En aquel entonces quería bajar a buscar a Emily y los demás, pero tenía miedo de que algo pudiera pasar...")
	await novel_interface.show_text_only("Entonces, mientras tía Haifa apagaba las luces, guardé ese chip en una nota y la dejé frente al marco de fotos de su escritorio.")
	await novel_interface.show_text_only("En la nota decía que si no había regresado en una semana, ella debería tratarlo como una donación para los niños.")
	await novel_interface.show_text_only("En ese momento pensé que me veía increíblemente genial. Nunca imaginé que pasaría dos semanas enteras durmiendo en la cama...")
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Ya conozco la historia completa detrás de eso, así que de aquí en adelante...", "Mariru")
	await novel_interface.hide_character()
	
	
	await novel_interface.show_text_only("Por alguna razón Mariru parecía un poco emocionada.")
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("Lo único de lo que debes preocuparte ahora es de ganar dinero para pagar tu deuda~", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("Incluso si me vendieras una docena de veces, todavía no sería suficiente...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("No seas tan duro contigo mismo~\nYa he conseguido varias ofertas publicitarias para ti.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","wail")
	await novel_interface.show_dialog("¡¿Qué?!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("El vídeo que publicó el periodista también te capturó, pero la mayoría de la gente asume que eres sólo un médico al que Emily salvó.", "Mariru")
	await novel_interface.show_dialog("Dado que tu cara ya está ahí fuera, en lugar de dejar que otras agencias de inteligencia especulen salvajemente, pensé que podríamos aprovecharlo...", "Mariru")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("Ya he negociado un respaldo para las nuevas baterías de alta energía que Masada acaba de lanzar...", "Mariru")
	await novel_interface.show_dialog("Y el fabricante también piensa que reemplazar el conejo de juguete de los anuncios tradicionales de baterías por \"la niña rescatada\" es una idea absolutamente brillante~", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("¡¡No hay nada bueno en que te comparen con un conejo!!")
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("... Así de divertido es ser gerente~", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Una vez que Mariru se cansó de verme enrojecer y humear por la vergüenza, felizmente me envió a saludar a Annie y a los demás.")
	await novel_interface.show_text_only("...")
	novel_interface.change_music("res://assets/audio/music/unkown/UI_Main_Funk.mp3")
	novel_interface.change_background("res://assets/images/bg/other/BG_City_street3.png")
	await novel_interface.show_text_only("Cuando salí del ascensor, Annie y Stardust ya llevaban bastante tiempo esperando afuera.")
	novel_interface.show_character("stardust_small","tear")
