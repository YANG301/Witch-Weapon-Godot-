# stardustdescends_ep11.gd - 星尘降临篇第11话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	stardustdescends_ep11_script()

func play_script():
	pass

func stardustdescends_ep11_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_MasadMuseum.png")
	novel_interface.show_character("ren_medical","normal1")
	await novel_interface.show_dialog("Museo Nacional de Masada... ¿este es el lugar?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sosteniendo mi teléfono, me aseguré de haber llegado al lugar correcto.")
	await novel_interface.show_text_only("Lo que me sorprendió fue que la mayoría de las salas de exposición de este museo nacional estaban ubicadas en espacios semisubterráneos.")
	await novel_interface.show_text_only("Se decía que el muro de piedra negra que se alzaba en la entrada principal contenía piedra extraída de las ruinas de la antigua muralla de la ciudad en el lado oeste del Monte del Templo en la antigua capital.")
	await novel_interface.show_text_only("El material negro de protección contra la radiación envuelto firmemente alrededor del exterior del muro parecía hablar en silencio de las heridas y el sufrimiento dejados por esa catástrofe.")
	await novel_interface.show_text_only("Todo el muro era como una lápida gigante. Debajo de ella había algunas personas mayores, inclinando la cabeza y acariciando suavemente la piedra, y no podía decir si estaban de luto u orando...")
	novel_interface.show_character("ren_medical","uneasy")
	await novel_interface.show_dialog("Me registro aquí... ¿verdad?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Utilicé mi placa en el mostrador no tripulado de la entrada y completé un escaneo biométrico facial.")
	await novel_interface.show_text_only("Esta insignia era una credencial encriptada de la Organización Internacional de Ayuda Médica, diseñada específicamente para el personal médico que entra y sale con frecuencia de zonas de guerra.")
	await novel_interface.show_text_only("Además de almacenar información personal y registros médicos, también le permite solicitar equipos de comunicación y suministros de ayuda de la organización en cualquier parte del mundo.")
	await novel_interface.show_text_only("Incluso venía precargado con una suma de moneda electrónica fuera de línea, supuestamente para pagar el rescate si te secuestran...")
	novel_interface.show_character("ren_medical","wry_smile")
	await novel_interface.show_dialog("(Una enfermera interna no necesita un acceso como este en absoluto, ¿verdad?)\n(Mariru, sinceramente...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("En fin, mientras no me obliguen a hacer nada peligroso...")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("...")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_FirstExhibition.png")
	await novel_interface.show_text_only("Bajé por las escaleras mecánicas hasta la primera sala de exposiciones, donde se exhibían muchos relieves de piedra en una sala no muy espaciosa.")
	await novel_interface.show_text_only("Las huellas visibles de la erosión eólica parecían contar una historia lejana y erosionada.")
	await novel_interface.show_text_only("Pero no estaba interesado en la historia. Simplemente hojeé mi teléfono y traté de descubrir cómo iba a sobrevivir estas miserables tres horas.")
	novel_interface.show_character("ren_medical","panic")
	await novel_interface.show_dialog("¿Es eso... una guía?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Hoy en día, cuando las guías de voz de IA están en todas partes, no había visto una guía humana real en mucho tiempo.")
	novel_interface.show_character("ren_medical","stare")
	await novel_interface.show_dialog("(¿No está Masada desesperadamente escasa de población...?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Era un hombre mayor con barba blanca, probablemente de unos sesenta años, que llevaba un pequeño casquete negro con una placa de identificación prendida en el cuello de su traje.")
	await novel_interface.show_text_only("Pacientemente guió a todos mientras recogían folletos, sonriendo amablemente mientras respondía a cada persona que le preguntaba algo.")
	await novel_interface.show_text_only("Curioso, me acerqué. Estaba presentando la historia del museo a algunos visitantes.")
	await novel_interface.show_dialog("Aunque muchas reliquias preciosas fueron destruidas durante la guerra, junto con el museo nacional original.", "Guía")
	await novel_interface.show_dialog("Sin embargo, en los últimos años, este nuevo museo ha recopilado muchos artefactos preciosos de Asia occidental y África, lo que les permitió escapar de los estragos de la guerra...", "Guía")
	await novel_interface.show_text_only("Miré la momia egipcia y la máscara de bronce impresas en la parte posterior del folleto.")
	novel_interface.show_character("ren_medical","wail")
	await novel_interface.show_dialog("(Así que los robaste de esos lugares, ¡eh!)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Pero hoy en día, los artefactos históricos más preciados del mundo se guardan en las Seis Ciudades Academia de todos modos, por lo que este tipo de cosas no es inusual.")
	await novel_interface.show_text_only("Noté que mientras hablaba con gran emoción, su mano izquierda permaneció metida en el bolsillo de su traje todo el tiempo.")
	novel_interface.show_character("ren_medical","bored")
	await novel_interface.show_dialog("(Tal vez sea alguna costumbre religiosa especial...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Miré a mi alrededor. Afortunadamente, hoy no era sábado, por lo que no había muchos visitantes y tampoco había otros miembros de la organización médica en el museo.")
	await novel_interface.show_text_only("Para los miembros de las ONG, el procedimiento requerido de \"visita de estudio\" comienza con pasar al menos treinta minutos en las salas de historia y documentos.")
	await novel_interface.show_text_only("Deambulé aburrido y pronto mis ojos se vieron atraídos por algunos lugareños y más de una docena de niños que recorrían el lugar al mismo tiempo.")
	await novel_interface.show_text_only("Entre ellos, los más llamativos eran dos hombres de unos cuarenta años; ambos tenían grandes barbas y extrañas trenzas pequeñas colgando del cabello en las sienes.")
	await novel_interface.show_text_only("Iban vestidos igual: camisas blancas, abrigos negros hasta las rodillas y sombreros negros de copa plana y ala rizada, como personas de alguna extraña organización.")
	await novel_interface.show_text_only("Una docena de niños seguían a esos hombres, y tanto los niños como las niñas vestían los mismos trajes en blanco y negro.")
	novel_interface.show_character("ren_medical","bored")
	await novel_interface.show_dialog("(¿Es esta una excursión escolar cercana?)\n(Pero el rango de edad en esta escuela es un poco salvaje...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Los niños tenían edades comprendidas uniformemente entre tres o cuatro años y unos diez años; los más pequeños apenas podían caminar con paso firme, mientras que algunos de los niños mayores gritaban y se peleaban.")
	await novel_interface.show_text_only("Detrás del grupo caminaban con dificultad dos mujeres de mediana edad, de aspecto cansado y figuras caídas.")
	novel_interface.show_character("ren_medical","stare")
	await novel_interface.show_dialog("(Esos dos no son los profesores... ¿verdad?)", "Lian")
	await novel_interface.show_dialog("(¿Por qué uno de ellos incluso empuja un cochecito?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Que combinación más rara...")
	await novel_interface.show_text_only("El recorrido por la sala de historia terminó rápidamente y el guía comenzó a llevar a todos a la sala de documentos.")
	await novel_interface.show_text_only("Ajustó el micrófono que colgaba de su cuello y se aclaró la garganta.")
	await novel_interface.show_dialog("A continuación, les mostraré la exposición más importante de este museo.", "Guía")
	await novel_interface.show_dialog("Está prohibida la fotografía en la sala de al lado. Por favor guarden sus teléfonos y síganme al Santuario del Libro.", "Guía")
	await novel_interface.show_text_only("En el momento en que escucharon eso, los niños alborotadores guardaron silencio y los dos hombres de negro también se pusieron solemnes.")
	await novel_interface.show_text_only("Guardé mi teléfono y lo seguí con la curiosidad ardiendo en mi pecho.")
	await novel_interface.hide_background()
	await novel_interface.stop_music()
	await novel_interface.show_text_only("Después de que el guía escaneó la huella de su palma, una puerta de basalto en la sala de historia se abrió lentamente, revelando un largo corredor de piedra más allá.")
	await novel_interface.show_text_only("Más de veinte de nosotros nos presentamos uno tras otro. Parecía como si una atmósfera solemne nos hubiera infectado; Todos se movieron con cuidado y no dijeron nada.")
	await novel_interface.show_text_only("...")
	novel_interface.change_music("res://assets/audio/music/Normal Stage.mp3")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_SOTB.png")
	novel_interface.show_character("ren_medical","panic")
	await novel_interface.show_dialog("Esto es...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Al final del pasillo había una cámara de forma extraña.")
	await novel_interface.show_text_only("La sala de exposiciones del Santuario del Libro era perfectamente circular, con franjas anilladas espaciadas uniformemente desde las paredes hasta el tragaluz.")
	await novel_interface.show_text_only("La luz que entraba por el tragaluz caía sobre el soporte de exhibición en el centro, haciendo que todo el lugar pareciera tranquilo y sagrado.")
	await novel_interface.show_text_only("Todo el espacio había sido diseñado como una vasija de barro, y las paredes circundantes utilizaban un material de tierra similar.")
	await novel_interface.show_text_only("En el expositor circular con forma de tambor de escrituras, encima de los escalones de piedra, había un antiguo pergamino moteado y amarillento.")
	await novel_interface.show_text_only("Subí los escalones y me incliné para verlo más de cerca. El cristal protector parecía tener al menos cinco centímetros de grosor y la mayoría de los caracteres hebreos del pergamino eran claramente visibles.")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_DSS.png")
	await novel_interface.show_dialog("¿Podría ser esto...?", "Lian")
	await novel_interface.show_text_only("Ya sabes, esa cosa de ese anime...")
	await novel_interface.show_dialog("Se trata de un antiguo documento descubierto en cuevas al noroeste del Mar Muerto, conocido como los \"Rollos del Mar Muerto\", el mayor descubrimiento arqueológico del último siglo.", "Guía")
	await novel_interface.show_dialog("Los Rollos del Mar Muerto son de gran escala y abarcan más de quinientos manuscritos desenterrados en doce cuevas.", "Guía")
	await novel_interface.show_dialog("Y el que está en esta vitrina es una página manuscrita parcial del Génesis de la \"Torá\", uno de los Rollos del Mar Muerto.", "Guía")
	await novel_interface.show_dialog("Registra el proceso por el cual Dios creó el mundo y cómo eligió a los habitantes de Masad como su pueblo elegido. Es la reliquia histórica más importante de este país.", "Guía")
	await novel_interface.show_text_only("Ahora que lo pienso, los habitantes de Masada siempre parecen enorgullecerse de ser el pueblo elegido de Dios...")
	await novel_interface.show_text_only("Pero nunca me han interesado historias religiosas como esta...")
	await novel_interface.show_text_only("Cada pueblo en la tierra tiene algunos antepasados que se convirtieron en dioses en sus leyendas, ¿no es así?")
	await novel_interface.show_text_only("Los visitantes locales claramente no pensaban así. Los dos tíos con sombreros extraños se volvieron inmediatamente hacia la vitrina y comenzaron a orar.")
	await novel_interface.show_text_only("Con su voz profunda y amable, el guía continuó.")
	await novel_interface.show_dialog("Este manuscrito registra las historias de los antepasados Abraham, Isaac, Jacob y los doce hijos de Jacob.", "Guía")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_TheThree.png")
	await novel_interface.show_dialog("Abraham es un profeta en muchas religiones y el ancestro común de los hebreos y los árabes.", "Guía")
	await novel_interface.show_dialog("Abraham fue el que el Señor eligió entre todos los seres y lo bendijo.", "Guía")
	await novel_interface.show_dialog("Dios hizo un pacto con Abraham, prometiendo conceder una tierra fértil a su hijo legítimo, a su nieto y a todos los descendientes que produciría la línea de su nieto.", "Guía")
	await novel_interface.show_dialog("Esta tierra se extiende desde el Nilo hasta el Éufrates. Es lo que ahora llamamos la \"Tierra Prometida\".", "Guía")
	await novel_interface.show_dialog("Posteriormente, Abraham engendró a su hijo legítimo Isaac; Isaac engendró a Esaú, y su segundo hijo se llamó Jacob...", "Guía")
	await novel_interface.show_dialog("(Espera... ¿Jacob?)", "Lian")
	await novel_interface.show_text_only("¿No es ese el nombre de ese administrador de Elluka?")
	await novel_interface.show_text_only("Por otra parte, a los occidentales les gusta mucho poner a sus hijos nombres de figuras de los clásicos religiosos...")
	await novel_interface.show_text_only("El guía hizo una pausa, se ajustó las gafas de lectura y continuó explicando el contenido del pergamino.")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_MessOfPottage.png")
	await novel_interface.show_dialog("Según las Escrituras, Jacob, el segundo hijo de Isaac, una vez compró la primogenitura de su hermano mayor Esaú con un plato de guiso de frijoles rojos.", "Guía")
	await novel_interface.show_dialog("Según el pacto de Abraham con Dios, una vez que Jacob obtuvo la primogenitura, adquirió el derecho legítimo de heredar la \"Tierra Prometida\".", "Guía")
	await novel_interface.show_dialog("Más tarde, Jacob se convirtió en el santo patriarca de Masada, y sus doce hijos se convirtieron en los doce antepasados de las tribus de Masada...", "Guía")
	await novel_interface.show_text_only("En ese momento mi cabeza empezaba a palpitar.")
	await novel_interface.show_text_only("Espera... ¿guiso de frijoles rojos? ¿¡Qué diablos!?\n¿Eran los antiguos realmente tan casuales?")
	await novel_interface.show_text_only("Y si eso es cierto, entonces todos los masadaneses son descendientes de ese Jacob...")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_DSS.png")
	await novel_interface.show_text_only("El guía dio dos pasos a lo largo de la plataforma circular, examinó las palabras cerca del final del pergamino y continuó.")
	await novel_interface.show_dialog("Esta es la porción final del Génesis:", "Guía")
	await novel_interface.show_dialog("La vida del santo patriarca Jacob estuvo llena de leyendas. Soñó con la puerta del cielo y escuchó a Dios reafirmar el juramento hecho a su abuelo.", "Guía")
	await novel_interface.show_dialog("Luchó con Dios y quedó cojo, y se le concedió un nombre santo.", "Guía")
	await novel_interface.show_dialog("Jacob pasó los últimos diecisiete años de su vida en Egipto, y antes de morir llamó a su hijo José...", "Guía")
	await novel_interface.show_dialog("Jacob hizo jurar a su hijo que lo sacaría de Egipto y lo sepultaría en la cueva de Macpela en Hebrón, en la tierra de Canaán.", "Guía")
	await novel_interface.show_dialog("Esa era la tumba familiar que Abraham había comprado hacía mucho tiempo, donde fueron enterrados los padres y abuelos de Jacob.", "Guía")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("El manuscrito termina ahí.")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_SOTB.png")
	novel_interface.show_character("ren_medical","worry")
	await novel_interface.show_dialog("(Cueva de Machpela... ¿por qué me suena ese nombre?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Siento que Aya lo mencionó en la sesión informativa de anoche... ¿No hubo una explosión hace un par de días?")
	await novel_interface.show_text_only("Uf, no lo recuerdo. Todas estas personas extranjeras y nombres de lugares me suenan igual de todos modos...")
	await novel_interface.show_text_only("El guía acarició suavemente el cristal de la vitrina y suspiró en voz baja.")
	await novel_interface.show_dialog("Masada es un pueblo antiguo y damos gran importancia a las excavaciones arqueológicas.", "Guía")
	await novel_interface.show_dialog("Desde el día en que se descubrió el primer rollo, la excavación y restauración de los Rollos del Mar Muerto ha continuado durante más de ochenta años.", "Guía")
	await novel_interface.show_dialog("Son la preciosa herencia de nuestros antepasados y también de nuestras raíces.", "Guía")
	await novel_interface.show_dialog("Sin embargo...", "Guía")
	await novel_interface.show_text_only("El guía bajó las escaleras y se acercó al enorme cuadro al óleo a un lado del pasillo.")
	novel_interface.change_music("res://assets/audio/music/Hero.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_TheJewishWar.png")
	await novel_interface.show_text_only("Permaneció ante él durante un largo rato, mirándolo en un silencio significativo.")
	await novel_interface.show_text_only("La pintura era de gran escala y cubría casi toda una pared.")
	await novel_interface.show_dialog("Sin embargo, nuestra historia también está llena de sufrimiento.", "Guía")
	await novel_interface.show_text_only("Se dio la vuelta, las comisuras de su boca se movieron levemente como si estuviera reprimiendo desesperadamente algún recuerdo doloroso.")
	await novel_interface.show_dialog("Esta pintura fue creada basándose en los escritos del historiador del siglo I Flavio Josefo.", "Guía")
	await novel_interface.show_dialog("En aquellos días, el poderoso Imperio Romano conquistó la ciudad santa y más de un millón de antepasados de Masad fueron masacrados por soldados legionarios.", "Guía")
	await novel_interface.show_dialog("Y esta pintura representa el día en que se incendió el Segundo Templo.", "Guía")
	await novel_interface.show_dialog("Fue el día más triste en la historia de Masadan... y, sin embargo, fue sólo el comienzo de mil años de sufrimiento.", "Guía")
	await novel_interface.show_dialog("En el año 70, nuestros antepasados fueron expulsados en gran número de Judea por los romanos.", "Guía")
	await novel_interface.show_dialog("Aquellos que se negaron a aceptar el exilio de su tierra natal se levantaron en resistencia, y más de mil rebeldes hicieron de Masada de esa época su última fortaleza.", "Guía")
	await novel_interface.show_dialog("Mantuvieron esa ciudad durante dos años completos bajo el asedio romano, hasta que se les cortó el suministro de agua y no les quedaron fuerzas.", "Guía")
	await novel_interface.show_dialog("Cuando la Décima Legión finalmente irrumpió en la ciudad, el gobernador que entró encontró sólo más de novecientos cadáveres y edificios quemados hasta los cimientos.", "Guía")
	await novel_interface.show_dialog("Los defensores prefirieron suicidarse antes que someterse y convertirse en esclavos de Roma. Al final, sólo sobrevivieron dos adultos y cinco niños...", "Guía")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Imaginar esa escena hizo que me doliera el pecho.")
	await novel_interface.show_text_only("El guía guardó silencio durante un largo rato, luego se volvió hacia nosotros y continuó.")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_SOTB.png")
	await novel_interface.show_dialog("Fuimos expulsados de nuestra patria una y otra vez, obligados a abandonar nuestros propios hogares.", "Guía")
	await novel_interface.show_dialog("Fuimos conquistados, gobernados, marginados, masacrados, tratados como esclavos, prisioneros, incluso ganado...", "Guía")
	await novel_interface.show_dialog("Hace un siglo, en una de las purgas étnicas más atroces de la historia de la humanidad, seis millones de nuestros compatriotas fueron masacrados.", "Guía")
	await novel_interface.show_dialog("Y hace diez años, nuestra capital volvió a quedar reducida a tierra arrasada. El Monte del Templo ardió en llamas púrpuras durante siete días y siete noches...", "Guía")
	await novel_interface.show_dialog("Mucha gente, mi familia y mis amigos, perdieron la vida en esa catástrofe.", "Guía")
	await novel_interface.show_dialog("Y aquellos que sobrevivieron por pura suerte pueden haber perdido aún más...", "Guía")
	await novel_interface.show_text_only("Su voz tembló cuando levantó la mano izquierda que tenía metida en el bolsillo.")
	await novel_interface.show_text_only("Sólo entonces vimos que la mano había sido sustituida por una prótesis metálica, y las quemaduras cubrían la muñeca y el antebrazo expuesto más allá de la manga...")
	await novel_interface.show_text_only("Toda la sala quedó en silencio. Yo también me encontré conteniendo la respiración.")
	await novel_interface.show_text_only("Una joven turista entre la multitud se tapó la boca con ambas manos, con lágrimas en los ojos.")
	await novel_interface.show_text_only("Pero el guía apretó esa mano en un puño y la levantó en alto, mirándonos mientras hablaba con voz resuelta:")
	await novel_interface.show_dialog("Y, sin embargo, al igual que aquellos mil guerreros que defendieron esta fortaleza hasta el final, el sufrimiento nunca nos hará doblegar.", "Guía")
	await novel_interface.show_text_only("Su voz no era fuerte, pero estaba llena de espíritu heroico, e hizo que una extraña fuerza brotara de mi pecho.")
	await novel_interface.show_text_only("Sus ojos brillaron como si pudiera ver a un dios señalando el camino.")
	await novel_interface.show_dialog("Hemos soportado dos grandes diásporas, pero al final siempre regresaremos a esta tierra, porque el sufrimiento nunca nos hará someternos.", "Guía")
	await novel_interface.show_dialog("Hace noventa años, nuestros antepasados desafiaron los disparos y los proyectiles sólo para regresar aquí una vez más y establecer una nación propia.", "Guía")
	await novel_interface.show_dialog("Aunque esto no fuera más que un desierto árido, aunque entonces apenas hubiera agua dulce disponible, ¡este es nuestro hogar!", "Guía")
	await novel_interface.show_dialog("Lo que fluye por esta tierra no es leche y miel, sino nuestra sangre, lágrimas y sudor.", "Guía")
	await novel_interface.show_dialog("Esta es nuestra única patria en el mundo y el hogar espiritual que el pueblo de Masadan ha apreciado durante miles de años.", "Guía")
	await novel_interface.show_dialog("La \"Tierra Prometida\" es el pacto entre nuestros antepasados y Dios, y también nuestra promesa a las generaciones futuras.", "Guía")
	await novel_interface.show_dialog("¡El Templo podrá ser quemado, pero la fortaleza del espíritu nunca caerá!", "Guía")
	await novel_interface.show_dialog("Finalmente, gracias a todos nuevamente por visitar el Museo Nacional de Masada. ¡Gracias a todos!", "Guía")
	await novel_interface.show_text_only("Dicho esto, el guía hizo una reverencia a la multitud.")
	await novel_interface.show_text_only("A nuestro alrededor estallaron largos e interminables aplausos. No pude evitar sentir admiración por este pueblo resistente y me encontré aplaudiendo también.")
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_IndiaEH.png")
	await novel_interface.show_text_only("Después de abandonar el área de exposición de documentos, comencé a deambular sin rumbo por el museo.")
	await novel_interface.show_text_only("Aunque había sido una experiencia muy completa, el requisito de tiempo mínimo significaba que todavía tenía que permanecer aquí otras dos horas y media.")
	await novel_interface.show_text_only("El discurso del guía de antes fue como una corriente oscura que se agita en el fondo del mar, persistiendo en mi mente.")
