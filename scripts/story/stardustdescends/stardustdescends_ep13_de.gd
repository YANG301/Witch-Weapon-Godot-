# stardustdescends_ep13.gd - 星尘降临篇第13话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	stardustdescends_ep13_script()

func play_script():
	pass

func stardustdescends_ep13_script():
	novel_interface.change_music("res://assets/audio/music/Story_01.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_MasadSentry.png")
	await novel_interface.show_text_only("Den Aufnahmen des Fahrzeugmonitors nach zu urteilen, befand sich geradeaus ein Abschnitt der Isoliermauer, der sich noch im Bau befand.")
	await novel_interface.show_text_only("Da es am Rande der Innenstadt lag, hatte es nichts von der wohlhabenden, friedlichen Atmosphäre des zentralen Bezirks –")
	await novel_interface.show_text_only("Stahl, Beton und Staub stellten die rohe, raue Textur eines Wüstenkriegsgebietes wieder her.")
	await novel_interface.show_text_only("Der vor uns liegende Kontrollpunkt war wie eine Festung gebaut und mehrere APCs des gleichen Modells waren um ihn herum geparkt.")
	await novel_interface.show_text_only("In der Ferne waren viele Turmdrehkrane und schwere Maschinen im Einsatz, und jenseits der Mauer konnte man undeutlich Schwärme von Drohnen am Himmel erkennen.")
	await novel_interface.show_text_only("Der Anordnung der Metallbarrikaden nach zu urteilen, schien der Ausgang vor uns eindeutig für den Verkehr gesperrt zu sein.")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_MasadAPCO2.png")
	novel_interface.show_character("ren_medical","wail")
	await novel_interface.show_dialog("Du willst... deinen Weg erzwingen?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Emily klopfte mit den Knöcheln gegen die Innenwand des APC.")
	novel_interface.show_character("emilio","speechless")
	await novel_interface.show_dialog("Damit?", "Emily")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("Die Panzerung ist robust, leitet aber die Wärme genauso wie gewöhnliches Metall. Wir würden wahrscheinlich etwa zwanzig Sekunden durchhalten, bevor wir bei lebendigem Leibe geröstet wären", "Emily")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Plötzlich blieb das Fahrzeug stehen. Eine vertraute Stimme kam aus der Fahrerkabine –")
	await novel_interface.show_dialog("Vera Valkyrie, Warrant Officer First Class des Caracal-Bataillons, holt Personal aus dem Lager zur Aufklärung außerhalb der Stadt ab.", "Vera")
	novel_interface.show_character("ren_medical","wry_smile")
	await novel_interface.show_dialog("(Das ist die superstarke Sicherheitsfrau vom Casinoschiff, nicht wahr?!)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ich erinnere mich noch lebhaft daran, wie sie den riesigen Oberbischof mit einer Hand hochgehoben hatte.")
	await novel_interface.show_dialog("Oh, es ist Vera. Derzeit findet am Yehuda-Markt eine Protestkundgebung statt. Wer sich nicht verzetteln will, sollte lieber eine andere Ausfahrt nehmen...", "Männerstimme")
	await novel_interface.show_dialog("Hören Sie auf zu reden und lassen Sie uns schon durch. Wir haben keine Zeit für einen Umweg!", "Vera")
	await novel_interface.show_dialog("Haha, gut, gut. Mach einfach keinen weiteren Ärger. Das letzte Mal, als Ihr alter Herr vom Hauptquartier des Generalstabs anrief, nur um die Leute zu verarschen ...", "Männerstimme")
	await novel_interface.show_dialog("Erwähne ihn noch einmal und ich überfahre dich.", "Vera")
	await novel_interface.show_dialog("Bewegen Sie die Straßensperre. Lass sie durch, lass sie durch!", "Männerstimme")
	await novel_interface.show_text_only("Emily beugte sich vor und flüsterte mir zu.")
	novel_interface.show_character("emilio","mock")
	await novel_interface.show_dialog("Gab es bei Ihnen diesen kurzen Moment, in dem Sie darüber nachgedacht haben, um Hilfe zu schreien … und dann die Nerven verloren haben?", "Emily")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","shy_left")
	await novel_interface.show_dialog("Natürlich nicht!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ich wandte hastig den Kopf ab. Ugh, sie ist so widerlich!")
	await novel_interface.show_text_only("Das Fahrzeug rollte langsam vorwärts und passierte bald die Isolationsmauer in die Außenstadt von Masada.")
	await novel_interface.show_text_only("Ich hatte angenommen, dass die Außenstadt noch trostloser sein würde, aber nachdem wir die Isolationsmauer überquert hatten, stieg die Zahl der Menschen auf der Straße plötzlich sprunghaft an –")
	await novel_interface.show_text_only("Die Straßen waren hier rauer und es gab weniger Hochhäuser und Grüngürtel, aber die Straßen waren unerwartet belebt.")
	await novel_interface.show_text_only("Die Menschenmassen, die hin und her schlängelnden Busse und die Straßenverkäufer, die Waren feilboten, gaben mir das Gefühl, als wäre ich durch die Zeit gereist.")
	novel_interface.show_character("ren_medical","gratified")
	await novel_interface.show_dialog("Es sind so viele Leute hier...", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("emilio","smile",0.25)
	await novel_interface.show_dialog("Natürlich. Neunzig Prozent der Bevölkerung dieser Stadt leben außerhalb der Isolationsmauer.", "Emily")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("So viele!?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Die Innenstadt ist insgesamt nur 32 Quadratkilometer groß, weniger als ein Viertel der Gesamtfläche Masadas, und die Grundstückspreise sind unverschämt~", "Emily")
	await novel_interface.show_dialog("Vor allem im zentralen Bezirk. Die Grundfläche einer einzigen Toilette dort würde ausreichen, um ein Studio-Apartment am Toten Meer zu kaufen.", "Emily")
	novel_interface.character_light(0.35,"wry_smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ich dachte, die Isolationsmauer wäre dafür da... wissen Sie...", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Rassentrennung?", "Emily")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Richtig, richtig. Gibt es nicht eine Regel, dass bestimmte für eine bestimmte Gruppe beleidigende Wörter nur von Personen aus dieser Gruppe selbst gesagt werden dürfen ...")
	novel_interface.show_character("emilio","mock")
	await novel_interface.show_dialog("Der Vereinigte Rat hat so etwas schon vor langer Zeit verboten~", "Emily")
	await novel_interface.show_dialog("Aber das Anti-Terror-Gesetz von Masada besagt, dass man, wenn man langfristig in der Innenstadt wohnen möchte, in der sich Regierung und Parlament befinden, eine Überprüfung durch das Sicherheitsbüro bestehen muss.", "Emily")
	await novel_interface.show_dialog("Und Bewerber, deren unmittelbare Familie bestimmten ethnischen Gruppen angehört, bestehen zufälligerweise nie … verstanden?", "Emily")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ich nickte, nur halb verstehend.")
	await novel_interface.show_text_only("Das ist also Rassentrennung!\nAuch wenn es sich anhört, als würden sie sich selbst ausgrenzen...")
	await novel_interface.show_text_only("Und wenn das wahr ist, dann müssen sogar die meisten ethnischen Masadaner in der Außenstadt leben, oder?")
	await novel_interface.show_text_only("Auf dem Bildschirm sah ich eine Soldatin mit einer M16 über der Schulter, die vor einem Straßenstand hockte, an dem Haarschmuck verkauft wurde, und mit einer Verkäuferin feilschte, deren Gesicht in ein Kopftuch gehüllt war.")
	novel_interface.show_character("ren_medical","wail")
	await novel_interface.show_dialog("(Es stellt sich heraus, dass sich niemand eine Wohnung leisten kann, egal woher er kommt ...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Plötzlich bremste das Fahrzeug stark ab. Mein Kopf wäre fast auf dem Bildschirm aufgeschlagen, und aus der Fahrerkabine ertönte Veras Fluchen.")
	await novel_interface.show_dialog("Verdammt!!", "Vera")
	novel_interface.show_character("emilio","shout")
	await novel_interface.show_dialog("Was ist passiert!?", "Emily")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Ich habe eine Scout-Drohne gestartet. Beobachten Sie einfach selbst den Bildschirm.", "Vera")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Emily und ich eilten zur Ausstellung und sahen eine Szene, die mir eine Gänsehaut bereitete …")
	#novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_AncientHumanEH.png") #原游戏有素材，但已丢失
	await novel_interface.show_text_only("Mehr als tausend Männer in schwarzen Mänteln und schwarzen Hüten versammelten sich an der Kreuzung vor ihnen, wie bei einer riesigen Beerdigung.")
	await novel_interface.show_text_only("Sie hielten selbstgemachte schwarz-weiße Protestschilder in der Hand, als wollten sie gegen die Existenz anderer Farben auf der Welt protestieren.")
	await novel_interface.show_text_only("Die meisten von ihnen hatten riesige Bärte und seltsame kleine Zöpfe an den Schläfen. Dieser Blick kam mir furchtbar bekannt vor ...")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_MasadAPCR1.png")
	await novel_interface.show_dialog("Diese nutzlosen Miststücke! Sie leben von staatlichen Subventionen und protestieren trotzdem jeden verdammten Tag!", "Vera")
	await novel_interface.show_text_only("Nehmen wir mal an, „bleep“ ist eine Art Dialekt... Ich konnte es sowieso nicht verstehen.")
	await novel_interface.show_dialog("Sie wollen, dass die Zahl der Grundschulen, die ihrer Doktrin entsprechen, verdoppelt wird?\nSind ihnen diese verdammten Locken ins Gehirn gewachsen!?", "Vera")
	await novel_interface.show_text_only("Ich hörte Tritte von der Kabinentür. Anscheinend war unser Fahrer aufgesprungen, um eine Schlägerei anzuzetteln.")
	novel_interface.show_character("ren_medical","wail")
	await novel_interface.show_dialog("Was macht sie?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("emilio","mock",0.25)
	await novel_interface.show_dialog("Werde die Teller abdecken~", "Emily")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Emily antwortete geistesabwesend, während sie die Streckenkarte auf ihrem robusten Militärtablett überprüfte.")
	novel_interface.show_character("ren_medical","wry_smile")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("emilio","mock",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("W-Was wird sie tun...? Diese Leute sind Masadaner, nicht wahr?\nIch glaube, ich habe gerade einige von ihnen im Museum gesehen ...", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"stare")
	await novel_interface.show_dialog("Sie sind Masadas „historisches Erbe“. Sie arbeiten nicht, zahlen keine Steuern, leisten keinen Militärdienst und die Regierung muss ihnen trotzdem monatliche Subventionen zahlen –", "Emily")
	await novel_interface.show_dialog("Auch wenn sie die öffentliche Ordnung stören und den Verkehr blockieren, können Polizei und Armee ihnen nichts anhaben, denn sie haben ihre eigenen Religionsgerichte.", "Emily")
	novel_interface.character_light(0.35,"stare")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("...Das ist so gut?", "Lian")
	novel_interface.change_expression("uneasy")
	await novel_interface.show_dialog("(Würde das nicht bedeuten, dass Sie einfach zu Hause bleiben und jeden Tag Spiele spielen könnten ...)", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"mock")
	await novel_interface.show_dialog("Aber ihre Doktrin besagt, dass es im Haus keine Fernseher oder Computer geben darf und der Internetzugang strengstens verboten ist –", "Emily")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Das ist Folter!!")
	novel_interface.show_character("ren_medical","uneasy")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("emilio","speechless",0.25)
	await novel_interface.show_dialog("Aber ihre Frauen sind anders. Sie dürfen elektronische Geräte benutzen, weil diese Männer auf Frauen angewiesen sind, um Geld zu verdienen und den Haushalt zu unterstützen.", "Emily")
	novel_interface.change_2nd_expression("stare")
	await novel_interface.show_dialog("Das liegt nicht daran, dass die Subventionen zu gering sind. Das liegt daran, dass die Frauen in diesen Familien durchschnittlich sechs oder sieben Kinder haben und manche sogar über ein Dutzend.", "Emily")
	novel_interface.change_2nd_expression("speechless")
	await novel_interface.show_dialog("So viele Kinder. Kein Wunder, dass religiöse Schulen nicht ausreichen ...", "Emily")
	novel_interface.character_light(0.35,"bored")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("(Könnten die etwa zehn Kinder, die ich im Museum um diese beiden bärtigen Männer in Schwarz scharen sah, …)", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Und die beiden hageren Frauen, die ihnen folgten ...")
	await novel_interface.show_text_only("Als ich an den Kinderwagen dachte, den einer von ihnen geschoben hatte, lief mir ein Schauer über den Rücken.")
	novel_interface.show_character("emilio","speechless")
	await novel_interface.show_dialog("Religiöse Fundamentalisten sind ein Krebsgeschwür, egal wohin man geht ...", "Emily")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Emily fummelte weiter mit gesenktem Kopf an ihrem Tablet herum, in ihrem Ton klang eine seltsame Traurigkeit und ein Anflug von Resignation.")
	await novel_interface.show_text_only("Bald darauf kam Vera wieder ins Fahrzeug und Emily klopfte zur Erinnerung auf die Metalltrennwand der Kabine.")
	novel_interface.show_character("emilio","smile")
	await novel_interface.show_dialog("Gehen Sie um die dritte Kreuzung auf der Ostseite herum. Dort gibt es eine neu fertiggestellte Überführung. Es ist die schnellste Route aus der Stadt heraus.", "Emily")
	await novel_interface.show_dialog("Und wenn Sie „das“ tun, denken Sie auch daran, das Fahrzeug zuerst umzudrehen.", "Emily")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Verstanden~", "Vera")
	await novel_interface.show_text_only("Vera drehte das Lenkrad bis zum Anschlag, drückte aufs Gaspedal und drehte die Frontpartie in einer einzigen Drehung herum, ohne sich auch nur im Geringsten um den Komfort der Passagiere zu kümmern.")
	await novel_interface.show_text_only("Einen Moment später ertönte vier dumpfe Schläge vom Dach des Fahrzeugs: poltsch, poltsch, poltsch, poltsch.")
	novel_interface.show_character("ren_medical","panic")
	await novel_interface.show_dialog("(Warte, warum klang das wie ein Granatwerfer ...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sehr bald gerieten die versammelten Männer in Schwarz in Panik, als an vier verschiedenen Stellen in der Menge weiße Tränengasrauchwolken aufstiegen ...")
	await novel_interface.show_text_only("Und unser Fahrzeug überschlug sich und verschwand um die Ecke.")
	await novel_interface.stop_music()
	await novel_interface.hide_background_with_fade()
	await novel_interface.show_text_only("...")
	await novel_interface.show_text_only("............")
	await novel_interface.show_text_only("Als der Schatten der Isolationsmauer hinter mir kleiner wurde, wurde das Land auf beiden Seiten der Straße allmählich unfruchtbar.")
	await novel_interface.show_text_only("Nachdem man so lange in der Stadt geblieben war, vergaß man leicht, dass Masadaburg selbst eine abrupt in der Wüste erbaute Stadt war.")
	await novel_interface.show_text_only("Der APC raste über eine leere Straße, und nirgendwo außerhalb der einsamen Autobahn gab es Anzeichen von menschlichem Leben.")
	await novel_interface.show_text_only("Nur ein paar vertrocknete Sträucher standen noch hartnäckig im Sand...")
	novel_interface.change_music("res://assets/audio/music/unkown/Battle_08.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_StagingPost.png")
	await novel_interface.show_text_only("Etwa eine weitere Stunde außerhalb der Stadt öffnete sich langsam die Tür des Truppenabteils und eine militärische Versorgungsstation erschien vor mir.")
	novel_interface.show_character("valkyrja","normal")
	await novel_interface.show_dialog("Das ist es. Möchten Sie, dass sie mithilft?", "Vera")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","perspire1")
	await novel_interface.show_dialog("Hä?!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("emilio","smile")
	await novel_interface.show_dialog("Kein Problem. Sie wird kooperieren.", "Emily")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","wry_smile")
	await novel_interface.show_dialog("Du hast nicht einmal Angst, dass ich weglaufe –", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ich protestierte beim Aussteigen aus dem Fahrzeug sehr gehorsam, schluckte den Rest aber mittendrin hinunter.")
	novel_interface.show_character("ren_medical","wail")
	await novel_interface.show_dialog("(Es ist in alle Richtungen leere Wüste. Wo genau würde ich überhaupt rennen ...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Diese versunkene Versorgungsstation lag versteckt in den Dünen. Von weitem sah es aus wie ein weiterer kahler Erdhügel auf einem kahlen Hügel.")
	await novel_interface.show_text_only("Dennoch war es offensichtlich schon seit geraumer Zeit verlassen...")
	await novel_interface.show_text_only("Wahrscheinlich, weil der Unterhalt eines solchen Ortes zu teuer ist und weil der Widerstand die Umgebung bereits aufgegeben hat.")
	await novel_interface.show_text_only("Der im Bahnhof geparkte Jeep war mit einer dicken Staubschicht überzogen, und überall stapelten sich riesige Stapel Sandsäcke, die für den Bau von Befestigungsanlagen bestimmt waren.")
	await novel_interface.show_text_only("Der Gabelstapler und der Generator, die an der Wand lehnten, waren mit Rost und Narben bedeckt, die Wind und Sand hinterlassen hatten. In der Ecke lagen auch ein paar umgestürzte Munitionskisten...")
	await novel_interface.show_text_only("Zurück im Fahrzeug hatte Emily meine zweite Frage beantwortet: Was genau war das „persönliche Geschäft“, das sie hier erledigen wollten?")
	await novel_interface.show_text_only("Einen Teil davon hatte ich tatsächlich schon erraten. Es hatte mit meiner Tarnidentität zu tun...")
	await novel_interface.show_text_only("Laut Emily verstößt es gegen internationale Konventionen, wenn NGOs in Kriegsgebieten militärische Güter jeglicher Art transportieren.")
	await novel_interface.show_text_only("Von beiden Seiten Befreiungen zu erwirken, um unschuldigen Zivilisten zu helfen, nur um anschließend einer Seite zu helfen, ist ein schwerwiegender Verstoß gegen die Ethik.")
	await novel_interface.show_text_only("Doch in den letzten Jahren hat das Militär von Masadan viele militärische Außenposten als zivile Hilfseinrichtungen getarnt und NGOs bestochen, damit diese Vorräte für sie transportieren.")
	await novel_interface.show_text_only("Auf diese Weise können sie den Guerilla-Widerstand flexibler eingrenzen, und wenn einer dieser Außenposten zerstört wird, können sie ihn lautstark als Terroranschlag gegen Unschuldige verurteilen.")
	await novel_interface.show_text_only("Sie waren hier, um diese Art von Graumarktangeboten zu kapern.")
	await novel_interface.show_text_only("Mithilfe des Notfallcodes auf meiner Dienstmarke hatte Emily Informationen über das Fahrzeug gefunden, das sich am besten für das Ziel eignete.")
	await novel_interface.show_text_only("Diese Funktion war ursprünglich dazu gedacht, im Notfall die nächstgelegenen NGO-Hilfsgüter zu lokalisieren und abzurufen.")
	novel_interface.show_character("emilio","smile")
	await novel_interface.show_dialog("Der Lastwagen transportiert hauptsächlich militärische medizinische Versorgung. Es wird in vierzig Minuten hier auf der Autobahn vorbeifahren.", "Emily")
	await novel_interface.hide_character()
	novel_interface.show_character("valkyrja","happy")
	await novel_interface.show_dialog("Ich werde Straßensperren und Minen errichten. Ihr zwei macht die Maschinengewehre und Lautsprecher bereit.", "Vera")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","shy")
	await novel_interface.show_dialog("...Lautsprecher?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Reflexartig bewegte sich meine Hand zu meiner Brust.")
	await novel_interface.show_text_only("Vera zog nach und nach die Schutzhüllen von der Ausrüstung im Fahrzeug ab. Ich hatte mich darauf vorbereitet, aber es erschreckte mich trotzdem …")
	await novel_interface.show_text_only("Ein großer vierbeiniger Frachtroboter, zwei Reihen ferngesteuerter Straßensperren, sechs automatisch zielende Maschinengewehre, vier Lautsprecher und ein Haufen kleiner ferngesteuerter Bomben ...")
	await novel_interface.show_text_only("...Was zum Teufel hatten sie vor!?")
	await novel_interface.show_text_only("Emily und ich nutzten schnell die Tragfähigkeit des Packroboters, um die Maschinengewehre und Lautsprecher auf den nahegelegenen Hügeln einzusetzen.")
	await novel_interface.show_text_only("Nachdem sie die Straßensperren und Bomben errichtet hatte, befolgte Vera Emilys Anweisungen, füllte einen Jeep mit Benzin und fuhr ihn hinter einen riesigen Felsbrocken an der Straße.")
	await novel_interface.show_text_only("Dann starteten sie die Aufklärungsdrohne von der Oberseite des APC aus und versteckten das Fahrzeug perfekt unter einer optischen Tarnabdeckung.")
	await novel_interface.show_text_only("Schließlich kauerten wir drei hinter dem höchsten Hügel und warteten schweigend auf das Erscheinen des Ziels.")
	novel_interface.show_character("ren_medical","stare")
	await novel_interface.show_dialog("Sie garantieren wirklich, dass niemand verletzt wird ...?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ich fragte unbehaglich. Die Waffen, die wir gerade aufgestellt hatten, schienen auszureichen, um einen ganzen Zug auszulöschen.")
	novel_interface.show_character("valkyrja","wink")
	await novel_interface.show_dialog("Entspannen Sie sich. Das ist ein Emily-Plan...", "Vera")
	await novel_interface.show_dialog("Jeder in unserem Bataillon weiß, wenn es ihr Plan ist, ist es in Ordnung!", "Vera")
	await novel_interface.hide_character()
	novel_interface.show_character("emilio","mock")
	await novel_interface.show_dialog("Diese Maschinengewehre verwenden KI-gesteuertes Infrarot-Zielen. Sie werden auf keinen Fall Menschen schlagen.", "Emily")
