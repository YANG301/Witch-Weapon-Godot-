	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aya enciende el video de vigilancia mientras se queja.")
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("No es ningún mal funcionamiento. Todas las lecturas volvieron a la normalidad rápidamente. El sensor también ha estado funcionando bien desde entonces.", "Aya")
