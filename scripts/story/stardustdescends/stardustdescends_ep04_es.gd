	await novel_interface.show_text_only("Aya rápidamente descarta posibilidades. Al final, parece haber sólo una explicación...")
	novel_interface.show_character("ai","blush_dizzy")
	await novel_interface.show_dialog("Lian, y solo Lian, absorbió 2,5 YB de datos en menos de un segundo...", "Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aya encuentra su propia conclusión difícil de creer.")
	await novel_interface.show_dialog("... ¿Recuérdame nuevamente qué tan grande es una unidad YB?", "Mariru")
	novel_interface.show_character("ai","blush_dizzy")
	await novel_interface.show_dialog("Un yottabyte es 10 elevado a 24 bytes de potencia, más que todos los datos de Internet de antes de la guerra combinados...", "Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("La voz de Aya tiembla de emoción.")
	novel_interface.show_character("ai","blush_dizzy")
