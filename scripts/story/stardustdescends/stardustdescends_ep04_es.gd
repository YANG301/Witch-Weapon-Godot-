	novel_interface.show_character("ai","blush_wink")
	await novel_interface.show_dialog("Me temo que ahora tendremos que depender de Lian.", "Aya")
	await novel_interface.hide_character()
	await novel_interface.hide_background_with_fade()
	await novel_interface.stop_music()
	await novel_interface.show_text_only("...")
	await novel_interface.show_text_only("Cinco días después, a bordo del barco casino de Lebona, Liberty Star.")
	novel_interface.change_music("res://assets/audio/music/Shop.mp3")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_Gambling_Boat.png")
	await novel_interface.show_dialog("Um... ¿señorita?", "Crupier")
	await novel_interface.show_dialog("¿Señorita?", "Crupier")
	novel_interface.show_character("ren_full","panic")
	await novel_interface.show_dialog("¿Es mi turno?", "Lian")
	await novel_interface.show_dialog("F-Doblar...", "Lian")
	novel_interface.change_expression("perspire1")
	await novel_interface.show_dialog("Lo siento, pero tengo que quedarme sentado una ronda.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("La niña se levanta de la mesa y camina hacia un lugar tranquilo en la esquina del pasillo.")
	novel_interface.show_character("ren_full","wry_smile")
	await novel_interface.show_dialog("¡Tuve un rubor! ¿Por qué me dijiste que me retirara?", "Lian")
	await novel_interface.show_dialog("(baja la voz). Especialmente después de haber apostado tanto dinero...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("La voz baja de Lian no puede ocultar su decepción.")
	await novel_interface.show_dialog("Saca tu teléfono y finge que estás atendiendo una llamada, Lian. En este momento, para todos los demás, parece como si estuvieras murmurando para ti mismo.", "Annie")
	await novel_interface.show_dialog("Hay tres salas de control en este barco. Ya he asaltado uno...", "Annie")
	novel_interface.show_character("ren_full","wail")
	await novel_interface.show_dialog("(R-¡¿Incursión?!...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Hay cámaras por todas partes en este barco. Si alguien nota tu microauricular, te arrojarán a los tiburones.", "Nix")
	await novel_interface.show_text_only("Siento escalofríos por mi espalda. Rápidamente saqué mi teléfono.")
	novel_interface.show_character("ren_full","upset")
	await novel_interface.show_dialog("Ya perdí el 20% de lo que traje. ¿No dijiste que tenía que duplicar mi dinero antes de poder entrar a la sala VIP?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Miro el número en la pulsera que me emitió el casino y me digo una y otra vez: esto no es dinero.")
