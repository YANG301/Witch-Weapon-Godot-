# stardustdescends_ep11.gd - 星尘降临篇第11话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	stardustdescends_ep11_script()

func play_script():
	pass

func stardustdescends_ep11_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_MasadMuseum.png")
	novel_interface.show_character("ren_medical","normal1")
	await novel_interface.show_dialog("Национальный музей Масады... вот это место?", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Держа телефон, я убедился, что прибыл в нужное место.")
	await novel_interface.show_text_only("Что меня удивило, так это то, что большинство выставочных залов этого национального музея располагались в полуподземных помещениях.")
	await novel_interface.show_text_only("Говорят, что черная каменная стена, стоящая у главного входа, содержит камень, взятый из руин старой городской стены на западной стороне Храмовой горы в бывшей столице.")
	await novel_interface.show_text_only("Черный материал, защищающий от радиации, плотно обернутый снаружи стены, казалось, молча говорил о ранах и страданиях, оставленных этой катастрофой.")
	await novel_interface.show_text_only("Вся стена напоминала гигантское надгробие. Под ним стояли несколько пожилых людей, склонив головы и нежно поглаживая камень, и я не мог понять, скорбят они или молятся...")
	novel_interface.show_character("ren_medical","uneasy")
	await novel_interface.show_dialog("Я регистрируюсь здесь... верно?", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я использовал свой бейдж на беспилотной стойке у входа и выполнил биометрическое сканирование лица.")
	await novel_interface.show_text_only("Этот значок представлял собой зашифрованное удостоверение Международной организации медицинской помощи, разработанное специально для медицинского персонала, который часто приезжает в зоны боевых действий и покидает их.")
	await novel_interface.show_text_only("Помимо хранения личной информации и медицинских записей, он также позволяет вам пользоваться средствами связи организации и гуманитарной помощью в любой точке мира.")
	await novel_interface.show_text_only("В него даже была предварительно загружена определенная сумма в автономной электронной валюте, предположительно для выплаты выкупа, если вас похитят...")
	novel_interface.show_character("ren_medical","wry_smile")
	await novel_interface.show_dialog("(Интернёру такой доступ вообще не нужен, верно!)\n(Мариру, честно...)", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("В любом случае, пока они не заставят меня сделать что-нибудь опасное...")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("...")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_FirstExhibition.png")
	await novel_interface.show_text_only("Я спустился на эскалаторе в первый выставочный зал, где в не очень просторном зале было выставлено множество каменных рельефов.")
	await novel_interface.show_text_only("Видимые следы ветровой эрозии, казалось, рассказывали о далекой, выветрившейся истории.")
	await novel_interface.show_text_only("Но меня не интересовала история. Я просто листал на телефоне и пытался понять, как мне пережить эти несчастные три часа.")
	novel_interface.show_character("ren_medical","panic")
	await novel_interface.show_dialog("Это... гид?!", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("В наши дни, когда голосовые гиды с искусственным интеллектом повсюду, я очень давно не видел настоящего человеческого гида.")
	novel_interface.show_character("ren_medical","stare")
	await novel_interface.show_dialog("(Разве в Масаде катастрофически не хватает населения...?)", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Это был пожилой мужчина с белой бородой, лет шестидесяти, в маленькой черной тюбетейке с идентификационным бейджем, прикрепленным к воротнику костюма.")
	await novel_interface.show_text_only("Он терпеливо направлял всех, пока они брали брошюры, добродушно улыбаясь, отвечая каждому, кто его о чем-то спрашивал.")
	await novel_interface.show_text_only("Заинтересовавшись, я подошел ближе. Он знакомил нескольких посетителей с историей музея...")
	await novel_interface.show_dialog("Хотя многие драгоценные реликвии были уничтожены в войну вместе с оригинальным национальным музеем.", "Гид")
	await novel_interface.show_dialog("Однако за последние годы этот новый музей собрал множество драгоценных артефактов из Западной Азии и Африки, что позволило им избежать разрушительных последствий войны...", "Гид")
	await novel_interface.show_text_only("Я взглянул на египетскую мумию и бронзовую маску, напечатанные на обратной стороне брошюры.")
	novel_interface.show_character("ren_medical","wail")
	await novel_interface.show_dialog("(Значит, ты только что украл их из тех мест, да!)", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Но в настоящее время большинство ценных исторических артефактов по всему миру все равно хранятся в Шести Академгородах, так что подобные вещи вряд ли являются чем-то необычным.")
	await novel_interface.show_text_only("Я заметил, что, хотя он говорил с большим волнением, его левая рука все время оставалась засунутой в карман костюма.")
	novel_interface.show_character("ren_medical","bored")
	await novel_interface.show_dialog("(Может быть, это какой-то особый религиозный обычай...)", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я осмотрелся. К счастью, сегодня был не шабат, поэтому посетителей было немного, да и других представителей медицинской организации в музее тоже не было.")
	await novel_interface.show_text_only("Для членов НПО обязательная процедура «ознакомительного визита» начинается с пребывания не менее тридцати минут в зале истории и документации.")
	await novel_interface.show_text_only("Я бродил от скуки, и вскоре мой взгляд привлек несколько местных жителей и более дюжины детей, прогуливающихся по этому месту одновременно.")
	await novel_interface.show_text_only("Среди них особенно бросались в глаза двое мужчин лет сорока — у обоих были большие бороды и странные маленькие косички, свисающие с волос на висках.")
	await novel_interface.show_text_only("Одеты они были одинаково: белые рубашки, черные пальто до колен и черные шляпы с плоской тульей и загнутыми полями, как у людей из какой-то странной организации.")
	await novel_interface.show_text_only("Около дюжины детей следовали за этими мужчинами, и мальчики, и девочки были одеты в одинаковые черно-белые костюмы.")
	novel_interface.show_character("ren_medical","bored")
	await novel_interface.show_dialog("(Это школьная экскурсия из соседней школы?)\n(Но возрастной диапазон в этой школе какой-то дикий...)", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Возраст детей был одинаковым: от трех-четырех лет до десяти; младший едва мог уверенно ходить, а некоторые из детей постарше кричали и хулиганили.")
	await novel_interface.show_text_only("За группой шли две усталые на вид женщины средних лет с обвисшими фигурами.")
	novel_interface.show_character("ren_medical","stare")
	await novel_interface.show_dialog("(Эти двое не учителя... не так ли?)", "Лиан")
	await novel_interface.show_dialog("(Почему один из них вообще толкает коляску?)", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Какое странное сочетание...")
	await novel_interface.show_text_only("Экскурсия по историческому залу быстро закончилась, и гид начал вести всех в зал документов.")
	await novel_interface.show_text_only("Он поправил микрофон, прикрепленный к воротнику, и откашлялся:")
	await novel_interface.show_dialog("Далее я покажу вам самый главный экспонат этого музея.", "Гид")
	await novel_interface.show_dialog("В соседнем зале фотографировать запрещено. Пожалуйста, отложите свои телефоны и следуйте за мной в Храм Книги.", "Гид")
	await novel_interface.show_text_only("В тот момент, когда они услышали это, шумные дети замолчали, и двое мужчин в черном тоже принялись торжествовать.")
	await novel_interface.show_text_only("Я отложила телефон и последовала за ним с любопытством, горящим в груди.")
	await novel_interface.hide_background()
	await novel_interface.stop_music()
	await novel_interface.show_text_only("После того, как гид просканировал отпечаток своей ладони, базальтовая дверь в зале истории медленно открылась, открыв за собой длинный каменный коридор.")
	await novel_interface.show_text_only("Более двадцати из нас вошли один за другим. Было такое ощущение, будто нас заразила какая-то торжественная атмосфера; все двигались осторожно и ничего не говорили.")
	await novel_interface.show_text_only("...")
	novel_interface.change_music("res://assets/audio/music/Normal Stage.mp3")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_SOTB.png")
	novel_interface.show_character("ren_medical","panic")
	await novel_interface.show_dialog("Это...", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("В конце коридора находилась комната странной формы.")
	await novel_interface.show_text_only("Выставочный зал Храма Книги имел идеально круглую форму, с равномерно расположенными кольцевыми полосами, идущими от стен до самого потолочного окна над головой.")
	await novel_interface.show_text_only("Свет, струящийся через потолочное окно, падал на выставочный стенд в центре, создавая ощущение тишины и священности.")
	await novel_interface.show_text_only("Все пространство было спроектировано как глиняный кувшин, а окружающие стены были выполнены из такого же глиняного материала.")
	await novel_interface.show_text_only("На круглом стенде в форме барабана с Священными Писаниями, стоящем на каменных ступенях, лежал древний пожелтевший, испещренный крапинками пергаментный свиток.")
	await novel_interface.show_text_only("Я поднялся по ступенькам и наклонился, чтобы рассмотреть поближе. Защитное стекло выглядело толщиной не менее пяти сантиметров, и большинство еврейских символов на свитке было хорошо видно.")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_DSS.png")
	await novel_interface.show_dialog("Может ли это быть...", "Лиан")
	await novel_interface.show_text_only("Знаешь, эта штука из того аниме...")
	await novel_interface.show_dialog("Это древний документ, обнаруженный в пещерах к северо-западу от Мертвого моря, известный как «Свитки Мертвого моря», величайшее археологическое открытие прошлого века.", "Гид")
	await novel_interface.show_dialog("Свитки Мертвого моря огромны по своим масштабам и включают в себя более пятисот рукописей, обнаруженных в двенадцати пещерах.", "Гид")
	await novel_interface.show_dialog("А та, что в этой витрине, представляет собой частичную рукописную страницу Бытия из «Торы», одного из свитков Мертвого моря.", "Гид")
	await novel_interface.show_dialog("В нем записан процесс создания Богом мира и то, как Он избрал масаданцев Своим избранным народом. Это самая важная историческая реликвия в этой стране.", "Гид")
	await novel_interface.show_text_only("Если подумать, масаданцы, кажется, всегда гордятся тем, что являются избранным Богом народом...")
	await novel_interface.show_text_only("Но меня никогда не интересовали подобные религиозные истории...")
	await novel_interface.show_text_only("У каждого народа на земле есть несколько предков, которые в их легендах превратились в богов, не так ли...")
	await novel_interface.show_text_only("Местные приезжие явно так не думали. Два дяди в странных шляпах тут же повернулись к футляру и начали молиться.")
	await novel_interface.show_text_only("Своим глубоким, добрым голосом продолжил гид.")
	await novel_interface.show_dialog("В этой рукописи записаны истории праотцов Авраама, Исаака, Иакова и двенадцати сыновей Иакова.", "Гид")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_TheThree.png")
	await novel_interface.show_dialog("Авраам — пророк во многих религиях и общий предок евреев и арабов.", "Гид")
	await novel_interface.show_dialog("Авраам был тем, кого Господь избрал из всех существ и благословил.", "Гид")
	await novel_interface.show_dialog("Бог заключил завет с Авраамом, пообещав даровать плодородную землю его законному сыну, его внуку и всем потомкам, которые произведут по линии внука.", "Гид")
	await novel_interface.show_dialog("Эта земля простирается от Нила до Евфрата. Это то, что мы теперь называем «Землей обетованной».", "Гид")
	await novel_interface.show_dialog("Позже у Авраама родился законный сын Исаак; Исаак родил Исава, и второго сына его звали Иаков...", "Гид")
	await novel_interface.show_dialog("(Подожди... Джейкоб?)", "Лиан")
	await novel_interface.show_text_only("Разве это не имя того администратора из Эллуки?")
	await novel_interface.show_text_only("С другой стороны, жители Запада действительно любят называть своих детей в честь деятелей религиозных классиков...")
	await novel_interface.show_text_only("Гид сделал паузу, поправил очки для чтения и продолжил объяснять содержание свитка.")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_MessOfPottage.png")
	await novel_interface.show_dialog("Согласно Священному Писанию, Иаков, второй сын Исаака, однажды купил право первородства своего старшего брата Исава за миску тушеной красной фасоли.", "Гид")
	await novel_interface.show_dialog("Согласно завету Авраама с Богом, как только Иаков получил право первородства, он приобрел законное право наследовать «Землю обетованную».", "Гид")
	await novel_interface.show_dialog("Позже Иаков стал святым патриархом Масады, а его двенадцать сыновей стали двенадцатью праотцами племен Масады...", "Гид")
	await novel_interface.show_text_only("К этому моменту моя голова начала пульсировать.")
	await novel_interface.show_text_only("Подожди... рагу из красной фасоли? Какого черта!?\nНеужели древние люди были такими непринужденными?")
	await novel_interface.show_text_only("А если это правда, то все масадцы — потомки того самого Иакова...")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_DSS.png")
	await novel_interface.show_text_only("Гид сделал два шага по круглой платформе, просмотрел слова в конце свитка и продолжил.")
	await novel_interface.show_dialog("Это заключительная часть Книги Бытия.", "Гид")
	await novel_interface.show_dialog("Жизнь святого патриарха Иакова была полна легенд. Ему приснились врата рая и он услышал, как Бог подтвердил клятву, данную его деду.", "Гид")
	await novel_interface.show_dialog("Он боролся с Богом, остался хромым и получил святое имя.", "Гид")
	await novel_interface.show_dialog("Последние семнадцать лет своей жизни Иаков провел в Египте и перед смертью призвал своего сына Иосифа...", "Гид")
	await novel_interface.show_dialog("Иаков заставил своего сына поклясться, что вынесет его из Египта и похоронит в пещере Махпела в Хевроне, в земле Ханаанской.", "Гид")
	await novel_interface.show_dialog("Это была семейная гробница, которую давно купил Авраам, где были похоронены родители, бабушка и дедушка Иакова.", "Гид")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("На этом рукопись заканчивается.")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_SOTB.png")
	novel_interface.show_character("ren_medical","worry")
	await novel_interface.show_dialog("(Пещера Махпела... почему это название кажется знакомым?)", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Такое ощущение, что Ая упоминал об этом на вчерашнем брифинге... Разве пару дней назад не было какого-то взрыва?")
	await novel_interface.show_text_only("Ух, я не могу вспомнить. В любом случае, все эти иностранцы и географические названия для меня звучат одинаково...")
	await novel_interface.show_text_only("Гид нежно погладил стекло витрины и тихо вздохнул.")
	await novel_interface.show_dialog("Масада — древний народ, и мы придаем большое значение археологическим раскопкам.", "Гид")
	await novel_interface.show_dialog("Со дня обнаружения первого свитка раскопки и реставрация свитков Мертвого моря продолжались более восьмидесяти лет.", "Гид")
	await novel_interface.show_dialog("Они — драгоценное наследие наших предков, а также наши корни.", "Гид")
	await novel_interface.show_dialog("Однако...", "Гид")
	await novel_interface.show_text_only("Гид спустился по лестнице и подошел к огромной картине, написанной маслом, на одной стороне зала.")
	novel_interface.change_music("res://assets/audio/music/Hero.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_TheJewishWar.png")
	await novel_interface.show_text_only("Он долго стоял перед ним, глядя в многозначительное молчание.")
	await novel_interface.show_text_only("Картина была грандиозной по размеру, занимая почти всю стену.")
	await novel_interface.show_dialog("Однако наша история также полна страданий.", "Гид")
	await novel_interface.show_text_only("Он обернулся, уголки его рта слегка дернулись, как будто он отчаянно подавлял какое-то болезненное воспоминание.")
	await novel_interface.show_dialog("Эта картина создана по мотивам сочинений историка первого века Иосифа Флавия.", "Гид")
	await novel_interface.show_dialog("В те дни могущественная Римская империя завоевала священный город, и более миллиона предков Масада были убиты солдатами-легионерами.", "Гид")
	await novel_interface.show_dialog("На этой картине изображен день, когда был подожжен Второй Храм.", "Гид")
