# stardustdescends_ep02.gd - 星尘降临篇第2话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	stardustdescends_ep02_script()

func play_script():
	pass

func stardustdescends_ep02_script():
