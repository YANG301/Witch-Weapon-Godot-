	await novel_interface.show_dialog("Einige Wissenschaftler argumentieren sogar, dass man Sex nicht anhand der Größe der Beckenöffnung beurteilen könne, da die Größe des menschlichen Gehirns zu diesem Zeitpunkt noch nicht begonnen habe.", "Mädchen")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lächelnd lehnte sie sich dicht an mein Ohr und flüsterte.")
	novel_interface.show_character("stardust_big","smile1")
