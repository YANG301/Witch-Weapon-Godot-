# stardustdescends_ep21.gd - 星尘降临篇第21话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	stardustdescends_ep21_script()

func play_script():
	pass

func stardustdescends_ep21_script():
	await novel_interface.show_text_only("..............")
	await novel_interface.show_text_only("...")
	await novel_interface.show_text_only("Спустя две недели после инцидента, на окраине Пятого Академгорода.")
	novel_interface.change_music("res://assets/audio/music/Shop.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_VillaHall.png")
	await novel_interface.show_text_only("С гарнитурой в ухе Никс изящно спускался по лестнице, разговаривая по телефону.")
	novel_interface.show_character("nyx_normal","normal1")
	await novel_interface.show_dialog("Этот инцидент был официально признан самым тяжким и отвратительным террористическим актом со времен войны.", "Никс")
	await novel_interface.show_dialog("Объединенный совет начал полномасштабное расследование и заявил, что не проявит ни малейшей снисходительности ни к кому, кто окажется под подозрением.", "Никс")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Итак...", "Никс")
	await novel_interface.show_dialog("Как вы думаете, сколько стоит информация о том, что «Мушар купил тот спутник через ваш канал»... господин Хонг?", "Никс")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("Может быть, это потому, что... Недавно у меня появились друзья, которые очень хорошо умеют отслеживать электронную валюту в обратном направлении~", "Никс")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Слабая улыбка заиграла в уголках рта Никса.")
	novel_interface.show_character("nyx_normal","smile")
	await novel_interface.show_dialog("Так что я верну себе это поместье от имени моего отца...", "Никс")
	await novel_interface.show_dialog("Конечно, бизнес, который он всегда вёл, может продолжаться. Я хочу только десять процентов прибыли в качестве арендной платы.", "Никс")
	await novel_interface.show_dialog("В конце концов, я бы не хотел, чтобы ты закончил, как Хамон.", "Никс")
	await novel_interface.show_dialog("Мне просто нужно, чтобы ты взял на себя ответственность за мою личную безопасность...", "Никс")
	await novel_interface.show_dialog("Вдохновленный Мушаром, мне также имплантировали своего рода монитор признаков жизни.", "Никс")
	novel_interface.change_expression("sad")
	await novel_interface.show_dialog("Если мои жизненные показатели прекратятся, эти секреты автоматически будут опубликованы в Интернете...", "Никс")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("Кстати, я сохраню в тайне отношения архиепископа Миллера с Лебоной~", "Никс")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("Поскольку вы были достаточно щедры, чтобы передать и мне украденные данные НАСА.", "Никс")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Никс взял планшет на столе и открыл зашифрованный файл.")
	novel_interface.show_character("nyx_normal","normal1")
	await novel_interface.show_dialog("...Спутник проекта 0812 называется \"ЗВЕЗДНАЯ ПЫЛЬ\"?", "Никс")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Как... совершенно неудивительно~", "Никс")
	await novel_interface.hide_character()
	await novel_interface.hide_background_with_fade()
	await novel_interface.show_text_only("...")
	await novel_interface.show_text_only("На следующий день SID Командный пункт.")
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.show_character("liliu_research","shock")
	await novel_interface.show_dialog("Так... ты действительно ничего не помнишь?", "Мариру")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("Совсем нет...", "Лиан")
	novel_interface.change_expression("wry_smile")
	await novel_interface.show_dialog("Я думаю, что ударная волна от удара спутника заставила меня удариться головой внутри БТР и потерять сознание.", "Лиан")
	await novel_interface.show_dialog("Потом, когда я проснулся, я обнаружил, что лежу на больничной койке с капельницей...", "Лиан")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("На кадрах Сил обороны, когда вы выходите из БТР, вы ничего не выражаете и совершенно молчаливы, окруженные странным кобальтово-синим свечением.", "Мариру")
	await novel_interface.show_dialog("Как будто ты уже знал весь план. Под всеобщими взглядами вы поднялись прямо на крышу конференц-центра.", "Мариру")
	novel_interface.change_expression("angry")
	await novel_interface.show_dialog("Согласно отчету Энни, почти в то же время бессознательное Stardust в посольстве также начало излучать подобное свечение...", "Мариру")
	await novel_interface.show_dialog("Эмили сказала, что когда вы схватили ее за руку на крыше, в ее тело хлынула какая-то неописуемо огромная сила.", "Мариру")
	await novel_interface.show_dialog("В сотни раз сильнее, чем когда вы двое столкнулись с Ульем раньше, как будто он мог расплавить ее тело в любой момент.", "Мариру")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("Но после того, как этот удар был нанесен, сияние вокруг вас исчезло. Ты обмяк в ее объятиях и отчаянно пытался уткнуться лицом в ее грудь.", "Мариру")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("...А?\nD-Правда?", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Блин, я вообще ничего этого не помню!")
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("Но после прочтения брифинга об инциденте я все еще кое-что не понимаю...", "Лиан")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Мушар купил ключ управления этим спутником два года назад, верно?", "Лиан")
	await novel_interface.show_dialog("Тогда Масада даже не анонсировал автоматическую систему возмездия. Как он мог заранее подготовить контрмеру?", "Лиан")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Даже если бы он просто врезался этим спутником в землю, ущерб был бы огромным. Возможно, это даже изменило бы ситуацию на поле обычного боя.", "Мариру")
	await novel_interface.show_dialog("Опытный стратег никогда не тратит зря ни единого куска. Кто знает, когда он может оказаться полезным...", "Мариру")
	await novel_interface.hide_character()
	
	
	await novel_interface.show_text_only("Мариру многозначительно посмотрела на меня, а я сделал вид, что понимаю, и кивнул.")
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Вчера Никс нашел украденный файл НАСА на черном рынке.", "Мариру")
	await novel_interface.show_dialog("Спутник, упавший в Мертвое море, должен был принимать и хранить сигналы, передаваемые к Земле из определенного региона Плеяд, находящегося на расстоянии четырехсот световых лет.", "Мариру")
	novel_interface.change_expression("angry")
	await novel_interface.show_dialog("Объем данных сигнала был огромен, хранил терабайты в секунду, и его можно было получить только с определенных орбитальных позиций...", "Мариру")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Таким образом, данные пришлось хранить на жестких дисках внутри спутника до тех пор, пока однажды, после того, как он будет заполнен, спутник можно будет вернуть на Землю для физического восстановления.", "Мариру")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("Вы могли бы назвать это космическим центром обработки данных.", "Мариру")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Ая подозревает, что эти данные могут быть связаны с пропавшими воспоминаниями Stardust.", "Мариру")
	await novel_interface.show_dialog("Но сейчас этот спутник разбит и разбросан по дну Мертвого моря, на глубине более четырехсот метров...", "Мариру")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Значит, воспоминания Stardust невозможно восстановить?", "Лиан")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Кто знает... В любом случае сигнал из глубокого космоса пропал.", "Мариру")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("Может быть, в каком-то смысле оно уже достигло своей цели?", "Мариру")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","gratified")
	await novel_interface.show_dialog("Так как сейчас дела у Stardust...?", "Лиан")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Когда она впервые вернулась, она спала так же, как и ты. Ая отвез ее в исследовательский центр мозга Харимы...", "Мариру")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Но у вас двоих, кажется, есть какая-то психическая связь. Вчера вы оба проснулись почти в одно и то же время.", "Мариру")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("Впрочем, она тоже ничего не знает. Ая был очень разочарован и сказал, что голова ребенка такая же пустая, как и твоя.", "Мариру")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Кого ты называешь пустоголовым!?")
	novel_interface.show_character("liliu_research","angry")
	await novel_interface.show_dialog("О, верно! Ая также провела тест на родство на Stardust...", "Мариру")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","perspire1",0.25)
	await novel_interface.show_dialog("?", "Лиан")
	novel_interface.character_light(0.35,"happy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Не волнуйтесь, вы действительно не связаны кровью~", "Мариру")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"wail")
	await novel_interface.show_dialog("Во-первых, такой возможности не должно было быть!!", "Лиан")
	novel_interface.character_light(0.35,"speak")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Малышка продолжала настаивать на встрече с тобой после того, как проснулась, поэтому Энни отвозит ее обратно в штаб.", "Мариру")
	await novel_interface.show_dialog("Хе-хе-хе... дети действительно очень оживленные, не так ли~", "Мариру")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Why do you sound like somebody's grandma...?",)
	novel_interface.show_character("liliu_research","happy")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("ren_battle","wail",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Поскольку этот ребенок настаивает на том, чтобы цепляться за вас, я подумал, что это также может быть хорошим шансом исправить вашу привычку всегда пытаться уклониться от ответственности.", "Мариру")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Ч-что ты имеешь в виду...?\n(Это не может означать то, что я думаю!!)", "Лиан")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Мариру взяла термос и сделала небольшой глоток травяного чая, наполненного странными растениями, и добрая улыбка расплылась по ее лицу.")
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("Кстати, эм... С Эмили и Верой все в порядке?", "Лиан")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Вы не знали? У них сейчас все отлично~", "Мариру")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("А?", "Лиан")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Репортер, находившийся поблизости, снял на видео крышу конференц-центра с верхнего этажа жилого дома.", "Мариру")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("Итак, весь мир увидел, как Эмили спустилась, как богиня, и разделила песчаную бурю на две части...", "Мариру")
	await novel_interface.show_dialog("Позже Силы обороны объяснили это неким одноразовым оружием из гетерогенной материи, из которого можно выстрелить только один раз.", "Мариру")
	await novel_interface.show_dialog("Но во всех авраамических религиях только такой избранный персонаж, как Моисей, мог «растворить море и спасти людей».", "Мариру")
	await novel_interface.show_dialog("Учитывая столь бурную реакцию нижних слоев верующих, а также то, что она принадлежит к смешанной расе и сама не имеет религии...", "Мариру")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Главный раввин Масады и его имамы достигли беспрецедентного консенсуса, пытаясь назвать ее посланницей Бога.", "Мариру")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","stare")
	await novel_interface.show_dialog("Какая... сложная страна.", "Лиан")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Премьер-министр Шнайдерман пошла по течению и назначила ее главным советником Министерства религии и образования.", "Мариру")
	await novel_interface.show_dialog("Это всего лишь почетная должность, но Эмили все же наняла Веру своей помощницей.", "Мариру")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("Несколько дней назад парламент Масады решил продолжить выполнение частей первоначального соглашения о прекращении огня, а Эмили будет координировать этнические вопросы.", "Мариру")
	await novel_interface.show_dialog("Таким образом, независимо от того, чем закончится борьба за власть внутри Сил обороны или будущие выборы, они оба должны держаться подальше от неприятностей.", "Мариру")
	await novel_interface.hide_character()
	
	novel_interface.show_character("ren_battle","happy")
	await novel_interface.show_dialog("Пока они в безопасности...", "Лиан")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Тогда насчет \"Phantom Force\"...", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Прежде чем я успел закончить, Мариру прервала меня.")
	novel_interface.show_character("liliu_research","angry")
	await novel_interface.show_dialog("Этот вопрос должен оставаться строго конфиденциальным. Даже Энни нельзя сказать.", "Мариру")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("А?", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Мариру посмотрела на меня с такой же улыбкой, как у маленького животного, делающего какую-то глупость.")
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Вы же не думаете, что Хамон пощадил Эмили только потому, что вам удалось разгадать тайну Phantom Force, не так ли?", "Мариру")
	await novel_interface.show_dialog("С того момента, как вы нажали кнопку передачи, Силы обороны и Монола отслеживали ваше местоположение. Этот БТР уже был окружен.", "Мариру")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("Если бы я вовремя не вмешался в разговор и не представился, ни ты, ни Эмили бы не выжили.", "Мариру")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","wail")
	await novel_interface.show_dialog("А?!", "Лиан")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Ты забыл? Phantom Force, ядро ​​системы возмездия, было давно запечатано.", "Мариру")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("Даже если все ваши выводы были верны, у вас все равно не было никаких доказательств.", "Мариру")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Более двадцати лет назад ту же теорию предложил масаданский профессор истории Шломо Сандер.", "Мариру")
	await novel_interface.show_dialog("У него тоже не было веских доказательств, и его объявили предателем, ревизионистом геноцида и пособником нацистов.", "Мариру")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","stare")
	await novel_interface.show_dialog("Тогда разве ты не тоже...", "Лиан")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Мое выступление передало два сообщения:", "Мариру")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("Во-первых, этот SID очень серьезно относится к вашей безопасности, если его директор появляется лично.", "Мариру")
	await novel_interface.show_dialog("Во-вторых, если с вами что-нибудь случится, SID без колебаний отомстит Масаде, используя эту информацию.", "Мариру")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Монола знает, что SID обладает достаточным интеллектом, который она может использовать, чтобы оказать давление на настоящих контролеров крупных международных СМИ.", "Мариру")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("Как любит говорить мир средств массовой информации: если ваш голос достаточно громок, вам не нужны никакие проклятые доказательства.", "Мариру")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Если бы эта история распространилась повсюду и вызвала достаточно националистических настроений, Западную Азию ждали бы как минимум еще тридцать лет антитеррористических войн.", "Мариру")
	await novel_interface.show_dialog("Эмили тоже все это тогда слышала, но Вере не рассказала. И ты тоже не будешь...", "Мариру")
