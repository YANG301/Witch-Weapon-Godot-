# stardustdescends_ep08.gd - 星尘降临篇第8话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	stardustdescends_ep08_script()

func play_script():
	pass

func stardustdescends_ep08_script():
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Masada0.png")
	await novel_interface.show_text_only("Третий школьный город, Масадабург.")
	await novel_interface.show_text_only("Военная крепость, построенная в пустыне, известная грязью Мертвого моря, песчаными бурями и террористическими атаками.")
	await novel_interface.show_text_only("Для большинства людей любая новость о Масадабурге означает либо военный конфликт, либо гуманитарную катастрофу.")
	await novel_interface.show_text_only("Окрашенный смертью пейзаж из крови и песка, сырой нефти и белого дыма уже давно висит над этой древней землей...")
	await novel_interface.show_text_only("Какой жизнью там живут люди?\nПонятия не имею...")
	await novel_interface.show_text_only("И все же это кажется странно знакомым, как будто я сам там был...")
	await novel_interface.hide_background()
	await novel_interface.show_dialog("Вздох──", "Лиан")
	novel_interface.change_music("res://assets/audio/music/unkown/UI_Main_Funk.mp3")
	novel_interface.show_background("res://assets/images/bg/Stardust/Vessel.png")
	await novel_interface.show_text_only("Я прислонился к перилам на палубе, а Stardust прижалась ко мне, как коала, слезы все еще блестели в ее глазах.")
	novel_interface.show_character("ren_full","wry_smile")
	await novel_interface.show_dialog("Хорошо, хорошо. Я просто пошутил──", "Лиан")
	novel_interface.change_expression("wail")
	await novel_interface.show_dialog("Эй, полегче. Твои ногти впиваются в мою плоть...", "Лиан")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("stardust_small","tear",0.25)
	await novel_interface.show_dialog("Нюхать...", "Stardust")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Д-Не вытирай нос о мою одежду!!!", "Лиан")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Я беспомощно вздохнул и погладил ее по голове, чтобы успокоить.")
	await novel_interface.show_text_only("Ранее Ая догадалась, что Stardust указала направление, это Масадабург, но после расспросов выяснилось, что девушка понятия не имела, что означает это название.")
	await novel_interface.show_text_only("Вернее, она даже не понимала понятия «школьный город»…")
	await novel_interface.show_text_only("Мариру сказала, что сначала разберется с информацией, и велела мне подождать на палубе, пока она снова со мной не свяжется.")
	await novel_interface.show_text_only("Я все еще не мог смириться с тем, что эта девушка была какой-то иллюзией, которую мог видеть только я, поэтому воспользовался возможностью провести еще несколько тестов──")
	await novel_interface.show_text_only("Сначала я положил телефон на землю и попросил ее поднять трубку.")
	await novel_interface.show_text_only("Вместо этого она просто вежливо улыбнулась мне, наклонила голову и посмотрела на меня так: «Ты что, дурак?»")
	await novel_interface.show_text_only("Примерно через тридцать секунд безвыходной ситуации я смог лишь неловко взять в руки свой телефон, а затем мне в голову пришла еще более глупая идея──")
	await novel_interface.show_text_only("«Если у нее нет физического тела, сможет ли она проходить сквозь стены?»")
	await novel_interface.show_text_only("Итак, пока она наблюдала, я вернулся в каюту, запер дверь, ведущую на палубу, и спрятался в ее слепой зоне.")
	await novel_interface.show_text_only("Через две минуты я услышал тихие рыдания с другой стороны. Почувствовав беду, я поспешно открыл дверь, а она схватила меня за бедро и не хотела отпускать.")
	await novel_interface.show_text_only("Чтобы избежать случайных официантов, проходящих через каюту, я изо всех сил старался подтащить ее к перилам.")
	novel_interface.show_character("ren_full","wail")
	await novel_interface.show_dialog("(С этим аксессуаром для ног я едва могу ходить...)", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Уход за ребенком всегда такой утомительный!?")
	await novel_interface.show_text_only("Хуже того, никто больше ее не видит. Сейчас я, должно быть, похож на какого-то сумасшедшего, бормочущего про себя и странно передвигающегося.")
	await novel_interface.show_text_only("Поскольку у меня действительно не было ответа на ее навязчивость, я мог только мягко уговаривать ее.")
	novel_interface.show_character("ren_full","wry_smile")
	await novel_interface.show_dialog("Вот, вот. Я не оставлю тебя~", "Лиан")
	novel_interface.change_expression("gratified")
	await novel_interface.show_dialog("Это была моя вина только что. Я извинюсь, ладно?", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я сказал это, построив на нее глупое лицо.")
	await novel_interface.show_text_only("Если бы кто-нибудь увидел, как я корчу рожицы в пустоте, мне бы хотелось заползти прямо в трещину в палубе.")
	await novel_interface.show_text_only("Stardust немного успокоился. Все еще обнимая меня, она подняла глаза, моргнула своими большими глазами, и наушники на ее голове сверкнули.")
	novel_interface.show_character("stardust_small","tear")
	await novel_interface.show_dialog("Тогда пообещай мне, что пойдешь со мной в этом направлении, хорошо...?", "Stardust")
	await novel_interface.show_dialog("Это действительно очень важно...", "Stardust")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("...")
	await novel_interface.show_text_only("Ты не притворно плакала сейчас, не так ли?")
	novel_interface.show_character("ren_full","upset")
	await novel_interface.show_dialog("(Детей действительно немного...)", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я понятия не имел, одобрит ли Мариру, что я отправлюсь с этим маленьким тагалом в такое опасное место.")
	await novel_interface.show_text_only("В этот момент в моем наушнике затрещали статические помехи, и Мариру снова подключилась к линии.")
	await novel_interface.show_dialog("Лиан, Энни, как много вы знаете о Масадабурге?", "Мариру")
	novel_interface.show_character("ren_full","worry")
	await novel_interface.show_dialog("Хм...", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Примерно...", "Энни")
	await novel_interface.show_text_only("Я очень старался запомнить, но даже во время обучения агентов SID информация о Масадабурге была фрагментарной.")
	await novel_interface.show_dialog("Город Третьей Школы, город-крепость в самом сердце Западной Азии, разделенный на внутренний и внешний районы изолирующей стеной высотой в десятки метров.", "Энни")
	novel_interface.show_character("ren_full","bored")
	await novel_interface.show_dialog("Я думаю, это произошло из-за этнического или религиозного конфликта или чего-то еще?", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("В любом случае, внешний район Масадабурга кажется опасным. Похоже, каждый месяц происходит один или два теракта!")
	await novel_interface.show_dialog("Их разведывательное агентство, Бюро миссии по восстановлению Масады, напрямую контролируется военными и имеет смелый, радикальный стиль.", "Энни")
	novel_interface.show_character("ren_full","happy")
	await novel_interface.show_dialog("Ах, я это знаю. Это агентство также называется «Монола», верно?", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Это имя постоянно появляется в фильмах и играх, хотя и редко в качестве основной фракции.")
	novel_interface.show_character("ren_full","smile")
	await novel_interface.show_dialog("Да, оружие у них тоже современное. В играх Масада обычно снабжает игроков дистанционно управляемыми танками и дронами...", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Ладно, хватит ──", "Мариру")
	await novel_interface.show_dialog("Геополитическая среда в этом регионе всегда была сложной, а если добавить сюда силы сопротивления и сепаратистские группировки, она станет еще более хаотичной.", "Мариру")
	await novel_interface.show_dialog("Но если говорить только о «внутреннем районе» Масадабурга, то его безопасность не хуже, чем в Нью-Тойосу, поэтому ──", "Мариру")
	novel_interface.show_character("ren_full","perspire1")
	await novel_interface.show_dialog("А? Не говори мне...\nТы согласился?", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Все еще обхватив мое бедро, Stardust счастливо извивалась.")
	await novel_interface.show_dialog("Только мы двое... ты уверен, что с нами все будет в порядке?", "Энни")
	await novel_interface.show_text_only("Три. Нас трое!!\nНе забудь, здесь есть лишний багаж!!")
	await novel_interface.show_dialog("Это не шпионская миссия. Мы еще даже не знаем точного пункта назначения. Если вы не сделаете ничего возмутительного, все будет в порядке.", "Мариру")
	await novel_interface.show_dialog("Кроме того, вам даже не придется менять корабли. Завтра утром это судно-казино пришвартуется в порту Масада~", "Ая")
	await novel_interface.show_dialog("...Что происходит? Разве мы не должны были отправиться в Самонтон?", "Энни")
	await novel_interface.show_dialog("Масада намерен подписать соглашение о прекращении огня с сопротивлением через три дня, и до завершения церемонии Суэцкий канал будет полностью закрыт.", "Мариру")
	await novel_interface.show_dialog("Ради безопасности своих пассажиров казино только что решило последовать «настоятельной рекомендации» военных Масады и вернуться в Эйлат.", "Мариру")
	await novel_interface.show_dialog("Этот корабль направится на север вдоль Большого канала Красного и Мертвого морей, пришвартуется в порту Масада и останется там до тех пор, пока не будет снята блокада Суэцкого канала.", "Мариру")
	await novel_interface.show_dialog("Под прикрытием Энни - студентка программы обмена произведениями искусства Нью-Тойосу. Оформление документов уже готово.", "Мариру")
	await novel_interface.show_dialog("Что касается тебя, береговая оборона Лиан──Масады, скорее всего, уже зарегистрировала твою прикрытие, так что продолжай быть маленькой медсестрой, какой ты есть~", "Мариру")
	await novel_interface.show_text_only("В голосе Мариру прозвучала улыбка, от которой мне стало немного не по себе.")
	novel_interface.show_character("ren_full","panic")
	await novel_interface.show_dialog("А??!", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("В любом случае, вы не сможете переехать, пока соглашение не будет подписано, поэтому следующие два дня потратьте на осмотр достопримечательностей города~", "Ая")
	await novel_interface.show_dialog("Если место, куда хочет пойти девушка, окажется за пределами города, я попрошу местную разведку прислать кого-нибудь для поддержки через три дня.", "Мариру")
	novel_interface.show_character("ren_full","panic")
	await novel_interface.show_dialog("Даже Суэцкий канал перекрыт...", "Лиан")
	await novel_interface.show_dialog("Просто подписание соглашения... им действительно нужно заходить так далеко?", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.stop_music()
	await novel_interface.show_dialog("Это потому что...", "Ая")
	await novel_interface.show_dialog("Потому что все уже серьезно ──", "Ая")
	await novel_interface.show_dialog("Вы двое были на корабле все это время, так что вы еще не знаете, не так ли?", "Мариру")
	await novel_interface.show_dialog("Ч-что случилось...?", "Энни")
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("Более десяти часов назад возле мечети Ибра в Хевроне, на территории Масады, произошел взрыв промышленных химикатов.", "Мариру")
	await novel_interface.show_dialog("Взрывная волна вызвала частичное обрушение близлежащих зданий и повредила местные системы электроснабжения, водоснабжения и газоснабжения.", "Мариру")
	await novel_interface.show_dialog("Согласно официальному заявлению, все жители этого района уже эвакуированы в безопасную зону.", "Мариру")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Очередной теракт?", "Лиан")
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("Под мечетью Ибра находится пещера Махпела, которая считается местом захоронения предков народа Масадан.", "Ая")
	await novel_interface.show_dialog("Хотя с тех пор, как они захватили этот город в прошлом веке, они никогда не проводили там никаких археологических раскопок...", "Ая")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("Странно то, что, хотя официальное сообщение о потерях правдоподобно, информационная блокада слишком жесткая...", "Ая")
	await novel_interface.show_dialog("В сети даже не найти видео, снятое жителями окрестностей. На каждой странице новостей об этом инциденте используются фотографии и видео, предоставленные официальными лицами Масады.", "Ая")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","serious")
	await novel_interface.show_dialog("В то же время электронные системы нескольких крупных больниц в Хевроне вышли из строя, и огромное количество экстренных записей было утеряно.", "Мариру")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("После аварии Масада почти сразу же отклонил предложение организации всемирного наследия помочь сохранить руины пещеры Махпела.", "Мариру")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Такой уровень вопиющего контроля над информацией действительно похож на Монолу... но зачем им блокировать информацию?", "Энни")
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("Наверное, потому, что они не хотят, чтобы ситуация еще больше усложнялась──", "Мариру")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Анализ спутниковых изображений показывает, что взрыв, скорее всего, был вызван небольшой ракетой.", "Мариру")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Сопротивление?\nНо разве они не собираются подписать прекращение огня...?", "Лиан")
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("Лидер сопротивления немедленно написал в социальных сетях, что инцидент не имеет к ним никакого отношения, и выразил сожаление и осуждение.", "Ая")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("В настоящее время разведывательная группа подозревает, что нападение могло быть совершено какой-то отколовшейся фракцией внутри сопротивления. Эти люди никогда не были единым блоком~", "Ая")
	await novel_interface.show_dialog("Даже если лидер хочет прекращения огня, сторонники жесткой линии внутри не хотят, чтобы соглашение было заключено, верно?", "Ая")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("Возможно. Но все это пока предположения. Что не является спекулятивным, так это то, что следующие три дня — самый чувствительный период, с которым может столкнуться Город Третьей Школы ──", "Мариру")
	await novel_interface.show_dialog("Соответственно, уровень безопасности Масады максимальный. Во внутреннем районе вы будете в большей безопасности, чем в открытом море.", "Мариру")
	novel_interface.change_expression("sigh")
	await novel_interface.show_dialog("Отдохни сегодня вечером как следует. Мы свяжемся с вами завтра, как только вы приедете в порт.", "Мариру")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Хорошо!", "Лиан")
	await novel_interface.show_dialog("Понятно~", "Энни")
	await novel_interface.show_text_only("На этом Мариру завершила разговор с двумя людьми на борту корабля и перевела взгляд на видеоизображение женщины в красном на большом экране.")
	novel_interface.show_character("akiko","serious")
	await novel_interface.show_dialog("...Ты тоже думаешь, что что-то не так?", "Акико")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","sigh")
	await novel_interface.show_dialog("Да. Об этом соглашении было объявлено слишком внезапно──", "Мариру")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("На прошлой неделе представитель правительства Масады внезапно объявил, что они подпишут соглашение о прекращении огня с сопротивлением в течение десяти дней.", "Мариру")
	await novel_interface.show_dialog("Правительства и средства массовой информации всего мира высоко оценили это, а разоружение и прекращение огня действительно являются общей тенденцией.", "Мариру")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("──Но соглашение по-прежнему кажется слишком поспешным.", "Мариру")
	await novel_interface.hide_character()
	novel_interface.show_character("akiko","normal")
	await novel_interface.show_dialog("Я согласен. Это не похоже на обычный стиль премьер-министра Шейннемана, который переезжает только после тщательного планирования.", "Акико")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("Не потому ли, что его состояние ухудшилось больше, чем ожидалось...?", "Ая")
	await novel_interface.show_dialog("Со времени последнего мирного форума премьер-министр Шейннеман ни разу не показывался публично~", "Ая")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","sigh")
	await novel_interface.show_dialog("Возможно, это не единственная причина──", "Мариру")
	novel_interface.change_expression("normal1")
