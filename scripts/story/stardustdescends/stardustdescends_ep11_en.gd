	await novel_interface.show_text_only("The guide paused, adjusted his reading glasses, and continued explaining the contents of the scroll.")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_MessOfPottage.png")
	await novel_interface.show_dialog("According to the scripture, Jacob, Isaac's second son, once bought his elder brother Esau's birthright with a bowl of red bean stew.", "Guide")
