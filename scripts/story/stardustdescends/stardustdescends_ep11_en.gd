	await novel_interface.hide_background()
	await novel_interface.show_text_only("...")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_FirstExhibition.png")
	await novel_interface.show_text_only("I rode the escalator down into the first exhibition hall, where a great many stone reliefs were displayed in the not-very-spacious room.")
	await novel_interface.show_text_only("The visible traces of wind erosion seemed to tell a distant, weathered history.")
	await novel_interface.show_text_only("But I wasn't interested in history. I just scrolled on my phone and tried to figure out how I was going to survive these miserable three hours.")
