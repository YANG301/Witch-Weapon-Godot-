	await novel_interface.show_text_only("Besides storing personal info and medical records, it also lets you call on the organization's communication gear and relief supplies anywhere in the world.")
	await novel_interface.show_text_only("It even came preloaded with a sum of offline electronic currency, supposedly for paying ransom if you're kidnapped...")
	novel_interface.show_character("ren_medical","wry_smile")
	await novel_interface.show_dialog("(An intern nurse doesn't need access like this at all, right!)
(Mariru, honestly...)", "Ren")
	await novel_interface.hide_character()
