	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_SOTB.png")
	novel_interface.show_character("ren_medical","worry")
	await novel_interface.show_dialog("(Machpelah Cave... why does that name sound familiar?)", "Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I feel like Aya mentioned it in last night's briefing... Wasn't there some explosion a couple days ago?")
	await novel_interface.show_text_only("Ugh, I can't remember. All these foreign people and place names sound the same to me anyway...")
	await novel_interface.show_text_only("The guide gently stroked the glass of the display case and sighed in a low voice.")
	await novel_interface.show_dialog("Masada is an ancient people, and we place great importance on archaeological excavation.", "Guide")
	await novel_interface.show_dialog("From the day the first scroll was discovered, the excavation and restoration of the Dead Sea Scrolls has continued for more than eighty years.", "Guide")
	await novel_interface.show_dialog("They are the precious heritage of our ancestors, and our roots as well.", "Guide")
	await novel_interface.show_dialog("However...", "Guide")
	await novel_interface.show_text_only("The guide walked down the stairs and approached the huge oil painting on one side of the hall.")
	novel_interface.change_music("res://assets/audio/music/Hero.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_TheJewishWar.png")
	await novel_interface.show_text_only("He stood before it for a long while, staring in meaningful silence.")
	await novel_interface.show_text_only("The painting was grand in scale, nearly covering an entire wall.")
	await novel_interface.show_dialog("Yet our history is also filled with suffering.", "Guide")
	await novel_interface.show_text_only("He turned around, the corners of his mouth twitching slightly as though he were desperately suppressing some painful memory.")
	await novel_interface.show_dialog("This painting was created based on the writings of the first-century historian Flavius Josephus.", "Guide")
	await novel_interface.show_dialog("In those days, the mighty Roman Empire conquered the holy city, and more than a million Masadan ancestors were slaughtered by legionary soldiers.", "Guide")
	await novel_interface.show_dialog("And this painting depicts the day the Second Temple was set ablaze.", "Guide")
