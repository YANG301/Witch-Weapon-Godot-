	await novel_interface.show_dialog("In the year 70, our ancestors were driven out of Judea in great numbers by the Romans.", "Guide")
	await novel_interface.show_dialog("Those who refused to accept exile from their homeland rose up in resistance, and more than a thousand rebels made Masada of that age their final fortress.", "Guide")
