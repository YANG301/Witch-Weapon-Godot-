	await novel_interface.hide_character()
	await novel_interface.show_text_only("Suddenly a thought flashed through my mind--")
	await novel_interface.show_text_only("Right. That elderly man's job was to tirelessly repeat the exact same speech to batch after batch of visitors every day...")
