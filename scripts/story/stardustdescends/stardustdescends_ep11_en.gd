	await novel_interface.show_dialog("When the Tenth Legion finally breached the city, the governor who entered found only more than nine hundred corpses and buildings burned to the ground--", "Guide")
	await novel_interface.show_dialog("The defenders chose suicide rather than submit and become slaves of Rome. In the end, only two adults and five children survived...", "Guide")
	await novel_interface.hide_background()
