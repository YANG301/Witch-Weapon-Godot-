	await novel_interface.show_dialog("Abraham is a prophet in many religions and the common ancestor of the Hebrews and the Arabs.", "Guide")
	await novel_interface.show_dialog("Abraham was the one the Lord chose from among all beings and blessed.", "Guide")
	await novel_interface.show_dialog("God made a covenant with Abraham, promising to grant a fertile land to his legitimate son, his grandson, and all the descendants that grandson's line would produce.", "Guide")
