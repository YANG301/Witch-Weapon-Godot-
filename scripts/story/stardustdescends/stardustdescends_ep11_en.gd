	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("A chill ran down my spine. I felt like I was beginning to understand what Mariru had said during last night's call...")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_Masadhotel.png")
	await novel_interface.show_dialog("If you want to maintain universal conscription, you have to let ideological indoctrination seep into every pore of society.", "Mariru")
