	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_IndiaEH.png")
	await novel_interface.show_text_only("After leaving the document exhibition area, I started wandering aimlessly around the museum.")
	await novel_interface.show_text_only("Even though that had just been a very full experience, the minimum time requirement meant I still had to remain here for another two and a half hours.")
	await novel_interface.show_text_only("The guide's speech from earlier was like a dark current churning at the bottom of the sea, lingering in my mind.")
	await novel_interface.show_text_only("I only calmed down when I stepped into a brightly lit semi-underground exhibition hall.")
