	await novel_interface.show_text_only("And if that's true, then all Masadans are descendants of that Jacob...")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_DSS.png")
	await novel_interface.show_text_only("The guide took two steps along the circular platform, examined the words near the end of the scroll, and continued.")
	await novel_interface.show_dialog("This is the closing portion of Genesis--", "Guide")
	await novel_interface.show_dialog("The life of the holy patriarch Jacob was full of legend. He dreamed of the gate of heaven and heard God reaffirm the oath made to his grandfather.", "Guide")
	await novel_interface.show_dialog("He wrestled with God and came away lame, and was granted a holy name.", "Guide")
	await novel_interface.show_dialog("Jacob spent the last seventeen years of his life in Egypt, and before his death he called for his son Joseph...", "Guide")
	await novel_interface.show_dialog("Jacob made his son swear to carry him out of Egypt and bury him in the Cave of Machpelah at Hebron in the land of Canaan.", "Guide")
