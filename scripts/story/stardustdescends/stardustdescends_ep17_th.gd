	novel_interface.show_character("ren_medical","worry")
	await novel_interface.show_dialog("(มืดมาก...)", "เหลียน")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("การโทรของฉันกับเอมิลี่ถูกตัดไปโดยไม่มีการเตือนล่วงหน้า พยายามโทรกลับกี่ครั้งก็ไม่มีการตอบรับ")
	await novel_interface.show_text_only("ความรู้สึกแย่ๆ แล่นเข้ามาหาฉัน อัตราการเกิดอาชญากรรมในสลัมแห่งนี้อยู่นอกเหนือแผนภูมิในตอนกลางคืน และคาดว่ากลุ่มหัวรุนแรงจะปรากฏตัวที่นี่เป็นครั้งคราว...")
