# stardustdescends_ep21.gd - 星尘降临篇第21话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	stardustdescends_ep21_script()

func play_script():
	pass

func stardustdescends_ep21_script():
	await novel_interface.show_text_only("..............")
	await novel_interface.show_text_only("...")
	await novel_interface.show_text_only("Due settimane dopo l'incidente, alla periferia della Quinta Città Accademia.")
	novel_interface.change_music("res://assets/audio/music/Shop.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_VillaHall.png")
	await novel_interface.show_text_only("Con l'auricolare all'orecchio, Nix scese con grazia le scale mentre parlava al telefono.")
	novel_interface.show_character("nyx_normal","normal1")
	await novel_interface.show_dialog("Quell'incidente è stato ufficialmente classificato come l'attacco terroristico più grave e abietto dai tempi della guerra.", "Nix")
	await novel_interface.show_dialog("Il Consiglio Unito ha avviato un'indagine completa e ha dichiarato che non mostrerà alcuna clemenza verso chiunque sia sospettato di esserne coinvolto.", "Nix")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Quindi...", "Nix")
	await novel_interface.show_dialog("Secondo lei, quanto vale l'informazione che \"Mushar ha comprato quel satellite attraverso il suo canale\"... signor Hong?", "Nix")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("Forse è perché... recentemente mi sono fatto degli amici che sono molto bravi a rintracciare la valuta elettronica a ritroso~", "Nix")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Un debole sorriso si incurvò agli angoli della bocca di Nix.")
	novel_interface.show_character("nyx_normal","smile")
	await novel_interface.show_dialog("Quindi riprenderò possesso di questa proprietà per conto di mio padre...", "Nix")
	await novel_interface.show_dialog("Naturalmente l’attività che ha sempre portato avanti può continuare. Voglio solo il dieci per cento dei profitti come affitto.", "Nix")
	await novel_interface.show_dialog("Dopotutto, non vorrei che tu finissi come Hamon.", "Nix")
	await novel_interface.show_dialog("Ho semplicemente bisogno che tu ti occupi della mia sicurezza personale...", "Nix")
	await novel_interface.show_dialog("Ispirato da Mushar, mi è stato anche impiantato una specie di monitor dei segni vitali.", "Nix")
	novel_interface.change_expression("sad")
	await novel_interface.show_dialog("Se i miei segnali vitali si fermano, quei segreti verranno automaticamente divulgati online...", "Nix")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("A proposito, manterrò riservata la relazione dell'arcivescovo Miller con Lebona~", "Nix")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("Visto che sei stato così generoso da consegnare anche a me i dati rubati della NASA.", "Nix")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Nix prese il tablet dalla scrivania e aprì il file criptato.")
	novel_interface.show_character("nyx_normal","normal1")
	await novel_interface.show_dialog("...Il satellite del Progetto 0812 si chiama \"STARDUST\"?", "Nix")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Come... assolutamente non sorprendente~", "Nix")
	await novel_interface.hide_character()
	await novel_interface.hide_background_with_fade()
	await novel_interface.show_text_only("...")
	await novel_interface.show_text_only("Il giorno successivo, SID Sala Comando.")
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.show_character("liliu_research","shock")
	await novel_interface.show_dialog("Quindi... davvero non ricordi niente?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("Niente affatto...", "Lian")
	novel_interface.change_expression("wry_smile")
	await novel_interface.show_dialog("Penso che l'onda d'urto dell'impatto del satellite mi abbia fatto sbattere la testa all'interno dell'APC e svenire.", "Lian")
	await novel_interface.show_dialog("Poi quando mi sono svegliato, mi sono ritrovato sdraiato in un letto d'ospedale con una flebo...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Nel filmato della Defense Force, quando uscivi dall'APC eri inespressivo e completamente silenzioso, circondato da uno strano bagliore blu cobalto.", "Mariru")
	await novel_interface.show_dialog("Era come se conoscessi già l'intero piano. Sotto gli occhi di tutti, sei salito direttamente sul tetto del centro congressi.", "Mariru")
	novel_interface.change_expression("angry")
	await novel_interface.show_dialog("Secondo il rapporto di Annie, quasi nello stesso momento, anche l'inconscio Stardust nell'ambasciata ha iniziato ad emettere un bagliore simile...", "Mariru")
	await novel_interface.show_dialog("Emily ha detto che quando le hai afferrato la mano sul tetto, un potere indescrivibilmente enorme sembrava fluire nel suo corpo.", "Mariru")
	await novel_interface.show_dialog("Centinaia di volte più forte di quando voi due avete incontrato l'Alveare, come se potesse sciogliere il suo corpo da un momento all'altro.", "Mariru")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("Ma dopo che il colpo è stato sferrato, il bagliore intorno a te è scomparso. Ti sei afflosciato tra le sue braccia e hai cercato disperatamente di seppellire il viso nel suo petto.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("...Eh?\nD-L'ho fatto?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Maledizione, non ricordo proprio niente!")
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("Ma dopo aver letto il briefing sull'incidente, ci sono ancora alcune cose che non capisco...", "Lian")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Mushar ha comprato la chiave di controllo di quel satellite due anni fa, giusto?", "Lian")
	await novel_interface.show_dialog("Masada allora non aveva nemmeno annunciato il sistema di ritorsione automatica. Come avrebbe potuto preparare in anticipo una contromisura?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Anche se avesse semplicemente fatto atterrare il satellite, il danno sarebbe stato enorme. Potrebbe anche aver cambiato le sorti del campo di battaglia convenzionale.", "Mariru")
	await novel_interface.show_dialog("Un abile stratega non spreca mai un solo pezzo. Chissà quando qualcuno potrebbe tornare utile...", "Mariru")
	await novel_interface.hide_character()
	
	
	await novel_interface.show_text_only("Mariru mi lanciò uno sguardo significativo mentre fingevo di capire e annuivo.")
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Ieri Nix ha trovato un file della NASA rubato al mercato nero.", "Mariru")
	await novel_interface.show_dialog("Il satellite precipitato nel Mar Morto avrebbe dovuto ricevere e immagazzinare i segnali trasmessi verso la Terra da una certa regione delle Pleiadi, distante quattrocento anni luce.", "Mariru")
	novel_interface.change_expression("angry")
	await novel_interface.show_dialog("Il volume dei dati del segnale era enorme, immagazzinava terabyte al secondo, e poteva essere ricevuto solo da posizioni orbitali specifiche...", "Mariru")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Quindi i dati dovevano essere archiviati su dischi rigidi all'interno del satellite fino a quando un giorno, una volta pieno, il satellite avrebbe potuto essere riportato sulla Terra per il recupero fisico.", "Mariru")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("Potresti chiamarlo un data center spaziale.", "Mariru")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Aya sospetta che i dati possano essere collegati ai ricordi scomparsi di Stardust.", "Mariru")
	await novel_interface.show_dialog("Ma quel satellite ora è andato in frantumi e disperso sul fondo del Mar Morto, a più di quattrocento metri di profondità...", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Quindi i ricordi di Stardust non possono essere recuperati?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Chissà... In ogni caso il segnale dallo spazio profondo è svanito.", "Mariru")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("Forse, in un certo senso, ha già raggiunto il suo scopo?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","gratified")
	await novel_interface.show_dialog("Allora, come sta Stardust adesso...?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Quando è tornata, stava dormendo come te. Aya l'ha portata all'Harima Brain Research...", "Mariru")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Ma voi due sembrate avere una specie di legame psichico. Ieri vi siete svegliati entrambi quasi alla stessa ora.", "Mariru")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("Eppure neanche lei sa niente. Aya è rimasta molto delusa e ha detto che la testa di quel ragazzo è vuota quanto la tua.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Chi stai chiamando a testa vuota!?")
	novel_interface.show_character("liliu_research","angry")
	await novel_interface.show_dialog("Oh giusto! Aya ha anche eseguito un test di parentela su Stardust...", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","perspire1",0.25)
	await novel_interface.show_dialog("?", "Lian")
	novel_interface.character_light(0.35,"happy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Non preoccuparti, voi due non siete davvero legati dal sangue~", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"wail")
	await novel_interface.show_dialog("Tanto per cominciare non avrebbe dovuto esserci alcuna possibilità!!", "Lian")
	novel_interface.character_light(0.35,"speak")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("La piccola ha continuato a insistere per vederti dopo essersi svegliata, quindi Annie la riporterà al quartier generale.", "Mariru")
	await novel_interface.show_dialog("Hehehe... i bambini sono davvero vivaci, non è vero?", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Why do you sound like somebody's grandma...?",)
	novel_interface.show_character("liliu_research","happy")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("ren_battle","wail",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Dato che quel ragazzino insiste ad aggrapparsi a te, ho pensato che potesse essere anche una buona occasione per correggere la tua abitudine di cercare sempre di schivare le responsabilità.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("W-Cosa intendi con...?\n(Non può assolutamente significare quello che penso!!)", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru prese il suo thermos e bevve un piccolo sorso di tisana intrisa di strane piante, un sorriso gentile si diffuse sul suo viso.")
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("A proposito, um... Emily e Vera stanno bene?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Non lo sapevi? Stanno andando alla grande in questo momento~", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("Eh?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Un giornalista nelle vicinanze ha filmato il tetto del centro congressi dall'ultimo piano di un edificio residenziale.", "Mariru")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("Quindi il mondo intero vide Emily scendere come una dea e dividere in due la tempesta di sabbia...", "Mariru")
	await novel_interface.show_dialog("Le Forze di Difesa in seguito lo spiegarono come una sorta di arma di materia eterogenea sacrificabile che può essere sparata solo una volta.", "Mariru")
	await novel_interface.show_dialog("Ma in tutte le religioni abramitiche, solo una figura scelta come Mosè poteva \"dividere il mare e salvare il popolo\".", "Mariru")
	await novel_interface.show_dialog("Con i ranghi inferiori dei fedeli che reagiscono in modo così forte, e con lei che è di razza mista e non ha alcuna religione...", "Mariru")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Il Gran Rabbino di Masada e i suoi Imam hanno raggiunto un consenso senza precedenti, entrambi si affrettano a chiamarla messaggera di Dio.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","stare")
	await novel_interface.show_dialog("Che paese... complicato.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Il primo ministro Schneiderman ha seguito la corrente e l’ha nominata consigliere capo presso il Ministero della religione e dell’istruzione.", "Mariru")
	await novel_interface.show_dialog("È solo un incarico onorario, ma Emily ha comunque assunto Vera come sua assistente.", "Mariru")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("Pochi giorni fa, il parlamento di Masada ha deciso di continuare ad attuare alcune parti dell'accordo originale di cessate il fuoco, con Emily che coordina gli affari etnici.", "Mariru")
	await novel_interface.show_dialog("In questo modo, non importa come andrà a finire la lotta per il potere all’interno delle Forze di Difesa o le future elezioni, loro due dovrebbero restare fuori dai guai.", "Mariru")
	await novel_interface.hide_character()
	
	novel_interface.show_character("ren_battle","happy")
	await novel_interface.show_dialog("Finché sono al sicuro...", "Lian")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Allora riguardo a \"Phantom Force\"...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Prima che potessi finire, Mariru mi interruppe.")
	novel_interface.show_character("liliu_research","angry")
	await novel_interface.show_dialog("Questa questione deve rimanere strettamente confidenziale. Nemmeno Annie può dirlo.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("Eh?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru mi guardò con lo stesso sorriso che riserva un piccolo animale che fa qualcosa di stupido.")
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Non penserai davvero che Hamon abbia risparmiato Emily perché ti è capitato di indovinare il segreto di Phantom Force, vero?", "Mariru")
	await novel_interface.show_dialog("Dal momento in cui hai premuto il pulsante di trasmissione, la Defense Force e Monola hanno tracciato la tua posizione. Quell'APC era già stato circondato.", "Mariru")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("Se non fossi intervenuto nella conversazione in tempo e non mi fossi identificato, né tu né Emily sareste sopravvissute.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","wail")
	await novel_interface.show_dialog("Eh?!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Te ne sei dimenticato? Essendo il fulcro del sistema di ritorsione, Phantom Force è stato sigillato molto tempo fa.", "Mariru")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("Anche se ogni deduzione che hai fatto fosse corretta, non avevi comunque alcuna prova.", "Mariru")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Più di venti anni fa, un professore di storia di Masadan di nome Shlomo Sander propose la stessa teoria.", "Mariru")
	await novel_interface.show_dialog("Anche lui non aveva prove concrete e fu denunciato come traditore, revisionista del genocidio e complice dei nazisti.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","stare")
	await novel_interface.show_dialog("Allora non eri anche tu...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Il mio intervento ha trasmesso due messaggi:", "Mariru")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("Innanzitutto, SID prende molto sul serio la tua sicurezza se il suo direttore appare di persona.", "Mariru")
	await novel_interface.show_dialog("In secondo luogo, se ti accadesse qualcosa, SID non esiterebbe a vendicarsi contro Masada utilizzando tali informazioni.", "Mariru")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Monola sa che SID possiede molta intelligenza che può usare per fare pressione sui veri controllori dei principali media internazionali.", "Mariru")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("Come piace dire al mondo dei media: se la tua voce è abbastanza forte, non hai bisogno di alcuna dannata prova.", "Mariru")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Se quella storia si diffondesse ovunque e suscitasse abbastanza sentimenti nazionalisti, l’Asia occidentale si troverebbe di fronte ad almeno altri trent’anni di guerre antiterrorismo.", "Mariru")
	await novel_interface.show_dialog("Anche Emily ha sentito tutto questo in quel momento, ma non lo dirà a Vera. E nemmeno tu...", "Mariru")
	await novel_interface.show_dialog("Una volta reso pubblico, un segreto perde il suo valore.", "Mariru")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("Fallo. Voi. Capire?", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru mi sorrise facendo schioccare le nocche.")
	novel_interface.show_character("ren_battle","wail")
	await novel_interface.show_dialog("Capisco!\nNon lo dirò a nessuno anche se mi uccide!!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("Morire non sarà così facile...", "Mariru")
	await novel_interface.show_dialog("Ho sentito che un orfanotrofio nei bassifondi di Masada ha ricevuto un'enorme donazione non molto tempo fa...", "Mariru")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("Non penserai che avessi dimenticato il gettone d'oro di Lebona, vero?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("Eh?\nG-G-G-Quello...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Me ne ero dimenticato!")
	await novel_interface.show_text_only("Allora volevo scendere a cercare Emily e gli altri, ma avevo paura che potesse succedere qualcosa...")
	await novel_interface.show_text_only("Così, mentre zia Haifa spegneva le luci, ho infilato il chip in un biglietto e l'ho lasciato davanti alla cornice della foto sulla sua scrivania.")
	await novel_interface.show_text_only("Nella nota ho detto che se non fossi tornata entro una settimana, avrebbe dovuto trattarla come una donazione per i bambini.")
	await novel_interface.show_text_only("In quel momento pensavo di sembrare incredibilmente figo. Non avrei mai immaginato di trascorrere due settimane intere dormendo a letto...")
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Conosco già tutta la storia, quindi da qui in poi...", "Mariru")
	await novel_interface.hide_character()
	
	
	await novel_interface.show_text_only("Per qualche ragione Mariru sembrava un po' emozionata.")
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("Tutto ciò di cui devi preoccuparti adesso è fare soldi per ripagare il tuo debito~", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("Anche se mi vendessi una dozzina di volte, non basterebbe comunque...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("Non essere così duro con te stesso~\nHo già ottenuto diverse offerte pubblicitarie per te.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","wail")
	await novel_interface.show_dialog("Cosa?!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Il video pubblicato dal giornalista ha catturato anche te, ma la maggior parte della gente presume che tu sia solo un medico che Emily ha salvato per caso.", "Mariru")
	await novel_interface.show_dialog("Dato che la tua faccia è già là fuori, piuttosto che lasciare che altre agenzie di intelligence speculassero selvaggiamente, ho pensato che ne avremmo approfittato...", "Mariru")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("Ho già negoziato un'approvazione per le nuove batterie ad alta energia che Masada ha appena lanciato...", "Mariru")
	await novel_interface.show_dialog("E il produttore pensa anche che sostituire il coniglio giocattolo delle tradizionali pubblicità di batterie con \"la ragazza salvata\" sia un'idea assolutamente geniale~", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Non c'è niente di bello nell'essere paragonato ad un coniglio!!")
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("...Quindi ecco quanto è divertente essere un manager~", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
