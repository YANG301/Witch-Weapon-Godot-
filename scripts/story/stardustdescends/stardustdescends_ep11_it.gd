# stardustdescends_ep11.gd - 星尘降临篇第11话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	stardustdescends_ep11_script()

func play_script():
	pass

func stardustdescends_ep11_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_MasadMuseum.png")
	novel_interface.show_character("ren_medical","normal1")
	await novel_interface.show_dialog("Museo Nazionale di Masada... questo è il posto giusto?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Tenendo in mano il telefono, mi sono assicurato di essere arrivato nel posto giusto.")
	await novel_interface.show_text_only("Ciò che mi ha sorpreso è che la maggior parte delle sale espositive di questo museo nazionale erano allestite in spazi semi-sotterranei.")
	await novel_interface.show_text_only("Si dice che il muro di pietra nera che si trova all'ingresso principale contenga pietra prelevata dalle rovine delle mura della città vecchia sul lato ovest del Monte del Tempio nell'ex capitale.")
	await novel_interface.show_text_only("Il materiale nero di schermatura dalle radiazioni avvolto strettamente attorno all'esterno del muro sembrava parlare silenziosamente delle ferite e della sofferenza lasciate da quella catastrofe.")
	await novel_interface.show_text_only("L'intero muro era come una gigantesca lapide. Sotto c'erano alcune persone anziane, che chinavano la testa e accarezzavano dolcemente la pietra, e non saprei dire se stessero piangendo o pregando...")
	novel_interface.show_character("ren_medical","uneasy")
	await novel_interface.show_dialog("Mi registro qui...vero?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ho usato il mio badge allo sportello automatico all'ingresso e ho completato una scansione biometrica facciale.")
	await novel_interface.show_text_only("Questo badge era una credenziale crittografata dell'International Medical Relief Organization, progettata specificamente per il personale medico che si sposta spesso dentro e fuori dalle zone di guerra.")
	await novel_interface.show_text_only("Oltre a memorizzare informazioni personali e cartelle cliniche, ti consente anche di chiamare i dispositivi di comunicazione e le forniture di soccorso dell'organizzazione in qualsiasi parte del mondo.")
	await novel_interface.show_text_only("Era addirittura precaricato con una somma di valuta elettronica offline, presumibilmente per pagare il riscatto in caso di rapimento...")
	novel_interface.show_character("ren_medical","wry_smile")
	await novel_interface.show_dialog("(Un'infermiera tirocinante non ha affatto bisogno di un accesso del genere, vero!)\n(Mariru, onestamente...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Comunque, sempre che non mi facciano fare nulla di pericoloso...")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("...")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_FirstExhibition.png")
	await novel_interface.show_text_only("Con la scala mobile scesi nella prima sala espositiva, dove nella stanza non molto spaziosa erano esposti moltissimi rilievi in pietra.")
	await novel_interface.show_text_only("Le tracce visibili dell'erosione eolica sembravano raccontare una storia lontana e alterata.")
	await novel_interface.show_text_only("Ma non ero interessato alla storia. Ho semplicemente cercato sul mio telefono e ho cercato di capire come avrei potuto sopravvivere a queste miserabili tre ore.")
	novel_interface.show_character("ren_medical","panic")
	await novel_interface.show_dialog("Quella è... una guida?!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Al giorno d'oggi, quando le guide vocali dell'IA sono ovunque, non vedevo una vera guida umana da molto tempo.")
	novel_interface.show_character("ren_medical","stare")
	await novel_interface.show_dialog("(Masada non è disperatamente a corto di popolazione...?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Era un uomo anziano con la barba bianca, probabilmente sulla sessantina, che portava un piccolo zucchetto nero con un distintivo di riconoscimento appuntato al bavero del vestito.")
	await novel_interface.show_text_only("Guidava pazientemente tutti mentre prendevano i volantini delle brochure, sorridendo gentilmente mentre rispondeva a ogni persona che gli chiedeva qualcosa.")
	await novel_interface.show_text_only("Incuriosito, mi avvicinai. Stava presentando la storia del museo ad alcuni visitatori...")
	await novel_interface.show_dialog("Anche se molti preziosi cimeli furono distrutti durante la guerra insieme al museo nazionale originario.", "Guida")
	await novel_interface.show_dialog("Negli ultimi anni, tuttavia, questo nuovo museo ha raccolto molti preziosi manufatti provenienti dall'Asia occidentale e dall'Africa, consentendo loro di sfuggire alle devastazioni della guerra...", "Guida")
	await novel_interface.show_text_only("Lanciai un'occhiata alla mummia egiziana e alla maschera di bronzo stampate sul retro della brochure.")
	novel_interface.show_character("ren_medical","wail")
	await novel_interface.show_dialog("(Quindi li hai appena rubati da quei posti, eh!)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ma al giorno d'oggi, i manufatti storici più preziosi di tutto il mondo sono comunque conservati nelle Sei Città Accademia, quindi questo genere di cose non è affatto insolito.")
	await novel_interface.show_text_only("Ho notato che mentre parlava con grande emozione, la sua mano sinistra era rimasta per tutto il tempo infilata nella tasca della giacca.")
	novel_interface.show_character("ren_medical","bored")
	await novel_interface.show_dialog("(Forse è qualche usanza religiosa speciale...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mi sono guardato intorno. Fortunatamente oggi non era sabato, quindi non c'erano molti visitatori e non c'erano nemmeno altri membri dell'organizzazione medica nel museo.")
	await novel_interface.show_text_only("Per i membri delle ONG, la procedura richiesta di \"visita di studio\" inizia con una permanenza di almeno trenta minuti nelle sale di storia e di documentazione.")
	await novel_interface.show_text_only("Vagavo annoiato e presto i miei occhi furono attratti da alcuni locali e da oltre una dozzina di bambini che visitavano il posto contemporaneamente.")
	await novel_interface.show_text_only("Tra loro, i più attraenti erano due uomini sulla quarantina: entrambi avevano grandi barbe e strane trecce che pendevano dai capelli sulle tempie.")
	await novel_interface.show_text_only("Erano vestiti allo stesso modo: camicie bianche, cappotti neri lunghi fino al ginocchio e cappelli neri a corona piatta con la tesa arricciata, come persone di una strana organizzazione.")
	await novel_interface.show_text_only("Una dozzina circa di bambini seguivano quegli uomini, e sia i ragazzi che le ragazze indossavano gli stessi abiti in bianco e nero.")
	novel_interface.show_character("ren_medical","bored")
	await novel_interface.show_dialog("(È una gita scolastica dalle vicinanze?)\n(Ma la fascia d'età in questa scuola è un po' selvaggia...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I bambini variavano uniformemente dai tre o quattro anni ai dieci circa; i più piccoli riuscivano a malapena a camminare in modo regolare, mentre alcuni dei ragazzi più grandi urlavano e si scagliavano contro.")
	await novel_interface.show_text_only("Dietro il gruppo arrancavano due donne di mezza età dall'aria stanca e dalle figure cadenti.")
	novel_interface.show_character("ren_medical","stare")
	await novel_interface.show_dialog("(Quei due non sono gli insegnanti... vero?)", "Lian")
	await novel_interface.show_dialog("(Perché uno di loro spinge anche un passeggino?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Che strano abbinamento...")
	await novel_interface.show_text_only("Il tour della sala storica si è concluso rapidamente e la guida ha iniziato a condurre tutti nella sala documenti.")
	await novel_interface.show_text_only("Si aggiustò il microfono agganciato al colletto e si schiarì la gola--")
	await novel_interface.show_dialog("Successivamente, ti mostrerò la mostra più importante di questo museo.", "Guida")
	await novel_interface.show_dialog("Nella sala accanto è vietato fotografare. Per favore, mettete via i cellulari e seguitemi nel Santuario del Libro.", "Guida")
	await novel_interface.show_text_only("Appena udirono ciò, i bambini chiassosi tacquero, e anche i due uomini in nero si fecero solenni.")
	await novel_interface.show_text_only("Ho messo via il telefono e l'ho seguito con la curiosità che mi bruciava nel petto.")
	await novel_interface.hide_background()
	await novel_interface.stop_music()
	await novel_interface.show_text_only("Dopo che la guida ebbe scannerizzato l'impronta del suo palmo, una porta di basalto nella sala di storia si aprì lentamente, rivelando un lungo corridoio di pietra al di là di essa.")
	await novel_interface.show_text_only("Più di venti di noi si sono presentati uno dopo l'altro. Sembrava che un'atmosfera solenne ci avesse contagiati; tutti si muovevano con cautela e non dicevano nulla.")
	await novel_interface.show_text_only("...")
	novel_interface.change_music("res://assets/audio/music/Normal Stage.mp3")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_SOTB.png")
	novel_interface.show_character("ren_medical","panic")
	await novel_interface.show_dialog("Questo è...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Alla fine del corridoio c'era una camera dalla forma strana.")
	await novel_interface.show_text_only("La sala espositiva del Santuario del Libro era perfettamente circolare, con strisce ad anelli equidistanti che correvano dalle pareti fino al lucernario sopra di loro.")
	await novel_interface.show_text_only("La luce che filtrava dal lucernario cadeva sullo stand espositivo al centro, rendendo l'intero luogo silenzioso e sacro.")
	await novel_interface.show_text_only("L'intero spazio era stato progettato come un vaso di terracotta e le pareti circostanti utilizzavano un materiale simile alla terra.")
	await novel_interface.show_text_only("Sull'espositore circolare a forma di tamburo scritturale, in cima ai gradini di pietra, giaceva un antico rotolo di pergamena ingiallita e screziata.")
	await novel_interface.show_text_only("Salii i gradini e mi chinai per dare un'occhiata più da vicino. Il vetro protettivo sembrava spesso almeno cinque centimetri e la maggior parte dei caratteri ebraici sul rotolo erano chiaramente visibili.")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_DSS.png")
	await novel_interface.show_dialog("Potrebbe essere...", "Lian")
	await novel_interface.show_text_only("Sai, quella cosa di quell'anime...")
	await novel_interface.show_dialog("Si tratta di un antico documento scoperto nelle grotte a nord-ovest del Mar Morto, conosciuti come i \"Rotoli del Mar Morto\", la più grande scoperta archeologica del secolo scorso.", "Guida")
	await novel_interface.show_dialog("I Rotoli del Mar Morto sono di vastissime dimensioni e comprendono più di cinquecento manoscritti rinvenuti in dodici grotte...", "Guida")
	await novel_interface.show_dialog("E quella in questa vetrina è una pagina manoscritta parziale della Genesi dalla \"Torah\", uno dei Rotoli del Mar Morto.", "Guida")
	await novel_interface.show_dialog("Registra il processo con cui Dio crea il mondo e come ha scelto i Masadan come popolo eletto. È la reliquia storica più importante di questo paese.", "Guida")
	await novel_interface.show_text_only("Ora che ci penso, i Masadan sembrano sempre orgogliosi di essere il popolo eletto di Dio...")
	await novel_interface.show_text_only("Ma non sono mai stato interessato a storie religiose come questa...")
	await novel_interface.show_text_only("Ogni popolo sulla terra ha alcuni antenati che nelle loro leggende si sono trasformati in dei, non è vero?")
	await novel_interface.show_text_only("I visitatori locali evidentemente non la pensavano così. I due zii con strani cappelli si voltarono subito verso la cassa e cominciarono a pregare.")
	await novel_interface.show_text_only("Con la sua voce profonda e gentile, la guida continuò.")
	await novel_interface.show_dialog("Questo manoscritto registra le storie degli antenati Abramo, Isacco, Giacobbe e i dodici figli di Giacobbe.", "Guida")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_TheThree.png")
	await novel_interface.show_dialog("Abramo è un profeta in molte religioni e l'antenato comune degli ebrei e degli arabi.", "Guida")
	await novel_interface.show_dialog("Abramo fu colui che il Signore scelse tra tutti gli esseri e benedisse.", "Guida")
	await novel_interface.show_dialog("Dio fece un patto con Abramo, promettendo di concedere una terra fertile al suo figlio legittimo, a suo nipote e a tutti i discendenti che la discendenza di quel nipote avrebbe prodotto.", "Guida")
	await novel_interface.show_dialog("Questa terra si estende dal Nilo all'Eufrate. È quella che oggi chiamiamo la “Terra Promessa”.", "Guida")
	await novel_interface.show_dialog("Successivamente Abraamo generò il figlio legittimo Isacco; Isacco generò Esaù e il suo secondo figlio si chiamò Giacobbe...", "Guida")
	await novel_interface.show_dialog("(Aspetta... Jacob?)", "Lian")
	await novel_interface.show_text_only("Non è quello il nome di quell'amministratore di Elluka?")
	await novel_interface.show_text_only("D'altra parte, agli occidentali piace davvero dare ai propri figli nomi di personaggi dei classici religiosi...")
	await novel_interface.show_text_only("La guida fece una pausa, si aggiustò gli occhiali da lettura e continuò a spiegare il contenuto del rotolo.")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_MessOfPottage.png")
	await novel_interface.show_dialog("Secondo le Scritture, Giacobbe, il secondo figlio di Isacco, una volta acquistò il diritto di primogenitura di suo fratello maggiore Esaù con una ciotola di stufato di fagioli rossi.", "Guida")
	await novel_interface.show_dialog("Secondo il patto di Abramo con Dio, una volta ottenuto il diritto di primogenitura, Giacobbe acquisì il diritto legittimo di ereditare la \"Terra Promessa\".", "Guida")
	await novel_interface.show_dialog("Giacobbe in seguito divenne il santo patriarca di Masada, e i suoi dodici figli divennero i dodici antenati delle tribù di Masada...", "Guida")
	await novel_interface.show_text_only("A questo punto la mia testa cominciava a pulsare.")
	await novel_interface.show_text_only("Aspetta... stufato di fagioli rossi? Che diavolo!?\nGli antichi erano davvero così casuali?")
	await novel_interface.show_text_only("E se questo è vero, allora tutti i Masadan sono discendenti di quel Jacob...")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_DSS.png")
	await novel_interface.show_text_only("La guida fece due passi lungo la piattaforma circolare, esaminò le parole verso la fine del rotolo e proseguì.")
	await novel_interface.show_dialog("Questa è la parte conclusiva della Genesi...", "Guida")
	await novel_interface.show_dialog("La vita del santo patriarca Giacobbe era piena di leggende. Sognò la porta del paradiso e sentì Dio riaffermare il giuramento fatto a suo nonno.", "Guida")
	await novel_interface.show_dialog("Lottò con Dio e ne ritornò zoppo, e gli fu concesso un nome santo.", "Guida")
	await novel_interface.show_dialog("Giacobbe trascorse gli ultimi diciassette anni della sua vita in Egitto e prima di morire chiamò a sé suo figlio Giuseppe...", "Guida")
	await novel_interface.show_dialog("Giacobbe fece giurare a suo figlio di portarlo fuori dall'Egitto e di seppellirlo nella grotta di Macpela a Hebron nel paese di Canaan.", "Guida")
	await novel_interface.show_dialog("Quella era la tomba di famiglia che Abramo aveva acquistato molto tempo prima, dove furono sepolti i genitori e i nonni di Giacobbe.", "Guida")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Il manoscritto finisce qui.")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_SOTB.png")
	novel_interface.show_character("ren_medical","worry")
	await novel_interface.show_dialog("(Grotta di Macpela... perché quel nome suona familiare?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mi sembra che Aya ne abbia parlato nel briefing di ieri sera... Non c'è stata un'esplosione un paio di giorni fa?")
	await novel_interface.show_text_only("Uffa, non riesco a ricordare. Comunque tutte queste persone e questi nomi di luoghi stranieri mi suonano uguali...")
	await novel_interface.show_text_only("La guida accarezzò dolcemente il vetro della vetrina e sospirò a bassa voce.")
	await novel_interface.show_dialog("Masada è un popolo antico e diamo grande importanza agli scavi archeologici.", "Guida")
	await novel_interface.show_dialog("Dal giorno in cui fu scoperto il primo rotolo, lo scavo e il restauro dei Rotoli del Mar Morto sono continuati per più di ottant'anni.", "Guida")
	await novel_interface.show_dialog("Sono la preziosa eredità dei nostri antenati, ma anche le nostre radici.", "Guida")
	await novel_interface.show_dialog("Tuttavia...", "Guida")
	await novel_interface.show_text_only("La guida scese le scale e si avvicinò all'enorme dipinto ad olio su un lato della sala.")
	novel_interface.change_music("res://assets/audio/music/Hero.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_TheJewishWar.png")
	await novel_interface.show_text_only("Rimase a lungo davanti ad esso, fissandolo in un silenzio significativo.")
	await novel_interface.show_text_only("Il dipinto era di grandi dimensioni e copriva quasi un'intera parete.")
	await novel_interface.show_dialog("Eppure la nostra storia è piena anche di sofferenza.", "Guida")
	await novel_interface.show_text_only("Si voltò, contraendo leggermente gli angoli della bocca, come se stesse disperatamente sopprimendo un ricordo doloroso.")
	await novel_interface.show_dialog("Questo dipinto è stato creato sulla base degli scritti dello storico del I secolo Flavio Giuseppe Flavio.", "Guida")
	await novel_interface.show_dialog("A quei tempi, il potente Impero Romano conquistò la città santa e più di un milione di antenati Masadan furono massacrati dai soldati legionari.", "Guida")
	await novel_interface.show_dialog("E questo dipinto raffigura il giorno in cui il Secondo Tempio fu dato alle fiamme.", "Guida")
	await novel_interface.show_dialog("Fu il giorno più triste nella storia di Masadan... eppure fu solo l'inizio di mille anni di sofferenza.", "Guida")
	await novel_interface.show_dialog("Nell'anno 70 i nostri antenati furono cacciati in gran numero dalla Giudea dai Romani.", "Guida")
	await novel_interface.show_dialog("Coloro che rifiutarono di accettare l'esilio dalla loro patria insorsero per resistere e più di mille ribelli fecero di Masada di quell'epoca la loro fortezza finale.", "Guida")
	await novel_interface.show_dialog("Tennero quella città per due anni interi sotto l'assedio romano, finché la loro fornitura d'acqua fu interrotta e non ebbero più le forze.", "Guida")
	await novel_interface.show_dialog("Quando la Decima Legione finalmente fece breccia nella città, il governatore che entrò trovò solo più di novecento cadaveri ed edifici rasi al suolo...", "Guida")
	await novel_interface.show_dialog("I difensori scelsero il suicidio piuttosto che sottomettersi e diventare schiavi di Roma. Alla fine sopravvissero solo due adulti e cinque bambini...", "Guida")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Immaginare quella scena mi fece male al petto.")
	await novel_interface.show_text_only("La guida rimase a lungo in silenzio, poi si voltò verso di noi e proseguì.")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_SOTB.png")
	await novel_interface.show_dialog("Siamo stati cacciati dalla nostra patria ancora e ancora, costretti a lasciare le nostre stesse case.", "Guida")
	await novel_interface.show_dialog("Siamo stati conquistati, governati, emarginati, massacrati, trattati come schiavi, prigionieri, persino come bestiame...", "Guida")
	await novel_interface.show_dialog("Un secolo fa, in una delle più spaventose purghe etniche della storia umana, furono massacrati sei milioni di nostri connazionali.", "Guida")
	await novel_interface.show_dialog("E dieci anni fa la nostra capitale era ancora una volta ridotta in terra bruciata. Il Monte del Tempio bruciò in fiamme viola per sette giorni e sette notti...", "Guida")
	await novel_interface.show_dialog("Molte persone, la mia famiglia e i miei amici, hanno perso la vita in quella catastrofe.", "Guida")
	await novel_interface.show_dialog("E coloro che sono sopravvissuti per pura fortuna potrebbero aver perso ancora di più...", "Guida")
	await novel_interface.show_text_only("La sua voce tremava mentre alzava la mano sinistra che aveva infilato in tasca.")
	await novel_interface.show_text_only("Solo allora ci siamo accorti che la mano era stata sostituita da una protesi metallica, e delle ustioni coprivano il polso e l'avambraccio esposto oltre la manica...")
	await novel_interface.show_text_only("L'intera stanza cadde nel silenzio. Anch'io mi sono ritrovato a trattenere il respiro.")
	await novel_interface.show_text_only("Una giovane turista tra la folla si coprì la bocca con entrambe le mani, con le lacrime agli occhi.")
	await novel_interface.show_text_only("Ma la guida strinse quella mano a pugno e la alzò in alto, guardandoci mentre parlava con voce risoluta:")
	await novel_interface.show_dialog("Eppure, proprio come quei mille guerrieri che hanno difeso questa fortezza fino alla fine, la sofferenza non ci farà mai sottomettere.", "Guida")
	await novel_interface.show_text_only("La sua voce non era forte, ma era piena di spirito eroico, e mi fece salire una strana forza nel petto.")
	await novel_interface.show_text_only("I suoi occhi brillavano come se potesse vedere un dio che indicava la strada.")
	await novel_interface.show_dialog("Abbiamo sopportato due grandi diaspore, ma alla fine torneremo sempre in questa terra, perché la sofferenza non ci farà mai sottomettere...", "Guida")
	await novel_interface.show_dialog("Novant’anni fa, i nostri antenati sfidarono colpi di arma da fuoco e proiettili solo per tornare qui ancora una volta e fondare una nazione tutta nostra.", "Guida")
	await novel_interface.show_dialog("Anche se questo non era altro che un deserto arido, anche se allora l’acqua dolce era scarsamente disponibile, questa è la nostra casa!", "Guida")
	await novel_interface.show_dialog("Ciò che scorre in questa terra non è latte e miele, ma il nostro sangue, le nostre lacrime e il nostro sudore.", "Guida")
	await novel_interface.show_dialog("Questa è la nostra unica patria al mondo e la casa spirituale che il popolo Masadan ama da migliaia di anni.", "Guida")
	await novel_interface.show_dialog("La \"Terra Promessa\" è il patto tra i nostri antenati e Dio, e anche la nostra promessa alle generazioni future...", "Guida")
	await novel_interface.show_dialog("Il Tempio potrà anche essere bruciato, ma la fortezza dello spirito non cadrà mai!", "Guida")
	await novel_interface.show_dialog("Infine, grazie ancora a tutti per aver visitato il Museo Nazionale di Masada. Grazie a tutti!", "Guida")
	await novel_interface.show_text_only("Detto questo, la guida si inchinò alla folla.")
