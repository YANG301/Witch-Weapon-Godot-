# stardustdescends_ep17.gd - 星尘降临篇第17话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	stardustdescends_ep17_script()

func play_script():
	pass

func stardustdescends_ep17_script():
	novel_interface.change_music("res://assets/audio/music/Sewer.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_SlumArea.png")
	await novel_interface.show_text_only("Я спустился по темной лестнице и вышел из здания в полной темноте.")
	novel_interface.show_character("ren_medical","worry")
	await novel_interface.show_dialog("(Так темно...)", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Мой разговор с Эмили прервался без предупреждения. Сколько бы раз я ни пытался перезвонить, ответа не было.")
	await novel_interface.show_text_only("Меня охватило плохое предчувствие. Уровень преступности в этих трущобах уже по ночам зашкаливал, и время от времени здесь появлялись якобы экстремисты...")
	await novel_interface.show_text_only("Тётя Хайфа быстро выключила свет в коридоре и во всех комнатах. К счастью, дети уже спали.")
	await novel_interface.show_text_only("Когда она медленно закрыла тяжелую металлическую дверь приюта, волна страха внезапно поднялась в моей груди...")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Если бы я остался здесь, возможно, я никогда больше не увижу Эмили и остальных...")
	await novel_interface.show_text_only("Не знаю, откуда взялся этот импульс, но прежде чем дверь закрылась, я выскочил, оставив после себя быстрое «пойду посмотрю», и побежал вниз по лестнице.")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_SlumArea.png")
	await novel_interface.show_text_only("...")
	novel_interface.show_character("ren_medical","wry_smile")
	await novel_interface.show_dialog("(Почему я так опрометчиво бросился сюда...?)", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("В Масаде, возможно, и мягкий средиземноморский климат, но ночной ветер все еще ощущал прохладу в моих волосах, которые еще не полностью высохли.")
	await novel_interface.show_text_only("У бронемашины, припаркованной во дворе, были выключены внутренние и наружные фонари, но я заметил, что задний люк был закрыт лишь наполовину.")
	await novel_interface.show_text_only("Затаив дыхание, я подкрался к задней части машины и открыл люк ровно настолько, чтобы просунуть голову.")
	await novel_interface.show_text_only("Глядя на кромешную тьму кабины, я включил фонарик на телефоне...")
	await novel_interface.show_text_only("Внезапно в поле зрения появилось перевернутое лицо мужчины! Пена свисала из уголка его рта, а безжизненные зрачки смотрели прямо на меня!")
	await novel_interface.show_text_only("Я рефлекторно отпрыгнул назад, как испуганный олень, и телефон вылетел из моей руки.")
	await novel_interface.show_text_only("Прежде чем мои ноги коснулись земли, чья-то рука схватила меня сзади, а другая крепко зажала мне рот.")
	novel_interface.show_character("ren_medical","sob")
	await novel_interface.show_dialog("(Мммф--!)", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я смотрел, как мой телефон летел по дуге, но Эмили поймала его одной рукой, прежде чем он упал на землю, и плавно выключила фонарик.")
	novel_interface.show_character("emilio","smile")
	await novel_interface.show_dialog("(шепотом) Тсс! Это мы.", "Эмили")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Она беспомощно погладила мое перепуганное лицо и небрежно вытерла слезы, которые только что навернулись в уголках моих глаз.")
	novel_interface.show_character("valkyrja","happy")
	await novel_interface.show_dialog("Ты только что вышла из душа?\n(нюх-нюх) От тебя очень приятно пахнет~", "Вера")
	novel_interface.change_expression("wink")
	await novel_interface.show_dialog("Не издавай ни звука, понял?", "Вера")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Позади меня послышался дразнящий голос Веры. Только после того, как она увидела, что я послушно кивнул, она отпустила меня.")
	novel_interface.show_character("emilio","stare")
	await novel_interface.show_dialog("(шепотом) Посмотрите наружу.", "Эмили")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Следуя направлению, которое она указала, я выглянул через щель во дворовых воротах на улицу…")
	await novel_interface.show_text_only("Как только мои глаза привыкли к темноте, я быстро заметил шуршащие по улице тени.")
	novel_interface.show_character("emilio","stare")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_medical","stare",0.25)
	await novel_interface.show_dialog("(Это воры...? Нет, их слишком много.)", "Лиан")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("В поле моего зрения было четыре или пять мужчин в черном, окружавших два старых фургона, движущихся с неестественно медленной скоростью.")
	await novel_interface.show_text_only("У фургонов не было фар, даже стоп-сигналы были сняты. Водители старались работать двигателями как можно тише.")
	await novel_interface.show_text_only("Вскоре после того, как этот подозрительный конвой прошел, сзади подошла еще одна команда с точно такой же установкой.")
	await novel_interface.show_text_only("Вдалеке бездомный мужчина, шатаясь, вышел из хижины на углу улицы с бутылкой спиртного в руках, рыгнул и тупо уставился на темную улицу.")
	await novel_interface.show_text_only("Один из мужчин в черном подошел к пьяному, без колебаний свернул ему шею и быстро оттащил тело в тень на обочине.")
	novel_interface.show_character("emilio","stare")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("ren_medical","panic",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("--?!!", "Лиан")
	await novel_interface.show_dialog("Кто эти люди...?", "Лиан")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Это уже шестая команда, которую мы видим. Я только что тайно схватил одного, но прежде чем я успел его допросить, он проглотил яд и покончил с собой.", "Эмили")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Эмили указала на бронемашину, вероятно, имея в виду человека, которого я только что видела с пеной изо рта.")
	novel_interface.show_character("emilio","stare")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("ren_medical","panic",0.25)
	await novel_interface.show_dialog("За одежду у него был черный флаг с религиозными лозунгами. Обычно так поступают только экстремисты, совершающие теракты-смертники...", "Эмили")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Эмили глубоко нахмурилась. Ситуация явно вышла далеко за рамки того, что она ожидала.")
	novel_interface.show_character("ren_medical","panic")
	await novel_interface.show_dialog("S-атака террориста-смертника?", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я видел этот термин только в кино и зарубежных новостях. Я никогда не слышал, чтобы столько людей появлялось одновременно!")
	novel_interface.show_character("ren_medical","panic")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("emilio","stare",0.25)
	await novel_interface.show_dialog("У этих транспортных средств нет номеров и стоп-сигналов, поэтому они могут передвигаться только внутри трущоб, которые являются слепыми зонами в сети наблюдения. В любом другом месте дроны перехватили бы их почти сразу.", "Эмили")
	await novel_interface.show_dialog("Силы национальной обороны также проводят здесь случайные патрули в течение дня, так что я не думаю, что эти машины когда-либо были предназначены для того, чтобы вернуться целыми и невредимыми...", "Эмили")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0)
	await novel_interface.show_dialog("Д-Ты имеешь в виду...", "Лиан")
	await novel_interface.hide_character()
	novel_interface.show_character("emilio","angry")
	await novel_interface.show_dialog("Беспрецедентно масштабная атака террористов-смертников, которая, скорее всего, произойдет в ближайшие несколько часов.", "Эмили")
	await novel_interface.hide_character()
	novel_interface.show_character("valkyrja","speak")
	await novel_interface.show_dialog("Тот факт, что они подошли так близко к центру города, означает, что машины не перевозят радиоактивных материалов...", "Вера")
	await novel_interface.show_dialog("Под дорогами на многие километры вокруг Масады закопаны детекторы радиоактивных материалов.", "Вера")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Но если бы это был просто взрыв заминированного автомобиля, действительно ли им понадобилось бы такое количество людей?", "Вера")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","sob")
	await novel_interface.show_dialog("С-должны ли мы сообщить об этом первыми?", "Лиан")
	await novel_interface.hide_character()
	novel_interface.show_character("emilio","stare")
	await novel_interface.show_dialog("Электромагнитные сигналы поблизости сейчас глушатся. Я только что отправил код экстренной помощи из телефонной будки.", "Эмили")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Здесь еще есть такие старые вещи?")
	novel_interface.show_character("emilio","stare")
	await novel_interface.show_dialog("Сопротивление даже редко использует средства радиопомех на передовой. Я понятия не имею, кто эти люди...", "Эмили")
	await novel_interface.hide_character()
	novel_interface.show_character("valkyrja","angry")
	await novel_interface.show_dialog("Даже если армия и Монола бросятся к нам, это все равно займет у них не менее десяти минут. К тому времени этих людей уже давно не будет.", "Вера")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","stare")
	await novel_interface.show_dialog("Тогда стоит ли нам тихо следовать за ними?", "Лиан")
	await novel_interface.hide_character()
	novel_interface.show_character("emilio","speechless")
	await novel_interface.show_dialog("Это не поможет. Поскольку они действуют группами, то обязательно разделятся и спрячутся отдельно.", "Эмили")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Верно. Эти трущобы уже являются анклавом этнических меньшинств, а местные банды, говорящие на разных языках, смешались в полном хаосе.")
	await novel_interface.show_text_only("Мало того, что инфраструктура сильно разрушена, здесь также имеется множество скрытых зон, созданных незаконными постройками, которые не указаны ни на каких картах планирования.")
	await novel_interface.show_text_only("Правительство Масады всегда неоднозначно относилось к происходящему здесь беспорядку. В любом случае национальный бюджет уже много лет истощен, поэтому у них не было сил расчистить эту свалку.")
	novel_interface.show_character("ren_medical","worry")
	await novel_interface.show_dialog("Может ли это иметь какое-то отношение к завтрашнему соглашению о прекращении огня?", "Лиан")
	novel_interface.change_expression("wry_smile")
	await novel_interface.show_dialog("Ли... Я имею в виду, мой начальник упомянул о какой-то церемонии подписания завтра.", "Лиан")
	await novel_interface.hide_character()
	novel_interface.show_character("emilio","shout")
	await novel_interface.show_dialog("Ах! Во сколько завтра церемония?", "Эмили")
	await novel_interface.hide_character()
	novel_interface.show_character("valkyrja","panic")
	await novel_interface.show_dialog("Если я правильно помню, во внутреннем уведомлении говорилось, что время перенесено на шесть утра. Там будет много средств массовой информации, поэтому они хотели максимально избежать песчаной бури во время отснятого материала.", "Вера")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Нашим подписавшим представителем является генерал-майор Хамон. В интервью он даже сказал, что на церемонию наденет костюм вместо униформы.", "Вера")
	novel_interface.change_expression("speechless")
	await novel_interface.show_dialog("Эта большая жаба с таким же успехом могла бы просто объявить, что он баллотируется на выборах в следующем году. Его амбиции не могли быть более очевидными...", "Вера")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","wry_smile")
	await novel_interface.show_dialog("(...Жаба?)", "Лиан")
	await novel_interface.hide_character()
	novel_interface.show_character("emilio","stare")
	await novel_interface.show_dialog("Подожди... если это Хамон...", "Эмили")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Эмили, казалось, была очень знакома с генерал-майором. Она нахмурила брови и напряженно задумалась.")
	novel_interface.show_character("emilio","stare")
	await novel_interface.show_dialog("Если Хамон действительно намерен баллотироваться на пост премьер-министра, то с его личностью он, вероятно, подумает, что простая подпись и рукопожатие слишком слабы.", "Эмили")
	novel_interface.change_expression("shout")
	await novel_interface.show_dialog("Если он хочет, чтобы средства массовой информации увидели изменения, вызванные прекращением огня, более непосредственно, я предполагаю, что он одновременно обновит электронные протоколы защитного оружия искусственного интеллекта.", "Эмили")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","bored")
	await novel_interface.show_dialog("Что ты имеешь в виду...?", "Лиан")
	await novel_interface.hide_character()
	novel_interface.show_character("emilio","shout")
	await novel_interface.show_dialog("Если бы левые СМИ, присутствовавшие на месте событий, стали свидетелями того, как стаи дронов, которые весь год окружали Масаду, были разоружены и отступили, они, вероятно, разрыдались бы на месте.", "Эмили")
	await novel_interface.hide_character()
	novel_interface.show_character("valkyrja","wink")
	await novel_interface.show_dialog("Пффф--\nДа, я это вижу.", "Вера")
	novel_interface.change_expression("panic")
	await novel_interface.show_dialog("Подождите... Вы хотите сказать, что эти люди планируют нападение, пока система защиты Масады обновляет единый протокол!?", "Вера")
	await novel_interface.hide_character()
	novel_interface.show_character("emilio","stare")
	await novel_interface.show_dialog("Восемьдесят процентов защиты Масады опирается на оружие искусственного интеллекта. Система не была бы настолько глупой, чтобы отключить все сразу.", "Эмили")
	await novel_interface.show_dialog("Такое крупное обновление протокола будет производиться партиями по оборонному сектору...", "Эмили")
	novel_interface.change_expression("shout")
	await novel_interface.show_dialog("Верно. Где именно пройдет завтрашняя церемония подписания?", "Эмили")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","panic")
	await novel_interface.show_dialog("Я думаю, это какой-то конференц-центр на берегу Мертвого моря.", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Я вспомнил, как Мариру только что упомянула об этом по телефону...")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_ShelterOffice.png")
	await novel_interface.show_dialog("Они окончательно определили представителя Масады для завтрашнего подписания соглашения о прекращении огня. Это будет генерал-майор Хамон из Северного командования.", "Мариру")
	await novel_interface.show_dialog("По политическим причинам местом подписания был выбран Международный конференц-центр Масада на берегу Мертвого моря.", "Мариру")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_SlumArea.png")
	novel_interface.show_character("valkyrja","speak")
	await novel_interface.show_dialog("Международный конференц-центр Масады?\nЭто недалеко отсюда...", "Вера")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","solemn")
	await novel_interface.show_dialog("Они планируют напрямую атаковать это место?!", "Лиан")
	await novel_interface.hide_character()
	novel_interface.show_character("valkyrja","speechless")
	await novel_interface.show_dialog("Не смешите. Территория вокруг места проведения определенно будет находиться под строгим наблюдением Монолы, а Силы национальной обороны будут располагать повсюду тяжелым вооружением.", "Вера")
	await novel_interface.show_dialog("Если бы эти люди осмелились направиться в конференц-центр, их бы заметили за пять километров и немедленно истребили бы.", "Вера")
	await novel_interface.hide_character()
	novel_interface.show_character("emilio","stare")
	await novel_interface.show_dialog("Я помню, где на карте находится конференц-центр. Если бы я стоял в этом зале...", "Эмили")
	await novel_interface.show_dialog("Ближайшая изоляционная стена, которую я мог видеть, была бы на том участке перед нами, верно?", "Эмили")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я последовал жесту Эмили и посмотрел в том направлении. Дорога, уходящая вдаль, казалось, была почти перерезана высокой изоляционной стеной...")
	await novel_interface.show_text_only("За ним просачивались слабые отблески шумного центра города...")
	novel_interface.show_character("emilio","stare")
	await novel_interface.show_dialog("Это северо-восточная изолирующая стена центральной части города. Если это место не является их настоящей целью...", "Эмили")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Эмили и Вера замолчали. Судя по их выражениям лиц, я мог сказать, насколько плоха ситуация.")
	await novel_interface.show_text_only("Я посмотрел на потемневшее небо. Не было ни одной звезды.")
	novel_interface.show_character("ren_medical","worry")
	await novel_interface.show_dialog("(Небо... всегда было таким темным?)", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Тогда внутри меня вспыхнуло жуткое и зловещее чувство, которое я не мог выразить словами.")
