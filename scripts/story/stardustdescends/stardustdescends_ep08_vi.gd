# stardustdescends_ep08.gd - 星尘降临篇第8话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	stardustdescends_ep08_script()

func play_script():
	pass

func stardustdescends_ep08_script():
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Masada0.png")
	await novel_interface.show_text_only("Thành phố trường học thứ ba, Masadaburg.")
	await novel_interface.show_text_only("Một pháo đài quân sự được xây dựng trên sa mạc, nổi tiếng với bùn Biển Chết, bão cát và các cuộc tấn công khủng bố.")
	await novel_interface.show_text_only("Đối với hầu hết mọi người, bất kỳ tin tức nào về Masadaburg đều có nghĩa là xung đột quân sự hoặc thảm họa nhân đạo.")
	await novel_interface.show_text_only("Một khung cảnh nhuốm màu máu và cát, dầu thô và khói trắng, từ lâu đã treo lơ lửng trên vùng đất cổ xưa này...")
	await novel_interface.show_text_only("Mọi người sống ở đó kiểu cuộc sống như thế nào?\nTôi hoàn toàn không biết...")
	await novel_interface.show_text_only("Tuy nhiên, nó cũng có cảm giác quen thuộc một cách kỳ lạ, như thể tôi đã từng ở đó vậy...")
	await novel_interface.hide_background()
	await novel_interface.show_dialog("Thở dài──", "Lian")
	novel_interface.change_music("res://assets/audio/music/unkown/UI_Main_Funk.mp3")
	novel_interface.show_background("res://assets/images/bg/Stardust/Vessel.png")
	await novel_interface.show_text_only("Tôi dựa vào lan can boong trong khi Stardust bám chặt vào tôi như một con gấu túi, nước mắt vẫn long lanh trên mắt.")
	novel_interface.show_character("ren_full","wry_smile")
	await novel_interface.show_dialog("Được rồi, được rồi. Tôi chỉ đùa thôi──", "Lian")
	novel_interface.change_expression("wail")
	await novel_interface.show_dialog("Này, dễ thôi. Móng tay của bạn đang cắm sâu vào da thịt của tôi...", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("stardust_small","tear",0.25)
	await novel_interface.show_dialog("Đánh hơi...", "Stardust")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Đ-Đừng lau mũi vào quần áo của tôi!!!", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Tôi bất lực thở dài và xoa đầu cô ấy để giúp cô ấy bình tĩnh lại.")
	await novel_interface.show_text_only("Lúc trước Aya đoán hướng Stardust chỉ là Masadaburg, nhưng sau khi hỏi xung quanh, hóa ra cô gái đó không biết tên địa điểm đó nghĩa là gì.")
	await novel_interface.show_text_only("Hay đúng hơn, cô ấy thậm chí còn không hiểu khái niệm \"thành phố trường học\"...")
	await novel_interface.show_text_only("Mariru nói rằng cô ấy sẽ sắp xếp thông tin trước và bảo tôi đợi trên boong cho đến khi cô ấy liên lạc lại với tôi.")
	await novel_interface.show_text_only("Tôi vẫn không thể chấp nhận rằng cô gái này chỉ là ảo ảnh mà chỉ tôi mới có thể nhìn thấy, nên tôi nhân cơ hội này thực hiện thêm một vài thử nghiệm──")
	await novel_interface.show_text_only("Đầu tiên, tôi đặt điện thoại xuống đất và nhờ cô ấy nhặt nó lên.")
	await novel_interface.show_text_only("Thay vào đó, cô ấy chỉ nở một nụ cười lịch sự với tôi, nghiêng đầu và nhìn tôi như thể \"Anh ngốc à?\"")
	await novel_interface.show_text_only("Sau khoảng ba mươi giây bế tắc, tôi chỉ có thể lúng túng nhấc điện thoại của mình lên, và rồi một ý tưởng thậm chí còn ngu ngốc hơn nảy ra trong đầu tôi──")
	await novel_interface.show_text_only("\"Nếu cô ấy không có cơ thể vật lý, liệu cô ấy có thể đi xuyên tường không?\"")
	await novel_interface.show_text_only("Vì vậy, trong khi cô ấy quan sát, tôi quay trở lại cabin, khóa cửa dẫn lên boong và trốn vào điểm mù của cô ấy.")
	await novel_interface.show_text_only("Hai phút sau, tôi nghe thấy tiếng nức nở khe khẽ ở phía bên kia. Cảm thấy rắc rối, tôi vội vàng mở cửa thì cô ấy tóm lấy đùi tôi không chịu buông ra.")
	await novel_interface.show_text_only("Để tránh những người phục vụ thỉnh thoảng đi qua cabin, tôi cố gắng kéo cô ấy lại bên lan can.")
	novel_interface.show_character("ren_full","wail")
	await novel_interface.show_dialog("(Với phụ kiện chân này được gắn vào, tôi khó có thể đi lại được...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Chăm sóc một đứa trẻ luôn mệt mỏi thế này sao!?")
	await novel_interface.show_text_only("Tệ hơn nữa, không ai khác có thể nhìn thấy cô ấy. Lúc này chắc tôi trông giống như một kẻ mất trí nào đó đang lẩm bẩm một mình và di chuyển xung quanh một cách kỳ lạ.")
	await novel_interface.show_text_only("Vì thực sự không có câu trả lời nào cho sự đeo bám của cô ấy nên tôi chỉ có thể nhẹ nhàng dỗ dành cô ấy.")
	novel_interface.show_character("ren_full","wry_smile")
	await novel_interface.show_dialog("Đó, đó. Anh sẽ không bỏ em lại đâu~", "Lian")
	novel_interface.change_expression("gratified")
	await novel_interface.show_dialog("Đó là điều xấu của tôi vừa rồi. Tôi sẽ xin lỗi, được chứ?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Tôi nói thế trong khi làm bộ mặt ngớ ngẩn với cô ấy.")
	await novel_interface.show_text_only("Nếu có ai nhìn thấy tôi nhăn mặt giữa không trung, tôi sẽ muốn bò thẳng vào một khe nứt trên boong tàu.")
	await novel_interface.show_text_only("Stardust bình tĩnh lại một chút. Vẫn đang ôm tôi, cô ấy ngước lên, chớp đôi mắt to, khuyên tai trên đầu lóe lên.")
	novel_interface.show_character("stardust_small","tear")
	await novel_interface.show_dialog("Vậy hãy hứa với tôi là bạn sẽ đi theo hướng đó với tôi nhé, được chứ...?", "Stardust")
	await novel_interface.show_dialog("Nó thực sự, thực sự quan trọng...", "Stardust")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("...")
	await novel_interface.show_text_only("Vừa nãy cậu không giả vờ khóc đấy chứ?")
	novel_interface.show_character("ren_full","upset")
	await novel_interface.show_dialog("(Trẻ con thực sự là một số ít...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Tôi không biết liệu Mariru có đồng ý cho tôi mang con tagalong nhỏ bé này đến một nơi nguy hiểm đến thế không.")
	await novel_interface.show_text_only("Ngay lúc đó, tai nghe của tôi rung lên và Mariru quay trở lại đường dây.")
	await novel_interface.show_dialog("Lian, Annie, hai bạn biết bao nhiêu về Masadaburg?", "Mariru")
	novel_interface.show_character("ren_full","worry")
	await novel_interface.show_dialog("Ừm...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Đại khái...", "Annie")
	await novel_interface.show_text_only("Tôi đã cố gắng hết sức để nhớ, nhưng ngay cả trong quá trình đào tạo đặc vụ SID, thông tin về Masadaburg đã bị rời rạc.")
	await novel_interface.show_dialog("Thành phố Trường học thứ ba, một thành phố pháo đài ở trung tâm Tây Á, được chia thành các quận trong và ngoài bởi bức tường biệt lập cao hàng chục mét.", "Annie")
	novel_interface.show_character("ren_full","bored")
	await novel_interface.show_dialog("Tôi nghĩ đó là do xung đột sắc tộc, tôn giáo hay gì đó?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Dù sao đi nữa, khu vực ngoại ô của Masadaburg có vẻ nguy hiểm. Nghe như có một hoặc hai vụ đánh bom mỗi tháng!")
	await novel_interface.show_dialog("Cơ quan tình báo của họ, Cục Sứ mệnh Phục hồi Masada, do quân đội trực tiếp kiểm soát và có phong cách táo bạo, cấp tiến.", "Annie")
	novel_interface.show_character("ren_full","happy")
	await novel_interface.show_dialog("À, tôi biết điều đó. Công ty đó còn có tên là \"Monola\" phải không?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Đó là cái tên luôn xuất hiện trong các bộ phim và trò chơi, mặc dù hiếm khi là phe chính.")
	novel_interface.show_character("ren_full","smile")
	await novel_interface.show_dialog("Đúng vậy, vũ khí của họ cũng rất tiên tiến. Trong trò chơi, Masada thường là bên cung cấp cho người chơi xe tăng và máy bay không người lái điều khiển từ xa...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Được rồi, thế là đủ──", "Mariru")
	await novel_interface.show_dialog("Môi trường địa chính trị ở khu vực đó luôn phức tạp, một khi cộng thêm lực lượng kháng chiến và các nhóm ly khai thì tình hình càng trở nên hỗn loạn hơn.", "Mariru")
	await novel_interface.show_dialog("Nhưng chỉ nói về \"quận nội thành\" của Masadaburg, an ninh của nó không tệ hơn New Toyosu, vì vậy──", "Mariru")
	novel_interface.show_character("ren_full","perspire1")
	await novel_interface.show_dialog("Hả? Đừng nói với tôi là...\nBạn đã đồng ý rồi à?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Vẫn quấn quanh đùi tôi, Stardust quằn quại vui vẻ.")
	await novel_interface.show_dialog("Chỉ có hai chúng ta... anh có chắc là chúng ta sẽ ổn không?", "Annie")
	await novel_interface.show_text_only("Ba. Ba chúng ta!!\nĐừng quên có thêm hành lý ở đây!!")
	await novel_interface.show_dialog("Đây không phải là một nhiệm vụ gián điệp. Chúng tôi thậm chí còn chưa biết điểm đến chính xác của mình. Miễn là bạn không làm điều gì quá đáng thì sẽ ổn thôi.", "Mariru")
	await novel_interface.show_dialog("Ngoài ra, bạn thậm chí sẽ không cần phải đổi tàu. Con tàu sòng bạc này sẽ cập cảng Masada vào sáng mai~", "Aya")
	await novel_interface.show_dialog("...Chuyện gì đang xảy ra vậy? Không phải chúng ta đang hướng tới Samonton sao?", "Annie")
	await novel_interface.show_dialog("Masada chuẩn bị ký thỏa thuận ngừng bắn với quân kháng chiến trong ba ngày, và cho đến khi buổi lễ kết thúc, kênh đào Suez sẽ hoàn toàn bị phong tỏa.", "Mariru")
	await novel_interface.show_dialog("Vì sự an toàn của hành khách, sòng bạc vừa quyết định làm theo \"khuyến nghị mạnh mẽ\" của quân đội Masada và quay trở lại Eilat.", "Mariru")
	await novel_interface.show_dialog("Con tàu này sẽ đi về phía bắc dọc theo Kênh đào lớn Biển Đỏ-Biển Chết, cập cảng Masada và ở đó cho đến khi lệnh phong tỏa Kênh Suez được dỡ bỏ.", "Mariru")
	await novel_interface.show_dialog("Danh tính bìa của Annie là một sinh viên trong chương trình trao đổi nghệ thuật New Toyosu. Giấy tờ đã xong rồi.", "Mariru")
	await novel_interface.show_dialog("Về phần bạn, Lian── Lực lượng bảo vệ bờ biển của Masada có thể đã đăng ký danh tính vỏ bọc của bạn, vì vậy hãy tiếp tục làm y tá nhỏ nhé~", "Mariru")
	await novel_interface.show_text_only("Có một nụ cười trong giọng nói của Mariru khiến tôi có chút lo lắng.")
	novel_interface.show_character("ren_full","panic")
	await novel_interface.show_dialog("Hả???", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Trong mọi trường hợp, bạn không thể di chuyển cho đến khi thỏa thuận được ký kết, vì vậy hãy dành hai ngày tiếp theo để tham quan thành phố~", "Aya")
	await novel_interface.show_dialog("Nếu nơi cô gái muốn đến nằm ngoài thành phố, tôi sẽ sai đồn tình báo địa phương cử người đến hỗ trợ anh trong ba ngày.", "Mariru")
	novel_interface.show_character("ren_full","panic")
	await novel_interface.show_dialog("Ngay cả kênh đào Suez cũng bị phong tỏa...", "Lian")
	await novel_interface.show_dialog("Chỉ cần ký một thỏa thuận... họ có thực sự cần phải đi xa đến thế không?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.stop_music()
	await novel_interface.show_dialog("Đó là bởi vì...", "Aya")
	await novel_interface.show_dialog("Bởi vì mọi chuyện đã nghiêm trọng rồi──", "Aya")
	await novel_interface.show_dialog("Hai người đã ở trên tàu suốt thời gian qua nên vẫn chưa biết phải không?", "Mariru")
	await novel_interface.show_dialog("C-Chuyện gì đã xảy ra vậy...?", "Annie")
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("Hơn mười giờ trước, một vụ nổ liên quan đến hóa chất công nghiệp đã xảy ra gần Nhà thờ Hồi giáo Ibra ở Hebron, thuộc lãnh thổ Masada.", "Mariru")
	await novel_interface.show_dialog("Sóng nổ đã gây ra sự sụp đổ một phần của các tòa nhà gần đó và làm hư hỏng hệ thống điện, nước và khí đốt của địa phương.", "Mariru")
	await novel_interface.show_dialog("Theo tuyên bố chính thức, tất cả cư dân trong khu vực đó đã được sơ tán đến vùng an toàn.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Lại một vụ tấn công khủng bố nữa?", "Lian")
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("Bên dưới Nhà thờ Hồi giáo Ibra là Hang Machpelah, được cho là nơi chôn cất tổ tiên của người Masadan.", "Aya")
	await novel_interface.show_dialog("Mặc dù kể từ khi họ tiếp quản thành phố đó vào thế kỷ trước, họ chưa bao giờ tiến hành bất kỳ cuộc khai quật khảo cổ nào ở đó...", "Aya")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("Điều kỳ lạ là mặc dù báo cáo thương vong chính thức là hợp lý nhưng việc phong tỏa thông tin lại quá chặt chẽ...", "Aya")
	await novel_interface.show_dialog("Bạn thậm chí không thể tìm thấy video do cư dân gần đó quay trực tuyến. Mọi trang tin tức về vụ việc này đều sử dụng hình ảnh và video do quan chức Masada cung cấp.", "Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","serious")
	await novel_interface.show_dialog("Đồng thời, hệ thống điện tử của một số bệnh viện lớn ở Hebron đều gặp trục trặc và một số lượng lớn hồ sơ cấp cứu bị mất.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("Sau vụ tai nạn, Masada gần như ngay lập tức từ chối lời đề nghị giúp bảo tồn di tích Hang Machpelah của Tổ chức Di sản Thế giới.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Mức độ kiểm soát thông tin trắng trợn đó thực sự nghe giống Monola... nhưng tại sao họ lại chặn thông tin?", "Annie")
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("Có lẽ là vì họ không muốn tình hình trở nên phức tạp hơn──", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Phân tích hình ảnh vệ tinh cho thấy vụ nổ rất có thể do một tên lửa nhỏ gây ra.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Quân kháng chiến?\nNhưng không phải họ sắp ký lệnh ngừng bắn sao...?", "Lian")
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("Thủ lĩnh kháng chiến ngay lập tức đăng tải lên mạng xã hội rằng vụ việc không liên quan gì đến họ, đồng thời bày tỏ sự hối tiếc và lên án.", "Aya")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("Hiện tại, đội tình báo nghi ngờ cuộc tấn công có thể được thực hiện bởi một số phe phái nhỏ trong quân kháng chiến. Những người đó chưa bao giờ là một khối thống nhất~", "Aya")
	await novel_interface.show_dialog("Ngay cả khi người lãnh đạo muốn ngừng bắn, những người theo đường lối cứng rắn bên trong cũng không muốn thỏa thuận xảy ra, phải không?", "Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("Có lẽ. Nhưng tất cả những điều đó vẫn chỉ là suy đoán. Điều không phải suy đoán là ba ngày tới là khoảng thời gian nhạy cảm nhất mà Thành phố Trường học thứ ba có thể phải đối mặt──", "Mariru")
