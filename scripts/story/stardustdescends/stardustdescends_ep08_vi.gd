	await novel_interface.show_text_only("Annie và tôi nhìn chằm chằm vào vật thể dị thường ở phía xa, ngơ ngác, trong khi Stardust nói mà không hề ngẩng đầu lên──")
	await novel_interface.show_dialog("Bão cát.", "Stardust")

	print("=== 星尘降临篇第8话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
