	await novel_interface.show_dialog("Chiunque scommette tutto ciò che ha è quel tipo di sciocco.", "Nix")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("È duro!", "Lian")
	await novel_interface.show_text_only("Lian trema in modo incontrollabile.")
	await novel_interface.show_text_only("Nix beve un sorso di tè, poi prosegue.")
	novel_interface.show_character("nyx_normal","mock")
	await novel_interface.show_dialog("Ascolta, il Texas Hold 'em è un gioco a turni.", "Nix")
	await novel_interface.show_dialog("Ciò che conta di più non sono le tue carte, ma piuttosto i tuoi avversari.", "Nix")
	await novel_interface.hide_character()
