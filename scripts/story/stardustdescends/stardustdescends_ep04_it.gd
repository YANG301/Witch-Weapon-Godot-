	await novel_interface.show_dialog("Signorina?", "Croupier")
	novel_interface.show_character("ren_full","panic")
	await novel_interface.show_dialog("E' il mio turno?", "Lian")
	await novel_interface.show_dialog("F- Piega...", "Lian")
