	await novel_interface.show_text_only("È probabilmente l'obbligazione al portatore con il valore più alto.")
	await novel_interface.show_dialog("Abbiamo sequestrato tutte le loro telecamere di sorveglianza. È un tentativo ogni volta che sei pronto! ", "Annie")
	await novel_interface.show_text_only("Finalmente una buona notizia!")

	print("=== 星尘降临篇第4话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
