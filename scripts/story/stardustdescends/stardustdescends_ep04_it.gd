	await novel_interface.show_dialog("Non preoccuparti. Le due guardie stanno facendo un dolce sogno mentre parliamo.", "Aya")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("Non sottovalutare il cervello umano: è disposto e capace di razionalizzare le situazioni in cui si trova.", "Aya")
