	await novel_interface.show_dialog("(R- Raid?!...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Le telecamere sono ovunque su questa nave. Se qualcuno nota il tuo microauricolare, verrai gettato in pasto agli squali.", "Nix")
	await novel_interface.show_text_only("Sento brividi lungo la schiena. Tiro fuori in fretta il telefono.")
	novel_interface.show_character("ren_full","upset")
	await novel_interface.show_dialog("Ho già perso il 20% di quello che ho portato. Non hai detto che dovevo raddoppiare i miei soldi prima di poter entrare nella sala VIP?", "Lian")
