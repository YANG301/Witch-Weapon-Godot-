	await novel_interface.show_dialog("(abbassa la voce). Soprattutto dopo che avevo già scommesso così tanti soldi...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("La voce bassa di Lian non riesce a nascondere la sua delusione.")
