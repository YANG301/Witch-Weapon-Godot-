	await novel_interface.show_dialog("Si sentiranno liberi solo dopo aver scommesso tutto quello che avevano.", "Nix")
	await novel_interface.show_dialog("Il risultato è che il suo avversario può facilmente prevedere la sua decisione dal suo comportamento.", "Nix")
	novel_interface.change_expression("normal2")
