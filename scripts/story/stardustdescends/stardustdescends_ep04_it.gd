	await novel_interface.show_dialog("...Ricordami ancora quanto è grande un'unità YB?", "Mariru")
	novel_interface.show_character("ai","blush_dizzy")
	await novel_interface.show_dialog("Uno yottabyte è 10 alla 24esima potenza byte, più di tutti i dati presenti su Internet prima della guerra messi insieme...", "Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("La voce di Aya trema per l'eccitazione.")
	novel_interface.show_character("ai","blush_dizzy")
	await novel_interface.show_dialog("E pensavo che il suo cervello fosse buono solo per i giochi...", "Aya")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Yottabyte. Penso di averlo visto nel rapporto del professor Shih!", "Mariru")
	novel_interface.show_character("ai","blush_stare")
