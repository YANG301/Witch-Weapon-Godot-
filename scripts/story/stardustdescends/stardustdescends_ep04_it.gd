	await novel_interface.show_text_only("Aya si guarda di nuovo intorno nella stanza. Due uomini vestiti di nero sono distesi su un paio di dispositivi Mind Diving.")
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Dopotutto, è più probabile che le persone credano alle bugie che mettono insieme da sole...", "Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("All'improvviso, qualcosa sul tablet di Aya attira la sua attenzione. Scorre rapidamente diverse pagine verso il basso, quindi torna ai dati interessanti.")
