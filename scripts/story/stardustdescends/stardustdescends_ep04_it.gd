	await novel_interface.show_text_only("A trentamila metri di altezza, a bordo di un trasporto pesante ad alta velocità SID, Nix osserva lo schermo di proiezione con una tazza di tè in mano.")
	novel_interface.show_character("nyx_normal","normal1")
	await novel_interface.show_dialog("Avevi solo il 2 e il 6 di quadri. A giudicare dal suo comportamento, c'era un'alta probabilità che anche lui avesse un colore, e le sue carte erano quasi certamente più alte delle tue.", "Nix")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Sul serio?!\nStavo per andare all in...", "Lian")
	novel_interface.show_character("nyx_normal","speak")
	await novel_interface.show_dialog("*sospiro*", "Nix")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Non ha idea di come spiegarlo chiaramente a Lian, la stessa ragazza che ieri sera si è addormentata sbavando su un mucchio di fiches da cinquanta milioni.")
	novel_interface.show_character("nyx_normal","normal2")
	await novel_interface.show_dialog("L'errore più comune commesso da un principiante è che ogni volta che ha una buona mano, vuole scommettere molto, anche andare all-in.", "Nix")
