# stardustdescends_ep16.gd - 星尘降临篇第16话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	stardustdescends_ep16_script()

func play_script():
	pass

func stardustdescends_ep16_script():
	novel_interface.change_music("res://assets/audio/music/Sunset.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_ShelterOffice.png")
	novel_interface.show_character("ren_medical","gratified")
	await novel_interface.show_dialog("Сколько у вас здесь детей?", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("— спросил я задумавшуюся тетю Хайфу.")
	await novel_interface.show_dialog("Тридцать два. Все они сироты из поселка, не старше десяти лет.", "Хайфа")
	await novel_interface.show_dialog("Это все, что я могу сделать, и даже тогда мне все равно нужны социальные работники, чтобы помочь в течение дня... эх...", "Хайфа")
	await novel_interface.show_dialog("В близлежащих трущобах есть еще сотни таких детей. Детские учреждения Масады получают так мало финансирования, что едва могут продолжать работу.", "Хайфа")
	await novel_interface.show_text_only("Как и сказала Мариру, как только окружающие ресурсы будут полностью разграблены, даже такое место, как Масада, с такой огромной армией, не сможет существовать вечно...")
	novel_interface.show_character("ren_medical","worry")
	await novel_interface.show_dialog("Неужели нет никого, кто мог бы помочь этим сиротам? Разве Масада не всегда держит свои двери открытыми для НПО...?", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Раньше приходили какие-то люди в белых касках, но они просто сфотографировали каких-то детей-инвалидов и ушли...", "Хайфа")
	await novel_interface.show_dialog("Я едва могу идти в ногу со временем. Даже такие домашние дела, как уборка, зависят от помощи старших детей. Я так много могу сделать...", "Хайфа")
	novel_interface.show_character("ren_medical","smile")
	await novel_interface.show_dialog("Не говори так! Я уверен, что все дети невероятно вам благодарны...\nТо есть, даже я...", "Лиан")
	await novel_interface.show_dialog("В любом случае, для таких детей, как они, очень важно иметь семью!", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Она удивленно посмотрела на меня, а затем добродушно улыбнулась.")
	await novel_interface.show_dialog("Какой хороший ребенок. Ты не отсюда, Лиан?", "Хайфа")
	await novel_interface.show_dialog("Эмили сказала, что ты останешься здесь сегодня вечером и уедешь завтра утром?", "Хайфа")
	novel_interface.show_character("ren_medical","gratified")
	await novel_interface.show_dialog("Мм. Похоже, сегодня вечером в центре города объявлено военное положение, потому что завтра они подписывают соглашение о прекращении огня с сопротивлением... Извините, что навязываю!", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Все в порядке, все в порядке. Сначала я пойду приготовлю ванну.", "Хайфа")
	await novel_interface.show_text_only("Тетя Хайфа встала и подошла к двери, что-то бормоча про себя.")
	await novel_interface.show_dialog("Эх... Неужели столько ненависти можно стереть одним листком бумаги...", "Хайфа")
	await novel_interface.stop_music()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("..............")
	await novel_interface.show_text_only("...")
	await novel_interface.show_text_only("SID Командный зал.")
	novel_interface.change_music("res://assets/audio/music/Normal Stage.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	await novel_interface.show_text_only("Мариру вошла в командную рубку, зевая и неся две чашки кофе, и обнаружила, что Ая все еще работает за главной консолью.")
	novel_interface.show_character("liliu_uniform1","normal2")
	await novel_interface.show_dialog("Нечасто вы добровольно соглашаетесь на такую унылую разведывательную работу.", "Мариру")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","wink")
	await novel_interface.show_dialog("Потому что цель интересная~", "Ая")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Мариру поставила карамельный маккиато на стол рядом с Аей, и Ая сделала глоток.")
	novel_interface.show_character("liliu_uniform1","normal2")
	await novel_interface.show_dialog("Неужели это нормально - выпить что-нибудь такое сладкое посреди ночи...?", "Мариру")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Мой мозг все равно сожжет сахар. И я нашел прорыв.", "Ая")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform1","normal1",0.25)
	await novel_interface.show_dialog("Нашли инсайдера?", "Мариру")
	novel_interface.character_light(0.35,"normal")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Нет. Учитывая уровень шифрования проекта 0812, полную картину должны знать менее десяти человек, и я не могу найти ни одного из них.", "Ая")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"sigh")
	await novel_interface.show_dialog("Верно. Зная стиль Палантира, они не могли позволить столь ценной цели ускользнуть...", "Мариру")
	novel_interface.character_light(0.35,"stare")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Поэтому вместо этого я поменял подходы...", "Ая")
	await novel_interface.show_dialog("Любой космический корабль, использующий гетерогенную материю, должен был бы стать вершиной промышленного и технологического потенциала страны.", "Ая")
	await novel_interface.show_dialog("В его проектировании, исследованиях и разработках, производстве и транспортировке было бы задействовано как минимум несколько тысяч человек.", "Ая")
	novel_interface.change_expression("think")
	await novel_interface.show_dialog("А после того, как федеральное правительство рухнуло, соответствующие законы о секретности перестали применяться, так что...", "Ая")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Вы планируете анализировать общедоступную информацию в Интернете?\nБольшая часть ее, должно быть, мусор, верно...?", "Мариру")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Айя пожал плечами.")
	novel_interface.show_character("ai","normal")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("liliu_uniform1","sigh",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Поначалу некоторые бывшие инсайдеры сливали информацию только для того, чтобы заработать деньги... людям, естественно, были интересны подобные истории.", "Ая")
	await novel_interface.show_dialog("Затем нагрянули компании интернет-маркетинга, набросали сенсационные заголовки на эти сырые обрывки информации и дополнили их всевозможными украшениями.", "Ая")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("До того, как общественность устала от кликбейта и фейковых новостей, существовало более шести миллионов общедоступных сведений, касающихся секретов НАСА.", "Ая")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("Я так и предполагал...", "Мариру")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Мариру беспомощно потерла виски, а Ая скорчила ей рожу.")
	novel_interface.show_character("ai","stare")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("liliu_uniform1","normal1",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Но если вы используете ИИ для семантической декомпозиции и отслеживания источников, тогда фильтруйте информацию с ортогональной достоверностью выше 90%...", "Ая")
	novel_interface.change_expression("wink")
	await novel_interface.show_dialog("Вы получаете гораздо больше материала, чем ожидали~", "Ая")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Ая постучал по клавиатуре, и мгновенно появился экран с данными. Мариру сразу оживилась.")
	novel_interface.show_character("ai","normal")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("liliu_uniform1","normal1",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Проект 0812 имеет полную массу от 30 до 50 тонн. Одно только оптическое оборудование весит 5 тонн и не имеет никаких систем жизнеобеспечения.", "Ая")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("При такой массе это точно не спутник... Беспилотная космическая станция?", "Мариру")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Возможно. Корабль имеет две двигательные установки и может менять орбиту на высоте от 660 километров над Землей до 36 000 километров.", "Ая")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("Один из них — ионный двигатель, способный обеспечить стабильное ускорение в космосе в течение длительного времени, с расчетным сроком службы тридцать лет.", "Ая")
	novel_interface.change_expression("normal") 
	await novel_interface.show_dialog("Другой — обычный ракетный двигатель, который может обеспечить возвратную посадку на Землю, и на его долю приходится почти половина массы системы.", "Ая")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"serious")
	await novel_interface.show_dialog("Задержаться в космосе так долго и постоянно корректировать свое орбитальное положение... Было ли это предназначено для того, чтобы продолжать нацеливаться на источник сигнала, находящийся на расстоянии 400 световых лет?", "Мариру")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("И тот факт, что их можно восстановить, предполагает, что объем данных слишком велик для передачи по беспроводной сети...", "Ая")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("О каком объеме информации мы говорим...?", "Мариру")
	novel_interface.change_2nd_expression("normal1")
	await novel_interface.show_dialog("Сможете ли вы найти этот спутник?", "Мариру")
	novel_interface.character_light(0.35,"think")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Что-то столь большое невозможно было бы скрыть от Сентинела, но оно не появляется ни на одной орбите...", "Ая")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Sentinel — это система мониторинга астероидов, верно?", "Мариру")
	novel_interface.character_light(0.35,"normal")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Да. Согласно записям, последний раз космический корабль, соответствующий этим характеристикам, менял орбиту около года назад.", "Ая")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Итак, в этот момент... контрольный ключ был продан на черном рынке?", "Мариру")
	novel_interface.character_light(0.35,"wink")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Понятия не имею. Если бы ты хотел спрятать что-то такое большое, может быть, ты бы спрятал это за луной?", "Ая")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"sigh")
	await novel_interface.show_dialog("Кстати... когда ты написал такой ИИ?", "Мариру")
	novel_interface.character_light(0.35,"think")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Я не мог написать что-то подобное. Модель и параметры были загружены позавчера аккаунтом Elder Seven.", "Ая")
	novel_interface.change_expression("wink")
	await novel_interface.show_dialog("Форумы сообщества открытого исходного кода в последние несколько дней бурно обсуждают эту тему~", "Ая")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("Что в нем такого особенного?", "Мариру")
	novel_interface.character_light(0.35,"normal")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Этот человек тоже опубликовал алгоритм. По приблизительным оценкам, обучение ИИ до такого уровня потребует вычислительных ресурсов на сумму более миллиарда долларов.", "Ая")
	await novel_interface.show_dialog("И код такого масштаба определенно не мог быть написан одним человеком.", "Ая")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("Какая организация выпустит в открытый доступ что-то настолько ценное...? Вы его правильно изолировали?", "Мариру")
	novel_interface.character_light(0.35,"wink")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Конечно. Я запускал все внутри виртуальной машины Themis.", "Ая")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Эта модель может быстро архивировать огромные объемы аналогичной информации и оценивать корреляции между ними.", "Ая")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("В то же время он оценивает надежность каждого элемента на основе того, насколько ортогональны различные источники.", "Ая")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"jest")
	await novel_interface.show_dialog("Звучит полезно. Значит, у этих сомнительных маркетинговых фирм проблемы?", "Мариру")
	novel_interface.character_light(0.35,"blush_think")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Так я сначала подумал. Но подумайте вот о чем: если вы подключили его к достаточно большой базе данных...", "Ая")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Выражение лица Мариру внезапно стало серьезным...")
	novel_interface.show_character("ai","blush_think")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("liliu_uniform1","serious",0.25)
	await novel_interface.show_dialog("Типа системы наблюдения государственной безопасности...?", "Мариру")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Точно. В сочетании с распознаванием изображений он может профилировать и классифицировать всех, а затем делать выводы о том, как они связаны.")
	await novel_interface.show_text_only("Он также может использовать эту информацию для определения целей цели и прогнозирования поведения людей, а может быть, даже целенаправленно управлять ими...")
	await novel_interface.show_text_only("Мариру покачала головой. Сейчас не время отвлекать их внимание.")
	novel_interface.show_character("ai","blush_think")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("liliu_uniform1","sigh",0.25)
	await novel_interface.show_dialog("Мы можем поговорить об этом ИИ позже.", "Мариру")
	novel_interface.change_2nd_expression("normal1")
	await novel_interface.show_dialog("Они окончательно определили представителя Масады для завтрашнего подписания соглашения о прекращении огня. Это будет генерал-майор Хамон из Северного командования.", "Мариру")
	await novel_interface.show_dialog("По политическим причинам местом подписания был выбран Международный конференц-центр Масада на берегу Мертвого моря.", "Мариру")
	novel_interface.character_light(0.35,"think")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Имеет смысл. Перемирие, подписанное за изоляционной стеной, никогда никого не убедит.", "Ая")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("Какие люди вообще участвуют в сопротивлении? Раньше я никогда не обращал особого внимания.", "Ая")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("Конечно, нет~", "Мариру")
	await novel_interface.show_dialog("Сначала это была коалиция местных этнических ополченцев, экстремистских религиозных группировок, остатков армии после падения правительства и бродячих бандитов.", "Мариру")
	await novel_interface.show_dialog("Все это были вооруженные группировки, ненавидевшие Масаду и говорящие между собой на семи или восьми местных языках. Обычно их следовало уничтожить отдельно...", "Мариру")
	novel_interface.character_light(0.35,"normal")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Какой человек мог организовать такую кучу?", "Ая")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("Валид Мушар, человек, который завтра подпишет соглашение от имени сопротивления.", "Мариру")
	await novel_interface.show_dialog("Даже после многих лет охоты со стороны Сил национальной обороны, оснащенных на два поколения впереди них, ему все же удавалось увеличивать сопротивление все больше и больше.", "Мариру")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Айя вывел на экран файл Валида Мушара.")
	novel_interface.show_character("ai","dizzy")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("liliu_uniform1","normal1",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("...У него действительно есть докторская степень!?", "Ая")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Да. Человек, который когда-то получил самую высокую награду в мире, является доктором наук по физике из Университета Бен-Гуриона.", "Мариру")
	novel_interface.change_2nd_expression("serious")
	await novel_interface.show_dialog("Говорят, что после разрушения Священного города масаданцы в такой ярости, что потеряли всякий рассудок, вытащили жену и дочь из дома в Беэр-Шеве на улицу...", "Мариру")
	novel_interface.character_light(0.35,"think")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Всеобщая этническая ненависть?\nЛюди действительно безнадежно глупые животные...", "Ая")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Мариру слегка ударила Аю по голове. Ая рефлекторно сжала шею и обнаружила, что Мариру на этот раз не применила много силы.")
	novel_interface.show_character("ai","think")
