# stardustdescends_ep01.gd - 星尘降临篇第1话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	stardustdescends_ep01_script()

func play_script():
	pass

func stardustdescends_ep01_script():
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_Prisoner.png")
	await novel_interface.show_text_only("Você provavelmente já ouviu esta história clássica...")
	await novel_interface.show_text_only("Os objetos de valor de um homem rico foram roubados. A polícia encontrou o produto do roubo num quarto compartilhado por dois suspeitos, mas não tinha provas suficientes para condenar nenhum dos dois.")
	await novel_interface.show_text_only("Então a polícia separou os dois suspeitos e lhes apresentou a seguinte escolha:")
	await novel_interface.show_text_only("Se um confessar e o outro ficar em silêncio, o primeiro sai em liberdade e o segundo pega dez anos de prisão.")
	await novel_interface.show_text_only("Se ambos permanecerem calados, cada um recebe seis meses. Mas, se ambos confessarem, cada um recebe cinco anos.")
	await novel_interface.show_text_only("Para as duas pessoas dessa história, o resultado que mais beneficiaria as duas sempre fica fora de alcance.")
	await novel_interface.show_text_only("Porque, quer o outro lado fique calado ou confesse, confessar sempre leva a um resultado melhor. A confissão se torna a estratégia dominante.")
	novel_interface.hide_background()
	await novel_interface.show_text_only("Alguns economistas argumentam que, na vida real, jogos repetidos podem ensinar aos dois lados que cooperar é a melhor estratégia.")
	novel_interface.show_background("res://assets/images/bg/Shot/storyBGWar.png")
	await novel_interface.show_text_only("Mas alguns jogos não deixam espaço para uma segunda rodada...")
	await novel_interface.show_text_only("Uma vez que ambos os lados caiam em suspeita mútua, eles nunca poderão escapar deste “dilema do prisioneiro”...")
	novel_interface.hide_background()
	await novel_interface.show_text_only("<Periferia, New Opulentia>")
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_Manorgate.png")
	await novel_interface.show_text_only("Uma limusine pára na entrada da propriedade. Uma garota bem vestida sai desajeitadamente do banco de trás.")
	novel_interface.show_character("ren_full","upset")
	await novel_interface.show_dialog("E-Esse tipo de lugar--!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Diante de mim estava uma luxuosa propriedade em estilo europeu – um portão de latão, esculturas requintadas, até mesmo o gramado e os arbustos aparados com perfeição.")
	await novel_interface.show_text_only("Eu não tinha ideia de que tal lugar existia em New Opulentia. Enquanto aprecio a bela paisagem, ouço a voz severa de Mariru no meu fone de ouvido.")
	await novel_interface.show_dialog("Pare de ficar boquiaberto. Você está praticamente babando.", "Mariru")
	novel_interface.show_character("ren_full","shy")
	await novel_interface.show_dialog("Tudo bem, tudo bem...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Eu me recomponho e dou um passo à frente – tropeçando imediatamente nos sapatos.")
	novel_interface.show_character("ren_full","shy")
	await novel_interface.show_dialog("Esse salto é alto demais... E por que esse vestido saia é tão curto?!", "Lian")
	novel_interface.change_expression("shy_right")
	await novel_interface.show_dialog("(E está um pouco apertado na cintura também. Tenho comido muito ultimamente...?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Levante o queixo, não fique desleixado. Você parece uma lagosta.", "Mariru")
	await novel_interface.show_dialog("Não é seu primeiro dia como menina!", "Mariru")
	await novel_interface.show_text_only("Tão chato--!!")
	await novel_interface.show_text_only("Ao me aproximar da entrada da villa, um porteiro abre os portões e faz uma reverência para mim.")
	await novel_interface.show_text_only("Forço um sorriso e rezo muito para não tropeçar novamente nas escadas.")
	novel_interface.hide_background()
	await novel_interface.show_text_only("Tomando medidas cuidadosas, entro na vila e passo por uma série de verificações de segurança complicadas. O interior do edifício aparece - e é lindo.")
	novel_interface.change_music("res://assets/audio/music/Shop.mp3")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_VillaHall.png")
	await novel_interface.show_text_only("O lobby, embora não seja grande, foi obviamente projetado por alguém com bom gosto. Até a lâmpada no canto brilha de uma forma que só uma antiguidade poderia fazer.")
	await novel_interface.show_text_only("Na minha cabeça, repito o que aprendi ontem na etiqueta 101. Peito para fora, barriga para dentro, pescoço reto, sorriso, rosto para frente...")
	novel_interface.show_character("ren_full","uneasy")
	await novel_interface.show_dialog("(E não quebre nada!)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("No momento em que entro no saguão, os convidados, todos vestidos com esmero e sussurrando em grupos de dois e três, se viram e olham como um só.")
	await novel_interface.show_dialog("Uau, Lian, você está linda hoje!", "Annie")
	await novel_interface.show_text_only("Observando cada movimento meu pela câmera de vigilância, Annie parece animada, embora se lembre de manter a voz baixa.")
	novel_interface.show_character("ren_full","blush")
	await novel_interface.show_dialog("(Bem, este vestido parece muito bonito, é verdade...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mas eu sou um cara! Eca!")
	await novel_interface.show_dialog("Os convidados aqui são todos elites famosas das várias Cidades Acadêmicas. Superficialmente, este lugar administra um cassino exclusivo para membros sob uma licença especial do Senado.", "Mariru")
	await novel_interface.show_dialog("Mas o verdadeiro negócio da mansão é o contrabando e o comércio de informações. É também o maior fiador clandestino de todo New Opulentia.", "Mariru")
	novel_interface.show_character("ren_full","upset")
	await novel_interface.show_dialog("Então você está tentando reunir evidências para invadir este lugar...?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Eu sussurro, o tempo todo sorrindo e acenando para as pessoas ao meu redor.")
	await novel_interface.show_dialog("Eu realmente acho que você é tão sem tato?\nAlém disso, se eu quisesse invadir um lugar, precisaria de provas?", "Mariru")
	await novel_interface.show_text_only("Mariru responde. Aposto que ela está revirando os olhos enquanto conversamos.")
	await novel_interface.show_dialog("Você precisa primeiro atrair a atenção do alvo. Annie vai ajudar.", "Mariru")
	novel_interface.show_character("ren_full","upset")
	await novel_interface.show_dialog("Todos aqui parecem ter entre quarenta e cinquenta anos. Obviamente sou um estudante do ensino médio... isso não seria suspeito?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("A segurança já escaneou você e verificou seus registros no momento em que você entrou nos portões.", "Mariru")
	await novel_interface.show_dialog("E não se preocupe, você aparecerá no sistema como um estudante normal do ensino médio que trabalha meio período em uma cafeteria.", "Mariru")
	novel_interface.show_character("ren_full","panic")
	await novel_interface.show_dialog("Huh?\n(Por que alguém assim seria permitido neste tipo de reunião?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Congelo, nervoso, encolhendo-me desconfortavelmente sob o olhar dos outros convidados.")
	await novel_interface.show_dialog("Pessoas como você aparecem aqui de vez em quando. Alguns convidados gostam muito desse tipo de coisa.", "Mariru")
	await novel_interface.show_text_only("O que você quer dizer com 'pessoas como eu'?!!")
	await novel_interface.show_dialog("O alvo está sentado perto da esquina, perto da escada. Parece um pouco nervoso.", "Annie")
	await novel_interface.show_text_only("Eu vou até um local onde posso observar o alvo e dar uma olhada...")
	novel_interface.show_character("shi","angry")
	await novel_interface.show_dialog("Droga! Droga! Droga!", "???")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("O alvo é um homem de meia idade abraçando uma sacola. Seu cabelo está uma bagunça, pelos faciais despenteados. Não se parece em nada com os outros convidados.")
	await novel_interface.show_text_only("Um casaco velho, uma camisa branca por baixo de um suéter cor de mostarda e até um lenço verde...")
	novel_interface.show_character("ren_full","wail")
	await novel_interface.show_dialog("Esse é o professor Shih?\n(Ele é incrivelmente cafona!)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Sim, acho que sim...", "Annie")
	novel_interface.show_character("ren_full","smile")
	await novel_interface.show_dialog("Tudo bem.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Por alguma razão, me senti estranhamente confiante sobre minha aparência hoje.")
	await novel_interface.show_text_only("Ando até a frente dele e finjo admirar o vitral do andar de cima, balançando os quadris enquanto ando de um lado para o outro. O cara ainda não me dá uma olhada adequada.")
	await novel_interface.show_text_only("Um pouco sem vontade de desistir, eu secretamente puxo as almofadas do meu peito e me aproximo, fingindo examinar a cabeça de veado montada na parede.")
	await novel_interface.show_text_only("Ele realmente virou a cabeça em desgosto!!")
	novel_interface.show_character("ren_full","wail")
	await novel_interface.show_dialog("(Cara, vamos lá!)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Hum... com licença, senhorita...", "Convidado masculino")
	await novel_interface.show_text_only("Um homem de meia-idade de smoking e gravata borboleta aparece ao meu lado.")
	await novel_interface.show_dialog("Dirijo uma empresa de mídia em Newmoridas... Você estaria interessado em conversar um pouco?", "Convidado masculino")
	await novel_interface.show_text_only("Esfregando as mãos, o homem sorri alegremente.")
	novel_interface.show_character("ren_full","perspire1")
	await novel_interface.show_dialog("S-Desculpe, com licença...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Seguro a barriga, como se tivesse sido atingida por uma tontura repentina, e me esgueirei até um canto, onde lanço para a câmera de vigilância um olhar de desespero.")
	await novel_interface.show_text_only("O alvo não reagiu de forma alguma. Acabei atraindo alguns esquisitos.")
	novel_interface.show_character("ren_full","sob")
	await novel_interface.show_dialog("Não consigo chamar a atenção daquele cara...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Lian, você é muito rígido...", "Annie")
	await novel_interface.show_dialog("Ele também parece estar esperando por alguém. E o que quer que esteja naquela bolsa parece suspeito.", "Annie")
	await novel_interface.show_dialog("Há um dispositivo de imagem na sua bolsa. Escaneamos sua bolsa agora há pouco - não há eletrônicos dentro, apenas vinte ou trinta páginas de documentos em papel.", "Mariru")
	await novel_interface.show_dialog("Ele realmente é um fóssil antigo...", "Annie")
	novel_interface.show_character("ren_full","normal2")
	await novel_interface.show_dialog("Aya não disse que essa coisa poderia fotografar o conteúdo de vários documentos em papel através de obstáculos?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Eu levanto a bolsa surpreendentemente pesada. Sob o couro cuidadosamente costurado, ele está repleto de pequenos gadgets do SRD.")
	await novel_interface.show_text_only("O mais surpreendente é que, graças ao seu forro especialmente tratado, de alguma forma passou na verificação de segurança na entrada.")
	await novel_interface.show_dialog("Para fotografar várias folhas de uma vez, o pó metálico deve ser disperso uniformemente pelo espaço para que os raios que passam por cada página acabem em diferentes níveis de intensidade.", "Mariru")
	await novel_interface.show_dialog("Há uma cápsula de metal em pó detonada remotamente na sua bolsa, mas são muitas páginas. Você precisará agitar com força para que o pó se espalhe uniformemente.", "Mariru")
	await novel_interface.show_dialog("A cápsula não fará barulho quando estourar? E ele está abraçando aquela bolsa como se fosse um tesouro...", "Annie")
	await novel_interface.show_dialog("Você não tem uma carga pegajosa que pode abrir a fechadura de uma porta?", "Mariru")
	await novel_interface.show_dialog("Isso é ainda mais alto!\nE se ela chamar a atenção com aquela roupa e as pessoas erradas perceberem...", "Annie")
	await novel_interface.show_text_only("Um arrepio percorre meu corpo quando me lembro do modo como aquele canalha da empresa de mídia ficava olhando para meu peito.")
	novel_interface.show_character("ren_full","normal2")
	await novel_interface.show_dialog("Agora que estou pensando nisso...", "Lian")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("O lobby parece ser a nossa melhor escolha.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Não há janelas. Mesmo o vidro colorido não deixa entrar luz, provavelmente para garantir privacidade.")
	novel_interface.show_character("ren_full","gratified")
	await novel_interface.show_dialog("Vocês dois podem cortar a energia nesta sala?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Parece que você tem algo ousado em mente, garoto...", "Mariru")
	await novel_interface.show_text_only("...")
	await novel_interface.show_text_only("Volto ao saguão e passo pelo Professor, tentando agir com naturalidade.")
	await novel_interface.show_text_only("De repente, a lâmpada do outro lado da escada pisca – e então, com um estalo, ela se quebra.")
	await novel_interface.show_text_only("No segundo em que todos, inclusive o professor, viram a cabeça, coloco uma cápsula prateada na abertura da bolsa dele.")
	await novel_interface.show_text_only("Então me agacho como se estivesse ajustando os calcanhares e rapidamente pressiono a carga de cola contra uma perna da cadeira.")
	novel_interface.show_character("ren_full","uneasy")
	await novel_interface.show_dialog("(Perfeito!)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Faço um sinal de “OK” para a câmera de vigilância e me afasto alguns passos.")
	novel_interface.hide_background()
	await novel_interface.show_text_only("Um baque vem do teto e num instante todas as luzes da sala se apagam. O professor grita.")
	await novel_interface.show_text_only("Antes que alguém possa reagir, uma perna da cadeira quebra e o Professor cai no chão.")
	await novel_interface.show_text_only("Na sala totalmente escura, aponto o lado de digitalização da minha bolsa em direção aos arquivos e rezo furtivamente para que o dispositivo funcione como deveria.")
	await novel_interface.show_text_only("Os convidados explodem em confusão. Um mordomo entra correndo para acalmar todos, dizendo que a energia voltará em breve.")
	await novel_interface.show_dialog("Está funcionando.", "Mariru")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_VillaHall.png")
	await novel_interface.show_text_only("Eu exalo de alívio. No segundo em que larguei a bolsa, as luzes se acenderam novamente.")
	novel_interface.show_character("ren_full","uneasy")
	await novel_interface.show_dialog("Sim!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Tudo pronto!")
	await novel_interface.show_dialog("Ei, vocês dois...", "???")
	await novel_interface.show_text_only("Uma voz feminina... atrás de mim.")
	novel_interface.show_character("nyx_full","normal1")
	await novel_interface.show_dialog("Eu estive observando lá de cima. O que você está fazendo aqui, tentando seduzir as pessoas?", "Nix")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_full","panic")
	await novel_interface.show_dialog("... Nix?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("A garota mais velha olha para o Professor, que está sentado perto de nós, esfregando a bunda.")
	novel_interface.show_character("nyx_full","normal1")
	await novel_interface.show_dialog("Essa cadeira tem pelo menos cento e trinta anos. Especialistas dizem que vale mais de dois milhões.", "Nix")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_full","upset")
	await novel_interface.show_dialog("Hã...?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Nix se vira e coloca a mão na minha bochecha.")
	novel_interface.show_character("nyx_full","smile")
	await novel_interface.show_dialog("Você está muito bem vestida hoje, querido.", "Nix")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Seu dedo frio traça uma linha pelo meu rosto, alcança meu fone de ouvido de condução óssea, que ela recupera com um sorriso frio.")
	novel_interface.show_character("nyx_full","mock")
	await novel_interface.show_dialog("... Então, como você planeja pagar por isso?", "Nix")

	print("=== 星尘降临篇第1话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
