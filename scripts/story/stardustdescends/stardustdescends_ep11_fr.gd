# stardustdescends_ep11.gd - 星尘降临篇第11话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	stardustdescends_ep11_script()

func play_script():
	pass

func stardustdescends_ep11_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_MasadMuseum.png")
	novel_interface.show_character("ren_medical","normal1")
	await novel_interface.show_dialog("Musée national de Massada... c'est l'endroit ?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("En tenant mon téléphone, je me suis assuré d'être arrivé au bon endroit.")
	await novel_interface.show_text_only("Ce qui m'a surpris, c'est que la plupart des salles d'exposition de ce musée national se trouvaient dans des espaces semi-souterrains.")
	await novel_interface.show_text_only("Le mur de pierre noire qui se dresse à l'entrée principale contiendrait des pierres provenant des ruines de l'ancien mur de la ville, du côté ouest du mont du Temple, dans l'ancienne capitale.")
	await novel_interface.show_text_only("Le matériau noir de protection contre les radiations étroitement enroulé autour de l’extérieur du mur semblait parler silencieusement des blessures et des souffrances laissées par cette catastrophe.")
	await novel_interface.show_text_only("Le mur entier ressemblait à une pierre tombale géante. Quelques personnes âgées se tenaient en dessous, baissant la tête et caressant doucement la pierre, et je ne pouvais pas dire si elles étaient en deuil ou en prière...")
	novel_interface.show_character("ren_medical","uneasy")
	await novel_interface.show_dialog("Je m'inscris ici... non ?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("J'ai utilisé mon badge au comptoir sans personnel près de l'entrée et j'ai effectué un scan biométrique facial.")
	await novel_interface.show_text_only("Ce badge était un identifiant crypté de l'Organisation internationale de secours médical, conçu spécifiquement pour le personnel médical qui entre et sort fréquemment des zones de guerre.")
	await novel_interface.show_text_only("En plus de stocker des informations personnelles et des dossiers médicaux, il vous permet également de faire appel au matériel de communication et aux fournitures de secours de l'organisation partout dans le monde.")
	await novel_interface.show_text_only("Il était même préchargé avec une somme de monnaie électronique hors ligne, soi-disant pour payer une rançon en cas d'enlèvement...")
	novel_interface.show_character("ren_medical","wry_smile")
	await novel_interface.show_dialog("(Une infirmière stagiaire n'a pas du tout besoin d'un tel accès, n'est-ce pas !)\n(Mariru, honnêtement...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Quoi qu'il en soit, tant qu'ils ne me font rien faire de dangereux...")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("...")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_FirstExhibition.png")
	await novel_interface.show_text_only("J'ai pris l'escalier roulant jusqu'à la première salle d'exposition, où de nombreux reliefs en pierre étaient exposés dans une salle pas très spacieuse.")
	await novel_interface.show_text_only("Les traces visibles de l’érosion éolienne semblaient raconter une histoire lointaine et érodée.")
	await novel_interface.show_text_only("Mais l'histoire ne m'intéressait pas. J'ai juste fait défiler mon téléphone et essayé de comprendre comment j'allais survivre à ces trois misérables heures.")
	novel_interface.show_character("ren_medical","panic")
	await novel_interface.show_dialog("Est-ce... un guide ?!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("À notre époque, où les guides vocaux IA sont partout, je n’avais pas vu de véritable guide humain depuis très longtemps.")
	novel_interface.show_character("ren_medical","stare")
	await novel_interface.show_dialog("(Masada n'est-elle pas désespérément à court de population... ?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("C'était un homme âgé avec une barbe blanche, probablement dans la soixantaine, portant une petite calotte noire avec un badge d'identification épinglé au col de son costume.")
	await novel_interface.show_text_only("Il a patiemment guidé tout le monde pendant qu'ils ramassaient les brochures, souriant gentiment en répondant à chaque personne qui lui demandait quelque chose.")
	await novel_interface.show_text_only("Curieuse, je me suis rapprochée. Il présentait l'histoire du musée à quelques visiteurs...")
	await novel_interface.show_dialog("Bien que de nombreuses reliques précieuses aient été détruites pendant la guerre, ainsi que le musée national d'origine.", "Guide")
	await novel_interface.show_dialog("Ces dernières années, cependant, ce nouveau musée a rassemblé de nombreux objets précieux d'Asie occidentale et d'Afrique, leur permettant d'échapper aux ravages de la guerre...", "Guide")
	await novel_interface.show_text_only("J'ai jeté un coup d'œil à la momie égyptienne et au masque de bronze imprimés au dos de la brochure.")
	novel_interface.show_character("ren_medical","wail")
	await novel_interface.show_dialog("(Alors tu viens de les voler à ces endroits-là, hein !)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mais de nos jours, les artefacts historiques les plus précieux du monde sont de toute façon conservés par les Six Villes Académies, ce genre de chose n’est donc guère inhabituel.")
	await novel_interface.show_text_only("J'ai remarqué que même s'il parlait avec beaucoup d'émotion, sa main gauche restait tout le temps dans la poche de son costume.")
	novel_interface.show_character("ren_medical","bored")
	await novel_interface.show_dialog("(C'est peut-être une coutume religieuse particulière...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("J'ai regardé autour de moi. Heureusement, aujourd'hui n'était pas un sabbat, donc il n'y avait pas beaucoup de visiteurs, et il n'y avait pas non plus d'autres membres de l'organisation médicale dans le musée.")
	await novel_interface.show_text_only("Pour les membres d'ONG, la procédure obligatoire de « visite d'étude » commence par un séjour d'au moins trente minutes dans les salles d'histoire et de documentation.")
	await novel_interface.show_text_only("J'ai erré dans l'ennui et mes yeux ont vite été attirés par quelques habitants et plus d'une douzaine d'enfants visitant les lieux en même temps.")
	await novel_interface.show_text_only("Parmi eux, les plus accrocheurs étaient deux hommes d'une quarantaine d'années, tous deux arborant de grandes barbes et d'étranges petites tresses qui pendaient de leurs cheveux au niveau des tempes.")
	await novel_interface.show_text_only("Ils étaient habillés de la même manière : des chemises blanches, des manteaux noirs jusqu'aux genoux et des chapeaux noirs à couronne plate et à bords bouclés, comme les membres d'une étrange organisation.")
	await novel_interface.show_text_only("Une douzaine d'enfants suivaient ces hommes, et les garçons et les filles portaient les mêmes tenues en noir et blanc.")
	novel_interface.show_character("ren_medical","bored")
	await novel_interface.show_dialog("(Est-ce une sortie scolaire à proximité ?)\n(Mais la tranche d'âge dans cette école est plutôt sauvage...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Les enfants étaient âgés de trois ou quatre ans à une dizaine d'années ; les plus jeunes pouvaient à peine marcher régulièrement, tandis que certains des enfants les plus âgés criaient et se bousculaient.")
	await novel_interface.show_text_only("Derrière le groupe se tenaient deux femmes d'âge moyen à l'air las et aux silhouettes affaissées.")
	novel_interface.show_character("ren_medical","stare")
	await novel_interface.show_dialog("(Ces deux-là ne sont pas les professeurs... n'est-ce pas ?)", "Lian")
	await novel_interface.show_dialog("(Pourquoi l’un d’eux pousse-t-il une poussette ?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Quelle étrange combinaison...")
	await novel_interface.show_text_only("La visite de la salle d’histoire s’est terminée rapidement et le guide a commencé à conduire tout le monde vers la salle des documents.")
	await novel_interface.show_text_only("Il ajusta le microphone attaché à son collier et s'éclaircit la gorge...")
	await novel_interface.show_dialog("Ensuite, je vais vous montrer l'exposition la plus importante de ce musée.", "Guide")
	await novel_interface.show_dialog("La photographie est interdite dans la salle voisine. S'il vous plaît, rangez vos téléphones et suivez-moi dans le sanctuaire du livre.", "Guide")
	await novel_interface.show_text_only("Au moment où ils entendirent cela, les enfants turbulents se turent et les deux hommes en noir devinrent également solennels.")
	await novel_interface.show_text_only("J'ai rangé mon téléphone et j'ai suivi avec une curiosité brûlante dans ma poitrine.")
	await novel_interface.hide_background()
	await novel_interface.stop_music()
	await novel_interface.show_text_only("Après que le guide ait scanné l'empreinte de sa paume, une porte en basalte de la salle d'histoire s'est lentement ouverte, révélant un long couloir de pierre au-delà.")
	await novel_interface.show_text_only("Nous étions plus d'une vingtaine à nous présenter les uns après les autres. C'était comme si une atmosphère solennelle nous avait infectés ; tout le monde bougeait prudemment et ne disait rien.")
	await novel_interface.show_text_only("...")
	novel_interface.change_music("res://assets/audio/music/Normal Stage.mp3")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_SOTB.png")
	novel_interface.show_character("ren_medical","panic")
	await novel_interface.show_dialog("C'est...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Au bout du couloir se trouvait une pièce aux formes étranges.")
	await novel_interface.show_text_only("La salle d'exposition du Sanctuaire du Livre était parfaitement circulaire, avec des rayures annelées uniformément espacées allant des murs jusqu'à la lucarne au-dessus.")
	await novel_interface.show_text_only("La lumière traversant la lucarne tombait sur le présentoir au centre, donnant à l'ensemble un sentiment de calme et de sacré.")
	await novel_interface.show_text_only("L'espace entier avait été conçu comme un pot d'argile et les murs environnants utilisaient un matériau en terre similaire.")
	await novel_interface.show_text_only("Sur le présentoir circulaire en forme de tambour d'écriture au sommet des marches de pierre se trouvait un ancien rouleau de parchemin jauni et tacheté.")
	await novel_interface.show_text_only("J'ai grimpé les marches et me suis penché pour regarder de plus près. Le verre de protection avait une épaisseur d’au moins cinq centimètres et la plupart des caractères hébreux sur le parchemin étaient clairement visibles.")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_DSS.png")
	await novel_interface.show_dialog("Est-ce que cela pourrait être...", "Lian")
	await novel_interface.show_text_only("Tu sais, ce truc de cet anime...")
	await novel_interface.show_dialog("Il s'agit d'un document ancien découvert dans des grottes au nord-ouest de la mer Morte, connu sous le nom de « manuscrits de la mer Morte », la plus grande découverte archéologique du siècle dernier.", "Guide")
	await novel_interface.show_dialog("Les manuscrits de la mer Morte sont vastes et comprennent plus de cinq cents manuscrits découverts dans douze grottes...", "Guide")
	await novel_interface.show_dialog("Et celle qui se trouve dans cette vitrine est une page manuscrite partielle de la Genèse tirée de la « Torah », l'un des manuscrits de la mer Morte.", "Guide")
	await novel_interface.show_dialog("Il raconte le processus par lequel Dieu a créé le monde et comment il a choisi les Masadans comme son peuple élu. C'est le vestige historique le plus important de ce pays.", "Guide")
	await novel_interface.show_text_only("À bien y penser, les Masadans semblent toujours se targuer d'être le peuple élu de Dieu...")
	await novel_interface.show_text_only("Mais je n'ai jamais été intéressé par des histoires religieuses comme celle-ci...")
	await novel_interface.show_text_only("Chaque peuple sur terre a quelques ancêtres qui se sont transformés en dieux dans leurs légendes, n'est-ce pas...")
	await novel_interface.show_text_only("Les visiteurs locaux ne pensaient clairement pas de cette façon. Les deux oncles aux chapeaux étranges se tournèrent immédiatement vers la valise et commencèrent à prier.")
	await novel_interface.show_text_only("De sa voix grave et bienveillante, le guide poursuivit.")
	await novel_interface.show_dialog("Ce manuscrit relate les histoires des ancêtres Abraham, Isaac, Jacob et des douze fils de Jacob.", "Guide")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_TheThree.png")
	await novel_interface.show_dialog("Abraham est un prophète dans de nombreuses religions et l’ancêtre commun des Hébreux et des Arabes.", "Guide")
	await novel_interface.show_dialog("Abraham était celui que le Seigneur avait choisi parmi tous les êtres et qu'il avait béni.", "Guide")
	await novel_interface.show_dialog("Dieu a conclu une alliance avec Abraham, promettant d'accorder une terre fertile à son fils légitime, à son petit-fils et à tous les descendants que produirait la lignée de ce petit-fils.", "Guide")
	await novel_interface.show_dialog("Cette terre s'étend du Nil à l'Euphrate. C'est ce que nous appelons aujourd'hui la « Terre promise ».", "Guide")
	await novel_interface.show_dialog("Plus tard, Abraham engendra son fils légitime Isaac ; Isaac engendra Ésaü, et son deuxième fils s'appela Jacob...", "Guide")
	await novel_interface.show_dialog("(Attends... Jacob ?)", "Lian")
	await novel_interface.show_text_only("N'est-ce pas le nom de cet administrateur d'Elluka ?")
	await novel_interface.show_text_only("Là encore, les Occidentaux aiment vraiment donner à leurs enfants le nom de figures de classiques religieux...")
	await novel_interface.show_text_only("Le guide fit une pause, ajusta ses lunettes de lecture et continua à expliquer le contenu du parchemin.")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_MessOfPottage.png")
	await novel_interface.show_dialog("Selon l'Écriture, Jacob, le deuxième fils d'Isaac, a acheté un jour le droit d'aînesse de son frère aîné Ésaü avec un bol de ragoût de haricots rouges.", "Guide")
	await novel_interface.show_dialog("Selon l'alliance d'Abraham avec Dieu, une fois que Jacob a obtenu le droit d'aînesse, il a acquis le droit légal d'hériter de la « Terre promise ».", "Guide")
	await novel_interface.show_dialog("Jacob devint plus tard le saint patriarche de Massada, et ses douze fils devinrent les douze ancêtres des tribus de Massada...", "Guide")
	await novel_interface.show_text_only("À ce stade, ma tête commençait à me faire mal.")
	await novel_interface.show_text_only("Attends... un ragoût de haricots rouges ? Qu'est-ce que c'est !?\nLes peuples anciens étaient-ils vraiment aussi décontractés ?")
	await novel_interface.show_text_only("Et si c'est vrai, alors tous les Massadans sont des descendants de ce Jacob...")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_DSS.png")
	await novel_interface.show_text_only("Le guide fit deux pas le long de la plate-forme circulaire, examina les mots vers la fin du parchemin et continua.")
	await novel_interface.show_dialog("Ceci est la dernière partie de la Genèse...", "Guide")
	await novel_interface.show_dialog("La vie du saint patriarche Jacob était pleine de légendes. Il rêva de la porte du ciel et entendit Dieu réaffirmer le serment fait à son grand-père.", "Guide")
	await novel_interface.show_dialog("Il lutta avec Dieu et en sortit boiteux, et on lui accorda un saint nom.", "Guide")
	await novel_interface.show_dialog("Jacob a passé les dix-sept dernières années de sa vie en Égypte, et avant sa mort, il a appelé son fils Joseph...", "Guide")
	await novel_interface.show_dialog("Jacob fit jurer à son fils de le faire sortir d'Égypte et de l'enterrer dans la grotte de Macpéla à Hébron, au pays de Canaan.", "Guide")
	await novel_interface.show_dialog("C'était le tombeau familial qu'Abraham avait acheté il y a longtemps, où étaient enterrés les parents et les grands-parents de Jacob.", "Guide")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Le manuscrit s'arrête là.")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_SOTB.png")
	novel_interface.show_character("ren_medical","worry")
	await novel_interface.show_dialog("(Grotte de Machpelah... pourquoi ce nom vous semble-t-il familier ?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("J'ai l'impression qu'Aya l'a mentionné lors du briefing d'hier soir... N'y a-t-il pas eu une explosion il y a quelques jours ?")
	await novel_interface.show_text_only("Pouah, je ne m'en souviens pas. De toute façon, tous ces étrangers et tous ces noms de lieux me semblent pareils...")
	await novel_interface.show_text_only("Le guide caressa doucement la vitre de la vitrine et soupira à voix basse.")
	await novel_interface.show_dialog("Massada est un peuple ancien et nous accordons une grande importance aux fouilles archéologiques.", "Guide")
	await novel_interface.show_dialog("Depuis le jour où le premier rouleau a été découvert, les fouilles et la restauration des manuscrits de la mer Morte se sont poursuivies pendant plus de quatre-vingts ans.", "Guide")
	await novel_interface.show_dialog("Ils sont le précieux héritage de nos ancêtres, mais aussi nos racines.", "Guide")
	await novel_interface.show_dialog("Cependant...", "Guide")
	await novel_interface.show_text_only("Le guide descendit les escaliers et s'approcha de l'immense peinture à l'huile située sur un côté du hall.")
	novel_interface.change_music("res://assets/audio/music/Hero.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_TheJewishWar.png")
	await novel_interface.show_text_only("Il resta longtemps devant lui, le regardant dans un silence significatif.")
	await novel_interface.show_text_only("La peinture était de grande taille, couvrant presque tout un mur.")
	await novel_interface.show_dialog("Pourtant, notre histoire est également remplie de souffrances.", "Guide")
	await novel_interface.show_text_only("Il se retourna, les coins de sa bouche se contractant légèrement comme s'il supprimait désespérément un souvenir douloureux.")
	await novel_interface.show_dialog("Ce tableau a été créé sur la base des écrits de l’historien Flavius Josèphe du premier siècle.", "Guide")
	await novel_interface.show_dialog("À cette époque, le puissant Empire romain conquit la ville sainte et plus d’un million d’ancêtres Massadan furent massacrés par des légionnaires.", "Guide")
	await novel_interface.show_dialog("Et ce tableau représente le jour où le Second Temple a été incendié.", "Guide")
	await novel_interface.show_dialog("Ce fut le jour le plus triste de l'histoire de Massadan... et pourtant ce n'était que le début de mille ans de souffrance.", "Guide")
	await novel_interface.show_dialog("En l’an 70, nos ancêtres furent chassés en grand nombre de Judée par les Romains.", "Guide")
	await novel_interface.show_dialog("Ceux qui refusaient d’accepter l’exil de leur pays se soulevèrent dans la résistance et plus d’un millier de rebelles firent de Massada de cette époque leur dernière forteresse.", "Guide")
	await novel_interface.show_dialog("Ils ont tenu cette ville pendant deux années complètes sous le siège romain, jusqu'à ce que leur approvisionnement en eau soit coupé et qu'ils n'aient plus de force.", "Guide")
	await novel_interface.show_dialog("Lorsque la Dixième Légion a finalement pénétré dans la ville, le gouverneur qui est entré n'a trouvé que plus de neuf cents cadavres et des bâtiments entièrement incendiés...", "Guide")
	await novel_interface.show_dialog("Les défenseurs ont choisi de se suicider plutôt que de se soumettre et de devenir esclaves de Rome. Au final, seuls deux adultes et cinq enfants ont survécu...", "Guide")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Imaginer cette scène m’a fait mal à la poitrine.")
	await novel_interface.show_text_only("Le guide resta longtemps silencieux, puis se retourna vers nous et continua.")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_SOTB.png")
	await novel_interface.show_dialog("Nous avons été chassés de notre pays à maintes reprises, forcés de quitter nos propres maisons.", "Guide")
	await novel_interface.show_dialog("Nous avons été conquis, gouvernés, marginalisés, massacrés, traités comme des esclaves, des prisonniers, voire du bétail...", "Guide")
	await novel_interface.show_dialog("Il y a un siècle, lors de l’une des purges ethniques les plus épouvantables de l’histoire de l’humanité, six millions de nos compatriotes ont été massacrés.", "Guide")
	await novel_interface.show_dialog("Et il y a dix ans, notre capitale était à nouveau réduite en terre brûlée. Le Mont du Temple a brûlé dans des flammes violettes pendant sept jours et sept nuits...", "Guide")
	await novel_interface.show_dialog("De nombreuses personnes – ma famille et mes amis – ont perdu la vie dans cette catastrophe.", "Guide")
	await novel_interface.show_dialog("Et ceux qui ont survécu par pure chance ont peut-être perdu encore plus...", "Guide")
	await novel_interface.show_text_only("Sa voix trembla alors qu'il levait la main gauche qui était dans sa poche.")
	await novel_interface.show_text_only("C'est seulement alors que nous avons constaté que la main avait été remplacée par une prothèse métallique, et que des brûlures couvraient le poignet et l'avant-bras exposés au-delà de la manche...")
	await novel_interface.show_text_only("La pièce entière devint silencieuse. Je me suis retrouvé à retenir mon souffle aussi.")
	await novel_interface.show_text_only("Une jeune touriste dans la foule se couvrit la bouche des deux mains, les larmes aux yeux.")
	await novel_interface.show_text_only("Mais le guide serra cette main dans un poing et le leva très haut, nous regardant tout en parlant d'une voix résolue :")
	await novel_interface.show_dialog("Et pourtant, tout comme ces milliers de guerriers qui ont défendu cette forteresse jusqu’au bout, la souffrance ne nous soumettra jamais.", "Guide")
	await novel_interface.show_text_only("Sa voix n'était pas forte, mais elle était remplie d'un esprit héroïque et elle faisait monter une étrange force dans ma poitrine.")
	await novel_interface.show_text_only("Ses yeux brillaient comme s’il pouvait voir un dieu lui montrer le chemin.")
	await novel_interface.show_dialog("Nous avons enduré deux grandes diasporas, mais à la fin nous reviendrons toujours sur cette terre, car la souffrance ne nous soumettra jamais.", "Guide")
	await novel_interface.show_dialog("Il y a quatre-vingt-dix ans, nos ancêtres ont bravé les tirs et les obus juste pour revenir ici une fois de plus et fonder notre propre nation.", "Guide")
	await novel_interface.show_dialog("Même si ce n’était qu’un désert aride, même si l’eau douce était alors à peine disponible, c’est notre maison !", "Guide")
	await novel_interface.show_dialog("Ce qui coule sur cette terre, ce n’est pas du lait et du miel, mais notre sang, nos larmes et notre sueur.", "Guide")
	await novel_interface.show_dialog("C’est notre seule patrie au monde et le foyer spirituel que le peuple Masadan chérit depuis des milliers d’années.", "Guide")
	await novel_interface.show_dialog("La « Terre promise » est l'alliance entre nos ancêtres et Dieu, ainsi que notre promesse aux générations futures.", "Guide")
	await novel_interface.show_dialog("Le Temple peut être brûlé, mais la forteresse de l’esprit ne tombera jamais !", "Guide")
	await novel_interface.show_dialog("Enfin, merci encore à tous d’avoir visité le Musée national de Massada. Merci à tous !", "Guide")
	await novel_interface.show_text_only("Sur ce, le guide s'inclina devant la foule.")
