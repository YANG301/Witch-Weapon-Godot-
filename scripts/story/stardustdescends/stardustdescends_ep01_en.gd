# stardustdescends_ep01.gd - 星尘降临篇第1话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	stardustdescends_ep01_script()

func play_script():
	pass

func stardustdescends_ep01_script():
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_Prisoner.png")
	await novel_interface.show_text_only("You've probably heard this classic story before...")
	await novel_interface.show_text_only("A wealthy man's valuables were stolen. The police found the stolen goods in a room shared by two suspects, but lacked enough evidence to convict either of them.")
	await novel_interface.show_text_only("So the police separated the two suspects and gave them the following choice:")
	await novel_interface.show_text_only("If one confesses while the other stays silent, the confessor goes free and the silent one gets ten years in prison.")
	await novel_interface.show_text_only("If both remain silent, they each get six months. But if both confess, they each get five years.")
	await novel_interface.show_text_only("For the two people in this story, the outcome that best serves both of them is forever out of reach--")
	await novel_interface.show_text_only("Because whether the other side stays silent or confesses, confessing yourself always leads to a better result. Confession becomes the dominant strategy.")
	novel_interface.hide_background()
	await novel_interface.show_text_only("Some economists argue that in real life, repeated games can teach both sides that cooperation is the optimal strategy.")
	novel_interface.show_background("res://assets/images/bg/Shot/storyBGWar.png")
	await novel_interface.show_text_only("But some games leave no room for a second round--")
	await novel_interface.show_text_only("Once both sides fall into mutual suspicion, they can never escape this 'prisoner's dilemma'...")
	novel_interface.hide_background()
	await novel_interface.show_text_only("<Outskirts, New Opulentia>")
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_Manorgate.png")
	await novel_interface.show_text_only("A stretch limousine stops at the entrance to the estate. A finely dressed girl awkwardly climbs out of the back seat.")
	novel_interface.show_character("ren_full","upset")
	await novel_interface.show_dialog("T-This kind of place--!", "Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Before me stood a lavish European-style estate--a brass gate, exquisite sculptures, even the lawn and shrubs trimmed to perfection.")
	await novel_interface.show_text_only("I had no idea such a place existed in New Opulentia. As I take in the fine scenery, I hear Mariru's stern voice from my earpiece.")
	await novel_interface.show_dialog("Quit gawking. You're practically drooling.", "Mariru")
	novel_interface.show_character("ren_full","shy")
	await novel_interface.show_dialog("All right, all right...", "Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I collect myself and take one step forward--promptly tripping over my shoes.")
	novel_interface.show_character("ren_full","shy")
	await novel_interface.show_dialog("These heels are way too high... And why is this dress skirt so short?!", "Ren")
	novel_interface.change_expression("shy_right")
	await novel_interface.show_dialog("(And it's a little tight at the waist too. Have I been eating too much lately...?)", "Ren")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Chin up, don't slouch. You look like a lobster.", "Mariru")
	await novel_interface.show_dialog("It's not your first day as a girl!", "Mariru")
	await novel_interface.show_text_only("So annoying--!!")
	await novel_interface.show_text_only("As I approach the villa entrance, a doorman opens the gates and bows at me.")
	await novel_interface.show_text_only("I force a smile and pray hard that I won't trip again on the stairs.")
	novel_interface.hide_background()
	await novel_interface.show_text_only("Taking careful steps, I enter the villa and pass through a series of complicated security checks. The interior of the building comes into view--and it's gorgeous.")
	novel_interface.change_music("res://assets/audio/music/Shop.mp3")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_VillaHall.png")
	await novel_interface.show_text_only("The lobby, while not a big one, is obviously designed by someone with taste. Even the lamp in the corner gleams in a way only an antique could.")
	await novel_interface.show_text_only("In my head, I repeat what I learned yesterday in etiquette 101. Chest out, stomach in, neck straight, smile, face forward...")
	novel_interface.show_character("ren_full","uneasy")
	await novel_interface.show_dialog("(And don't break anything!)", "Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("The moment I enter the lobby, the guests, all dressed to the nines and whispering in twos and threes, turn to stare as one.")
	await novel_interface.show_dialog("Wow, Ren, you look pretty today!", "Annie")
	await novel_interface.show_text_only("Watching my every move from the surveillance camera, Annie sounds excited, though she does remember to keep her voice down.")
	novel_interface.show_character("ren_full","blush")
	await novel_interface.show_dialog("(Well, this gown looks really nice, that's true...)", "Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("But I'm a guy! Ugh!")
	await novel_interface.show_dialog("The guests here are all famous elites from the various Academy Cities. On the surface, this place runs a members-only casino under a special Senate license.", "Mariru")
	await novel_interface.show_dialog("But the manor's real business is contraband and intelligence trading. It's also the biggest underground guarantor in all of New Opulentia.", "Mariru")
	novel_interface.show_character("ren_full","upset")
	await novel_interface.show_dialog("So you're trying to gather evidence so you can raid this place...?", "Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I whisper, all the while smiling and nodding at the people around me.")
	await novel_interface.show_dialog("Do I really strike you as that tactless?\nBesides, if I wanted to raid a place, would I need evidence?", "Mariru")
	await novel_interface.show_text_only("Mariru replies. I bet she's rolling her eyes as we speak.")
	await novel_interface.show_dialog("You need to attract the attention of the target first. Annie will help.", "Mariru")
	novel_interface.show_character("ren_full","upset")
	await novel_interface.show_dialog("Everyone here seems to be in their forties and fifties. I'm obviously a high school student... wouldn't that be suspicious?", "Ren")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("The security has already scanned you and checked your records the moment you entered the gates.", "Mariru")
	await novel_interface.show_dialog("And don't worry, you'll show up in the system as a normal high school student who works part-time in a maid cafe.", "Mariru")
	novel_interface.show_character("ren_full","panic")
	await novel_interface.show_dialog("Huh?\n(Why would someone like that be allowed in this kind of gathering?)", "Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I freeze, nervous, cringing uncomfortably under the gaze of the other guests.")
	await novel_interface.show_dialog("People like you do turn up here from time to time. Some guests are very fond of that sort of thing.", "Mariru")
	await novel_interface.show_text_only("What do you mean, 'people like me'?!!")
	await novel_interface.show_dialog("The target is sitting near the corner, by the stairs. Looks a bit nervous.", "Annie")
	await novel_interface.show_text_only("I drift to a spot where I can observe the target and sneak a glance over--")
	novel_interface.show_character("shi","angry")
	await novel_interface.show_dialog("Dammit! Dammit! Dammit!", "???")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("The target is a middle-aged man hugging a bag. His hair is a mess, facial hair unkempt. Doesn't look anything like the other guests.")
	await novel_interface.show_text_only("An old coat, a white shirt under a mustard-colored sweater, and even a green scarf...")
	novel_interface.show_character("ren_full","wail")
	await novel_interface.show_dialog("That's Professor Shih?\n(He's unbelievably tacky!)", "Ren")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Yeah, guess so...", "Annie")
	novel_interface.show_character("ren_full","smile")
	await novel_interface.show_dialog("All right.", "Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("For some reason, I felt oddly confident about how I looked today.")
	await novel_interface.show_text_only("I walk up in front of him and pretend to admire the stained glass upstairs, swaying my hips as I pace back and forth. The guy still doesn't give me a proper glance.")
	await novel_interface.show_text_only("A little unwilling to give up, I secretly tug at my chest pads and edge closer, pretending to examine the mounted deer head on the wall.")
	await novel_interface.show_text_only("He actually turned his head away in disgust!!")
	novel_interface.show_character("ren_full","wail")
	await novel_interface.show_dialog("(Dude, come on!)", "Ren")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Um... excuse me, miss--", "Male Guest")
	await novel_interface.show_text_only("A middle-aged man in a tuxedo and a bow tie appears by my side.")
	await novel_interface.show_dialog("I run a media company in Newmoridas... Would you be interested in chatting for a bit?", "Male Guest")
	await novel_interface.show_text_only("Rubbing his hands, the man beams gleefully.")
	novel_interface.show_character("ren_full","perspire1")
	await novel_interface.show_dialog("S-Sorry--excuse me...", "Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I hold my stomach, as if hit by a sudden dizzy spell, and sneak to a corner, where I send the surveillance camera a look of despair.")
	await novel_interface.show_text_only("The target didn't react at all. I only ended up attracting some weirdo.")
	novel_interface.show_character("ren_full","sob")
	await novel_interface.show_dialog("I can't seem to get that guy's attention at all...", "Ren")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Ren, you're way too stiff...", "Annie")
	await novel_interface.show_dialog("He also seems to be waiting for someone. And whatever's in that bag looks suspicious.", "Annie")
	await novel_interface.show_dialog("There's an imaging device in your handbag. We scanned his bag just now--no electronics inside, just twenty or thirty pages of paper documents.", "Mariru")
	await novel_interface.show_dialog("He really is an old fossil...", "Annie")
	novel_interface.show_character("ren_full","normal2")
	await novel_interface.show_dialog("Didn't Aya say this thing could photograph the contents of multiple paper documents through obstacles?", "Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I heft the surprisingly heavy handbag. Under the carefully stitched patent leather, it's packed with little gadgets from the SRD.")
	await novel_interface.show_text_only("The most amazing part is that, thanks to its specially treated lining, it somehow passed the security check at the entrance.")
	await novel_interface.show_dialog("To photograph multiple sheets at once, metal powder has to be evenly dispersed through the space so the rays passing through each page end up at different intensity levels.", "Mariru")
	await novel_interface.show_dialog("There's a remotely detonated metal-powder capsule in your bag, but that's a lot of pages. You'll need to shake it hard for the powder to spread evenly.", "Mariru")
	await novel_interface.show_dialog("Won't the capsule make a sound when it bursts? And he's been hugging that bag like it's treasure...", "Annie")
	await novel_interface.show_dialog("Don't you have a sticky charge that can blow open a door lock?", "Mariru")
	await novel_interface.show_dialog("That's even louder!\nAnd if she draws attention in that outfit and the wrong people notice...", "Annie")
	await novel_interface.show_text_only("A shiver runs through me as I remember the way that media-company creep kept staring at my chest.")
	novel_interface.show_character("ren_full","normal2")
	await novel_interface.show_dialog("Now that I'm thinking about it...", "Ren")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("The lobby seems like our best choice.", "Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("There aren't any windows. Even the colored glass doesn't let in light, probably to ensure privacy.")
	novel_interface.show_character("ren_full","gratified")
	await novel_interface.show_dialog("Can you two cut the power in this room?", "Ren")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Sounds like you've got something bold in mind, kid...", "Mariru")
	await novel_interface.show_text_only("...")
	await novel_interface.show_text_only("I return to the lobby and stroll by the Professor, trying to act natural.")
	await novel_interface.show_text_only("Suddenly, the light bulb from the other side of the stairs flashes--and then, with a pop, it shatters.")
	await novel_interface.show_text_only("The second everyone, including the professor, turns their heads, I stick a silver capsule through the opening on his bag.")
	await novel_interface.show_text_only("Then I crouch as if adjusting my heels and quickly press the glue charge against one leg of his chair.")
	novel_interface.show_character("ren_full","uneasy")
	await novel_interface.show_dialog("(Perfect!)", "Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I make an \"OK\" sign at the surveillance camera and move a few steps away.")
	novel_interface.hide_background()
	await novel_interface.show_text_only("A thud comes from the ceiling, and in an instant all the lights in the room go out. The professor screams.")
	await novel_interface.show_text_only("Before anyone can react, one leg of the chair snaps and the Professor tumbles to the floor.")
	await novel_interface.show_text_only("In the pitch-dark room, I aim the scanning side of my bag toward the files and furtively pray the device works the way it's supposed to.")
	await novel_interface.show_text_only("The guests erupt in confusion. A butler rushes in to calm everyone down, saying the power will be back momentarily.")
	await novel_interface.show_dialog("It's working.", "Mariru")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_VillaHall.png")
	await novel_interface.show_text_only("I exhale in relief. The second I put down the bag, the lights come back on again.")
	novel_interface.show_character("ren_full","uneasy")
	await novel_interface.show_dialog("Yes!", "Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("All done!")
	await novel_interface.show_dialog("Heh, you two...", "???")
	await novel_interface.show_text_only("A female voice... from behind me.")
	novel_interface.show_character("nyx_full","normal1")
	await novel_interface.show_dialog("I've been watching from upstairs. What are you doing down here, trying to seduce people?", "Nix")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_full","panic")
	await novel_interface.show_dialog("... Nix?", "Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("The older girl peers at the Professor, who's sitting near us, rubbing his butt.")
	novel_interface.show_character("nyx_full","normal1")
	await novel_interface.show_dialog("That chair is at least a hundred and thirty years old. Experts say it's worth more than two million.", "Nix")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_full","upset")
	await novel_interface.show_dialog("Huh...?", "Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Nix turns around and lays a hand on my cheek.")
	novel_interface.show_character("nyx_full","smile")
	await novel_interface.show_dialog("You're dressed very nicely today, sweetie.", "Nix")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Her cold finger draws a line down my face, reaches my bone conduction earpiece, which she retrieves with a cold smile.")
	novel_interface.show_character("nyx_full","mock")
	await novel_interface.show_dialog("... So how do you plan to pay for that?", "Nix")

	print("=== 星尘降临篇第1话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
