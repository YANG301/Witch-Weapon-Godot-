# stardustdescends_ep19.gd - 星尘陨落篇第19话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	stardustdescends_ep19_script()

func play_script():
	pass

func stardustdescends_ep19_script():
	novel_interface.change_music("res://assets/audio/music/Witch's Confession.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_Recording.png")
	await novel_interface.show_dialog("Minha filha Nasha faz sete anos este ano, e ultimamente adora me arrastar para montar quebra-cabeças com ela.", "Gravação")
	await novel_interface.show_dialog("Às vezes eu finjo de propósito estar sem vontade ou ocupado, e só aceito \"a contragosto\" depois de vê-la implorar por um bom tempo.", "Gravação")
	await novel_interface.show_dialog("Na verdade, eu adoro brincar com ela... mas, quando Nasha faz manha, fica simplesmente adorável demais.", "Gravação")
	await novel_interface.show_text_only("Uma explosão de risos do público vazou da gravação.")
	await novel_interface.show_dialog("O quebra-cabeça com que brincávamos era de um tipo novo, bem diferente dos que eu tinha quando criança--", "Gravação")
	await novel_interface.show_dialog("Cada peça tinha de um lado uma tela colorida de e-ink exibindo uma imagem fixa, então, à primeira vista, ele quase não se distinguia de um quebra-cabeça tradicional.", "Gravação")
	await novel_interface.show_dialog("Mas, à medida que você o completava e encaixava a última peça, cada parte se iluminava e a imagem do quebra-cabeça começava a se mover...", "Gravação")
	await novel_interface.show_dialog("Ainda me lembro muito bem da primeira vez que o vi. No começo achei que estávamos montando aquela famosa fotografia da Terra chamada \"Blue Marble\"--", "Gravação")
	await novel_interface.show_dialog("Mas quando minha filha colocou a última peça, toda a imagem começou a se mover: a câmera recuou, passando pela Lua, Marte, Júpiter...", "Gravação")
	await novel_interface.show_dialog("Em seguida, voou para fora do sistema solar, além de inúmeras estrelas, e finalmente revelou toda a Via Láctea.", "Gravação")
	await novel_interface.show_dialog("Nasha deu um pulo de excitação, gritando enquanto balançava meu braço, assim como eu fiz na primeira vez que completei um experimento de curvatura de luz de matéria heterogênea...", "Gravação")
	await novel_interface.show_dialog("Acredito que todos aqui já passaram por um momento assim.", "Gravação")
	await novel_interface.show_dialog("Naquele dia, saí correndo do laboratório de chinelos e calças de pijama, gritando até chegar ao escritório de um professor de microbiologia da nossa universidade.", "Gravação")
	await novel_interface.show_dialog("O velho me disse uma vez que se eu conseguisse realizar o experimento, ele abriria aquela cara garrafa de saquê japonês que seu aluno lhe dera...", "Gravação")
	await novel_interface.show_dialog("Aquela bebida quase me sufocou até a morte. Ainda não consigo acreditar que é vendido por tanto.", "Gravação")
	await novel_interface.show_text_only("O público caiu na gargalhada e alguns deles aplaudiram.")
	await novel_interface.show_dialog("Mais tarde, gradualmente fui compreendendo que o processo de estudar matéria heterogênea é realmente muito parecido com montar um quebra-cabeça.", "Gravação")
	await novel_interface.show_dialog("Antes que o enigma seja finalmente resolvido, tudo o que você pode fazer é tentar coisas com base na intuição e em algumas pistas.", "Gravação")
	await novel_interface.show_dialog("É como montar um quebra-cabeça: primeiro você encontra os quatro cantos e os usa como axiomas, como fulcros lógicos.", "Gravação")
	await novel_interface.show_dialog("Depois, começando pelos cantos, você faz todo o possível para fechar a moldura.", "Gravação")
	await novel_interface.show_dialog("Assim como você começa com os axiomas mais básicos e gradualmente obtém conclusões logicamente consistentes.", "Gravação")
	await novel_interface.show_dialog("Então, dentro desse quadro completo, você continua fazendo tentativas de tentativa e erro, avançando passo a passo em direção ao núcleo desconhecido...", "Gravação")
	await novel_interface.show_dialog("O processo é longo e cansativo, e só quando a última peça estiver no lugar poderemos vislumbrar a verdade do mundo.", "Gravação")
	await novel_interface.show_dialog("Durante esse tempo, você pode deixar sua imaginação correr solta em antecipação, imaginando que tipo de panorama magnífico você verá.", "Gravação")
	await novel_interface.show_dialog("Acredito que essa seja a parte mais cativante da pesquisa científica e a razão pela qual a maioria de nós persevera!", "Gravação")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Clique--")
	await novel_interface.stop_music()
	await novel_interface.show_text_only("Quando os aplausos do público estavam prestes a aumentar, a gravação foi interrompida abruptamente.")
	novel_interface.change_music("res://assets/audio/music/Normal Stage.mp3")
	novel_interface.show_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("Esta foi uma gravação que Mariru encontrou no computador de um pesquisador falecido.", "Aya")
	novel_interface.change_expression("wink")
	await novel_interface.show_dialog("Supostamente foi parte de uma palestra privada que Mushar deu na 30ª Conferência Solvay, há mais de uma década.", "Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("akiko","shock")
	await novel_interface.show_dialog("Quem falou foi... Walid Mushar?", "Akiko")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Akiko ficou um pouco surpresa. Por um momento, ela não conseguiu conectar aquela voz refinada e descontraída com o implacável líder terrorista.")
	novel_interface.show_character("akiko","normal")
	await novel_interface.show_dialog("A 30ª Conferência Solvay... isso foi em 2026, certo?", "Akiko")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Esta conferência acadêmica, fundada pelo industrial belga Ernest Solvay, convidou os principais cientistas do mundo da época para todas as sessões.")
	await novel_interface.show_text_only("Acontecia uma vez a cada três anos e, embora as guerras e as turbulências políticas tenham feito com que fosse suspenso várias vezes, continua até hoje.")
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("É isso mesmo, um ano antes do início da guerra...", "Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Naquela época, Mushar não poderia imaginar que, alguns meses depois daquele discurso, a sua esposa e filha acabariam mortas na rua devido ao derramamento de sangue étnico cego.")
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("Na altura, os tratados internacionais proibiam a investigação de matérias heterogéneas, pelo que as discussões em conferências académicas como esta só podiam ser realizadas em privado.", "Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("Mas no ano seguinte todos os países arrancaram a máscara, e a maioria das pessoas que participaram naquela conferência já não estão vivas...", "Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Um lampejo de melancolia passou pelo rosto de Aya, mas ela rapidamente voltou ao normal.")
	await novel_interface.show_text_only("Ela acessou transmissões ao vivo de dezenas de plataformas de mídia diferentes na tela grande e, sem exceção, todas mostravam a cerimônia de assinatura de Masada.")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_SigningCeremony.png")
	await novel_interface.show_text_only("Tudo parecia estar indo bem, sem nenhum relato sobre a explosão que Emily havia causado perto do local do evento mais cedo.")
	await novel_interface.show_text_only("Após a conclusão do longo processo de assinatura de documentos, os representantes de Masadan e da resistência caminharam juntos e pressionaram as palmas das mãos sobre uma tela.")
	await novel_interface.show_text_only("Suas impressões palmares, juntamente com o texto do acordo, foram carregadas on-line em tempo real, e o sistema de defesa da cidade de Massada começou imediatamente a atualizar seu protocolo de defesa.")
	await novel_interface.show_text_only("Ao mesmo tempo, a resistência apresentou voluntariamente ficheiros digitais de mais de duzentos mil membros que apoiaram o acordo de cessar-fogo.")
	await novel_interface.show_text_only("A partir de agora, desde que essas pessoas deponham as armas, serão livres de entrar e sair da maior parte das áreas de Massada como cidadãos comuns.")
	await novel_interface.show_text_only("O preço era que eles tivessem que usar pulseiras de rastreamento por dois anos e serem colocados sob o sistema de vigilância de Monola.")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_SigningCeremony1.png")
	await novel_interface.show_text_only("Ao final da cerimônia, os dois representantes trocaram documentos e apertaram as mãos diante da mídia.")
	await novel_interface.show_text_only("O major-general das Forças de Defesa e o líder da resistência apertaram as mãos diante das câmeras por três minutos completos.")
	await novel_interface.show_text_only("O sorriso exagerado de Hamon estava quase congelado em seu rosto, enquanto Mushar apenas manteve o sorriso calmo.")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	await novel_interface.show_text_only("Aya olhou para a boca aberta na tela e depois olhou para as informações que havia coletado sobre o homem nas redes sociais ontem.")
	novel_interface.show_character("ai","dizzy")
	await novel_interface.show_dialog("Hamon, hein...\nNão admira que o exército o tenha apelidado de \"Sapo\"~", "Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Vendo que Mariru ainda não havia voltado, Akiko tirou os óculos e respirou naturalmente nas lentes.")
	await novel_interface.show_text_only("Enquanto ela os limpava, uma mecha de cabelo que estava presa na têmpora escorregou pela costeleta, e sua expressão e comportamento instantaneamente se tornaram como os de outra pessoa...")
	novel_interface.show_character("akikounglass")
	await novel_interface.show_dialog("Esse cara é o porta-estandarte da facção falcão dentro das Forças de Defesa de Masada.", "Akiko")
	await novel_interface.show_dialog("Seus apoiadores o elogiam como um herói que protegeu a nação. Seus oponentes o chamam de açougueiro encharcado de sangue...", "Akiko")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aya percebeu a mudança no tom de Akiko e olhou para a imagem do vídeo com curiosidade evidente.")
	await novel_interface.show_text_only("Akiko não pareceu se importar e continuou relembrando.")
	novel_interface.show_character("akikounglass")
	await novel_interface.show_dialog("Naquela época, Hamon seguiu seu tio, o primeiro-ministro Schneiderman, que era então tenente-general do Exército da Restauração, e lutou na Defesa de Massada.", "Akiko")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("Aquele em que eles mudaram as coisas com \"Phantom Force\" depois de ficarem sem munição e suprimentos?", "Aya")
	await novel_interface.show_dialog("Isso certamente o qualifica para concorrer a um cargo público...", "Aya")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("Parece que todos os oficiais superiores que participaram dessa batalha e ainda estão vivos agora ocupam um posto importante nas forças armadas ou no governo.", "Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aya, que normalmente não tinha interesse em política, fez seu próprio julgamento com base nas informações que reuniu e organizou com a IA na noite passada.")
	novel_interface.show_character("akikounglass")
	await novel_interface.show_dialog("Menos de dez desses oficiais ainda estão vivos, e cada um deles é um herói de guerra que também conhece os principais segredos do país...", "Akiko")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("A verdade sobre \"Phantom Force,\" huh... Eles certamente protegeram bem esse segredo.", "Aya")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Mas há outras razões pelas quais Hamon recebe tanto apoio, certo? Ouvi dizer que as Forças de Defesa já teriam falido há muito tempo se não fosse pela sua gestão eficiente...", "Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("akikounglass")
	await novel_interface.show_dialog("Gestão?\nChame isso de pilhagem.", "Akiko")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Akiko não fez nenhum esforço para esconder seu desprezo por ele.")
	novel_interface.show_character("akikounglass")
	await novel_interface.show_dialog("Além de contornar a lei internacional em todas as áreas cinzentas possíveis, ele impôs a segregação racial na zona militar e expandiu enormemente a autoridade de disparo de armas não tripuladas...", "Akiko")
	await novel_interface.show_dialog("Os oficiais de inteligência da Palantir julgaram que se este homem assumisse o poder, a primeira coisa que faria seria aprovar a Lei Étnica Nacional.", "Akiko")
	await novel_interface.show_dialog("Afinal, o Grande Rabino já deixou explícito o seu apoio a Hamon...", "Akiko")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aya não tinha ideia de como responder a um tópico político tão avançado, então ela pesquisou silenciosamente “Lei Étnica Nacional”.")
	await novel_interface.show_text_only("Uma enxurrada de palavras-chave como “segregação racial” apareceu abaixo.")
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("(Humanos são realmente chatos...)", "Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("akikounglass")
	await novel_interface.show_dialog("Aliás, por que a Mariru ainda não voltou...\nEssa bebida estava muito boa, né?", "Akiko")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Relaxe, essa mulher é durona...", "Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aya abriu uma nova garrafa de energético e tomou um gole. Ela parecia muito mais acordada instantaneamente.")
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("Ela provavelmente está agachada no banheiro pensando agora...", "Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("akikounglass")
	await novel_interface.show_dialog("...Pensando em como executar você?", "Akiko")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","blush_dizzy")
	await novel_interface.show_dialog("Pensando no plano da Famur~!!", "Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mesmo depois de reunir uma montanha de informações, Aya ainda não tinha ideia de qual seria a forma do ataque iminente da resistência.")
	await novel_interface.show_text_only("Ela obteve outra série de imagens de satélite perto do Mar Morto.")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_SatelliteDustStorm.png")
	await novel_interface.show_text_only("Nas imagens meteorológicas de satélite em tempo real, a tempestade de areia parecia uma poça de água suja espalhando-se desenfreadamente pela superfície da Terra.")
	await novel_interface.show_text_only("A essa altura, aquela poça havia engolido completamente o Grand Canyon de Mujib, na costa leste do Mar Morto, e estava rolando em direção à Fortaleza de Masada, a sudoeste...")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	await novel_interface.show_text_only("Aya examinou a favela de Masada mais duas vezes com um satélite SID e não encontrou nenhum vestígio de flutuações de fase no espaço-tempo.")
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("Mesmo que realmente existisse alguma arma de matéria heterogênea capaz de bloquear ondas eletromagnéticas, ela deveria estar atualmente inativa.", "Aya")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("Caso contrário, as imagens de satélite das favelas já teriam se transformado em um borrão distorcido devido aos efeitos de curvatura da luz...", "Aya")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Atacar a Fortaleza de Masada, fortemente defendida, sem armas de matéria heterogênea?", "Akiko")
	await novel_interface.show_dialog("Mesmo que as armas de defesa da IA estivessem 100% danificadas, isso ainda seria impossível...", "Akiko")
	await novel_interface.show_dialog("Pelo tamanho das equipes de ataque que Lian descreveu, esses terroristas não durariam vinte minutos. Eles não poderiam colocar os pés no centro da cidade.", "Akiko")
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("Algo está definitivamente errado...", "Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Tal como Mariru disse, desta vez Mushar entregou-se a si mesmo e a centenas de milhares de camaradas da resistência.")
	await novel_interface.show_text_only("Se fosse realmente para lançar um ataque, então, como um jogador que escolhe ir all-in na mesa, ele estaria determinado a derrubar o adversário nesta mesma rodada.")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_doomsday.png")
	await novel_interface.show_text_only("Mais difícil ainda, eles operavam sob uma condição implícita: não poderiam acionar o sistema de retaliação automática de Masada.")
	await novel_interface.show_text_only("Se não se importassem com o sistema de retaliação automática, a resistência poderia simplesmente manter a sua estratégia anterior e continuar a espremer o espaço de Masada.")
	await novel_interface.show_text_only("Um dia, os sistemas sociais e económicos de Massada entrariam em colapso total e então a resistência poderia facilmente tomar a cidade de frente.")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	await novel_interface.show_text_only("Aya olhou silenciosamente para a tela grande, mergulhando em pensamentos enquanto o tempo passava segundo após segundo...")
	await novel_interface.show_dialog("Aaaahhh, não faço a mínima ideia!!!", "Aya")
	await novel_interface.show_text_only("Como uma estudante incapaz de resolver uma questão de exame com pontuação alta, Aya de repente bateu a testa com força no teclado do console, assustando Akiko.")
	await novel_interface.show_dialog("Como você aniquila ou toma o centro da cidade de Masada sem acionar o sistema de retaliação automática...", "Aya")
	await novel_interface.show_text_only("Ainda enterrando a cabeça no teclado, Aya murmurou para si mesma.")
	await novel_interface.show_dialog("Estou pensando nesse problema há semanas e é totalmente impossível!!", "Aya")
	await novel_interface.show_dialog("...Por semanas?", "Akiko")
	await novel_interface.show_dialog("...Por que você gasta seu tempo livre pensando em coisas assim?", "Akiko")
	await novel_interface.show_dialog("Uh--\nBem...", "Aya")
	await novel_interface.show_text_only("Aya levantou a cabeça, com várias marcas vermelhas impressas em sua testa pelo teclado, e respondeu fracamente.")
	novel_interface.show_character("ai","blush_stare")
	await novel_interface.show_dialog("É assim que mato o tempo quando meu cérebro está ocioso... Tenho pensado nisso desde o dia em que Masada anunciou o sistema de retaliação automática.", "Aya")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("...Você é um demônio?!", "Akiko")
	await novel_interface.stop_music()
	await novel_interface.hide_background_with_fade()
	await novel_interface.show_text_only("...")
	await novel_interface.show_text_only("Enquanto isso, fora do local da cerimônia de assinatura.")
	novel_interface.change_music("res://assets/audio/music/Story_01.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_MasadAPCRS.png")
	await novel_interface.show_text_only("Com o passar do tempo, sentei-me enrolado em minha cadeira com os joelhos abraçados com força, esperando ansiosamente pela “ordem de evacuação” que Mariru havia mencionado.")
	novel_interface.show_character("ren_medical","gratified")
	await novel_interface.show_dialog("(As meninas realmente parecem achar mais fácil sentar-se abraçando os joelhos...)", "Lian")
	novel_interface.change_expression("uneasy")
	await novel_interface.show_dialog("(É que minha bunda está um pouco fria...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("A transmissão televisiva da cerimônia de assinatura estava na tela do console. Aparentemente até o diretor achou que o aperto de mão havia demorado muito, porque a transmissão foi cortada para o estúdio.")
	await novel_interface.show_text_only("Os apresentadores do estúdio começaram a conversar ociosamente com o convidado, enquanto eu olhava distraidamente para o rádio militar que Emily havia colocado em minhas mãos na noite passada.")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_UAVs.png")
	await novel_interface.show_text_only("De repente, a transmissão ao vivo mudou para fora do local e o cinegrafista aumentou o zoom da lente telefoto em direção ao céu acima do muro de isolamento do centro da cidade.")
	await novel_interface.show_text_only("As vozes do convidado e do repórter de campo aumentaram ao mesmo tempo, enquanto vários grupos de drones patrulhadores acima do muro começavam a descer em uníssono.")
	await novel_interface.show_text_only("De acordo com o procedimento, os drones que patrulham ao longo do muro de isolamento retornam aos seus berços em doze grupos rotativos para atualizar seus protocolos de defesa.")
	await novel_interface.show_text_only("À medida que as armas defensivas que normalmente circulavam acima do muro durante todo o ano desciam gradualmente e desapareciam atrás dele, a repórter no local tornou-se intensamente emocionada.")
	await novel_interface.show_text_only("Sua voz tremia à beira das lágrimas enquanto ela elogiava o significado histórico do momento e continuava falando sobre como a paz finalmente havia chegado.")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_APC_Wall.png")
	novel_interface.show_character("ren_medical","wry_smile")
	await novel_interface.show_dialog("(Vamos lá...)\n(Esses drones vão voar de volta depois de atualizarem seus protocolos, não vão?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("E, além disso, ela era claramente da Samonton TV, uma típica caucasiana de cabelos loiros e olhos azuis, mas parecia mais animada do que a maioria dos repórteres locais.")
	novel_interface.show_character("ren_medical","wry_smile")
	await novel_interface.show_dialog("Então, alguns meios de comunicação realmente começam a chorar na hora ~", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("De repente, isso me atingiu. Não é à toa que insistiram em realizar uma cerimônia de assinatura em ambiente fechado ao amanhecer, antes da chegada da tempestade de areia.")
	novel_interface.show_character("ren_medical","stare")
	await novel_interface.show_dialog("Se esperassem mais, provavelmente só conseguiriam filmar um céu cheio de poeira amarela...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Emily estava certa. A jogada de Hamon foi realmente absurdamente eficaz.")
	novel_interface.show_character("ren_medical","normal2")
	await novel_interface.show_dialog("Emily e Vera...\nElas deveriam ficar bem, certo?", "Lian")
