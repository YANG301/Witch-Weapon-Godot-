# stardustdescends_ep13.gd - 星尘降临篇第13话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	stardustdescends_ep13_script()

func play_script():
	pass

func stardustdescends_ep13_script():
	novel_interface.change_music("res://assets/audio/music/Story_01.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_MasadSentry.png")
	await novel_interface.show_text_only("A juzgar por las imágenes del monitor del vehículo, al frente había una sección del muro de aislamiento aún en construcción.")
	await novel_interface.show_text_only("Debido a que esto estaba en el borde del centro de la ciudad, no tenía nada de la sensación de prosperidad y paz del distrito central...")
	await novel_interface.show_text_only("El acero, el hormigón y el polvo restauraron la textura cruda y áspera de una zona de guerra desértica.")
	await novel_interface.show_text_only("El puesto de control que tenía delante había sido construido como una fortaleza y varios vehículos blindados del mismo modelo estaban estacionados a su alrededor.")
	await novel_interface.show_text_only("A lo lejos, muchas grúas torre y máquinas pesadas estaban trabajando, y más allá del muro se podían ver vagamente enjambres de drones en el cielo.")
	await novel_interface.show_text_only("Por la forma en que estaban dispuestas las barricadas metálicas, la salida de delante parecía claramente cerrada al tráfico.")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_MasadAPCO2.png")
	novel_interface.show_character("ren_medical","wail")
	await novel_interface.show_dialog("¿Quieres... abrirte camino a la fuerza?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Emily golpeó con los nudillos la pared interior del APC.")
	novel_interface.show_character("emilio","speechless")
	await novel_interface.show_dialog("¿Con esto?", "Emily")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("La armadura es resistente, pero conduce el calor como el metal común. Probablemente duraríamos unos veinte segundos antes de que nos asaran vivos~", "Emily")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("De repente el vehículo se detuvo. Una voz familiar vino desde la cabina del conductor.")
	await novel_interface.show_dialog("Vera Valkyrie, Suboficial de Primera Clase del Batallón Caracal, recogiendo personal del campamento para realizar reconocimientos fuera de la ciudad.", "Vera")
	novel_interface.show_character("ren_medical","wry_smile")
	await novel_interface.show_dialog("(Esa es la mujer de seguridad súper fuerte del barco casino, ¿no es así?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Todavía la recordaba vívidamente levantando ese enorme obispo principal con una sola mano.")
	await novel_interface.show_dialog("Oh, es Vera. En este momento hay una protesta en el mercado Yehuda. Si no quieres empantanarte, será mejor que tomes otra salida...", "Voz masculina")
	await novel_interface.show_dialog("Deja de hablar y déjanos pasar ya. ¡No tenemos tiempo para desviarnos!", "Vera")
	await novel_interface.show_dialog("Jaja, bien, bien. Simplemente no provoques más problemas. La última vez que tu padre llamó desde el cuartel general del Estado Mayor sólo para regañar a la gente...", "Voz masculina")
	await novel_interface.show_dialog("Vuelve a mencionarlo y te atropellaré.", "Vera")
	await novel_interface.show_dialog("Mueva el obstáculo. ¡Déjenlos pasar, déjenlos pasar!", "Voz masculina")
	await novel_interface.show_text_only("Emily se inclinó y me susurró.")
	novel_interface.show_character("emilio","mock")
	await novel_interface.show_dialog("Entonces, ¿tuviste ese breve momento en el que pensaste en gritar pidiendo ayuda... y luego te acobardaste?", "Emily")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","shy_left")
	await novel_interface.show_dialog("¡Por supuesto que no!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Rápidamente volví la cabeza. ¡Uf, ella es tan desagradable!")
	await novel_interface.show_text_only("El vehículo avanzó lentamente y pronto atravesó el muro de aislamiento hacia las afueras de la ciudad de Masada.")
	await novel_interface.show_text_only("Supuse que la ciudad exterior estaría aún más desolada, pero después de que cruzamos el muro de aislamiento, la cantidad de personas en el camino aumentó repentinamente...")
	await novel_interface.show_text_only("Las carreteras allí eran más accidentadas y había menos rascacielos y zonas verdes, pero las calles estaban inesperadamente animadas.")
	await novel_interface.show_text_only("Las multitudes, los autobuses yendo y viniendo y los vendedores ambulantes pregonando mercancías me hicieron sentir como si me hubiera deslizado en el tiempo.")
	novel_interface.show_character("ren_medical","gratified")
	await novel_interface.show_dialog("Hay tanta gente aquí...", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("emilio","smile",0.25)
	await novel_interface.show_dialog("Por supuesto. El noventa por ciento de la población de esta ciudad vive fuera del muro de aislamiento.", "Emily")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("¿¡Tantos!?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("El centro de la ciudad tiene sólo 32 kilómetros cuadrados en total, menos de una cuarta parte del área total de Masada, y los precios de la tierra son escandalosos ~", "Emily")
	await novel_interface.show_dialog("Especialmente en el distrito central. Con la superficie de un solo baño se podría comprar un estudio junto al Mar Muerto.", "Emily")
	novel_interface.character_light(0.35,"wry_smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Pensé que el muro de aislamiento era para eso... ya sabes...", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("¿Segregación racial?", "Emily")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Bien, bien. ¿No existe alguna regla según la cual ciertas palabras ofensivas para un grupo específico sólo pueden ser dichas por personas de ese grupo?")
	novel_interface.show_character("emilio","mock")
	await novel_interface.show_dialog("El Consejo Unido prohibió ese tipo de cosas hace mucho tiempo~", "Emily")
	await novel_interface.show_dialog("Pero la Ley Antiterrorista de Masada dice que si uno quiere residir a largo plazo en el centro de la ciudad donde están ubicados el gobierno y el parlamento, debe pasar una revisión de la Oficina de Seguridad.", "Emily")
	await novel_interface.show_dialog("Y los solicitantes cuya familia inmediata pertenece a ciertos grupos étnicos resulta que nunca pasan... ¿entiendes?", "Emily")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Asentí, comprendiendo sólo a medias.")
	await novel_interface.show_text_only("¡Así que eso es segregación!\nIncluso si suena como si se estuvieran segregando ellos mismos...")
	await novel_interface.show_text_only("Y si eso es cierto, entonces incluso la mayoría de los habitantes étnicos de Masadan también deben vivir en las afueras de la ciudad, ¿verdad?")
	await novel_interface.show_text_only("En la pantalla vi a una mujer soldado con un M16 colgado al hombro en cuclillas frente a un puesto callejero que vendía adornos para el cabello, regateando con una vendedora cuyo rostro estaba envuelto en un pañuelo en la cabeza.")
	novel_interface.show_character("ren_medical","wail")
	await novel_interface.show_dialog("(Resulta que nadie puede permitirse una vivienda, sin importar de dónde sea...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("De repente el vehículo frenó con fuerza. Mi cabeza casi golpea la pantalla y las malas palabras de Vera resonaron desde la cabina del conductor.")
	await novel_interface.show_dialog("¡¡Maldita sea!!", "Vera")
	novel_interface.show_character("emilio","shout")
	await novel_interface.show_dialog("¿¡Qué pasó!?", "Emily")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Lancé un dron explorador. Simplemente miren la pantalla ustedes mismos.", "Vera")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Emily y yo corrimos hacia la pantalla y vimos una escena que me puso la piel de gallina.")
	#novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_AncientHumanEH.png") #原游戏有素材，但已丢失
	await novel_interface.show_text_only("Más de mil hombres con abrigos y sombreros negros estaban reunidos en la intersección más adelante, como si se tratara de un funeral multitudinario.")
	await novel_interface.show_text_only("Llevaban carteles de protesta caseros en blanco y negro, como si objetaran la existencia de otros colores en el mundo.")
	await novel_interface.show_text_only("La mayoría de ellos tenían barbas enormes y pequeñas trenzas extrañas en las sienes. Esa mirada se sentía terriblemente familiar...")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_MasadAPCR1.png")
	await novel_interface.show_dialog("¡Estas mierdas inútiles! ¡Viven de los subsidios estatales y todavía protestan todos los malditos días!", "Vera")
	await novel_interface.show_text_only("Supongamos que \"bip\" es algún tipo de dialecto... De todos modos, no pude entenderlo.")
	await novel_interface.show_dialog("¿Quieren que se duplique el número de escuelas primarias que coinciden con su doctrina? \n ¿¡Esos malditos rizos laterales han crecido en sus cerebros!?", "Vera")
	await novel_interface.show_text_only("Escuché patadas desde la puerta de la cabaña. Aparentemente nuestro conductor había saltado para buscar pelea.")
	novel_interface.show_character("ren_medical","wail")
	await novel_interface.show_dialog("¿Qué está haciendo?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("emilio","mock",0.25)
	await novel_interface.show_dialog("Voy a cubrir los platos~", "Emily")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Emily respondió distraídamente mientras revisaba el mapa de ruta en su robusta tableta militar.")
	novel_interface.show_character("ren_medical","wry_smile")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("emilio","mock",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("¿Q-Qué va a hacer ella...? Esas personas son masadanses, ¿no?\nCreo que acabo de ver a algunos de ellos en el museo...", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"stare")
	await novel_interface.show_dialog("Son el grupo del \"patrimonio histórico\" de Masada. No trabajan, no pagan impuestos, no sirven en el ejército y el gobierno todavía tiene que darles subsidios mensuales...", "Emily")
	await novel_interface.show_dialog("Incluso si alteran el orden público y bloquean el tráfico, la policía y el ejército no pueden tocarlos porque tienen sus propios tribunales religiosos.", "Emily")
	novel_interface.character_light(0.35,"stare")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("...¿Eso es tan bueno?", "Lian")
	novel_interface.change_expression("uneasy")
	await novel_interface.show_dialog("(¿No significaría eso que podrías quedarte en casa y jugar todos los días...?)", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"mock")
	await novel_interface.show_dialog("Pero su doctrina dice que no puede haber televisores ni computadoras en el hogar, y el acceso a Internet está estrictamente prohibido.", "Emily")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("¡¡Eso es una tortura!!")
	novel_interface.show_character("ren_medical","uneasy")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("emilio","speechless",0.25)
	await novel_interface.show_dialog("Pero sus esposas son diferentes. Se les permite usar dispositivos electrónicos porque esos hombres dependen de las mujeres para ganar dinero y ayudar a mantener el hogar.", "Emily")
	novel_interface.change_2nd_expression("stare")
	await novel_interface.show_dialog("No es porque los subsidios sean demasiado pequeños. Esto se debe a que las mujeres de esas familias tienen un promedio de seis o siete hijos, y algunas tienen más de una docena.", "Emily")
	novel_interface.change_2nd_expression("speechless")
	await novel_interface.show_dialog("Tantos niños. No es de extrañar que las escuelas religiosas no sean suficientes...", "Emily")
	novel_interface.character_light(0.35,"bored")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("(¿Podrían los diez y tantos niños que vi agrupados alrededor de esos dos hombres barbudos vestidos de negro en el museo haber sido...)", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Y las dos mujeres demacradas que los seguían...")
	await novel_interface.show_text_only("Cuando pensé en el cochecito que uno de ellos había estado empujando, un escalofrío recorrió mi espalda.")
	novel_interface.show_character("emilio","speechless")
	await novel_interface.show_dialog("Los fundamentalistas religiosos son un cáncer, no importa a dónde vayas...", "Emily")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Emily siguió jugueteando con su tableta con la cabeza gacha, su tono transmitía una extraña tristeza y un toque de resignación.")
	await novel_interface.show_text_only("Al poco tiempo, Vera regresó al vehículo y Emily dio unas palmaditas en la partición metálica de la cabina para recordárselo.")
	novel_interface.show_character("emilio","smile")
	await novel_interface.show_dialog("Vaya hasta la tercera intersección en el lado este. Allí hay un paso elevado recién terminado. Es la ruta más rápida para salir de la ciudad.", "Emily")
	await novel_interface.show_dialog("Y además, si vas a hacer \"eso\", recuerda dar la vuelta al vehículo primero.", "Emily")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Lo tengo ~", "Vera")
	await novel_interface.show_text_only("Vera giró el volante hasta el límite y pisó el acelerador, haciendo girar la parte delantera en un giro sin la menor preocupación por la comodidad del pasajero.")
	await novel_interface.show_text_only("Un momento después, se escucharon cuatro golpes sordos desde el techo del vehículo: ruido sordo, ruido sordo, ruido sordo, ruido sordo.")
	novel_interface.show_character("ren_medical","panic")
	await novel_interface.show_dialog("(Espera, ¿por qué eso sonó como un lanzagranadas...?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Muy pronto, los hombres de negro reunidos comenzaron a entrar en pánico, cuando columnas de humo blanco de gas lacrimógeno surgieron de cuatro puntos diferentes entre la multitud...")
	await novel_interface.show_text_only("Y nuestro vehículo pisó el suelo y desapareció al doblar la esquina.")
	await novel_interface.stop_music()
	await novel_interface.hide_background_with_fade()
	await novel_interface.show_text_only("...")
	await novel_interface.show_text_only("............")
	await novel_interface.show_text_only("A medida que la sombra del muro de aislamiento se hacía más pequeña detrás de mí, la tierra a ambos lados de la carretera gradualmente se volvió árida.")
	await novel_interface.show_text_only("Después de permanecer en la ciudad durante tanto tiempo, era fácil olvidar que Masadaburg era una ciudad abrupta construida en el desierto.")
	await novel_interface.show_text_only("El APC aceleró por una carretera vacía y no había señales de vida humana en ningún lado de la carretera solitaria.")
	await novel_interface.show_text_only("Sólo unos pocos arbustos secos aún permanecían obstinadamente en la arena...")
	novel_interface.change_music("res://assets/audio/music/unkown/Battle_08.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_StagingPost.png")
	await novel_interface.show_text_only("Después de aproximadamente una hora fuera de la ciudad, la puerta del compartimento de tropas se abrió lentamente y apareció ante mí una estación de suministros militares.")
	novel_interface.show_character("valkyrja","normal")
	await novel_interface.show_dialog("Esto es todo. ¿Quieres que ella te ayude?", "Vera")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","perspire1")
	await novel_interface.show_dialog("¡¿Eh?!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("emilio","smile")
	await novel_interface.show_dialog("No hay problema. Ella cooperará.", "Emily")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","wry_smile")
	await novel_interface.show_dialog("Ni siquiera te preocupa que me escape...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Protesté mientras salía del vehículo muy obedientemente, pero me tragué el resto a mitad de camino.")
	novel_interface.show_character("ren_medical","wail")
	await novel_interface.show_dialog("(Es un desierto vacío en todas direcciones. ¿Adónde exactamente podría correr...?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Esta estación de suministro hundida estaba escondida entre las dunas. Desde lejos parecía un montículo de tierra más en una colina árida.")
	await novel_interface.show_text_only("Aún así, claramente había estado abandonado durante bastante tiempo...")
	await novel_interface.show_text_only("Probablemente porque un lugar como este cuesta demasiado mantener y porque la resistencia ya había abandonado el área circundante.")
	await novel_interface.show_text_only("El jeep estacionado dentro de la estación estaba cubierto por una gruesa capa de polvo, y enormes montones de sacos de arena destinados a la construcción de fortificaciones estaban apilados descuidadamente por todas partes.")
	await novel_interface.show_text_only("La carretilla elevadora y el generador apoyados contra la pared estaban cubiertos de óxido y cicatrices dejadas por el viento y la arena. En un rincón también había algunas cajas de municiones volcadas...")
	await novel_interface.show_text_only("De vuelta en el vehículo, Emily había respondido mi segunda pregunta: ¿cuál era exactamente el \"asunto personal\" que estaban aquí para hacer?")
	await novel_interface.show_text_only("De hecho, ya había adivinado parte de ello. Tenía que ver con mi identidad encubierta...")
	await novel_interface.show_text_only("Según Emily, el hecho de que las ONG en zonas de guerra transporten cualquier tipo de suministros militares viola los convenios internacionales.")
	await novel_interface.show_text_only("Obtener exenciones de ambas partes en nombre de ayudar a civiles inocentes, para luego ayudar a una de las partes, es una grave violación de la ética.")
	await novel_interface.show_text_only("Pero en los últimos años, el ejército de Masadan ha disfrazado muchos puestos militares como instalaciones de ayuda civil y ha sobornado a ONG para que les transporten suministros.")
	await novel_interface.show_text_only("De esa manera pueden controlar con mayor flexibilidad la resistencia guerrillera y cada vez que uno de esos puestos de avanzada es destruido, pueden denunciarlo en voz alta como un ataque terrorista contra inocentes.")
	await novel_interface.show_text_only("Lo que estaban aquí para hacer era secuestrar ese tipo de suministro del mercado gris.")
	await novel_interface.show_text_only("Usando el código de ayuda de emergencia en mi placa, Emily encontró información sobre el vehículo más adecuado para el objetivo.")
	await novel_interface.show_text_only("Originalmente, esa función estaba destinada a localizar y solicitar suministros de socorro de las ONG más cercanas en caso de emergencia.")
	novel_interface.show_character("emilio","smile")
	await novel_interface.show_dialog("El camión transporta principalmente suministros médicos militares. Pasará por aquí por la autopista en cuarenta minutos.", "Emily")
	await novel_interface.hide_character()
	novel_interface.show_character("valkyrja","happy")
	await novel_interface.show_dialog("Iré a poner barricadas y minas. Ustedes dos preparen las ametralladoras y los altavoces.", "Vera")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","shy")
	await novel_interface.show_dialog("...¿Altavoces?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mi mano se movió hacia mi pecho por reflejo.")
	await novel_interface.show_text_only("Vera quitó las cubiertas protectoras del equipo del vehículo una por una. Me había estado preparando, pero aún así me sobresalté...")
	await novel_interface.show_text_only("Un gran robot de carga cuadrúpedo, dos filas de barricadas controladas remotamente, seis ametralladoras con puntería automática, cuatro altavoces y un montón de pequeñas bombas remotas...")
	await novel_interface.show_text_only("... ¿¡Qué diablos estaban planeando hacer!?")
	await novel_interface.show_text_only("Emily y yo utilizamos rápidamente la capacidad de carga del robot de carga para desplegar las ametralladoras y los altavoces en las colinas cercanas.")
	await novel_interface.show_text_only("Después de colocar barricadas y bombas, Vera siguió las instrucciones de Emily, llenó un jeep con gasolina y lo condujo detrás de una roca gigante junto a la carretera.")
	await novel_interface.show_text_only("Luego lanzaron el dron explorador desde lo alto del APC y ocultaron el vehículo perfectamente bajo una cubierta de camuflaje óptico.")
	await novel_interface.show_text_only("Por fin, los tres nos agachamos detrás de la colina más alta y esperamos en silencio a que apareciera el objetivo.")
	novel_interface.show_character("ren_medical","stare")
	await novel_interface.show_dialog("¿Realmente garantizas que nadie saldrá lastimado...?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Pregunté con inquietud. Las armas que acabábamos de instalar parecían suficientes para acabar con un pelotón entero.")
	novel_interface.show_character("valkyrja","wink")
	await novel_interface.show_dialog("Relájate. Este es un plan de Emily.", "Vera")
	await novel_interface.show_dialog("Todos en nuestro batallón saben que si es su plan, ¡está bien!", "Vera")
	await novel_interface.hide_character()
	novel_interface.show_character("emilio","mock")
	await novel_interface.show_dialog("Esas ametralladoras utilizan objetivos infrarrojos controlados por IA. Absolutamente no golpearán a la gente.", "Emily")
	await novel_interface.show_dialog("Y las bombas remotas también han sido modificadas. Básicamente no tienen mucho poder letal. Algunos son principalmente para hacer ruido, y otros simplemente sacan toneladas de humo...", "Emily")
	novel_interface.change_expression("shout")
	await novel_interface.show_dialog("¡Ah, ya viene el camión!", "Emily")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("La imagen del dron explorador mostró un camión con el logo rojo de la organización de ayuda médica conduciendo por la carretera.")
	await novel_interface.show_text_only("Cuando llegó al tramo cercano a la estación de suministros, explotó una bomba y la primera fila de barricadas apareció en un ángulo que sacudió el camión.")
	await novel_interface.show_text_only("El camión redujo la velocidad a paso lento. Pensando que se había reventado un neumático, el conductor se apresuró a comprobarlo.")
	novel_interface.show_character("emilio","angry")
	await novel_interface.show_dialog("¡Ahora!", "Emily")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("A la orden del teniente, comenzó el espectáculo de fuegos artificiales cuidadosamente organizado.")
