	await novel_interface.show_text_only("大廳出口處，一個軍官模樣的人用擴音器宣讀著接受安檢時的注意事項。")
	novel_interface.show_character("valkyrja","normal")
	await novel_interface.show_dialog("所有手錶、首飾和金屬物品都要取下以接受檢查。", "軍官")
