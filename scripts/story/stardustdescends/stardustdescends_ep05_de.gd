# stardustdescends_ep05.gd - 星尘降临篇第5话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	stardustdescends_ep05_script()

func play_script():
	pass

func stardustdescends_ep05_script():
	novel_interface.change_music("res://assets/audio/music/Shop.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_Vault.png")
	novel_interface.show_character("ren_full","panic")
	await novel_interface.show_dialog("Das ist also der Tresorraum an Bord der „Liberty Star“...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ich schaue mich erstaunt um. Decke, Boden und beide Wände sind mit spiegelglänzenden Metallpaneelen aus einem besonderen Material verkleidet.")
	await novel_interface.show_text_only("Ich vergleiche die Metallplatten mit dem Goldchip in meiner Hand. Die Farbe ist ähnlich, die Wände strahlen jedoch einen schwachen graugrünen Schimmer ab.")
	await novel_interface.show_text_only("Nur bestimmte VIP-Gäste dürfen die Safes im Frachtraum nutzen – und ich habe dieses Privileg gerade erst erhalten.")
	await novel_interface.show_text_only("Der einzige Weg rein oder raus ist der Aufzug im VIP-Bereich, und die Tür unten ist so dick wie eine Wand.")
	await novel_interface.hide_background()
	await novel_interface.show_dialog("(Keine Signale hier... Genau wie erwartet.)", "Lian")
	await novel_interface.show_text_only("Ich verlor mein Kommunikationsgerät, sobald ich den Aufzug betrat. Jetzt muss ich alles genau so machen, wie ich es während der Übung getan habe, und darf keinen einzigen Schritt falsch machen.")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_Vault.png")
	novel_interface.show_character("ren_full","solemn")
	await novel_interface.show_dialog("(Schritt eins: Bestätigen Sie, dass das Überwachungssystem ausgefallen ist ... OK.)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ich bemerke, dass mehrere Kameras im Tresorraum gleichzeitig blinken und dann alle dunkel werden.")
	await novel_interface.show_dialog("Fräulein, Ihr Safe hat die Nummer 1212. Bei jedem Öffnen müssen sowohl Ihr als auch unserer Schlüssel eingesteckt werden...", "Kellner")
	await novel_interface.show_text_only("Der Kellner dreht sich höflich um, um mir den Schlüssel zu geben, nur um eine Flasche „Parfüm“ direkt auf sein Gesicht gerichtet zu finden –")
	novel_interface.show_character("ren_full","wry_smile")
	await novel_interface.show_dialog("Es tut mir so leid!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Nach einem Sprühstoß ins Gesicht werden seine Augen sofort stumpf. Er scheint etwas sagen zu wollen, aber nachdem er den Mund ein paar Mal geöffnet hat, kommt kein Ton mehr heraus.")
	await novel_interface.show_text_only("Dieses Anästhesiespray ist ein neues SRD-Produkt. Aya fügte sogar ein Medikament hinzu, das die Hemmungskontrolle des Gehirns aufhebt.")
	await novel_interface.show_text_only("Wer davon besprüht wird, gelangt in einen hypnotischen Zustand und wird äußerst empfänglich für Suggestionen.")
	novel_interface.show_character("ren_full","smile")
	await novel_interface.show_dialog("Komm und steh hier.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ich führe den benommenen Kellner vorsichtig zu einem Platz direkt vor der Aufzugstür und schiebe ihm einen roten Chip in die Hand.")
	novel_interface.show_character("ren_full","solemn")
	await novel_interface.show_dialog("Ähm...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ich erinnere mich an die Zeilen, die ich immer wieder proben sollte, und spreche ihn mit fester Stimme an:")
	novel_interface.show_character("ren_full","normal1")
	await novel_interface.show_dialog("Du hast mich gerade hierher zum Tresor gebracht. Alles war normal.", "Lian")
	await novel_interface.show_dialog("Nachdem ich meinen Artikel eingelagert hatte, gab ich Ihnen als Trinkgeld einen Chip.", "Lian")
	novel_interface.change_expression("solemn")
	await novel_interface.show_dialog("Sobald Sie ein Fingerschnippen hören oder sehen, wie sich die Aufzugstür öffnet, werden Sie aufwachen und sich an jedes Detail „erinnern“.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Der Kellner kann nichts sagen. Er starrt nur auf die Aufzugstür. Ich gehe vorsichtig weg.")
	novel_interface.show_character("ren_full","stare")
	await novel_interface.show_dialog("(Das reicht wirklich?...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru sagte, das menschliche Gehirn sei gut darin, Details aus ein paar einfachen Hinweisen und Vorschlägen zu ergänzen … aber das fühlt sich immer noch viel zu einfach an, nicht wahr?!")
	novel_interface.show_character("ren_full","stare")
	await novel_interface.show_dialog("Woran wird er sich genau erinnern?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Immer noch vor mich hin murmelnd, gehe ich in die Mitte des Tresorraums, ziehe schnell meine High Heels aus und lege sie ordentlich auf den Boden.")
	await novel_interface.show_text_only("Dann stopfe ich meinen Ohrhörer und alle anderen Metallgegenstände in meine Handtasche und lasse sie neben den Absätzen.")
	await novel_interface.show_text_only("Dieses Gewölbe ist eine riesige supraleitende statisch-magnetische Abschirmkammer, die in der Lage ist, die meisten Strahlungen und Magnetfelder zu blockieren.")
	await novel_interface.show_text_only("Lebona verfügt nicht über eine solche Technologie. Den Informationen von Professor Shih zufolge wurde die Abschirmkammer bei einem Militärhersteller im Schwebenden Palast in Auftrag gegeben.")
	await novel_interface.show_text_only("Ich finde den Zielcontainer. Zwischen den beiden Schlüssellöchern an jeder Tür befindet sich ein schwaches, lasergeätztes Wolkenmotiv.")
	novel_interface.show_character("ren_full","normal1")
	await novel_interface.show_dialog("Behälter Nr. 0812...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ich stecke zwei Hauptschlüssel aus Keramik gleichzeitig in die beiden Schlösser und betätige die Schalter an ihren Enden.")
	await novel_interface.show_text_only("Fabella sagte einmal, dass die Schlüssel für private Tresore in Banken und ähnlichen Institutionen tatsächlich von sehr geringer Sicherheit seien –")
	await novel_interface.show_text_only("Ein Grund dafür ist, dass diese Institutionen großes Vertrauen in die Sicherheit des Tresors selbst haben.")
	await novel_interface.show_text_only("Noch wichtiger ist, dass der Schlüssel den Kunden die Illusion vermittelt, dass nur sie den Safe öffnen können, was das Bezahlen der Dienstleistung viel einfacher macht.")
	novel_interface.show_character("ren_full","stare")
	await novel_interface.show_dialog("(Der Tresor und das Sicherheitssystem sorgen also für „Sicherheit“, während der Schlüssel für „Seelenfrieden“ sorgt ...?)", "Lian")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("(Warum klingt das so sehr nach etwas, was Mariru sagen würde? Ich hasse es ...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Klicken Sie. Der Safe ist geöffnet!")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Im Inneren des Behälters lag der über 1,5 Meter lange schwarze Meteorit –")
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/APT/livingRoom.png")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("EX-Stoff Stoff H?!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Ja, EX-Level!", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","stare")
	await novel_interface.show_dialog("Aber ich erinnere mich, dass Sie gesagt haben, dass das EX-Level mit Religionen zusammenhängt.", "Lian")
	await novel_interface.show_dialog("Da sie speziell für religiöse Anhänger bestimmt sind, kann Substanz H der EX-Stufe gesammelt werden, Forschung ist jedoch verboten.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("In religiösen Legenden heißt es, dass eine bestimmte Substanz H die Macht besitzt, Götter zu töten.")
	await novel_interface.show_text_only("Sobald es aktiviert ist, könnte es eine Katastrophe der Weltuntergangsklasse auslösen, daher sind alle Formen der Forschung strengstens verboten.")
	novel_interface.change_background("res://assets/images/bg/Shot/boySP_news.png")
	await novel_interface.show_text_only("Und ja...")
	await novel_interface.show_text_only("Der Grund, warum ich mich so genau an all das erinnere ...")
	await novel_interface.show_text_only("Liegt daran, dass der Speer des Schicksals, den sie gestohlen hat, ebenfalls Substanz H der EX-Klasse war!")
	novel_interface.change_background("res://assets/images/bg/APT/livingRoom.png")
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("(Redet sie über mich?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ich schaue auf und überprüfe mich im Spiegel.")
	await novel_interface.show_text_only("Genau so sehe ich in all den Träumen aus, die ich in letzter Zeit hatte.")
	novel_interface.show_character("liliu_uniform2","speak")
	await novel_interface.show_dialog("EX-Stufe Substanz H ist nicht nur mit Religionen verbunden.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Marirus Stimme bringt mich zurück in die Realität.")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Unser Test zeigt, dass der Meteorit vor mehr als 4.000 Jahren auf die Erde fiel. Es wurde vor dem Krieg von ägyptischen Archäologen ausgegraben.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_TheMeteorite.png")
	await novel_interface.show_dialog("Aufgrund seiner regelmäßigen Ecken und flachen Flächen wurde der Schluss gezogen, dass der Meteorit nicht auf natürliche Weise entstanden sein konnte.", "Mariru")
	await novel_interface.show_dialog("Zuerst dachte man, es handele sich um eine Art Sarkophag aus dem alten Ägypten, aber dieser Meteor war ganz und ohne den geringsten Riss.", "Mariru")
	await novel_interface.show_dialog("Jahre später, als die Probleme rund um Substanz H eskalierten, wurde der Meteorit in das Hovering Palace Museum überführt.", "Mariru")
	await novel_interface.show_dialog("Professor Shih war einer der führenden Forscher, die es untersuchten. Als der Hovering Palace den Meteoriten zum ersten Mal erhielt, dachten sie, sie hätten den Jackpot geknackt.", "Mariru")
	await novel_interface.show_dialog("Doch bald stellten sie fest, dass der Meteorit jede Form von Sondierung und Eindringen ablehnte.", "Mariru")
	await novel_interface.show_dialog("Zunächst schwankt sein eigenes Magnetfeld periodisch, fast wie beim Atmen – und an seinem Höhepunkt ist das Feld fast so stark wie das eines Neodym-Magneten.", "Mariru")
	await novel_interface.show_dialog("In dem Moment, in dem es Strahlung erkennt, steigt sein Magnetfeld stark an und erreicht eine Intensität, die zu hoch ist, um gemessen zu werden.", "Mariru")
	await novel_interface.show_dialog("Das Experiment scheiterte nicht nur, es sprengte auch fast die gesamte Forschungsstation in die Luft.", "Mariru")
	novel_interface.change_background("res://assets/images/bg/APT/livingRoom.png")
	novel_interface.show_character("anne_normal","happy")
	await novel_interface.show_dialog("...Was wäre, wenn ich beispielsweise versuchen würde, es aufzuschneiden?", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("Obwohl der Meteorit selbst nicht besonders hart ist, führt jeder Versuch, seine Struktur zu beschädigen, dazu, dass er starke Hitze und Strahlung abgibt.", "Mariru")
	await novel_interface.show_dialog("Nach unseren Berechnungen würde die freigesetzte Energie ausreichen, um den halben Planeten auszulöschen, wenn jemand es gewaltsam aufschneiden würde.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Kein Wunder, dass Forschung verboten ist...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Außerdem ist es extrem instabil – eine tickende Bombe, von der niemand weiß, wann sie hochgehen wird.", "Mariru")
	await novel_interface.show_dialog("Der schwebende Palast versuchte auf jede erdenkliche Weise, den Meteoriten loszuwerden. Am Ende stimmte die Kirche der Übernahme zu und Samonton erteilte die Erlaubnis.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Apropos Kirche. Sonya hat mir heute Nachmittag eine E-Mail geschickt. Im Anhang war ein Bild von ihr in der Werkstatt der Strafvollzugsanstalt.")
	await novel_interface.show_text_only("Nach dem letzten Vorfall kehrte Sonya in die Kirche zurück. Sie sagte, sie müsse etwas untersuchen und ein paar „Tools“ aktualisieren.")
	await novel_interface.show_text_only("Der Raum auf ihrem Bild war voller teurer Geräte. Ich hätte es fast mit einer SRD-Einrichtung verwechselt.")
	await novel_interface.show_text_only("Wenn Sonya nicht ihre Nonnenuniform getragen hätte, gäbe es auf dem Bild nichts, was die Leute dazu bringen würde, den Ort mit Religion in Verbindung zu bringen.")
	novel_interface.show_character("ren_battle","speechless")
	await novel_interface.show_dialog("(Klingt so, als würde die Kirche wirklich jeden und alles akzeptieren, solange der Preis stimmt ...)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Aufgrund seines starken Magnetismus konnte der Meteor nicht mit einem Flugzeug transportiert werden. Der einzig sichere Weg war das Schiff.", "Mariru")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("Was zu einem weiteren Problem führte: Sobald das Schiff den Suezkanal passierte, könnte es gegen eine ganze Reihe internationaler Konventionen verstoßen ...", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_normal","normal1",0.25)
	await novel_interface.show_dialog("Und da kam Lebona ins Spiel?", "Annie")
	novel_interface.character_light(0.35,"normal1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Genau! Der Schwebende Palast stellte sogar Substanz H zur Verfügung, um auf dem Schiff einen sicheren Tresorraum zu errichten, der Strahlung und Magnetfelder blockiert.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"panic")
	await novel_interface.show_dialog("Und indem wir all diese Informationen an uns weitergeben...", "Annie")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru nickt, als sie Annies Theorie bestätigt.")
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("Sie sind jedoch schon einmal mit etwas Ähnlichem wie diesem Meteoriten in Kontakt gekommen.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("Ach?", "Lian")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_TheLastJudgement.png")
	await novel_interface.show_text_only("Während ich ihr antworte, werde ich bereits von einem der Fotos in der E-Mail abgelenkt. Es ist eine Aufnahme des Jüngsten Gerichts, des Freskos, das Sonya in der Sixtinischen Kapelle fotografiert hat.")
	await novel_interface.show_text_only("Erleichtert sehe ich, dass Sonya sich immer noch frei in der Kirche bewegen kann, und suche nach Informationen über das Fresko.")
	await novel_interface.show_dialog("(Michelangelo... Er stammt aus der gleichen Zeit wie Henriette.)", "Lian")
	await novel_interface.show_dialog("Es fühlt sich an, als ob jedes Genie dieser Zeit von nackten Körpern besessen war ...", "Lian")
	novel_interface.change_background("res://assets/images/bg/APT/livingRoom.png")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Henriettes „Tesheimer Lapissäule“.", "Mariru")
	await novel_interface.show_dialog("Ebenso wie die Atmung schwankt auch die Oberflächentemperatur der Säule.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_normal","stare")
	await novel_interface.show_dialog("Also...", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sowohl Mariru als auch Annie drehen sich zu mir um. Plötzlich wird es still im Raum.")
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("Ähm...", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","speechless")
	await novel_interface.show_dialog("?", "Lian")
	novel_interface.change_expression("panic")
	await novel_interface.show_dialog("Hä??", "Lian")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("...")
	novel_interface.change_music("res://assets/audio/music/Shop.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_Vault.png")
	await novel_interface.show_text_only("Um zu verhindern, dass sich ein weiterer „Heaven's Door“-Vorfall wiederholt, änderte Mariru das SID-Protokoll.")
	await novel_interface.show_text_only("Es ist zwingend erforderlich, alle Informationen im Zusammenhang mit der EX-Stufe Substanz H weiterzuverfolgen.")
	await novel_interface.show_text_only("„Man kann nicht die ganze Welt retten, indem man in New Opulentia bleibt. Wir brauchen auch einen Schlüssel zum Vereinigten Rat.“")
	novel_interface.show_character("ren_full","panic")
	await novel_interface.show_dialog("(Stimmt, aber...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Diese Männer in schwarzen Spezial-Kampfanzügen kommen mir in den Sinn, ebenso wie meine Angst.")
	novel_interface.show_character("ren_full","uneasy")
	await novel_interface.show_dialog("(Ich hoffe nur, dass mein Schlüssel nicht im Schloss einrastet ...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Widerwillig öffne ich den Safe Nr. 0812 und schaue auf den darin aufbewahrten schwarzen Meteor.")
	await novel_interface.show_text_only("Laut Aya sollte der Raum, in dem ich stehe, selbst der stärksten Zauberei standhalten können.")
	await novel_interface.show_text_only("Darüber hinaus gibt es an Bord dieses Casino-Schiffs eine taktische Reaktionseinheit, die für jeden Notfall bereit ist.")
	novel_interface.show_character("ren_full","upset")
	await novel_interface.show_dialog("Also muss ich es nur einmal anfassen?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Nervös oder verängstigt? Ich bin mir nicht sicher. Aber ich konnte fast spüren, wie mein Blut durch meine Adern floss.")
	await novel_interface.show_text_only("Ich strecke meine Hand langsam nach dem Meteor aus und schließe meine Augen.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("...")
	await novel_interface.show_text_only("...")
	await novel_interface.show_text_only("Es fühlt sich... weich an?")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_Vault.png")
	await novel_interface.show_text_only("Ich öffne meine Augen wieder. Meine Handfläche ruht bereits auf dem Meteoriten. Es ist hart und leicht feucht.")
	novel_interface.show_character("ren_full","panic")
	await novel_interface.show_dialog("(War das nur meine Einbildung? Ich hätte schwören können, dass ich etwas Weiches berührt habe ...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ich berühre den Meteor erneut. Es ist tatsächlich hart und flach.")
	await novel_interface.show_text_only("Nach dem ursprünglichen Plan sollte ich den Meteor nur einmal berühren.")
	await novel_interface.show_text_only("Verwirrt schließe ich den Safe und stecke das Schloss wieder ein. Dann stehe ich still davor und versuche immer noch herauszufinden, was ich beim ersten Mal gefühlt habe.")
	novel_interface.show_character("ren_full","upset")
	await novel_interface.show_dialog("(Was war das...?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Plötzlich ertönt hinter mir ein seltsames Geräusch – als würde ein Knopf auf den Boden fallen.")
	await novel_interface.show_text_only("In diesem abgeschlossenen kleinen Raum klingt das Geräusch des über den Boden rollenden Gegenstands unnatürlich deutlich.")
	novel_interface.show_character("ren_full","normal1")
	await novel_interface.show_dialog("?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ich drehe mich um – es ist ein kleines gelbes Ding. Ich gehe hin und hebe es auf.")
	await novel_interface.show_text_only("Es ist ein winziges rundes Objekt mit acht kleinen Höckern auf seiner Oberfläche.")
	novel_interface.show_character("ren_full","wry_smile")
	await novel_interface.show_dialog("... Ist es von meinem Kleid gefallen?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aber es sieht genauso aus wie die Konpeito-Bonbons, die ich als Kind gegessen habe. Für eine Sekunde möchte ich es fast lecken.")
	await novel_interface.show_dialog("Hä?", "???")
	await novel_interface.show_text_only("Es ist die Stimme eines kleinen Mädchens!")
	novel_interface.show_character("stardust_small","smile")
	await novel_interface.show_dialog("Hä? Was soll ich suchen?", "Stardust")

	print("=== 星尘降临篇第5话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
