	novel_interface.show_character("ren_full","upset")
	await novel_interface.show_dialog("咦──？？", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("倪克斯別過頭來，曖昧得把手放在我的臉上。")
