	await novel_interface.show_text_only("一切順利～")
	await novel_interface.show_dialog("咳咳，我說……", "？？？")
	await novel_interface.show_text_only("我身後傳來一個女聲。")
	novel_interface.show_character("nyx_full","normal1")
	await novel_interface.show_dialog("我在二樓看妳半天了，在這搔首弄姿地做什麼呢？", "倪克斯")
