# stardustdescends_ep01.gd - 星尘降临篇第1话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	stardustdescends_ep01_script()

func play_script():
	pass

func stardustdescends_ep01_script():
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_Prisoner.png")
	await novel_interface.show_text_only("有這樣一個廣為人知的經典故事……")
	await novel_interface.show_text_only("某個富翁的財物遭竊，警察在一間兩人合租的房間內搜到贓物，卻沒有足夠證據證明兩人有罪。")
	await novel_interface.show_text_only("於是警方將兩名嫌犯分開監禁，並向他們提供了這樣的選擇──")
	await novel_interface.show_text_only("如果一人招供而另一人沉默，則招供的人獲釋，沉默的人將被判刑10年；")
	await novel_interface.show_text_only("如果雙方都保持沉默，則兩人都會被判刑半年；但如果兩人都招供，則兩人都會被判5年有期徒刑。")
	await novel_interface.show_text_only("對故事中的兩個人而言，他們永遠無法達成為雙方帶來最佳利益的結果──")
	await novel_interface.show_text_only("因為無論對方沉默還是認罪，自己先認罪一定比沉默要好，因此招供成為了支配性的策略。")
	novel_interface.hide_background()
	await novel_interface.show_text_only("有些經濟學家提出，現實中雙方可以透過反覆博弈，讓對方理解到合作才是最佳策略。")
	novel_interface.show_background("res://assets/images/bg/Shot/storyBGWar.png")
	await novel_interface.show_text_only("但有些博弈並沒有重來的餘地──")
	await novel_interface.show_text_only("陷入猜疑的雙方永遠無法突破這個「囚徒困境」……")
	novel_interface.hide_background()
	await novel_interface.show_text_only("新豐洲城郊。")
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_Manorgate.png")
	await novel_interface.show_text_only("一輛加長型轎車緩緩停在莊園門口，打扮精緻的少女不太自在地從車後座鑽了出來。")
	novel_interface.show_character("ren_full","upset")
	await novel_interface.show_dialog("這、這種地方──！", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("眼前是一座奢華的歐式莊園──黃銅裝飾的大門、精緻傳神的雕像，連草坪和灌木叢都修剪得一絲不苟。")
	await novel_interface.show_text_only("我正驚嘆著新豐洲居然有這種地方，耳機中卻傳來了莉琉的聲音。")
	await novel_interface.show_dialog("別一直東張西望，妳的口水都快要流出來了～", "莉琉")
	novel_interface.show_character("ren_full","shy")
	await novel_interface.show_dialog("知、知道了啦──", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("我整理一下儀容，結果剛踏上大門的階梯就差點摔倒。")
	novel_interface.show_character("ren_full","shy")
	await novel_interface.show_dialog("這鞋跟也太高了吧……而且禮服裙子這麼短是怎樣！！", "小憐")
