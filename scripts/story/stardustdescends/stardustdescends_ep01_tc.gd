	await novel_interface.show_dialog("（腰還有點緊繃，是不是最近吃太多了……）", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("挺起胸，保持儀態，別走得像蝦子一樣。", "莉琉")
	await novel_interface.show_dialog("妳又不是第一天做女孩子了～", "莉琉")
	await novel_interface.show_text_only("妳很煩欸──！！")
	await novel_interface.show_text_only("我快要走到別墅門口時，服務生就打開了大門，並彬彬有禮地向我鞠躬。")
	await novel_interface.show_text_only("我勉強擠出一個微笑，同時祈禱自己踏上台階時別再摔倒……")
	novel_interface.hide_background()
	await novel_interface.show_text_only("我小心翼翼進入別墅，通過一套繁複的安檢設備後，昂貴的氣息迎面而來──")
	novel_interface.change_music("res://assets/audio/music/Shop.mp3")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_VillaHall.png")
	await novel_interface.show_text_only("前廳並不算大，卻處處露出精緻講究的質感，連角落的檯燈都散發著古董特有的珠光。")
	await novel_interface.show_text_only("我在腦中反覆默念著昨天美姿美儀課的重點──挺胸收腹、脖子不要前傾、保持微笑、別東張西望……")
	novel_interface.show_character("ren_full","uneasy")
	await novel_interface.show_dialog("（還有千萬別打碎任何東西！！）", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("我一走進大廳，那些穿著講究、三三兩兩聚在一起竊竊私語的來賓，全都將目光投到我的身上。")
	await novel_interface.show_dialog("哇──小憐好漂亮！", "安妮")
	await novel_interface.show_text_only("在監視器中看到我進門後，安妮雖刻意壓低音量，但是聲音中卻依然難掩激動之情。")
	novel_interface.show_character("ren_full","blush")
	await novel_interface.show_dialog("（這打扮確實……還挺好看的啦……）", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("但是絕不能承認！ 我可是男生啊！！")
	await novel_interface.show_dialog("到場的賓客都是各個學園都市的明星權貴，主要經營會員制的賭場，由元老院發放執照。", "莉琉")
	await novel_interface.show_dialog("不過，這座莊園的主業是違禁品和情報交易，還充當新豐洲最大的地下擔保仲介。", "莉琉")
	novel_interface.show_character("ren_full","upset")
	await novel_interface.show_dialog("所以，妳是想收集證據然後把這裡抄了嗎？", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("我一邊假裝向遠處的空氣微笑致意，一邊小聲說道。")
	await novel_interface.show_dialog("我看起來像是這種人嗎？\n更何況，我想抄哪裡還需要什麼證據？", "莉琉")
	await novel_interface.show_text_only("莉琉不屑地回答。")
	await novel_interface.show_dialog("總之，妳的任務就是吸引目標的注意力，安妮會配合妳。", "莉琉")
	novel_interface.show_character("ren_full","upset")
	await novel_interface.show_dialog("這裡的人至少都四五十歲起跳吧，我一個高中生出現在這裡不會怪怪的嗎……", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("喔，從妳踏進莊園大門的那一刻，莊園的保全系統就已經幫妳拍照掃描過了。", "莉琉")
	await novel_interface.show_dialog("但系統只會顯示妳是一個平時在女僕咖啡打工的女高中生而已。", "莉琉")
	novel_interface.show_character("ren_full","panic")
	await novel_interface.show_dialog("什麼──？\n（那不是完全露餡了嗎？ ！！ ）", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("我嚇得僵在原地，不安地觀察著周遭人的目光。")
	await novel_interface.show_dialog("偶爾也會有妳這種情況啦，有些客人還很喜歡呢。", "莉琉")
	await novel_interface.show_text_only("哪種情況啊！！")
	await novel_interface.show_dialog("目標坐在樓梯轉角的椅子上，看起來有點緊張。", "安妮")
	await novel_interface.show_text_only("我若無其事地走到可以觀察到目標的角落，用餘光看了一下──")
	novel_interface.show_character("shi","angry")
	await novel_interface.show_dialog("該死……該死該死！", "？？？")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("那個頭髮凌亂、滿臉鬍渣，穿著格格不入的中年男人正抱著一個皮包自言自語。")
	await novel_interface.show_text_only("老舊的外套、白襯衫外面套著土黃色的毛衣、還圍著一條綠色的圍巾……")
	novel_interface.show_character("ren_full","wail")
	await novel_interface.show_dialog("那個就是施教授？\n（簡直有夠俗！ ）", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("呃……好像是……", "安妮")
	novel_interface.show_character("ren_full","smile")
	await novel_interface.show_dialog("好的～", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("不知為何，我今天對自己的樣子莫名地充滿自信。")
	await novel_interface.show_text_only("我走到他面前，假裝在欣賞二樓的彩繪玻璃，扭腰擺臀地來回踱步，但那傢伙連正眼都沒看過我。")
	await novel_interface.show_text_only("我有點不甘心，偷偷拉了拉胸墊，又湊近一些，以假裝想看牆上的鹿頭裝飾。")
	await novel_interface.show_text_only("那土包子居然嫌棄地把頭別開了！！")
	novel_interface.show_character("ren_full","wail")
	await novel_interface.show_dialog("（喂！！）", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("啊請問……這位小姐──", "男性賓客")
	await novel_interface.show_text_only("一個身著高級訂製禮服、戴著領結的大叔湊了過來。")
	await novel_interface.show_dialog("我在紐摩利達斯經營一家傳媒公司……請問有沒有興趣聊聊？", "男性賓客")
	await novel_interface.show_text_only("那個大叔一邊搓著手一邊笑盈盈地和我說話。")
	novel_interface.show_character("ren_full","perspire1")
	await novel_interface.show_dialog("不、不好意思──", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("我趕忙揮揮手，假裝肚子痛地抱著腹部快步溜到轉角，對著監視攝影機露出一副哭喪的臉。")
	await novel_interface.show_text_only("目標無動於衷，卻吸引到了奇怪的傢伙。")
	novel_interface.show_character("ren_full","sob")
	await novel_interface.show_dialog("好像完全吸引不到那傢伙的注意力啊……", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("小憐的動作太僵硬啦……", "安妮")
	await novel_interface.show_dialog("他看起來好像在等什麼人，皮包裡的東西也很可疑。", "安妮")
	await novel_interface.show_dialog("小憐的手提包裡有透視設備，剛才也掃描了那個皮包，裡面並沒有任何電子產品，只有大概二三十頁的紙類文件。", "莉琉")
	await novel_interface.show_dialog("還真是個老古董……", "安妮")
	novel_interface.show_character("ren_full","normal2")
	await novel_interface.show_dialog("愛衣不是說過，這東西能穿透障礙物，將多張紙上的內容拍起來嗎？", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("我拿起那個頗有份量的手提包，精緻的漆皮縫線背後塞滿了戰研部的小道具。")
	await novel_interface.show_text_only("最神奇的是，內襯經過特殊處理後，居然能通過門口的安檢。")
	await novel_interface.show_dialog("能同時拍攝多張紙的前提是，空間中均勻散佈了金屬粉末，讓穿過每張紙的射線拉開不同強度。", "莉琉")
	await novel_interface.show_dialog("妳的包包裡有個能遙控爆破的金屬粉末膠囊，但那些頁數有點多，要大力晃動才能均勻擴散開。", "莉琉")
	await novel_interface.show_dialog("而且膠囊爆開會有聲音吧？ 那傢伙一直像寶貝似地抱著那個皮包……", "安妮")
	await novel_interface.show_dialog("小憐不是有一個能炸開門鎖的黏膠炸彈嗎？", "莉琉")
	await novel_interface.show_dialog("那東西聲音更大！\n而且小憐要是穿成那樣被抓住的話……", "安妮")
	await novel_interface.show_text_only("我想到剛才那個大叔色瞇瞇的目光，忍不住抱住胸部打了個冷顫。")
	novel_interface.show_character("ren_full","normal2")
	await novel_interface.show_dialog("話說回來……", "小憐")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("那個大廳似乎是完全密閉的？", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("可能是為了確保隱私，連彩色玻璃都沒有光線透進來的樣子。")
