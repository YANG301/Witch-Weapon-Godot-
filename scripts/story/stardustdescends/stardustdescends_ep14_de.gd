# stardustdescends_ep14.gd - 星尘降临篇第14话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	stardustdescends_ep14_script()

func play_script():
	pass

func stardustdescends_ep14_script():
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_ClusterBombs.png")
	await novel_interface.show_text_only("„Hive“ – ein Waffensystem, das in der Lage ist, Personal und Ausrüstung in einem weiten Umkreis wahllos zu vernichten.")
	await novel_interface.show_text_only("Diese handtellergroßen Drohnen entfernen sperrige Steuermodule und tragen jeweils nur eine einzige selbstzerstörende Splittergranate.")
	await novel_interface.show_text_only("Mithilfe der KI-Erkennung zur Unterscheidung von Personal und Ausrüstung können sich Dutzende Drohnen untereinander koordinieren und Flächenangriffe noch effektiver durchführen als Streubomben.")
	await novel_interface.show_text_only("Vor einigen Jahren warf Masada zahlreiche Bienenstöcke im Bekaa-Tal ab, was zu Tausenden zivilen Opfern führte und international heftige Verurteilung hervorrief.")
	await novel_interface.show_text_only("Trotzdem hat Masada noch immer kein internationales Übereinkommen zur Abschaffung dieser Art von Waffe unterzeichnet ...")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("...")
	await novel_interface.show_text_only("Boom--!!")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_StagingPost.png")
	await novel_interface.show_text_only("Mit einer ohrenbetäubenden Explosion explodierte das Maschinengewehr auf dem südlichen Hügel plötzlich und die Plane, die es bedeckte, wurde in unzählige verkohlte Fetzen gerissen, die in die Luft verstreut waren ...")
	novel_interface.show_character("ren_medical","sob")
	await novel_interface.show_dialog("Warum haben sie so etwas...?\nSollte dieser Lastwagen nicht medizinische Hilfsgüter transportieren!?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("emilio","angry")
	await novel_interface.show_dialog("Die Verteidigungskräfte müssen still und heimlich einige Extras eingeschleust haben, ohne es ihnen zu sagen.", "Emily")
	await novel_interface.show_dialog("An der Versorgungsstation steht ein Jeep. Vera, bring sie dorthin.", "Emily")
	await novel_interface.hide_character()
	novel_interface.show_character("valkyrja","angry")
	await novel_interface.show_dialog("Verstanden!", "Vera")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","wail")
	await novel_interface.show_dialog("Was ist los... hey, wai--aaaah!!!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Die superstarke Frau packte mich ohne Erklärung an der Taille, klemmte mich unter ihrem Arm und sprintete zur Versorgungsstation.")
	novel_interface.show_character("ren_medical","sob")
	await novel_interface.show_dialog("Aaaaaahhhhh--!!!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mit großen Schritten raste sie den Hang hinunter. Wenn ihr jetzt der Griff entglitt, würde ich fliegen wie ein kleiner Seehund, der über das Eis schlittert.")
	await novel_interface.show_text_only("Vera stürmte zur Versorgungsstation und warf mich auf einen Stapel Sandsäcke.")
	novel_interface.show_character("valkyrja","speak")
	await novel_interface.show_dialog("Bleiben Sie hier verborgen. Ich werde Emily helfen, das Feuer zu entfachen!", "Vera")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Sie warf sich die Leine über die Schulter, sprang in den Jeep und raste davon ...")
	await novel_interface.show_text_only("Der Drohnenschwarm ist so programmiert, dass er alle umliegenden Fahrzeuge, Waffen oder Geräte zerstört, die keine befreundeten Identifikationsgeräte tragen.")
	await novel_interface.show_text_only("Und ein schnell fahrendes Fahrzeug ist offensichtlich das Ziel mit der höchsten Priorität.")
	await novel_interface.show_text_only("...")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_StagingPostF.png")
	await novel_interface.show_text_only("Zitternd kauerte ich hinter einer Verteidigungsmauer in der Ecke der Versorgungsstation und lauschte dem Maschinengewehrfeuer in der Ferne und einer Explosion nach der anderen.")
	await novel_interface.show_text_only("Auf jede Explosion folgte ein knisterndes Klappern von Metall, das auf Sand und Stein traf.")
	await novel_interface.show_text_only("Das waren von den Granaten herausgeschleuderte Stahlnägel, die tödlich genug waren, um einen Menschen in Stücke zu reißen.")
	await novel_interface.show_text_only("Doch das Maschinengewehrfeuer wurde immer spärlicher und ein großes Gefühl der Angst überkam mich –")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Ich legte ein Brett auf die Barriere und duckte mich wie ein Pilz darunter, wobei ich meinen Kopf bedeckte.")
	await novel_interface.show_text_only("Man sagt, dass es im Zweiten Weltkrieg einen verheerenden Schlag für die Moral bedeutete, wenn die eigenen Maschinengewehre während eines Angriffs verstummten.")
	await novel_interface.show_text_only("Heute habe ich genau verstanden, was das bedeutet...")
	await novel_interface.show_text_only("Als das letzte Maschinengewehr endlich verstummte, wurden die anderen Geräusche auf dem Schlachtfeld erschreckend deutlich –")
	await novel_interface.show_text_only("Das Summen dieser kreisenden Drohnen klang wie ein Himmel voller tödlicher Bienen, den man nicht genau bestimmen konnte.")
	await novel_interface.show_text_only("Sie schienen überall zu sein, wie der Tod selbst, der über mir kreiste und jeden Moment bereit war, neben mir herzufallen ...")
	novel_interface.show_character("ren_medical","panic")
	await novel_interface.show_dialog("(Sind die beiden in Ordnung...?)", "Lian")
	await novel_interface.show_dialog("(...Moment, ein Motor!?)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_StagingPostF.png")
	await novel_interface.show_text_only("Ich schaute hinaus und sah überall Verwüstung. In der Ferne stand die Hütte, in der Munition gestapelt worden war, bereits in Flammen.")
	await novel_interface.show_text_only("Veras Jeep raste vom Osthang auf die Versorgungsstation zu und wirbelte dahinter eine riesige Staubwolke auf.")
	await novel_interface.show_text_only("Mehr als ein Dutzend Drohnen waren ihm direkt auf den Fersen. Sie waren nicht besonders schnell, aber auch nicht langsam genug, um erschüttert zu werden.")
	await novel_interface.show_text_only("Emily kletterte auf das Dach, richtete eine M16 auf und feuerte Salven auf den Schwarm ab, aber es war schwer, irgendetwas zu treffen.")
	await novel_interface.show_text_only("Bald ging ihr die Munition aus und sie schleuderte das Gewehr einfach in Richtung Heck des Fahrzeugs ...")
	await novel_interface.show_text_only("Eine Drohne stürzte sich sofort auf das weggeworfene Gewehr und detonierte selbst, während die anderen schnell aufstiegen, um dem Explosionsradius auszuweichen.")
	novel_interface.show_character("emilio","angry")
	await novel_interface.show_dialog("Verdammt!", "Emily")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Der Jeep wurde neben der Mauer vor der Versorgungsstation langsamer. Emily wich der Sichtlinie der Drohnen aus, sprang aus dem Fahrzeug und drückte sich in die Ecke an der Wand.")
	await novel_interface.show_text_only("Dann riss der Jeep sein Lenkrad, wirbelte Staub auf und raste direkt auf einen weiteren nahegelegenen Hügel zu.")
	await novel_interface.show_text_only("Emily hockte sich an die Ecke, wartete darauf, dass der Schwarm über sie hinwegfegte, sprang dann sanft über die Wand und kam hinein.")
	novel_interface.show_character("emilio","angry")
	await novel_interface.show_dialog("Lian!?", "Emily")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","sob")
	await novel_interface.show_dialog("H-hier...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ich antwortete mit leiser Stimme, und sie folgte der Wand bis unter den Plankenschutz, den ich aufgebaut hatte.")
	novel_interface.show_character("ren_medical","sob")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("emilio","perspire",0.25)
	await novel_interface.show_dialog("Du weißt zwar, wie man einen Platz auswählt, aber du musst nicht flüstern. Diese Dinger können nicht hören.", "Emily")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ah, du bist verletzt?!", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Ich sah mehrere Schnittwunden an Emilys Oberarm. Blut war durch ihren Uniformärmel gesickert, aber sie wirkte völlig unbesorgt.")
	novel_interface.show_character("ren_medical","panic")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("emilio","smile",0.25)
	await novel_interface.show_dialog("Es ist nichts. Wir müssen schnell zum APC zurückkehren. Die Panzerung dieses Fahrzeugs sollte diesen Dingen ausreichend Platz bieten.", "Emily")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Der APC war unter optischer Tarnung an der Straße geparkt, etwa zwei- bis dreihundert Meter von der Versorgungsstation entfernt.")
	novel_interface.show_character("ren_medical","panic")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("emilio","smile",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Hast du keine freundlichen Identifikationsgeräte mitgebracht!?\nDiese Drohnen werden doch nicht ihre eigene Seite angreifen, oder...?", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Andererseits sind diese beiden hier, um die Vorräte ihrer eigenen Seite zu kapern. Ist das ein nationaler Zeitvertreib Masadas?")
	novel_interface.show_character("emilio","speechless")
	await novel_interface.show_dialog("Diese Dinge führen integrierte Standortprotokolle. Natürlich haben wir sie in der Stadt zurückgelassen, bevor wir diesen Auftrag annahmen.", "Emily")
	novel_interface.change_expression("angry")
	await novel_interface.show_dialog("Wir müssen umziehen!\nWer weiß, wie lange Vera sie noch beschäftigen kann...", "Emily")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Emily tippte mir auf den Arm und machte sich auf den Weg aus der Deckung.")
	await novel_interface.show_text_only("Ich wollte ihr gerade folgen, als ich bemerkte, dass sie festgefroren war. Ihre Stimme zitterte leicht, als sie sagte:")
	novel_interface.show_character("emilio","perspire")
	await novel_interface.show_dialog("Lian, lauf...", "Emily")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ich beugte mich vor und schaute. Drei Drohnen kreisten über der Versorgungsstation und führten einen vollständigen 360-Grad-Scan durch.")
	await novel_interface.show_text_only("Plötzlich blieb einer von ihnen stehen, als er sich unserer Position zuwandte, und das rote Licht an seinem Körper begann zu blinken ...")
	novel_interface.show_character("emilio","angry")
	await novel_interface.show_dialog("Lauf!!!", "Emily")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Emily zog ihre Pistole und feuerte sofort in den Himmel, wobei sie alle zwölf Patronen in einem Augenblick leerte.")
	await novel_interface.show_text_only("Eine Drohne wurde von einem Auslegerarm getroffen und stürzte aus der Versorgungsstation.")
	await novel_interface.show_text_only("Ein weiterer explodierte direkt in der Luft und überschüttete die Planke über unseren Köpfen mit Metallsplittern.")
	await novel_interface.show_text_only("Aber der letzte, der eine rote Linie durch den Staub zog, kam direkt auf uns zu –")
	novel_interface.show_character("ren_medical","sob")
	await novel_interface.show_dialog("(Wir sind tot!)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Boom--!!")
	await novel_interface.show_text_only("Die Druckwelle der Granate füllte zusammen mit der glühend heißen Luft sofort den engen Raum im Inneren des Bunkers und riss die Planke über unseren Köpfen weg.")
	await novel_interface.show_text_only("Die Luft erfüllte den beißenden Brandgeruch und den rostigen Geruch von durch Hitze blitzgetrocknetem Blut.")
	await novel_interface.show_text_only("Gleichzeitig spritzte ein Sturm aus Metallsplittern in die Versorgungsstation...")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_StagingPostF.png")
	await novel_interface.show_text_only("Der Schock brachte mich aus dem Gleichgewicht und fiel zu Boden, und ein stechender Schmerz schmerzte an der Außenseite meines Unterarms.")
	await novel_interface.show_text_only("Nein, was noch wichtiger ist...")
	novel_interface.show_character("ren_medical","perspire1")
	await novel_interface.show_dialog("(Ich bin... noch am Leben?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ich habe mich selbst überprüft. Abgesehen von einer Schnittwunde am Unterarm blieb ich im Wesentlichen unverletzt.")
	await novel_interface.show_text_only("Und vor mir, mich beschützend, schien Emily einen Schild aus Blut entfaltet zu haben –")
	await novel_interface.show_text_only("Der Schild absorbierte den größten Teil der Explosion, verdampfte dann zu dunkelrotem Rauch wie Trockeneis unter der Sonne und verschwand in der Luft.")
	novel_interface.show_character("ren_medical","worry")
	await novel_interface.show_dialog("Was ist in deiner Hand...?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("emilio","stare",0.25)
	await novel_interface.show_dialog("Ich wollte wirklich nicht, dass du das siehst...", "Emily")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Sie bewegte ihr Handgelenk. Der Ärmel, der vorhin noch rot mit Blut befleckt war, war jetzt völlig sauber.")
	novel_interface.show_character("ren_medical","worry")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("emilio","stare",0.25)
	await novel_interface.show_dialog("Vera und ich kamen einmal zufällig mit einer heterogenen Materie in Kontakt und erlangten anschließend diese seltsame Fähigkeit.", "Emily")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Ich kann mein eigenes Blut in einen Feststoff verwandeln, der härter als Stahl ist, obwohl er schnell verdunstet, also ist das nicht sehr praktisch ...", "Emily")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("...Aber es sieht so cool aus!!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"speechless")
	await novel_interface.show_dialog("Hä?", "Emily")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Sie schien von meiner Reaktion überrascht zu sein, drehte sich dann um und sah, wie ich versuchte, meinen eigenen Ellbogen zu lecken. Sie musste lächeln und den Kopf schütteln.")
	await novel_interface.show_text_only("Es tut höllisch weh!!\nEin Metallsplitter hat mich gerade verletzt...")
	novel_interface.show_character("emilio","speechless")
	await novel_interface.show_dialog("Mehr als neunzig Prozent der Bevölkerung Masadas sind religiös. In den Augen jeder Religion wäre eine Fähigkeit, Blut auf diese Weise zu manipulieren, eine Blasphemie und ein Fluch, nicht wahr?", "Emily")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Veras Kraft ist praktischer, obwohl sie schon von Anfang an unglaublich stark war ...", "Emily")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Veras Jeep befand sich am rechten Rand unseres Blickfelds –")
	await novel_interface.show_text_only("Die starke Frau hatte es auf dem östlichen Hügel gestoppt, und die etwa ein Dutzend Drohnen hinter ihr würden in vielleicht zehn Sekunden aufholen ...")
	novel_interface.show_character("ren_medical","panic")
	await novel_interface.show_dialog("Der Motor ist abgewürgt?!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Vera stieg vom Fahrersitz, ging zur Vorderseite des Jeeps und atmete tief durch, mit Blick auf die vordere Stoßstange –")
	await novel_interface.show_text_only("Dann schleuderte sie den Jeep mit einem metallischen Knall, der das Tal erschüttern ließ, seitwärts durch die Luft.")
	novel_interface.show_character("ren_medical","wry_smile")
	await novel_interface.show_dialog("........................??!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Der Jeep flog in einem anmutigen Bowlingkugelbogen in den Schwarm, der gerade den Hang erklommen hatte, und löste augenblicklich eine Kette von Explosionen aus ...")
	novel_interface.show_character("ren_medical","wry_smile")
	await novel_interface.show_dialog("...Hat sie sie ausgeräumt!?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("emilio","stare",0.25)
	await novel_interface.show_dialog("Feiern Sie noch nicht. Hören.", "Emily")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Richtig – das nervtötende Summen war nicht verschwunden …")
	await novel_interface.show_text_only("Ich drehte mich um und sah einen Anblick, der mein Herz sinken ließ –")
	await novel_interface.show_text_only("Vom Fuß des Hügels vor der Versorgungsstation stiegen langsam mehr als dreißig neue schwarze Punkte in die Luft ...")
	await novel_interface.show_text_only("Diese pechschwarzen Gespenster wirbelten im Rauch herum, rote Lichter blinkten, als wollten sie jeden Lebenswillen auslöschen.")
	await novel_interface.show_text_only("Das ist es, was den Hive so furchteinflößend macht. Es klammert sich an dich wie ein Todesgott und lässt dich nicht los, bis jedes Ziel völlig zerstört ist ...")
	await novel_interface.show_text_only("Emily zog mich instinktiv hinter sich her--")
	novel_interface.show_character("ren_medical","wail")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("emilio","stare",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Was machen wir...", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("Entschuldigung. Ich habe dich da hineingezogen.", "Emily")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Hey, hey, sagen Sie keine Zeilen, die wie ein letzter Wille klingen!")
	novel_interface.show_character("ren_medical","wail")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("emilio","upset",0.25)
	await novel_interface.show_dialog("Ich habe keine Zeitschriften mehr. Gleich locke ich sie weg und du rennst so schnell du kannst zum APC. Vielleicht...", "Emily")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Auf diese Distanz schaffe ich es auf keinen Fall, oder?")
	await novel_interface.show_text_only("Die ersten sechs oder sieben Drohnen stürzten bereits auf uns zu. Instinktiv ergriff ich Emilys Hand.")
	await novel_interface.show_text_only("Blut aus der Schnittwunde an meinem Unterarm verschmierte ihre Hand, und es fühlte sich an, als hätten wir beide gleichzeitig etwas gespürt –")
	await novel_interface.show_text_only("Sie ballte ihre rechte Hand, als würde sie etwas umklammern, und in ihrer Handfläche begann sich Blut zu sammeln.")
	await novel_interface.stop_music()
	novel_interface.show_character("emilio","stare")
	await novel_interface.show_dialog("Das ist...??", "Emily")
	await novel_interface.hide_character()
	novel_interface.change_music("res://assets/audio/music/Deep Water.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_StagingPostL.png")
	await novel_interface.show_text_only("Gleichzeitig spürten wir beide, wie unsere Herzen rasten wie mit flüssigem Stickstoff gefüllte Rennmotoren, die unter einer Belastung nahe der Belastungsgrenze hämmerten.")
	await novel_interface.show_text_only("Als unsere Herzfrequenz in die Höhe schoss, dehnte sich unser Zeitgefühl endlos aus –")
	await novel_interface.show_text_only("Jedes Geräusch um uns herum wurde langwierig und verschwommen, und die mit hoher Geschwindigkeit abtauchenden Drohnen sahen aus wie Schmetterlinge, die in Zeitlupe flattern.")
	await novel_interface.show_text_only("Das Blut in Emilys Handfläche löste sich in der Luft in unzählige feine Stränge auf und verwob sich nach einem voreingestellten Programm automatisch zu einer Netzstruktur wie ein 3D-Drucker.")
	await novel_interface.show_text_only("Sie starrte ungläubig auf den sich formenden Gegenstand in ihren Händen – solange ich groß war, sah er aus wie ein riesiges Schwert.")
	await novel_interface.show_text_only("Kaum hatte sich die Klinge geformt, brach ein sengendes, strahlend rosa Licht aus ihr hervor, und Emily wirbelte herum und schoss in den Himmel ...")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("In dem Moment, als sie sich hin und her bewegte, verdunkelte sich meine Sicht plötzlich und der Raum um uns herum fühlte sich an, als wäre er leer gesaugt worden.")
	await novel_interface.show_text_only("Nach einem Piercing-Ring war es, als wäre die ganze Welt verstummt und alles verstummte –")
	await novel_interface.show_text_only("------")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_StagingPostC.png")
	await novel_interface.show_text_only("--!!!!!!!!!!!!")
	await novel_interface.show_text_only("Als ich wieder zu mir kam, hatte der tosende Wind jedes andere Geräusch übertönt.")
	await novel_interface.show_text_only("Mehr als dreißig Drohnen stürzten davon wie tote Blätter, die von einem Hurrikan erfasst wurden, rollten durch die Luft und wurden weit in die Ferne geschleudert.")
	await novel_interface.show_text_only("Der heftige Schock ließ ihre Granaten eine nach der anderen explodieren, aber die Feuerbälle und Splitter wurden von der sengenden Luftströmung weggeschwemmt und verschwanden außerhalb des Sichtfeldes.")
	await novel_interface.show_text_only("Als der Sturm allmählich nachließ, hatte sich das große Schwert in Emilys Händen vollständig in dunkelroten Rauch aufgelöst.")
