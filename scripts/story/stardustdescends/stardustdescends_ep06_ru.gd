# stardustdescends_ep06.gd - 星尘降临篇第6话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	stardustdescends_ep06_script()

func play_script():
	pass

func stardustdescends_ep06_script():
	novel_interface.change_music("res://assets/audio/music/Shop.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_Vault.png")
	await novel_interface.show_dialog("Эй, что ты ищешь?", "Голос девочки")
	novel_interface.show_character("ren_full","worry")
	await novel_interface.show_dialog("!!!", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("В этой запечатанной комнате у меня за спиной вдруг появилась маленькая девочка. В голове пусто, а все тело словно оцепенело.")
	novel_interface.show_character("ren_full","sob")
	await novel_interface.show_dialog("(Аааааа!)", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Такое обычно бывает только в фильмах ужасов. Неужели я...?")
	await novel_interface.show_text_only("...")
	await novel_interface.show_dialog("Хм?", "Маленькая девочка")
	await novel_interface.show_text_only("Мне так страшно, что я едва дышу. А девочка тем временем невозмутимо кружит передо мной и разглядывает меня с неприкрытым любопытством.")
	novel_interface.show_character("stardust_small","panic")
	await novel_interface.show_dialog("...Ты сломался?", "Маленькая девочка")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Она протягивает руку и ущипывает меня за щеку. Гарнитура в форме кошачьих ушей на ее голове мерцает мягким золотистым светом.")
	novel_interface.show_character("ren_full","panic")
	await novel_interface.show_dialog("Кто... Кто ты?", "Лиан")
	await novel_interface.hide_character()
	novel_interface.show_character("stardust_small","wordless")
	await novel_interface.show_dialog("А? Ты не помнишь?", "Маленькая девочка")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Помните что?")
	await novel_interface.show_text_only("Она разочарованно вздыхает.")
	novel_interface.show_character("stardust_small","wordless")
	await novel_interface.show_dialog("Все еще из тех, кто уклоняется от ответственности, да?", "Маленькая девочка")
	novel_interface.change_expression("konata_eye")
	await novel_interface.show_dialog("Тьфу-тьфу...", "Маленькая девочка")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Она цокает языком и качает головой, как будто я ей надоел.")
	novel_interface.show_character("ren_full","wry_smile")
	await novel_interface.show_dialog("??", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я до сих пор понятия не имею, что происходит, но определенно чувствую, как этот маленький засранец смотрит на меня сверху вниз.")
	novel_interface.show_character("ren_full","upset")
	await novel_interface.show_dialog("Кто ты?...", "Лиан")
	await novel_interface.hide_character()
	novel_interface.show_character("stardust_small","pleased")
	await novel_interface.show_dialog("Хорошо, я расскажу тебе еще раз, так что слушай внимательно!", "Маленькая девочка")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Она упирает руки в бедра и поднимает подбородок, явно готовясь объявить свое громкое имя.")
	novel_interface.show_character("ren_full","bored")
	await novel_interface.show_dialog("(То, как она себя ведет... Я откуда-то это знаю...)", "Лиан")
	await novel_interface.hide_character()
	novel_interface.show_character("stardust_small","pleased")
	await novel_interface.show_dialog("я...", "Маленькая девочка")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_full","uneasy")
	await novel_interface.show_dialog("(Пожалуйста! Никаких больше дворян, гениев, босодзоку и прочих странных девчонок, которых я недавно встречал...)", "Лиан")
	await novel_interface.hide_character()
	novel_interface.show_character("stardust_small","uneasy")
	await novel_interface.show_dialog("я...", "Маленькая девочка")
	await novel_interface.show_dialog("Хм...", "Маленькая девочка")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_full","stare")
	await novel_interface.show_dialog("... А?", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Она смотрит на меня, не мигая, выражение ее лица меняется от самодовольства до паники.")
	novel_interface.show_character("stardust_small","panic")
	await novel_interface.show_dialog("Эм... как меня еще раз звали?!", "Маленькая девочка")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_full","perspire1")
	await novel_interface.show_dialog("Ты меня спрашиваешь??", "Лиан")
	await novel_interface.hide_character()
	novel_interface.show_character("stardust_small","tear")
	await novel_interface.show_dialog("Не кричи на меня!", "Маленькая девочка")
	await novel_interface.show_dialog("Бу-у-у...", "Маленькая девочка")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Видимо, я действительно ее напугал. Она беспомощно оглядывается по сторонам и делает несколько неуверенных шагов назад.")
	await novel_interface.show_text_only("Затем она отворачивается, закрывает голову обеими руками и приседает.")
	novel_interface.show_character("ren_full","shy_left")
	await novel_interface.show_dialog("(...Я ничего ей не делал.)", "Лиан")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Э... Что это?", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я замечаю смятую розовую комбинезон, повязанную на ее запястье, поэтому подхожу и осторожно развязываю его.")
	await novel_interface.show_text_only("На нем нацарапано два кривых иероглифа.")
	novel_interface.show_character("ren_full","normal2")
	await novel_interface.show_dialog("\"Stardust\"", "Лиан")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("stardust_small","panic",0.25)
	await novel_interface.show_dialog("Ах!!!", "Маленькая девочка")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Она внезапно вздрагивает, осознав это.")
	novel_interface.show_character("ren_full","normal2")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("stardust_small","panic",0.25)
	await novel_interface.show_dialog("Это мое имя!!", "Маленькая девочка")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Ты что, брошенный ребенок, чьи родители прикрепили к тебе записку с твоим именем, прежде чем куда-то бросить?")
	novel_interface.show_character("ren_full","normal2")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("stardust_small","tear",0.25)
	await novel_interface.show_dialog("Я... я...\n...", "Stardust")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Она выглядит на грани слез.")
	novel_interface.show_character("ren_full","perspire1")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("stardust_small","tear",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Извините. Я не это имел в виду...", "Лиан")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Она опускает голову и замолкает, видимо, пытаясь успокоиться. Глядя на нее, я наконец начинаю восстанавливать самообладание.")
	await novel_interface.show_text_only("Я раньше прикасался к метеору, потом эта девушка просто появилась из ниоткуда. Это не может быть совпадением.")
	novel_interface.show_character("ren_full","upset")
	await novel_interface.show_dialog("(Эта девушка... ведьма?)", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Но есть проблема. Этот метеор упал на Землю более четырех тысяч лет назад, и ничто в наряде этой девушки даже отдаленно не выглядит таким старым.")
	novel_interface.show_character("ren_full","normal2")
	await novel_interface.show_dialog("(Может быть, это что-то вроде случая с Генриеттой...?)\n(А \"тот\" тоже шил для нее эту одежду?)", "Лиан")
	await novel_interface.hide_character()
	novel_interface.show_character("stardust_small","normal1")
	await novel_interface.show_text_only("Это не так. Например, ее наушники-кошачьи ушки? Я почти уверен, что видел их на торговом сайте.")
	novel_interface.change_expression("normal2")
	await novel_interface.show_text_only("Хотя они ей идут.")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Кроме того, то, как она говорит, больше похоже на речь современного ребенка, живущего в социальных сетях. Невозможно, чтобы человек, живший четыре тысячи лет назад, мог так говорить.")
	await novel_interface.show_text_only("Может быть, она потеряла память? Мне нужно попросить Энни позже проверить отчеты о пропавших людях.")
	await novel_interface.show_text_only("Пока я все еще пытаюсь понять, что делать дальше, она подходит ко мне и обнимает меня.")
	novel_interface.show_character("ren_full","timid")
	await novel_interface.show_dialog("О чем это?...", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Поняв, что я ее не отталкиваю, она обнимает меня еще крепче. Она кладет свое лицо мне на живот, не желая, чтобы я оставлял ее.")
	novel_interface.show_character("ren_full","timid")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("stardust_small","tear",0.25)
	await novel_interface.show_dialog("Мне все равно. Ты не можешь бросить меня.", "Stardust")
	await novel_interface.show_dialog("У нас была сделка...", "Stardust")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Она рыдает и бормочет.")
	await novel_interface.show_text_only("Я поглаживаю ее по голове. Ее светло-голубые волосы кажутся шелковистыми, мягкими и гладкими.")
	await novel_interface.show_text_only("Под светом он даже переливается слабым фиолетовым отливом...")
	novel_interface.show_character("ren_full","gratified")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("stardust_small","tear",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("(Она приняла меня за кого-то другого?)\n(Я не знаю, что с ней делать...)", "Лиан")
	await novel_interface.show_dialog("Ладно, ладно...", "Лиан")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Вот только это НЕ в порядке!\nЯ ужасно отношусь к детям!")
	novel_interface.show_character("ren_full","smile")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("stardust_small","tear",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Я не брошу тебя, но ты должен подыграть. Если кто спросит, скажи, что пришел со мной, слышишь?", "Лиан")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Она кивает, ее голова все еще уткнулась в мою одежду.")
	novel_interface.show_character("ren_full","shy")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("stardust_small","tear",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("(...Она приняла меня за свою маму?)", "Лиан")
	novel_interface.change_expression("shy_left")
	await novel_interface.show_dialog("(Когда я был еще мальчиком, у меня даже не было первого поцелуя...)", "Лиан")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("По первоначальному плану, если появится ведьма, я должен снова загипнотизировать официанта, как только подтвержу, что ведьма не враждебна.")
	await novel_interface.show_text_only("Я уговариваю маленькую тварь ослабить хватку, а затем прячу эту похожую на леденец сферу в безопасное место.")
	await novel_interface.show_text_only("На всякий случай я снова открываю сейф № 0812 и вижу, что метеор все еще лежит внутри.")
	novel_interface.show_character("ren_full","normal2")
	await novel_interface.show_dialog("(Он не сломался, как Ляписовый Столб в прошлый раз...)", "Лиан")
	await novel_interface.hide_character()
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	await novel_interface.show_text_only("Поднимая голову, я замечаю, что индикатор состояния камеры наблюдения быстро мигает — это сигнал тревоги, который мы с Энни придумали.")
	novel_interface.show_character("ren_full","serious")
	await novel_interface.show_dialog("Что-то случилось?!", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Что еще хуже — я понятия не имею, как долго длится этот сигнал тревоги…")
	await novel_interface.show_text_only("Затем из конца коридора доносится резкий звон.")
	novel_interface.show_character("ren_full","serious")
	await novel_interface.show_dialog("Это...", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Тяжелая дверь лифта медленно открывается.")
	novel_interface.show_character("ren_full","wail")
	await novel_interface.show_dialog("Дерьмо!", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я беру Stardust, туфли и сумочку и бегу к лифту.")
	novel_interface.show_character("ren_full","sob")
	await novel_interface.show_dialog("(Нет времени снова гипнотизировать официанта. Как мне объяснить этого ребенка?)", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Все происходит слишком быстро. Как только я подхожу к официанту, дверь лифта полностью открывается.")
	await novel_interface.show_text_only("Из лифта выходят четыре человека. Впереди молодая женщина в военной форме.")
	await novel_interface.show_text_only("Позади нее идут два мускулистых солдата в синих камуфляжных костюмах. А менеджер казино застрял посередине, под их опекой.")
	await novel_interface.show_text_only("Женщина впереди смотрит на дежурного, а затем на меня и говорит скучающим тоном:")
	novel_interface.show_character("emilio","stare")
	await novel_interface.show_dialog("Я второй лейтенант Эмили Швертлауте из Сил обороны Масады. Мы проводим операцию по обеспечению морской безопасности.", "Женщина-офицер")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("У этого младшего лейтенанта бледная кожа. У нее глаза разного цвета: правый синий, а левый оранжевый.")
	novel_interface.show_character("ren_full","stare")
	await novel_interface.show_dialog("(Гетерохромия?? Впервые вижу такого...)", "Лиан")
	await novel_interface.hide_character()
	novel_interface.show_character("emilio","stare")
	await novel_interface.show_dialog("В настоящее время вы находитесь в водах, находящихся под военным контролем Масадана. Мы получили информацию о том, что на этом корабле находится контрабанда, запрещенная Самонтонским договором...", "Эмили")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Я уже обсудил всю речь о праве обыска с капитаном наверху.", "Эмили")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("Если у вас есть какие-либо возражения, подайте их в Военный комитет Масады. Или вооруженные патрульные катера снаружи.", "Эмили")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Молодой младший лейтенант, как обычно, объясняет уведомление, заряжая пистолет.")
	novel_interface.show_character("emilio","smile")
	await novel_interface.show_dialog("Поэтому, пожалуйста, сотрудничайте с нами.", "Эмили")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Она подает сигнал. Двое солдат «провожают» менеджера казино прямо в хранилище.")
	novel_interface.show_character("emilio","speechless")
	await novel_interface.show_dialog("В сейфе были только вы двое?\nЧто вы там делали?", "Эмили")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_full","normal1")
	await novel_interface.show_dialog("(Нас... Двое??)", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я смотрю на Stardust. Она просто моргает, вся невинная.")
	await novel_interface.show_text_only("Официант проснулся. Он смотрит на чип в своей руке. Я очень нервничаю.")
	novel_interface.show_character("ren_full","sob")
	await novel_interface.show_dialog("(«Человеческий мозг может восполнить детали, основываясь даже на самых простых указаниях или подсказках». Я могу только надеяться, что это правда...)", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Его лицо краснеет, пот покрывает лоб, как будто его только что поймали за чем-то неприличным.")
	await novel_interface.show_dialog("О, ничего!", "Официант")
	await novel_interface.show_dialog("Мы ничего не делали...", "Официант")
	novel_interface.show_character("emilio","speechless")
	await novel_interface.show_dialog("...", "Эмили")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_full","wail")
	await novel_interface.show_dialog("...", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Что именно он «вспомнил»?")
	await novel_interface.show_text_only("И разве он не видит, что здесь есть третий человек?")
	novel_interface.show_character("emilio","mock")
	await novel_interface.show_dialog("Это так?", "Эмили")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("На ее лице появляется сложное выражение, она несколько секунд смотрит на официанта, затем подходит к нему ближе.")
	await novel_interface.show_text_only("Официант же просто смотрит на свой пистолет. Он выглядит так, будто обмочится в штаны в любой момент.")
	await novel_interface.show_text_only("Хм! Затем Эмили оборачивается и улыбается мне.")
	novel_interface.show_character("emilio","mock")
	await novel_interface.show_dialog("Мисс, могу я увидеть удостоверение личности?", "Эмили")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_full","panic")
	await novel_interface.show_dialog("А?\n... О, конечно!", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я тянусь к сумочке в поисках «правильного» удостоверения личности. SID подготовил для меня несколько поддельных удостоверений личности.")
	await novel_interface.show_text_only("Если Масада меня спросит, мне следует использовать...\nОранжевый!")
	await novel_interface.show_text_only("Она сканирует мое удостоверение личности на своем портативном устройстве, ее брови поднимаются вверх.")
