# stardustdescends_ep08.gd - 星尘降临篇第8话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	stardustdescends_ep08_script()

func play_script():
	pass

func stardustdescends_ep08_script():
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Masada0.png")
	await novel_interface.show_text_only("Die dritte Schulstadt, Masadaburg.")
	await novel_interface.show_text_only("Eine in der Wüste erbaute Militärfestung, berühmt für Schlamm aus dem Toten Meer, Sandstürme und Terroranschläge.")
	await novel_interface.show_text_only("Für die meisten Menschen bedeutet jede Nachricht über Masadaburg entweder einen militärischen Konflikt oder eine humanitäre Katastrophe.")
	await novel_interface.show_text_only("Eine vom Tod gefärbte Landschaft aus Blut und Sand, Rohöl und weißem Rauch hing schon lange über diesem alten Land ...")
	await novel_interface.show_text_only("Was für ein Leben führen die Menschen dort?\nIch habe absolut keine Ahnung ...")
	await novel_interface.show_text_only("Dennoch kommt es mir auch seltsam vertraut vor, als wäre ich selbst dort gewesen ...")
	await novel_interface.hide_background()
	await novel_interface.show_dialog("Seufz──", "Lian")
	novel_interface.change_music("res://assets/audio/music/unkown/UI_Main_Funk.mp3")
	novel_interface.show_background("res://assets/images/bg/Stardust/Vessel.png")
	await novel_interface.show_text_only("Ich lehnte an der Reling an Deck, während Stardust sich wie ein Koala an mich klammerte, Tränen schimmerten immer noch in ihren Augen.")
	novel_interface.show_character("ren_full","wry_smile")
	await novel_interface.show_dialog("Okay, okay. Ich habe nur Spaß gemacht──", "Lian")
	novel_interface.change_expression("wail")
	await novel_interface.show_dialog("Hey, ganz einfach. Deine Nägel graben sich in mein Fleisch ...", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("stardust_small","tear",0.25)
	await novel_interface.show_dialog("Schnüffeln...", "Stardust")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("D-Wisch dir nicht die Nase an meiner Kleidung ab!!!", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Ich stieß einen hilflosen Seufzer aus und streichelte ihren Kopf, um sie zu beruhigen.")
	await novel_interface.show_text_only("Zuvor vermutete Aya, dass die Richtung, in die Stardust gezeigt hatte, Masadaburg war, aber nachdem sie sich umgehört hatte, stellte sich heraus, dass das Mädchen keine Ahnung hatte, was dieser Ortsname bedeutete.")
	await novel_interface.show_text_only("Oder besser gesagt, sie verstand nicht einmal das Konzept einer „Schulstadt“ ...")
	await novel_interface.show_text_only("Mariru sagte, sie würde zuerst die Informationen klären und sagte mir, ich solle an Deck warten, bis sie mich erneut kontaktierte.")
	await novel_interface.show_text_only("Ich konnte immer noch nicht akzeptieren, dass dieses Mädchen eine Illusion war, die nur ich sehen konnte, also nutzte ich die Gelegenheit, um noch ein paar Tests durchzuführen──")
	await novel_interface.show_text_only("Zuerst legte ich mein Telefon auf den Boden und bat sie, es aufzuheben.")
	await novel_interface.show_text_only("Stattdessen schenkte sie mir nur ein höfliches Lächeln, legte den Kopf schief und sah mich an wie: „Bist du dumm?“")
	await novel_interface.show_text_only("Nach etwa dreißig Sekunden der Pattsituation konnte ich nur noch unbeholfen mein eigenes Telefon in die Hand nehmen, und dann kam mir eine noch dümmere Idee──")
	await novel_interface.show_text_only("„Wenn sie keinen physischen Körper hat, könnte sie dann durch Wände gehen?“")
	await novel_interface.show_text_only("Während sie zusah, ging ich zurück in die Kabine, schloss die Tür zum Deck ab und versteckte mich in ihrem toten Winkel.")
	await novel_interface.show_text_only("Zwei Minuten später hörte ich auf der anderen Seite leises Schluchzen. Ich spürte, dass es Ärger gab, und öffnete hastig die Tür. Sie packte mich am Oberschenkel und weigerte sich, sie loszulassen.")
	await novel_interface.show_text_only("Um zu vermeiden, dass gelegentlich Kellner durch die Kabine gingen, bemühte ich mich, sie zurück an die Reling zu ziehen.")
	novel_interface.show_character("ren_full","wail")
	await novel_interface.show_dialog("(Mit diesem Beinzubehör kann ich kaum laufen ...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ist es immer so anstrengend, auf ein Kind aufzupassen?")
	await novel_interface.show_text_only("Schlimmer noch, niemand sonst kann sie sehen. Im Moment muss ich wie ein Verrückter aussehen, der vor sich hin murmelt und sich seltsam bewegt.")
	await novel_interface.show_text_only("Da ich wirklich keine Antwort auf ihre Anhänglichkeit wusste, konnte ich sie nur sanft überreden.")
	novel_interface.show_character("ren_full","wry_smile")
	await novel_interface.show_dialog("Da, da. Ich werde dich nicht zurücklassen~", "Lian")
	novel_interface.change_expression("gratified")
	await novel_interface.show_dialog("Das war gerade mein Problem. Ich werde mich entschuldigen, okay?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ich sagte das, während ich ihr ein albernes Gesicht verzog.")
	await novel_interface.show_text_only("Wenn jemand sehen würde, wie ich im leeren Raum Grimassen schneide, würde ich am liebsten direkt in einen Spalt im Deck kriechen.")
	await novel_interface.show_text_only("Stardust hat sich etwas beruhigt. Sie umarmte mich immer noch, blickte auf, blinzelte mit ihren großen Augen und die Ohrstöpsel an ihrem Kopf blitzten.")
	novel_interface.show_character("stardust_small","tear")
	await novel_interface.show_dialog("Dann versprich mir, dass du mit mir in diese Richtung gehst, okay...?", "Stardust")
	await novel_interface.show_dialog("Es ist wirklich, wirklich wichtig...", "Stardust")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("...")
	await novel_interface.show_text_only("Du hast doch gerade nicht vorgetäuscht geweint, oder?")
	novel_interface.show_character("ren_full","upset")
	await novel_interface.show_dialog("(Kinder sind wirklich eine Handvoll...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ich hatte keine Ahnung, ob Mariru es gutheißen würde, wenn ich diesen kleinen Begleiter an einen so gefährlichen Ort mitnehme.")
	await novel_interface.show_text_only("In diesem Moment knisterte ein statisches Rauschen durch meinen Ohrhörer, und Mariru meldete sich wieder am Telefon.")
	await novel_interface.show_dialog("Lian, Annie, wie viel wisst ihr beide über Masadaburg?", "Mariru")
	novel_interface.show_character("ren_full","worry")
	await novel_interface.show_dialog("Hm...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Ungefähr...", "Annie")
	await novel_interface.show_text_only("Ich habe mich angestrengt, mich zu erinnern, aber selbst in der Agentenschulung waren die Informationen über Masadaburg fragmentiert gewesen.")
	await novel_interface.show_dialog("Die Third School City, eine Festungsstadt im Herzen Westasiens, geteilt durch eine Dutzende Meter hohe Isolationsmauer in innere und äußere Bezirke.", "Annie")
	novel_interface.show_character("ren_full","bored")
	await novel_interface.show_dialog("Ich denke, es lag an ethnischen oder religiösen Konflikten oder so?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Wie auch immer, der Außenbezirk von Masadaburg scheint gefährlich zu sein. Es hört sich so an, als gäbe es jeden Monat ein oder zwei Bombenanschläge!")
	await novel_interface.show_dialog("Ihr Geheimdienst, das Masada Restoration Mission Bureau, wird direkt vom Militär kontrolliert und hat einen kühnen, radikalen Stil.", "Annie")
	novel_interface.show_character("ren_full","happy")
	await novel_interface.show_dialog("Ah, das weiß ich. Diese Agentur heißt auch „Monola“, oder?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Es ist ein Name, der ständig in Filmen und Spielen auftaucht, wenn auch selten als Hauptfraktion.")
	novel_interface.show_character("ren_full","smile")
	await novel_interface.show_dialog("Richtig, auch ihre Waffen sind fortschrittlich. In Spielen ist Masada normalerweise die Seite, die die Spieler mit ferngesteuerten Panzern und Drohnen versorgt ...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Okay, das reicht──", "Mariru")
	await novel_interface.show_dialog("Das geopolitische Umfeld in dieser Region war schon immer komplex, und wenn man Widerstandskräfte und Separatistengruppen hinzufügt, wird es noch chaotischer.", "Mariru")
	await novel_interface.show_dialog("Aber wenn wir nur vom „inneren Bezirk“ von Masadaburg sprechen: Seine Sicherheit ist nicht schlechter als die von New Toyosu, also──", "Mariru")
	novel_interface.show_character("ren_full","perspire1")
	await novel_interface.show_dialog("Hä? Sag es mir nicht...\nDu hast zugestimmt?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Immer noch um meinen Oberschenkel gewickelt, zappelte Stardust glücklich.")
	await novel_interface.show_dialog("Nur wir beide... bist du sicher, dass es uns gut geht?", "Annie")
	await novel_interface.show_text_only("Drei. Drei von uns!!\nVergessen Sie nicht, dass es hier zusätzliches Gepäck gibt!!")
	await novel_interface.show_dialog("Das ist keine Spionagemission. Wir kennen noch nicht einmal unser genaues Ziel. Solange du nichts Unverschämtes tust, ist alles in Ordnung.", "Mariru")
	await novel_interface.show_dialog("Außerdem müssen Sie nicht einmal das Schiff wechseln. Dieses Casino-Schiff wird morgen früh im Hafen von Masada anlegen~", "Aya")
	await novel_interface.show_dialog("...Was ist los? Sollten wir nicht nach Samonton fahren?", "Annie")
	await novel_interface.show_dialog("Masada soll in drei Tagen ein Waffenstillstandsabkommen mit dem Widerstand unterzeichnen, und bis zum Ende der Zeremonie wird der Suezkanal vollständig versiegelt sein.", "Mariru")
	await novel_interface.show_dialog("Um die Sicherheit seiner Passagiere zu gewährleisten, hat das Casino gerade beschlossen, der „eindringlichen Empfehlung“ des Masada-Militärs zu folgen und nach Eilat zurückzukehren.", "Mariru")
	await novel_interface.show_dialog("Dieses Schiff wird entlang des Großen Kanals Rotes Meer-Totes Meer nach Norden fahren, im Hafen von Masada anlegen und dort bleiben, bis die Blockade des Suezkanals aufgehoben wird.", "Mariru")
	await novel_interface.show_dialog("Annies Tarnidentität ist eine Studentin in einem Kunstaustauschprogramm in New Toyosu. Der Papierkram ist bereits erledigt.", "Mariru")
	await novel_interface.show_dialog("Was Sie betrifft, Lian──Masadas Küstenverteidigung hat Ihre Tarnidentität wahrscheinlich bereits registriert, also bleiben Sie die kleine Krankenschwester, die Sie sind~", "Mariru")
	await novel_interface.show_text_only("In Marirus Stimme lag ein Lächeln, das mich ein wenig unruhig machte.")
	novel_interface.show_character("ren_full","panic")
	await novel_interface.show_dialog("Huh??!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("In jedem Fall können Sie nicht umziehen, bis die Vereinbarung unterzeichnet ist, also verbringen Sie die nächsten zwei Tage damit, die Stadt zu besichtigen", "Aya")
	await novel_interface.show_dialog("Wenn sich herausstellt, dass der Ort, an den das Mädchen gehen möchte, außerhalb der Stadt liegt, lasse ich den örtlichen Geheimdienst in drei Tagen jemanden schicken, der Sie unterstützt.", "Mariru")
	novel_interface.show_character("ren_full","panic")
	await novel_interface.show_dialog("Sogar der Suezkanal ist abgeriegelt...", "Lian")
	await novel_interface.show_dialog("Nur eine Vereinbarung unterzeichnen... müssen sie wirklich so weit gehen?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.stop_music()
	await novel_interface.show_dialog("Das liegt daran...", "Aya")
	await novel_interface.show_dialog("Denn es ist schon ernst──", "Aya")
	await novel_interface.show_dialog("Ihr beide seid die ganze Zeit auf dem Schiff gewesen, ihr wisst es also noch nicht, oder?", "Mariru")
	await novel_interface.show_dialog("W-Was ist passiert...?", "Annie")
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("Vor mehr als zehn Stunden ereignete sich in der Nähe der Ibra-Moschee in Hebron im Gebiet von Masada eine Explosion mit Industriechemikalien.", "Mariru")
	await novel_interface.show_dialog("Die Druckwelle verursachte einen teilweisen Einsturz benachbarter Gebäude und beschädigte die örtlichen Strom-, Wasser- und Gassysteme.", "Mariru")
	await novel_interface.show_dialog("Der offiziellen Erklärung zufolge wurden alle Bewohner dieses Gebiets bereits in eine sichere Zone evakuiert.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Ein weiterer Terroranschlag?", "Lian")
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("Unter der Ibra-Moschee liegt die Höhle von Machpela, die angeblich die Grabstätte der Vorfahren des Masadan-Volkes war.", "Aya")
	await novel_interface.show_dialog("Obwohl sie seit der Übernahme dieser Stadt im letzten Jahrhundert nie irgendwelche archäologischen Ausgrabungen dort durchgeführt haben ...", "Aya")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("Das Merkwürdige ist, dass der offizielle Unfallbericht zwar plausibel ist, die Informationsblockade jedoch viel zu streng ist ...", "Aya")
	await novel_interface.show_dialog("Es gibt nicht einmal online die Möglichkeit, von Anwohnern aufgenommene Videos zu finden. Auf jeder Nachrichtenseite zu diesem Vorfall werden Fotos und Videos verwendet, die von Beamten aus Masada bereitgestellt wurden.", "Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","serious")
	await novel_interface.show_dialog("Gleichzeitig kam es in den elektronischen Systemen mehrerer großer Krankenhäuser in Hebron zu Störungen und eine große Anzahl von Notfallakten gingen verloren.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("Nach dem Unfall lehnte Masada das Angebot der Welterbeorganisation, bei der Erhaltung der Ruinen der Machpelah-Höhle zu helfen, fast sofort ab.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Dieses Maß an offensichtlicher Informationskontrolle klingt wirklich nach Monola ... aber warum sollten sie die Informationen blockieren?", "Annie")
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("Wahrscheinlich, weil sie nicht wollen, dass die Situation noch komplizierter wird──", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Die Analyse von Satellitenbildern legt nahe, dass die Explosion höchstwahrscheinlich von einer kleinen Rakete verursacht wurde.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Der Widerstand?\nAber sind sie nicht dabei, einen Waffenstillstand zu unterzeichnen ...?", "Lian")
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("Der Widerstandsführer veröffentlichte sofort in den sozialen Medien, dass der Vorfall nichts mit ihm zu tun habe, und drückte sein Bedauern und seine Verurteilung aus.", "Aya")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("Derzeit vermutet das Geheimdienstteam, dass der Angriff möglicherweise von einer Splittergruppe des Widerstands verübt wurde. Diese Leute waren nie ein einheitlicher Block", "Aya")
	await novel_interface.show_dialog("Selbst wenn der Anführer einen Waffenstillstand will, wollen die Hardliner im Inneren nicht, dass die Vereinbarung zustande kommt, oder?", "Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("Vielleicht. Aber das alles ist noch Spekulation. Was nicht spekulativ ist, ist, dass diese nächsten drei Tage die heikelste Zeit sind, die der Third School City bevorstehen könnte──", "Mariru")
	await novel_interface.show_dialog("Dementsprechend ist das Sicherheitsniveau von Masada am höchsten. Im inneren Bezirk sind Sie sicherer als auf dem offenen Meer.", "Mariru")
	novel_interface.change_expression("sigh")
	await novel_interface.show_dialog("Gönnen Sie sich heute Abend eine ordentliche Ruhepause. Wir werden Sie morgen erneut kontaktieren, sobald Sie den Hafen erreichen.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Okay!", "Lian")
	await novel_interface.show_dialog("Verstanden~", "Annie")
	await novel_interface.show_text_only("Damit beendete Mariru das Gespräch mit den beiden Personen an Bord des Schiffes und richtete ihren Blick auf das Videobild einer Frau in Rot auf dem großen Bildschirm.")
	novel_interface.show_character("akiko","serious")
	await novel_interface.show_dialog("... Du denkst doch auch, dass etwas nicht stimmt, oder?", "Akiko")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","sigh")
	await novel_interface.show_dialog("Ja. Diese Vereinbarung wurde viel zu plötzlich bekannt gegeben──", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Letzte Woche kündigte ein Regierungssprecher von Masada plötzlich an, dass man innerhalb von zehn Tagen ein Waffenstillstandsabkommen mit dem Widerstand unterzeichnen werde.", "Mariru")
	await novel_interface.show_dialog("Regierungen und Medien auf der ganzen Welt haben es alle gelobt, und Abrüstung und Waffenstillstand sind tatsächlich der allgemeine Trend.", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("──Aber die Einigung fühlt sich immer noch viel zu voreilig an.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("akiko","normal")
	await novel_interface.show_dialog("Ich stimme zu. Es klingt nicht nach der üblichen Art von Premierminister Sheinneman, nur nach sorgfältiger Planung umzuziehen.", "Akiko")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("Liegt es daran, dass sich sein Zustand stärker verschlechtert hat als erwartet ...?", "Aya")
	await novel_interface.show_dialog("Seit dem letzten Friedensforum hat Premierminister Sheinneman kein einziges Mal sein Gesicht in der Öffentlichkeit gezeigt", "Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","sigh")
	await novel_interface.show_dialog("Das ist möglicherweise nicht der einzige Grund──", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Die internen Widersprüche innerhalb der Verteidigungskräfte Masadas nähern sich wahrscheinlich dem Punkt, an dem sie nicht mehr beigelegt werden können.", "Mariru")
	await novel_interface.show_dialog("Angesichts drastischer Personal- und Budgetkürzungen ist es nur eine Frage der Zeit, bis sich die hochdekorierten Offiziere und die Tech-Fraktion gegenseitig auseinanderreißen.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("akiko","serious")
	await novel_interface.show_dialog("Ein Kampf zwischen der an der Akademie ausgebildeten technischen Fraktion innerhalb der Verteidigungskräfte und der Kriegsverdienstfraktion, die sich an der Front einen Namen gemacht hat ...", "Akiko")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru nickte leicht.")
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("Und Masada hat immer noch nicht entschieden, wer dieses historische Abkommen in seinem Namen unterzeichnen wird──", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Wer auch immer vor den Augen der ganzen Welt eine so beispiellose Leistung für sich beansprucht, wird höchstwahrscheinlich die nächste Wahl gewinnen, oder?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("akiko","normal")
	await novel_interface.show_dialog("Zwangsläufig...", "Akiko")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Als würde Akiko plötzlich etwas bemerken, stieß sie ein leises „Ah“ aus.")
	novel_interface.show_character("akiko","shock")
	await novel_interface.show_dialog("Masada möchte nicht, dass dieser Angriff die Unterzeichnungszeremonie beeinträchtigt, also bestehen sie darauf, dass es sich um einen Chemieexplosionsunfall handelte ...?", "Akiko")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal2")
	await novel_interface.show_dialog("Heh, die Art, wie du aussiehst, wenn du geschüttelt wirst, ist so süß wie immer~", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("akiko","shy")
	await novel_interface.show_dialog("(unter Atem) ...Pervers.", "Akiko")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Akikos Wangen erröteten leicht, als sie zweimal hustete.")
	novel_interface.show_character("akiko","shy")
	await novel_interface.show_dialog("Na, hast du schon eines gefunden?", "Akiko")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("──Der richtige „Kandidat“, den Sie letztes Mal erwähnt haben.", "Akiko")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru schüttelte den Kopf.")
	novel_interface.show_character("liliu_uniform1","sigh")
	await novel_interface.show_dialog("Wenn es so einfach wäre, einen zu finden, hätte dieser alte Mann Sheinneman nicht so lange durchgehalten, ohne in den Ruhestand zu gehen ...", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.stop_music()
	await novel_interface.hide_background_with_fade()
	await novel_interface.show_text_only("...")
	await novel_interface.show_text_only("Am nächsten Morgen, 8:40 Uhr")
	await novel_interface.show_text_only("Das Casinoschiff Liberty Star, VIP-Restaurant.")
	novel_interface.change_music("res://assets/audio/music/Shop.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_Gambling_Boat4.png")
	await novel_interface.show_text_only("Das VIP-Restaurant befand sich auf dem Oberdeck. Es war nicht groß, aber die Aussicht war ausgezeichnet.")
	await novel_interface.show_text_only("Vor den Fenstern hingen dunkle Wolken, und auf der Tiefseeoberfläche schien sich eine unheilvolle Katastrophe anzubahnen.")
	await novel_interface.show_text_only("Vielleicht weil die meisten Gäste gestern Abend von den unbegrenzten Gratisgetränken des Casinos umgehauen waren, war unser Tisch der einzige besetzte im Restaurant.")
