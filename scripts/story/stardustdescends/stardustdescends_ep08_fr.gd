	await novel_interface.show_text_only("Un paysage teinté de mort, de sang et de sable, de pétrole brut et de fumée blanche, plane depuis longtemps sur cette terre ancienne...")
	await novel_interface.show_text_only("Quel genre de vie les gens vivent-ils là-bas ?\nJe n'en ai absolument aucune idée...")
	await novel_interface.show_text_only("Pourtant, cela me semble aussi étrangement familier, comme si j'y étais moi-même...")
	await novel_interface.hide_background()
	await novel_interface.show_dialog("Soupir──", "Lian")
	novel_interface.change_music("res://assets/audio/music/unkown/UI_Main_Funk.mp3")
	novel_interface.show_background("res://assets/images/bg/Stardust/Vessel.png")
	await novel_interface.show_text_only("Je m'appuyais contre la balustrade du pont tandis que Stardust s'accrochait à moi comme un koala, les larmes scintillant encore dans ses yeux.")
	novel_interface.show_character("ren_full","wry_smile")
	await novel_interface.show_dialog("Très bien, très bien. Je plaisantais──", "Lian")
	novel_interface.change_expression("wail")
	await novel_interface.show_dialog("Hé, c'est facile. Tes ongles s'enfoncent dans ma chair...", "Lian")
