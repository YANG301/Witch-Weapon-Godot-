	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_Vault.png")
	await novel_interface.show_text_only("ณ จุดนี้ ฉันแค่อยากจะออกไปจากที่นี่ให้เร็วที่สุด ฉันส่งสัญญาณ Stardust แล้วเดินไปที่ลิฟต์")
	await novel_interface.show_text_only("เธอเข้าใจความตั้งใจของฉันทันทีและตามทันฉันอย่างรวดเร็ว")
	await novel_interface.show_text_only("เด็กหญิงตัวเล็ก ๆ ดูเหมือนจะรู้สึกถึงความกังวลของฉัน เธอจึงถูข้อมือของฉันเบา ๆ")
