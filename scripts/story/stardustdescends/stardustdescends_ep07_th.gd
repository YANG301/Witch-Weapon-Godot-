	await novel_interface.show_text_only("โทรศัพท์และหูฟังของฉันไม่สามารถรับสัญญาณใดๆ ได้เช่นกัน Stardust กลัวสิ่งที่เธอเห็นจึงซ่อนอยู่ข้างหลังฉัน")
	await novel_interface.show_text_only("บริเวณทางออกล็อบบี้เจ้าหน้าที่ใช้ลำโพงประกาศกฎเกณฑ์การตรวจรักษาความปลอดภัย")
