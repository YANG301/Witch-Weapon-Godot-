	await novel_interface.show_text_only("เมื่อสัมผัสถึงมืออันอ่อนนุ่มและอุณหภูมิของเธอ ฉันจึงค่อยๆ สงบสติอารมณ์ลง แล้วจึงจับมือเธอไว้")
	novel_interface.show_character("stardust_small","normal2")
	await novel_interface.show_text_only("ดูเหมือนเราจะได้สร้างสายสัมพันธ์พิเศษระหว่างเราแล้ว เธอเริ่มยิ้ม")
	await novel_interface.show_text_only("มันไม่แปลกเลยที่เราเพิ่งพบกัน")
