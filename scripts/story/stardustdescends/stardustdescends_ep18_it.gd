	novel_interface.show_character("hamon","serious")
	await novel_interface.show_dialog("E un cadetto della Torre, per di più...", "Hamon")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Hamon lo disse parola per parola.")
	await novel_interface.show_text_only("Rendendosi conto delle ripercussioni politiche che ciò avrebbe potuto causare, il maggiore non poté fare a meno di trattenere il fiato...")
	await novel_interface.show_text_only("All'interno delle Forze di Difesa c'erano sempre state molte voci contrarie a questo accordo, soprattutto tra i giovani agitatori desiderosi di distinguersi.")
	novel_interface.show_character("hamon","serious")
	await novel_interface.show_dialog("Ancora più strano, le impronte digitali rilevate sulla scena mostrano che tra coloro che agivano con lei c'era uno straniero che si era registrato all'immigrazione pochi giorni fa.", "Hamon")
