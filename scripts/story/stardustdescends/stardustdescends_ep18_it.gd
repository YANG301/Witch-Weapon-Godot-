	await novel_interface.show_dialog("Una spia all'estero?", "Maggiore")
	await novel_interface.show_text_only("Le sopracciglia di Hamon si aggrottarono insieme mentre rifletteva per un momento.")
	novel_interface.show_character("hamon","speak")
