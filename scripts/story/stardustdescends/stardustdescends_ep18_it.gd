# stardustdescends_ep18.gd - 星尘降临篇第18话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	stardustdescends_ep18_script()

func play_script():
	pass

func stardustdescends_ep18_script():
	novel_interface.change_music("res://assets/audio/music/Sewer.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_Psychology.png")
	await novel_interface.show_text_only("Tutti hanno sperimentato il dolore interiore: qualcosa di così reale, così pesante, così angosciante, così difficile da sopportare.")
	await novel_interface.show_text_only("Eppure poche persone sanno che la maggior parte della sofferenza psicologica viene appresa dopo la nascita.")
	await novel_interface.show_text_only("Un bambino che riesce a stare felice tutto il giorno con nient’altro che una coscia di pollo non può capire il dolore di essere escluso e isolato dai compagni di classe sui social media.")
	await novel_interface.show_text_only("Sia che tu soffra perché non riesci a inserirti in un gruppo, perché chi ti circonda non ti accetta, o perché non riesci a diventare la persona che immagini...")
	await novel_interface.show_text_only("Tutto quel dolore si basa su concetti complessi, niente più che un sottoprodotto di significati accumulati appresi dopo il fatto.")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_Camus.png")
	await novel_interface.show_text_only("Camus diceva che l’assurdità dell’umanità risiede nella ricerca infinita di significato in un universo privo di significato.")
	await novel_interface.show_text_only("Sotto le catene del significato, nessuno può ottenere la vera libertà.")
	await novel_interface.show_text_only("La civiltà umana non può esistere senza significato; è il fondamento dei sistemi sociali in ogni epoca.")
	await novel_interface.show_text_only("Il significato di clan, il significato di nazione, il significato di proprio signore, il significato di religione, persino l'identità etnica, l'ideologia e la cultura pop...")
	await novel_interface.show_text_only("Una volta che ti è stato instillato un sistema di significato, tutti i tipi di idee si formano naturalmente e nella tua mente si costruisce una scala di valori...")
	await novel_interface.show_text_only("cosa merita lode e promozione, cosa merita disprezzo e condanna, cosa conta come felicità e onore, cosa dovrebbe portare dolore e vergogna...")
	await novel_interface.show_text_only("Alcune persone sono spinte al suicidio dal cambiamento dinastico, altre dal matrimonio del loro idolo; non esiste una distinzione vera o falsa tra il loro dolore.")
	await novel_interface.show_text_only("Ma se la tua mente è abbastanza acuta, forse di tanto in tanto puoi liberarti dalle catene e scivolare fuori da solo a prendere una boccata d'aria.")
	await novel_interface.show_text_only("Poi ritorni nel gruppo, continui a fingere di indossare le catene, lodando ciò che tutti lodano e disprezzando ciò che tutti disprezzano.")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_Prisoner.png")
	await novel_interface.show_text_only("Perché se sei intelligente, devi già renderti conto di questo: l'umanità non solo è prigioniera del senso, ma ne diventa volentieri il carceriere.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("..............")
	await novel_interface.show_text_only("...")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_ConventionCentre.png")
	await novel_interface.show_text_only("Centro Congressi Internazionale di Masada, prima della cerimonia della firma.")
	await novel_interface.show_text_only("Nella sala erano già presenti i reporter di oltre un centinaio di organi di stampa, con flash e telecamere pronte a registrare questo momento storico.")
	await novel_interface.show_text_only("Dietro il podio, una pesante tenda blu isolava completamente la rumorosa sala dal backstage.")
	await novel_interface.show_text_only("File di impianti di illuminazione professionali nuovi di zecca sulle capriate del soffitto erano tutti in standby a bassa luminosità.")
	await novel_interface.show_text_only("I pannelli acustici avvolti nelle pareti e il rivestimento insonorizzante sulla tenda rendevano il posto stranamente silenzioso.")
	await novel_interface.show_text_only("Quando l'ufficiale in mimetica da deserto vide l'uomo vestito di grigio avvicinarsi attraverso il passaggio dietro la tenda, si raddrizzò immediatamente e fece il saluto militare.")
	await novel_interface.show_text_only("Le insegne di grado sul collare mimetico e la stella dorata a sei punte dimostravano che era un maggiore delle Forze di Difesa.")
	await novel_interface.show_text_only("E l'uomo che stava per informare era il rappresentante di Masadan di oggi: il Maggiore Generale Hamon del Comando Nord delle Forze di Difesa.")
	await novel_interface.show_dialog("Fate rapporto, signore. Sono qui per aggiornarti sull'attacco proprio adesso.", "Maggiore")
	await novel_interface.show_text_only("Il maggiore generale era ingrassato, ma i suoi capelli erano ancora pettinati con perfetta precisione e il suo sguardo conservava l'acutezza caratteristica del soldato.")
	await novel_interface.show_text_only("Mentre camminava, allentò con impazienza la cravatta e la rimboccò insieme alla tavoletta con il retro in pelle nera che aveva in mano.")
	novel_interface.show_character("hamon","serious")
	await novel_interface.show_dialog("Non riesco mai ad abituarmi a indossare questa cosa...", "Hamon")
	await novel_interface.show_dialog("Vai avanti.", "Hamon")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("È il rapporto dell'indagine sull'esplosione a sud-ovest del centro congressi, trenta minuti fa.", "Maggiore")
	await novel_interface.show_dialog("Sulla base delle tracce sulla scena, la squadra artificieri ha concluso che si trattava di un ordigno esplosivo fatto principalmente con zucchero.", "Maggiore")
	novel_interface.show_character("hamon","serious")
	await novel_interface.show_dialog("...Una bomba fatta in casa fatta di zucchero?", "Hamon")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Sì, ma l'intensità dell'esplosione non è stata elevata e non ha causato vittime. Sembra che l'esplosivo contenesse additivi che aumentavano il fumo.", "Maggiore")
	await novel_interface.show_dialog("Abbiamo spento immediatamente il fumo. Il reggimento di guardia ha ora isolato l’area circostante e finora nessun media ha riportato l’incidente.", "Maggiore")
	await novel_interface.show_dialog("La sorveglianza stradale nelle vicinanze non ha ancora trovato alcun sospetto. Stiamo espandendo l'area di ricerca ora. Rapporto completato.", "Maggiore")
	novel_interface.show_character("hamon","serious")
	await novel_interface.show_dialog("...Tutto qui?", "Hamon")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Hamon fissò il maggiore negli occhi e non disse nulla per un lungo momento. Il maggiore non osava parlare e poteva solo restare rigido sul posto.")
	await novel_interface.show_text_only("Hamon sbuffò e, insoddisfatto, sbatté la tavoletta che aveva in mano sul petto del maggiore--")
	novel_interface.show_character("hamon","speak")
	await novel_interface.show_dialog("Guardalo tu stesso!", "Hamon")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Barcollando dopo il colpo, il maggiore si affrettò a stabilizzare il tablet. Sullo schermo c'era l'iconico logo del candelabro a sette bracci di Monola.")
	novel_interface.show_character("hamon","serious")
	await novel_interface.show_dialog("L'hanno mandato pochi minuti fa.", "Hamon")
	await novel_interface.show_dialog("Monola ha individuato tre individui sospetti che si erano mescolati nel parcheggio sotterraneo.", "Hamon")
	await novel_interface.show_dialog("Due di loro sono scivolati nel pozzo dell'ascensore con l'intenzione di sabotare il sistema antincendio dell'edificio.", "Hamon")
	await novel_interface.show_dialog("Fortunatamente i loro agenti sono intervenuti in tempo. Ne catturarono uno, ma gli altri due fuggirono; uno di loro è stato raggiunto da un proiettile mentre fuggiva.", "Hamon")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("...La tromba dell'ascensore!?\nS-Qualcuno si è infiltrato nel locale?", "Maggiore")
	await novel_interface.show_text_only("Il maggiore sfogliò rapidamente il rapporto e la sua testa cominciò subito a ronzare:")
