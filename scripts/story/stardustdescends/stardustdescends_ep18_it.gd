	await novel_interface.show_text_only("Poiché il parcheggio in superficie era stato occupato dalle forze di sicurezza e da veicoli militari, tutti i furgoni delle apparecchiature multimediali erano parcheggiati nel seminterrato del centro congressi.")
	await novel_interface.show_text_only("Quindi il parcheggio sotterraneo era davvero l'area più facile in cui infiltrarsi.")
	await novel_interface.show_text_only("Sebbene i servizi segreti militari avessero dispiegato misure di sicurezza in ogni angolo dell'edificio, la parte inferiore della cabina dell'ascensore era un punto cieco di sorveglianza.")
	await novel_interface.show_text_only("Rendendosi conto che la linea difensiva che aveva predisposto era stata violata così facilmente, il sudore imperlò immediatamente sulla fronte del maggiore.")
	novel_interface.show_character("hamon","speak")
	await novel_interface.show_dialog("L'intelligence militare non mi ha assicurato che la sicurezza del locale era a prova di bomba?", "Hamon")
	novel_interface.change_expression("shout")
