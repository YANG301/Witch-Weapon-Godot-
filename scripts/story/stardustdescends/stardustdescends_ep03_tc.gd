	await novel_interface.hide_background()
	await novel_interface.stop_music()
	await novel_interface.show_text_only("把愛衣按回去之後，莉琉走出指揮室，一言不發地盯著手持裝置上衛星傳來的數據。")
	await novel_interface.show_dialog("（剛才小憐和倪克斯額頭接觸的一瞬間，爆發出了強度極高的低頻電波。）", "莉琉")
	await novel_interface.show_dialog("（電波類型與人類睡眠時快速動眼期的腦電波模式非常相似）", "莉琉")
	novel_interface.show_background("res://assets/images/bg/Baizhu/snowfield.png")
	await novel_interface.show_text_only("簡直，就像是南極那次……")

	print("=== 星尘降临篇第3话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
