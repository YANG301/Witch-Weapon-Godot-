# stardustdescends_ep03.gd - 星尘降临篇第3话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	stardustdescends_ep03_script()

func play_script():
	pass

func stardustdescends_ep03_script():
	novel_interface.change_music("res://assets/audio/music/Shop.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_NoxRoom.png")
	await novel_interface.show_text_only("我坐在學姐豪華大床的一角，聽著她的述說。")
	novel_interface.show_character("nyx_full","normal1")
	await novel_interface.show_dialog("監視我的人每半年會更換一批，這次的兩個人剛調來不到三個月。", "倪克斯")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("等一下你就跟門口的人說要親自送小憐回家，車我已經安排好了。", "莉琉")
	await novel_interface.show_dialog("那兩個保鏢只要一上車，就會立刻被麻醉。", "莉琉")
	novel_interface.show_character("nyx_full","sad")
	await novel_interface.show_dialog("可是監視人員要定期回報，如果不想引起懷疑，也需要他們兩個配合吧？", "倪克斯")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("學姐顯然對這個臨時擬定的逃脫計劃有點擔心。")
	novel_interface.show_character("nyx_full","normal1")
	await novel_interface.show_dialog("雖然派來監視我的只是外圍成員，但「對外安全委員會」的人都受過嚴格的抗審訊訓練。", "倪克斯")
	novel_interface.change_expression("sad")
	await novel_interface.show_dialog("恐怕他們不會輕易配合吧……", "倪克斯")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_full","upset")
	await novel_interface.show_dialog("是那個……對外安全委員會？", "小憐")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_Commandments.png")
	await novel_interface.show_text_only("那個組織又稱「七誡」，是萊博娜的情報機構，最早由歐洲黑手黨內部的整肅部門發展而來。")
	await novel_interface.show_text_only("他們以匪夷所思的暗殺能力和對黑色西裝的執著聞名於世，任何被盯上的人都很難逃脫。")
	await novel_interface.show_text_only("最具傳奇色彩的是，那是一個以維護《萊博娜誡條》為宗旨的獨立組織。")
	await novel_interface.show_text_only("他們透過遍佈全球數百家賭場的固定股份獲取運作資金，因此不聽命於任何政府……")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_NoxRoom.png")
	novel_interface.show_character("ren_full","happy")
	await novel_interface.show_dialog("（實在……太誇張了！！！）", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("和那個組織相關的幾款遊戲我都打到了白金。")
	novel_interface.show_character("ren_full","gratified")
	await novel_interface.show_dialog("所以想要安全脫離的話，問題不在於方式為何，而是怎樣才不會引起他們的警覺吧？", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("呵呵呵，放心好了。", "莉琉")
	await novel_interface.show_text_only("莉琉得意地笑道──")
	await novel_interface.show_dialog("戰研部對付這種人的方法多得是～", "莉琉")
	await novel_interface.show_text_only("我腦海中浮現出愛衣一臉興奮地拿著審訊道具的樣子，不禁打了個冷顫。")
	await novel_interface.show_dialog("你們倆先準備一下，隨時可以行動。", "莉琉")
	await novel_interface.show_text_only("語畢，莉琉便切斷了通訊。")
	await novel_interface.show_text_only("忽然安靜下來的氛圍讓我有些尷尬，而學姐卻還目不轉睛地盯著我的胸部。")
	novel_interface.show_character("nyx_full","smile")
	await novel_interface.show_dialog("音質……不錯呢。", "倪克斯")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("我有點不好意思地低下了頭。")
	novel_interface.show_character("ren_full","shy")
	await novel_interface.show_dialog("還、還可以啦……", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("我們在聊什麼啊？？")
	await novel_interface.show_text_only("上次愛衣說做了個升級，音質好像真的變好了……？")
	novel_interface.show_character("ren_full","shy_right")
	await novel_interface.show_dialog("（不過，沒事幹嘛升級那種沒用的東西啊？！）", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("倪克斯忽然湊近我身邊，右手也順勢伸到了我背後。")
	novel_interface.show_character("ren_full","panic")
	await novel_interface.show_dialog("學、學姐……？", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("她的手在我背上隔著衣服輕輕拉了一下，我頓時感到一陣鬆脫。")
	novel_interface.show_character("ren_full","awkward")
	await novel_interface.show_dialog("──！", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("不會是把那個扣子給……")
	await novel_interface.show_text_only("接著，學姐左手伸進我禮服的前襟，緩緩地抽出了黑色胸墊……")
	novel_interface.show_character("ren_full","awkward")
	await novel_interface.show_dialog("……", "小憐")
	await novel_interface.show_dialog("…………", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("……………………")
	await novel_interface.show_text_only("啊啊啊啊啊啊啊啊啊啊啊啊啊啊──！！！！！！")
	await novel_interface.show_text_only("她將胸墊捏來捏去地把玩著，發現裡面沒有喇叭之後，又狐疑地看向一旁早已衣衫不整的我。")
	await novel_interface.show_text_only("我的臉一路漲紅到脖子，一把搶過胸墊後衝進洗手間。")
	novel_interface.show_character("nyx_full","smile")
	await novel_interface.show_dialog("嗯？小憐肚子不舒服嗎？", "倪克斯")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("如果需要「那個」的話，壁櫥裡就有哦～", "倪克斯")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("學姐在洗手間外用關切的聲音說道。")
	novel_interface.show_character("ren_full","sob")
	await novel_interface.show_dialog("不、不是啦──！！", "小憐")
	await novel_interface.show_dialog("（嗚嗚嗚嗚嗚～～）", "小憐")
	await novel_interface.hide_character()
	await novel_interface.hide_background_with_fade()
	await novel_interface.stop_music()
	await novel_interface.show_text_only("……")
	await novel_interface.show_text_only("在此同時，SID作戰指揮室。")
	novel_interface.change_music("res://assets/audio/music/Normal Stage.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	await novel_interface.show_text_only("愛衣坐在指揮台上翻閱著一疊紙本文件，她面前的大螢幕上跳動著四五個分析視窗。")
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("喏……", "愛衣")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("愛衣仰過頭看向身後穿著筆挺軍裝的女性。")
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("要從那個土包子身上竊取文件的話，應該有無數種方法吧……", "愛衣")
	await novel_interface.show_dialog("但妳卻偏偏派小憐去冒這種不必要的風險，她和安妮不會起疑心嗎？", "愛衣")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("莉琉看著手持裝置上的數據笑了笑。")
	novel_interface.show_character("liliu_uniform1","normal2")
	await novel_interface.show_dialog("那傢伙應該還處在進入學姐閨房的興奮中吧～", "莉琉")
	await novel_interface.show_dialog("而且……這本來是安妮的主意。", "莉琉")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("咦？", "愛衣")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal2")
	await novel_interface.show_dialog("你還記得吧──", "莉琉")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Soya/Earthperspective.png")
	await novel_interface.show_dialog("十幾天前，小憐從異空間帶回索婭的時候，在全球範圍內引起了5秒左右的巨幅時空相位波動。", "莉琉")
	await novel_interface.show_dialog("雖然訊號劇烈，但因為很快就消失了，各國都沒能探測出訊號來源。", "莉琉")
	await novel_interface.show_dialog("目前似乎最能被接受的解釋是，當時太陽系正好掃過銀河中一束伽瑪射線暴的邊緣。", "莉琉")
	await novel_interface.show_dialog("雖然是胡扯，但在某種意義上，人類確實又一次與世界末日擦肩而過了呢～", "莉琉")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.show_character("liliu_uniform1","serious")
	await novel_interface.show_dialog("但只要世界還沒毀滅，我們就得防止有人懷疑到新豐洲頭上。", "莉琉")
	await novel_interface.show_dialog("從那次事件之後，SID一直在執行最高級別的輿論和情報監控。", "莉琉")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("雖然資訊部一無所獲，但安妮在瀏覽社群網絡內容的時候發現了有趣的東西。", "莉琉")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("連安妮都會做這種分析了？教官說她在體能訓練時也特別努力呢～", "愛衣")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","sigh")
	await novel_interface.show_dialog("那孩子也有自己的理由吧……", "莉琉")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("倒是小憐，一直都悠閒過頭了。", "莉琉")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("莉琉調出一長串小憐最近破關的遊戲清單，像發現自己的小孩是笨蛋的家長般，無奈地搖了搖頭。")
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("總之，安妮發現，小憐把索婭帶回來的那天，有幾十個人在網上描述了自己下午睡覺時的奇怪夢境。", "莉琉")
	await novel_interface.show_dialog("「在夢中墜入一片黑暗，還見到了去世的親人。」", "莉琉")
	await novel_interface.show_dialog("發佈訊息的都是沒什麼關注者的普通人，所以很快就被資訊河道淹沒了。", "莉琉")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("下午睡覺時的夢……", "愛衣")
	novel_interface.change_expression("think")
	await novel_interface.show_dialog("等等，那次劇烈的波動是在新豐洲時間下午四點左右出現的！", "愛衣")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("那個時間在睡覺的人本來就不多，會把自己的夢發佈到網上的傢伙更是少之又少。", "莉琉")
	await novel_interface.show_dialog("進一步分析發現，那些帳號的實體地址全都位在新豐洲，且都分佈在一個半徑不到五公里的區域內。", "莉琉")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("聽到這裡，愛衣的兩眼發出亮光。")
	novel_interface.show_character("liliu_uniform1","serious")
	await novel_interface.show_dialog("──而那個區域的中心，就是倪克斯的莊園。", "莉琉")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","blush_dizzy")
	await novel_interface.show_dialog("難道是這座莊園裡的某種存在，在天堂之門打開時被啟動了，從而引發大規模的夢境？", "愛衣")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("愛衣說話的音調中帶著難以壓抑的興奮。")
	novel_interface.show_character("liliu_uniform1","normal2")
	await novel_interface.show_dialog("本來我也不確定，所以請安妮在莊園的監視系統上安裝了玻爾茲曼探測器……", "莉琉")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("愛衣滿臉寫著「給我看」的表情向莉琉撲過去，被莉琉用手掌按在臉上擋開了。")
	await novel_interface.show_text_only("身形嬌小的銀髮少女兩隻手完全搆不到莉琉，卻依然鍥而不捨地在空中胡亂揮舞著。")
	novel_interface.show_character("ai","blush_dizzy")
	await novel_interface.show_dialog("咕（給）～嗚（我）～罐（看）～rua（啦）～～～", "愛衣")
