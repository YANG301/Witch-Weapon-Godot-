# stardustdescends_ep10.gd - 星尘降临篇第10话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	stardustdescends_ep10_script()

func play_script():
	pass

func stardustdescends_ep10_script():
	await novel_interface.show_text_only("Quando uscimmo dall'ufficio immigrazione, il cielo si era schiarito e noi tre salimmo sulla navetta ferroviaria del porto.")
	await novel_interface.show_text_only("Il treno a levitazione magnetica era incredibilmente veloce. In meno di dieci minuti arrivò alla stazione della Knesset, nel centro della città di Masada.")
	await novel_interface.show_text_only("...")
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_Masadainner.png")
	novel_interface.show_character("anne_uniform","panic")
	await novel_interface.show_dialog("Questo...", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","happy")
	await novel_interface.show_dialog("T-Questo è incredibile!!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("stardust_small","happy")
	await novel_interface.show_dialog("Wooow──", "Stardust")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","happy")
	await novel_interface.show_dialog("Quindi questo è... Masadaburg?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_uniform","panic",0.25)
	await novel_interface.show_dialog("Nemmeno io... non me lo aspettavo...", "Annie")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("La scena davanti a noi ha completamente ribaltato la mia impressione di Masada come una \"fortezza deserta devastata dalla guerra\"──")
	await novel_interface.show_text_only("Nelle strade pulite ed eleganti come un giardino, ovunque si potevano vedere robot igienico-sanitari e carri merci senza pilota.")
	await novel_interface.show_text_only("Le facciate dei grattacieli nel lontano centro cittadino erano rivestite con pannelli metallici dal forte sapore futuristico, che riflettevano debolmente le nuvole bianche sopra.")
	await novel_interface.show_text_only("Sotto il cielo azzurro, vaste distese di verde si estendono fino all'orizzonte...")
	novel_interface.show_character("ren_medical","smile")
	await novel_interface.show_dialog("Quest'aria è incredibilmente rinfrescante──", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Appoggiandomi alla ringhiera di pietra, ho fatto un respiro profondo. L'aria umida portava con sé il lieve sentore salato tipico del vento marino.")
	novel_interface.show_character("ren_medical","smile")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_uniform","happy",0.25)
	await novel_interface.show_dialog("Questo è il luogo con la più alta pressione atmosferica sulla Terra. Con più ossigeno nell'aria, respirare sembra più facile~", "Annie")
	novel_interface.change_2nd_expression("normal1")
	await novel_interface.show_dialog("Non posso credere che abbiano trasformato il deserto vicino al Mar Morto in questo...", "Annie")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Annie, cos'è quel lungo tratto laggiù...?", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Ho indicato a sinistra. In lontananza c'era una barriera che correva da est a ovest, e al di là di essa non sembrava esserci alcun grattacielo.")
	novel_interface.show_character("anne_uniform","stare")
	await novel_interface.show_dialog("Questo è il \"muro di isolamento\".", "Annie")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Siamo lontani adesso, ma in realtà è alto decine di metri, con checkpoint di sicurezza e sistemi di difesa automatizzati ovunque.", "Annie")
	await novel_interface.show_dialog("Ci sono anche molti sensori sepolti sottoterra. Nemmeno un topo potrebbe passare.", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie sospirò e mormorò piano tra sé.")
	novel_interface.show_character("anne_uniform","upset")
	await novel_interface.show_dialog("Anche il loro capitale precedente aveva qualcosa del genere, ed è stato comunque appiattito...", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","worry")
	await novel_interface.show_dialog("È successo molto tempo fa, vero...?\nAllora ero solo alle elementari──", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Poi mi venne in mente che Annie aveva trascorso sette anni nell'Intervallo di Causalità. Per lei, quel ricordo potrebbe non essere così vecchio.")
	novel_interface.show_character("ren_medical","wry_smile")
	await novel_interface.show_dialog("B-A proposito──\nChe senso ha costruire un muro del genere?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Cambiai argomento in fretta e in modo piuttosto goffo.")
	novel_interface.show_character("ren_medical","smile")
	await novel_interface.show_dialog("Se davvero scoppiasse la guerra, un muro del genere non fermerebbe nulla...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","normal2")
	await novel_interface.show_dialog("I governi costruiscono muri per i motivi più disparati: fermare le invasioni, impedire alle persone di fuggire, tenere lontani gli immigrati clandestini...", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie lo disse mentre guardava le bandiere delle Sei Città Scolastiche nel parco davanti a loro.")
	novel_interface.show_character("anne_uniform","upset")
	await novel_interface.show_dialog("Ma la situazione di Masada è ancora più complicata...", "Annie")
	await novel_interface.show_dialog("Su entrambi i lati del muro, molte persone non vogliono vedere l'altro lato.", "Annie")
	await novel_interface.show_dialog("Solo non vedendo l'altro lato, facendo finta che gli altri non esistano, si può vivere con la coscienza pulita.", "Annie")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("Beh... anche se dubito che capirai davvero, Lian.", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("stardust_small","pleased")
	await novel_interface.show_dialog("Ooh~~ Capisco...", "Stardust")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Stardust è intervenuta all'improvviso nella conversazione, annuendo e assumendo una posa pensierosa come se avesse capito perfettamente.")
	novel_interface.show_character("stardust_small","pleased")
	await novel_interface.show_dialog("Mmm, mm~", "Stardust")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Come se capissi una cosa! Non è esattamente la stessa reazione che ho quando perdo i sensi durante la lezione di fisica?!")
	await novel_interface.show_text_only("Ad essere onesti, anche la spiegazione di Annie è passata oltre la mia testa. Forse aveva qualcosa a che fare con il suo passato...")
	await novel_interface.show_text_only("Vedendo lo sguardo vuoto e perso nei miei occhi, Annie mi mise un braccio attorno al collo.")
	novel_interface.show_character("anne_uniform","smile")
	await novel_interface.show_dialog("Ehi, non prenderla così sul serio. Per lo più dico solo sciocchezze~", "Annie")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("Lascia che ti dica una cosa. \"Phantom Force\" di Masada è da qualche parte nel sottosuolo del centro città!", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","panic")
	await novel_interface.show_dialog("Eh...?\nIntendi quell'oggetto eteromorfo di classe XK?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("\"Phantom Force\" è l'oggetto eteromorfo di classe strategica di Masada, esistente come uno spazio designato immobile.")
	await novel_interface.show_text_only("Qualsiasi arma sparata dall'interno di quello spazio ottiene un effetto di amplificazione anomalo, producendo un potere distruttivo da diverse a centinaia di volte superiore al suo design originale.")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_doomsday.png")
	await novel_interface.show_text_only("Il \"sistema di contrattacco automatico\" annunciato tempo fa dalla Terza Città Scolastica si avvale proprio di questa proprietà.")
	await novel_interface.show_text_only("Se il sistema determina che il danno all'area urbana di Masada ha superato il 50%, attiva automaticamente il \"Programma Doomsday\"──")
	await novel_interface.show_text_only("Usare Phantom Force per lanciare armi nucleari indiscriminatamente in tutte le principali città del mondo, garantendo la distruzione reciproca.")
	await novel_interface.show_text_only("La notizia suscitò feroci proteste quando fu annunciata per la prima volta, ma la gente sembrò accettare il fatto compiuto in modo sorprendentemente rapido.")
	await novel_interface.show_text_only("Il fatto che Masada sia riuscito a raggiungere rapidamente un accordo di cessate il fuoco con la resistenza ha probabilmente molto a che fare con questo sistema.")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_Masadainner.png")
	novel_interface.show_character("anne_uniform","smile")
	await novel_interface.show_dialog("Vedete le armature metalliche su quegli edifici?", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","stare")
	await novel_interface.show_dialog("l'avevo notato prima...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Non dirmi che tutta questa città è stata costruita per combattere gli Apostoli...")
	novel_interface.show_character("anne_uniform","smile")
	await novel_interface.show_dialog("Ho sentito che l'intero sottosuolo del centro città è rivestito con la stessa armatura.", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Più ascolto, più sembra esattamente così!")
	novel_interface.show_character("ren_medical","perspire1")
	await novel_interface.show_dialog("W-cosa intendi con...?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","smile")
	await novel_interface.show_dialog("Perché pensi che abbiano scelto di costruire la loro nuova capitale in questo arido deserto salato vicino al Mar Morto──", "Annie")
	await novel_interface.show_dialog("E poi spese una somma enorme costruendo un canal grande con un dislivello di oltre quattrocento metri solo per sostenere una capitale in una posizione così miserabile.", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","panic")
	await novel_interface.show_dialog("Because of the Phantom Force down below...?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ho indicato il terreno sotto i miei piedi, ma c'era qualcosa che non andava.")
	novel_interface.show_character("ren_medical","panic")
	await novel_interface.show_dialog("Ma è comunque un investimento eccessivo... Non è come Aegis, uno scudo che può bloccare ogni attacco esterno.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","worry")
	await novel_interface.show_dialog("Ecco perché ogni paese sospetta che Phantom Force possa avere alcune proprietà chiave non divulgate.", "Annie")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Abbastanza perché i leader di Masada fossero disposti a mettere in gioco il destino dell'intero popolo di questa terra.", "Annie")
	await novel_interface.show_dialog("Si potrebbe dire che l'intera città è una struttura protettiva costruita attorno a Phantom Force──", "Annie")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("Quindi, come parte di quel sistema difensivo, costruire un muro di isolamento su quella scala non sembra così strano, vero~?", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","stare")
	await novel_interface.show_dialog("Quindi anche \"Masada Shall Never Fall\" porta con sé questa implicazione...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ma quanto più un segreto viene protetto instancabilmente, tanto più incuriosisce le persone...")
	await novel_interface.show_text_only("Mi sono voltato per guardare il gigantesco cartellone pubblicitario fuori dalla Knesset Station con lo stesso slogan, e inaspettatamente ho visto un volto familiare──")
	await novel_interface.show_text_only("Emilio, con in mano una borsa bianca imbottita della spesa, stava proprio salendo la scala mobile all'uscita della stazione...")
	novel_interface.show_character("emilio","smile")
	await novel_interface.show_dialog("Ah?", "Emily")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Il tenente incontrò i miei occhi, sorrise e si avvicinò.")
	await novel_interface.show_text_only("Annie all'istante, come una professionista, si è comportata come un'estranea che non mi conosceva, trascinando via la valigia mentre guardava il telefono.")
	await novel_interface.show_text_only("Nel frattempo, negli ultimi due giorni Stardust sembrava essersi reso conto che nessun altro poteva vederla o sentirla, ed era diventato molto più audace.")
	await novel_interface.show_text_only("Stava compiaciuta di fronte a me come un cagnolino incoraggiato dall'avere il suo proprietario dietro di sé.")
	novel_interface.show_character("emilio","mock")
	await novel_interface.show_dialog("Ah! Tu sei quella... tirocinante infermiera della nave casinò, giusto?", "Emily")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lanciò un'occhiata alla targhetta con il nome appesa al mio petto.")
	novel_interface.show_character("emilio","mock")
	await novel_interface.show_dialog("Il tuo nome è Lian, giusto~", "Emily")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","perspire1")
	await novel_interface.show_dialog("H-Ciao...\nVoglio incontrarti di nuovo.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("emilio","mock")
	await novel_interface.show_dialog("Ahah, volevo dirtelo: dopo che te ne sei andato quel giorno, ho dato una vera lezione a quel cameriere.", "Emily")
	await novel_interface.show_dialog("Più tardi scoprimmo che aveva molestato anche diverse spacciatrici.", "Emily")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","wail")
	await novel_interface.show_dialog("——Cosa!?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Quindi anche lui era recidivo?")
	novel_interface.show_character("emilio","mock")
	await novel_interface.show_dialog("E questa volta ha osato addirittura mettere le mani addosso a un ospite. Il suo cervello era in cortocircuito o cosa~", "Emily")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","wry_smile")
	await novel_interface.show_dialog("Ahahahah...!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Era lo spray ipnotico, in realtà!")
	novel_interface.show_character("ren_medical","happy")
	await novel_interface.show_dialog("A proposito, devo davvero ringraziarti per avermi fatto segno di passare i controlli di sicurezza quel giorno presto...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("emilio","smile")
	await novel_interface.show_dialog("Oh, non era niente. Ultimamente i piani alti hanno adorato arruolarci in ogni sorta di incarichi noiosi.", "Emily")
	novel_interface.change_expression("upset")
	await novel_interface.show_dialog("E anche l'ultima volta si sono presi in giro: la squadra di contenimento ha trascorso mezza giornata a scansionare la nave con una montagna di attrezzature e non ha trovato assolutamente nulla.", "Emily")
	novel_interface.change_expression("speechless")
	await novel_interface.show_dialog("Non ho idea di dove abbiano comprato quelle informazioni false questa volta...", "Emily")
	await novel_interface.hide_character()
	novel_interface.show_character("stardust_small","stare")
	await novel_interface.show_dialog("Hmph! E doveva essere ancora così cattiva...", "Stardust")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Stardust ha fatto la linguaccia a Emilio.")
	novel_interface.show_character("stardust_small","stare")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("emilio","normal",0.25)
	await novel_interface.show_dialog("A proposito──", "Emily")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Emilio si accovacciò.")
	novel_interface.show_character("stardust_small","stare")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("emilio","smile",0.25)
	await novel_interface.show_dialog("Questo ragazzo è adorabile~ Non è del posto, vero?", "Emily")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Stardust e io ci siamo bloccati sul posto.")
	novel_interface.show_character("stardust_small","panic")
	await novel_interface.show_dialog("Eh...?\nUgh... guh...", "Stardust")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Tutta la sua spavalderia svanì in un istante. Terrorizzata quasi fino alle lacrime, si nascose freneticamente dietro di me.")
	novel_interface.show_character("stardust_small","panic")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_medical","wail",0.25)
	await novel_interface.show_dialog("Ah? Hahaha...\nS-Lei è la mia... la mia, um...", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Come la vede?!?")
	await novel_interface.show_text_only("Emilio tirò fuori dalla borsa della spesa una bottiglia di vetro piena di liquido rosso trasparente. Non c'era alcuna etichetta su di esso.")
	novel_interface.show_character("stardust_small","panic")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("emilio","smile",0.25)
	await novel_interface.show_dialog("Succo di melograno appena spremuto. È delizioso~\nUna delle famose specialità della città.", "Emily")
	await novel_interface.show_dialog("Tieni, prendine uno──", "Emily")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Detto questo, porse la bottiglia a Stardust. Quando ho capito che dovevo fermarla, era troppo tardi.")
	await novel_interface.show_text_only("Potevo praticamente vedere la bottiglia passare attraverso il corpo di Stardust e frantumarsi sul pavimento...")
	novel_interface.show_character("stardust_small","uneasy")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("emilio","smile",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Mmm... grazie...", "Stardust")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Stardust prese la bottiglia e la tenne tra le braccia.\nEmilio allungò la mano e le diede una pacca sulla testa.")
	novel_interface.show_character("stardust_small","uneasy")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("emilio","mock",0.25)
	await novel_interface.show_dialog("Una ragazza così brava~", "Emily")
	novel_interface.character_light(0.35,"konata_eye")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ehehe~~", "Stardust")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Cosa sta succedendo...?\nQuesta piccola cosa... ha smesso di essere un'illusione?")
	await novel_interface.show_text_only("Da quando? Annie e io non ce ne eravamo accorti perché avevamo sempre potuto vederla?")
	await novel_interface.show_text_only("No, doveva essere dopo aver superato l'immigrazione. Altrimenti la dogana non ci avrebbe lasciato passare così facilmente.")
	await novel_interface.show_text_only("Il che significa che è successo proprio adesso?")
	await novel_interface.show_text_only("Comunque, dovremmo indagare più tardi in hotel. Per ora dobbiamo bluffare~")
	await novel_interface.show_text_only("Aspetta, parlando di immigrazione...")
	novel_interface.show_character("emilio","normal")
	await novel_interface.show_dialog("Eppure, Lian──", "Emily")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Emilio sembrò notare qualcosa. Afferrò casualmente il polso di Stardust e lo girò.")
	novel_interface.show_character("emilio","stare")
	await novel_interface.show_dialog("Perché non ha il codice a barre dell'immigrazione sulla mano?", "Emily")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("La testa mi ronzava e il sudore cominciò a imperlarmi la fronte.")
	await novel_interface.show_text_only("E' finita, è finita. mi arresteranno!!")
	await novel_interface.show_text_only("Ho sentito che anche i cittadini comuni di Masada sono estremamente sensibili agli ingressi illegali, non importa se i soldati ci colgono in flagrante per strada...")
	await novel_interface.show_text_only("Emilio studiò la mia espressione rigida, poi guardò Stardust, che stava ancora abbracciando il succo di melograno e sorridendo stupidamente senza capire nulla.")
	novel_interface.show_character("emilio","speechless")
	await novel_interface.show_dialog("Sospiro. Se vai in giro per la città con lei così apertamente, sarai arrestato entro un'ora.", "Emily")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Emilio prese un dispositivo portatile dalla clip della cintura. Sembrava un cellulare due o tre volte più spesso del normale.")
	await novel_interface.show_text_only("Dopo averlo toccato alcune volte, dallo slot della stampante del dispositivo è emersa una striscia di carta bianca larga circa un centimetro, su cui era stampato un codice a barre.")
	await novel_interface.show_text_only("Avvolse la striscia di carta attorno al braccio di Stardust e unì insieme le estremità.")
	novel_interface.show_character("emilio","smile")
	await novel_interface.show_dialog("Questo è un documento militare temporaneo. L'inchiostro del codice a barre scomparirà automaticamente dopo 36 ore.", "Emily")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("La striscia di carta è solo moderatamente impermeabile. La doccia va bene, ma niente bagni o nuoto.", "Emily")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Durante quel periodo, vai all'immigrazione e fatti rifare i documenti, oppure porta la bambina fuori città il prima possibile. Inteso?", "Emily")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_medical","wry_smile",0.25)
	await novel_interface.show_dialog("O-Okay!\nGrazie...", "Lian")
