# stardustdescends_ep18.gd - 星尘降临篇第18话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	stardustdescends_ep18_script()

func play_script():
	pass

func stardustdescends_ep18_script():
	novel_interface.change_music("res://assets/audio/music/Sewer.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_Psychology.png")
	await novel_interface.show_text_only("Jeder hat inneren Schmerz erlebt – etwas so Reales, so Schweres, so Qualvolles, so schwer zu ertragen.")
	await novel_interface.show_text_only("Dennoch wissen nur wenige Menschen, dass das meiste psychische Leiden nach der Geburt erlernt wird.")
	await novel_interface.show_text_only("Ein Kind, das den ganzen Tag mit nichts anderem als einer Hähnchenkeule glücklich bleiben kann, kann den Schmerz nicht verstehen, von Klassenkameraden in den sozialen Medien ausgeschlossen und isoliert zu werden.")
	await novel_interface.show_text_only("Ob Sie leiden, weil Sie nicht in eine Gruppe passen, weil die Menschen um Sie herum Sie nicht akzeptieren oder weil Sie nicht die Person werden können, die Sie sich vorstellen ...")
	await novel_interface.show_text_only("All dieser Schmerz basiert auf komplexen Konzepten und ist nichts anderes als ein Nebenprodukt angehäufter Bedeutungen, die nachträglich erlernt werden.")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_Camus.png")
	await novel_interface.show_text_only("Camus sagte, die Absurdität der Menschheit liege in der endlosen Suche nach Sinn in einem bedeutungslosen Universum.")
	await novel_interface.show_text_only("Unter den Fesseln der Bedeutung kann niemand wahre Freiheit erlangen.")
	await novel_interface.show_text_only("Die menschliche Zivilisation kann nicht ohne Sinn existieren; Es ist die Grundlage sozialer Systeme in allen Epochen.")
	await novel_interface.show_text_only("Die Bedeutung des Clans, die Bedeutung der Nation, die Bedeutung des eigenen Herrn, die Bedeutung der Religion, sogar ethnische Identität, Ideologie und Popkultur ...")
	await novel_interface.show_text_only("Sobald Ihnen ein Bedeutungssystem eingeflößt ist, bilden sich auf natürliche Weise alle möglichen Ideen und in Ihrem Kopf entsteht eine Werteleiter –")
	await novel_interface.show_text_only("Was verdient Lob und Förderung, was Verachtung und Verurteilung, was Glück und Ehre, was Schmerz und Schande bringen sollte ...")
	await novel_interface.show_text_only("Manche Menschen werden durch dynastische Veränderungen in den Selbstmord getrieben, andere durch die Heirat ihres Idols; Es gibt keinen wahren oder falschen Unterschied zwischen ihrem Schmerz.")
	await novel_interface.show_text_only("Aber wenn Ihr Verstand scharf genug ist, können Sie sich vielleicht gelegentlich von den Fesseln befreien und alleine rausschlüpfen, um etwas Luft zu schnappen.")
	await novel_interface.show_text_only("Dann kehrt man zur Gruppe zurück, tut weiterhin so, als würde man die Ketten tragen, lobt, was alle loben, und verachtet, was alle verachten.")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_Prisoner.png")
	await novel_interface.show_text_only("Denn wenn Sie schlau sind, müssen Sie dies bereits erkennen: Die Menschheit ist nicht nur ein Gefangener der Bedeutung, sondern wird bereitwillig zu ihrem Gefängniswärter.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("................")
	await novel_interface.show_text_only("...")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_ConventionCentre.png")
	await novel_interface.show_text_only("Masada International Convention Center, vor der Unterzeichnungszeremonie.")
	await novel_interface.show_text_only("Im Saal waren bereits Reporter von über hundert Medienunternehmen mit Blitzgeräten und Kameras vor Ort, um diesen historischen Moment festzuhalten.")
	await novel_interface.show_text_only("Hinter dem Podium schirmte ein schwerer blauer Vorhang den lauten Saal vollständig vom Backstage-Bereich ab.")
	await novel_interface.show_text_only("An den Deckenträgern befanden sich Reihen brandneuer professioneller Beleuchtungsanlagen, die alle im Standby-Modus mit geringer Helligkeit arbeiteten.")
	await novel_interface.show_text_only("Die in die Wände eingewickelten Akustikpaneele und die schalldämmende Beschichtung des Vorhangs machten den Ort unheimlich ruhig.")
	await novel_interface.show_text_only("Als der Beamte im Wüstentarn den Mann im grauen Anzug durch den Gang hinter dem Vorhang kommen sah, richtete er sich sofort auf und salutierte.")
	await novel_interface.show_text_only("Die Rangabzeichen am Tarnkragen und der goldene sechszackige Stern zeigten, dass er Major der Verteidigungsstreitkräfte war.")
	await novel_interface.show_text_only("Und der Mann, den er gerade informieren wollte, war der heutige Vertreter der Masadan-Unterzeichner: Generalmajor Hamon vom Nordkommando der Verteidigungsstreitkräfte.")
	await novel_interface.show_dialog("Melden Sie sich, Herr. Ich bin hier, um Sie über den Angriff zu informieren.", "Major")
	await novel_interface.show_text_only("Der Generalmajor hatte etwas an Gewicht zugenommen, aber sein Haar war immer noch mit perfekter Präzision gekämmt und sein Blick hatte die charakteristische Schärfe eines Soldaten behalten.")
	await novel_interface.show_text_only("Während er ging, lockerte er ungeduldig seine Krawatte und steckte sie zusammen mit dem schwarzen Ledertablett in seiner Hand.")
	novel_interface.show_character("hamon","serious")
	await novel_interface.show_dialog("Ich kann mich nie daran gewöhnen, dieses Ding zu tragen...", "Hamon")
	await novel_interface.show_dialog("Mach weiter.", "Hamon")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Es ist der Untersuchungsbericht zur Explosion südwestlich des Kongresszentrums vor dreißig Minuten.", "Major")
	await novel_interface.show_dialog("Aufgrund der Spuren am Tatort kam das Bombenentschärfungsteam zu dem Schluss, dass es sich um eine IED handelte, die hauptsächlich aus Zucker bestand.", "Major")
	novel_interface.show_character("hamon","serious")
	await novel_interface.show_dialog("...Eine selbstgemachte Bombe aus Zucker?", "Hamon")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Ja, aber die Explosionsintensität war nicht hoch und verursachte keine Verluste. Der Sprengstoff enthielt offenbar Zusatzstoffe, die den Rauch verstärkten.", "Major")
	await novel_interface.show_dialog("Wir haben den Rauch sofort gelöscht. Mittlerweile hat das Wachregiment das umliegende Gebiet abgeriegelt, bislang hat kein Medienunternehmen über den Vorfall berichtet.", "Major")
	await novel_interface.show_dialog("Die Straßenüberwachung in der Nähe hat bisher keine Verdächtigen gefunden. Wir erweitern jetzt den Suchbereich. Bericht abgeschlossen.", "Major")
	novel_interface.show_character("hamon","serious")
	await novel_interface.show_dialog("...Das ist es?", "Hamon")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Hamon blickte dem Major in die Augen und sagte lange Zeit nichts. Der Major wagte nicht zu sprechen und konnte nur starr dastehen.")
	await novel_interface.show_text_only("Hamon schnaubte und schlug unzufrieden das Tablet in seiner Hand gegen die Brust des Majors –")
	novel_interface.show_character("hamon","speak")
	await novel_interface.show_dialog("Schauen Sie es sich selbst an!", "Hamon")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Der Major taumelte von dem Treffer zurück und stabilisierte hastig die Tafel. Auf dem Bildschirm war Monolas ikonisches siebenarmiges Kandelaber-Logo zu sehen.")
	novel_interface.show_character("hamon","serious")
	await novel_interface.show_dialog("Sie haben dies vor ein paar Minuten gesendet.", "Hamon")
	await novel_interface.show_dialog("Monola entdeckte drei verdächtige Personen, die sich in die Tiefgarage gemischt hatten.", "Hamon")
	await novel_interface.show_dialog("Zwei von ihnen schlüpften in den Aufzugsschacht mit der Absicht, die Brandbekämpfungsanlage des Gebäudes zu sabotieren.", "Hamon")
	await novel_interface.show_dialog("Glücklicherweise griffen ihre Agenten rechtzeitig ein. Sie haben einen gefangen genommen, aber die anderen beiden konnten entkommen; Einer von ihnen wurde auf der Flucht von einer Kugel gestreift.", "Hamon")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("...Der Aufzugsschacht!?\nS-Jemand ist in den Veranstaltungsort eingedrungen?", "Major")
	await novel_interface.show_text_only("Der Major blätterte den Bericht schnell durch und in seinem Kopf begann es sofort zu summen –")
	await novel_interface.show_text_only("War diese Explosion nur eine Ablenkung...?")
	await novel_interface.show_text_only("Da der oberirdische Parkplatz von Sicherheitskräften und Militärfahrzeugen besetzt war, wurden alle Transporter mit Medienausrüstung im Keller des Kongresszentrums abgestellt.")
	await novel_interface.show_text_only("Dann war die Tiefgarage wirklich der Bereich, in den man am einfachsten eindringen konnte.")
	await novel_interface.show_text_only("Obwohl der Militärgeheimdienst in jeder Ecke des Gebäudes strenge Sicherheitsvorkehrungen getroffen hatte, war die Unterseite der Aufzugskabine ein toter Winkel für die Überwachung.")
	await novel_interface.show_text_only("Als ihm klar wurde, dass die von ihm arrangierte Verteidigungslinie so leicht durchbrochen werden konnte, liefen dem Major sofort Schweißperlen auf die Stirn.")
	novel_interface.show_character("hamon","speak")
	await novel_interface.show_dialog("Hat mir der Militärgeheimdienst nicht versichert, dass die Sicherheit am Veranstaltungsort lückenlos war?", "Hamon")
	novel_interface.change_expression("shout")
	await novel_interface.show_dialog("Ich habe Monolas Leute absichtlich weggezogen und in den Außenbereich geschickt, und so sehe ich bei dir aus?!", "Hamon")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Als Hamon sich daran erinnerte, dass der Saal hinter dem Vorhang voller Reporter war, senkte er absichtlich seine Stimme, als er ihn zurechtwies.")
	await novel_interface.show_dialog("Das...\nI-Es war mein Versagen!", "Major")
	await novel_interface.show_dialog("Aber waren Monolas Agenten nicht alle außerhalb des Kongresszentrums stationiert?\nWie konnten sie innerhalb des Gebäudes sein...?", "Major")
	await novel_interface.show_text_only("Hamon schüttelte leicht den Kopf und klopfte dem Major auf die Schulter.")
	novel_interface.show_character("hamon","serious")
	await novel_interface.show_dialog("Wer weiß unter den Reportern da draußen, wie viele von ihnen ihnen gehören ...", "Hamon")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Er verstand vollkommen, dass das Militärgeheimdienstbüro, das er in den letzten Jahren innerhalb des Armeesystems aufgebaut hatte, nicht mit einem Monster wie Monola zu vergleichen war.")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_Speech.png")
	await novel_interface.show_text_only("„Sie sind das Nervensystem dieses Landes, das in der Lage ist, mit größter Geschwindigkeit auf jede Gefahr zu reagieren.“")
	await novel_interface.show_text_only("„Wenn jemand einen Pfeil auf dich schießt und du dein Gehirn zum Nachdenken brauchst, bevor du ausweichst, stirbst du nur mit einem Pfeil im Körper.“")
	await novel_interface.show_text_only("Hamons Onkel, Premierminister Schneiderman, hatte dem Parlament einmal auf diese Weise erklärt, warum Monola die uneingeschränkte oberste operative Autorität innehatte.")
	await novel_interface.show_text_only("Aber Hamon konnte es nicht tolerieren, dass alle Geheimdienstinformationen von einer Organisation gehalten wurden, die er nicht kontrollieren konnte.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Information ist Macht. Das war die Kampferfahrung, die er über Jahrzehnte gesammelt hatte, sei es in internen oder externen Kriegen.")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_ConventionCentre.png")
	novel_interface.show_character("hamon","serious")
	await novel_interface.show_dialog("Und außerdem--", "Hamon")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Er warf dem Offizier vor ihm, einem Mann, den er persönlich befördert hatte, einen vielsagenden Blick zu.")
	novel_interface.show_character("hamon","serious")
	await novel_interface.show_dialog("Die Frau, die sie gefangen haben, ist ein Leutnant des Caracal-Bataillons.", "Hamon")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("--Einer von uns?!", "Major")
	novel_interface.show_character("hamon","serious")
	await novel_interface.show_dialog("Und noch dazu ein Kadett vom Turm ...", "Hamon")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Hamon sagte es Wort für Wort.")
	await novel_interface.show_text_only("Als der Major erkannte, welche politischen Auswirkungen dies haben könnte, hielt er den Atem an –")
	await novel_interface.show_text_only("Innerhalb der Verteidigungsstreitkräfte hatte es schon immer viele Stimmen gegeben, die gegen dieses Abkommen waren, insbesondere unter den jungen Aufrührern, die sich profilieren wollten.")
	novel_interface.show_character("hamon","serious")
	await novel_interface.show_dialog("Noch seltsamer ist, dass die am Tatort aufgenommenen Fingerabdrücke zeigen, dass sich unter den Personen, die mit ihr handelten, ein Ausländer befand, der sich vor einigen Tagen bei der Einwanderungsbehörde registriert hatte.", "Hamon")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Ein Spion aus Übersee?", "Major")
	await novel_interface.show_text_only("Hamons Augenbrauen zogen sich zusammen, während er einen Moment nachdachte.")
	novel_interface.show_character("hamon","speak")
	await novel_interface.show_dialog("Das ist möglich. Auf jeden Fall habe ich Monola gebeten, zuerst alle ihre Informationen preiszugeben, aber man kann nicht erwarten, dass sie sehr kooperativ sind ...", "Hamon")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("Ich habe den Leutnant vom Wachregiment festhalten lassen. Sie befindet sich jetzt im sicheren Raum oben und steht ebenfalls unter Ihrer Obhut.", "Hamon")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Ja, Herr!", "Major")
	await novel_interface.show_text_only("Hamon wandte sich ab, rückte seinen Kragen zurecht und zog seine Krawatte wieder an.")
	novel_interface.show_character("hamon","speak")
	await novel_interface.show_dialog("Die Zeremonie beginnt gleich...\nMachen Sie mir keinen Ärger mehr!", "Hamon")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Ja! Sie haben mein Wort, Sir!", "Major")
	await novel_interface.show_text_only("Hamon hielt inne und sagte dann düster, mit dem Rücken zum Major:")
	novel_interface.show_character("hamon","serious")
	await novel_interface.show_dialog("Ich trage heute keine Uniform. Sprechen Sie mich nicht mit meinem Rang an.", "Hamon")
	await novel_interface.show_dialog("Das Volk will keine Soldaten mehr an der Spitze der Regierung... verstanden?", "Hamon")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Ah... verstanden!", "Major")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("...\nMasada International Convention Center, Außenparkplatz.")
	await novel_interface.show_text_only("In einem gepanzerten Personentransporter.")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_MasadAPCRS.png")
	await novel_interface.show_dialog("Du Idiot--!!!\nDu bist direkt in ihre Falle getappt??!", "Mariru")
	await novel_interface.show_text_only("Wenn diese Kopfhörer die Lautstärke nicht dynamisch anpassen könnten, wäre mein Trommelfell wahrscheinlich früher gestorben.")
	novel_interface.show_character("ren_medical","panic")
	await novel_interface.show_dialog("Awoo...", "Lian")
	novel_interface.change_expression("wry_smile")
	await novel_interface.show_dialog("Th-Das...", "Lian")
	await novel_interface.show_dialog("B-Weil ich niemanden erreichen konnte...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ich habe ewig an der Steuerung herumgefummelt, bevor ich schließlich den Abschirmungsmodus dieses Fahrzeugs deaktivierte und zu Mariru durchkam.")
	await novel_interface.show_text_only("Ein heftiger Schlag ertönte durch das Headset, und ich stellte mir vor, wie sie ihren Schreibtisch in Stücke schlug.")
	await novel_interface.show_dialog("Du bist also einfach alleine losgegangen, nicht wahr?", "Mariru")
	await novel_interface.show_dialog("Ist es schon so lange her, seit ich dich trainiert habe, dass es dir ohne es am ganzen Körper gejuckt hat ...?", "Mariru")
	await novel_interface.show_text_only("Mariru hörte auf zu schreien und wechselte zu einem leisen, drohenden Ton.")
	await novel_interface.show_text_only("Es war wie ein Vulkan, der kurz vor dem Ausbruch steht, noch gruseliger als zuvor!!")
	await novel_interface.show_dialog("Hey, hey...\nSei nicht so sauer~", "Aya")
	await novel_interface.show_text_only("Aya versuchte in ihrem üblichen trägen Ton, die Sache für mich zu glätten.")
	await novel_interface.show_dialog("Auch wenn Lian bei jedem körperlichen Test die Note 1 erhielt, sagt die Tatsache, dass sie sich freiwillig für diese Art von Feldinfiltrationsarbeit gemeldet hat, immer noch etwas über ihren Mut aus", "Aya")
	await novel_interface.show_text_only("Versucht sie, die Situation zu beruhigen oder das Feuer anzufachen?")
	await novel_interface.show_text_only("Ich hatte keine Wahl. Ich konnte nur die Zähne zusammenbeißen und mich erklären.")
	novel_interface.show_character("ren_medical","sob")
	await novel_interface.show_dialog("B-Wegen der Sterne--", "Lian")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_SlumArea.png")
	await novel_interface.show_dialog("Ich erinnere mich, dass die letzte Nacht klar war und es im Slum nur wenige Lichter gab, sodass die Sterne gut zu sehen waren.", "Lian")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_SlumArea1.png")
	await novel_interface.show_dialog("Doch als diese Menschen später durch den Slum gingen, war kein einziger Stern zu sehen.", "Lian")
	await novel_interface.show_dialog("Und außerdem verlor jedes Kommunikationsgerät das Signal ...", "Lian")
	await novel_interface.show_dialog("Ich hatte das Gefühl, dass es kein gewöhnliches Jammen war …", "Lian")
	await novel_interface.hide_background()
	await novel_interface.show_dialog("...Was meinst du?", "Mariru")
	await novel_interface.show_dialog("Es fühlte sich genauso an wie die Situation rund um die Kirche in der Nacht, in der wir Elgana gefangen genommen haben ...", "Lian")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_Church.png")
	await novel_interface.show_text_only("Als in dieser Nacht mein Gespräch mit Mariru plötzlich unterbrochen wurde, wurde auch die Atmosphäre um mich herum seltsam –")
	await novel_interface.show_text_only("Die Gebäude in der Ferne verschwammen und verzerrten sich, und der klare Nachthimmel verdunkelte sich augenblicklich.")
	await novel_interface.show_dialog("Ich erinnere mich noch genau daran: Alle Sterne am Himmel verschwanden auf einmal.", "Lian")
	await novel_interface.show_dialog("Dann kamen gleich danach diese Soldaten in schwarzen Spezialeinheitsuniformen ...", "Lian")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_MasadAPCRS.png")
	await novel_interface.show_text_only("Mariru schwieg für eine lange Zeit. Wie ein Kind, das eine Vase zerbrochen hat, wagte ich kaum zu atmen, während ich auf die Antwort der Erwachsenen wartete.")
	await novel_interface.show_dialog("...Also hast du einfach dummerweise mitgemacht?", "Mariru")
	await novel_interface.show_text_only("Als ich die Mischung aus Vorwurf und Resignation in Marirus Stimme hörte, entspannte sich mein angespannter Körper ein wenig.")
	await novel_interface.show_dialog("Es sind nur Kadetten, die noch nicht einmal die Militärschule abgeschlossen haben. Wissen sie nicht, dass dies die Art von Dingen ist, mit denen sich Profis befassen sollten?", "Mariru")
	novel_interface.show_character("ren_medical","upset")
	await novel_interface.show_dialog("Nachdem wir aus dem Slum herausgefahren waren, meldete Emily es tatsächlich dem Militär, der Polizei und dem Geheimdienst und rief sogar die Anti-Terror-Hotline an ...", "Lian")
	await novel_interface.show_dialog("Aber sie alle gaben hochtrabende, formelhafte Antworten, sagten, sie würden den Slum so schnell wie möglich überprüfen, dankten ihr für den Tipp und so weiter ...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Emily sagte, ihre Reaktion sei nicht überraschend, da es im Slum ständig zu Schießereien von Banden komme und es üblich sei, nachts Menschen mit Waffen zu sehen.")
	await novel_interface.show_text_only("Und in den Augen der einfachen Bürger Masadas sieht dort nach Einbruch der Dunkelheit jeder auf der Straße wie ein Terrorist aus ...")
	novel_interface.show_character("ren_medical","upset")
	await novel_interface.show_dialog("Emily kam auch zu dem Schluss, dass diese Menschen mit Masadas Stadtverteidigungssystem niemals aus dem Slum herauskommen könnten.", "Lian")
	novel_interface.change_expression("perspire1")
	await novel_interface.show_dialog("Wenn das Fahrzeug tatsächlich eine Bombe trug und sie sich dazu entschloss, diese während der Unterzeichnungszeremonie zu zünden –", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Die Kinder im Waisenhaus...")
	await novel_interface.show_dialog("Weil jede Agentur, die sie kontaktierten, so langsam reagierte, beschlossen sie, selbst etwas zu bewegen und die Verschiebung der Unterzeichnungszeremonie zu erzwingen?", "Mariru")
	novel_interface.show_character("ren_medical","worry")
	await novel_interface.show_dialog("Mm...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Hatten Sie dann nicht genügend Zeit, mich anzurufen?", "Mariru")
	await novel_interface.show_text_only("Marirus Ton wurde plötzlich bösartig und mit jedem bewussten Schlag ihrer Worte drang das Geräusch knackender Knöchel durch das Headset.")
	novel_interface.show_character("ren_medical","wail")
	await novel_interface.show_dialog("Hä?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aaaaah, ich habe es durchgehen lassen!!!")
	novel_interface.show_character("ren_medical","sob")
	await novel_interface.show_dialog("S-Entschuldigung!!!!\nIch habe mich geirrt!", "Lian")
	await novel_interface.show_dialog("Ich habe mich geirrt...", "Lian")
	await novel_interface.show_dialog("B-Aber Emily, sie...", "Lian")
	await novel_interface.show_dialog("Wurde weggebracht~~~!!!!", "Lian")
	await novel_interface.show_dialog("Schluchzen, schluchzen, schluchzen, schluchzen, schluchzen ...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Anspannung, Angst, Bedauern, Kummer ... all diese Emotionen stiegen auf einmal auf und die Tränen hörten nicht auf, aus meinen Augen zu strömen.")
	await novel_interface.show_dialog("Was für ein Idiot...", "Mariru")
