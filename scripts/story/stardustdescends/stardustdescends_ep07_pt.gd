	await novel_interface.show_dialog("(A pele dela de alguma forma me acalma...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Talvez ela seja como Beatrice? Ambos têm um poder especial que eles próprios nem percebem?")
