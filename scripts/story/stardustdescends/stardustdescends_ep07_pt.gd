	await novel_interface.show_dialog("Quem é você, realmente? Quem autorizou esta operação?", "Miller")
	await novel_interface.show_dialog("Exijo falar com seu supervisor!", "Miller")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("O agressivo arcebispo fica diante da jovem como uma pequena montanha.")
	novel_interface.show_character("valkyrja","normal2")
