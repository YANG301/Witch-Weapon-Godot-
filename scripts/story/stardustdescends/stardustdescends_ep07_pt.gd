	novel_interface.show_character("valkyrja","speechless")
	await novel_interface.show_dialog("Não admira que você seja grande... Isso faz parte do seu trabalho, suponho.", "Vera")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Porém, da última vez que verifiquei, aquela região estava em guerra. As pessoas ainda pagam seus impostos durante a guerra?", "Vera")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ela ignora completamente o rosto vermelho do arcebispo enquanto pega o tablet que um escriturário lhe entrega.")
	novel_interface.show_character("valkyrja","happy")
	await novel_interface.show_dialog("Bem, bem, bem... Quem diria. Você possui um visto de trabalhador religioso.", "Vera")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Vera ri com desprezo e depois olha para a mesa da roleta.")
