	novel_interface.show_character("ren_full","shy_left")
	await novel_interface.show_dialog("Por onde eu começo?...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Limpo a garganta e conto tudo o que aconteceu. Aponto especificamente que ninguém pode ver Stardust.")
