	novel_interface.show_character("stardust_small","normal2")
	await novel_interface.show_text_only("Parece que estabelecemos um vínculo especial entre nós. Ela começa a sorrir.")
	await novel_interface.show_text_only("É estranho – afinal, acabamos de nos conhecer.")
	await novel_interface.show_text_only("Além disso, como é que tanto o garçom quanto os soldados a ignoraram completamente?")
