	await novel_interface.show_dialog("Ah, o doce cheiro da juventude! Esta é a sua maneira de conseguir um par ainda maior?", "Aya")
	await novel_interface.show_text_only("Acontece que é uma teleconferência – Mariru e alguns outros também estão na linha...")
	novel_interface.show_character("ren_full","awkward")
	await novel_interface.show_dialog("Eles estão me espionando?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Olho em volta e não consigo localizar nenhum dispositivo de vigilância. Então percebo que provavelmente vem de cima.")
