	await novel_interface.show_dialog("Se tudo estiver certo, você receberá uma pulseira azul. Só pode sair daqui quem estiver com a pulseira.", "Oficial")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_full","panic")
	await novel_interface.show_dialog("Esta verificação de segurança não é brincadeira...", "Lian")
