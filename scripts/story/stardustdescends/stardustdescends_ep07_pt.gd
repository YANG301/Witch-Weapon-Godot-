	await novel_interface.show_dialog("Estamos claros?!", "Vera")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("O rosto do arcebispo ficou roxo. Incapaz de falar, ele balança a cabeça apressadamente.")
	novel_interface.show_character("valkyrja","angry")
	await novel_interface.show_dialog("Volte para sua linha!", "Vera")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Assim que ele é solto, o arcebispo corre de volta para sua fila enquanto recupera o fôlego.")
