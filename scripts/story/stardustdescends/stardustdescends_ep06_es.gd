# stardustdescends_ep06.gd - 星尘降临篇第6话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	stardustdescends_ep06_script()

func play_script():
	pass

func stardustdescends_ep06_script():
	novel_interface.change_music("res://assets/audio/music/Shop.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_Vault.png")
	await novel_interface.show_dialog("Oye, ¿qué estás buscando?", "Voz de niña")
	novel_interface.show_character("ren_full","worry")
	await novel_interface.show_dialog("!!!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("En esta habitación sellada, de repente apareció una niña justo a mi espalda. La mente se me quedó en blanco y todo el cuerpo se me puso rígido.")
	novel_interface.show_character("ren_full","sob")
	await novel_interface.show_dialog("(¡Aaaaaaah!)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Estas cosas solo pasan en las películas de terror. ¿Es que yo...?")
	await novel_interface.show_text_only("...")
	await novel_interface.show_dialog("¿Mmm?", "Niña pequeña")
	await novel_interface.show_text_only("Estoy tan asustada que casi no puedo respirar. Entretanto, la niña se pasea con total tranquilidad frente a mí y me observa con franca curiosidad.")
	novel_interface.show_character("stardust_small","panic")
	await novel_interface.show_dialog("... ¿Te rompiste?", "Niña pequeña")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ella extiende la mano y me pellizca la mejilla. Los auriculares con forma de oreja de gato que lleva en la cabeza parpadean con una suave luz dorada.")
	novel_interface.show_character("ren_full","panic")
	await novel_interface.show_dialog("¿Quién... quién eres?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("stardust_small","wordless")
	await novel_interface.show_dialog("¿Eh? ¿No lo recuerdas?", "Niña pequeña")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("¿Recuerdas qué?")
	await novel_interface.show_text_only("Ella deja escapar un suspiro de decepción.")
	novel_interface.show_character("stardust_small","wordless")
	await novel_interface.show_dialog("Sigue siendo del tipo que elude la responsabilidad, ¿eh?", "Niña pequeña")
	novel_interface.change_expression("konata_eye")
	await novel_interface.show_dialog("Tut-tut...", "Niña pequeña")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Chasquea la lengua y sacude la cabeza como si estuviera completamente harta de mí.")
	novel_interface.show_character("ren_full","wry_smile")
	await novel_interface.show_dialog("??", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Todavía no tengo idea de lo que está pasando, pero definitivamente puedo sentir a este pequeño mocoso mirándome con desprecio.")
	novel_interface.show_character("ren_full","upset")
	await novel_interface.show_dialog("¿Quién eres?...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("stardust_small","pleased")
	await novel_interface.show_dialog("Bien, te lo diré una vez más, ¡así que escucha con atención!", "Niña pequeña")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Coloca las manos en las caderas y levanta la barbilla, claramente preparándose para anunciar su gran nombre.")
	novel_interface.show_character("ren_full","bored")
	await novel_interface.show_dialog("(La forma en que actúa... lo sé de alguna parte...)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("stardust_small","pleased")
	await novel_interface.show_dialog("yo soy...", "Niña pequeña")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_full","uneasy")
	await novel_interface.show_dialog("(¡Por favor! No más nobles, genios, bosozoku o cualquiera de esas chicas raras que he conocido últimamente...)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("stardust_small","uneasy")
	await novel_interface.show_dialog("Yo soy...", "Niña pequeña")
	await novel_interface.show_dialog("Mmm...", "Niña pequeña")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_full","stare")
	await novel_interface.show_dialog("... ¿Eh?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ella me mira fijamente sin pestañear, su expresión pasa de la presunción al pánico.")
	novel_interface.show_character("stardust_small","panic")
	await novel_interface.show_dialog("Um... ¡¿Cuál era mi nombre otra vez?!", "Niña pequeña")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_full","perspire1")
	await novel_interface.show_dialog("¿¿Me preguntas??", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("stardust_small","tear")
	await novel_interface.show_dialog("¡No me grites!", "Niña pequeña")
	await novel_interface.show_dialog("Boo-hoo...", "Niña pequeña")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aparentemente realmente la asusté. Mira a su alrededor con impotencia y retrocede unos pasos temblorosos.")
	await novel_interface.show_text_only("Luego se da vuelta, se cubre la cabeza con ambas manos y se agacha.")
	novel_interface.show_character("ren_full","shy_left")
	await novel_interface.show_dialog("(... No le hice nada.)", "Lian")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Eh... ¿Qué es eso?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Noto una combinación rosa arrugada atada alrededor de su muñeca, así que me acerco y la desato con cuidado.")
	await novel_interface.show_text_only("Sobre él aparecen garabateados dos caracteres torcidos.")
	novel_interface.show_character("ren_full","normal2")
	await novel_interface.show_dialog("\"Stardust\"", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("stardust_small","panic",0.25)
	await novel_interface.show_dialog("Ah!!!", "Niña pequeña")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("De repente se incorpora de golpe al darse cuenta.")
	novel_interface.show_character("ren_full","normal2")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("stardust_small","panic",0.25)
	await novel_interface.show_dialog("¡¡Ese es mi nombre!!", "Niña pequeña")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("¿Qué eres, un bebé abandonado cuyos padres te pusieron una nota con tu nombre antes de dejarte en alguna parte?")
	novel_interface.show_character("ren_full","normal2")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("stardust_small","tear",0.25)
	await novel_interface.show_dialog("Yo... yo...\n...", "Stardust")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Parece al borde de las lágrimas.")
	novel_interface.show_character("ren_full","perspire1")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("stardust_small","tear",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Lo siento. No quise decir eso...", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Ella baja la cabeza y se queda en silencio, aparentemente tratando de calmarse. Mirándola, finalmente empiezo a recuperar la compostura.")
	await novel_interface.show_text_only("Toqué el meteoro antes y luego esta chica apareció de la nada. No puede ser una coincidencia.")
	novel_interface.show_character("ren_full","upset")
	await novel_interface.show_dialog("(¿Es esta chica... una bruja?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Pero hay un problema. Ese meteoro cayó a la Tierra hace más de cuatro mil años, y nada en el atuendo de esta chica parece tan antiguo.")
	novel_interface.show_character("ren_full","normal2")
	await novel_interface.show_dialog("(¿Tal vez sea algo así como el caso de Henriette...?)\n(¿Y \"esa\" también le hizo esta ropa?)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("stardust_small","normal1")
	await novel_interface.show_text_only("No parece que sea el caso. ¿Sus auriculares con orejas de gato, por ejemplo? Estoy bastante seguro de haberlos visto en un sitio de compras.")
	novel_interface.change_expression("normal2")
	await novel_interface.show_text_only("Aunque le sientan bien.")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Además, su forma de hablar se parece más a la de una niña moderna que vive en las redes sociales. Es imposible que alguien de hace cuatro mil años suene así.")
	await novel_interface.show_text_only("¿Quizás perdió la memoria? Debería pedirle a Annie que revise los informes de personas desaparecidas más tarde.")
	await novel_interface.show_text_only("Mientras todavía estoy tratando de decidir qué hacer a continuación, ella se acerca a mí y me abraza.")
	novel_interface.show_character("ren_full","timid")
	await novel_interface.show_dialog("¿De qué se trata esto?...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Al darse cuenta de que no la estoy alejando, me abraza aún más fuerte. Ella pone su cara sobre mi estómago, no queriendo que la deje.")
	novel_interface.show_character("ren_full","timid")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("stardust_small","tear",0.25)
	await novel_interface.show_dialog("No me importa. No puedes abandonarme.", "Stardust")
	await novel_interface.show_dialog("Teníamos un trato...", "Stardust")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Ella solloza y murmura.")
	await novel_interface.show_text_only("Le doy unas palmaditas en la cabeza. Su cabello azul claro se siente como la seda, suave y terso.")
	await novel_interface.show_text_only("Bajo la luz, incluso brilla con un ligero brillo violeta...")
	novel_interface.show_character("ren_full","gratified")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("stardust_small","tear",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("(¿Me confundió con otra persona?)\n(No sé qué hacer con ella...)", "Lian")
	await novel_interface.show_dialog("Está bien, está bien...", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("¡Excepto que NO está bien! \n¡Soy terrible con los niños!")
	novel_interface.show_character("ren_full","smile")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("stardust_small","tear",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("No te abandonaré, pero debes seguir el juego. Si alguien pregunta, dime que viniste conmigo, ¿entiendes?", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Ella asiente, con la cabeza todavía enterrada en mi ropa.")
	novel_interface.show_character("ren_full","shy")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("stardust_small","tear",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("(... ¿Me confundió con su mamá?)", "Lian")
	novel_interface.change_expression("shy_left")
	await novel_interface.show_dialog("(Cuando todavía era un niño, ni siquiera había dado mi primer beso...)", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Según el plan original, si aparece una bruja, debería hipnotizar al camarero nuevamente tan pronto como confirme que la bruja no es hostil.")
	await novel_interface.show_text_only("Convenzo a la cosita para que suelte su agarre y luego guardo esa esfera parecida a un caramelo de azúcar en un lugar seguro.")
	await novel_interface.show_text_only("Sólo para estar seguro, vuelvo a abrir la caja fuerte número 0812 y veo que el meteoro aún se encuentra dentro.")
	novel_interface.show_character("ren_full","normal2")
	await novel_interface.show_dialog("(No se rompió como el Pilar de Lapislázuli la última vez...)", "Lian")
	await novel_interface.hide_character()
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	await novel_interface.show_text_only("Mientras levanto la cabeza, noto que la luz de estado de la cámara de seguridad parpadea rápidamente; esa es la señal de emergencia que se nos ocurrió a Annie y a mí.")
	novel_interface.show_character("ren_full","serious")
	await novel_interface.show_dialog("¿Pasó algo?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lo que es peor: no tengo idea de cuánto tiempo lleva funcionando esta señal de emergencia...")
	await novel_interface.show_text_only("Entonces un fuerte tintineo resuena desde el final del pasillo.")
	novel_interface.show_character("ren_full","serious")
	await novel_interface.show_dialog("¿Es esto...?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("La pesada puerta del ascensor se abre lentamente.")
	novel_interface.show_character("ren_full","wail")
	await novel_interface.show_dialog("¡Mierda!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Recojo a Stardust, mis zapatos y mi bolso, luego corro hacia el ascensor.")
	novel_interface.show_character("ren_full","sob")
	await novel_interface.show_dialog("(No hay tiempo para volver a hipnotizar al camarero. ¿Cómo puedo explicarle a este niño?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Todo sucede demasiado rápido. Justo cuando me acerco al camarero, la puerta del ascensor se abre por completo.")
	await novel_interface.show_text_only("Del ascensor salen cuatro personas. Delante hay una mujer joven con uniforme militar.")
	await novel_interface.show_text_only("Detrás de ella hay dos soldados musculosos con trajes de camuflaje azules. Y el director del casino está atrapado en el medio, bajo su custodia.")
	await novel_interface.show_text_only("La mujer al frente mira al asistente y luego a mí, hablando en un tono aburrido.")
	novel_interface.show_character("emilio","stare")
	await novel_interface.show_dialog("Soy la segunda teniente Emily Schwertlaute de las Fuerzas de Defensa de Masada. Estamos llevando a cabo una operación de seguridad marítima.", "Oficial femenina")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Este segundo teniente tiene la piel pálida. Sus ojos tienen diferentes colores: el derecho es azul mientras que el izquierdo es naranja.")
	novel_interface.show_character("ren_full","stare")
	await novel_interface.show_dialog("(¿Heterocromía? Esta es la primera vez que veo a alguien así...)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("emilio","stare")
	await novel_interface.show_dialog("Actualmente estás en aguas bajo control militar de Masadan. Recibimos información de que este barco transporta contrabando prohibido según el Tratado de Samonton...", "Emily")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Ya repasé todo el discurso sobre el \"derecho de búsqueda\" con el capitán de arriba.", "Emily")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("Si tienes alguna objeción, llévala al Comité Militar de Masada. O las lanchas patrulleras armadas afuera.", "Emily")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("La joven subteniente explica habitualmente la notificación mientras carga su pistola.")
	novel_interface.show_character("emilio","smile")
	await novel_interface.show_dialog("Entonces, coopere con nosotros.", "Emily")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ella da una señal. Los dos soldados \"escoltan\" al director del casino directamente a la bóveda.")
	novel_interface.show_character("emilio","speechless")
	await novel_interface.show_dialog("¿Solo ustedes dos estaban en la caja fuerte?\n¿Qué estaban haciendo allí?", "Emily")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_full","normal1")
	await novel_interface.show_dialog("(Nosotros... ¿Dos??)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Miro a Stardust. Ella simplemente parpadea, toda inocente.")
	await novel_interface.show_text_only("El camarero se ha despertado. Está mirando el chip que tiene en la mano. Me estoy poniendo muy nervioso.")
	novel_interface.show_character("ren_full","sob")
	await novel_interface.show_dialog("(\"Los cerebros humanos pueden completar detalles basándose incluso en las instrucciones o sugerencias más simples\". Sólo puedo esperar que sea cierto...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Su cara se pone roja, el sudor adorna su frente como si acabaran de pillarlo haciendo algo malo.")
	await novel_interface.show_dialog("¡Ah, nada!", "Camarero")
	await novel_interface.show_dialog("No estábamos haciendo nada...", "Camarero")
	novel_interface.show_character("emilio","speechless")
	await novel_interface.show_dialog("...", "Emily")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_full","wail")
	await novel_interface.show_dialog("...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("¿Qué es exactamente lo que \"recordó\"?")
	await novel_interface.show_text_only("¿Y no puede ver que hay una tercera persona aquí?")
	novel_interface.show_character("emilio","mock")
	await novel_interface.show_dialog("¿Es así?", "Emily")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Una mirada complicada aparece en su rostro, mira fijamente al camarero durante varios segundos y luego se acerca a él.")
	await novel_interface.show_text_only("El camarero, por su parte, se limita a mirar su arma. Parece que se orinará en los pantalones en cualquier momento.")
	await novel_interface.show_text_only("¡Mmm! Emily luego se da vuelta y me sonríe.")
	novel_interface.show_character("emilio","mock")
	await novel_interface.show_dialog("Señorita, ¿puedo ver alguna identificación?", "Emily")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_full","panic")
	await novel_interface.show_dialog("¿Eh?\n... ¡Oh, por supuesto!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Cojo mi bolso y busco la tarjeta de identificación \"correcta\". El SID me ha preparado varias identificaciones falsas.")
	await novel_interface.show_text_only("Si Masada me pregunta, debería usar...\n¡El naranja!")
	await novel_interface.show_text_only("Ella escanea mi tarjeta de identificación en su dispositivo portátil y levanta las cejas.")
	novel_interface.show_character("emilio","smile")
	await novel_interface.show_dialog("Organización Internacional de Ayuda Médica...", "Emily")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("¿Asociado de enfermería?\n¿Es usted real? Siempre pensé que este título de trabajo era inventado.", "Emily")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mi entrenamiento sólo duró tres días.")
	await novel_interface.show_text_only("Y el examen era dispararme con una vacuna de Asia Central...")
	await novel_interface.show_text_only("El día de mi examen, sostuve mi jeringa durante más de una hora, pero no pude hacerlo.")
	await novel_interface.show_text_only("Hasta que me sobresalté por un ruido agudo del altavoz colocado en mi pecho.")
	await novel_interface.show_text_only("Presa del pánico, accidentalmente metí la jeringa en el brazo... ¡Y aprobé el examen!")
	novel_interface.show_character("ren_full","wry_smile")
	await novel_interface.show_dialog("(El resto de ellos se han estado burlando de mí por esto desde entonces...)\n(¡Un grupo de sádicos!)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("emilio","smile")
	await novel_interface.show_dialog("Te vistes y actúas como un mocoso rico. ¿Viste demasiados videos promocionales de ONG?", "Emily")
	await novel_interface.show_dialog("¿O necesitas esto para decorar tu currículum y poder ingresar a una buena universidad?", "Emily")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("Aunque no me pareces alguien que quiera ir a la universidad.", "Emily")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_full","wail")
	await novel_interface.show_dialog("(¿Soy tan obvio?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Emily de repente se acerca y me susurra al oído.")
	await novel_interface.show_dialog("Es una zona de combate aquí. Los niños como tú no deberían estar aquí.", "Emily")
	await novel_interface.show_text_only("Estoy un poco sorprendido. Ella comienza a sonreír de nuevo mientras me da una palmadita en el hombro.")
	novel_interface.show_character("emilio","mock")
	await novel_interface.show_dialog("Estaba bromeando.\nTal vez necesitemos tu ayuda más tarde.", "Emily")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Entonces, Emily me da una pulsera azul.")
	novel_interface.show_character("emilio","mock")
	await novel_interface.show_dialog("Ponte esto. Estamos revisando a todos. Si aprueban, recibirán una pulsera.", "Emily")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_full","panic")
	await novel_interface.show_dialog("(¿Pasé? Ella escaneó mi tarjeta, pero ¿eso fue todo?...)\n(Además...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Confundido, miro a Stardust que le está haciendo una mueca a Emily.")
	await novel_interface.show_text_only("Toda esta gente... ¿No pueden verla?")

	print("=== 星尘降临篇第6话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
