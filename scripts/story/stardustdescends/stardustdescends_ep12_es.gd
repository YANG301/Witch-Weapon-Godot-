	await novel_interface.show_text_only("Me levanté, tiré del vestido lencero que se me había pegado al trasero por estar sentada demasiado tiempo y le dije a Emily un poco tímida.")
	novel_interface.show_character("ren_medical","panic")
	await novel_interface.show_dialog("Qué bueno que me despertaste. Casi hubiera llegado tarde...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("El plan era que después de la visita, Mariru haría que el personal de la embajada nos llevara a mí y al pequeño Stardust a la oficina de inmigración para manejar el papeleo.")
	await novel_interface.show_text_only("Su coche ya debería haber llegado a la entrada del museo...")
	novel_interface.show_character("ren_medical","sob")
	await novel_interface.show_dialog("Ah ~", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("De repente, sentí un leve pinchazo en la nuca...")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Antes de que pudiera darme la vuelta, mi visión se volvió borrosa, mis extremidades se debilitaron y caí hacia atrás...")
