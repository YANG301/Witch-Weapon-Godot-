	novel_interface.show_background("res://assets/images/bg/Fabiola/Mother.png")
	await novel_interface.show_text_only("Eso fue de un libro que mi mamá me leyó cuando era pequeña...")
	await novel_interface.show_text_only("Ese pasaje me dejó una impresión particularmente profunda...")
	await novel_interface.show_text_only("Pero después nunca supe cómo se llamaba ese libro.")
	await novel_interface.hide_background()
	novel_interface.show_character("ren_medical","normal2")
	await novel_interface.show_dialog("Espera, ¿dónde viste eso...?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("De repente, noté que el espacio detrás de la vitrina se había hundido en la oscuridad y una luz azul cobalto parpadeaba en el lugar de donde venía su voz.")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_Stardust.png")
	await novel_interface.show_text_only("Lo perseguí de inmediato y encontré a la chica parada en un resplandor nebuloso, mientras el espacio a su alrededor se volvía borroso y oscuro.")
	await novel_interface.show_dialog("Esto debería transmitir el mensaje ahora...", "Niña")
	await novel_interface.show_dialog("--Tal como lo prometimos.", "Niña")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("¿Prometimos... nosotros...?")
	await novel_interface.show_text_only("En el vacío, su última voz me alcanzó...")
	await novel_interface.show_dialog("Tú también te ves bien con el pelo largo...", "Niña")
	await novel_interface.show_text_only("Antes de que pudiera presionarla, su figura se desvaneció gradualmente, disolviéndose como si, para empezar, nunca hubiera pertenecido a este plano.")
	await novel_interface.show_text_only("Mis ojos se humedecieron y por alguna razón una ola de tristeza brotó dentro de mí...")
	await novel_interface.show_text_only("¿Qué... espera...?")
	await novel_interface.stop_music()
	await novel_interface.show_text_only("...")
	await novel_interface.show_text_only("Oye ............")
	await novel_interface.show_text_only("¡¡¡Oye, oye--!!!")
	await novel_interface.show_text_only("Entonces el mundo giró y sentí como si alguien estuviera sacudiendo mi cuerpo.")
