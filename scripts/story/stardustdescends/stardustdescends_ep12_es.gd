# stardustdescends_ep12.gd - 星尘降临篇第12话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	stardustdescends_ep12_script()

func play_script():
	pass

func stardustdescends_ep12_script():
	novel_interface.change_music("res://assets/audio/music/unkown/UI_Draw.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_AncientHumanEH.png")
	novel_interface.show_character("stardust_big","normal")
	await novel_interface.show_dialog("Hola.", "Niña")
	await novel_interface.show_text_only("La chica frente a mí tenía la piel suave como un bebé, ojos dorados brillando con la luz de las estrellas y parecía envuelta en una especie de halo.")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","blush")
	await novel_interface.show_dialog("(¡E-Ella es tan bonita!)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Estaba tan hipnotizado por su rostro que me tomó bastante tiempo recordar que debía saludarla.")
	novel_interface.show_character("ren_medical","awkward")
	await novel_interface.show_dialog("Ah--ahh!!\nH-hola! Um, e-esto--", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Me puse de pie de un salto presa del pánico, casi soltando \"Por favor, toma asiento\" en el banco.")
	await novel_interface.show_text_only("Al verme tropezar con mis palabras como una idiota, la chica dejó escapar una risa suave.")
	await novel_interface.show_text_only("Caminó hasta la vitrina central con los especímenes esqueléticos y rozó suavemente el marco de nogal como si estuviera perdida en sus pensamientos.")
	novel_interface.show_character("stardust_big","normal")
	await novel_interface.show_dialog("Esta sala siempre está tan silenciosa...\n¿Estás interesado en la paleoantropología?", "Niña")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Asentí reflexivamente--")
	novel_interface.show_character("ren_medical","uneasy")
	await novel_interface.show_dialog("(¡Me puede interesar!)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ella me dio una cálida sonrisa que podría derretir a una persona, luego se volvió hacia el esqueleto fosilizado en el estuche y dijo:")
	novel_interface.show_character("stardust_big","normal")
	await novel_interface.show_dialog("Su nombre es \"Lucía\". Vivió hace unos 3,2 millones de años.", "Niña")
	await novel_interface.show_dialog("Cuando una expedición la desenterró en África en 1974, se consideró que era el fósil de ancestro humano más antiguo y completo encontrado en ese momento.", "Niña")
	await novel_interface.show_dialog("Más tarde, se descubrieron fósiles de homínidos más antiguos, pero el título de Lucy como \"abuela de la humanidad\" ha perdurado hasta el día de hoy.", "Niña")
	novel_interface.change_expression("smile2")
	await novel_interface.show_dialog("Y en cuanto al nombre \"Lucy\"...", "Niña")
	await novel_interface.show_dialog("Dicen que cuando la descubrieron, la grabadora del lugar de excavación estaba reproduciendo \"Lucy in the Sky with Diamonds\" de los Beatles.", "Niña")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Su voz era suave y pura, como si estuviera describiendo el cielo nocturno lleno de estrellas sobre el continente africano hace más de tres millones de años.")
	novel_interface.show_character("ren_medical","perspire1")
	await novel_interface.show_dialog("¿Significa \"abuela de la humanidad\"...\nque es la antepasado de mucha gente?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("stardust_big","normal")
	await novel_interface.show_dialog("No necesariamente ~", "Niña")
	await novel_interface.show_dialog("Lucy fue una de las primeras personas en caminar erguida, pero era sólo un miembro de esa población.", "Niña")
	await novel_interface.show_dialog("Algunos científicos incluso argumentan que, dado que el tamaño del cerebro humano aún no había comenzado a aumentar en esa etapa, no se puede juzgar el sexo por el tamaño de la abertura pélvica.", "Niña")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sonriendo, se acercó a mi oído y susurró.")
	novel_interface.show_character("stardust_big","smile1")
	await novel_interface.show_dialog("Entonces...\nLucy podría no haber sido una niña tampoco~", "Niña")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","awkward")
	await novel_interface.show_dialog("--¿Eh?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Un escalofrío me recorrió y rápidamente retrocedí unos pasos.")
	await novel_interface.show_text_only("¿P-Por qué me diría eso? ¿Podría estar sospechando de mí...?")
	novel_interface.show_character("ren_medical","shy_right")
	await novel_interface.show_dialog("(¡¡Y deja de respirar en mi oído~~~!!)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ella pareció bastante complacida por mi reacción nerviosa, luego cambió de tema y continuó:")
	novel_interface.show_character("stardust_big","normal")
	await novel_interface.show_dialog("Ha pasado tanto tiempo que es imposible recuperar el ADN de Lucy y verificarlo ahora.", "Niña")
	await novel_interface.show_dialog("Pero si un cuerpo hubiera permanecido sellado y preservado, la última tecnología de análisis genético de Samonton aún podría determinar el parentesco.", "Niña")
	await novel_interface.show_dialog("Hace un par de años extrajeron ADN de una momia de seis mil años de antigüedad y lo compararon con una base de datos genética moderna, y realmente encontraron descendientes que aún viven hoy.", "Niña")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","perspire1")
	await novel_interface.show_dialog("¡¿Eso es asombroso--?!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("¿Esta chica es una estudiante de medicina de algún lugar cercano? Pero a juzgar por su apariencia y vestimenta, no parece local...")
	novel_interface.show_character("stardust_big","smile1")
	await novel_interface.show_dialog("En realidad, sólo lo aprendí yo mismo la última vez...", "Niña")
	novel_interface.change_expression("close_eye")
	await novel_interface.show_dialog("Pero los ancestros humanos son realmente increíbles.", "Niña")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Habló mientras caminaba alrededor de la vitrina, abandonando gradualmente mi campo de visión.")
	await novel_interface.show_dialog("Partieron de África, cruzaron el Creciente Fértil y se abrieron camino a través del mundo entero.", "Niña")
	await novel_interface.show_dialog("Llegaron a los lugares más fríos del planeta y a los más calurosos, lugares donde la mitad del año es de día y la otra mitad de noche...", "Niña")
	await novel_interface.show_dialog("Incluso cruzaron los mares y llegaron a la otra orilla...", "Niña")
