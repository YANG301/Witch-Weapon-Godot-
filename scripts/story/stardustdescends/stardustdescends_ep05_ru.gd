# stardustdescends_ep05.gd - 星尘降临篇第5话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	stardustdescends_ep05_script()

func play_script():
	pass

func stardustdescends_ep05_script():
	novel_interface.change_music("res://assets/audio/music/Shop.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_Vault.png")
	novel_interface.show_character("ren_full","panic")
	await novel_interface.show_dialog("Итак, это хранилище на борту «Звезды Свободы»...", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я с удивлением оглядываюсь вокруг. Потолок, пол и обе стены облицованы зеркально блестящими металлическими панелями, сделанными из какого-то специального материала.")
	await novel_interface.show_text_only("Я сравниваю металлические панели с золотой фишкой в руке. Цвет похож, но стены отдают слабым серо-зеленым отливом.")
	await novel_interface.show_text_only("Только некоторым VIP-гостям разрешено пользоваться сейфами в трюме, и я только что получил эту привилегию.")
	await novel_interface.show_text_only("Единственный способ войти или выйти — это лифт в VIP-зоне, а дверь внизу толщиной со стену.")
	await novel_interface.hide_background()
	await novel_interface.show_dialog("(Здесь нет сигналов... Как и ожидалось.)", "Лиан")
	await novel_interface.show_text_only("Я потерял связь, как только вошел в лифт. Теперь я должен делать все точно так же, как во время учений, и не могу ошибиться ни на шаг.")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_Vault.png")
	novel_interface.show_character("ren_full","solemn")
	await novel_interface.show_dialog("(Шаг первый: убедитесь, что система наблюдения не работает... ОК.)", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я замечаю, что несколько камер внутри хранилища одновременно мигают, а затем все гаснут.")
	await novel_interface.show_dialog("Мисс, ваш сейф № 1212. Каждый раз, когда его открывают, нужно вставлять и ваш, и наш ключ...", "Официант")
	await novel_interface.show_text_only("Официант вежливо поворачивается, чтобы передать мне ключ, но обнаруживает, что флакон «духов» направлен прямо ему в лицо...")
	novel_interface.show_character("ren_full","wry_smile")
	await novel_interface.show_dialog("Мне очень жаль!", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("После одного распыления на лицо глаза сразу тускнеют. Кажется, он хочет что-то сказать, но после того, как он несколько раз открыл рот, не вырвалось ни звука.")
	await novel_interface.show_text_only("Этот обезболивающий спрей является новым продуктом компании SRD. Ая даже добавила препарат, который снимает тормозящий контроль мозга.")
	await novel_interface.show_text_only("Любой, кто подвергся его воздействию, впадает в нечто вроде гипнотического состояния и становится чрезвычайно восприимчивым к внушению.")
	novel_interface.show_character("ren_full","smile")
	await novel_interface.show_dialog("Подойди и встань здесь.", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я осторожно веду ошеломленного официанта к месту, прямо напротив двери лифта, и вставляю ему в руку красный чип.")
	novel_interface.show_character("ren_full","solemn")
	await novel_interface.show_dialog("Кхм...", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Вспоминая строки, которые мне велели репетировать снова и снова, я обращаюсь к нему твердым голосом:")
	novel_interface.show_character("ren_full","normal1")
	await novel_interface.show_dialog("Ты только что привел меня сюда, в сейф-хранилище. Все было нормально.", "Лиан")
	await novel_interface.show_dialog("После того, как я оставил свою вещь на хранение, я дал вам фишку в качестве чаевых.", "Лиан")
	novel_interface.change_expression("solemn")
	await novel_interface.show_dialog("В тот момент, когда вы услышите щелчок пальца или увидите открывающуюся дверь лифта, вы проснетесь и «запомните» каждую деталь.", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Официант ничего не может сказать. Он просто смотрит на дверь лифта. Я осторожно ухожу.")
	novel_interface.show_character("ren_full","stare")
	await novel_interface.show_dialog("(Этого действительно достаточно?...)", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Мариру сказала, что человеческий мозг хорошо справляется с деталями с помощью нескольких простых сигналов и предложений... но все равно это кажется слишком простым, не так ли?!")
	novel_interface.show_character("ren_full","stare")
	await novel_interface.show_dialog("Что именно он вспомнит?", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Все еще бормоча про себя, я подхожу к середине хранилища, быстро снимаю высокие каблуки и аккуратно ставлю их на пол.")
	await novel_interface.show_text_only("Затем я кладу наушник и все остальные металлические предметы в сумочку и оставляю их рядом с пятками.")
	await novel_interface.show_text_only("Это хранилище представляет собой огромную сверхпроводящую статически-магнитную экранирующую камеру, способную блокировать большую часть радиации и магнитных полей.")
	await novel_interface.show_text_only("У Лебоны нет такой технологии. По данным профессора Ши, защитная камера была заказана военному производителю в Парящем Дворце.")
	await novel_interface.show_text_only("Я нахожу целевой контейнер. Между двумя замочными скважинами на каждой двери находится слабый узор облаков, выгравированный лазером.")
	novel_interface.show_character("ren_full","normal1")
	await novel_interface.show_dialog("Контейнер №0812...", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я вставляю две керамические отмычки в два замка одновременно и активирую переключатели на их концах.")
	await novel_interface.show_text_only("Фабелла однажды сказала, что ключи от частных сейфов в банках и подобных учреждениях на самом деле имеют очень низкий уровень защиты.")
	await novel_interface.show_text_only("Частично причина в том, что эти учреждения чрезвычайно уверены в безопасности самого хранилища.")
	await novel_interface.show_text_only("Что еще более важно, ключ дает клиентам иллюзию, что только они могут открыть сейф, что значительно упрощает оплату услуги.")
	novel_interface.show_character("ren_full","stare")
	await novel_interface.show_dialog("(Значит, хранилище и система безопасности обеспечивают «безопасность», а ключ обеспечивает «душевное спокойствие»…?)", "Лиан")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("(Почему это так похоже на то, что сказала бы Мариру? Ненавижу это...)", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Нажмите. Сейф открыт!")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Внутри контейнера лежал черный метеорит длиной более 1,5 метров.")
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/APT/livingRoom.png")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Вещество H уровня EX?!", "Лиан")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Да, уровень EX!", "Мариру")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","stare")
	await novel_interface.show_dialog("Но я помню, ты говорил, что уровень EX связан с религией.", "Лиан")
	await novel_interface.show_dialog("Поскольку они предназначены только для религиозных последователей, можно собирать Вещество H уровня EX, но исследования запрещены.", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("В религиозных легендах говорится, что некое вещество H обладает способностью убивать богов.")
	await novel_interface.show_text_only("После активации он может спровоцировать катастрофу класса Судного дня, поэтому все формы исследований строго запрещены.")
	novel_interface.change_background("res://assets/images/bg/Shot/boySP_news.png")
	await novel_interface.show_text_only("И да...")
	await novel_interface.show_text_only("Причина, по которой я все это так ясно помню...")
	await novel_interface.show_text_only("Потому что Копье Судьбы, которое она украла, тоже было Веществом H класса EX!")
	novel_interface.change_background("res://assets/images/bg/APT/livingRoom.png")
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("(Она говорит обо мне?)", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я поднимаю глаза и смотрю на себя в зеркало.")
	await novel_interface.show_text_only("Именно так я выгляжу во всех снах, которые мне снились в последнее время.")
	novel_interface.show_character("liliu_uniform2","speak")
	await novel_interface.show_dialog("Вещество H уровня EX связано не только с религией.", "Мариру")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Голос Мариру возвращает меня к реальности.")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Наш тест показывает, что метеорит упал на Землю более 4000 лет назад. Его раскопали египетские археологи еще до войны.", "Мариру")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_TheMeteorite.png")
	await novel_interface.show_dialog("Из-за правильных углов и плоских граней был сделан вывод, что метеорит не мог образоваться естественным путем.", "Мариру")
	await novel_interface.show_dialog("Сначала люди подумали, что это что-то вроде саркофага из Древнего Египта, но тот метеор был целый, без малейшей трещины.", "Мариру")
	await novel_interface.show_dialog("Спустя годы, когда проблемы вокруг вещества H обострились, метеорит был передан в Музей Парящего Дворца.", "Мариру")
	await novel_interface.show_dialog("Профессор Ши был одним из ведущих исследователей, изучавших это явление. Когда Парящий Дворец впервые получил метеорит, они думали, что сорвали куш.", "Мариру")
	await novel_interface.show_dialog("Но вскоре они обнаружили, что метеорит не поддается никакому исследованию и вторжению.", "Мариру")
	await novel_interface.show_dialog("Начнем с того, что его собственное магнитное поле периодически колеблется, почти как дыхание, и на пике оно почти такое же сильное, как у неодимового магнита.", "Мариру")
	await novel_interface.show_dialog("В тот момент, когда он обнаруживает радиацию, его магнитное поле резко возрастает, достигая интенсивности, слишком высокой для измерения.", "Мариру")
	await novel_interface.show_dialog("Эксперимент не только провалился, но и почти взорвал всю исследовательскую станцию.", "Мариру")
	novel_interface.change_background("res://assets/images/bg/APT/livingRoom.png")
	novel_interface.show_character("anne_normal","happy")
	await novel_interface.show_dialog("...Что, если, скажем, я попытаюсь разрезать его?", "Энни")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("Хотя сам метеорит не особенно тверд, любая попытка повредить его структуру приводит к сильному нагреву и радиации.", "Мариру")
	await novel_interface.show_dialog("По нашим расчетам, если бы кто-то насильно разрезал его, выделившейся энергии хватило бы, чтобы стереть с лица земли половину планеты.", "Мариру")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Неудивительно, что исследования запрещены...", "Лиан")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Кроме того, он крайне нестабильен — это бомба замедленного действия, о которой никто не знает, когда она взорвется.", "Мариру")
	await novel_interface.show_dialog("Парящий Дворец пытался всеми возможными способами избавиться от метеорита. В конце концов церковь согласилась взять это на себя, и Самонтон дал разрешение.", "Мариру")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Кстати о церкви. Соня прислала мне письмо сегодня днём. К письму прилагалась ее фотография в тюремной мастерской.")
	await novel_interface.show_text_only("После последнего случая Соня вернулась в церковь. Она сказала, что ей нужно кое-что расследовать и обновить несколько «инструментов».")
	await novel_interface.show_text_only("Комната на ее снимке была заставлена дорогим оборудованием. Я почти принял его за объект SRD.")
	await novel_interface.show_text_only("Если бы Соня не была в форме монахини, на этой фотографии не было бы ничего, что заставило бы людей связать это место с религией.")
	novel_interface.show_character("ren_battle","speechless")
	await novel_interface.show_dialog("(Похоже, что церковь действительно примет кого угодно и что угодно, лишь бы цена была подходящей...)", "Лиан")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Метеор нельзя было перевезти на самолете из-за его сильного магнетизма. Единственным безопасным способом был корабль.", "Мариру")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("Это привело к еще одной проблеме: пройдя Суэцкий канал, судно могло нарушить целый ряд международных конвенций...", "Мариру")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_normal","normal1",0.25)
	await novel_interface.show_dialog("И тут появилась Лебона?", "Энни")
	novel_interface.character_light(0.35,"normal1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Точно! Парящий дворец даже предоставил Вещество H для строительства на корабле безопасного хранилища, блокирующего радиацию и магнитные поля.", "Мариру")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"panic")
	await novel_interface.show_dialog("И слив нам всю эту информацию...", "Энни")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Мариру кивает, подтверждая теорию Энни.")
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("Однако вы уже сталкивались с чем-то похожим на этот метеорит.", "Мариру")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("О?", "Лиан")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_TheLastJudgement.png")
	await novel_interface.show_text_only("Отвечая ей, я уже отвлекся на одну из фотографий в письме. Это кадр «Страшного суда», фрески Сони, сфотографированной в Сикстинской капелле.")
	await novel_interface.show_text_only("С облегчением увидев, что Соня все еще может свободно передвигаться по церкви, я начинаю искать информацию о фреске.")
	await novel_interface.show_dialog("(Микеланджело... Он из той же эпохи, что и Генриетта.)", "Лиан")
	await novel_interface.show_dialog("Такое ощущение, что каждый гений той эпохи был одержим обнаженными телами…", "Лиан")
	novel_interface.change_background("res://assets/images/bg/APT/livingRoom.png")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Генриетта «Лаписовый столп Тесхайм».", "Мариру")
	await novel_interface.show_dialog("Температура поверхности столба также колеблется, как и дыхание.", "Мариру")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_normal","stare")
	await novel_interface.show_dialog("Итак...", "Энни")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("И Мариру, и Энни поворачиваются и смотрят на меня. В комнате внезапно наступает тишина.")
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("Кхм...", "Мариру")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","speechless")
	await novel_interface.show_dialog("?", "Лиан")
	novel_interface.change_expression("panic")
	await novel_interface.show_dialog("А??", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("...")
	novel_interface.change_music("res://assets/audio/music/Shop.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_Vault.png")
	await novel_interface.show_text_only("Чтобы избежать повторения еще одного инцидента с «Дверью Небес», Мариру изменила протокол SID.")
	await novel_interface.show_text_only("Обязательно отслеживать всю информацию, связанную с веществом H уровня EX.")
	await novel_interface.show_text_only("«Вы не сможете спасти весь мир, оставаясь внутри New Opulentia. Нам также нужен ключ от Объединенного Совета».")
	novel_interface.show_character("ren_full","panic")
	await novel_interface.show_dialog("(Верно, но...)", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Мне на ум приходят эти люди в черных специальных боевых костюмах и мой страх.")
	novel_interface.show_character("ren_full","uneasy")
	await novel_interface.show_dialog("(Я просто надеюсь, что мой ключ не защелкнется в замке...)", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я неохотно открываю сейф № 0812 и смотрю на хранящийся внутри черный метеор.")
	await novel_interface.show_text_only("По словам Аи, комната, в которой я стою, должна выдержать даже самое сильное колдовство.")
	await novel_interface.show_text_only("Кроме того, на борту корабля-казино есть подразделение тактического реагирования, готовое справиться с любой чрезвычайной ситуацией.")
	novel_interface.show_character("ren_full","upset")
	await novel_interface.show_dialog("Значит, мне просто нужно прикоснуться к нему один раз?", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Нервничаете или боитесь? Я не уверен. Но я почти чувствовал, как моя кровь течет по моим венам.")
	await novel_interface.show_text_only("Я медленно протягиваю руку к метеору и закрываю глаза.")
	await novel_interface.hide_background()
