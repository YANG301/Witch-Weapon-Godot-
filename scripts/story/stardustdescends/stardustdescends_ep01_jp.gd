# stardustdescends_ep01.gd - 星尘降临篇第1话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	stardustdescends_ep01_script()

func play_script():
	pass

func stardustdescends_ep01_script():
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_Prisoner.png")
	await novel_interface.show_text_only("これは、よく知られている物語の1つ……")
	await novel_interface.show_text_only("ある富豪の邸宅が盗難の被害にあった。\n\n警察の捜査により、とある2人の部屋から\n盗難品を発見するも。\n2人を有罪へと結びつけるには十分な証拠が\n揃わなかった。")
	await novel_interface.show_text_only("そこで警察はある案を実行する──\n\n2人を別々に監禁し、それぞれに「自白」と\n「黙秘」の2択を提示したのだ。")
	await novel_interface.show_text_only("2人が黙秘を貫けば半年の懲役となるだろう。\n\nだが、お前だけが自白をすれば、黙秘した相棒に\n全ての罪を着せて釈放してやろう。")
	await novel_interface.show_text_only("黙秘した側は10年の懲役を科す。\n\nお前が黙秘を続け、相棒が自白したら、\n10年間の豚箱行きだ。\n2人とも自白した場合は通常の窃盗として、\n5年の懲役とするが……\n……さあ、どうする？")
	await novel_interface.show_text_only("2人が2人にとって最善の選択をする事は\n難しい。\nなぜなら双方の利益より、自分へのリスクを\n優先的に避けたいのが人の性であるからだ。")
	await novel_interface.show_text_only("相棒がいずれを選択したとしても、自白した方が\n自らにとってリスクの少ない結果となる。\nだから2人は自白を選択してしまうのだ。")
	novel_interface.hide_background()
	await novel_interface.show_text_only("何度もやり取りを繰り返せば、協力こそが\n最善の選択肢であると認識できるのだが……")
	novel_interface.show_background("res://assets/images/bg/Shot/storyBGWar.png")
	await novel_interface.show_text_only("この世は、やり直しのできない事柄が\n大半を占めている──")
	await novel_interface.show_text_only("2人の間に猜疑心が生じてしまえば、\n『囚人のジレンマ』から抜け出す事は不可能……")
	novel_interface.hide_background()
	await novel_interface.show_text_only("──新豊洲・郊外")
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_Manorgate.png")
	await novel_interface.show_text_only("とある別荘の前に1台のリムジンが止まった。\n\nぎこちない動きで、着飾った俺は後部座席から\n降車する。")
	novel_interface.show_character("ren_full","upset")
	await novel_interface.show_dialog("す、すごいぞ──！？", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("眼前に広がるのは豪華なヨーロッパ式の荘園。\n\n真鍮で飾られた正門に、精巧な彫刻はまるで\n生きているかのよう。\n芝生や低木も手入れが行き届いている。")
	await novel_interface.show_text_only("こんな場所が新豊洲に存在するなんて……\n\nなどと驚嘆する中、イヤホンからマリルの声が\n聞こえてきた。")
	await novel_interface.show_dialog("あまりキョロキョロするな。\n\n口からヨダレは垂らすなよ～～", "マリル")
	novel_interface.show_character("ren_full","shy")
	await novel_interface.show_dialog("わ、分かってるって……", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("身だしなみを整え、正門の階段を上ろうとする。\n\nしかし足元がおぼつかず、普通に転倒しそうに\nなってしまう。")
	novel_interface.show_character("ren_full","shy")
	await novel_interface.show_dialog("この靴のヒール高い！\n\nあと、いっつもスカートが短いんだよ！！", "レン")
	novel_interface.change_expression("shy_right")
	await novel_interface.show_dialog("（腰回りも、ちょっとキツいし……）\n\n（最近食べ過ぎなのかな……）", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("胸を張れ、姿勢を正せ。\n海老みたいな姿勢で歩くな。", "マリル")
	await novel_interface.show_dialog("お前はもう初心者の女の子じゃないだろう～～？", "マリル")
	await novel_interface.show_text_only("うるさぁぁいっ！！")
	await novel_interface.show_text_only("豪邸の入り口に近づくと、使用人が門を開けて\n礼儀正しくお辞儀をしてくれた。")
	await novel_interface.show_text_only("俺はぎこちない微笑を見せて、階段で転ばない\nように心からの祈りを捧げる……")
	novel_interface.hide_background()
	await novel_interface.show_text_only("慎重に中へ入って、厳重なセキュリティー装置を\n通り抜ける。\nその先には高貴な空気を、所狭しと醸し出す\n光景が広がっていた。")
	novel_interface.change_music("res://assets/audio/music/Shop.mp3")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_VillaHall.png")
	await novel_interface.show_text_only("ロビーこそ広くはないものの、至る所から\n洗練された質感が滲み出ている。\n隅に設置されたテーブルスタンドまでもが、\nアンティーク特有の輝きを放っていた。")
	await novel_interface.show_text_only("思わず昨日受けた立ち振る舞いの授業で\n教わった要点を心の中で繰り返す──\n腹を引っ込める、胸を張る、首を前に傾けない、\n笑顔をキープ、キョロキョロしない、そして……")
	novel_interface.show_character("ren_full","uneasy")
	await novel_interface.show_dialog("（……決して物を壊さない！）", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ホールに入ると上品な格好をした来賓の人々が\nまず目に入った。\n三者三様に談話していた彼らの視線が、\n一斉に俺へと降り注ぐ。")
	await novel_interface.show_dialog("わぁ～～　レンちゃん綺麗だよっ！", "アニー")
	await novel_interface.show_text_only("入ってくる俺が監視カメラ経由で見えたのか、\n声を抑えつつもアニーは高揚を隠せないでいた。")
	novel_interface.show_character("ren_full","blush")
	await novel_interface.show_dialog("（このドレス……確かに綺麗だよな……）", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("いや、認めてはならん！　俺は男だぞ！！")
	await novel_interface.show_dialog("ここは元老院の特別認可がある場所で、\n主に会員制カジノの運営を行っている。\n来賓客達は各学園都市における大物権力者が\n揃い踏みだ。", "マリル")
	await novel_interface.show_dialog("そんな奴らの集まる場所だからか、密売や情報の\n交換も事業の1つとして成り立っているのだ。\n新豊洲最大の地下取引の仲介所と呼べるだろう。", "マリル")
	novel_interface.show_character("ren_full","upset")
	await novel_interface.show_dialog("それで、証拠を集めて差し押さえたいのか……？", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("遠くの誰もいない場所に、誰かいるような感じで\n相槌を打つフリをしながら小声でマリルと話す。")
	await novel_interface.show_dialog("私がそんな無粋な人間に見えるのか？\n\n検挙するだけならば私に証拠などは必要ない。", "マリル")
	await novel_interface.show_text_only("マリルは偉ぶった口調で話す。")
	await novel_interface.show_dialog("良く聞け、まずは目標の気を惹きつけろ。\nアニーもお前のフォローに入る。", "マリル")
	novel_interface.show_character("ren_full","upset")
	await novel_interface.show_dialog("ここにいるのは40～50歳ぐらいの\n人達ばかりだろ？\n俺みたい高校生が1人だけでいるなんて、\n怪しまれないのか……？", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("この荘園には顔を撮影してスキャンできる\nセキュリティーシステムが導入されている。\n足を踏み入れた瞬間、お前の個人情報が\n検索されてしまうってわけだ。", "マリル")
	await novel_interface.show_dialog("表示されるのは一応、メイドカフェでアルバイト\nしている普通の女子高生って結果だが……", "マリル")
	novel_interface.show_character("ren_full","panic")
	await novel_interface.show_dialog("えぇ――？\n（それって普通にバレるんじゃないかッ！？）", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("驚いてその場で立ちすくみ、周囲の人達の目線を\n追ってバレていないか警戒する。")
	await novel_interface.show_dialog("安心しろ、ここはお前みたいなのがたまに来る。\n\n『一部』の客はそういうのが大好きだからな～～", "マリル")
	await novel_interface.show_text_only("お前みたいなのって……うるさいなっ！！")
	await novel_interface.show_dialog("「目標」は階段の角の椅子に座ってるわ。\n何だか緊張しているみたいね！\nさあレンちゃん、ファイトだよ！", "アニー")
	await novel_interface.show_text_only("ファイトなんて言われても、俺の気が\n一層重くなるだけだぞアニー……\nとりあえず目標を観察できる位置に陣取り、\nさり気なく横目で見てみる。")
	novel_interface.show_character("shi","angry")
	await novel_interface.show_dialog("くそ……くそくそッ！！", "？？？")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("そこには、無精ヒゲを生やしたボサボサ髪の\n中年男性がいた。\n彼は鞄を抱えながら、何やらぶつぶつと独り言を\n呟いている。")
	await novel_interface.show_text_only("古びたコート、白シャツに黄土色のセーターを\n羽織り、緑のマフラーを巻いて……")
	novel_interface.show_character("ren_full","wail")
	await novel_interface.show_dialog("あいつが目標の施【シィ】教授？\n（すっごいダセぇ……）", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("えーっと……そうみたいだね……", "アニー")
	novel_interface.show_character("ren_full","smile")
	await novel_interface.show_dialog("まあ……何とかやってみるよ！", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("アイツぐらいだったら俺でも惹きつけられそう\nだったので、果敢にチャレンジしてみる。")
	await novel_interface.show_text_only("俺は2階のステンドガラスを見るフリをしながら\n彼に近寄った。\nわざと腰をくねらせて、彼の前でゆっくりと\n往復する。")
	await novel_interface.show_text_only("──だが、まともに見てもらえなかった。\n\n……少し悔しい。\n\n壁にある鹿の剥製を見るフリをしながら、\nさらに近寄ってみる。\n今度はそっと胸のパットを引っ張ってみた。")
	await novel_interface.show_text_only("──待て、コイツ！？ \n\n嫌そうな顔してそっぽを向いただと！？！？")
	novel_interface.show_character("ren_full","wail")
	await novel_interface.show_dialog("（オイコラ！！　おいッ！！）", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("あの……お嬢さん――", "男性客")
	await novel_interface.show_text_only("きっちりとしたフォーマルスーツのおじさんが\n近づいてくる。")
	await novel_interface.show_dialog("私はニューモリダスで広告やメディアの企業を\n運営しているのだが……\n……少しお話でもしないかい？", "男性客")
	await novel_interface.show_text_only("おじさんは紳士な笑顔で声をかけてきた。")
	novel_interface.show_character("ren_full","perspire1")
	await novel_interface.show_dialog("す、すみません～～", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("慌ててお腹が痛いフリをしながら隅の方へと\n足早に戻った。\nそして監視カメラに向かってしょんぼりする。")
	await novel_interface.show_text_only("恥を捨てて頑張ったけど目標は無関心で……\n\n変なやつが別で寄って来るし……")
	novel_interface.show_character("ren_full","sob")
	await novel_interface.show_dialog("あ、あの野郎の注意、全然引けないんですが……", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("レンちゃんの動きがぎこちなさ過ぎるのも\nあるけどさ……", "アニー")
	await novel_interface.show_dialog("どうやら彼は、誰かを待ってるみたいだよ。\n\n鞄に入っているモノも怪しい匂いがするね。", "アニー")
	await novel_interface.show_dialog("レンのハンドバッグには透視装置が\n備わっている。\nさっき彼の鞄をスキャンしたが、中は電子機器の\n類も付属されておらず、\n入っていたのは紙媒体の資料が20～30枚だけ。", "マリル")
	await novel_interface.show_dialog("今どき電子機器を一つも持たないなんて、\n時代遅れじゃない……？", "アニー")
	novel_interface.show_character("ren_full","normal2")
	await novel_interface.show_dialog("この装置は障害物越しに複数枚の書類が\n重なっていたとしても、\n書類の中身全てを透過してスキャンできる\nって愛衣が言っていたよな？", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("俺は改めて、そこそこ重いハンドバッグを\n持ち上げてみせた。\nこの緻密なデザインで縫われたエナメル生地の\nバッグには戦術研究部の小道具が詰まっている。")
	await novel_interface.show_text_only("さらにスキャンなどが行われてもバッグの裏地に\n特殊な処理が発生し、\n簡単にセキュリティーチェックを通れてしまう、\n実に不思議で便利なアイテムだ。")
	await novel_interface.show_dialog("全てを透過させてスキャンする事は一応可能だ。\n\nしかし前提条件として、書類を透過する放射線の\n透過強度を不均等にしなければならない。\n特定空間内で金属粉末が均一に散布されている\n状態を作り上げる必要性がある。", "マリル")
	await novel_interface.show_dialog("バックには遠隔爆破できる金属粉末のカプセルを\n入れておいたが、書類の枚数が多すぎるな……\n目標の鞄の中にカプセルを入れる事は出来るか？\n\n爆破させてから満遍なく粉末を馴染ませれば、\nスキャンの確実性は高くなる。", "マリル")
	await novel_interface.show_dialog("でもカプセルは爆発する時に音が鳴るでしょ？ \n\nあいつ宝物のように鞄を抱えているから\n……上手くいくかな？", "アニー")
	await novel_interface.show_dialog("レンにはドアロックをも爆破できる接着爆弾も\n持たせているだろう？", "マリル")
	await novel_interface.show_dialog("強行突破はダメだって！\nレンちゃんが今の格好で捕まっちゃったら……", "アニー")
	await novel_interface.show_text_only("先程のおっさんのいやらしい目つきを思い出し、\n反射的に身震いしてしまう。")
	novel_interface.show_character("ren_full","normal2")
	await novel_interface.show_dialog("……そういえば。", "レン")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("このホールって……完全に密閉されているよな？", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("機密保持のためだろうけど、辺りを見回すと、\nステンドガラスさえ光を通してない事が分かる。")
	novel_interface.show_character("ren_full","gratified")
	await novel_interface.show_dialog("マリル、相談なんだけどさ？\n\nこの部屋の電力供給システムをコントロールとか\nできたりする？", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("ほぉ……中々に大胆な案を思いついたようだな。", "マリル")
	await novel_interface.show_text_only("…………")
	await novel_interface.show_text_only("俺はホールに戻り、できるだけ自然な感じを\n装って施教授に近づく。")
	await novel_interface.show_text_only("――パチィンッ！！\n\nそんな音を立てて、急に階段の反対側の電球が\n強い光と共に爆発した。")
	await novel_interface.show_text_only("教授を含め全員の注意が電球へ向いたその瞬間、\n俺は彼の鞄の隙間に粉末カプセルを押し込む。")
	await novel_interface.show_text_only("次にハイヒールを調べるフリをしてしゃがんだ。\n\nコインぐらいの大きさの接着爆弾を、\n教授が座っている椅子の脚に貼り付ける。")
	novel_interface.show_character("ren_full","uneasy")
	await novel_interface.show_dialog("（準備OK！）", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("監視カメラに向かってOKのサインを出し、\n教授から少し距離をとる。")
	novel_interface.hide_background()
	await novel_interface.show_text_only("……重苦しい音がした。\n\nそして天井からプツンと何かの切れた大きな音が\n響くと同時に、全てが真っ暗闇になる。")
	await novel_interface.show_text_only("全員が騒然としている中、椅子の足が折れる音、\n教授の悲鳴、椅子から転げ落ちる音が続く。")
	await novel_interface.show_text_only("突然の事にゲストの騒めきがドンドン大きく\nなっていく。\n「すぐに電力は回復するので落ち着くように」と\n使用人達も呼びかけるが、収まる気配はない。")
	await novel_interface.show_text_only("騒々しい暗闇の中をこっそりと歩いて、\n俺は教授がいるであろう場所に装置を向けた。\nこのままスキャンが上手く機能してくれたら\n完璧なんだけど……")
	await novel_interface.show_dialog("大丈夫だ、成功しているぞ。", "マリル")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_VillaHall.png")
	await novel_interface.show_text_only("……なら安心だ。\n\nホッと一息を吐きながら俺はバッグを置いた。\n\nそれから程なくしてホールの明かりは何事も\nなかったかのように元に戻る。")
	novel_interface.show_character("ren_full","uneasy")
	await novel_interface.show_dialog("──YES！！", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("よっしゃよっしゃ♪、上手く行ったじゃん。\n\n案外バレずにできるもんだな～～")
	await novel_interface.show_dialog("……えっと。\n\n……少し、宜しいかしら？", "？？？")
	await novel_interface.show_text_only("……………………できてないじゃん！！\n\n一瞬の安堵も束の間、怪しい動きがバレたのか\n誰かが背後から話しかけて来た。\n……嫌な予感しかしないが意を決して確認する。")
	novel_interface.show_character("nyx_full","normal1")
	await novel_interface.show_dialog("2階からずっと観察していたのですが……\nこんな場所で何を？", "ニュクス")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_full","panic")
	await novel_interface.show_dialog("えっ！？　ニュ、ニュクス先輩？", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("なんとそこにはニュクス先輩がいた。\n\n彼女は地面に座り込んで尻をさすっている\n施教授を見ながら、淡々と言葉を放つ。")
	novel_interface.show_character("nyx_full","normal1")
	await novel_interface.show_dialog("あの椅子が作られたのは130年以上前……\n\n確か前回の査定で200万以上の値打ちはあると\n聞いた記憶のある代物なのですが……", "ニュクス")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_full","upset")
	await novel_interface.show_dialog("──へっ！？", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ニュクス先輩の出現に頭が回らない最中、\n彼女は俺の顔に手を当てて蠱惑的に撫で始める。")
	novel_interface.show_character("nyx_full","smile")
	await novel_interface.show_dialog("――今日はお洒落で綺麗ね、後輩さん。", "ニュクス")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("そう言って冷たい指を俺の頬に伝わせ──\n\n俺が付けていた骨伝導イヤホンを微笑みながら\nそっと取り外してきた。")
	novel_interface.show_character("nyx_full","mock")
	await novel_interface.show_dialog("それで……\n\n……どのように弁償してくれるのかしら？", "ニュクス")

	print("=== 星尘降临篇第1话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
