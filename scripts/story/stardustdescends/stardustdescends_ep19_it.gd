# stardustdescends_ep19.gd - 星尘陨落篇第19话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	stardustdescends_ep19_script()

func play_script():
	pass

func stardustdescends_ep19_script():
	novel_interface.change_music("res://assets/audio/music/Witch's Confession.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_Recording.png")
	await novel_interface.show_dialog("Quest'anno mia figlia Nasha compie sette anni, e ultimamente adora trascinarmi a fare puzzle insieme a lei.", "Registrazione")
	await novel_interface.show_dialog("A volte fingo apposta di essere svogliato o occupato, e cedo solo \"di malavoglia\" dopo averla lasciata pregarmi per un po'.", "Registrazione")
	await novel_interface.show_dialog("In realtà adoro giocare con lei... ma quando Nasha fa la viziata è semplicemente troppo adorabile.", "Registrazione")
	await novel_interface.show_text_only("Dalla registrazione arrivò una risata fragorosa del pubblico.")
	await novel_interface.show_dialog("Il puzzle con cui giocavamo era di un tipo completamente nuovo, molto diverso da quelli che avevo da bambino--", "Registrazione")
	await novel_interface.show_dialog("Ogni pezzo aveva su un lato un display e-ink a colori che mostrava un'immagine fissa, quindi a prima vista non era molto diverso da un puzzle tradizionale.", "Registrazione")
	await novel_interface.show_dialog("Ma, man mano che lo completavi e inserivi l'ultimo pezzo, ogni tessera si illuminava e l'immagine del puzzle iniziava a muoversi...", "Registrazione")
	await novel_interface.show_dialog("Ricordo ancora benissimo la prima volta che l'ho visto. All'inizio pensai che stessimo componendo quella famosa fotografia della Terra chiamata \"Blue Marble\"--", "Registrazione")
	await novel_interface.show_dialog("Ma quando mia figlia ha posizionato l'ultimo pezzo, l'intera immagine ha cominciato a muoversi: la fotocamera si è tirata indietro, passando davanti alla Luna, Marte, Giove...", "Registrazione")
	await novel_interface.show_dialog("Poi volò fuori dal sistema solare, oltre innumerevoli stelle, e alla fine rivelò l'intera Via Lattea.", "Registrazione")
	await novel_interface.show_dialog("Nasha balzò in piedi per l'eccitazione, urlando mentre mi stringeva il braccio, proprio come ho fatto la prima volta che ho completato un esperimento di piegatura della luce su una materia eterogenea...", "Registrazione")
	await novel_interface.show_dialog("Credo che tutti qui abbiano vissuto un momento del genere.", "Registrazione")
	await novel_interface.show_dialog("Quel giorno corsi fuori dal laboratorio in pantofole e pantaloni del pigiama, urlando fino all'ufficio di un professore di microbiologia della nostra università.", "Registrazione")
	await novel_interface.show_dialog("Il vecchio una volta mi aveva detto che se fossi riuscito a portare a termine l'esperimento, avrebbe aperto quella costosa bottiglia di sakè giapponese che il suo studente gli aveva regalato...", "Registrazione")
	await novel_interface.show_dialog("Quella bevanda mi ha quasi soffocato a morte. Non riesco ancora a credere che venga venduto a così tanto.", "Registrazione")
	await novel_interface.show_text_only("Il pubblico è scoppiato a ridere e alcuni di loro hanno applaudito.")
	await novel_interface.show_dialog("Più tardi, gradualmente sono arrivato a capire che il processo di studio della materia eterogenea è in realtà molto simile alla realizzazione di un puzzle.", "Registrazione")
	await novel_interface.show_dialog("Prima che l'enigma sia finalmente risolto, tutto ciò che puoi fare è provare le cose basandoti sull'intuizione e su una manciata di indizi.", "Registrazione")
	await novel_interface.show_dialog("È come fare un puzzle: prima trovi i quattro angoli e li usi come assiomi, come fulcri logici.", "Registrazione")
	await novel_interface.show_dialog("Poi, partendo dagli angoli, fai tutto il possibile per chiudere la cornice.", "Registrazione")
	await novel_interface.show_dialog("Proprio come si inizia con gli assiomi più basilari e si traggono gradualmente conclusioni logicamente coerenti.", "Registrazione")
	await novel_interface.show_dialog("Poi, all'interno di quella cornice completata, continui a fare tentativi per tentativi ed errori, spingendoti passo dopo passo verso il nucleo sconosciuto...", "Registrazione")
	await novel_interface.show_dialog("Il processo è lungo ed estenuante, e solo quando l’ultimo pezzo sarà a posto potremo intravedere la verità del mondo.", "Registrazione")
	await novel_interface.show_dialog("Durante questo periodo, puoi dare libero sfogo alla tua immaginazione, chiedendoti che tipo di magnifico panorama vedrai alla fine.", "Registrazione")
	await novel_interface.show_dialog("Credo che questa sia la parte più affascinante della ricerca scientifica e il motivo per cui la maggior parte di noi persevera!", "Registrazione")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Fare clic--")
	await novel_interface.stop_music()
	await novel_interface.show_text_only("Proprio mentre gli applausi del pubblico stavano per dilatarsi, la registrazione si interruppe bruscamente.")
	novel_interface.change_music("res://assets/audio/music/Normal Stage.mp3")
	novel_interface.show_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("Questa era una registrazione che Mariru ha trovato sul computer di un ricercatore deceduto.", "Aya")
	novel_interface.change_expression("wink")
	await novel_interface.show_dialog("Presumibilmente faceva parte di un discorso privato tenuto da Mushar alla 30a Conferenza Solvay più di dieci anni fa~", "Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("akiko","shock")
	await novel_interface.show_dialog("Chi parlava era... Walid Mushar?", "Akiko")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Akiko rimase un po' sorpreso. Per un momento non riuscì a collegare quella voce raffinata e disinvolta con lo spietato leader terrorista.")
	novel_interface.show_character("akiko","normal")
	await novel_interface.show_dialog("La 30a Conferenza Solvay... era nel 2026, giusto?", "Akiko")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Questa conferenza accademica, fondata dall'industriale belga Ernest Solvay, invitava a ogni sessione i migliori scienziati mondiali dell'epoca.")
	await novel_interface.show_text_only("Si teneva una volta ogni tre anni e, sebbene guerre e disordini politici ne abbiano causato la sospensione più volte, è continuato fino ad oggi.")
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("Esatto, l'anno prima dell'inizio della guerra...", "Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Allora Mushar non avrebbe potuto immaginare che pochi mesi dopo quel discorso, sua moglie e sua figlia sarebbero finite morte per strada a causa di un cieco spargimento di sangue etnico.")
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("All’epoca, i trattati internazionali proibivano la ricerca su materie eterogenee, quindi le discussioni in conferenze accademiche come questa potevano svolgersi solo in privato.", "Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("Ma l’anno successivo ogni Paese si tolse la maschera, e la maggior parte delle persone che parteciparono a quella conferenza adesso non sono più in vita…", "Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Un lampo di malinconia attraversò il viso di Aya, ma lei ritornò rapidamente a se stessa.")
	await novel_interface.show_text_only("Ha visualizzato sul grande schermo feed dal vivo da dozzine di diverse piattaforme multimediali e, senza eccezione, tutte mostravano la cerimonia della firma di Masada...")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_SigningCeremony.png")
	await novel_interface.show_text_only("Tutto sembrava procedere senza intoppi, senza alcuna notizia dell'esplosione che Emily aveva causato prima vicino al luogo dell'evento.")
	await novel_interface.show_text_only("Dopo che il lungo processo di firma dei documenti è stato completato, i rappresentanti di Masadan e della resistenza hanno camminato insieme e hanno premuto i palmi delle mani su uno schermo.")
	await novel_interface.show_text_only("Le impronte dei loro palmi, insieme al testo dell'accordo, sono state caricate online in tempo reale e il sistema di difesa della città di Masada ha immediatamente iniziato ad aggiornare il suo protocollo di difesa.")
	await novel_interface.show_text_only("Allo stesso tempo, la resistenza ha presentato volontariamente file digitali per più di duecentomila membri che hanno sostenuto l’accordo di cessate il fuoco.")
	await novel_interface.show_text_only("D'ora in poi, finché quelle persone deponessero le armi, sarebbero state libere di entrare e uscire dalla maggior parte delle zone di Masada come normali cittadini.")
	await novel_interface.show_text_only("Il prezzo era che dovevano indossare braccialetti di localizzazione per due anni ed essere posti sotto il sistema di sorveglianza di Monola.")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_SigningCeremony1.png")
	await novel_interface.show_text_only("Al termine della cerimonia, i due rappresentanti si sarebbero scambiati i documenti e si sarebbero stretti la mano davanti ai media.")
	await novel_interface.show_text_only("Il maggiore generale delle Forze di Difesa e il leader della resistenza si sono stretti la mano davanti alle telecamere per ben tre minuti.")
	await novel_interface.show_text_only("Il sorriso esagerato di Hamon era quasi congelato sul suo viso, mentre Mushar manteneva semplicemente il suo sorriso calmo.")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	await novel_interface.show_text_only("Aya guardò la bocca spalancata sullo schermo, poi guardò le informazioni che aveva raccolto ieri sull'uomo dai social media.")
	novel_interface.show_character("ai","dizzy")
	await novel_interface.show_dialog("Hamon, eh...\nNon c'è da stupirsi che l'esercito lo abbia soprannominato \"Rospo\"~", "Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Vedendo che Mariru ancora non era tornata, Akiko si tolse gli occhiali e soffiò naturalmente sulle lenti.")
	await novel_interface.show_text_only("Mentre li asciugava, una ciocca di capelli che era rimasta impigliata sulla tempia le scivolò giù dalla basetta, e la sua espressione e il suo portamento divennero immediatamente come quelli di qualcun altro...")
	novel_interface.show_character("akikounglass")
	await novel_interface.show_dialog("Quest'uomo è il portabandiera della fazione aggressiva all'interno delle Forze di Difesa di Masada.", "Akiko")
	await novel_interface.show_dialog("I suoi sostenitori lo lodano come un eroe che ha protetto la nazione. I suoi avversari lo chiamano un macellaio inzuppato di sangue...", "Akiko")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aya notò il cambiamento nel tono di Akiko e fissò l'immagine video con curiosità palese.")
	await novel_interface.show_text_only("Akiko non sembrava preoccuparsene e continuava a ricordare.")
	novel_interface.show_character("akikounglass")
	await novel_interface.show_dialog("Allora, Hamon seguì suo zio, il primo ministro Schneiderman, che allora era tenente generale dell'Esercito della Restaurazione, e combatté nella difesa di Masada.", "Akiko")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("Quello in cui hanno cambiato le cose con \"Phantom Force\" dopo aver finito le munizioni e le scorte?", "Aya")
	await novel_interface.show_dialog("Ciò certamente lo qualifica per candidarsi a una carica...", "Aya")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("Sembra che ogni alto ufficiale che ha preso parte a quella battaglia ed è ancora vivo ora ricopra un incarico importante nell'esercito o nel governo~", "Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aya, che normalmente non aveva alcun interesse per la politica, ha espresso il proprio giudizio basandosi sulle informazioni che aveva raccolto e organizzato con AI la notte scorsa.")
	novel_interface.show_character("akikounglass")
	await novel_interface.show_dialog("Meno di dieci di questi ufficiali sono ancora vivi, e ognuno di loro è un eroe di guerra che conosce anche i segreti più profondi del paese...", "Akiko")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("La verità su \"Phantom Force\", eh... Hanno sicuramente protetto bene quel segreto.", "Aya")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Ma ci sono altri motivi per cui Hamon riceve così tanto sostegno, giusto? Ho sentito che le Forze di Difesa sarebbero fallite molto tempo fa se non fosse stato per la sua efficiente gestione...", "Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("akikounglass")
	await novel_interface.show_dialog("Gestione?\nChiamatelo saccheggio.", "Akiko")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Akiko non fece alcuno sforzo per nascondere il suo disprezzo per lui.")
	novel_interface.show_character("akikounglass")
	await novel_interface.show_dialog("Oltre ad aggirare il diritto internazionale in ogni possibile zona grigia, ha imposto la segregazione razziale nella zona militare e ha ampliato notevolmente l'autorità di fuoco delle armi senza pilota...", "Akiko")
	await novel_interface.show_dialog("Gli ufficiali dell'intelligence Palantir ritenevano che se quest'uomo avesse preso il potere, la prima cosa che avrebbe fatto sarebbe stata far approvare la Legge Etnica Nazionale.", "Akiko")
	await novel_interface.show_dialog("Del resto il Gran Rabbino ha già esplicitato il suo sostegno ad Hamon...", "Akiko")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aya non aveva idea di come rispondere a un argomento politico così avanzato, quindi ha cercato in silenzio \"Legge etnica nazionale\".")
	await novel_interface.show_text_only("Sotto è emersa un'ondata di parole chiave come \"segregazione razziale\".")
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("(Gli esseri umani sono davvero noiosi...)", "Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("akikounglass")
	await novel_interface.show_dialog("A proposito, perché Mariru non è ancora tornata...\nQuel drink andava davvero bene, vero?", "Akiko")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Rilassati, quella donna è una dura...", "Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aya aprì una nuova bottiglia di bevanda energetica e ne bevve un sorso. Sembrava molto più sveglia all'istante.")
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("Probabilmente è accovacciata in bagno a pensare in questo momento...", "Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("akikounglass")
	await novel_interface.show_dialog("...Stai pensando a come giustiziarti?", "Akiko")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","blush_dizzy")
	await novel_interface.show_dialog("Sto pensando al piano di Famur~!!", "Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Anche dopo aver raccolto una montagna di informazioni, Aya non aveva ancora idea di quale forma avrebbe preso l'imminente attacco della resistenza.")
	await novel_interface.show_text_only("Ha recuperato un'altra serie di immagini satellitari vicino al Mar Morto.")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_SatelliteDustStorm.png")
	await novel_interface.show_text_only("Nelle immagini meteorologiche satellitari in tempo reale, la tempesta di sabbia sembrava una pozza di acqua sporca che si diffondeva arbitrariamente sulla superficie terrestre.")
	await novel_interface.show_text_only("Ormai quella pozzanghera aveva completamente inghiottito il Gran Canyon di Mujib, sulla sponda orientale del Mar Morto, e stava rotolando verso la Fortezza di Masada a sud-ovest...")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	await novel_interface.show_text_only("Aya ha scansionato il quartiere dei bassifondi di Masada altre due volte con un satellite SID e non ha trovato traccia di fluttuazioni della fase spazio-temporale.")
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("Anche se esistesse davvero un'arma di materia eterogenea in grado di bloccare le onde elettromagnetiche, al momento dovrebbe essere inattiva...", "Aya")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("Altrimenti le immagini satellitari degli slum si sarebbero già trasformate in una sfocatura deformata a causa degli effetti di deflessione della luce...", "Aya")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Attaccare la fortezza di Masada pesantemente difesa senza armi a materia eterogenea?", "Akiko")
	await novel_interface.show_dialog("Anche se le armi di difesa dell'IA fossero paralizzate al 100%, ciò sarebbe comunque impossibile...", "Akiko")
	await novel_interface.show_dialog("Considerando le dimensioni delle squadre d'assalto descritte da Lian, quei terroristi non sarebbero durati venti minuti. Non potevano assolutamente mettere piede nel centro della città.", "Akiko")
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("Sicuramente c'è qualcosa che non va...", "Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Proprio come ha detto Mariru, questa volta Mushar ha consegnato se stesso e centinaia di migliaia di compagni della resistenza.")
	await novel_interface.show_text_only("Se davvero dovesse lanciare un attacco, allora, come un giocatore d'azzardo che sceglie di andare all-in al tavolo, sarebbe determinato a sconfiggere l'avversario proprio in questo round.")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_doomsday.png")
	await novel_interface.show_text_only("Ancora più difficile, operavano a una condizione implicita: non potevano attivare il sistema di ritorsione automatica di Masada.")
	await novel_interface.show_text_only("Se non si preoccupassero del sistema di ritorsione automatica, la resistenza potrebbe semplicemente restare fedele alla strategia precedente e continuare a spremere lo spazio vitale di Masada.")
	await novel_interface.show_text_only("Un giorno il sistema sociale ed economico di Masada crollerebbe completamente, e allora la resistenza potrebbe facilmente prendere frontalmente la città.")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	await novel_interface.show_text_only("Aya fissava in silenzio il grande schermo, sprofondando nei suoi pensieri mentre il tempo scorreva secondo dopo secondo...")
	await novel_interface.show_dialog("Aaaahhh, non ne ho assolutamente idea!!!", "Aya")
	await novel_interface.show_text_only("Come uno studente incapace di risolvere una domanda d'esame con un punteggio elevato, Aya improvvisamente sbatté forte la fronte contro la tastiera della console, spaventando Akiko.")
	await novel_interface.show_dialog("Come si annienta o si impadronisce del centro città di Masada senza attivare il sistema di ritorsione automatica...", "Aya")
	await novel_interface.show_text_only("Ancora seppellendo la testa nella tastiera, Aya mormorò tra sé.")
	await novel_interface.show_dialog("Sono settimane che penso a questo problema ed è totalmente impossibile!!", "Aya")
	await novel_interface.show_dialog("...Per settimane?", "Akiko")
	await novel_interface.show_dialog("...Perché passi il tuo tempo libero a pensare a cose del genere?", "Akiko")
	await novel_interface.show_dialog("Uh--\nBene...", "Aya")
	await novel_interface.show_text_only("Aya alzò la testa, con diversi segni rossi impressi sulla fronte dalla tastiera, e rispose debolmente.")
	novel_interface.show_character("ai","blush_stare")
	await novel_interface.show_dialog("È così che ammazzo il tempo quando il mio cervello è inattivo... Ci penso dal giorno in cui Masada ha annunciato il sistema di ritorsione automatica.", "Aya")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("...Sei un demone?!", "Akiko")
	await novel_interface.stop_music()
	await novel_interface.hide_background_with_fade()
	await novel_interface.show_text_only("...")
	await novel_interface.show_text_only("Nel frattempo, fuori dal luogo della cerimonia della firma.")
	novel_interface.change_music("res://assets/audio/music/Story_01.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_MasadAPCRS.png")
	await novel_interface.show_text_only("Con il passare del tempo, mi sono seduto rannicchiato al mio posto con le ginocchia abbracciate strettamente, aspettando con ansia l'\"ordine di evacuazione\" di cui Mariru aveva parlato.")
	novel_interface.show_character("ren_medical","gratified")
	await novel_interface.show_dialog("(Sembra davvero che le ragazze trovino più facile sedersi abbracciandosi le ginocchia...)", "Lian")
	novel_interface.change_expression("uneasy")
	await novel_interface.show_dialog("(È solo che ho il sedere un po' freddo...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sullo schermo della consolle era trasmessa la trasmissione televisiva della cerimonia della firma. Apparentemente anche il regista pensava che la stretta di mano fosse durata troppo a lungo, perché il feed si era interrotto in studio.")
	await novel_interface.show_text_only("I conduttori nello studio iniziarono a conversare oziosamente con il loro ospite, mentre io fissavo distrattamente la radio militare che Emily mi aveva infilato tra le mani la sera prima.")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_UAVs.png")
	await novel_interface.show_text_only("All'improvviso, la ripresa dal vivo è passata all'esterno della sede e il cameraman ha zoomato con il teleobiettivo verso il cielo sopra il muro di isolamento del centro città.")
	await novel_interface.show_text_only("Le voci sia dell'ospite che del reporter sul campo si alzarono contemporaneamente mentre diversi gruppi di droni di pattuglia sopra il muro iniziarono a scendere all'unisono.")
	await novel_interface.show_text_only("Secondo la procedura, i droni che pattugliano lungo il muro di isolamento ritornano ai loro posti in dodici gruppi a rotazione per aggiornare i loro protocolli di difesa.")
	await novel_interface.show_text_only("Mentre le armi difensive che normalmente giravano sopra il muro tutto l'anno gradualmente scesero e scomparvero dietro di esso, la giornalista sul posto si emozionò intensamente.")
	await novel_interface.show_text_only("La sua voce tremava sull'orlo delle lacrime mentre elogiava il significato storico del momento e continuava a parlare di come la pace fosse finalmente arrivata.")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_APC_Wall.png")
	novel_interface.show_character("ren_medical","wry_smile")
	await novel_interface.show_dialog("(Andiamo...)\n(Quei droni torneranno indietro dopo aver aggiornato i loro protocolli, vero?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("E per di più, era chiaramente di Samonton TV, una tipica caucasica dai capelli biondi e dagli occhi azzurri, eppure sembrava più eccitata della maggior parte dei reporter locali.")
	novel_interface.show_character("ren_medical","wry_smile")
