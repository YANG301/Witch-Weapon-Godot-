# stardustdescends_ep17.gd - 星尘降临篇第17话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	stardustdescends_ep17_script()

func play_script():
	pass

func stardustdescends_ep17_script():
	novel_interface.change_music("res://assets/audio/music/Sewer.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_SlumArea.png")
	await novel_interface.show_text_only("Scesi a tentoni le scale buie e uscii dall'edificio nell'oscurità più totale.")
	novel_interface.show_character("ren_medical","worry")
	await novel_interface.show_dialog("(È così buio...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("La mia chiamata con Emily era stata interrotta senza preavviso. Non importa quante volte ho provato a richiamare, non ho ricevuto risposta.")
	await novel_interface.show_text_only("Una brutta sensazione si insinuò in me. Il tasso di criminalità in questo slum era già fuori scala di notte, e presumibilmente gli estremisti si presentavano qui di tanto in tanto...")
	await novel_interface.show_text_only("Zia Haifa spense rapidamente le luci del corridoio e di tutte le stanze. Per fortuna i bambini dormivano già.")
	await novel_interface.show_text_only("Mentre chiudeva lentamente la pesante porta di metallo dell'orfanotrofio, un'ondata di terrore salì improvvisamente nel mio petto...")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Se restassi qui, forse non rivedrei mai più Emily e gli altri...")
	await novel_interface.show_text_only("Non so da dove sia venuto l'impulso, ma prima che la porta si chiudesse sono corsa fuori, ho lasciato un veloce \"vado a dare un'occhiata\" e sono corsa giù per le scale.")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_SlumArea.png")
	await novel_interface.show_text_only("...")
	novel_interface.show_character("ren_medical","wry_smile")
	await novel_interface.show_dialog("(Perché sono corso qui così sconsideratamente...?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Masada può avere un clima mite mediterraneo, ma il vento notturno era ancora freddo contro i miei capelli, che non si erano ancora asciugati del tutto.")
	await novel_interface.show_text_only("Il veicolo blindato parcheggiato nel cortile aveva le luci interne ed esterne spente, ma ho notato che il portello posteriore era chiuso solo a metà.")
	await novel_interface.show_text_only("Trattenendo il respiro, strisciai verso il retro del veicolo e aprii il portello quel tanto che bastava per infilarci la testa.")
	await novel_interface.show_text_only("Fissando la cabina buia come la pece, ho acceso la torcia del mio telefono...")
	await novel_interface.show_text_only("All'improvviso apparve alla vista la faccia capovolta di un uomo! La schiuma gli pendeva dall'angolo della bocca e le sue pupille senza vita mi fissavano!")
	await novel_interface.show_text_only("Ho fatto un salto indietro di riflesso come un cervo spaventato e il mio telefono mi è volato via di mano.")
	await novel_interface.show_text_only("Prima ancora che i miei piedi toccassero terra, un braccio mi afferrò da dietro mentre un'altra mano mi strinse forte la bocca.")
	novel_interface.show_character("ren_medical","sob")
	await novel_interface.show_dialog("(Mmmf--!)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ho guardato il mio telefono fare un arco in aria, solo per Emily che lo afferrava con una mano prima che toccasse terra e spegneva senza problemi la torcia.")
	novel_interface.show_character("emilio","smile")
	await novel_interface.show_dialog("(sussurrando) Shh! Siamo noi.", "Emily")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mi accarezzò impotente il viso terrorizzato e con noncuranza asciugò le lacrime che si erano appena formate agli angoli dei miei occhi.")
	novel_interface.show_character("valkyrja","happy")
	await novel_interface.show_dialog("Sei appena uscito dalla doccia?\n(sniff sniff) Hai un buon odore~", "Vera")
	novel_interface.change_expression("wink")
	await novel_interface.show_dialog("Non fare rumore, capito?", "Vera")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("La voce canzonatoria di Vera proveniva da dietro di me. Solo dopo avermi visto annuire obbedientemente si lasciò andare.")
	novel_interface.show_character("emilio","stare")
	await novel_interface.show_dialog("(sussurrando) Guarda fuori.", "Emily")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Seguendo la direzione da lei indicata, sbirciai attraverso la fessura del cancello del cortile verso la strada fuori...")
	await novel_interface.show_text_only("Una volta che i miei occhi si sono abituati all'oscurità, ho subito notato le ombre che frusciavano sulla strada.")
	novel_interface.show_character("emilio","stare")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_medical","stare",0.25)
	await novel_interface.show_dialog("(Quei ladri sono...? No, ce ne sono troppi.)", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("C'erano quattro o cinque uomini in nero proprio nel mio campo visivo, che giravano intorno a due vecchi furgoni che si muovevano a un ritmo innaturalmente lento.")
	await novel_interface.show_text_only("I furgoni non avevano i fari e anche le luci dei freni erano state rimosse. Gli autisti hanno mantenuto i motori quanto più silenziosi possibile.")
	await novel_interface.show_text_only("Non molto tempo dopo il passaggio del convoglio sospetto, un'altra squadra con la stessa identica disposizione è arrivata da dietro.")
	await novel_interface.show_text_only("In lontananza, un senzatetto uscì barcollando da una baracca all'angolo della strada con in mano una bottiglia di liquore, ruttò e guardò con sguardo assente la strada buia.")
	await novel_interface.show_text_only("Uno degli uomini vestiti di nero si avvicinò all'ubriaco, gli spezzò il collo senza esitazione e trascinò rapidamente il corpo nell'ombra sul ciglio della strada.")
	novel_interface.show_character("emilio","stare")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("ren_medical","panic",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("--?!!", "Lian")
	await novel_interface.show_dialog("Chi sono quelle persone...?", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Questa è già la sesta squadra che vediamo. Ne ho afferrato uno di nascosto proprio adesso, ma prima che potessi interrogarlo, ha addentato il veleno e si è ucciso.", "Emily")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Emily indicò il veicolo blindato, probabilmente riferendosi all'uomo che avevo appena visto con la schiuma alla bocca.")
	novel_interface.show_character("emilio","stare")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("ren_medical","panic",0.25)
	await novel_interface.show_dialog("Aveva una bandiera nera con slogan religiosi infilata nei vestiti. Di solito lo fanno solo gli estremisti che compiono attacchi suicidi...", "Emily")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Emily si accigliò profondamente. La situazione era chiaramente andata ben oltre ciò che si aspettava.")
	novel_interface.show_character("ren_medical","panic")
	await novel_interface.show_dialog("S-Attacco suicida?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Avevo visto quel termine solo nei film e nei notiziari stranieri. Non avevo mai sentito parlare di così tante persone presenti contemporaneamente!")
	novel_interface.show_character("ren_medical","panic")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("emilio","stare",0.25)
	await novel_interface.show_dialog("Questi veicoli non hanno targa né luci di stop, quindi possono circolare solo all’interno delle baraccopoli, che sono punti ciechi nella rete di sorveglianza. In qualunque altro posto, i droni li avrebbero intercettati quasi immediatamente.", "Emily")
	await novel_interface.show_dialog("La Forza di Difesa Nazionale effettua pattuglie casuali da queste parti anche durante il giorno, quindi non credo che quei veicoli sarebbero mai stati destinati a tornare indietro intatti...", "Emily")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0)
	await novel_interface.show_dialog("Y-vuoi dire...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("emilio","angry")
	await novel_interface.show_dialog("Un attacco suicida senza precedenti, che molto probabilmente avverrà nelle prossime ore.", "Emily")
	await novel_interface.hide_character()
	novel_interface.show_character("valkyrja","speak")
	await novel_interface.show_dialog("Il fatto che siano arrivati così vicino al centro città significa che i veicoli non trasportano materiale radioattivo...", "Vera")
	await novel_interface.show_dialog("Ci sono rilevatori di materiale radioattivo sepolti sotto le strade per chilometri intorno a Masada.", "Vera")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Ma se si trattasse solo di un attacco con un’autobomba, avrebbero davvero bisogno di così tante persone?", "Vera")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","sob")
	await novel_interface.show_dialog("S-Dovremmo segnalarlo prima?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("emilio","stare")
	await novel_interface.show_dialog("I segnali elettromagnetici nelle vicinanze sono tutti disturbati in questo momento. Ho appena inviato un codice di emergenza da una cabina telefonica pubblica.", "Emily")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ci sono ancora cose così vecchie da queste parti?")
	novel_interface.show_character("emilio","stare")
	await novel_interface.show_dialog("La resistenza utilizza raramente anche apparecchiature di disturbo in prima linea. Non ho idea di chi siano queste persone...", "Emily")
	await novel_interface.hide_character()
	novel_interface.show_character("valkyrja","angry")
	await novel_interface.show_dialog("Anche se l'esercito e Monola accorressero, ci vorranno almeno dieci minuti. A quel punto queste persone se ne saranno andate da tempo.", "Vera")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","stare")
	await novel_interface.show_dialog("Allora dovremmo seguirli in silenzio?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("emilio","speechless")
	await novel_interface.show_dialog("Questo non aiuterà. Dato che operano in gruppi, si divideranno e si nasconderanno sicuramente separatamente.", "Emily")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Giusto. Questa baraccopoli è già un'enclave di minoranze etniche e le bande locali che parlano lingue diverse sono tutte mescolate insieme nel caos più completo.")
	await novel_interface.show_text_only("Non solo le infrastrutture sono gravemente deteriorate, ma ci sono anche molte zone nascoste scavate da strutture illegali che non compaiono su nessuna mappa di pianificazione.")
	await novel_interface.show_text_only("Il governo di Masada è sempre stato ambiguo riguardo al caos che c'è qui. In ogni caso, il bilancio nazionale è al limite da anni, quindi non hanno avuto la forza di ripulire questa discarica.")
	novel_interface.show_character("ren_medical","worry")
	await novel_interface.show_dialog("Ciò potrebbe avere qualcosa a che fare con l'accordo di cessate il fuoco di domani?", "Lian")
	novel_interface.change_expression("wry_smile")
	await novel_interface.show_dialog("Li... voglio dire, il mio superiore ha menzionato una specie di cerimonia per la firma domani.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("emilio","shout")
	await novel_interface.show_dialog("Ah! A che ora è la cerimonia domani?", "Emily")
	await novel_interface.hide_character()
	novel_interface.show_character("valkyrja","panic")
	await novel_interface.show_dialog("Se ricordo bene, l'avviso interno diceva che era stato spostato alle sei del mattino. Saranno presenti molti media, quindi hanno voluto evitare il più possibile la tempesta di sabbia per le riprese.", "Vera")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Il nostro rappresentante firmatario è il Maggiore Generale Hamon. Nelle interviste ha anche detto che alla cerimonia avrebbe indossato un abito invece dell'uniforme.", "Vera")
	novel_interface.change_expression("speechless")
	await novel_interface.show_dialog("Quel grosso rospo potrebbe anche semplicemente annunciare che si candiderà alle elezioni del prossimo anno. Le sue ambizioni non potrebbero essere più evidenti...", "Vera")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","wry_smile")
	await novel_interface.show_dialog("(...Rospo?)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("emilio","stare")
	await novel_interface.show_dialog("Aspetta... se è Hamon...", "Emily")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Emily sembrava avere molta familiarità con il maggiore generale. Aggrottò le sopracciglia e pensò intensamente.")
	novel_interface.show_character("emilio","stare")
	await novel_interface.show_dialog("Se Hamon avesse davvero intenzione di candidarsi come primo ministro, data la sua personalità probabilmente penserebbe che una semplice firma e una stretta di mano siano troppo deboli.", "Emily")
	novel_interface.change_expression("shout")
	await novel_interface.show_dialog("Se vuole che i media vedano i cambiamenti portati dal cessate il fuoco in modo più diretto, suppongo che aggiornerà allo stesso tempo i protocolli elettronici delle armi di difesa IA.", "Emily")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","bored")
	await novel_interface.show_dialog("Cosa intendi con...?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("emilio","shout")
	await novel_interface.show_dialog("Se i media di sinistra presenti sul posto avessero visto gli sciami di droni che circondavano Masada tutto l'anno essere disarmati e ritirati, probabilmente sarebbero scoppiati a piangere sul posto.", "Emily")
	await novel_interface.hide_character()
	novel_interface.show_character("valkyrja","wink")
	await novel_interface.show_dialog("Pfft--\nSì, lo vedo.", "Vera")
	novel_interface.change_expression("panic")
	await novel_interface.show_dialog("Aspetta... Stai dicendo che quelle persone stanno pianificando un attacco mentre il sistema di difesa di Masada sta aggiornando il protocollo unificato!?", "Vera")
	await novel_interface.hide_character()
	novel_interface.show_character("emilio","stare")
	await novel_interface.show_dialog("L'80% delle difese di Masada si basano su armi IA. Il sistema non sarebbe così stupido da mettere tutto offline in una volta.", "Emily")
	await novel_interface.show_dialog("Un importante aggiornamento del protocollo come questo, verrebbe fatto in lotti per settore della difesa...", "Emily")
	novel_interface.change_expression("shout")
	await novel_interface.show_dialog("Giusto. Dove si terrà esattamente la cerimonia della firma di domani?", "Emily")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","panic")
	await novel_interface.show_dialog("Uh, penso che sia un centro congressi vicino al Mar Morto.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Mi sono ricordato che Mariru me ne ha parlato al telefono proprio adesso...")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_ShelterOffice.png")
	await novel_interface.show_dialog("Hanno definito il rappresentante di Masada per la firma del cessate il fuoco di domani. Sarà il Maggiore Generale Hamon del Comando Nord.", "Mariru")
	await novel_interface.show_dialog("E per ragioni politiche, il luogo della firma è stato scelto come Centro Congressi Internazionale di Masada sul Mar Morto.", "Mariru")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_SlumArea.png")
	novel_interface.show_character("valkyrja","speak")
	await novel_interface.show_dialog("Centro congressi internazionale di Masada?\nNon è lontano da qui...", "Vera")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","solemn")
	await novel_interface.show_dialog("Stanno pianificando di attaccare direttamente la sede?!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("valkyrja","speechless")
	await novel_interface.show_dialog("Non essere ridicolo. L'area intorno alla sede sarà sicuramente sotto stretta sorveglianza di Monola e la Forza di Difesa Nazionale avrà armi pesanti schierate ovunque.", "Vera")
	await novel_interface.show_dialog("Se quelle persone avessero osato dirigersi verso il centro congressi, sarebbero stati individuati a cinque chilometri di distanza e sterminati immediatamente.", "Vera")
	await novel_interface.hide_character()
	novel_interface.show_character("emilio","stare")
	await novel_interface.show_dialog("Ricordo dove si trova il centro congressi sulla mappa. Se fossi in quel corridoio...", "Emily")
	await novel_interface.show_dialog("Il muro di isolamento più vicino che potrei vedere sarebbe quello tratto di fronte a noi, giusto?", "Emily")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ho seguito il gesto di Emily e ho guardato in quella direzione. La strada che si estendeva in lontananza sembrava quasi essere interrotta dall'imponente muro di isolamento...")
	await novel_interface.show_text_only("Al di là, deboli barlumi del vivace centro della città filtravano attraverso...")
	novel_interface.show_character("emilio","stare")
	await novel_interface.show_dialog("Questo è il muro di isolamento nord-orientale del centro città. Se il luogo non è il loro vero obiettivo...", "Emily")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Emily e Vera tacquero entrambe. A giudicare dalle loro espressioni, potevo capire quanto fosse grave la situazione.")
	await novel_interface.show_text_only("Alzai lo sguardo al cielo oscurato. Non c'era una sola stella.")
	novel_interface.show_character("ren_medical","worry")
	await novel_interface.show_dialog("(Il cielo era... sempre così buio?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Allora, una sensazione inquietante e inquietante che non potevo esprimere a parole sgorgò dentro di me.")
	await novel_interface.show_text_only("Ma in quel momento non potevo sapere che le cose sarebbero andate così...")
	await novel_interface.stop_music()
	await novel_interface.show_text_only("...")
	await novel_interface.show_text_only("Allo stesso tempo, nella Quinta Città Scolastica.")
	novel_interface.change_music("res://assets/audio/music/Shop.mp3")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_bar.png")
	await novel_interface.show_text_only("La dolce musica di sottofondo continuava a suonare mentre il professor Shih si sedeva sul divano stringendosi la testa per il dolore.")
	novel_interface.show_character("liliu_uniform1","normal2")
	await novel_interface.show_dialog("Sei sveglio?", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru mise un drink davanti al professor Shih e si sedette lentamente sulla poltrona di fronte a lui.")
	novel_interface.show_character("liliu_uniform1","normal2")
	await novel_interface.show_dialog("E' acqua elettrolitica. Aiuterà con il mal di testa.", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("shi","eyeclose",0.25)
	await novel_interface.show_dialog("Io...", "Professor Shih")
	novel_interface.change_2nd_expression("normal")
	await novel_interface.show_dialog("Mi sento come... ti conosco?", "Professor Shih")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru fu sorpresa dentro di sé, ma non ne venne mostrata traccia sul suo viso.")
	await novel_interface.show_text_only("Aveva intenzione di verificare con il professor Shih le informazioni che aveva appena ottenuto sul progetto nero della NASA, ma la sua reazione le diede invece qualcosa di inaspettato.")
	novel_interface.show_character("liliu_uniform1","normal1")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("shi","normal",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("(Nessuno dei precedenti interrogatori gli ha lasciato ricordi. L'ultima cancellazione della memoria non è riuscita a finire?)", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Cosa... ti ricordi?", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"eyeclose")
	await novel_interface.show_dialog("N-No... credo di averti visto in sogno... Neanch'io ricordo bene.", "Professor Shih")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("E' acqua elettrolitica. Aiuterà con il mal di testa.", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru spinse la bevanda giallo pallido verso il professor Shih. Era la \"misura di sicurezza\" che Aya aveva ideato.")
	await novel_interface.show_text_only("Finché il liquido nella tazza fosse stato consumato, il legame tra l'interrogante e il soggetto sarebbe stato automaticamente interrotto.")
	await novel_interface.show_text_only("In circostanze normali, quando il soggetto vedeva l'acqua elettrolitica, istintivamente resisteva, come se berla significasse ammettere che c'era qualcosa che non andava in lui.")
	await novel_interface.show_text_only("Ma una volta che lo stato mentale del soggetto diventasse instabile, sarebbe stato più propenso a bere l'acqua per calmarsi.")
	await novel_interface.show_text_only("Il professor Shih fissò a lungo la tazza prima di iniziare finalmente a parlare:")
	novel_interface.stop_music()
	novel_interface.show_character("shi","eyeclose")
	await novel_interface.show_dialog("C'è stato un periodo in cui mia figlia soffriva di insonnia ripetuta. Durante una telefonata, mi ha parlato di un esperimento mentale...", "Professor Shih")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("La sua domanda era: perché l'apocalisse non è ancora arrivata?", "Professor Shih")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal2")
	await novel_interface.show_dialog("Ah?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.change_music("res://assets/audio/music/Deep Water.mp3")
