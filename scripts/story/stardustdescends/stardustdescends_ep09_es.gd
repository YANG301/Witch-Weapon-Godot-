# stardustdescends_ep09.gd - 星尘降临篇第9话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	stardustdescends_ep09_script()

func play_script():
	pass

func stardustdescends_ep09_script():
	novel_interface.change_music("res://assets/audio/music/Normal Stage.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_Ordovician.png")
	await novel_interface.show_text_only("A la gente siempre le encanta especular: si existe una poderosa civilización alienígena, ¿es benévola o maliciosa?")
	await novel_interface.show_text_only("Una respuesta más probable es... es indiferente.")
	await novel_interface.show_text_only("Un día, hace 449 millones de años, un haz de rayos gamma de alta energía procedente de 6.000 años luz de distancia atravesó la atmósfera y chocó contra la Tierra.")
	await novel_interface.show_text_only("En un instante, la radiación destruyó un tercio de la capa de ozono, permitiendo que la luz ultravioleta del sol atravesara directamente la atmósfera.")
	await novel_interface.show_text_only("Murieron enormes cantidades de plancton, destrozando los cimientos de la cadena alimentaria marina, y la hambruna comenzó a extenderse.")
	await novel_interface.show_text_only("Varias décadas después del desastre, las moléculas atmosféricas destrozadas se recombinaron, formando grandes cantidades de dióxido de nitrógeno tóxico.")
	await novel_interface.show_text_only("El dióxido de nitrógeno cubrió el cielo, bloqueando el 50% de la luz solar. Privada de luz solar, la Tierra comenzó a enfriarse rápidamente.")
	await novel_interface.show_text_only("Las temperaturas del océano cayeron de 25 grados a 10 grados y la muerte adicional del plancton aceleró el colapso de la cadena alimentaria.")
	await novel_interface.show_text_only("Quinientos años después de la catástrofe, un tercio de toda la vida en la Tierra había desaparecido, y lo que quedaba luchaba contra el hambre y el frío.")
	await novel_interface.show_text_only("Con la disminución de la luz solar, enormes cantidades de agua de mar se congelaron en todo el mundo. Los glaciares se extendieron a una velocidad inimaginable y el nivel del mar cayó 100 metros.")
	await novel_interface.show_text_only("Ciento cincuenta mil años después del desastre, la temperatura media global bajó a 5 grados. La mayor parte de la superficie estaba cubierta de hielo y más de la mitad de todas las especies perecieron a causa del frío.")
	await novel_interface.show_text_only("El descuido de una estrella distante que colapsó en algún lugar de la galaxia sumió a la vida antigua en la Tierra en una desesperación sin fin.")
	await novel_interface.show_text_only("──Ese accidente es conocido en la historia como la extinción masiva del Ordovícico Tardío.")
	await novel_interface.hide_background()
	await novel_interface.stop_music()
	await novel_interface.show_text_only("...")
	await novel_interface.show_text_only("...")
	await novel_interface.show_text_only("La Quinta Ciudad Escolar.")
	await novel_interface.show_text_only("Mientras una suave melodía sonaba de fondo, el hombre tumbado en el sofá se despertó lentamente...")
	novel_interface.change_music("res://assets/audio/music/Sunset.mp3")
	novel_interface.show_background("res://assets/images/bg/Fabiola/BAR.png")
	await novel_interface.show_text_only("Con barba incipiente en la cara y cabello desordenado, luchó por incorporarse usando el respaldo del sofá como apoyo.")
	await novel_interface.show_text_only("Sobre la mesa frente a él había un vaso de agua. Sentía la garganta tan seca como si acabara de salir del desierto, así que la agarró y la bebió de un trago.")
	await novel_interface.show_text_only("Entonces lo golpeó un terrible dolor de cabeza. Se agarró la cabeza y gimió durante un rato, y de repente se levantó como si buscara algo.")
	await novel_interface.show_text_only("Una vez que encontró su maletín al lado del sofá y confirmó que los documentos que contenía estaban intactos, se sintió un poco tranquilo y volvió a sentarse.")
	novel_interface.show_character("shi","normal")
	await novel_interface.show_dialog("Esto es...\n¿Dónde estoy...?", "Professor Shih")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("El profesor Shih miró a su alrededor. El lugar parecía un bar exclusivo, con música suave flotando por la habitación y luces de neón parpadeando en los edificios exteriores.")
	await novel_interface.show_dialog("¿Estás despierto?", "Voz femenina")
	await novel_interface.show_text_only("Siguiendo la voz, el profesor Shih vio a una mujer pelirroja con una bata blanca que se acercaba lentamente con una bebida de color amarillo pálido en la mano.")
	await novel_interface.show_text_only("Dejó la bebida delante de él y se sentó en el sofá de enfrente.")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Es agua electrolítica. Ayudará con el dolor de cabeza.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("shi","normal")
	await novel_interface.show_dialog("¿Tú eres...?", "Professor Shih")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("El profesor Shih la miró a la cara con recelo, como si tuviera algún vago recuerdo de ella.")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Deberías conocerme──", "Mariru")
	await novel_interface.show_dialog("Soy Mariru von Braun. El año pasado, cuando vino a la Academia de Ciencias de New Toyosu como académico visitante, asistió a mi conferencia sobre objetos heteromórficos cristalinos.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru hizo una pausa, luego sonrió y continuó.")
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("Además, soy el jefe de SID.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("El profesor Shih se sobresaltó, instintivamente queriendo correr, pero rápidamente abandonó ese pensamiento infantil...")
	await novel_interface.show_text_only("Mariru le entregó una tableta y le dijo con dulzura:")
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("No tengas miedo. Es muy seguro aquí──", "Mariru")
	await novel_interface.show_dialog("Y si no fuera por nosotros, ya estarías muerto.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("El profesor Shih tomó la tableta con recelo. Mostraba imágenes de vigilancia de la calle.")
	await novel_interface.show_text_only("De repente recordó haber esperado en esa villa durante mucho tiempo sin ver al comprador con el que había quedado. Cuando salió, llamó a un taxi.")
	await novel_interface.show_text_only("Mientras esperaba al borde del camino, sintió un dolor agudo en el cuello, y luego todo se volvió negro...")
	novel_interface.show_character("shi","normal")
	await novel_interface.show_dialog("Esto es...", "Professor Shih")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("En las imágenes, el profesor Shih estaba junto a la carretera esperando el taxi. Cuando una mujer de mediana edad pasó detrás de él, de repente sacó una jeringa──")
	await novel_interface.show_text_only("Con un movimiento limpio y eficiente, le clavó la aguja en el cuello y luego rápidamente atrapó su cuerpo colapsado por detrás.")
	await novel_interface.show_text_only("Unos tres segundos después, una camioneta negra con la puerta lateral abierta se detuvo junto a la acera y dos personas dentro lo subieron al vehículo.")
	await novel_interface.show_text_only("Luego la furgoneta se alejó a toda velocidad. En menos de diez segundos, había desaparecido como si se hubiera evaporado del mundo.")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Estas personas eran asesinos contratados online por un cliente anónimo por un alto precio. Por suerte, paramos la furgoneta en el primer cruce...", "Mariru")
	await novel_interface.show_dialog("En ese momento estaban a punto de inyectarte una neurotoxina. Un paso más adelante y ahora mismo estarías con muerte cerebral.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("El profesor Shih respiró hondo y se puso rígido.")
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Por eso...", "Mariru")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("¿A quién ofendiste?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("shi","angry")
	await novel_interface.show_dialog("¿Ofender...?\nH-¡Cómo puede ser eso!", "Professor Shih")
	await novel_interface.show_dialog("Sólo soy un erudito. ¿A quién podría haber ofendido...?", "Professor Shih")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Esa villa siempre ha tenido una sólida reputación como \"corretaje clandestino\". Ya fueran negocios de armas, documentos clasificados u objetos heteromórficos──", "Mariru")
	await novel_interface.show_dialog("Bajo la garantía de la organización llamada \"Siete Mandamientos\", por vil que fuera el comprador o el vendedor, nadie se atrevía a cruzar la línea.", "Mariru")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Pero esta vez, el comprador con el que contactó estaba dispuesto a correr tal riesgo para eliminar a un novato inútil como usted. ¿Por qué?", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("El profesor Shih, a la defensiva, se subió el cuello de su abrigo y miró su viejo bolso de cuero.")
	novel_interface.show_character("shi","normal")
	await novel_interface.show_dialog("Ya lo has visto, ¿verdad? Este es un archivo \"alto secreto\" de First School City. ¿Podría ser la Puerta Sin Forma...?", "Professor Shih")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru se reclinó contra el sofá y se rió con desdén──")
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("Si incluso alguien como tú puede llevarlo al extranjero, entonces no puede ser tan secreto.", "Mariru")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Ya han aparecido en el mercado tres documentos idénticos y el departamento de inteligencia de Masada también consiguió uno.", "Mariru")
	await novel_interface.show_dialog("Incluso se puede inferir que Huayungong permitió deliberadamente que este documento se filtrara──", "Mariru")
	await novel_interface.show_dialog("Y hasta donde yo sé, los otros vendedores que intercambiaron esta información completaron sus transacciones sin incidentes.", "Mariru")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("Comparado con ellos, ¿qué tienes de especial para que tuvieran que arriesgarse a silenciarte?", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("El profesor Shih miró fijamente durante un largo rato, incapaz de decir una palabra.")
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Supongo que el precio que le cotizaste a tu comprador anterior no era solo dinero, ¿verdad?", "Mariru")
	await novel_interface.show_dialog("¿Quizás lo que pediste fue precisamente lo que casi hizo que te mataran?", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("El hombre frente a Mariru dejó escapar un largo suspiro, se relajó y se reclinó en el sofá.")
	novel_interface.show_character("shi","eyeclose")
	await novel_interface.show_dialog("La gente como tú... es aterradora.", "Professor Shih")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("Me siento halagado ~", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Las comisuras de la boca de Mariru se elevaron ligeramente.")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Ya que entiendes la situación en la que te encuentras ahora──", "Mariru")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Entonces hablemos de nuestro trato.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.stop_music()
	await novel_interface.hide_background_with_fade()
	await novel_interface.show_text_only("...")
	await novel_interface.show_text_only("La Tercera Ciudad Escolar, aduana del puerto de Masada.")
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_MasadaCustoms.png")
	novel_interface.show_character("ren_medical","stare")
	await novel_interface.show_dialog("¿Puede algo que parece un tatuaje realmente biodegradarse por sí solo...?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Froté el código de barras en el dorso de mi mano. Al parecer la tinta utiliza algún tipo de procesamiento heteromórfico y desaparece automáticamente en un momento preestablecido.")
	await novel_interface.show_text_only("Este código de barras es el permiso de entrada de la aduana de Masada y la única identificación legal que tienen los extranjeros mientras permanecen en el país.")
	await novel_interface.show_text_only("En el momento en que expira la estancia permitida, se supone que la tinta se evapora por sí sola.")
	await novel_interface.show_text_only("Sin este código de barras, cualquier soldado u oficial de inspección en Masada tiene derecho a arrestarme en el acto.")
	novel_interface.show_character("ren_medical","uneasy")
	await novel_interface.show_dialog("(Hmm... no se borrará cuando me duche, ¿verdad?)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("stardust_small","disgust")
	await novel_interface.show_dialog("Tan lento...", "Stardust")
	novel_interface.change_expression("wordless")
	await novel_interface.show_dialog("Waaah waaah aaawoo ~~", "Stardust")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Cansada de esperar, Stardust murmuró sílabas sin sentido en voz baja mientras se acercaba a la ventana del pasillo y se aferraba al pilar para mirar hacia afuera.")
	await novel_interface.show_text_only("La llevé por el pasillo especial para la Organización Internacional de Ayuda Médica, pero Annie tuvo que hacer cola en el carril de seguridad habitual para visitantes comunes.")
	await novel_interface.show_text_only("La seguridad de Masada es famosa en todo el mundo por ser brutalmente estricta; Incluso en el lobby del puerto, soldados con munición real patrullan por todas partes.")
	await novel_interface.show_text_only("Caminé detrás de Stardust y miré hacia el este por la ventana. Allí pude ver el mar Muerto azul en calma y la presa Elijah al final del Gran Canal.")
	await novel_interface.show_text_only("Cerca del desagüe en el lado sur de la presa del Mar Muerto, el agua estaba veteada de un turquesa irregular y un azul pálido, y cuanto más al norte se miraba, más profundo se volvía el color del agua.")
	await novel_interface.show_text_only("Según el Génesis, las dos ciudades pecadoras destruidas por Dios (Sodoma y Gomorra) se encuentran hundidas bajo el sur del Mar Muerto.")
	await novel_interface.show_text_only("Me preguntaba si el mar aún albergaba espíritus errantes que alimentaban resentimiento hacia \"ese grande\".")
	await novel_interface.show_text_only("En ese momento, en el horizonte nororiental, la bruma roja oscura nacida de la tormenta de arena comenzaba a agitarse.")
	await novel_interface.show_text_only("Pero lo que más me pareció extraño fue que esta pequeña niña había sido quien me contó sobre la tormenta de arena──")
	novel_interface.show_character("stardust_small","konata_eye")
	await novel_interface.show_dialog("¿Mmm?", "Stardust")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","smile")
	await novel_interface.show_dialog("Oye ~ ¿conoces la historia de Masada?", "Lian")
