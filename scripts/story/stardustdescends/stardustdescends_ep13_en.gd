# stardustdescends_ep13.gd - 星尘降临篇第13话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	stardustdescends_ep13_script()

func play_script():
	pass

func stardustdescends_ep13_script():
	novel_interface.change_music("res://assets/audio/music/Story_01.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_MasadSentry.png")
	await novel_interface.show_text_only("Judging by the footage from the vehicle monitor, straight ahead was a section of isolation wall still under construction.")
	await novel_interface.show_text_only("Because this was on the edge of the inner city, it had none of the prosperous, peaceful feel of the central district--")
	await novel_interface.show_text_only("Steel, concrete, and dust restored the raw, rough texture of a desert war zone.")
	await novel_interface.show_text_only("The checkpoint ahead had been built like a fortress, and several APCs of the same model were parked around it.")
	await novel_interface.show_text_only("In the distance, many tower cranes and heavy machines were at work, and beyond the wall you could vaguely see swarms of drones in the sky.")
	await novel_interface.show_text_only("From the way the metal barricades were arranged, the exit ahead clearly looked closed to traffic.")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_MasadAPCO2.png")
	novel_interface.show_character("ren_medical","wail")
	await novel_interface.show_dialog("You mean to... force your way through?", "Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Emily rapped her knuckles against the inner wall of the APC.")
	novel_interface.show_character("emilio","speechless")
	await novel_interface.show_dialog("With this?", "Emily")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("The armor is sturdy, but it conducts heat just like ordinary metal. We'd probably last about twenty seconds before we're roasted alive~", "Emily")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Suddenly the vehicle stopped. A familiar voice came from the driver's cabin--")
	await novel_interface.show_dialog("Vera Valkyrie, Warrant Officer First Class of the Caracal Battalion, picking up personnel from camp for reconnaissance outside the city.", "Vera")
	novel_interface.show_character("ren_medical","wry_smile")
	await novel_interface.show_dialog("(That's the super-strong security woman from the casino ship, isn't it?!)", "Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I still vividly remembered her lifting that huge chief bishop one-handed.")
	await novel_interface.show_dialog("Oh, it's Vera. There's a protest going on over by Yehuda Market right now. If you don't want to get bogged down, you'd better take another exit...", "Male Voice")
	await novel_interface.show_dialog("Stop talking and let us through already. We don't have time for a detour!", "Vera")
	await novel_interface.show_dialog("Haha, fine, fine. Just don't cause more trouble. Last time your old man called down from General Staff HQ just to chew people out...", "Male Voice")
	await novel_interface.show_dialog("Mention him again and I'll run you over.", "Vera")
	await novel_interface.show_dialog("Move the roadblock. Let them through, let them through!", "Male Voice")
	await novel_interface.show_text_only("Emily leaned over and whispered to me.")
	novel_interface.show_character("emilio","mock")
	await novel_interface.show_dialog("So, did you have that brief moment where you thought about shouting for help... and then chickened out?", "Emily")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","shy_left")
	await novel_interface.show_dialog("Of course not!", "Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I hurriedly turned my head away. Ugh, she's so obnoxious!")
	await novel_interface.show_text_only("The vehicle slowly rolled forward and soon passed through the isolation wall into Masada's outer city.")
	await novel_interface.show_text_only("I'd assumed the outer city would be even more desolate, but after we crossed the isolation wall, the number of people on the road suddenly jumped--")
	await novel_interface.show_text_only("The roads were rougher here, and there were fewer high-rises and green belts, but the streets were unexpectedly lively.")
	await novel_interface.show_text_only("The crowds, the buses weaving back and forth, and the street vendors hawking goods made me feel like I'd slipped through time.")
	novel_interface.show_character("ren_medical","gratified")
	await novel_interface.show_dialog("There are so many people here...", "Ren")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("emilio","smile",0.25)
	await novel_interface.show_dialog("Of course. Ninety percent of this city's population lives outside the isolation wall.", "Emily")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("That many!?", "Ren")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("The inner city is only 32 square kilometers in total, less than a quarter of Masada's total area, and the land prices are outrageous~", "Emily")
	await novel_interface.show_dialog("Especially in the central district. The floor space of a single toilet there would be enough to buy a studio apartment by the Dead Sea.", "Emily")
	novel_interface.character_light(0.35,"wry_smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("I thought the isolation wall was for that... you know...", "Ren")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Racial segregation?", "Emily")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Right, right. Isn't there some rule that certain words offensive to a specific group can only be said by people from that group themselves...")
	novel_interface.show_character("emilio","mock")
	await novel_interface.show_dialog("The United Council outlawed that kind of thing long ago~", "Emily")
	await novel_interface.show_dialog("But Masada's Anti-Terrorism Act says that if you want to reside long-term in the inner city where the government and parliament are located, you have to pass a Security Bureau review.", "Emily")
	await novel_interface.show_dialog("And applicants whose immediate family belong to certain ethnic groups just so happen to never pass... get it?", "Emily")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I nodded, only half understanding.")
	await novel_interface.show_text_only("So that is segregation!
Even if it sounds like they're segregating themselves...")
	await novel_interface.show_text_only("And if that's true, then even most ethnic Masadans must also be living in the outer city, right?")
	await novel_interface.show_text_only("On the screen I saw a female soldier with an M16 slung over her shoulder squatting in front of a street stall selling hair ornaments, haggling with a woman vendor whose face was wrapped in a headscarf.")
	novel_interface.show_character("ren_medical","wail")
	await novel_interface.show_dialog("(Turns out nobody can afford housing no matter where they're from...)", "Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Suddenly the vehicle braked hard. My head almost hit the screen, and Vera's swearing rang out from the driver's cabin.")
	await novel_interface.show_dialog("Damn it!!", "Vera")
	novel_interface.show_character("emilio","shout")
	await novel_interface.show_dialog("What happened!?", "Emily")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("I launched a scout drone. Just watch the screen yourselves.", "Vera")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Emily and I hurried over to the display and saw a scene that made my skin crawl--")
	#novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_AncientHumanEH.png") #原游戏有素材，但已丢失
	await novel_interface.show_text_only("More than a thousand men in black coats and black hats were gathered at the intersection ahead, like some massive funeral.")
	await novel_interface.show_text_only("They held homemade black-and-white protest signs, as though objecting to the existence of any other colors in the world.")
	await novel_interface.show_text_only("Most of them had huge beards and strange little braids at their temples. That look felt awfully familiar...")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_MasadAPCR1.png")
	await novel_interface.show_dialog("These useless pieces of crap! They live off state subsidies and still protest every damn day!", "Vera")
	await novel_interface.show_text_only("Let's just assume \"bleep\" is some kind of dialect... I couldn't understand it anyway.")
	await novel_interface.show_dialog("They want the number of elementary schools that match their doctrine doubled?
Have those damn side curls grown into their brains!?", "Vera")
	await novel_interface.show_text_only("I heard kicking from the cabin door. Apparently our driver had jumped out to pick a fight.")
	novel_interface.show_character("ren_medical","wail")
	await novel_interface.show_dialog("Wh-What's she doing?", "Ren")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("emilio","mock",0.25)
	await novel_interface.show_dialog("Going to cover the plates~", "Emily")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Emily answered absentmindedly while checking the route map on her rugged military tablet.")
	novel_interface.show_character("ren_medical","wry_smile")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("emilio","mock",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("W-What's she going to do...? Those people are Masadans, aren't they?
I think I saw some of them at the museum just now...", "Ren")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"stare")
	await novel_interface.show_dialog("They're Masada's \"historical heritage\" lot. They don't work, don't pay taxes, don't serve in the military, and the government still has to hand them monthly subsidies--", "Emily")
	await novel_interface.show_dialog("Even if they disrupt public order and block traffic, the police and army can't touch them, because they have their own religious courts.", "Emily")
	novel_interface.character_light(0.35,"stare")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("...That's so good?", "Ren")
	novel_interface.change_expression("uneasy")
	await novel_interface.show_dialog("(Wouldn't that mean you could just stay home and play games every day...)", "Ren")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"mock")
	await novel_interface.show_dialog("But their doctrine says there can't be TVs or computers in the home, and internet access is strictly forbidden--", "Emily")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("That's torture!!")
	novel_interface.show_character("ren_medical","uneasy")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("emilio","speechless",0.25)
	await novel_interface.show_dialog("But their wives are different. They're allowed to use electronic devices, because those men rely on women to earn money and help support the household.", "Emily")
	novel_interface.change_2nd_expression("stare")
	await novel_interface.show_dialog("It's not because the subsidies are too small. It's because women in those families average six or seven children, and some have over a dozen.", "Emily")
	novel_interface.change_2nd_expression("speechless")
	await novel_interface.show_dialog("That many kids. No wonder religious schools aren't enough...", "Emily")
	novel_interface.character_light(0.35,"bored")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("(Could the ten-odd children I saw clustering around those two bearded men in black at the museum have been--)", "Ren")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("And the two haggard women following behind them...")
	await novel_interface.show_text_only("When I thought of the stroller one of them had been pushing, a chill ran down my back.")
	novel_interface.show_character("emilio","speechless")
	await novel_interface.show_dialog("Religious fundamentalists are a cancer no matter where you go...", "Emily")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Emily kept fiddling with her tablet with her head down, her tone carrying a strange sadness and a hint of resignation.")
	await novel_interface.show_text_only("Before long Vera came back into the vehicle, and Emily patted the metal partition of the cabin to remind her.")
	novel_interface.show_character("emilio","smile")
	await novel_interface.show_dialog("Go around to the third intersection on the east side. There's a newly completed overpass there. It's the fastest route out of the city.", "Emily")
	await novel_interface.show_dialog("And also, if you're going to do \"that,\" remember to turn the vehicle around first.", "Emily")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Got it~", "Vera")
	await novel_interface.show_text_only("Vera spun the wheel to its limit and slammed the gas, whipping the front end around in one turn without the slightest concern for passenger comfort.")
	await novel_interface.show_text_only("A moment later, there came four dull thumps from the roof of the vehicle: thud, thud, thud, thud.")
	novel_interface.show_character("ren_medical","panic")
	await novel_interface.show_dialog("(Wait, why did that sound like a grenade launcher...)", "Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Very soon the gathered men in black began to panic, as plumes of white tear-gas smoke erupted from four different spots in the crowd...")
	await novel_interface.show_text_only("And our vehicle floored it and vanished around the corner.")
	await novel_interface.stop_music()
	await novel_interface.hide_background_with_fade()
	await novel_interface.show_text_only("...")
	await novel_interface.show_text_only("............")
	await novel_interface.show_text_only("As the shadow of the isolation wall grew smaller behind me, the land on both sides of the road gradually became barren.")
	await novel_interface.show_text_only("After staying in the city for so long, it was easy to forget that Masadaburg itself was an abrupt city built in the desert.")
	await novel_interface.show_text_only("The APC sped along an empty road, and there was no sign of human life anywhere beside the lonely highway.")
	await novel_interface.show_text_only("Only a few dried-up shrubs still stood stubbornly in the sand...")
	novel_interface.change_music("res://assets/audio/music/unkown/Battle_08.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_StagingPost.png")
	await novel_interface.show_text_only("After another hour or so outside the city, the troop compartment door slowly opened and a military supply station appeared before me.")
	novel_interface.show_character("valkyrja","normal")
	await novel_interface.show_dialog("This is it. Want to make her help out?", "Vera")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","perspire1")
	await novel_interface.show_dialog("Huh?!", "Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("emilio","smile")
	await novel_interface.show_dialog("No problem. She'll cooperate.", "Emily")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","wry_smile")
	await novel_interface.show_dialog("You're not even worried I'll run away--", "Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I protested while getting out of the vehicle very obediently, but swallowed the rest halfway through.")
	novel_interface.show_character("ren_medical","wail")
	await novel_interface.show_dialog("(It's empty desert in every direction. Where exactly would I even run...)", "Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("This sunken supply station was tucked into the dunes. From far away it looked like just one more bare dirt mound on a barren hill.")
	await novel_interface.show_text_only("Still, it had clearly been abandoned for quite a long time...")
	await novel_interface.show_text_only("Probably because a place like this costs too much to maintain, and because the resistance had already given up the surrounding area.")
	await novel_interface.show_text_only("The jeep parked inside the station was coated in a thick layer of dust, and huge piles of sandbags meant for building fortifications were stacked carelessly everywhere.")
	await novel_interface.show_text_only("The forklift and generator leaning against the wall were covered in rust and scars left by wind and sand. A few overturned boxes of ammunition lay in the corner as well...")
	await novel_interface.show_text_only("Back in the vehicle, Emily had answered my second question: what exactly was the \"personal business\" they were here to do.")
	await novel_interface.show_text_only("I'd actually guessed part of it already. It had to do with my cover identity--")
	await novel_interface.show_text_only("According to Emily, it violates international conventions for NGOs in war zones to transport any kind of military supplies.")
	await novel_interface.show_text_only("Winning exemptions from both sides in the name of helping innocent civilians, only to aid one side afterward, is a serious breach of ethics.")
	await novel_interface.show_text_only("But in recent years, the Masadan military has disguised many military outposts as civilian aid facilities and bribed NGOs to transport supplies for them.")
	await novel_interface.show_text_only("That way they can more flexibly pin down the guerrilla resistance, and whenever one of those outposts is destroyed, they can loudly denounce it as a terrorist attack against innocents.")
	await novel_interface.show_text_only("What they were here to do was hijack that kind of gray-market supply.")
	await novel_interface.show_text_only("Using the emergency relief code on my badge, Emily had found information on the vehicle best suited to target.")
	await novel_interface.show_text_only("That function was originally meant to locate and call up the nearest NGO relief supplies in an emergency.")
	novel_interface.show_character("emilio","smile")
	await novel_interface.show_dialog("The truck is carrying mostly military medical supplies. It'll pass by here on the highway in forty minutes.", "Emily")
	await novel_interface.hide_character()
	novel_interface.show_character("valkyrja","happy")
	await novel_interface.show_dialog("I'll go set up roadblocks and mines. You two get the machine guns and loudspeakers ready.", "Vera")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","shy")
	await novel_interface.show_dialog("...Loudspeakers?", "Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("My hand moved to my chest on reflex.")
	await novel_interface.show_text_only("Vera pulled the protective covers off the equipment on the vehicle one by one. I'd been bracing myself, but it still startled me--")
	await novel_interface.show_text_only("One large quadruped cargo robot, two rows of remote-controlled roadblocks, six auto-aiming machine guns, four loudspeakers, and a bunch of small remote bombs...")
	await novel_interface.show_text_only("...What on earth were they planning to do!?")
	await novel_interface.show_text_only("Emily and I quickly used the pack robot's carrying capacity to deploy the machine guns and speakers on the nearby hills.")
	await novel_interface.show_text_only("After planting the roadblocks and bombs, Vera followed Emily's instructions, filled a jeep with gas, and drove it behind a giant boulder by the road.")
	await novel_interface.show_text_only("Then they launched the scout drone from the top of the APC and hid the vehicle perfectly under an optical camouflage cover.")
	await novel_interface.show_text_only("At last the three of us crouched behind the tallest hill and waited quietly for the target to appear.")
	novel_interface.show_character("ren_medical","stare")
	await novel_interface.show_dialog("You really guarantee no one will get hurt...?", "Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I asked uneasily. The weapons we'd just set up looked like enough to wipe out an entire platoon.")
	novel_interface.show_character("valkyrja","wink")
	await novel_interface.show_dialog("Relax. This is an Emily plan--", "Vera")
	await novel_interface.show_dialog("Everyone in our battalion knows if it's her plan, it's fine!", "Vera")
	await novel_interface.hide_character()
	novel_interface.show_character("emilio","mock")
	await novel_interface.show_dialog("Those machine guns use AI-controlled infrared targeting. They absolutely won't hit people.", "Emily")
	await novel_interface.show_dialog("And the remote bombs have been modified too. Basically they don't have much killing power. Some are mainly for noise, and others just put out tons of smoke...", "Emily")
	novel_interface.change_expression("shout")
	await novel_interface.show_dialog("Ah, the truck's coming!", "Emily")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("The scout drone's feed showed a truck with the medical relief organization's red logo driving down the highway.")
	await novel_interface.show_text_only("When it reached the stretch near the supply station, one bomb exploded, and the first row of roadblocks popped up at an angle that jolted the truck.")
	await novel_interface.show_text_only("The truck slowed to a crawl. Thinking it had blown a tire, the driver hurried out to check.")
	novel_interface.show_character("emilio","angry")
	await novel_interface.show_dialog("Now!", "Emily")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("At the lieutenant's command, the carefully arranged fireworks show began--")
	await novel_interface.show_text_only("The second row of roadblocks snapped up and locked the truck's front wheels, and the machine guns on the hilltops began firing in sequence.")
	await novel_interface.show_text_only("Huge numbers of bullets artfully avoided both the people and the truck's power system, leaving countless impact marks in the ground instead.")
	await novel_interface.show_text_only("The driver who had just gotten out scrambled back into the truck in panic, only to find that no matter how he tried to start it, the vehicle wouldn't budge.")
	await novel_interface.show_text_only("The speakers began blasting prerecorded Arabic shouts from several men, roughly meaning things like \"Take them alive\" and \"Ransom.\"")
	await novel_interface.show_text_only("At the same time, explosions went off one after another, and the area around the truck was soon engulfed in smoke.")
	await novel_interface.show_text_only("The driver and passenger seized the chance to run out through the smoke, only to be herded by machine-gun fire in blind terror behind a huge roadside rock.")
	await novel_interface.show_text_only("About a minute later, the machine-gun fire thinned out. The two poor bastards, scared out of their minds, immediately jumped into the jeep parked there and fled in panic.")
	await novel_interface.show_text_only("They stomped the accelerator flat, ignored where the road even was, and zigzagged off into the depths of the desert...")
	await novel_interface.show_text_only("I stared open-mouthed at everything that had happened in those few minutes, too shocked to say a word.")
	await novel_interface.show_text_only("Emily pushed herself up off the ground, dusted the dirt from her clothes, and explained to me while I still had question marks all over my head.")
	novel_interface.show_character("emilio","smile")
	await novel_interface.show_dialog("There are some independent guerrilla factions within the resistance, and a fair number of deserters drifted into the mountains and became bandits.", "Emily")
	await novel_interface.show_dialog("As long as we make it look like it was them and leave behind eyewitnesses, the Defense Force, which is itself violating international conventions, can only swallow the loss in silence.", "Emily")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("That's the whole idea behind the plan~", "Emily")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I still don't understand why you two are robbing your own side's supplies, but please accept my deepest respect first!")
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	novel_interface.show_character("valkyrja","angry")
	await novel_interface.show_dialog("Wait, look over there!", "Vera")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Vera pointed and shouted at the metal plating unfolding from the roof of the truck's cargo compartment.")
	await novel_interface.show_text_only("Six small drones shot out of the pitch-black opening. Two or three seconds later, another six came out, then another six...")
	await novel_interface.show_text_only("Emily immediately dropped flat and started changing the machine guns' targeting parameters on her military tablet, but more and more drones kept pouring out.")
	novel_interface.show_character("emilio","shout")
	await novel_interface.show_dialog("Damn it, it's a \"Honeycomb\"!", "Emily")
	novel_interface.change_expression("angry")
	await novel_interface.show_dialog("This just got bad...", "Emily")

	print("=== 星尘降临篇第13话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
