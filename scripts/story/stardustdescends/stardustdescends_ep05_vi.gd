	await novel_interface.hide_character()
	await novel_interface.show_text_only("Một số chất H được cho là trong truyền thuyết tôn giáo có sức mạnh giết chết các vị thần.")
	await novel_interface.show_text_only("Một khi được kích hoạt, nó có thể gây ra thảm họa cấp độ ngày tận thế, vì vậy mọi hình thức nghiên cứu đều bị nghiêm cấm.")
