# stardustdescends_ep05.gd - 星尘降临篇第5话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	stardustdescends_ep05_script()

func play_script():
	pass

func stardustdescends_ep05_script():
	novel_interface.change_music("res://assets/audio/music/Shop.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_Vault.png")
	novel_interface.show_character("ren_full","panic")
	await novel_interface.show_dialog("Vậy đây là hầm trên tàu \"Liberty Star\"...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Tôi ngạc nhiên nhìn xung quanh. Trần, sàn và cả hai bức tường đều được ốp bằng những tấm kim loại sáng như gương làm bằng vật liệu đặc biệt.")
	await novel_interface.show_text_only("Tôi so sánh những tấm kim loại với con chip vàng trên tay mình. Màu sắc tương tự, nhưng các bức tường tỏa ra ánh sáng xanh xám nhạt.")
	await novel_interface.show_text_only("Chỉ một số khách VIP nhất định mới được phép sử dụng két sắt trong hầm - và tôi chỉ mới có được đặc quyền đó.")
	await novel_interface.show_text_only("Cách duy nhất để ra vào là thang máy ở khu VIP, cửa ở phía dưới dày như tường.")
	await novel_interface.hide_background()
	await novel_interface.show_dialog("(Không có tín hiệu ở đây... Đúng như mong đợi.)", "Lian")
	await novel_interface.show_text_only("Tôi mất liên lạc ngay khi bước vào thang máy. Bây giờ, tôi phải làm mọi thứ chính xác như cách tôi đã làm trong quá trình diễn tập và không được sai một bước nào.")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_Vault.png")
	novel_interface.show_character("ren_full","solemn")
	await novel_interface.show_dialog("(Bước một: xác nhận hệ thống giám sát đã ngừng hoạt động... OK.)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Tôi nhận thấy một số camera bên trong hầm đồng thời nhấp nháy, sau đó tất cả đều tối đen.")
	await novel_interface.show_dialog("Thưa cô, két sắt của cô là số 1212. Mỗi lần nó mở ra, cả chìa khóa của cô và của chúng tôi đều phải tra vào...", "Bồi bàn")
	await novel_interface.show_text_only("Người phục vụ lịch sự quay lại đưa chìa khóa cho tôi, chỉ để thấy một chai \"nước hoa\" chĩa thẳng vào mặt anh ta--")
	novel_interface.show_character("ren_full","wry_smile")
	await novel_interface.show_dialog("Tôi rất xin lỗi!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sau khi xịt một phát lên mặt, mắt anh ta lập tức mờ đi. Anh ấy dường như muốn nói điều gì đó, nhưng sau khi mở miệng vài lần, không có âm thanh nào phát ra.")
	await novel_interface.show_text_only("Thuốc xịt gây mê này là một sản phẩm SRD mới. Aya thậm chí còn bổ sung thêm một loại thuốc có tác dụng loại bỏ sự kiểm soát ức chế của não.")
	await novel_interface.show_text_only("Bất cứ ai bị nó phun vào sẽ rơi vào trạng thái giống như thôi miên và trở nên cực kỳ dễ tiếp thu gợi ý.")
	novel_interface.show_character("ren_full","smile")
	await novel_interface.show_dialog("Hãy đến và đứng ở đây.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Tôi cẩn thận dẫn người phục vụ đang choáng váng đến chỗ đối diện trực tiếp với cửa thang máy và nhét một con chip màu đỏ vào tay anh ta.")
	novel_interface.show_character("ren_full","solemn")
	await novel_interface.show_dialog("Ừm...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Nhớ lại những câu thoại tôi đã được yêu cầu tập đi tập lại, tôi nói với anh ấy bằng giọng chắc chắn--")
	novel_interface.show_character("ren_full","normal1")
	await novel_interface.show_dialog("Vừa rồi cậu đã đưa tôi tới két sắt này. Mọi thứ đều bình thường.", "Lian")
	await novel_interface.show_dialog("Sau khi cất giữ vật phẩm của mình, tôi đã đưa cho bạn một con chip làm tiền boa.", "Lian")
	novel_interface.change_expression("solemn")
	await novel_interface.show_dialog("Khoảnh khắc bạn nghe thấy tiếng ngón tay búng tay hoặc thấy cửa thang máy mở ra, bạn sẽ thức dậy và “nhớ” từng chi tiết.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Người phục vụ không thể nói bất cứ điều gì. Anh chỉ nhìn chằm chằm vào cửa thang máy. Tôi cẩn thận bước đi.")
	novel_interface.show_character("ren_full","stare")
	await novel_interface.show_dialog("(Thật sự đủ rồi sao?...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru nói rằng bộ não con người rất giỏi trong việc điền thông tin chi tiết từ một vài gợi ý và gợi ý đơn giản... nhưng việc này vẫn có vẻ quá dễ dàng phải không?!")
	novel_interface.show_character("ren_full","stare")
	await novel_interface.show_dialog("Chính xác thì anh ấy sẽ nhớ lại điều gì?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Vẫn lẩm bẩm một mình, tôi bước đến giữa hầm, nhanh chóng cởi giày cao gót và đặt chúng ngay ngắn xuống sàn.")
	await novel_interface.show_text_only("Sau đó, tôi nhét tai nghe và mọi vật kim loại khác vào túi xách và để nó cạnh gót chân.")
	await novel_interface.show_text_only("Hầm này là một buồng che chắn tĩnh từ siêu dẫn khổng lồ, có khả năng chặn hầu hết các bức xạ và từ trường.")
	await novel_interface.show_text_only("Lebona không có công nghệ như thế này. Theo thông tin tình báo của Giáo sư Shih, buồng che chắn được đặt hàng từ một nhà sản xuất quân sự ở Cung điện Hovering.")
	await novel_interface.show_text_only("Tôi tìm thấy thùng chứa mục tiêu. Giữa hai lỗ khóa trên mỗi cánh cửa là họa tiết đám mây được khắc laser mờ.")
	novel_interface.show_character("ren_full","normal1")
	await novel_interface.show_dialog("Container số 0812...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Tôi cắm hai chìa khóa chính bằng gốm vào hai ổ khóa cùng lúc và kích hoạt công tắc ở hai đầu của chúng.")
	await novel_interface.show_text_only("Fabella từng nói rằng chìa khóa két sắt cá nhân ở ngân hàng và các tổ chức tương tự thực ra có độ bảo mật rất thấp--")
	await novel_interface.show_text_only("Một phần lý do là các tổ chức đó cực kỳ tin tưởng vào độ an toàn bảo vệ chính kho tiền.")
	await novel_interface.show_text_only("Quan trọng hơn, chiếc chìa khóa mang đến cho khách hàng ảo tưởng rằng chỉ họ mới có thể mở két, điều này khiến việc thanh toán dịch vụ trở nên dễ dàng hơn rất nhiều.")
	novel_interface.show_character("ren_full","stare")
	await novel_interface.show_dialog("(Vậy kho tiền và hệ thống bảo mật mang lại sự \"bảo mật\", trong khi chìa khóa mang lại sự \"yên tâm\"...?)", "Lian")
