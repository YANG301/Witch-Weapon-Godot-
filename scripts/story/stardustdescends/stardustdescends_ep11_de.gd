# stardustdescends_ep11.gd - 星尘降临篇第11话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	stardustdescends_ep11_script()

func play_script():
	pass

func stardustdescends_ep11_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_MasadMuseum.png")
	novel_interface.show_character("ren_medical","normal1")
	await novel_interface.show_dialog("Nationalmuseum Masada... das ist der richtige Ort?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ich hielt mein Telefon in der Hand und vergewisserte mich, dass ich am richtigen Ort angekommen war.")
	await novel_interface.show_text_only("Was mich überraschte, war, dass die meisten Ausstellungsräume dieses Nationalmuseums in halbunterirdischen Räumen untergebracht waren.")
	await novel_interface.show_text_only("Die schwarze Steinmauer am Haupteingang enthielt angeblich Steine aus den Ruinen der alten Stadtmauer auf der Westseite des Tempelbergs in der ehemaligen Hauptstadt.")
	await novel_interface.show_text_only("Das schwarze, strahlenabschirmende Material, das fest um die Außenseite der Wand gewickelt war, schien stillschweigend von den Wunden und dem Leid zu sprechen, die diese Katastrophe hinterlassen hatte.")
	await novel_interface.show_text_only("Die gesamte Mauer glich einem riesigen Grabstein. Darunter standen ein paar ältere Menschen, senkten ihre Köpfe und streichelten sanft den Stein, und ich konnte nicht sagen, ob sie trauerten oder beteten ...")
	novel_interface.show_character("ren_medical","uneasy")
	await novel_interface.show_dialog("Ich registriere mich hier... oder?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ich benutzte meinen Ausweis am unbemannten Schalter am Eingang und führte einen biometrischen Gesichtsscan durch.")
	await novel_interface.show_text_only("Bei diesem Abzeichen handelte es sich um einen verschlüsselten Ausweis der International Medical Relief Organization, der speziell für medizinisches Personal entwickelt wurde, das häufig in Kriegsgebiete ein- und auszieht.")
	await novel_interface.show_text_only("Neben der Speicherung persönlicher Daten und Krankenakten können Sie damit auch die Kommunikationsausrüstung und Hilfsgüter der Organisation überall auf der Welt abrufen.")
	await novel_interface.show_text_only("Es war sogar eine Summe elektronischer Offline-Währung vorinstalliert, angeblich zur Zahlung eines Lösegelds im Falle einer Entführung ...")
	novel_interface.show_character("ren_medical","wry_smile")
	await novel_interface.show_dialog("(Eine Assistenzkrankenschwester braucht einen solchen Zugang überhaupt nicht, oder!)\n(Mariru, ehrlich...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Wie auch immer, solange sie mich nicht dazu zwingen, etwas Gefährliches zu tun ...")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("...")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_FirstExhibition.png")
	await novel_interface.show_text_only("Ich fuhr mit der Rolltreppe hinunter in die erste Ausstellungshalle, wo in dem nicht sehr geräumigen Raum viele Steinreliefs ausgestellt waren.")
	await novel_interface.show_text_only("Die sichtbaren Spuren der Winderosion schienen eine ferne, verwitterte Geschichte zu erzählen.")
	await novel_interface.show_text_only("Aber ich interessierte mich nicht für Geschichte. Ich scrollte einfach auf meinem Handy herum und versuchte herauszufinden, wie ich diese elenden drei Stunden überleben sollte.")
	novel_interface.show_character("ren_medical","panic")
	await novel_interface.show_dialog("Ist das... ein Leitfaden?!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("In der heutigen Zeit, in der KI-Sprachführer allgegenwärtig sind, hatte ich schon lange keinen echten menschlichen Führer mehr gesehen.")
	novel_interface.show_character("ren_medical","stare")
	await novel_interface.show_dialog("(Hat Masada nicht einen erbärmlichen Bevölkerungsmangel ...?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Er war ein älterer Mann mit weißem Bart, wahrscheinlich in den Sechzigern, und trug eine kleine schwarze Mütze mit einem Ausweis am Kragen seines Anzugs.")
	await novel_interface.show_text_only("Er führte alle geduldig beim Einsammeln der Broschüren und lächelte freundlich, als er jeder Person antwortete, die ihn etwas fragte.")
	await novel_interface.show_text_only("Neugierig schob ich mich näher heran. Er stellte einigen Besuchern die Geschichte des Museums vor –")
	await novel_interface.show_dialog("Obwohl viele wertvolle Relikte zusammen mit dem ursprünglichen Nationalmuseum im Krieg zerstört wurden.", "Guide")
	await novel_interface.show_dialog("In den letzten Jahren hat dieses neue Museum jedoch viele wertvolle Artefakte aus Westasien und Afrika gesammelt, die es ihnen ermöglichen, den Verwüstungen des Krieges zu entkommen ...", "Guide")
	await novel_interface.show_text_only("Ich warf einen Blick auf die ägyptische Mumie und die Bronzemaske, die auf der Rückseite der Broschüre aufgedruckt waren.")
	novel_interface.show_character("ren_medical","wail")
	await novel_interface.show_dialog("(Du hast sie also einfach von diesen Orten gestohlen, hm!)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aber heutzutage werden die wertvollsten historischen Artefakte auf der ganzen Welt ohnehin von den Sechs Akademiestädten aufbewahrt, sodass so etwas kaum ungewöhnlich ist.")
	await novel_interface.show_text_only("Mir fiel auf, dass er zwar voller Emotionen sprach, seine linke Hand aber die ganze Zeit in der Anzugtasche steckte.")
	novel_interface.show_character("ren_medical","bored")
	await novel_interface.show_dialog("(Vielleicht ist es ein besonderer religiöser Brauch ...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ich sah mich um. Glücklicherweise war heute kein Sabbat, daher gab es nicht viele Besucher, und auch andere Mitglieder der medizinischen Organisation waren nicht im Museum.")
	await novel_interface.show_text_only("Für NGO-Mitglieder beginnt der erforderliche „Studienbesuch“ damit, dass sie mindestens dreißig Minuten in den Geschichts- und Dokumentensälen verbringen.")
	await novel_interface.show_text_only("Ich wanderte gelangweilt umher und mein Blick fiel bald auf ein paar Einheimische und über ein Dutzend Kinder, die gleichzeitig den Ort besichtigten.")
	await novel_interface.show_text_only("Unter ihnen fielen am meisten zwei Männer in den Vierzigern auf – beide hatten große Bärte und seltsame kleine Zöpfe, die aus den Haaren an ihren Schläfen hingen.")
	await novel_interface.show_text_only("Sie waren gleich gekleidet: weiße Hemden, schwarze knielange Mäntel und schwarze, flache Hüte mit gewellter Krempe, wie Leute aus einer seltsamen Organisation.")
	await novel_interface.show_text_only("Etwa ein Dutzend Kinder folgten diesen Männern, und sowohl Jungen als auch Mädchen trugen die gleichen schwarz-weißen Outfits.")
	novel_interface.show_character("ren_medical","bored")
	await novel_interface.show_dialog("(Ist das ein Schulausflug aus der Nähe?)\n(Aber die Altersspanne an dieser Schule ist ziemlich wild...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Die Kinder waren gleichmäßig zwischen etwa drei oder vier Jahren und etwa zehn Jahren alt; Die Jüngsten konnten kaum noch stabil gehen, während einige der Älteren schrien und sich aufregten.")
	await novel_interface.show_text_only("Hinter der Gruppe stapften zwei müde aussehende Frauen mittleren Alters mit schlaffen Figuren.")
	novel_interface.show_character("ren_medical","stare")
	await novel_interface.show_dialog("(Diese beiden sind doch nicht die Lehrer... oder?)", "Lian")
	await novel_interface.show_dialog("(Warum schiebt einer von ihnen überhaupt einen Kinderwagen?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Was für eine seltsame Kombination...")
	await novel_interface.show_text_only("Der Rundgang durch den Geschichtssaal endete schnell und der Führer begann, alle zum Dokumentensaal zu führen.")
	await novel_interface.show_text_only("Er rückte das an seinem Kragen befestigte Mikrofon zurecht und räusperte sich …")
	await novel_interface.show_dialog("Als nächstes zeige ich Ihnen die wichtigste Ausstellung in diesem Museum.", "Guide")
	await novel_interface.show_dialog("In der Nebenhalle ist das Fotografieren verboten. Bitte legen Sie Ihre Telefone weg und folgen Sie mir in den Schrein des Buches.", "Guide")
	await novel_interface.show_text_only("Als sie das hörten, verstummten die rüpelhaften Kinder und auch die beiden Männer in Schwarz wurden ernst.")
	await novel_interface.show_text_only("Ich steckte mein Handy weg und folgte ihm mit brennender Neugier.")
	await novel_interface.hide_background()
	await novel_interface.stop_music()
	await novel_interface.show_text_only("Nachdem der Führer seinen Handabdruck gescannt hatte, öffnete sich langsam eine Basalttür im Geschichtssaal und gab den Blick auf einen langen Steinkorridor dahinter frei.")
	await novel_interface.show_text_only("Mehr als zwanzig von uns meldeten sich nacheinander an. Es fühlte sich an, als hätte uns eine feierliche Atmosphäre angesteckt; Alle bewegten sich vorsichtig und sagten nichts.")
	await novel_interface.show_text_only("...")
	novel_interface.change_music("res://assets/audio/music/Normal Stage.mp3")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_SOTB.png")
	novel_interface.show_character("ren_medical","panic")
	await novel_interface.show_dialog("Das ist...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Am Ende des Korridors befand sich eine seltsam geformte Kammer.")
	await novel_interface.show_text_only("Die Ausstellungshalle des Schreins des Buches war perfekt kreisförmig, mit gleichmäßig verteilten ringförmigen Streifen, die von den Wänden bis zum Oberlicht über ihnen verliefen.")
	await novel_interface.show_text_only("Das durch das Oberlicht strömende Licht fiel auf den Ausstellungsständer in der Mitte und ließ den ganzen Ort ruhig und heilig wirken.")
	await novel_interface.show_text_only("Der gesamte Raum war wie ein Tonkrug gestaltet und die umgebenden Wände bestanden aus einem ähnlichen Erdmaterial.")
	await novel_interface.show_text_only("Auf dem runden Ausstellungsständer in Form einer Schrifttrommel oben auf den Steinstufen lag eine alte, vergilbte, gesprenkelte Pergamentrolle.")
	await novel_interface.show_text_only("Ich stieg die Stufen hinauf und beugte mich vor, um genauer hinzuschauen. Das Schutzglas schien mindestens fünf Zentimeter dick zu sein, und die meisten hebräischen Zeichen auf der Schriftrolle waren deutlich zu erkennen.")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_DSS.png")
	await novel_interface.show_dialog("Könnte das sein--", "Lian")
	await novel_interface.show_text_only("Weißt du, das Ding aus diesem Anime...")
	await novel_interface.show_dialog("Hierbei handelt es sich um ein altes Dokument, das in Höhlen nordwestlich des Toten Meeres entdeckt wurde und als „Schriftrollen vom Toten Meer“ bekannt ist, die größte archäologische Entdeckung des letzten Jahrhunderts.", "Guide")
	await novel_interface.show_dialog("Die Schriftrollen vom Toten Meer sind riesig und umfassen mehr als fünfhundert Manuskripte, die in zwölf Höhlen ausgegraben wurden.", "Guide")
	await novel_interface.show_dialog("Und das in dieser Vitrine ist eine Teilmanuskriptseite der Genesis aus der „Tora“, einer der Schriftrollen vom Toten Meer.", "Guide")
	await novel_interface.show_dialog("Es dokumentiert den Prozess der Erschaffung der Welt durch Gott und wie er die Masadaner als sein auserwähltes Volk auswählte. Es ist das wichtigste historische Relikt dieses Landes.", "Guide")
	await novel_interface.show_text_only("Wenn ich darüber nachdenke, scheinen die Masadaner immer stolz darauf zu sein, Gottes auserwähltes Volk zu sein ...")
	await novel_interface.show_text_only("Aber solche religiösen Geschichten haben mich nie interessiert...")
	await novel_interface.show_text_only("Jedes Volk auf der Erde hat ein paar Vorfahren, die sich in seinen Legenden in Götter verwandelt haben, nicht wahr?")
	await novel_interface.show_text_only("Die einheimischen Besucher dachten offensichtlich nicht so. Die beiden Onkel mit den seltsamen Hüten wandten sich sofort dem Koffer zu und begannen zu beten.")
	await novel_interface.show_text_only("Mit seiner tiefen, freundlichen Stimme fuhr der Führer fort.")
	await novel_interface.show_dialog("Dieses Manuskript enthält die Geschichten der Vorfahren Abraham, Isaak, Jakob und der zwölf Söhne Jakobs.", "Guide")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_TheThree.png")
	await novel_interface.show_dialog("Abraham ist ein Prophet in vielen Religionen und der gemeinsame Vorfahre der Hebräer und Araber.", "Guide")
	await novel_interface.show_dialog("Abraham war derjenige, den der Herr unter allen Wesen auswählte und segnete.", "Guide")
	await novel_interface.show_dialog("Gott schloss einen Bund mit Abraham und versprach, seinem legitimen Sohn, seinem Enkel und allen Nachkommen, die die Linie des Enkels hervorbringen würde, fruchtbares Land zu gewähren.", "Guide")
	await novel_interface.show_dialog("Dieses Land erstreckt sich vom Nil bis zum Euphrat. Es ist das, was wir heute das „Gelobte Land“ nennen.", "Guide")
	await novel_interface.show_dialog("Später zeugte Abraham seinen legitimen Sohn Isaak; Isaak zeugte Esau und sein zweiter Sohn hieß Jakob ...", "Guide")
	await novel_interface.show_dialog("(Warte... Jacob?)", "Lian")
	await novel_interface.show_text_only("Ist das nicht der Name dieses Administrators aus Elluka?")
	await novel_interface.show_text_only("Andererseits benennen Westler ihre Kinder gerne nach Figuren aus religiösen Klassikern ...")
	await novel_interface.show_text_only("Der Führer hielt inne, rückte seine Lesebrille zurecht und erklärte weiter den Inhalt der Schriftrolle.")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_MessOfPottage.png")
	await novel_interface.show_dialog("Der Schrift zufolge kaufte Jakob, Isaaks zweiter Sohn, einst das Erstgeburtsrecht seines älteren Bruders Esau mit einer Schüssel rotem Bohneneintopf.", "Guide")
	await novel_interface.show_dialog("Gemäß Abrahams Bund mit Gott erlangte Jakob, sobald er das Erstgeburtsrecht erlangte, das gesetzliche Recht, das „Gelobte Land“ zu erben.", "Guide")
	await novel_interface.show_dialog("Jakob wurde später Masadas heiliger Patriarch und seine zwölf Söhne wurden die zwölf Vorväter von Masadas Stämmen ...", "Guide")
	await novel_interface.show_text_only("Zu diesem Zeitpunkt begann mein Kopf zu pochen.")
	await novel_interface.show_text_only("Moment mal ... Eintopf mit roten Bohnen? Was zum Teufel!?\nWaren die alten Menschen wirklich so locker?")
	await novel_interface.show_text_only("Und wenn das wahr ist, dann sind alle Masadaner Nachkommen dieses Jakobs ...")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_DSS.png")
	await novel_interface.show_text_only("Der Führer machte zwei Schritte über die runde Plattform, untersuchte die Worte am Ende der Schriftrolle und fuhr fort.")
	await novel_interface.show_dialog("Dies ist der Schlussteil der Genesis:", "Guide")
	await novel_interface.show_dialog("Das Leben des heiligen Patriarchen Jakob war voller Legenden. Er träumte vom Tor des Himmels und hörte, wie Gott den seinem Großvater geleisteten Eid bekräftigte.", "Guide")
	await novel_interface.show_dialog("Er rang mit Gott und kam lahm davon und ihm wurde ein heiliger Name verliehen.", "Guide")
	await novel_interface.show_dialog("Jakob verbrachte die letzten siebzehn Jahre seines Lebens in Ägypten und rief vor seinem Tod nach seinem Sohn Joseph ...", "Guide")
	await novel_interface.show_dialog("Jakob ließ seinen Sohn schwören, ihn aus Ägypten herauszuführen und in der Höhle Machpela in Hebron im Land Kanaan zu begraben.", "Guide")
	await novel_interface.show_dialog("Das war das Familiengrab, das Abraham vor langer Zeit gekauft hatte und in dem Jakobs Eltern und Großeltern begraben waren.", "Guide")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Das Manuskript endet hier.")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_SOTB.png")
	novel_interface.show_character("ren_medical","worry")
	await novel_interface.show_dialog("(Machpelah-Höhle ... warum kommt Ihnen dieser Name bekannt vor?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ich habe das Gefühl, dass Aya es in der Besprechung gestern Abend erwähnt hat ... Gab es vor ein paar Tagen nicht eine Explosion?")
	await novel_interface.show_text_only("Uff, ich kann mich nicht erinnern. All diese fremden Personen- und Ortsnamen klingen für mich sowieso gleich...")
	await novel_interface.show_text_only("Der Führer streichelte sanft das Glas der Vitrine und seufzte leise.")
	await novel_interface.show_dialog("Masada ist ein altes Volk und wir legen großen Wert auf archäologische Ausgrabungen.", "Guide")
	await novel_interface.show_dialog("Seit der Entdeckung der ersten Schriftrolle wird die Ausgrabung und Restaurierung der Schriftrollen vom Toten Meer seit mehr als achtzig Jahren fortgesetzt.", "Guide")
	await novel_interface.show_dialog("Sie sind das wertvolle Erbe unserer Vorfahren und zugleich unsere Wurzeln.", "Guide")
	await novel_interface.show_dialog("Allerdings...", "Guide")
	await novel_interface.show_text_only("Der Führer ging die Treppe hinunter und näherte sich dem riesigen Ölgemälde auf einer Seite der Halle.")
	novel_interface.change_music("res://assets/audio/music/Hero.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_TheJewishWar.png")
	await novel_interface.show_text_only("Er stand lange davor und starrte in bedeutungsvollem Schweigen.")
	await novel_interface.show_text_only("Das Gemälde hatte große Ausmaße und bedeckte fast eine ganze Wand.")
	await novel_interface.show_dialog("Doch unsere Geschichte ist auch voller Leid.", "Guide")
	await novel_interface.show_text_only("Er drehte sich um, seine Mundwinkel zuckten leicht, als würde er verzweifelt eine schmerzhafte Erinnerung unterdrücken.")
	await novel_interface.show_dialog("Dieses Gemälde wurde auf der Grundlage der Schriften des Historikers Flavius Josephus aus dem ersten Jahrhundert geschaffen.", "Guide")
	await novel_interface.show_dialog("Damals eroberte das mächtige Römische Reich die heilige Stadt und mehr als eine Million Masadan-Vorfahren wurden von Legionssoldaten abgeschlachtet.", "Guide")
	await novel_interface.show_dialog("Und dieses Gemälde zeigt den Tag, an dem der Zweite Tempel in Brand gesteckt wurde.", "Guide")
	await novel_interface.show_dialog("Es war der traurigste Tag in der Geschichte Masadas ... und doch war es nur der Anfang von tausend Jahren des Leidens.", "Guide")
	await novel_interface.show_dialog("Im Jahr 70 wurden unsere Vorfahren in großer Zahl von den Römern aus Judäa vertrieben.", "Guide")
	await novel_interface.show_dialog("Diejenigen, die sich weigerten, die Verbannung aus ihrem Heimatland anzunehmen, erhoben sich zum Widerstand, und mehr als tausend Rebellen machten Masada seinerzeit zu ihrer letzten Festung.", "Guide")
	await novel_interface.show_dialog("Sie hielten die Stadt ganze zwei Jahre lang unter römischer Belagerung, bis ihre Wasserversorgung unterbrochen wurde und sie keine Kraft mehr hatten.", "Guide")
	await novel_interface.show_dialog("Als die Zehnte Legion schließlich in die Stadt eindrang, fand der Gouverneur, der eintrat, nur mehr als neunhundert Leichen und bis auf die Grundmauern niedergebrannte Gebäude vor –", "Guide")
	await novel_interface.show_dialog("Die Verteidiger entschieden sich für Selbstmord, anstatt sich zu unterwerfen und Sklaven Roms zu werden. Am Ende überlebten nur zwei Erwachsene und fünf Kinder ...", "Guide")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Als ich mir diese Szene vorstellte, schmerzte meine Brust.")
	await novel_interface.show_text_only("Der Führer schwieg lange, dann drehte er sich wieder zu uns um und fuhr fort.")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_SOTB.png")
	await novel_interface.show_dialog("Wir wurden immer wieder aus unserer Heimat vertrieben, aus unseren eigenen Häusern vertrieben.", "Guide")
	await novel_interface.show_dialog("Wir wurden erobert, regiert, ausgegrenzt, abgeschlachtet, als Sklaven, Gefangene und sogar als Vieh behandelt ...", "Guide")
	await novel_interface.show_dialog("Vor einem Jahrhundert wurden bei einer der schrecklichsten ethnischen Säuberungen in der Geschichte der Menschheit sechs Millionen unserer Landsleute massakriert.", "Guide")
	await novel_interface.show_dialog("Und vor zehn Jahren wurde unsere Hauptstadt erneut in verbrannte Erde verwandelt. Der Tempelberg brannte sieben Tage und sieben Nächte lang in violetten Flammen ...", "Guide")
	await novel_interface.show_dialog("Viele Menschen – meine Familie und Freunde – verloren bei dieser Katastrophe ihr Leben.", "Guide")
	await novel_interface.show_dialog("Und diejenigen, die durch reines Glück überlebt haben, haben möglicherweise noch mehr verloren ...", "Guide")
	await novel_interface.show_text_only("Seine Stimme zitterte, als er die linke Hand hob, die in seiner Tasche steckte.")
	await novel_interface.show_text_only("Erst dann sahen wir, dass die Hand durch eine Metallprothese ersetzt worden war und dass Verbrennungen das Handgelenk und den Unterarm bedeckten, die über den Ärmel hinaus sichtbar waren …")
	await novel_interface.show_text_only("Der ganze Raum verstummte. Auch ich hielt den Atem an.")
	await novel_interface.show_text_only("Ein junges Touristenmädchen in der Menge bedeckte ihren Mund mit beiden Händen und Tränen traten ihr in die Augen.")
	await novel_interface.show_text_only("Doch der Führer ballte die Hand zur Faust, hob sie hoch und blickte uns an, während er mit entschlossener Stimme sprach:")
	await novel_interface.show_dialog("Und doch wird uns das Leid niemals dazu bringen, uns zu unterwerfen, genau wie die tausend Krieger, die diese Festung bis zum Ende verteidigt haben.", "Guide")
	await novel_interface.show_text_only("Seine Stimme war nicht laut, aber sie war erfüllt von heroischem Geist und ließ eine seltsame Kraft in meiner Brust aufsteigen.")
	await novel_interface.show_text_only("Seine Augen leuchteten, als könnte er einen Gott sehen, der ihm den Weg zeigte.")
	await novel_interface.show_dialog("Wir haben zwei große Diasporas durchgemacht, doch am Ende werden wir immer in dieses Land zurückkehren, denn Leid wird uns niemals dazu bringen, uns zu unterwerfen –", "Guide")
	await novel_interface.show_dialog("Vor neunzig Jahren trotzten unsere Vorfahren Schüssen und Granaten, nur um noch einmal hierher zurückzukehren und eine eigene Nation zu gründen.", "Guide")
	await novel_interface.show_dialog("Auch wenn dies nichts weiter als eine karge Wüste war, auch wenn es damals kaum Süßwasser gab, ist dies unser Zuhause!", "Guide")
	await novel_interface.show_dialog("Was durch dieses Land fließt, ist nicht Milch und Honig, sondern unser Blut, unsere Tränen und unser Schweiß.", "Guide")
	await novel_interface.show_dialog("Dies ist unsere einzige Heimat auf der Welt und die spirituelle Heimat, die das Volk der Masadan seit Tausenden von Jahren schätzt.", "Guide")
	await novel_interface.show_dialog("Das „Gelobte Land“ ist der Bund zwischen unseren Vorfahren und Gott und auch unser Versprechen an zukünftige Generationen –", "Guide")
	await novel_interface.show_dialog("Der Tempel mag niedergebrannt sein, aber die Festung des Geistes wird niemals fallen!", "Guide")
