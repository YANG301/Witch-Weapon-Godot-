	await novel_interface.show_dialog("A proposito... quando hai scritto un'intelligenza artificiale come questa?", "Mariru")
	novel_interface.character_light(0.35,"think")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Non potevo scrivere una cosa del genere. Il modello e i parametri sono stati caricati l'altro ieri da un account chiamato Elder Seven.", "Aya")
