	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Anche la persona ha rilasciato l'algoritmo. Stime approssimative dicono che addestrare un’intelligenza artificiale a questo livello consumerebbe oltre un miliardo di dollari di calcolo.", "Aya")
