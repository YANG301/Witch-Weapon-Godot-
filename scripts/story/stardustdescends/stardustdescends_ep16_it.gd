	await novel_interface.show_dialog("Va bene, va bene. Prima vado a preparare il bagno.", "Haifa")
	await novel_interface.show_text_only("Zia Haifa si alzò e si avviò verso la porta, mormorando tra sé.")
	await novel_interface.show_dialog("Sigh... Può davvero tanto odio essere spazzato via da un solo pezzo di carta...", "Haifa")
