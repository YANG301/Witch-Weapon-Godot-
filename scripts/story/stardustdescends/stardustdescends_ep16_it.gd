	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("Quale organizzazione renderebbe open source qualcosa di così prezioso...? Lo hai isolato bene?", "Mariru")
	novel_interface.character_light(0.35,"wink")
	novel_interface.character_2nd_dark()
