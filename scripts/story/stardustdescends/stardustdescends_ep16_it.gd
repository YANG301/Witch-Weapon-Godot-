	novel_interface.character_2nd_light(0.35,"sigh")
	await novel_interface.show_dialog("Vero. Conoscendo lo stile di Palantir, non c'era alcuna possibilità che si lasciassero scappare un bersaglio così prezioso...", "Mariru")
	novel_interface.character_light(0.35,"stare")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Quindi ho cambiato approccio...", "Aya")
	await novel_interface.show_dialog("Qualsiasi veicolo spaziale che coinvolga materia eterogenea dovrebbe essere l’apice della capacità industriale e tecnologica di una nazione.", "Aya")
	await novel_interface.show_dialog("Almeno diverse migliaia di persone sarebbero state coinvolte nella progettazione, nella ricerca e sviluppo, nella produzione e nei trasporti.", "Aya")
	novel_interface.change_expression("think")
	await novel_interface.show_dialog("E dopo il crollo del governo federale, le relative leggi sulla segretezza hanno cessato di applicarsi, quindi...", "Aya")
