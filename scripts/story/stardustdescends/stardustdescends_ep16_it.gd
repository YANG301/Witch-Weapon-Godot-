	await novel_interface.show_text_only("Proprio come ha detto Mariru, una volta che le risorse circostanti vengono saccheggiate, anche un posto come Masada, con un esercito così grande, non può andare avanti per sempre...")
	novel_interface.show_character("ren_medical","worry")
	await novel_interface.show_dialog("Non c'è nessuno che possa aiutare questi orfani? Masada non tiene sempre le porte aperte alle ONG...?", "Lian")
