	await novel_interface.show_dialog("Non capita spesso di fare volontariato per un noioso lavoro di intelligence come questo.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","wink")
	await novel_interface.show_dialog("Perché l'obiettivo è interessante~", "Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru posò il caramello macchiato sul tavolo accanto ad Aya, e Aya ne bevve un sorso.")
	novel_interface.show_character("liliu_uniform1","normal2")
	await novel_interface.show_dialog("Va davvero bene bere qualcosa di così dolce nel cuore della notte...?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Il mio cervello brucerà comunque lo zucchero. E ho trovato una svolta.", "Aya")
